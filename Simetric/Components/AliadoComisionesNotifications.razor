@using Simetric.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AliadoPortalService Portal
@inject AuthenticationStateProvider Auth
@inject ILogger<AliadoComisionesNotifications> Logger

<div class="position-relative">
    <button type="button" class="btn btn-outline-primary" @onclick="MostrarAsync" aria-expanded="@abierto" aria-label="Notificaciones de comisiones">
        <i class="bi bi-bell"></i> @avisos.Count
    </button>
    @if (abierto)
    {
        <div class="card shadow position-absolute end-0 p-3" style="z-index:1050;width:320px;max-height:400px;overflow:auto" role="status">
            <strong>Notificaciones de comisiones</strong>
            @if (cargando) { <p>Consultando...</p> }
            else if (error is not null) { <p class="text-danger">@error</p> }
            else if (avisos.Count == 0) { <p>No hay avisos de comisiones.</p> }
            else { @foreach (var aviso in avisos.Distinct()) { <p class="border-bottom py-2 mb-0" @key="aviso">@aviso</p> } }
        </div>
    }
</div>
