@using Simetric.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AliadoPortalService Portal
@inject AuthenticationStateProvider Auth
@inject ILogger<AliadoComisionesNotifications> Logger

@if (abierto)
{
    <div class="solicitud-notification-backdrop" @onclick="() => abierto = false"></div>
}
<div class="solicitud-notification-shell notification-center" @onkeydown='e => { if (e.Key == "Escape") abierto = false; }'>
    <button type="button" class="solicitud-notification-trigger @(avisos.Count > 0 ? "has-alerts" : string.Empty)" @onclick="MostrarAsync" aria-expanded="@abierto" aria-label="Notificaciones de comisiones">
        <i class="bi bi-bell" aria-hidden="true"></i>
        @if (avisos.Count > 0)
        {
            <span class="solicitud-notification-badge">@(avisos.Count > 99 ? "99+" : avisos.Count.ToString())</span>
        }
    </button>
    @if (abierto)
    {
        <div class="solicitud-notification-panel">
            <div class="solicitud-notification-head">
                <span><i class="bi bi-bell" aria-hidden="true"></i> Comisiones</span>
                <div>
                    <strong>@avisos.Count aviso(s)</strong>
                    <button type="button" class="solicitud-notification-close" @onclick="() => abierto = false" aria-label="Cerrar notificaciones de comisiones">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="solicitud-notification-list" role="status" aria-busy="@cargando">
                @if (cargando)
                {
                    <div class="solicitud-notification-empty">
                        <span><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
                        <strong>Consultando...</strong>
                    </div>
                }
                else if (error is not null)
                {
                    <div class="solicitud-notification-empty">
                        <span><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                        <strong>No se pudieron cargar los avisos</strong>
                        <small>@error</small>
                    </div>
                }
                else if (avisos.Count == 0)
                {
                    <div class="solicitud-notification-empty">
                        <span><i class="bi bi-bell-slash" aria-hidden="true"></i></span>
                        <strong>No hay avisos de comisiones.</strong>
                    </div>
                }
                else
                {
                    @foreach (var aviso in avisos.Distinct())
                    {
                        <div class="solicitud-notification-item" @key="aviso">
                            <div class="solicitud-notification-main">
                                <span class="solicitud-notification-icon is-code"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                                <div class="solicitud-notification-copy"><strong>@aviso</strong></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>
