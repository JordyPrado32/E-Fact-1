@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@using Simetric.Services.EContax
@inject AuthenticationStateProvider Auth
@inject EContaxSeguridadService Seguridad
@inject AppAccessService Acceso
@inject NavigationManager Nav
@inject MenuStateService MenuState
@implements IDisposable

@if (!esEContax || permitido || (evaluando && accesoServicioConfirmado))
{
    @ChildContent
}
else if (!evaluando)
{
    <div class="alert alert-warning m-4" role="alert">No tienes acceso a esta función de E-Contax.
        <a href="/e-contax/administracion/roles">Mi empresa</a>
        <a href="/portal-servicios">Portal de servicios</a>
    </div>
}

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
    private bool esEContax, permitido, evaluando, accesoServicioConfirmado;
    protected override void OnInitialized() => MenuState.OnMenuChanged += PermisosCambiados;
    protected override Task OnParametersSetAsync() => EvaluarAsync();
    private async Task EvaluarAsync()
    {
        esEContax = EContaxRoutes.IsEContaxPath(Nav, Nav.Uri);
        if (!esEContax) return;

        evaluando = true;
        permitido = false;
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User;
            if (user.Identity?.IsAuthenticated != true)
            { Nav.NavigateTo("/login?ReturnUrl=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri)), true); return; }
            if (!int.TryParse(user.FindFirst("IdUsuario")?.Value ?? user.FindFirstValue(ClaimTypes.NameIdentifier), out var id)) return;
            var esSuperAdmin = string.Equals(user.FindFirst("IdTipoUsuario")?.Value, AppAccessService.AdminRoleId, StringComparison.OrdinalIgnoreCase);
            var access = await Acceso.CanAccessAsync(id, EContaxRoutes.ServiceKey, esSuperAdmin);
            accesoServicioConfirmado = access.HasAccess;
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            permitido = access.HasAccess && (esSuperAdmin || await Seguridad.PuedeAccederRutaAsync(id, path));
        }
        finally { evaluando = false; }
    }
    private void PermisosCambiados() => _ = InvokeAsync(async () =>
    {
        accesoServicioConfirmado = false;
        await EvaluarAsync();
        StateHasChanged();
    });
    public void Dispose() => MenuState.OnMenuChanged -= PermisosCambiados;
}
