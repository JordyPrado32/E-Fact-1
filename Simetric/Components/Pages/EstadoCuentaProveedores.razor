@page "/cuentas-por-pagar/estado-cuenta"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@using Simetric.ViewModels
@attribute [AllowAnonymous]
@inject CuentasPagarService CuentasPagarService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Estado de cuenta de proveedores | Numerica e-fact</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><span class="text-muted text-uppercase small fw-semibold">Proveedores</span><h1 class="h3 mb-1">Estado de cuenta</h1><p class="text-muted mb-0">Consulta cargos, pagos y saldos por proveedor.</p></div>
        <a class="btn btn-outline-secondary" href="/cuentas-por-pagar">Volver a cuentas por pagar</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger border-0 rounded-3">@error</div> }
    @if (cargando) { <div class="alert alert-light border">Cargando estados de cuenta...</div> }
    else
    {
        <div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Saldo total</small><div class="fs-4 fw-semibold">$@resumen.Sum(x => x.SaldoActual).ToString("N2")</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Proveedores con saldo</small><div class="fs-4 fw-semibold">@resumen.Count(x => x.SaldoActual > 0)</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Vencidas</small><div class="fs-4 fw-semibold text-danger">@resumen.Sum(x => x.CuentasVencidas)</div></div></div></div></div>
        <div class="card border-0 shadow-sm"><div class="card-body"><input class="form-control mb-3" @bind="busqueda" @bind:event="oninput" placeholder="Buscar proveedor o RUC..." /><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Proveedor</th><th class="text-end">Facturado</th><th class="text-end">Pagado</th><th class="text-end">Saldo</th><th>Cuentas</th><th></th></tr></thead><tbody>
            @foreach (var item in ResumenFiltrado)
            {
                <tr @key="item.IdentificacionProveedor"><td><strong>@item.Proveedor</strong><br /><small class="text-muted">@item.IdentificacionProveedor</small></td><td class="text-end">$@item.TotalFacturado.ToString("N2")</td><td class="text-end">$@item.TotalPagado.ToString("N2")</td><td class="text-end fw-semibold">$@item.SaldoActual.ToString("N2")</td><td>@item.CuentasPendientes pendientes@if (item.CuentasVencidas > 0) { <span class="text-danger"> · @item.CuentasVencidas vencidas</span> }</td><td class="text-end"><button class="btn btn-sm btn-primary" @onclick="() => VerDetalleAsync(item)">Ver estado</button></td></tr>
            }
        </tbody></table></div></div></div>
        @if (detalle is not null)
        {
            <div class="card border-0 shadow-sm mt-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h5 mb-1">@detalle.Proveedor</h2><small class="text-muted">@detalle.IdentificacionProveedor</small></div><strong>Saldo: $@detalle.SaldoActual.ToString("N2")</strong></div><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Fecha</th><th>Documento</th><th>Concepto</th><th class="text-end">Cargo</th><th class="text-end">Pago</th><th class="text-end">Saldo</th></tr></thead><tbody>@foreach (var movimiento in detalle.Movimientos) { <tr @key="@(movimiento.Fecha.Ticks.ToString() + movimiento.Documento + movimiento.Tipo)"><td>@movimiento.Fecha.ToString("dd/MM/yyyy")</td><td>@movimiento.Documento</td><td>@movimiento.Concepto</td><td class="text-end">@(movimiento.Debito == 0 ? "-" : "$" + movimiento.Debito.ToString("N2"))</td><td class="text-end">@(movimiento.Credito == 0 ? "-" : "$" + movimiento.Credito.ToString("N2"))</td><td class="text-end fw-semibold">$@movimiento.Saldo.ToString("N2")</td></tr> }</tbody></table></div></div></div>
            @if (detalle.Pagos.Any())
            {
                <div class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5 mb-3">Historial de pagos y abonos</h2><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Fecha</th><th>Liquidación</th><th>Forma de pago</th><th>Referencia / comprobante</th><th>Observación</th><th class="text-end">Monto</th></tr></thead><tbody>@foreach (var pago in detalle.Pagos) { <tr @key="@(pago.IdPago == 0 ? pago.IdFactura.ToString() + pago.FechaPago.Ticks : pago.IdPago.ToString())"><td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td><td>@pago.NumeroDocumento</td><td>@(string.IsNullOrWhiteSpace(pago.FormaPago) ? "-" : pago.FormaPago)</td><td>@(string.IsNullOrWhiteSpace(pago.Referencia) ? "-" : pago.Referencia)</td><td>@(string.IsNullOrWhiteSpace(pago.Observacion) ? "-" : pago.Observacion)</td><td class="text-end fw-semibold">$@pago.Monto.ToString("N2")</td></tr> }</tbody></table></div></div></div>
            }
        }
    }
</div>

@code {
    private List<EstadoCuentaProveedorResumenVM> resumen = new();
    private EstadoCuentaProveedorDetalleVM? detalle;
    private int currentUserId;
    private bool cargando = true;
    private string error = "";
    private string busqueda = "";
    private IEnumerable<EstadoCuentaProveedorResumenVM> ResumenFiltrado => resumen.Where(x => string.IsNullOrWhiteSpace(busqueda) || x.Proveedor.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || x.IdentificacionProveedor.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id) ? id : 0;
        if (currentUserId <= 0) { Navigation.NavigateTo("/login", true); return; }
        try
        {
            resumen = await CuentasPagarService.ObtenerResumenProveedoresAsync(currentUserId);
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar los estados de cuenta: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VerDetalleAsync(EstadoCuentaProveedorResumenVM proveedor)
    {
        error = "";
        try
        {
            detalle = await CuentasPagarService.ObtenerDetalleProveedorAsync(currentUserId, proveedor.IdentificacionProveedor);
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar el estado del proveedor: {ex.Message}";
        }
    }
}
