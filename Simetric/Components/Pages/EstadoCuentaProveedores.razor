@page "/cuentas-por-pagar/estado-cuenta"
@page "/e-contax/cuentas-por-pagar/estado-cuenta"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@using Simetric.Services.EContax
@using Simetric.ViewModels
@attribute [AllowAnonymous]
@inject CuentasPagarService CuentasPagarService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<link rel="stylesheet" href="/css/cuentas-por-pagar.css?v=20261023-cxp-flow" />
<PageTitle>Estado de cuenta de proveedores | Numerica e-fact</PageTitle>

<div class="payable-shell">
    <section class="payable-hero">
        <div class="payable-hero-copy"><span class="payable-kicker">Cuentas por pagar</span><h1>Estado de cuenta por proveedor</h1><p>Consulta cargos, pagos, abonos y saldos de tus proveedores en un solo lugar.</p><div class="payable-hero-actions"><a class="payable-secondary-btn" href="@RutaCuentasPorPagar("/cuentas-por-pagar", EContaxRoutes.CuentasPorPagar)"><i class="ri-arrow-left-line"></i>Volver a cuentas por pagar</a></div></div>
        <div class="payable-hero-mark" aria-hidden="true"><i class="ri-file-chart-line"></i></div>
    </section>
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger border-0 rounded-3">@error</div> }
    @if (cargando) { <section class="payable-state">Cargando estados de cuenta...</section> }
    else
    {
        <section class="payable-metrics"><article class="payable-metric is-primary"><span>Saldo total</span><strong>$@resumen.Sum(x => x.SaldoActual).ToString("N2")</strong><small>Cartera de proveedores</small><i class="ri-wallet-3-line"></i></article><article class="payable-metric is-info"><span>Proveedores con saldo</span><strong>@resumen.Count(x => x.SaldoActual > 0)</strong><small>Con cuentas pendientes</small><i class="ri-team-line"></i></article><article class="payable-metric is-danger"><span>Cuentas vencidas</span><strong>@resumen.Sum(x => x.CuentasVencidas)</strong><small>Requieren atención</small><i class="ri-alarm-warning-line"></i></article><article class="payable-metric is-success"><span>Total pagado</span><strong>$@resumen.Sum(x => x.TotalPagado).ToString("N2")</strong><small>Pagos registrados</small><i class="ri-line-chart-line"></i></article></section>
        <section class="payable-flow" aria-label="Flujo del estado de cuenta"><div class="payable-flow-step is-active"><span>1</span><div><strong>Buscar proveedor</strong><small>Identifica la cuenta</small></div></div><i class="ri-arrow-right-line"></i><div class="payable-flow-step"><span>2</span><div><strong>Revisar saldo</strong><small>Consulta cargos y pagos</small></div></div><i class="ri-arrow-right-line"></i><div class="payable-flow-step"><span>3</span><div><strong>Ver movimientos</strong><small>Revisa el historial</small></div></div><i class="ri-arrow-right-line"></i><div class="payable-flow-step"><span>4</span><div><strong>Registrar abono</strong><small>Aplica el pago pendiente</small></div></div></section>
        <section class="payable-board"><div class="payable-board-head"><div><span class="payable-section-kicker">Resumen de proveedores</span><h2>Listado por proveedor</h2></div><span class="payable-payment-total">@ResumenFiltrado.Count() proveedor(s)</span></div><div class="payable-filters"><label class="payable-search"><i class="ri-search-line"></i><input @bind="busqueda" @bind:event="oninput" placeholder="Buscar proveedor o RUC..." /></label><label class="payable-select"><span>Saldo</span><select @bind="saldoFiltro"><option value="TODOS">Todos</option><option value="CON_SALDO">Con saldo</option><option value="SALDADOS">Saldados</option></select></label></div><div class="payable-table-wrap"><table class="payable-table payable-statement-table"><thead><tr><th>Proveedor</th><th class="text-end">Facturado</th><th class="text-end">Pagado</th><th class="text-end">Saldo</th><th>Cuentas</th><th></th></tr></thead><tbody>
            @foreach (var item in ResumenFiltrado)
            {
                <tr @key="item.IdentificacionProveedor" class="@(detalle?.IdentificacionProveedor == item.IdentificacionProveedor ? "is-selected" : "")" @onclick="() => VerDetalleAsync(item)"><td><strong>@item.Proveedor</strong><small>@item.IdentificacionProveedor</small></td><td class="text-end">$@item.TotalFacturado.ToString("N2")</td><td class="text-end">$@item.TotalPagado.ToString("N2")</td><td class="text-end payable-balance">$@item.SaldoActual.ToString("N2")</td><td>@item.CuentasPendientes pendientes@if (item.CuentasVencidas > 0) { <span class="payable-overdue"> · @item.CuentasVencidas vencidas</span> }</td><td class="text-end"><button type="button" class="payable-primary-btn payable-small-btn" @onclick:stopPropagation="true" @onclick="() => VerDetalleAsync(item)"><i class="ri-eye-line"></i>Ver estado</button></td></tr>
            }
        </tbody></table></div></section>
        @if (detalle is not null)
        {
            <section class="payable-detail-card"><div class="payable-detail-head"><div><span class="payable-section-kicker">Detalle del proveedor</span><h2>@detalle.Proveedor</h2><small>@detalle.IdentificacionProveedor</small></div><strong class="payable-balance">Saldo: $@detalle.SaldoActual.ToString("N2")</strong></div><div class="payable-table-wrap"><table class="payable-table"><thead><tr><th>Fecha</th><th>Documento</th><th>Concepto</th><th class="text-end">Cargo</th><th class="text-end">Pago</th><th class="text-end">Saldo</th></tr></thead><tbody>@foreach (var movimiento in detalle.Movimientos) { <tr @key="@(movimiento.Fecha.Ticks.ToString() + movimiento.Documento + movimiento.Tipo)"><td>@movimiento.Fecha.ToString("dd/MM/yyyy")</td><td>@movimiento.Documento</td><td>@movimiento.Concepto</td><td class="text-end">@(movimiento.Debito == 0 ? "-" : "$" + movimiento.Debito.ToString("N2"))</td><td class="text-end">@(movimiento.Credito == 0 ? "-" : "$" + movimiento.Credito.ToString("N2"))</td><td class="text-end payable-balance">$@movimiento.Saldo.ToString("N2")</td></tr> }</tbody></table></div>
            @if (detalle.Pagos.Any())
            {
                <div class="payable-history"><h3>Historial de pagos y abonos</h3><div class="payable-table-wrap"><table class="payable-table"><thead><tr><th>Fecha</th><th>Documento</th><th>Forma de pago</th><th>Referencia / comprobante</th><th>Observación</th><th class="text-end">Monto</th></tr></thead><tbody>@foreach (var pago in detalle.Pagos) { <tr @key="@(pago.IdPago == 0 ? pago.IdFactura.ToString() + pago.FechaPago.Ticks : pago.IdPago.ToString())"><td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td><td>@pago.NumeroDocumento</td><td>@(string.IsNullOrWhiteSpace(pago.FormaPago) ? "-" : pago.FormaPago)</td><td>@(string.IsNullOrWhiteSpace(pago.Referencia) ? "-" : pago.Referencia)</td><td>@(string.IsNullOrWhiteSpace(pago.Observacion) ? "-" : pago.Observacion)</td><td class="text-end payable-balance">$@pago.Monto.ToString("N2")</td></tr> }</tbody></table></div></div>
            }
            @if (detalle.SaldoActual > 0)
            {
                <div class="payable-detail-actions"><a class="payable-primary-btn" href="@RutaCuentasPorPagar("/cuentas-por-pagar/registrar", EContaxRoutes.CuentasPorPagarRegistrar)"><i class="ri-hand-coin-line"></i>Registrar abono</a></div>
            }
            </section>
        }
    }
</div>

@code {
    private List<EstadoCuentaProveedorResumenVM> resumen = new();
    private EstadoCuentaProveedorDetalleVM? detalle;
    private int currentUserId;
    private bool cargando = true;
    private string error = "";
    private string busqueda = "";
    private string saldoFiltro = "TODOS";

    private bool EsEContaxContext => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("e-contax/", StringComparison.OrdinalIgnoreCase);

    private string RutaCuentasPorPagar(string efact, string econtax) => EsEContaxContext ? econtax : efact;
    private IEnumerable<EstadoCuentaProveedorResumenVM> ResumenFiltrado => resumen.Where(x =>
        (string.IsNullOrWhiteSpace(busqueda) || x.Proveedor.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || x.IdentificacionProveedor.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) &&
        (saldoFiltro == "TODOS" || (saldoFiltro == "CON_SALDO" && x.SaldoActual > 0) || (saldoFiltro == "SALDADOS" && x.SaldoActual <= 0)));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id) ? id : 0;
        if (currentUserId <= 0) { Navigation.NavigateTo("/login", true); return; }
        try
        {
            resumen = await CuentasPagarService.ObtenerResumenProveedoresAsync(currentUserId);
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar los estados de cuenta: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VerDetalleAsync(EstadoCuentaProveedorResumenVM proveedor)
    {
        error = "";
        try
        {
            detalle = await CuentasPagarService.ObtenerDetalleProveedorAsync(currentUserId, proveedor.IdentificacionProveedor);
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar el estado del proveedor: {ex.Message}";
        }
    }
}
