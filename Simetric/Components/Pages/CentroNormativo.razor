@page "/configuracion/centro-normativo"
@using Microsoft.AspNetCore.Authorization
@using Simetric.Models
@using Simetric.Services
@attribute [Authorize]
@inject NormativaLegalService NormativaService

<PageTitle>Centro normativo | Numerica e-fact</PageTitle>

<div class="legal-page animate__animated animate__fadeIn">
    <header class="legal-hero">
        <div class="legal-hero-copy">
            <span class="legal-eyebrow">Base legal de E-Fact</span>
            <h1>Centro normativo</h1>
            <p>Encuentra en un solo lugar las disposiciones que respaldan tus comprobantes electrónicos y aplícalas con mayor seguridad.</p>
            <div class="legal-hero-highlights">
                <span><i class="ri-checkbox-circle-fill"></i> Contenido organizado</span>
                <span><i class="ri-links-line"></i> Fuentes oficiales</span>
                <span><i class="ri-refresh-line"></i> Consulta actualizada</span>
            </div>
        </div>
        <div class="legal-hero-art" aria-hidden="true">
            <span class="legal-orbit orbit-one"></span>
            <span class="legal-orbit orbit-two"></span>
            <div class="legal-hero-icon"><i class="ri-scales-3-line"></i></div>
            <span class="legal-float-icon icon-book"><i class="ri-book-2-line"></i></span>
            <span class="legal-float-icon icon-shield"><i class="ri-shield-check-line"></i></span>
        </div>
    </header>

    <section class="legal-summary-grid">
        <article class="legal-summary-card">
            <span class="summary-icon blue"><i class="ri-file-list-3-line"></i></span>
            <div><strong>@normativas.Count</strong><span>Normativas disponibles</span></div>
        </article>
        <article class="legal-summary-card">
            <span class="summary-icon cyan"><i class="ri-folder-shield-2-line"></i></span>
            <div><strong>@categorias.Count</strong><span>Categorías organizadas</span></div>
        </article>
        <article class="legal-summary-card">
            <span class="summary-icon green"><i class="ri-verified-badge-line"></i></span>
            <div><strong>@UltimaVerificacion</strong><span>Última verificación</span></div>
        </article>
    </section>

    <section class="legal-explorer">
        <div class="legal-explorer-head">
            <div>
                <span class="section-kicker">Biblioteca normativa</span>
                <h2>¿Qué necesitas consultar?</h2>
                <p>Busca por palabra clave o selecciona una categoría.</p>
            </div>
            <span class="legal-result-count">@NormativasFiltradas.Count() resultado(s)</span>
        </div>

        <label class="legal-search">
            <span class="search-icon"><i class="ri-search-line"></i></span>
            <input value="@busqueda" @oninput="ActualizarBusqueda" placeholder="Ej.: facturas, notas de crédito, anulación..." />
            @if (!string.IsNullOrWhiteSpace(busqueda))
            {
                <button type="button" title="Limpiar búsqueda" @onclick="LimpiarBusqueda"><i class="ri-close-line"></i></button>
            }
        </label>

        <div class="legal-categories" aria-label="Filtrar por categoría">
            <button type="button" class="@(string.IsNullOrWhiteSpace(categoria) ? "active" : "")" @onclick="() => SeleccionarCategoria(string.Empty)">
                <i class="ri-apps-2-line"></i> Todas
            </button>
            @foreach (var item in categorias)
            {
                <button type="button" class="@(categoria == item ? "active" : "")" @onclick="() => SeleccionarCategoria(item)">
                    @item
                </button>
            }
        </div>
    </section>

    @if (cargando)
    {
        <div class="legal-state"><div class="spinner-border text-primary"></div><span>Cargando normativa...</span></div>
    }
    else if (!NormativasFiltradas.Any())
    {
        <div class="legal-state">
            <span class="state-illustration"><i class="ri-file-search-line"></i></span>
            <strong>No encontramos resultados</strong>
            <span>Prueba con otra palabra o categoría.</span>
            <button type="button" @onclick="RestablecerFiltros">Mostrar toda la normativa</button>
        </div>
    }
    else
    {
        <section class="legal-grid">
            @foreach (var norma in NormativasFiltradas)
            {
                <article class="legal-card">
                    <span class="legal-card-accent"></span>
                    <div class="legal-card-top">
                        <span class="legal-category">@norma.Categoria</span>
                        <span class="legal-status"><i class="ri-checkbox-circle-fill"></i> @norma.EstadoNorma</span>
                    </div>
                    <div class="legal-document-icon"><i class="@IconoCategoria(norma.Categoria)"></i></div>
                    <span class="legal-code"><i class="ri-hashtag"></i>@norma.Codigo</span>
                    <h2>@norma.Titulo</h2>
                    <p>@norma.Resumen</p>

                    @if (normaSeleccionada == norma.Id)
                    {
                        <div class="legal-content">@norma.Contenido</div>
                        <div class="legal-metadata">
                            @if (norma.FechaPublicacion.HasValue)
                            {
                                <span><i class="ri-calendar-line"></i> Publicada: @norma.FechaPublicacion.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (norma.FechaVigencia.HasValue)
                            {
                                <span><i class="ri-time-line"></i> Vigente desde: @norma.FechaVigencia.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (norma.FechaUltimaVerificacion.HasValue)
                            {
                                <span><i class="ri-verified-badge-line"></i> Verificada: @norma.FechaUltimaVerificacion.Value.ToString("dd/MM/yyyy")</span>
                            }
                        </div>
                    }

                    <footer>
                        <button type="button" class="legal-detail-btn" @onclick="() => AlternarDetalle(norma.Id)">
                            <i class="@(normaSeleccionada == norma.Id ? "ri-arrow-up-s-line" : "ri-book-open-line")"></i>
                            @(normaSeleccionada == norma.Id ? "Ocultar detalle" : "Ver detalle")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(norma.UrlOficial))
                        {
                            <a href="@norma.UrlOficial" target="_blank" rel="noopener noreferrer">
                                Fuente oficial <i class="ri-external-link-line"></i>
                            </a>
                        }
                    </footer>
                </article>
            }
        </section>
    }

    <aside class="legal-notice">
        <span><i class="ri-information-line"></i></span>
        <div>
            <strong>Información importante</strong>
            <p>Este centro facilita la consulta y no sustituye el texto publicado por el SRI. Para decisiones tributarias, revisa siempre la fuente oficial.</p>
        </div>
    </aside>
</div>

@code {
    private List<NormativaLegal> normativas = [];
    private List<string> categorias = [];
    private bool cargando = true;
    private string busqueda = string.Empty;
    private string categoria = string.Empty;
    private int? normaSeleccionada;
    private string UltimaVerificacion => normativas
        .Where(x => x.FechaUltimaVerificacion.HasValue)
        .Select(x => x.FechaUltimaVerificacion!.Value)
        .DefaultIfEmpty()
        .Max() is var fecha && fecha != default
            ? fecha.ToString("MMM yyyy", new System.Globalization.CultureInfo("es-EC"))
            : "Por verificar";

    private IEnumerable<NormativaLegal> NormativasFiltradas
    {
        get
        {
            var resultado = normativas.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(categoria))
                resultado = resultado.Where(x => x.Categoria.Equals(categoria, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(busqueda))
            {
                var texto = busqueda.Trim();
                resultado = resultado.Where(x =>
                    x.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                    x.Titulo.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                    x.Resumen.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                    x.Contenido.Contains(texto, StringComparison.OrdinalIgnoreCase));
            }

            return resultado;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            normativas = await NormativaService.ObtenerPublicadasAsync();
            categorias = normativas.Select(x => x.Categoria)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();
        }
        finally
        {
            cargando = false;
        }
    }

    private void ActualizarBusqueda(ChangeEventArgs args) => busqueda = args.Value?.ToString() ?? string.Empty;
    private void LimpiarBusqueda() => busqueda = string.Empty;
    private void SeleccionarCategoria(string valor) => categoria = valor;
    private void RestablecerFiltros()
    {
        busqueda = string.Empty;
        categoria = string.Empty;
    }

    private void AlternarDetalle(int id) => normaSeleccionada = normaSeleccionada == id ? null : id;

    private static string IconoCategoria(string valor) => valor.ToLowerInvariant() switch
    {
        var x when x.Contains("factura") => "ri-file-list-3-line",
        var x when x.Contains("crédito") => "ri-refund-2-line",
        var x when x.Contains("débito") => "ri-bill-line",
        var x when x.Contains("entrega") => "ri-send-plane-line",
        var x when x.Contains("requisito") => "ri-list-check-3",
        _ => "ri-book-open-line"
    };
}
