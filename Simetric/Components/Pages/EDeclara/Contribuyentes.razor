    // Métodos de Validación Ecuatoriana Oficiales
    private static bool ValidarCedulaEcuatoriana(string cedula)
    {
        cedula = new string((cedula ?? "").Where(char.IsDigit).ToArray());

        if (cedula.Length != 10)
            return false;

        int[] coeficientes = { 2, 1, 2, 1, 2, 1, 2, 1, 2 };
        
        if (!int.TryParse(cedula[..2], out var provincia) || provincia < 1 || provincia > 24)
            return false;

        var tercerDigito = cedula[2] - '0';
        if (tercerDigito > 5)
            return false;

        var suma = 0;
        for (var i = 0; i < 9; i++)
        {
            var valor = (cedula[i] - '0') * coeficientes[i];
            suma += valor > 9 ? valor - 9 : valor;
        }

        var digitoRecibido = cedula[9] - '0';
        var digitoCalculado = (10 - (suma % 10)) % 10;
        return digitoCalculado == digitoRecibido;
    }

    private static bool ValidarRucEcuatoriano(string ruc)
    {
        ruc = new string((ruc ?? "").Where(char.IsDigit).ToArray());

        if (ruc.Length != 13)
            return false;

        if (!int.TryParse(ruc[..2], out var provincia) || provincia < 1 || provincia > 24)
            return false;

        var tercerDigito = ruc[2] - '0';

        return tercerDigito switch
        {
            <= 5 => ValidarCedulaEcuatoriana(ruc[..10]) && ruc.EndsWith("001", StringComparison.Ordinal),
            6 => ValidarRucPublico(ruc),
            9 => ValidarRucPrivado(ruc),
            _ => false
        };
    }

    private static bool ValidarRucPrivado(string ruc) => ruc[10..] != "000";

    private static bool ValidarRucPublico(string ruc) => ruc[9..] != "0000";

