@page "/e-declara/contribuyentes"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Controllers
@using Simetric.Components
@using Simetric.Models
@using System.Text
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Contribuyentes | E-Declara</PageTitle>

<div class="entity-shell edeclara-contribuyentes">
    <section class="plan-quota-strip" aria-label="Cupo de contribuyentes del plan">
        <span class="quota-icon"><i class="ri-group-line"></i></span>
        <div class="quota-copy"><small>Cupo de contribuyentes</small><strong>@actualContribuyentesActivos de @limiteContribuyentes utilizados</strong></div>
        <div class="quota-progress"><i style="width:@PorcentajeCupo%"></i></div>
        <span class="quota-remaining"><strong>@CuposDisponibles</strong><small>disponibles</small></span>
    </section>

    <section class="quick-action-bar" aria-label="Acciones rápidas de contribuyentes">
        <button type="button" class="quick-action-card" @onclick="AbrirAsistenteAsync">
            <span class="quick-action-icon"><i class="ri-sparkling-line"></i></span>
            <span><strong>Crear contribuyente con IA</strong><small>Abre el bot para asistirte</small></span>
        </button>
        <button type="button" class="quick-action-card" @onclick="InformarImportacion">
            <span class="quick-action-icon quick-action-icon-green"><i class="ri-file-excel-2-line"></i></span>
            <span><strong>Importar desde Excel</strong><small>Carga masiva de contribuyentes</small></span>
        </button>
        <button type="button" class="quick-action-card" @onclick="ExportarContribuyentesAsync">
            <span class="quick-action-icon quick-action-icon-blue"><i class="ri-download-line"></i></span>
            <span><strong>Exportar todos</strong><small>Descargar archivo CSV</small></span>
        </button>
        <div class="quick-action-search">
            <i class="ri-search-line"></i>
            <input placeholder="Buscar por nombre, identificación o correo..." value="@filtro" @oninput='e => { filtro = e.Value?.ToString() ?? ""; paginaActual = 1; }' />
        </div>
        <button type="button" class="filter-toggle-btn is-enabled @(mostrarPanelFiltros ? "active" : "")" @onclick="AlternarPanelFiltros">
            <i class="ri-filter-3-line"></i>
            <span>Filtros</span>
            @if (HayFiltrosActivos)
            {
                <span class="filter-indicator" aria-label="Filtros activos"></span>
            }
        </button>
    </section>

    @if (mostrarPanelFiltros)
    {
        <section class="toolbar-card filters-panel">
            <div class="toolbar-secondary-actions">
                <div class="filter-box">
                    <label class="filter-label" style="color:#6C63FF">Tipo</label>
                    <select class="filter-select" value="@filtroTipoContribuyente"
                            @onchange='e => { filtroTipoContribuyente = e.Value?.ToString() ?? "todos"; paginaActual = 1; }'>
                        <option value="todos">Todos</option>
                        <option value="natural">Persona Natural</option>
                        <option value="sociedad">Sociedad / Persona Jurídica</option>
                    </select>
                </div>
                <div class="filter-box">
                    <label class="filter-label" style="color:#6C63FF">Registros</label>
                    <select class="filter-select" value="@registrosPorPagina"
                            @onchange='e => { registrosPorPagina = int.Parse(e.Value?.ToString() ?? "10"); paginaActual = 1; }'>
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                    </select>
                </div>
                <button type="button" class="secondary-btn" @onclick="() => CargarTodo(true)">
                    <i class="ri-refresh-line"></i> Refrescar
                </button>
                <button type="button" class="secondary-btn" @onclick="LimpiarFiltros" disabled="@(!HayFiltrosActivos)">
                    <i class="ri-eraser-line"></i> Limpiar filtros
                </button>
            </div>
        </section>
    }

    <section class="entity-grid">

        @* ── Tabla (Columna Izquierda) ── *@
        <div class="grid-left-col">
            <section class="table-card">
                <div class="table-card-head">
                    <div>
                        <span class="table-kicker" style="color:#6C63FF">Listado activo</span>
                        <h3>Contribuyentes registrados</h3>
                    </div>
                    <div class="table-head-actions">
                        <span class="table-badge" style="background:rgba(108,99,255,0.1);color:#6C63FF">@ContribuFiltrados.Count() registros</span>
                        <button type="button" class="primary-btn" @onclick="PrepararNuevoContribuyente" disabled="@limiteExcedido">
                            <i class="ri-add-line"></i><span>Nuevo contribuyente</span>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="status-banner status-banner-info"><i class="ri-information-line"></i> @mensaje</div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMsg))
                {
                    <div class="status-banner status-banner-error"><i class="ri-error-warning-line"></i> @errorMsg</div>
                }

                @if (cargando)
                {
                    <div class="state-card">
                        <span class="spinner-border" role="status" style="color:#6C63FF"></span>
                        <h3 class="mt-2">Cargando contribuyentes</h3>
                    </div>
                }
                else if (!ContribuFiltrados.Any())
                {
                    <div class="state-card state-card-empty">
                        <div class="state-icon"><i class="ri-user-star-line"></i></div>
                        <h3>No hay contribuyentes para mostrar</h3>
                        <p>Ajusta la búsqueda o registra un nuevo contribuyente.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table entity-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:70px">ID</th>
                                    <th>Contribuyente</th>
                                    <th>Identificación</th>
                                    <th>Estado</th>
                                    <th class="text-center col-acciones">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in ContribuPaginados)
                                {
                                    <tr>
                                        <td>
                                            <span class="code-pill code-pill-id">#@c.CodContribuyente</span>
                                        </td>
                                        <td>
                                            <div class="cell-main cell-main-stacked">
                                                <strong>@NombreCompleto(c)</strong>
                                                @if (!string.IsNullOrWhiteSpace(c.Nombrecomercial))
                                                {
                                                    <span class="meta-line">
                                                        <i class="ri-building-line"></i>
                                                        <span>@c.Nombrecomercial</span>
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.Correo))
                                                {
                                                    <span class="meta-line">
                                                        <i class="ri-mail-line"></i>
                                                        <span>@c.Correo</span>
                                                    </span>
                                                }
                                                @if (c.CorreosAdicionales.Any())
                                                {
                                                    @foreach (var extra in c.CorreosAdicionales)
                                                    {
                                                        <span class="meta-line">
                                                            <i class="ri-mail-add-line"></i>
                                                            <span>@extra</span>
                                                        </span>
                                                    }
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="code-pill">
                                                @(string.IsNullOrWhiteSpace(c.Numeroidentificacion) ? "Sin ID" : c.Numeroidentificacion)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="@(c.Estado == true ? "mini-status" : "mini-status mini-status-inactive")">
                                                @(c.Estado == true ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td class="text-center col-acciones">
                                            <div class="action-group">
                                                <button type="button" class="action-btn action-view" title="Ver"
                                                        @onclick="() => AbrirDetalleAsync(c)">
                                                    <i class="ri-eye-line"></i>
                                                </button>
                                                @if (c.Estado == true)
                                                {
                                                    <button type="button" class="action-btn action-view" title="Gestionar declaraciones"
                                                            @onclick="() => IrADeclaraciones(c)">
                                                        <i class="ri-file-list-3-line"></i>
                                                    </button>
                                                }
                                                <button type="button" class="action-btn action-edit" title="Editar"
                                                        @onclick="() => CargarEdicion(c)">
                                                    <i class="ri-pencil-line"></i>
                                                </button>
                                                @if (c.Estado == true)
                                                {
                                                    <button type="button" class="action-btn action-delete" title="Desactivar"
                                                            @onclick="() => ConfirmarDesactivar(c)">
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="action-btn action-activate" title="Activar"
                                                            @onclick="() => ConfirmarActivar(c)">
                                                        <i class="ri-checkbox-circle-line"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="table-pagination">
                        <span>Mostrando @PrimerReg-@UltimoReg de @TotalFiltrados registros</span>
                        <div class="pagination-actions">
                            <button class="pagination-btn" disabled="@(paginaActual <= 1)"
                                    @onclick="() => paginaActual--">
                                <i class="ri-arrow-left-s-line"></i>
                            </button>
                            <strong>@paginaActual / @TotalPaginas</strong>
                            <button class="pagination-btn" disabled="@(paginaActual >= TotalPaginas)"
                                    @onclick="() => paginaActual++">
                                <i class="ri-arrow-right-s-line"></i>
                            </button>
                        </div>
                    </div>
                }
            </section>
        </div>

        @* ── Modal de formulario o detalle ── *@
        @if (mostrarEditor || enVista is not null)
        {
        <div class="contribuyente-modal-overlay" @onclick="CerrarEditor">
        <div class="grid-right-col contribuyente-modal" role="dialog" aria-modal="true" aria-label="Contribuyente" @onclick:stopPropagation>
            @if (enVista is not null)
            {
                @* Vista de Detalle (Reemplaza al formulario) *@
                <section class="editor-card entity-editor-card detail-card-interactive">
                    <div class="editor-head" style="border-bottom: 1px solid rgba(108, 99, 255, 0.15)">
                        <div>
                            <span class="panel-kicker" style="color:#6C63FF">Detalle contribuyente</span>
                            <h3>@NombreCompleto(enVista)</h3>
                            <p>Código contribuyente: #@enVista.CodContribuyente</p>
                        </div>
                        <button class="detail-close-btn" @onclick="CerrarEditor">&times;</button>
                    </div>

                    <div class="editor-body">
                        <div class="detail-sections">
                            <section class="detail-section">
                                <h4 class="detail-section-title">Datos principales</h4>
                                <div class="detail-grid">
                                    <div class="detail-item">
                                        <span>Identificación</span>
                                        <strong>@(enVista.Numeroidentificacion ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Estado</span>
                                        <strong>@(enVista.Estado == true ? "Activo" : "Inactivo")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Correo</span>
                                        <strong>@(enVista.Correo ?? "Sin correo")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Obligado contabilidad</span>
                                        <strong>@(enVista.Oblgconta ?? "No definido")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Persona natural</span>
                                        <strong>@(enVista.PersonaNatural == true ? "Sí" : "No")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Contribuyente especial</span>
                                        <strong>@(enVista.ContribuyenteEspecial == true ? "Sí" : "No")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>N° Contribuyente</span>
                                        <strong>@(enVista.NumContribuyente ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Periodicidad IVA</span>
                                        <strong>@(enVista.PeriodicidadIva ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Periodicidad Renta</span>
                                        <strong>@(enVista.PeriodicidadRenta ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item detail-item-full">
                                        <span>Fecha Declaración</span>
                                        <strong>@(enVista.FechaDeclaracion?.ToString("dd/MM/yyyy") ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item detail-item-full">
                                        <span>Actividad</span>
                                        <strong>@(enVista.ActividadContribuyente ?? "Sin datos")</strong>
                                    </div>
                                </div>
                            </section>
                            
                            @if (enVista.CorreosAdicionales.Any())
                            {
                                <section class="detail-section">
                                    <h4 class="detail-section-title">Correos Adicionales</h4>
                                    <div class="detail-note">
                                        @foreach (var extra in enVista.CorreosAdicionales)
                                        {
                                            <div style="margin-bottom: 0.25rem;">
                                                <strong><i class="ri-mail-line"></i> @extra</strong>
                                            </div>
                                        }
                                    </div>
                                </section>
                            }

                            <section class="detail-section">
                                <h4 class="detail-section-title">Contacto</h4>
                                <div class="detail-grid">
                                    <div class="detail-item">
                                        <span>Teléfono</span>
                                        <strong>@(enVista.Telefonoconvencional ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Celular</span>
                                        <strong>@(enVista.Celular ?? "Sin datos")</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>País</span>
                                        <strong>@(string.IsNullOrWhiteSpace(GetPaisNombre(enVista.Pais)) ? "Sin país" : GetPaisNombre(enVista.Pais))</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Provincia</span>
                                        <strong>@(string.IsNullOrWhiteSpace(GetProvinciaNombre(enVista.Provincia)) ? "Sin provincia" : GetProvinciaNombre(enVista.Provincia))</strong>
                                    </div>
                                    <div class="detail-item">
                                        <span>Ciudad</span>
                                        <strong>@(string.IsNullOrWhiteSpace(GetCiudadNombre(enVista.Ciudad)) ? "Sin ciudad" : GetCiudadNombre(enVista.Ciudad))</strong>
                                    </div>
                                    <div class="detail-item detail-item-full">
                                        <span>Dirección</span>
                                        <strong>@(enVista.Direccion ?? "Sin datos")</strong>
                                    </div>
                                </div>
                            </section>
                            
                            @if (!string.IsNullOrWhiteSpace(enVista.Observaciones))
                            {
                                <div class="detail-note">
                                    <span>Observaciones</span>
                                    <strong>@enVista.Observaciones</strong>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="detail-modal-footer" style="padding: 1rem 1.5rem; border-top: 1px solid rgba(108, 99, 255, 0.15); display: flex; justify-content: flex-end; gap: 0.75rem;">
                        <button class="secondary-btn" @onclick="() => CargarEdicion(enVista)">Editar Datos</button>
                        <button class="primary-btn" style="background:#6C63FF" @onclick="CerrarEditor">Cerrar</button>
                    </div>
                </section>
            }
            else
            {
                @* Formulario de Registro / Edición *@
                <section class="editor-card entity-editor-card contribuyente-form-card">
                    <div class="editor-head contribuyente-form-head">
                        <div>
                            <span class="panel-kicker">Catálogo tributario</span>
                            <h3>@(editando ? "Editar contribuyente" : "Registrar contribuyente")</h3>
                        </div>
                        <button type="button" class="contribuyente-modal-close" @onclick="CerrarEditor" aria-label="Cerrar">&times;</button>
                    </div>

                    <div class="editor-body entity-form-legacy">
                        <EditForm EditContext="editContext" OnSubmit="Guardar">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3 fw-semibold" />

                            <section class="contribuyente-form-section">
                            <button type="button" class="contribuyente-section-title" @onclick="() => AlternarSeccionFormulario(1)" aria-expanded="@seccionesFormularioAbiertas.Contains(1)"><span>1</span><strong>Información básica</strong><i class="ri-@(seccionesFormularioAbiertas.Contains(1) ? "arrow-up-s-line" : "arrow-down-s-line")"></i></button>
                            @if (seccionesFormularioAbiertas.Contains(1))
                            {
                            <div class="contribuyente-section-body">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Tipo de Contribuyente *</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="modeloPersonaNaturalString" style="border-color:#6C63FF">
                                    <option value="true">Persona Natural</option>
                                    <option value="false">Sociedad / Persona Jurídica</option>
                                </InputSelect>
                            </div>

                            <div class="row mb-2">
                                <div class="col">
                                    <label class="form-label small fw-bold">Tipo identificación *</label>
                                    <InputSelect class="form-select form-select-sm"
                                                 Value="@modelo.Tipoidentificacion"
                                                 ValueExpression="() => modelo.Tipoidentificacion"
                                                 ValueChanged="(string val) => { modelo.Tipoidentificacion = val; CalcularFechaDeclaracion(); }">
                                        <option value="">-- Seleccione --</option>
                                        @foreach (var id in identificaciones)
                                        {
                                            <option value="@id.Codigo">@id.Descripcion</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => modelo.Tipoidentificacion)" class="text-danger small" />
                                </div>
                                <div class="col">
                                    <label class="form-label small fw-bold">N° Identificación *</label>
                                    <InputText class="form-control form-control-sm" 
                                               Value="@modelo.Numeroidentificacion" 
                                               ValueExpression="() => modelo.Numeroidentificacion" 
                                               ValueChanged="OnIdentificacionInput" />
                                    <ValidationMessage For="@(() => modelo.Numeroidentificacion)" class="text-danger small" />
                                </div>
                            </div>

                            @if (modeloPersonaNatural)
                            {
                                <div class="row mb-2">
                                    <div class="col">
                                        <label class="form-label small fw-bold">Apellidos * </label>
                                        <InputText class="form-control form-control-sm" 
                                                   Value="@modelo.Apellidos" 
                                                   ValueExpression="() => modelo.Apellidos" 
                                                   ValueChanged="OnApellidosInput" 
                                                   placeholder="Ej: Pérez Gómez" />
                                        <ValidationMessage For="@(() => modelo.Apellidos)" class="text-danger small" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label small fw-bold">Nombres *</label>
                                        <InputText class="form-control form-control-sm" 
                                                   Value="@modelo.Nombres" 
                                                   ValueExpression="() => modelo.Nombres" 
                                                   ValueChanged="OnNombresInput" 
                                                   placeholder="Ej: Juan Carlos" />
                                        <ValidationMessage For="@(() => modelo.Nombres)" class="text-danger small" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row mb-2">
                                    <div class="col">
                                        <label class="form-label small fw-bold">Nombre comercial *</label>
                                        <InputText class="form-control form-control-sm" @bind-Value="modelo.Nombrecomercial" />
                                        <ValidationMessage For="@(() => modelo.Nombrecomercial)" class="text-danger small" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label small fw-bold">Razón social *</label>
                                        <InputText class="form-control form-control-sm" @bind-Value="modelo.Nombrerazonsocial" />
                                        <ValidationMessage For="@(() => modelo.Nombrerazonsocial)" class="text-danger small" />
                                    </div>
                                </div>
                            }
                            </div>
                            }
                            </section>

                            @* Sección de correos múltiples *@
                            <section class="contribuyente-form-section">
                            <button type="button" class="contribuyente-section-title" @onclick="() => AlternarSeccionFormulario(2)" aria-expanded="@seccionesFormularioAbiertas.Contains(2)"><span>2</span><strong>Contacto</strong><i class="ri-@(seccionesFormularioAbiertas.Contains(2) ? "arrow-up-s-line" : "arrow-down-s-line")"></i></button>
                            @if (seccionesFormularioAbiertas.Contains(2))
                            {
                            <div class="contribuyente-section-body">
                            <div class="email-fields-shell mb-3">
                                <div class="form-group">
                                    <label class="form-label small fw-bold">Correo Principal *</label>
                                    <div class="email-primary-row">
                                        <InputText type="email" @bind-Value="modelo.Correo" class="form-control form-control-sm" placeholder="correo@empresa.com" />
                                        <button type="button" class="email-add-icon-btn" @onclick="AgregarCorreoCampo" title="Agregar correo adicional">
                                            <i class="ri-add-line"></i>
                                        </button>
                                    </div>
                                    <ValidationMessage For="@(() => modelo.Correo)" class="text-danger small" />
                                </div>

                                @if (modelo.CorreosAdicionales.Any())
                                {
                                    <div class="email-extra-shell">
                                        <div class="email-extra-head">
                                            <label class="form-label small fw-bold mb-0">Correos adicionales</label>
                                            <button type="button" class="email-add-btn" @onclick="AgregarCorreoCampo">
                                                <i class="ri-add-line"></i>
                                                <span>Agregar otro correo</span>
                                            </button>
                                        </div>

                                        @for (var i = 0; i < modelo.CorreosAdicionales.Count; i++)
                                        {
                                            var index = i;
                                            <div class="email-extra-row">
                                                <InputText type="email" @bind-Value="modelo.CorreosAdicionales[index]" class="form-control form-control-sm" placeholder="adicional@empresa.com" />
                                                <button type="button" class="email-remove-btn" @onclick="() => EliminarCorreoAdicional(index)" title="Eliminar correo adicional">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="mb-2">
                                <label class="form-label small">Teléfono (opcional)</label>
                                <div class="phone-selector-row">
                                    <div class="phone-type-toggle" role="group" aria-label="Tipo de teléfono">
                                        <button type="button" class="@(tipoTelefono == "celular" ? "active" : "")" @onclick='() => tipoTelefono = "celular"'>Celular</button>
                                        <button type="button" class="@(tipoTelefono == "convencional" ? "active" : "")" @onclick='() => tipoTelefono = "convencional"'>Convencional</button>
                                    </div>
                                    <input class="form-control form-control-sm" type="tel" autocomplete="tel" placeholder="@(tipoTelefono == "celular" ? "Ej: 0998765432" : "Ej: 022345678")" @bind="TelefonoSeleccionado" />
                                </div>
                            </div>
                            </div>
                            }
                            </section>

                            <section class="contribuyente-form-section">
                            <button type="button" class="contribuyente-section-title" @onclick="() => AlternarSeccionFormulario(3)" aria-expanded="@seccionesFormularioAbiertas.Contains(3)"><span>3</span><strong>Información tributaria</strong><i class="ri-@(seccionesFormularioAbiertas.Contains(3) ? "arrow-up-s-line" : "arrow-down-s-line")"></i></button>
                            @if (seccionesFormularioAbiertas.Contains(3))
                            {
                            <div class="contribuyente-section-body">
                            <div class="row mb-2">
                                <div class="col">
                                    <label class="form-label small fw-bold">Obligado contabilidad *</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="modelo.Oblgconta">
                                        <option value="">-- Seleccione --</option>
                                        <option value="SI">SI</option>
                                        <option value="NO">NO</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => modelo.Oblgconta)" class="text-danger small" />
                                </div>
                                <div class="col">
                                    <label class="form-label small">N° Contribuyente</label>
                                    <InputText class="form-control form-control-sm" 
                                               Value="@modelo.NumContribuyente" 
                                               ValueExpression="() => modelo.NumContribuyente" 
                                               ValueChanged="OnNumContribuyenteInput" />
                                    <ValidationMessage For="@(() => modelo.NumContribuyente)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col">
                                    <label class="form-label small fw-bold">Periodicidad IVA *</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="modelo.PeriodicidadIva">
                                        <option value="">-- Seleccione --</option>
                                        <option value="Mensual">Mensual</option>
                                        <option value="Semestral">Semestral</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => modelo.PeriodicidadIva)" class="text-danger small" />
                                </div>
                                <div class="col">
                                    <label class="form-label small fw-bold">Periodicidad Renta *</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="modelo.PeriodicidadRenta">
                                        <option value="">-- Seleccione --</option>
                                        <option value="Régimen General">Régimen General</option>
                                        <option value="Régimen Emprendedor">Régimen Emprendedor</option>
                                        <option value="Régimen Negocio Popular">Régimen Negocio Popular</option>
                                        <option value="Régimen Mixto">Régimen Mixto</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => modelo.PeriodicidadRenta)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small fw-bold">Fecha Declaración *</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="modelo.FechaDeclaracion" />
                                <ValidationMessage For="@(() => modelo.FechaDeclaracion)" class="text-danger small" />
                            </div>
                            </div>
                            }
                            </section>

                            <section class="contribuyente-form-section">
                            <button type="button" class="contribuyente-section-title" @onclick="() => AlternarSeccionFormulario(4)" aria-expanded="@seccionesFormularioAbiertas.Contains(4)"><span>4</span><strong>Dirección</strong><i class="ri-@(seccionesFormularioAbiertas.Contains(4) ? "arrow-up-s-line" : "arrow-down-s-line")"></i></button>
                            @if (seccionesFormularioAbiertas.Contains(4))
                            {
                            <div class="contribuyente-section-body">
                            <div class="row mb-2">
                                <div class="col">
                                    <label class="form-label small fw-bold">País *</label>
                                    <InputSelect class="form-select form-select-sm"
                                                 Value="@modelo.Pais"
                                                 ValueExpression="() => modelo.Pais"
                                                 ValueChanged="async (int? val) => { modelo.Pais = val; await OnPaisChangedAsync(); }">
                                        <option value="">-- Seleccione País --</option>
                                        @foreach (var p in paises)
                                        {
                                            <option value="@p.IdPais">@p.Descripcion</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => modelo.Pais)" class="text-danger small" />
                                </div>
                                <div class="col">
                                    <label class="form-label small fw-bold">Provincia *</label>
                                    <InputSelect class="form-select form-select-sm"
                                                 Value="@modelo.Provincia"
                                                 ValueExpression="() => modelo.Provincia"
                                                 ValueChanged="async (int? val) => { modelo.Provincia = val; await OnProvinciaChangedAsync(); }"
                                                 disabled="@(modelo.Pais is null)">
                                        <option value="">-- Seleccione Provincia --</option>
                                        @foreach (var pr in ProvinciasDisponibles)
                                        {
                                            <option value="@pr.IdProvincia">@pr.Descripcion</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => modelo.Provincia)" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small fw-bold">Ciudad *</label>
                                <InputSelect class="form-select form-select-sm"
                                             @bind-Value="modelo.Ciudad"
                                             disabled="@(modelo.Provincia is null || !CiudadesDisponibles.Any())">
                                    <option value="">@(modelo.Provincia.HasValue ? "-- Seleccione Ciudad --" : "-- Seleccione una provincia --")</option>
                                    @foreach (var c in CiudadesDisponibles)
                                    {
                                        <option value="@c.IdCiudad">@c.Descripcion</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => modelo.Ciudad)" class="text-danger small" />
                            </div>

                            <div class="mb-2">
                                <label class="form-label small fw-bold">Dirección *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="modelo.Direccion" />
                                <ValidationMessage For="@(() => modelo.Direccion)" class="text-danger small" />
                            </div>
                            </div>
                            }
                            </section>

                            <section class="contribuyente-form-section">
                            <button type="button" class="contribuyente-section-title" @onclick="() => AlternarSeccionFormulario(5)" aria-expanded="@seccionesFormularioAbiertas.Contains(5)"><span>5</span><strong>Información adicional</strong><i class="ri-@(seccionesFormularioAbiertas.Contains(5) ? "arrow-up-s-line" : "arrow-down-s-line")"></i></button>
                            @if (seccionesFormularioAbiertas.Contains(5))
                            {
                            <div class="contribuyente-section-body">
                            <div class="mb-3">
                                <label class="form-label">Clave del SRI @(editando ? "(opcional)" : "*")</label>
                                <div class="sri-password-field">
                                    <input type="@(mostrarClaveSri ? "text" : "password")"
                                           class="form-control form-control-sm"
                                           autocomplete="new-password"
                                           maxlength="200"
                                           placeholder="@(claveSriConfiguradaEdicion ? "Escribe una nueva clave para reemplazarla" : "Ingresa la clave del SRI")"
                                           @bind="modelo.ClaveSri" />
                                    <button type="button" @onclick="() => mostrarClaveSri = !mostrarClaveSri" aria-label="Mostrar u ocultar clave SRI">
                                        <i class="ri-@(mostrarClaveSri ? "eye-off-line" : "eye-line")"></i>
                                    </button>
                                </div>
                                <small class="sri-password-help">La clave se almacena protegida y nunca se muestra nuevamente.</small>
                            </div>
                            <div class="mb-2 d-flex align-items-center gap-3 pt-2">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="modeloEspecial" id="chkEspecial" />
                                    <label class="form-check-label small" for="chkEspecial">Contribuyente especial</label>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small">Actividad del contribuyente</label>
                                <InputTextArea class="form-control form-control-sm" rows="2"
                                               @bind-Value="modelo.ActividadContribuyente" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small">Observaciones</label>
                                <InputTextArea class="form-control form-control-sm" rows="2"
                                               @bind-Value="modelo.Observaciones" />
                            </div>
                            </div>
                            }
                            </section>

                            @if (!editando && limiteExcedido)
                            {
                                <div class="status-banner status-banner-error mb-3" style="border-radius:12px; margin-bottom: 1rem; padding: 0.75rem;">
                                    <i class="ri-error-warning-line"></i>
                                    <span>Has alcanzado el límite de <strong>@limiteContribuyentes</strong> contribuyente(s) activo(s) para tu plan actual. Para agregar más, debes actualizar tu plan en la sección de Suscripción.</span>
                                </div>
                            }

                            <div class="form-actions entity-form-actions">
                                <button type="button" class="secondary-btn" @onclick="CerrarEditor">Cancelar</button>
                                <button type="submit" class="primary-btn"
                                        disabled="@(!editando && limiteExcedido)"
                                        style="background:#6C63FF;background-image:linear-gradient(135deg,#6C63FF,#8c85ff)">
                                    <i class="ri-save-line"></i>
                                    @(editando ? "Guardar cambios" : "Crear contribuyente")
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </section>
            }
        </div>
        </div>
        }
    </section>

    <section class="contributor-tips" aria-label="Consejos rápidos">
        <div class="tips-heading">
            <i class="ri-lightbulb-line"></i>
            <div><strong>Consejos rápidos</strong><span>Pequeñas acciones para mantener tu cartera tributaria al día.</span></div>
        </div>
        <div class="tips-grid">
            <article><span class="tip-icon"><i class="ri-shield-check-line"></i></span><div><strong>Verifica los datos tributarios</strong><small>Mantén identificación, correo y ubicación actualizados antes de declarar.</small></div></article>
            <article><span class="tip-icon tip-icon-purple"><i class="ri-pie-chart-line"></i></span><div><strong>Controla el cupo de tu plan</strong><small>Revisa la capacidad disponible antes de registrar otro contribuyente.</small></div></article>
        </div>
    </section>
</div>

@code {
    private int userId;
    private bool cargando = true;
    private string? mensaje;
    private string? errorMsg;

    private int limiteContribuyentes = 0;
    private int actualContribuyentesActivos = 0;
    private bool limiteExcedido = false;
    private int CuposDisponibles => Math.Max(0, limiteContribuyentes - actualContribuyentesActivos);
    private int PorcentajeCupo => limiteContribuyentes <= 0 ? 0 : Math.Min(100, actualContribuyentesActivos * 100 / limiteContribuyentes);

    private string filtro = "";
    private int registrosPorPagina = 10;
    private int paginaActual = 1;
    private bool mostrarPanelFiltros = true;
    private bool HayFiltrosActivos => filtroTipoContribuyente != "todos" || registrosPorPagina != 10;

    private ContribuyenteDto? enVista;
    private bool editando;
    private bool mostrarEditor;

    private List<ContribuyenteDto> contribuyentes = new();

    // Modelo formulario
    private ContribuyenteUpsertDto modelo = new();
    private bool modeloPersonaNatural = true;
    private bool modeloEspecial;
    private bool mostrarClaveSri;
    private bool claveSriConfiguradaEdicion;
    private readonly HashSet<int> seccionesFormularioAbiertas = new() { 1 };
    private string tipoTelefono = "celular";
    private string? TelefonoSeleccionado
    {
        get => tipoTelefono == "celular" ? modelo.Celular : modelo.Telefonoconvencional;
        set
        {
            if (tipoTelefono == "celular") modelo.Celular = value;
            else modelo.Telefonoconvencional = value;
        }
    }

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    private List<PaisLookupDto> paises = new();
    private List<ProvinciaLookupDto> provincias = new();
    private List<CiudadLookupDto> ciudades = new();
    private int? ecuadorPaisId;

    private IEnumerable<ProvinciaLookupDto> ProvinciasDisponibles =>
        provincias
            .Where(x => x.IdPais == modelo.Pais)
            .OrderBy(GetOrdenProvincia)
            .ThenBy(x => x.Descripcion);

    private IEnumerable<CiudadLookupDto> CiudadesDisponibles =>
        ciudades
            .Where(x => x.IdProvincia == modelo.Provincia)
            .OrderBy(x => x.Descripcion);

    private class PaisLookupDto
    {
        public int IdPais { get; set; }
        public string Descripcion { get; set; } = "";
    }

    private class ProvinciaLookupDto
    {
        public int IdProvincia { get; set; }
        public string Descripcion { get; set; } = "";
        public int? IdPais { get; set; }
    }

    private class CiudadLookupDto
    {
        public int IdCiudad { get; set; }
        public string Descripcion { get; set; } = "";
        public int? IdProvincia { get; set; }
    }

    // Toggle string para bindeo del dropdown de tipo de contribuyente
    private string modeloPersonaNaturalString
    {
        get => modeloPersonaNatural.ToString().ToLowerInvariant();
        set
        {
            if (bool.TryParse(value, out var parsed))
            {
                modeloPersonaNatural = parsed;
                modelo.PersonaNatural = parsed;
                if (parsed)
                {
                    modelo.Nombrecomercial = null;
                    modelo.Nombrerazonsocial = null;
                }
                else
                {
                    modelo.Apellidos = null;
                    modelo.Nombres = null;
                }
                editContext?.Validate();
                StateHasChanged();
            }
        }
    }

    // Lookups de identificaciones
    private List<IdentificacionItem> identificaciones = new();
    private record IdentificacionItem(string Codigo, string Descripcion);

    // Paginación y Filtros
    private string filtroTipoContribuyente = "todos";

    private IEnumerable<ContribuyenteDto> ContribuFiltrados =>
        contribuyentes.Where(c =>
            (string.IsNullOrWhiteSpace(filtro) ||
             $"{c.Apellidos} {c.Nombres}".Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
             (c.Numeroidentificacion ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
             (c.Correo ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
             (c.Nombrerazonsocial ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
             (c.Nombrecomercial ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase)) &&
            (filtroTipoContribuyente == "todos" ||
             (filtroTipoContribuyente == "natural" && c.PersonaNatural == true) ||
             (filtroTipoContribuyente == "sociedad" && c.PersonaNatural != true))
        );

    private int TotalFiltrados => ContribuFiltrados.Count();
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(TotalFiltrados / (double)registrosPorPagina));
    private int PrimerReg => TotalFiltrados == 0 ? 0 : ((paginaActual - 1) * registrosPorPagina) + 1;
    private int UltimoReg => Math.Min(paginaActual * registrosPorPagina, TotalFiltrados);

    private IEnumerable<ContribuyenteDto> ContribuPaginados =>
        ContribuFiltrados.Skip((paginaActual - 1) * registrosPorPagina).Take(registrosPorPagina);

    protected override void OnInitialized()
    {
        ReinitValidation();
    }

    private void ReinitValidation()
    {
        if (editContext != null)
        {
            editContext.OnValidationRequested -= HandleValidationRequested;
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
        editContext = new EditContext(modelo);
        messageStore = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += HandleValidationRequested;
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        messageStore?.Clear(e.FieldIdentifier);
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        messageStore?.Clear();

        // 1. Validación de Identificación Ecuatoriana (si el país es Ecuador)
        if (modelo.Pais == ecuadorPaisId && !string.IsNullOrWhiteSpace(modelo.Numeroidentificacion))
        {
            var ident = modelo.Numeroidentificacion.Trim();
            if (ident.All(char.IsDigit))
            {
                if (modelo.Tipoidentificacion == "05") // Cédula
                {
                    if (ident.Length != 10)
                    {
                        messageStore?.Add(() => modelo.Numeroidentificacion!, "La cédula debe tener exactamente 10 dígitos.");
                    }
                    else if (!ValidarCedulaEcuatoriana(ident))
                    {
                        messageStore?.Add(() => modelo.Numeroidentificacion!, "La cédula ecuatoriana ingresada no es válida.");
                    }
                }
                else if (modelo.Tipoidentificacion == "04") // RUC
                {
                    if (ident.Length != 13)
                    {
                        messageStore?.Add(() => modelo.Numeroidentificacion!, "El RUC debe tener exactamente 13 dígitos.");
                    }
                    else if (!ValidarRucEcuatoriano(ident))
                    {
                        messageStore?.Add(() => modelo.Numeroidentificacion!, "El RUC ecuatoriano ingresado no es válido.");
                    }
                }
            }
        }

        // 2. Validación de duplicados local en el listado
        if (!string.IsNullOrWhiteSpace(modelo.Numeroidentificacion))
        {
            var ident = modelo.Numeroidentificacion.Trim();
            var duplicado = contribuyentes.Any(c => 
                string.Equals(c.Numeroidentificacion?.Trim(), ident, StringComparison.OrdinalIgnoreCase) && 
                (!editando || c.CodContribuyente != _editandoId));
            if (duplicado)
            {
                messageStore?.Add(() => modelo.Numeroidentificacion!, "El número de identificación ya está registrado.");
            }
        }

        // 3. País, Provincia y Ciudad (no definidos en el DTO)
        if (!modelo.Pais.HasValue || modelo.Pais <= 0)
        {
            messageStore?.Add(() => modelo.Pais!, "Debe seleccionar un país.");
        }
        else
        {
            if (!modelo.Provincia.HasValue || modelo.Provincia <= 0)
            {
                messageStore?.Add(() => modelo.Provincia!, "Debe seleccionar una provincia.");
            }
            if (!modelo.Ciudad.HasValue || modelo.Ciudad <= 0)
            {
                messageStore?.Add(() => modelo.Ciudad!, "Debe seleccionar una ciudad.");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var idStr = user.FindFirst("IdUsuario")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idStr, out userId) || userId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        await CargarIdentificaciones();
        await CargarTodo();
    }

    private async Task CargarIdentificaciones()
    {
        try
        {
            var resp = await Http.GetAsync("api/clientes/lookups");
            if (!resp.IsSuccessStatusCode) return;

            var body = await resp.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(body);

            if (doc.RootElement.TryGetProperty("identificaciones", out var idElem))
            {
                identificaciones = idElem.EnumerateArray().Select(i => new IdentificacionItem(
                    i.TryGetProperty("ideCodigo", out var cod) ? cod.GetString() ?? "" : "",
                    i.TryGetProperty("ideDescripcion", out var desc) ? desc.GetString() ?? "" : ""
                )).ToList();
            }
        }
        catch { /* silencioso */ }
    }

    private async Task CargarTodo(bool esRefresco = false)
    {
        cargando = true;
        mensaje = null;
        errorMsg = null;
        StateHasChanged();

        try
        {
            await CargarPaises();
            await CargarUbicacionEcuador();

            if (!modelo.Pais.HasValue && ecuadorPaisId.HasValue)
                modelo.Pais = ecuadorPaisId;

            // Cargar límite de contribuyentes
            try
            {
                var limiteResp = await Http.GetAsync($"api/contribuyentes-edeclara/limite-estado?userId={userId}");
                if (limiteResp.IsSuccessStatusCode)
                {
                    var limitBody = await limiteResp.Content.ReadAsStringAsync();
                    using var limitDoc = System.Text.Json.JsonDocument.Parse(limitBody);
                    var root = limitDoc.RootElement;
                    limiteContribuyentes = root.GetProperty("limite").GetInt32();
                    actualContribuyentesActivos = root.GetProperty("actual").GetInt32();
                    limiteExcedido = root.GetProperty("excedido").GetBoolean();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al cargar límite de contribuyentes: {ex.Message}");
            }

            var resp = await Http.GetAsync($"api/contribuyentes-edeclara?userId={userId}");
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
                throw new Exception($"HTTP {(int)resp.StatusCode}: {body}");

            contribuyentes = System.Text.Json.JsonSerializer.Deserialize<List<ContribuyenteDto>>(
                body,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

            await PrepararLookupsUbicacionParaListado();

            if (esRefresco) mensaje = "Datos actualizados.";
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarEdicion(ContribuyenteDto c)
    {
        // Al cargar edición cerramos vista detallada
        enVista = null;

        modelo = new ContribuyenteUpsertDto
        {
            Apellidos = c.Apellidos,
            Nombres = c.Nombres,
            Nombrecomercial = c.Nombrecomercial,
            Nombrerazonsocial = c.Nombrerazonsocial,
            Tipoidentificacion = c.Tipoidentificacion,
            Numeroidentificacion = c.Numeroidentificacion,
            Direccion = c.Direccion,
            Telefonoconvencional = c.Telefonoconvencional,
            Celular = c.Celular,
            Correo = c.Correo,
            CorreosAdicionales = new List<string>(c.CorreosAdicionales),
            TipoCliente = c.TipoCliente,
            Oblgconta = c.Oblgconta,
            Estado = c.Estado,
            Observaciones = c.Observaciones,
            Pais = c.Pais,
            Provincia = c.Provincia,
            Ciudad = c.Ciudad,
            PersonaNatural = c.PersonaNatural,
            ContribuyenteEspecial = c.ContribuyenteEspecial,
            ActividadContribuyente = c.ActividadContribuyente,
            NumContribuyente = c.NumContribuyente,
            PeriodicidadIva = c.PeriodicidadIva,
            PeriodicidadRenta = c.PeriodicidadRenta,
            ClaveSri = null,
            FechaDeclaracion = c.FechaDeclaracion,
        };
        claveSriConfiguradaEdicion = c.ClaveSriConfigurada;
        mostrarClaveSri = false;
        modeloPersonaNatural = c.PersonaNatural ?? true;
        modeloEspecial = c.ContribuyenteEspecial ?? false;
        _editandoId = c.CodContribuyente;
        editando = true;
        mostrarEditor = true;
        ReiniciarSeccionesFormulario();
        tipoTelefono = !string.IsNullOrWhiteSpace(c.Celular) ? "celular" : "convencional";
        await CambiarEstadoVisualModalAsync(true);

        TriggerLoadingLocationDataForModel();

        CalcularFechaDeclaracion();

        ReinitValidation();
        StateHasChanged();
    }

    private async void TriggerLoadingLocationDataForModel()
    {
        if (modelo.Pais.HasValue && modelo.Pais != ecuadorPaisId)
        {
            await CargarProvincias(modelo.Pais.Value);
            if (modelo.Provincia.HasValue)
            {
                await CargarCiudades(modelo.Provincia.Value);
            }
            StateHasChanged();
        }
    }

    private int _editandoId;

    private async Task Guardar()
    {
        modelo.PersonaNatural = modeloPersonaNatural;
        modelo.ContribuyenteEspecial = modeloEspecial;
        modelo.Oblgconta = (modelo.Oblgconta ?? "").Trim().ToUpperInvariant();

        if (!editando && string.IsNullOrWhiteSpace(modelo.ClaveSri))
        {
            await JS.ShowAlertAsync("Clave requerida", "Ingresa la clave del SRI del contribuyente.", "warning");
            return;
        }

        var isValid = editContext?.Validate() ?? false;
        if (!isValid)
