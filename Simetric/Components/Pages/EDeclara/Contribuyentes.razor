    private async Task ExportarContribuyentesAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("Tipo;Identificación;Nombre o razón social;Correo;Celular;Estado");
        foreach (var item in ContribuFiltrados)
        {
            csv.AppendLine(string.Join(';',
                EscaparCsv(item.PersonaNatural == true ? "Persona Natural" : "Sociedad / Persona Jurídica"),
                EscaparCsv(item.Numeroidentificacion),
                EscaparCsv(NombreCompleto(item)),
                EscaparCsv(item.Correo),
                EscaparCsv(item.Celular),
                EscaparCsv(item.Estado == true ? "Activo" : "Inactivo")));
        }

        await using var stream = new MemoryStream(Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray());
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", $"contribuyentes-{DateTime.Now:yyyyMMdd-HHmm}.csv", reference, "text/csv;charset=utf-8");
    }

    private static string EscaparCsv(string? valor)
    {
        var comilla = '"';
        return string.Concat(comilla, (valor ?? string.Empty).Replace("\"", "\"\""), comilla);
    }

