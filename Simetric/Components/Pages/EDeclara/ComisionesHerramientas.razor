@page "/e-declara/comisiones/herramientas"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text
@using Simetric.Models.EDeclara
@using Simetric.Services
@using Simetric.Services.EDeclara
@inject AuthenticationStateProvider AuthStateProvider
@inject AppAccessService AppAccessService
@inject ComisionesService ComisionesService
@inject IJSRuntime JS

<PageTitle>Historial de comisiones | E-Declara</PageTitle>
<div class="edeclara-page comisiones-page commission-tools-page">
    <section class="edeclara-hero comisiones-hero commission-history-hero">
        <div><span class="hero-eyebrow">E-Declara · Comisiones</span><h2><i class="ri-coins-line"></i> Historial de comisiones</h2><p>Consulta, liquida y exporta el historial de comisiones.</p></div>
        <div class="history-hero-actions"><span><i class="ri-calendar-line"></i> @RangoPeriodo</span><button type="button" class="secondary-action" @onclick="Exportar" disabled="@(movimientos.Count == 0)"><i class="ri-download-2-line"></i> Exportar CSV</button></div>
    </section>
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
    @if (!string.IsNullOrWhiteSpace(exito)) { <div class="alert alert-success">@exito</div> }
    @if (actualizando) { <div class="commission-update-status"><span class="spinner-border spinner-border-sm"></span> Actualizando historial y reportes…</div> }
    @if (detalle is not null) { <div class="commission-modal-backdrop" @onclick="CerrarDetalle"><section class="edeclara-panel commission-modal movement-detail-modal" role="dialog" aria-modal="true" @onclick:stopPropagation><div class="table-card-head"><div><span class="hero-eyebrow">Detalle de movimiento</span><h3 class="panel-title"><i class="ri-file-search-line"></i>@(detalle.NumeroFactura ?? "Comisión")</h3></div><button type="button" class="modal-close" @onclick="CerrarDetalle"><i class="ri-close-line"></i></button></div><dl class="movement-detail-grid"><div><dt>Involucrado</dt><dd>@detalle.Involucrado</dd></div><div><dt>Estado</dt><dd><span class="status-pill @EstadoCss(detalle.Estado)">@detalle.Estado</span></dd></div><div><dt>Cliente</dt><dd>@(detalle.Cliente ?? "Sin cliente")</dd></div><div><dt>Fecha</dt><dd>@detalle.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Base / porcentaje</dt><dd>@Dinero(detalle.ValorFacturado) · @detalle.Porcentaje.ToString("0.##")%</dd></div><div><dt>Comisión</dt><dd>@Dinero(detalle.ComisionGenerada)</dd></div><div><dt>Método de pago</dt><dd>@(detalle.MetodoPago ?? "Pendiente")</dd></div><div><dt>Referencia</dt><dd>@(detalle.ReferenciaPago ?? "—")</dd></div><div class="span-2"><dt>Motivo / observación</dt><dd>@(detalle.Motivo ?? "Sin observaciones")</dd></div></dl></section></div> }
    <section class="commission-metrics four history-metrics"><article class="metric-generated"><i class="ri-coins-line"></i><div><span>Generadas</span><strong>@Dinero(resumen.Generadas)</strong><small>Comisiones del período</small></div></article><article class="metric-pending"><i class="ri-time-line"></i><div><span>Pendientes</span><strong>@Dinero(resumen.Pendientes)</strong><small>Por liquidar</small></div></article><article class="metric-paid"><i class="ri-checkbox-circle-line"></i><div><span>Pagadas</span><strong>@Dinero(resumen.Pagadas)</strong><small>Liquidaciones realizadas</small></div></article><article class="metric-billing"><i class="ri-file-text-line"></i><div><span>Facturación asociada</span><strong>@Dinero(resumen.Facturacion)</strong><small>En ventas generadas</small></div></article></section>
    <section class="edeclara-panel commission-filters history-filter-panel"><div class="table-card-head"><div><span class="hero-eyebrow">Consulta rápida</span><h3 class="panel-title"><i class="ri-filter-3-line"></i>Historial y filtros</h3></div><span class="advanced-filter-label"><i class="ri-equalizer-2-line"></i> Filtros avanzados</span></div><div class="filter-grid"><div class="form-group"><label class="form-label-n">Desde</label><InputDate class="input-n-premium" @bind-Value="desde" /></div><div class="form-group"><label class="form-label-n">Hasta</label><InputDate class="input-n-premium" @bind-Value="hasta" /></div><div class="form-group"><label class="form-label-n">Estado</label><InputSelect class="input-n-premium" @bind-Value="estado"><option value="">Todos</option>@foreach(var x in Enum.GetValues<ComisionEstado>()){<option value="@x">@x</option>}</InputSelect></div><div class="form-group span-2"><label class="form-label-n">Involucrado / Cliente / Factura</label><InputText class="input-n-premium" @bind-Value="filtro" placeholder="Buscar por nombre, identificación o factura..." /></div><button type="button" class="primary-action filter-button" @onclick="Cargar" disabled="@actualizando"><i class="ri-search-line"></i> Consultar</button></div></section>
    <section class="edeclara-panel history-movements-panel"><div class="table-card-head"><div><span class="hero-eyebrow">Liquidación</span><h3 class="panel-title"><i class="ri-list-check-3"></i>Movimientos recientes</h3></div><div class="history-table-actions"><span class="selection-counter">@movimientos.Count movimientos</span><button type="button" class="primary-action" @onclick="Pagar" disabled="@(actualizando || seleccionados.Count == 0)"><i class="ri-bank-card-line"></i> Registrar pago</button><button type="button" class="secondary-action" @onclick="Pendientes" disabled="@(actualizando || seleccionados.Count == 0)">Marcar pendientes</button></div></div>@if (mostrarPago){<div class="payment-box"><div class="form-group"><label class="form-label-n">Método *</label><InputSelect class="input-n-premium" @bind-Value="metodo"><option value="">Selecciona…</option><option>Transferencia</option><option>Efectivo</option><option>Cheque</option></InputSelect></div><div class="form-group"><label class="form-label-n">Referencia</label><InputText class="input-n-premium" @bind-Value="referencia" /></div><div class="payment-confirmation">Se marcarán como pagadas únicamente las comisiones pendientes seleccionadas.</div><button class="primary-action" @onclick="ConfirmarPago">Confirmar pago</button></div>}<div class="table-container"><table class="sri-table movements-table history-table"><thead><tr><th><input type="checkbox" checked="@Todos" @onchange="Alternar" /></th><th>Fecha</th><th>Factura / cliente</th><th>Involucrado</th><th>Base</th><th>% comisión</th><th>Comisión</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@if(movimientos.Count==0){<tr><td colspan="9"><div class="commission-empty"><i class="ri-file-search-line"></i><strong>Sin resultados todavía</strong><span>Usa los filtros para consultar el historial.</span></div></td></tr>}@foreach(var x in MovimientosVisibles){<tr class="@(seleccionados.Contains(x.Id)?"selected":null)"><td><input type="checkbox" checked="@seleccionados.Contains(x.Id)" @onchange="e=>Seleccionar(x.Id,(bool?)e.Value==true)" /></td><td>@x.FechaGeneracion.ToString("dd/MM/yyyy")</td><td><strong>@(x.NumeroFactura??"—")</strong><small>@(x.Cliente??"Sin cliente")</small></td><td><strong>@x.Involucrado</strong><small>@x.TipoInvolucrado</small></td><td>@Dinero(x.ValorFacturado)</td><td>@x.Porcentaje.ToString("0.##")%</td><td><strong>@Dinero(x.ComisionGenerada)</strong></td><td><span class="status-pill @EstadoCss(x.Estado)">@x.Estado</span></td><td class="actions-cell"><button type="button" class="icon-action edit" title="Ver detalle" @onclick="() => detalle = x"><i class="ri-eye-line"></i></button></td></tr>}</tbody></table></div>@if (TotalPaginas > 1) { <footer class="commission-pager"><span>Mostrando @InicioRegistro-@FinRegistro de @movimientos.Count movimientos</span><div><button type="button" disabled="@(paginaActual == 1)" @onclick="PaginaAnterior"><i class="ri-arrow-left-s-line"></i></button>@for(var pagina=1;pagina<=TotalPaginas;pagina++){var actual=pagina;<button type="button" class="@(paginaActual == actual ? "active" : null)" @onclick="() => IrAPagina(actual)">@actual</button>}<button type="button" disabled="@(paginaActual == TotalPaginas)" @onclick="PaginaSiguiente"><i class="ri-arrow-right-s-line"></i></button></div></footer>}</section>
    <section class="history-bottom-grid"><section class="edeclara-panel history-period-summary"><h3 class="panel-title"><i class="ri-bar-chart-box-line"></i>Resumen del período</h3><div class="period-summary-cards"><article><i class="ri-file-list-3-line"></i><span>Movimientos</span><strong>@movimientos.Count</strong><small>Total de registros</small></article><article><i class="ri-time-line"></i><span>Por liquidar</span><strong>@Dinero(resumen.Pendientes)</strong><small>Comisiones pendientes</small></article><article><i class="ri-checkbox-circle-line"></i><span>Pagadas</span><strong>@Dinero(resumen.Pagadas)</strong><small>Liquidaciones del período</small></article></div></section><section class="edeclara-panel history-status-summary"><h3 class="panel-title"><i class="ri-pie-chart-2-line"></i>Comisiones por estado</h3><div class="status-donut"><div><strong>@Dinero(resumen.Generadas)</strong><small>Total generado</small></div></div><div class="status-legend"><span><i class="paid"></i>Pagadas <strong>@Dinero(resumen.Pagadas)</strong></span><span><i class="pending"></i>Pendientes <strong>@Dinero(resumen.Pendientes)</strong></span><span><i class="generated"></i>Generadas <strong>@Dinero(resumen.Generadas - resumen.Pagadas - resumen.Pendientes)</strong></span></div></section><section class="edeclara-panel commission-history-panel"><h3 class="panel-title"><i class="ri-time-line"></i>Últimos cambios</h3>@if(historial.Count==0){<div class="commission-empty compact"><strong>Sin cambios registrados</strong></div>}else{<div class="history-timeline">@foreach(var x in historial.Take(4)){<article><span class="history-dot"></span><div><strong>@x.Involucrado</strong><p>@x.Motivo</p><small>@x.Fecha.ToString("dd/MM/yyyy HH:mm")</small></div></article>}</div>}</section></section>
</div>

@code {
    private const int RegistrosPorPagina=10; private static readonly CultureInfo Cultura=CultureInfo.GetCultureInfo("es-EC"); private int empresaId,usuarioId,paginaActual=1; private bool actualizando,mostrarPago; private string? error,exito,filtro,metodo,referencia; private DateTime? desde=DateTime.Today.AddMonths(-1),hasta=DateTime.Today; private ComisionEstado? estado; private ComisionesResumen resumen=new(); private IReadOnlyList<ComisionMovimiento> movimientos=[]; private IReadOnlyList<ComisionHistorial> historial=[]; private ComisionMovimiento? detalle; private readonly HashSet<long> seleccionados=[];
    private string RangoPeriodo => $"{(desde ?? DateTime.Today.AddMonths(-1)):dd/MM/yyyy} - {(hasta ?? DateTime.Today):dd/MM/yyyy}";
    private IReadOnlyList<ComisionMovimiento> MovimientosVisibles=>movimientos.Skip((paginaActual-1)*RegistrosPorPagina).Take(RegistrosPorPagina).ToList(); private int TotalPaginas=>Math.Max(1,(int)Math.Ceiling(movimientos.Count/(double)RegistrosPorPagina)); private int InicioRegistro=>movimientos.Count==0?0:(paginaActual-1)*RegistrosPorPagina+1; private int FinRegistro=>Math.Min(paginaActual*RegistrosPorPagina,movimientos.Count);
    protected override Task OnInitializedAsync(){_ = Inicializar();return Task.CompletedTask;}
    private async Task Inicializar(){try{var user=(await AuthStateProvider.GetAuthenticationStateAsync()).User;if(!int.TryParse(user.FindFirst("IdUsuario")?.Value,out usuarioId))throw new InvalidOperationException("No se pudo determinar el usuario activo.");empresaId=usuarioId;var acceso=await AppAccessService.CanAccessAsync(usuarioId,EDeclaraRoutes.ServiceKey,user.FindFirst("IdTipoUsuario")?.Value==AppAccessService.AdminRoleId);if(!acceso.HasAccess)throw new InvalidOperationException("No tienes acceso a Comisiones.");await CargarCore();}catch(Exception ex){error=ex.Message;}finally{await InvokeAsync(StateHasChanged);}}
    private async Task Cargar()=>await Ejecutar(CargarCore); private async Task CargarCore(){if(desde>hasta)throw new ArgumentException("La fecha desde no puede ser posterior a la fecha hasta.");var a=ComisionesService.ListarMovimientosAsync(empresaId,estado,desde,hasta,filtro,500);var b=ComisionesService.ObtenerResumenAsync(empresaId,desde,hasta);var c=ComisionesService.ListarHistorialAsync(empresaId);await Task.WhenAll(a,b,c);movimientos=await a;resumen=await b;historial=await c;paginaActual=1;seleccionados.Clear();mostrarPago=false;}
    private async Task Ejecutar(Func<Task> accion){actualizando=true;error=null;try{await accion();}catch(Exception ex){error=ex.Message;}finally{actualizando=false;}}
    private bool Todos=>movimientos.Count>0&&movimientos.All(x=>seleccionados.Contains(x.Id)); private void Seleccionar(long id,bool ok){if(ok)seleccionados.Add(id);else seleccionados.Remove(id);} private void Alternar(ChangeEventArgs e){seleccionados.Clear();if((bool?)e.Value==true)foreach(var x in movimientos)seleccionados.Add(x.Id);} private void Pagar()=>mostrarPago=true; private void CerrarDetalle()=>detalle=null; private void IrAPagina(int pagina)=>paginaActual=Math.Clamp(pagina,1,TotalPaginas); private void PaginaAnterior()=>IrAPagina(paginaActual-1); private void PaginaSiguiente()=>IrAPagina(paginaActual+1);
    private async Task Pendientes()=>await Ejecutar(async()=>{await ComisionesService.MarcarPendientesAsync(empresaId,seleccionados,usuarioId);exito="Comisiones marcadas como pendientes.";await CargarCore();}); private async Task ConfirmarPago()=>await Ejecutar(async()=>{await ComisionesService.RegistrarPagoAsync(empresaId,seleccionados,metodo??"",referencia,usuarioId);exito="Pago registrado.";await CargarCore();}); private async Task VerPendientes(){estado=ComisionEstado.Pendiente;await Cargar();} private async Task VerPagadas(){estado=ComisionEstado.Pagada;await Cargar();}
    private async Task Exportar(){var texto=new StringBuilder("Fecha;Factura;Involucrado;Comision;Estado\r\n");foreach(var x in movimientos)texto.AppendLine($"{x.FechaGeneracion:yyyy-MM-dd};{x.NumeroFactura};{x.Involucrado};{x.ComisionGenerada.ToString("0.00",CultureInfo.InvariantCulture)};{x.Estado}");await using var stream=new MemoryStream(Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(texto.ToString())).ToArray());using var file=new DotNetStreamReference(stream);await JS.InvokeVoidAsync("downloadFileFromStream","reporte-comisiones.csv",file,"text/csv;charset=utf-8");}
    private static string Dinero(decimal valor)=>valor.ToString("C2",Cultura); private static string EstadoCss(ComisionEstado x)=>x==ComisionEstado.Pagada?"paid":x==ComisionEstado.Pendiente?"pending":"generated";
}
