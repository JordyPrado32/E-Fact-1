@page "/e-declara/compras"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Simetric.Models
@using Simetric.Models.EDeclara
@using Simetric.Services
@using Simetric.Services.EDeclara
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject ContribuyenteEdeclaraService ContribuyentesService
@inject EDeclaraComprasService ComprasService
@inject EDeclaraClasificacionIaService ClasificacionIaService
@inject EDeclaraSriCredentialService SriCredentialService
@inject CedulaLookupService CedulaLookupService
@inject ISimpleExcelExportService ExcelService
@inject IJSRuntime JS

<PageTitle>Compras | E-Declara</PageTitle>

<style>
    .ec-shell .ec-table { min-width: 1120px; }
    .ec-shell .ec-table th { padding: .55rem .5rem; font-size: .62rem; }
    .ec-shell .ec-table td { padding: .52rem .5rem; font-size: .72rem; }
    .ec-shell .ec-table td small { margin-top: .1rem; font-size: .66rem; }
    .ec-shell .ec-grid-select { max-width: 120px; padding: .32rem .4rem; font-size: .68rem; }
    .ec-shell .ec-grid-select.compact { width: 68px; }
    .ec-shell .ec-concept { max-width: 145px; }
    .ec-shell .ec-origin { padding: .2rem .38rem; font-size: .58rem; }
    .ec-shell .ec-row-actions { gap: .25rem; }
    .ec-shell .ec-row-actions button { width: 26px; height: 26px; border-radius: 7px; }
    .ec-sri-loading { position: fixed; inset: 0; z-index: 1040; display: grid; place-items: center; padding: 1.5rem; background: rgba(15,23,42,.4); backdrop-filter: blur(4px); }
    .ec-sri-loading-card { width: min(560px, calc(100vw - 3rem)); padding: 2rem; border: 1px solid rgba(108,99,255,.2); border-radius: 24px; background: #fff; box-shadow: 0 28px 80px rgba(15,23,42,.28); color: #1e293b; text-align: center; }
    .ec-sri-loading-icon { display: grid; place-items: center; width: 62px; height: 62px; margin: 0 auto 1rem; border-radius: 20px; background: #eeecff; color: #6c63ff; font-size: 1.8rem; animation: ec-loading-float 2.2s ease-in-out infinite; }
    .ec-sri-loading-card .ec-kicker { margin-bottom: .35rem; }
    .ec-sri-loading-card strong { display: block; font-size: 1.05rem; }
    .ec-sri-loading-copy { margin: .45rem 0 0; color: #475569; font-size: .82rem; line-height: 1.45; }
    .ec-sri-loading-hint { display: block; margin-top: .7rem; color: #64748b; font-size: .7rem; }
    .ec-sri-loading-bar { height: 8px; margin-top: 1.15rem; overflow: hidden; border-radius: 99px; background: #e9e7fb; }
    .ec-sri-loading-bar span { display: block; width: 42%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #6c63ff, #a78bfa); animation: ec-loading-progress 1.6s ease-in-out infinite; }
    .ec-sri-loading-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: 1.25rem; color: #94a3b8; font-size: .68rem; font-weight: 800; }
    .ec-sri-loading-steps span { display: flex; align-items: center; justify-content: center; gap: .35rem; }
    .ec-sri-loading-steps span:first-child { color: #574fd6; }
    .ec-sri-loading-steps i { font-size: .9rem; }
    .ec-modal-backdrop { position: fixed; inset: 0; z-index: 1030; display: grid; place-items: center; padding: 1rem; overflow-y: auto; background: rgba(15,23,42,.46); backdrop-filter: blur(4px); }
    .ec-editor-modal { width: min(920px, 100%); max-height: calc(100vh - 2rem); overflow-y: auto; margin: auto; padding: 1.35rem; border: 1px solid rgba(108,99,255,.2); border-radius: 24px; background: #fff; box-shadow: 0 28px 80px rgba(15,23,42,.28); }
    .ec-editor-modal .ec-form-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    @@keyframes ec-loading-progress { 0% { transform: translateX(-115%); } 100% { transform: translateX(260%); } }
    @@keyframes ec-loading-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    @@media(max-width: 700px) { .ec-editor-modal .ec-form-grid { grid-template-columns: 1fr 1fr; } }
    @@media(max-width: 500px) { .ec-editor-modal .ec-form-grid { grid-template-columns: 1fr; } .ec-sri-loading-card { padding: 1.5rem 1rem; } .ec-sri-loading-steps { grid-template-columns: 1fr; gap: .45rem; } }
</style>

<div class="ec-shell">
    <section class="ec-hero">
        <div>
            <span class="ec-kicker">Gestión tributaria · E-Declara</span>
            <h1>Información de compras</h1>
            <p>Centraliza compras, notas de crédito y documentos recibidos desde el SRI.</p>
        </div>
        <span class="ec-hero-badge"><i class="ri-file-chart-line"></i> Declaración de IVA</span>
    </section>

    @if (cargando)
    {
        <section class="ec-state"><span class="spinner-border" role="status"></span><strong>Preparando compras</strong></section>
    }
    else if (!string.IsNullOrWhiteSpace(errorInicial))
    {
        <section class="ec-alert ec-alert-error"><i class="ri-error-warning-line"></i><span>@errorInicial</span></section>
    }
    else
    {
        <section class="ec-context-card">
            <div class="ec-context-copy">
                <span class="ec-kicker">Contexto de trabajo</span>
                <strong>Selecciona el período</strong>
            </div>
            <label><span>Contribuyente</span><select value="@contribuyenteId" @onchange="CambiarContribuyenteAsync">@foreach (var contribuyente in contribuyentes){<option value="@contribuyente.CodContribuyente">@NombreContribuyente(contribuyente) · @contribuyente.Numeroidentificacion</option>}</select></label>
            <label><span>Año</span>
                <select value="@anio" @onchange="CambiarAnioAsync">
                    @for (var value = DateTime.Today.Year; value >= DateTime.Today.Year - 6; value--)
                    { <option value="@value">@value</option> }
                </select>
            </label>
            <label><span>Período</span>
                <select value="@periodo" @onchange="CambiarPeriodoAsync">
                    @for (var value = 1; value <= 12; value++)
                    { <option value="@value">@NombrePeriodo(value)</option> }
                    <option value="13">Primer semestre</option>
                    <option value="14">Segundo semestre</option>
                </select>
            </label>
        </section>

        @if (!claveSriConfigurada)
        {
            <section class="ec-alert ec-alert-warning">
                <i class="ri-lock-2-line"></i>
                <div><strong>Consulta SRI bloqueada</strong><span>Configura la Clave SRI en tu perfil para descargar compras y notas de crédito.</span></div>
                <button type="button" @onclick="IrAPerfil">Configurar ahora</button>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <section class="ec-alert @(mensajeError ? "ec-alert-error" : "ec-alert-success")">
                <i class="ri-@(mensajeError ? "error-warning" : "checkbox-circle")-line"></i><span>@mensaje</span>
            </section>
        }

        <section class="ec-metrics">
            <article><span>Registros</span><strong>@documentos.Count</strong><small>@NombreTipoDocumentoPlural()</small></article>
            <article><span>Base imponible</span><strong>@Dinero(documentos.Sum(x => x.BaseImponible))</strong><small>Acumulado del período</small></article>
            <article><span>IVA</span><strong>@Dinero(documentos.Sum(x => x.Iva))</strong><small>Impuesto registrado</small></article>
            <article class="@(PendientesClasificacion > 0 ? "is-pending" : "")"><span>Por clasificar</span><strong>@PendientesClasificacion</strong><small>Actividad o casilla pendiente</small></article>
        </section>

        <section class="ec-workspace">
            <div class="ec-tabs">
                <button type="button" class="@(tipoDocumento == 1 ? "is-active" : "")" @onclick="() => CambiarTipoAsync(1)"><i class="ri-shopping-bag-3-line"></i> Compras</button>
                <button type="button" class="@(tipoDocumento == 3 ? "is-active" : "")" @onclick="() => CambiarTipoAsync(3)"><i class="ri-file-reduce-line"></i> Notas de crédito</button>
                <button type="button" class="@(tipoDocumento == 2 ? "is-active" : "")" @onclick="() => CambiarTipoAsync(2)"><i class="ri-store-2-line"></i> Ventas</button>
                <button type="button" class="@(tipoDocumento == 4 ? "is-active" : "")" @onclick="() => CambiarTipoAsync(4)"><i class="ri-file-reduce-line"></i> NC ventas</button>
                <button type="button" class="@(tipoDocumento == 6 ? "is-active" : "")" @onclick="() => CambiarTipoAsync(6)"><i class="ri-file-shield-2-line"></i> Retenciones</button>
            </div>

            <div class="ec-toolbar">
                <div class="ec-search"><i class="ri-search-line"></i><input placeholder="Buscar por proveedor, RUC, serie o concepto" value="@filtro" @oninput="Filtrar" /></div>
                <div class="ec-actions">
                    <button type="button" class="ec-btn ec-btn-light" disabled="@ocupado" @onclick="ExportarAsync"><i class="ri-file-excel-2-line"></i> Excel</button>
                    @if (tipoDocumento is (1 or 2 or 3 or 4) && PendientesClasificacion > 0)
                    {
                        <button type="button" class="ec-btn ec-btn-ai" disabled="@(ocupado || clasificandoIa)" @onclick="ClasificarConIaAsync">
                            @if (clasificandoIa) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="ri-sparkling-2-line"></i> }
                            Clasificar con IA
                        </button>
                    }
                    <label class="ec-btn ec-btn-light @(ocupado ? "is-disabled" : "")"><i class="ri-upload-cloud-2-line"></i> Importar XML<InputFile multiple accept=".xml,text/xml,application/xml" OnChange="ImportarXmlAsync" disabled="@ocupado" /></label>
                    @if (tipoDocumento is 2 or 4)
                    {
                        <button type="button" class="ec-btn ec-btn-light" disabled="@ocupado" @onclick="SincronizarVentasEFactAsync"><i class="ri-refresh-line"></i> Sincronizar E-Fact</button>
                    }
                    <button type="button" class="ec-btn ec-btn-sri" disabled="@(ocupado || tipoDocumento is 2 or 4 || !claveSriConfigurada || string.IsNullOrWhiteSpace(perfilIdentificacion))" @onclick="ConsultarSriAsync">
                        @if (sincronizando) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="ri-cloud-line"></i> }
                        Consultar SRI
                    </button>
                    <button type="button" class="ec-btn ec-btn-primary" disabled="@(ocupado || string.IsNullOrWhiteSpace(perfilIdentificacion))" @onclick="Nuevo"><i class="ri-add-line"></i> Registrar @NombreTipoDocumentoSingular().ToLowerInvariant()</button>
                </div>
            </div>

            @if (mostrarFormulario)
            {
                <div class="ec-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="ec-editor-title" @onclick="CerrarFormulario">
                    <section class="ec-editor ec-editor-modal" @onclick:stopPropagation="true">
                        <div class="ec-editor-head">
                            <div><span class="ec-kicker">@(edicion.Id == 0 ? "Nuevo registro" : "Editando registro")</span><h2 id="ec-editor-title">Datos de @NombreTipoDocumentoSingular().ToLowerInvariant()</h2></div>
                            <button type="button" class="ec-icon-btn" @onclick="CerrarFormulario"><i class="ri-close-line"></i></button>
                        </div>
                        <div class="ec-form-grid">
                            <div class="ec-auto-field span-2"><span>Clasificación tributaria</span><strong>Se asigna automáticamente con IA</strong><small>Se valida contra el catálogo de E-Declara al procesar el período.</small></div>
                            <label><span>Serie *</span><input maxlength="6" placeholder="001001" @bind="edicion.Serie" /></label>
                            <label><span>Número *</span><input maxlength="9" placeholder="000000001" @bind="edicion.Numero" /></label>
                            <label><span>Fecha de emisión *</span><input type="date" @bind="edicion.FechaEmision" @bind:format="yyyy-MM-dd" /></label>
                            <label><span>RUC / identificación *</span><input maxlength="20" @bind="edicion.Ruc" @onblur="BuscarProveedorAsync" /></label>
                            <label class="span-2"><span>Razón social</span><input maxlength="300" @bind="edicion.RazonSocial" /></label>
                            <label class="span-2"><span>Concepto</span><input maxlength="500" @bind="edicion.Concepto" /></label>
                            @if (tipoDocumento is 3 or 4)
                            {
                                <label><span>Serie factura relacionada *</span><input maxlength="6" placeholder="001001" @bind="edicion.SerieDocumentoModificado" @onblur="BuscarFacturaRelacionadaAsync" /></label>
                                <label><span>Número factura relacionada *</span><input maxlength="9" placeholder="000000001" @bind="edicion.NumeroDocumentoModificado" @onblur="BuscarFacturaRelacionadaAsync" /></label>
                            }
                            <label><span>Tarifa (%)</span><select value="@edicion.Tarifa.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="CambiarTarifaEdicion"><option value="0">0%</option>@foreach(var x in catalogos.Tarifas.Where(x => x.Valor != 0)){<option value="@x.Valor.ToString(System.Globalization.CultureInfo.InvariantCulture)">@x.Descripcion</option>}</select></label>
                            <label><span>Base ($) *</span><input type="number" min="0" step="0.01" value="@edicion.BaseImponible.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="CambiarBaseEdicion" /></label>
                            <label><span>IVA ($)</span><input type="number" min="0" step="0.01" @bind="edicion.Iva" /></label>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(DescripcionCasillaEdicion)) { <div class="ec-field-help"><i class="ri-information-line"></i> @DescripcionCasillaEdicion</div> }
                        <div class="ec-editor-actions"><button type="button" class="ec-btn ec-btn-light" @onclick="CerrarFormulario">Cancelar</button><button type="button" class="ec-btn ec-btn-primary" disabled="@guardando" @onclick="GuardarAsync">@if(guardando){<span class="spinner-border spinner-border-sm"></span>}else{<i class="ri-save-3-line"></i>} Guardar</button></div>
                    </section>
                </div>
            }

            <div class="ec-table-tools">
                <label class="ec-check"><input type="checkbox" checked="@TodosSeleccionados" @onchange="SeleccionarTodos" /> Seleccionar página</label>
                @if (seleccionados.Count > 0) { <button type="button" class="ec-delete-selected" @onclick="EliminarSeleccionadosAsync"><i class="ri-delete-bin-6-line"></i> Eliminar @seleccionados.Count</button> }
                <label class="ec-check">Ordenar por <select class="ec-grid-select" value="@orden" @onchange="CambiarOrden"><option value="ruc">Proveedor</option><option value="fecha">Fecha</option><option value="documento">Documento</option></select></label>
                <button type="button" class="ec-icon-btn" title="Cambiar dirección" @onclick="CambiarDireccionOrden"><i class="ri-sort-@(ordenDescendente ? "desc" : "asc")"></i></button>
                <span>@DocumentosFiltrados.Count registro(s)</span>
            </div>

            <div class="ec-table-wrap">
                <table class="ec-table">
                    <thead><tr><th></th><th>Actividad</th><th>Documento</th><th>Fecha</th><th>@(tipoDocumento is 2 or 4 ? "Cliente" : "Proveedor")</th><th>Concepto</th>@if(tipoDocumento is 3 or 4){<th>Factura relacionada</th>}<th>Casilla</th><th>Tarifa</th><th class="number">Base</th><th class="number">@(tipoDocumento == 6 ? "Retenido" : "IVA")</th><th>Origen</th><th></th></tr></thead>
                    <tbody>
                    @if (!DocumentosPagina.Any())
                    {
                        <tr><td colspan="@(tipoDocumento is 3 or 4 ? 14 : 13)"><div class="ec-empty"><i class="ri-inbox-archive-line"></i><strong>No hay @NombreTipoDocumentoPlural().ToLowerInvariant()</strong><span>Consulta el SRI, sincroniza E-Fact, importa XML o registra el documento manualmente.</span></div></td></tr>
                    }
                    @foreach (var item in DocumentosPagina)
                    {
                        <tr class="@(item.EsFaltante ? "is-missing" : item.RequiereClasificacion ? "is-unclassified" : "")">
                            <td><input type="checkbox" checked="@seleccionados.Contains(item.Id)" @onchange="e => Seleccionar(item.Id, e)" /></td>
                            <td><span class="ec-classification-cell">@(DescripcionActividad(item) ?? "Pendiente")<small>@(item.TipoFacturacion is null or <= 0 ? "Requiere clasificación IA" : $"Actividad {item.TipoFacturacion}")</small></span></td>
                            <td><strong>@item.Serie-@item.Numero</strong><small>@(item.EsFaltante ? "Secuencial faltante" : NombreTipoDocumentoSingular())</small></td>
                            <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(item.RazonSocial) ? "Sin proveedor" : item.RazonSocial)</strong><small>@item.Ruc</small></td>
                            <td><button type="button" class="ec-concept" @onclick="() => AlternarDetalle(item.Id)">@item.Concepto</button></td>
                            @if(tipoDocumento is 3 or 4){<td>@FormatoDocumento(item.SerieDocumentoModificado,item.NumeroDocumentoModificado)</td>}
                            <td><span class="ec-classification-cell">@(DescripcionCasilla(item) ?? "Pendiente")<small>@(string.IsNullOrWhiteSpace(item.Casilla) ? "Se asignará con IA" : item.Casilla)</small></span></td>
                            <td>@item.Tarifa.ToString("0.##")%</td><td class="number">@Dinero(item.BaseImponible)</td><td class="number">@Dinero(item.Iva)</td>
                            <td><span class="ec-origin origin-@item.Origen.ToLowerInvariant()">@item.Origen</span></td>
                            <td><div class="ec-row-actions"><button title="Editar" @onclick="() => Editar(item)"><i class="ri-pencil-line"></i></button><button title="Eliminar" @onclick="() => EliminarAsync(item)"><i class="ri-delete-bin-line"></i></button></div></td>
                        </tr>
                        @if (detalleAbierto == item.Id)
                        {
                            <tr class="ec-detail-row"><td colspan="@(tipoDocumento is 3 or 4 ? 14 : 13)"><div><strong>Detalle del comprobante</strong>@if(item.Detalles.Count==0){<span>Sin líneas de detalle.</span>}else{<ul>@foreach(var detalle in item.Detalles){<li>@detalle</li>}</ul>}@if(!string.IsNullOrWhiteSpace(item.NumeroAutorizacion)){<small>Autorización: @item.NumeroAutorizacion</small>}</div></td></tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            @if (TotalPaginas > 1)
            {
                <div class="ec-pagination"><button disabled="@(pagina==1)" @onclick="() => pagina--"><i class="ri-arrow-left-s-line"></i></button><span>Página @pagina de @TotalPaginas</span><button disabled="@(pagina==TotalPaginas)" @onclick="() => pagina++"><i class="ri-arrow-right-s-line"></i></button></div>
            }

            @if (sincronizando)
            {
                <section class="ec-sri-loading" role="status" aria-live="polite">
                    <div class="ec-sri-loading-card">
                        <div class="ec-sri-loading-icon"><i class="ri-cloud-download-line"></i></div>
                        <span class="ec-kicker">Sincronización en curso</span>
                        <strong>@(tipoDocumento is 2 or 4 ? "Sincronizando comprobantes emitidos" : "Consultando comprobantes del SRI")</strong>
                        <p class="ec-sri-loading-copy">@(tipoDocumento is 2 or 4 ? "Recuperando documentos autorizados desde E-Fact." : $"El tiempo aproximado para {(periodo is 13 or 14 ? "el semestre" : "este mes")} es de {TiempoEstimadoConsulta}.")</p>
                        <div class="ec-sri-loading-bar" aria-hidden="true"><span></span></div>
                        <div class="ec-sri-loading-steps" aria-hidden="true">
                            <span><i class="ri-checkbox-circle-fill"></i> Conectando</span>
                            <span><i class="ri-loader-4-line"></i> Consultando</span>
                            <span><i class="ri-file-list-3-line"></i> Importando</span>
                        </div>
                        <small class="ec-sri-loading-hint">No cierres esta página mientras finaliza la importación.</small>
                    </div>
                </section>
            }
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "contribuyenteId")]
    private int? ContribuyenteIdQuery { get; set; }

    private IReadOnlyList<EDeclaraCompraDocumento> documentos = Array.Empty<EDeclaraCompraDocumento>();
    private EDeclaraComprasCatalogos catalogos = new();
    private readonly HashSet<long> seleccionados = new();
    private EDeclaraCompraDocumento edicion = new();
    private int userId, contribuyenteId, anio = DateTime.Today.Year, periodo = DateTime.Today.Month, tipoDocumento = 1, pagina = 1;
    private const int TamanoPagina = 12;
    private string filtro = string.Empty, mensaje = string.Empty, errorInicial = string.Empty, orden = "ruc", perfilNombre = string.Empty, perfilIdentificacion = string.Empty;
    private bool cargando = true, ocupado, sincronizando, clasificandoIa, guardando, mostrarFormulario, mensajeError, claveSriConfigurada, ordenDescendente;
    private long? detalleAbierto;
    private List<ContribuyenteEdeclare> contribuyentes = new();

    private List<EDeclaraCompraDocumento> DocumentosFiltrados
    {
        get
        {
            var source = documentos.Where(x => string.IsNullOrWhiteSpace(filtro) ||
                ($"{x.RazonSocial} {x.Ruc} {x.Serie} {x.Numero} {x.Concepto}").Contains(filtro, StringComparison.OrdinalIgnoreCase));
            IOrderedEnumerable<EDeclaraCompraDocumento> sorted = orden switch
            {
                "fecha" => ordenDescendente ? source.OrderByDescending(x => x.FechaEmision) : source.OrderBy(x => x.FechaEmision),
                "documento" => ordenDescendente ? source.OrderByDescending(x => x.Serie).ThenByDescending(x => x.Numero) : source.OrderBy(x => x.Serie).ThenBy(x => x.Numero),
                _ => ordenDescendente ? source.OrderByDescending(x => x.Ruc) : source.OrderBy(x => x.Ruc)
            };
            return sorted.ThenBy(x => x.FechaEmision).ThenBy(x => x.Numero).ToList();
        }
    }
    private List<EDeclaraCompraDocumento> DocumentosPagina => DocumentosFiltrados.Skip((pagina-1)*TamanoPagina).Take(TamanoPagina).ToList();
    private int TotalPaginas => Math.Max(1,(int)Math.Ceiling(DocumentosFiltrados.Count/(double)TamanoPagina));
    private int PendientesClasificacion => documentos.Count(x => x.RequiereClasificacion);
    private bool TodosSeleccionados => DocumentosPagina.Count > 0 && DocumentosPagina.All(x => seleccionados.Contains(x.Id));
    private IReadOnlyList<EDeclaraCasillaCompra> CasillasActuales => tipoDocumento switch { 2 => catalogos.CasillasVentas, 3 => catalogos.CasillasNotasCredito, 4 => catalogos.CasillasNotasCreditoVentas, _ => catalogos.CasillasCompras };
    private string DescripcionCasillaEdicion => CasillasActuales.FirstOrDefault(x=>x.Id==edicion.Casilla)?.Descripcion ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state=await AuthStateProvider.GetAuthenticationStateAsync(); var user=state.User;
            if(user.Identity?.IsAuthenticated!=true || !int.TryParse(user.FindFirst("IdUsuario")?.Value,out userId)){Navigation.NavigateTo("/login",true);return;}
            var superAdmin=user.FindFirst("IdTipoUsuario")?.Value==AppAccessService.AdminRoleId;
            var access=await AppAccessService.CanAccessAsync(userId,EDeclaraRoutes.ServiceKey,superAdmin);
            if(!access.HasAccess){Navigation.NavigateTo($"/suscripciones?servicio={EDeclaraRoutes.ServiceKey}",true);return;}
            await SelectedAppServiceState.SetCurrentServiceKeyAsync(EDeclaraRoutes.ServiceKey);
            contribuyentes=(await ContribuyentesService.ObtenerContribuyentesAsync(userId)).Where(x=>x.Estado==true).ToList();
            var seleccionado=ContribuyenteIdQuery.HasValue
                ? contribuyentes.FirstOrDefault(x=>x.CodContribuyente==ContribuyenteIdQuery.Value)
                : contribuyentes.FirstOrDefault();
            if(seleccionado is null) throw new InvalidOperationException("Registra al menos un contribuyente activo antes de administrar compras.");
            contribuyenteId=seleccionado.CodContribuyente;
            perfilNombre=NombreContribuyente(seleccionado);
            perfilIdentificacion=seleccionado.Numeroidentificacion?.Trim()??string.Empty;
            claveSriConfigurada=await SriCredentialService.TieneClaveContribuyenteAsync(userId,contribuyenteId);
            catalogos=await ComprasService.ObtenerCatalogosAsync();
            await CargarAsync();
        }
        catch(Exception ex){errorInicial=$"No se pudo abrir el módulo de compras: {ex.Message}";}
        finally{cargando=false;}
    }

    private async Task CambiarContribuyenteAsync(ChangeEventArgs e){if(!int.TryParse(e.Value?.ToString(),out var value)||!contribuyentes.Any(x=>x.CodContribuyente==value))return;contribuyenteId=value;var seleccionado=contribuyentes.First(x=>x.CodContribuyente==value);perfilNombre=NombreContribuyente(seleccionado);perfilIdentificacion=seleccionado.Numeroidentificacion?.Trim()??string.Empty;claveSriConfigurada=await SriCredentialService.TieneClaveContribuyenteAsync(userId,contribuyenteId);CerrarFormulario();await EjecutarCargaAsync();}
    private async Task CargarAsync(){documentos=await ComprasService.ListarAsync(userId,contribuyenteId,anio,periodo,tipoDocumento);seleccionados.Clear();pagina=1;detalleAbierto=null;}
    private async Task CambiarAnioAsync(ChangeEventArgs e){anio=int.Parse(e.Value?.ToString()??DateTime.Today.Year.ToString());await EjecutarCargaAsync();}
    private async Task CambiarPeriodoAsync(ChangeEventArgs e){periodo=int.Parse(e.Value?.ToString()??DateTime.Today.Month.ToString());await EjecutarCargaAsync();}
    private async Task CambiarTipoAsync(int value){tipoDocumento=value;CerrarFormulario();await EjecutarCargaAsync();}
    private async Task EjecutarCargaAsync(){LimpiarMensaje();try{ocupado=true;await CargarAsync();}catch(Exception ex){MostrarError(ex.Message);}finally{ocupado=false;}}
    private async Task ClasificarConIaAsync()
    {
        LimpiarMensaje();
        ocupado = clasificandoIa = true;
        try
        {
            var resultado = await ClasificacionIaService.ClasificarAsync(userId, contribuyenteId, anio, periodo);
            var detalle = resultado.Errores.Count > 0 ? $" {string.Join(" | ", resultado.Errores.Take(3))}" : string.Empty;
            if (resultado.Clasificados == 0) MostrarError($"No se clasificaron documentos automáticamente.{detalle}");
            else MostrarExito($"IA clasificó {resultado.Clasificados} documento(s). Pendientes: {resultado.Pendientes}.{detalle}");
            await CargarAsync();
        }
        catch (Exception ex) { MostrarError(ex.Message); }
        finally { ocupado = clasificandoIa = false; }
    }
    private async Task EjecutarClasificacionAutomaticaAsync()
    {
        if (tipoDocumento == 6) return;
        try
        {
            var resultado = await ClasificacionIaService.ClasificarAsync(userId, contribuyenteId, anio, periodo);
            if (resultado.Clasificados > 0)
            {
                await CargarAsync();
                MostrarExito($"Clasificación automática: {resultado.Clasificados} documento(s) procesado(s). Pendientes: {resultado.Pendientes}.");
            }
            else if (resultado.TieneErrores)
            {
                MostrarError($"La clasificación automática requiere revisión. {string.Join(" | ", resultado.Errores.Take(3))}");
            }
        }
        catch (Exception ex) { MostrarError($"No se pudo ejecutar la clasificación automática: {ex.Message}"); }
    }
    private void Filtrar(ChangeEventArgs e){filtro=e.Value?.ToString()??string.Empty;pagina=1;seleccionados.Clear();}
    private void Nuevo(){edicion=CrearModeloBase();mostrarFormulario=true;}
    private void Editar(EDeclaraCompraDocumento item){edicion=Copiar(item);mostrarFormulario=true;}
    private void CerrarFormulario(){mostrarFormulario=false;edicion=CrearModeloBase();}
    private EDeclaraCompraDocumento CrearModeloBase()=>new(){IdContribuyente=contribuyenteId,Anio=anio,Periodo=periodo,TipoDocumento=tipoDocumento,FechaEmision=FechaInicialPeriodo(),Origen="MANUAL"};
    private DateTime FechaInicialPeriodo()=>anio==DateTime.Today.Year && ((periodo<=12&&periodo==DateTime.Today.Month)||(periodo==13&&DateTime.Today.Month<=6)||(periodo==14&&DateTime.Today.Month>=7))?DateTime.Today:new DateTime(anio,periodo switch{13=>1,14=>7,_=>periodo},1);
    private static EDeclaraCompraDocumento Copiar(EDeclaraCompraDocumento x)=>new(){Id=x.Id,IdContribuyente=x.IdContribuyente,Anio=x.Anio,Periodo=x.Periodo,TipoDocumento=x.TipoDocumento,TipoFacturacion=x.TipoFacturacion,Serie=x.Serie,Numero=x.Numero,FechaEmision=x.FechaEmision,Ruc=x.Ruc,RazonSocial=x.RazonSocial,IdentificacionComprador=x.IdentificacionComprador,Concepto=x.Concepto,Casilla=x.Casilla,Tarifa=x.Tarifa,BaseImponible=x.BaseImponible,Iva=x.Iva,SerieDocumentoModificado=x.SerieDocumentoModificado,NumeroDocumentoModificado=x.NumeroDocumentoModificado,NumeroAutorizacion=x.NumeroAutorizacion,Origen=x.Origen,EsFaltante=x.EsFaltante,Detalles=x.Detalles};

    private async Task GuardarAsync(){LimpiarMensaje();guardando=true;try{edicion.IdContribuyente=contribuyenteId;edicion.Anio=anio;edicion.Periodo=periodo;edicion.TipoDocumento=tipoDocumento;await ComprasService.GuardarAsync(userId,edicion);CerrarFormulario();await CargarAsync();await EjecutarClasificacionAutomaticaAsync();if(string.IsNullOrWhiteSpace(mensaje))MostrarExito("Documento guardado correctamente.");}catch(Exception ex){MostrarError(ex.Message);}finally{guardando=false;}}
    private void CambiarTarifaEdicion(ChangeEventArgs e){edicion.Tarifa=Decimal(e.Value);edicion.Iva=Math.Round(edicion.BaseImponible*edicion.Tarifa/100m,2);}
    private void CambiarBaseEdicion(ChangeEventArgs e){edicion.BaseImponible=Decimal(e.Value);edicion.Iva=Math.Round(edicion.BaseImponible*edicion.Tarifa/100m,2);}
    private static decimal Decimal(object? value)=>decimal.TryParse(value?.ToString(),System.Globalization.NumberStyles.Any,System.Globalization.CultureInfo.InvariantCulture,out var n)?n:0m;
    private async Task BuscarProveedorAsync(){if(string.IsNullOrWhiteSpace(edicion.Ruc)||!string.IsNullOrWhiteSpace(edicion.RazonSocial))return;try{var local=await ComprasService.BuscarRazonSocialAsync(userId,contribuyenteId,edicion.Ruc);if(!string.IsNullOrWhiteSpace(local)){edicion.RazonSocial=local;return;}if(!claveSriConfigurada)return;var result=await CedulaLookupService.ConsultarAsync(edicion.Ruc);if(result.Success&&result.Found)edicion.RazonSocial=result.RazonSocial??result.NombreCompleto??string.Empty;}catch{}}
    private async Task BuscarFacturaRelacionadaAsync()
    {
        if (tipoDocumento is not (3 or 4) || string.IsNullOrWhiteSpace(edicion.Ruc) || string.IsNullOrWhiteSpace(edicion.SerieDocumentoModificado) || string.IsNullOrWhiteSpace(edicion.NumeroDocumentoModificado)) return;
        var factura = await ComprasService.BuscarFacturaRelacionadaAsync(userId, contribuyenteId, anio, periodo, edicion.SerieDocumentoModificado, edicion.NumeroDocumentoModificado, edicion.Ruc, tipoDocumento == 4 ? 2 : 1);
        if (factura is null) { MostrarError("No se encontró la factura relacionada en el período."); return; }
        edicion.RazonSocial = factura.RazonSocial;
        edicion.Concepto = string.IsNullOrWhiteSpace(edicion.Concepto) ? factura.Concepto : edicion.Concepto;
        edicion.TipoFacturacion = factura.TipoFacturacion;
        edicion.Casilla = factura.Casilla;
        LimpiarMensaje();
    }

    private async Task ImportarXmlAsync(InputFileChangeEventArgs e){LimpiarMensaje();ocupado=true;try{var archivos=new List<(string Nombre,string Xml)>();foreach(var file in e.GetMultipleFiles(100)){if(file.Size>10*1024*1024){MostrarError($"{file.Name} supera 10 MB.");continue;}using var reader=new StreamReader(file.OpenReadStream(10*1024*1024));archivos.Add((file.Name,await reader.ReadToEndAsync()));}var result=await ComprasService.ImportarXmlAsync(userId,contribuyenteId,anio,periodo,archivos,"XML",tipoDocumento is 2 or 4 ? 2 : 1);MostrarResultado(result,"Importación XML");await CargarAsync();await EjecutarClasificacionAutomaticaAsync();}catch(Exception ex){MostrarError(ex.Message);}finally{ocupado=false;}}
    private async Task SincronizarVentasEFactAsync(){LimpiarMensaje();ocupado=sincronizando=true;await InvokeAsync(StateHasChanged);try{var result=await ComprasService.SincronizarVentasEFactAsync(userId,contribuyenteId,anio,periodo,tipoDocumento);MostrarResultado(result,"Sincronización E-Fact");await CargarAsync();await EjecutarClasificacionAutomaticaAsync();}catch(Exception ex){MostrarError(ex.Message);}finally{ocupado=sincronizando=false;}}
    private string TiempoEstimadoConsulta => periodo is 13 or 14 ? "18 a 30 minutos" : "3 a 5 minutos";
    private async Task ConsultarSriAsync(){LimpiarMensaje();ocupado=sincronizando=true;await InvokeAsync(StateHasChanged);try{var result=await ComprasService.ConsultarSriAsync(userId,contribuyenteId,anio,periodo,tipoDocumento);MostrarResultado(result,"Consulta SRI");await CargarAsync();await EjecutarClasificacionAutomaticaAsync();}catch(Exception ex){MostrarError(ex.Message);}finally{ocupado=sincronizando=false;}}
    private void MostrarResultado(EDeclaraImportacionResultado x,string proceso){var detalle=x.Errores.Count>0?$" Errores: {string.Join(" | ",x.Errores.Take(4))}":string.Empty;var texto=$"{proceso}: {x.Importados} registro(s) importado(s) y {x.Omitidos} duplicado(s) omitido(s).{detalle}";if(x.Errores.Count>0&&x.Importados==0)MostrarError(texto);else MostrarExito(texto);}
    private async Task RegistrarFaltantesAsync(){if(!await JS.InvokeAsync<bool>("confirm","¿Registrar los secuenciales faltantes entre los documentos existentes?"))return;ocupado=true;try{var count=await ComprasService.RegistrarFaltantesAsync(userId,contribuyenteId,anio,periodo,tipoDocumento);MostrarExito($"Se registraron {count} secuencial(es) faltante(s).");await CargarAsync();}catch(Exception ex){MostrarError(ex.Message);}finally{ocupado=false;}}
    private async Task EliminarAsync(EDeclaraCompraDocumento item){if(!await JS.ConfirmDeleteAsync("Eliminar compra",$"Se eliminará el documento {item.Serie}-{item.Numero}.","Sí, eliminar"))return;await ComprasService.EliminarAsync(userId,contribuyenteId,new[]{item.Id});MostrarExito("Registro eliminado.");await CargarAsync();}
    private async Task EliminarSeleccionadosAsync(){if(!await JS.ConfirmDeleteAsync("Eliminar compras",$"Se eliminarán {seleccionados.Count} registro(s) seleccionado(s).","Sí, eliminar"))return;await ComprasService.EliminarAsync(userId,contribuyenteId,seleccionados);MostrarExito("Registros eliminados.");await CargarAsync();}
