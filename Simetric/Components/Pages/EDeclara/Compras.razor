    private async Task ExportarAsync(){try{var headers=new[]{"Tipo","Actividad","Serie","Número","Fecha","RUC","Razón social","Concepto","Serie relacionada","Número relacionado","Casilla","Tarifa","Base","IVA","Origen"};var rows=DocumentosFiltrados.Select(x=>(IReadOnlyList<string>)new[]{NombreTipoDocumentoSingular(),catalogos.Actividades.FirstOrDefault(a=>a.Id==x.TipoFacturacion)?.Descripcion??"",x.Serie,x.Numero,x.FechaEmision.ToString("dd/MM/yyyy"),x.Ruc,x.RazonSocial,x.Concepto,x.SerieDocumentoModificado,x.NumeroDocumentoModificado,x.Casilla,x.Tarifa.ToString("0.##"),x.BaseImponible.ToString("0.00"),x.Iva.ToString("0.00"),x.Origen}).ToList();var file=ExcelService.Create($"compras-{anio}-{periodo:00}.xlsx",new ExcelSheetData(NombreTipoDocumentoPlural(),headers,rows));await using var stream=new MemoryStream(file.Content);using var reference=new DotNetStreamReference(stream);await JS.InvokeVoidAsync("downloadFileFromStream",file.FileName,reference,file.ContentType);}catch(Exception ex){MostrarError($"No se pudo exportar: {ex.Message}");}}
    private static string NombreContribuyente(ContribuyenteEdeclare contribuyente)=>!string.IsNullOrWhiteSpace(contribuyente.Nombrerazonsocial)?contribuyente.Nombrerazonsocial.Trim():$"{contribuyente.Apellidos} {contribuyente.Nombres}".Trim();
    private void IrAPerfil()=>Navigation.NavigateTo(EDeclaraRoutes.Profile);
    private void MostrarError(string value){mensaje=value;mensajeError=true;}
    private void MostrarExito(string value){mensaje=value;mensajeError=false;}
    private void LimpiarMensaje(){mensaje=string.Empty;mensajeError=false;}
    private string NombreTipoDocumentoSingular()=>tipoDocumento switch { 2 => "Venta", 3 => "Nota de crédito", 4 => "Nota de crédito de venta", 6 => "Retención", _ => "Compra" };
    private string NombreTipoDocumentoPlural()=>tipoDocumento switch { 2 => "Ventas", 3 => "Notas de crédito", 4 => "Notas de crédito de ventas", 6 => "Retenciones", _ => "Compras" };
    private static string NombrePeriodo(int value)=>System.Globalization.CultureInfo.GetCultureInfo("es-EC").DateTimeFormat.GetMonthName(value);
    private static string Dinero(decimal value)=>value.ToString("C2",System.Globalization.CultureInfo.GetCultureInfo("es-EC"));
    private static string FormatoDocumento(string serie,string numero)=>string.IsNullOrWhiteSpace(serie)&&string.IsNullOrWhiteSpace(numero)?"—":$"{serie}-{numero}";
    private string? DescripcionActividad(EDeclaraCompraDocumento documento)=>catalogos.Actividades.FirstOrDefault(x=>x.Id==documento.TipoFacturacion)?.Descripcion;
    private string? DescripcionCasilla(EDeclaraCompraDocumento documento)=>CasillasActuales.FirstOrDefault(x=>x.Id==documento.Casilla)?.Descripcion;
