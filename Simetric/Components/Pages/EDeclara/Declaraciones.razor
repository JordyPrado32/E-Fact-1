@page "/e-declara/declaraciones"
@page "/e-contax/declaraciones"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Models
@using Simetric.Models.EDeclara
@using Simetric.Services
@using Simetric.Services.EDeclara
@using Simetric.Services.EContax
@inject AuthenticationStateProvider AuthStateProvider
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject EDeclaraDeclaracionesService DeclaracionesService
@inject EDeclaraClasificacionIaService ClasificacionIaService
@inject ContribuyenteEdeclaraService ContribuyentesService
@inject NavigationManager Navigation

<PageTitle>Declaraciones | @NombreAplicacion</PageTitle>

<div class="ec-shell @(EsContextoEContax ? "econtax-context" : string.Empty)">
    <section class="ec-hero">
        <div class="ec-hero-content">
            <span class="ec-kicker">Gestión tributaria</span>
            <h1>Declaraciones <span>| @NombreAplicacion</span></h1>
            <p>Presenta, gestiona y controla tus declaraciones tributarias de forma rápida y segura.</p>
            <div class="ec-hero-features">
                <div><i class="ri-file-shield-2-line"></i><span><strong>Información validada</strong><small>Con datos de tus documentos</small></span></div>
                <div><i class="ri-shield-check-line"></i><span><strong>Cumplimiento normativo</strong><small>Según normativa vigente</small></span></div>
                <div><i class="ri-draft-line"></i><span><strong>Generación y borrador</strong><small>Guarda y revisa antes de enviar</small></span></div>
            </div>
        </div>
        <div class="ec-hero-visual" aria-hidden="true"><span class="ec-visual-card ec-visual-doc"><i class="ri-file-list-3-line"></i></span><img src="/images/support/numerica-support-bot12.png" alt="" /><span class="ec-visual-card ec-visual-ok"><i class="ri-checkbox-circle-line"></i></span></div>
    </section>

    @if (cargando)
    {
        <section class="ec-state"><span class="spinner-border" role="status"></span><strong>Preparando declaración</strong></section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
            <section class="ec-alert ec-alert-error" role="alert" aria-live="assertive"><i class="ri-error-warning-line"></i><span>@error</span></section>
    }
    else
    {
        <section class="ec-context-card">
            <div class="ec-context-copy"><span class="ec-kicker">Contribuyente seleccionado</span><strong>@perfilNombre</strong><small>@perfilIdentificacion</small><small>@EstadoTexto(analisis.Estado) · versión @analisis.VersionCalculo</small></div>
            <div class="ec-context-period"><label><span>Contribuyente</span><select value="@contribuyenteId" @onchange="CambiarContribuyenteAsync">@foreach (var contribuyente in contribuyentes){<option value="@contribuyente.CodContribuyente">@NombreContribuyente(contribuyente) · @contribuyente.Numeroidentificacion</option>}</select></label><label><span>Período a declarar</span><select value="@anio" @onchange="CambiarAnioAsync">@for (var value = DateTime.Today.Year; value >= DateTime.Today.Year - 6; value--){<option value="@value">@value</option>}</select></label><label><span>&nbsp;</span><select value="@periodo" @onchange="CambiarPeriodoAsync">@for (var value = 1; value <= 12; value++){<option value="@value">@NombrePeriodo(value)</option>}<option value="13">Primer semestre</option><option value="14">Segundo semestre</option></select></label></div>
            <button type="button" class="ec-btn ec-btn-light" disabled="@ocupado" @onclick="AnalizarAsync"><i class="ri-refresh-line"></i> Actualizar análisis</button>
        </section>

        <nav class="ec-stepper" aria-label="Flujo de declaración">
            <button type="button" class="ec-step @(pasoActual == 1 ? "is-active" : "is-done")" @onclick="() => IrPaso(1)"><span>1</span><div><strong>Período</strong><small>Cuenta y rango fiscal</small></div></button>
            <i class="ri-arrow-right-line"></i>
            <button type="button" class="ec-step @(pasoActual == 2 ? "is-active" : pasoActual > 2 ? "is-done" : "")" @onclick="() => IrPaso(2)"><span>2</span><div><strong>Validación</strong><small>Documentos y controles</small></div></button>
            <i class="ri-arrow-right-line"></i>
            <button type="button" class="ec-step @(pasoActual == 3 ? "is-active" : "")" disabled="@(!analisis.PuedeGuardarBorrador)" @onclick="() => IrPaso(3)"><span>3</span><div><strong>Revisión</strong><small>Casillas y borrador</small></div></button>
        </nav>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <section class="ec-alert @(mensajeError ? "ec-alert-error" : "ec-alert-success")" role="status" aria-live="polite"><i class="ri-@(mensajeError ? "error-warning" : "checkbox-circle")-line"></i><span>@mensaje</span></section>
        }

        @if (pasoActual == 1)
        {
            <div class="ec-overview-grid">
                <div class="ec-overview-main">
                    <section class="ec-declaration-card">
                        <div class="ec-section-head"><div><h2>Selecciona el tipo de declaración</h2><p>El análisis utiliza únicamente facturas, notas de crédito y retenciones descargadas para esta cuenta.</p></div></div>
                        <div class="ec-type-grid">
                            <button type="button" class="ec-type-card is-selected"><i class="ri-file-list-3-line"></i><span><strong>IVA</strong><small>Formulario 104</small><small>Mensual</small></span><b><i class="ri-check-line"></i></b></button>
                            <button type="button" class="ec-type-card" disabled><i class="ri-file-shield-2-line"></i><span><strong>Retenciones</strong><small>Formulario 103</small><small>Mensual</small></span></button>
                            <button type="button" class="ec-type-card" disabled><i class="ri-file-chart-line"></i><span><strong>Renta</strong><small>Formulario 101</small><small>Anual</small></span></button>
                            <button type="button" class="ec-type-card" disabled><i class="ri-archive-drawer-line"></i><span><strong>Anexos</strong><small>ATS, ISD, ICE</small><small>Según período</small></span></button>
                        </div>
                    </section>
                    <section class="ec-summary-card">
                        <div class="ec-section-head"><div><h2>Resumen de información cargada</h2><p>Documentos considerados para el cálculo del período seleccionado.</p></div></div>
                        <div class="ec-summary-grid">
                            <article><i class="ri-file-list-3-line"></i><span>Facturas de compra<strong>@analisis.TotalFacturas</strong></span></article>
                            <article><i class="ri-file-reduce-line"></i><span>Notas de crédito<strong>@analisis.TotalNotasCredito</strong></span></article>
                            <article><i class="ri-file-shield-2-line"></i><span>Retenciones<strong>@analisis.TotalRetenciones</strong></span></article>
                            <article><i class="ri-stack-line"></i><span>Total documentos<strong>@analisis.TotalDocumentos</strong></span></article>
                        </div>
                        <div class="ec-start-bar"><span><i class="ri-information-line"></i> Revisa el período y el tipo de declaración para continuar con el análisis.</span><button type="button" class="ec-btn ec-btn-primary" disabled="@ocupado" @onclick="IrAValidacionAsync">Continuar <i class="ri-arrow-right-line"></i></button></div>
                    </section>
                </div>
                <aside class="ec-overview-aside">
                    <section class="ec-info-card">
                        <div class="ec-aside-title"><h2>Información del período</h2><span><i class="ri-calendar-line"></i> @NombrePeriodo(periodo) @anio</span></div>
                        <ul><li><i class="ri-user-3-line"></i><span>Tipo de contribuyente<strong>Persona natural</strong></span></li><li><i class="ri-book-2-line"></i><span>Declaración seleccionada<strong>IVA · Formulario 104</strong></span></li><li><i class="ri-money-dollar-circle-line"></i><span>Moneda<strong>USD - Dólares</strong></span></li><li><i class="ri-time-line"></i><span>Información actualizada<strong>@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy · HH:mm", System.Globalization.CultureInfo.GetCultureInfo("es-EC"))</strong></span></li></ul>
                    </section>
                    <section class="ec-guide-card"><h2>Guía rápida</h2><ol><li><i class="ri-calendar-check-line"></i><span><strong>Selecciona el período</strong><small>Elige el año y mes que vas a declarar.</small></span></li><li><i class="ri-search-eye-line"></i><span><strong>Valida la información</strong><small>Revisa documentos y controles.</small></span></li><li><i class="ri-draft-line"></i><span><strong>Genera el borrador</strong><small>Visualiza las casillas y guarda el período.</small></span></li></ol></section>
                </aside>
            </div>
        }

        @if (pasoActual is 2 or 3)
        {
        <section class="ec-metrics">
            <article><span>Documentos</span><strong>@analisis.TotalDocumentos</strong><small>Período seleccionado</small></article>
            <article><span>Compras</span><strong>@Dinero(analisis.ComprasBase)</strong><small>Base imponible</small></article>
            <article><span>Notas de crédito</span><strong>@Dinero(analisis.NotasCreditoBase)</strong><small>Base a descontar</small></article>
            <article><span>Ventas</span><strong>@Dinero(analisis.VentasBase)</strong><small>Base imponible</small></article>
            <article><span>IVA generado</span><strong>@Dinero(analisis.IvaGenerado)</strong><small>Ventas menos NC</small></article>
            <article><span>Base neta</span><strong>@Dinero(analisis.BaseNeta)</strong><small>Compras menos notas</small></article>
            <article><span>IVA neto</span><strong>@Dinero(analisis.IvaNeto)</strong><small>IVA de compras menos notas</small></article>
            <article><span>Saldo antes de retenciones</span><strong>@Dinero(analisis.IvaAntesRetenciones)</strong><small>IVA generado menos crédito</small></article>
            <article class="@(analisis.PendientesClasificacion > 0 ? "is-pending" : "")"><span>Pendientes</span><strong>@analisis.PendientesClasificacion</strong><small>Actividad o casilla</small></article>
        </section>

        <section class="ec-source-strip" aria-label="Documentos analizados">
            <span class="ec-source-title"><i class="ri-database-2-line"></i> Fuentes del análisis</span>
            <span><i class="ri-file-list-3-line"></i> @analisis.TotalFacturas factura(s)</span>
            <span><i class="ri-file-reduce-line"></i> @analisis.TotalNotasCredito nota(s) de crédito</span>
            <span><i class="ri-file-shield-2-line"></i> @analisis.TotalRetenciones retención(es)</span>
            <span class="ec-source-progress"><strong>@ValidacionesCorrectas/@ValidacionesTotal</strong> controles aprobados</span>
        </section>

        <section class="ec-validation-card">
            <div class="ec-validation-head">
                <div><span class="ec-kicker">Control previo</span><h2>Validaciones de la declaración</h2><p class="ec-subtitle">Selecciona un control para consultar cómo resolverlo.</p></div>
                <span class="ec-validation-state @(analisis.TieneBloqueos ? "is-error" : "is-ok")"><i class="ri-@(analisis.TieneBloqueos ? "close-circle" : "checkbox-circle")-line"></i>@(analisis.TieneBloqueos ? "Requiere corrección" : "Lista para borrador")</span>
            </div>
            <div class="ec-validation-grid">
                @foreach (var item in analisis.Validaciones)
                {
                    <button type="button" @key="item.Codigo" class="ec-validation-item @(item.EsValida ? "is-ok" : item.EsBloqueante ? "is-error" : "is-warning")" @onclick="() => AbrirValidacion(item)">
                        <i class="ri-@(item.EsValida ? "checkbox-circle" : item.EsBloqueante ? "error-warning" : "alert")-line"></i>
                        <div><strong>@item.Mensaje</strong><small>@(item.EsValida ? "Validado" : item.EsBloqueante ? "Corrige este punto para guardar" : "Advertencia: puedes continuar con el borrador")</small></div>
                        <i class="ri-arrow-right-s-line ec-validation-arrow"></i>
                    </button>
                }
            </div>
            @if (analisis.TieneBloqueos)
            {
                <div class="ec-inline-warning"><i class="ri-lock-line"></i><span>Resuelve los bloqueos antes de guardar el borrador.</span>@if (analisis.PendientesClasificacion > 0){<button type="button" class="ec-btn ec-btn-ai" disabled="@(ocupado || clasificandoIa)" @onclick="ClasificarConIaAsync">@if(clasificandoIa){<span class="spinner-border spinner-border-sm"></span>}else{<i class="ri-sparkling-2-line"></i>} Clasificar con IA</button>}<button type="button" class="ec-link-btn" @onclick="IrACompras">Abrir Compras</button></div>
            }
        </section>

        @if (pasoActual == 2)
        {
            <section class="ec-next-card"><div><span class="ec-kicker">Siguiente paso</span><strong>Cuando las validaciones estén listas, revisa las casillas calculadas.</strong></div><button type="button" class="ec-btn ec-btn-primary" disabled="@(!analisis.PuedeGuardarBorrador)" @onclick="() => IrPaso(3)">Revisar casillas <i class="ri-arrow-right-line"></i></button></section>
        }

        @if (pasoActual == 3)
        {
        <section class="ec-workspace">
            <div class="ec-editor-head"><div><span class="ec-kicker">Paso 3 · Revisar</span><h2>Casillas de la declaración</h2><p class="ec-subtitle">Los valores se calculan desde los documentos clasificados del período.</p></div><div><button type="button" class="ec-btn ec-btn-light" disabled="@(ocupado || !analisis.PuedeGuardarBorrador || analisis.Estado == EDeclaraEstadoDeclaracion.Presentada)" @onclick="SolicitarGuardado"><i class="ri-save-3-line"></i> Guardar borrador</button><button type="button" class="ec-btn ec-btn-primary" disabled="@(ocupado || !analisis.PuedeGuardarBorrador || analisis.Estado == EDeclaraEstadoDeclaracion.Presentada)" @onclick="ValidarDeclaracionAsync"><i class="ri-shield-check-line"></i> Validar declaración</button></div></div>
            <div class="ec-table-wrap">
                <table class="ec-table">
                    <thead><tr><th>Origen</th><th>Casilla</th><th class="number">Base</th><th class="number">IVA</th><th>Documentos</th></tr></thead>
                    <tbody>
                    @if (analisis.Casillas.Count == 0)
                    {
                        <tr><td colspan="5"><div class="ec-empty"><i class="ri-inbox-archive-line"></i><strong>No hay documentos para analizar</strong><span>Consulta o importa los comprobantes desde Compras.</span><button type="button" class="ec-link-btn" @onclick="IrACompras">Ir a Compras</button></div></td></tr>
                    }
                    @foreach (var item in analisis.Casillas)
                    {
                        <tr @key="item.Grupo + item.Casilla"><td><span class="ec-badge">@item.Grupo</span></td><td><strong>@item.Casilla</strong></td><td class="number">@Dinero(item.Base)</td><td class="number">@Dinero(item.Iva)</td><td>@item.Documentos</td></tr>
                    }
                    </tbody>
                    @if (analisis.Casillas.Count > 0)
                    {
                        <tfoot><tr><td colspan="2"><strong>Totales</strong></td><td class="number"><strong>@Dinero(analisis.BaseNeta + analisis.VentasBase - analisis.NotasCreditoVentasBase)</strong></td><td class="number"><strong>@Dinero(analisis.IvaNeto + analisis.IvaGenerado)</strong></td><td><strong>@analisis.Casillas.Sum(x => x.Documentos)</strong></td></tr></tfoot>
                    }
                </table>
            </div>
            <div class="ec-summary-footer"><span><i class="ri-shield-check-line"></i> Retenciones de IVA identificadas: <strong>@Dinero(analisis.RetencionesIva)</strong></span><span><i class="ri-calculator-line"></i> Saldo estimado después de retenciones: <strong>@Dinero(analisis.IvaDespuesRetenciones)</strong></span></div>
        </section>
        }
        }
    }
</div>

@if (validacionSeleccionada is not null)
{
    <div class="ec-modal-backdrop" role="presentation" @onclick="CerrarModal">
        <section class="ec-modal" role="dialog" aria-modal="true" aria-labelledby="validacion-titulo" @onclick:stopPropagation="true">
            <div class="ec-modal-head"><div><span class="ec-kicker">Detalle de control</span><h2 id="validacion-titulo">@TituloValidacion(validacionSeleccionada)</h2></div><button type="button" class="ec-modal-close" aria-label="Cerrar" @onclick="CerrarModal"><i class="ri-close-line"></i></button></div>
            <div class="ec-modal-status @(validacionSeleccionada.EsValida ? "is-ok" : validacionSeleccionada.EsBloqueante ? "is-error" : "is-warning")"><i class="ri-@(validacionSeleccionada.EsValida ? "checkbox-circle" : validacionSeleccionada.EsBloqueante ? "error-warning" : "alert")-line"></i><strong>@validacionSeleccionada.Mensaje</strong></div>
            <p class="ec-modal-copy">@AyudaValidacion(validacionSeleccionada)</p>
            <div class="ec-modal-actions"><button type="button" class="ec-btn ec-btn-light" @onclick="CerrarModal">Cerrar</button>@if (!validacionSeleccionada.EsValida && validacionSeleccionada.Codigo == "CLASIFICACION"){<button type="button" class="ec-btn ec-btn-primary" @onclick="IrACompras">Ir a Compras</button>}</div>
        </section>
    </div>
}

@if (mostrarConfirmacionGuardado)
{
    <div class="ec-modal-backdrop" role="presentation" @onclick="CancelarGuardado">
        <section class="ec-modal ec-modal-confirm" role="dialog" aria-modal="true" aria-labelledby="guardar-titulo" @onclick:stopPropagation="true">
            <div class="ec-modal-icon"><i class="ri-save-3-line"></i></div><h2 id="guardar-titulo">Guardar borrador de declaración</h2><p class="ec-modal-copy">Se guardará el análisis de @NombrePeriodo(periodo) @anio para la cuenta <strong>@perfilNombre</strong>. Podrás revisarlo nuevamente antes de presentarlo.</p>
            <div class="ec-modal-actions"><button type="button" class="ec-btn ec-btn-light" @onclick="CancelarGuardado">Cancelar</button><button type="button" class="ec-btn ec-btn-primary" disabled="@ocupado" @onclick="ConfirmarGuardadoAsync"><i class="ri-check-line"></i> Confirmar guardado</button></div>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "contribuyenteId")]
    private int? ContribuyenteIdQuery { get; set; }

    private int userId;
    private int contribuyenteId;
    private int anio = DateTime.Today.Year;
    private int periodo = DateTime.Today.Month;
    private bool cargando = true;
    private bool ocupado;
    private bool clasificandoIa;
    private bool clasificacionAutomaticaIntentada;
    private bool mensajeError;
    private int pasoActual = 1;
    private bool mostrarConfirmacionGuardado;
    private EDeclaraDeclaracionValidacion? validacionSeleccionada;
    private bool EsContextoEContax => EContaxRoutes.IsEContaxPath(Navigation, Navigation.Uri);
    private string NombreAplicacion => EsContextoEContax ? "E-Contax" : "E-Declara";
    private string error = string.Empty;
    private string mensaje = string.Empty;
    private string perfilNombre = string.Empty;
    private string perfilIdentificacion = string.Empty;
    private List<ContribuyenteEdeclare> contribuyentes = new();
    private EDeclaraDeclaracionAnalisis analisis = new();
    private int ValidacionesTotal => analisis.Validaciones.Count;
    private int ValidacionesCorrectas => analisis.Validaciones.Count(x => x.EsValida);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated != true || !int.TryParse(user.FindFirst("IdUsuario")?.Value, out userId))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            var superAdmin = user.FindFirst("IdTipoUsuario")?.Value == AppAccessService.AdminRoleId;
            var serviceKey = EContaxRoutes.IsEContaxPath(Navigation, Navigation.Uri)
                ? EContaxRoutes.ServiceKey
                : EDeclaraRoutes.ServiceKey;
            var access = await AppAccessService.CanAccessAsync(userId, serviceKey, superAdmin);
            if (!access.HasAccess)
            {
                Navigation.NavigateTo($"/suscripciones?servicio={serviceKey}", true);
                return;
            }

            await SelectedAppServiceState.SetCurrentServiceKeyAsync(serviceKey);
            contribuyentes = (await ContribuyentesService.ObtenerContribuyentesAsync(userId))
                .Where(x => x.Estado == true)
                .ToList();
            var seleccionado = ContribuyenteIdQuery.HasValue
                ? contribuyentes.FirstOrDefault(x => x.CodContribuyente == ContribuyenteIdQuery.Value)
                : contribuyentes.FirstOrDefault();
            if (seleccionado is null)
                throw new InvalidOperationException("Registra al menos un contribuyente activo antes de analizar declaraciones.");

            contribuyenteId = seleccionado.CodContribuyente;
            perfilNombre = NombreContribuyente(seleccionado);
            perfilIdentificacion = seleccionado.Numeroidentificacion?.Trim() ?? string.Empty;
            await CargarAnalisisGuardadoOActualizarAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarContribuyenteAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value) || !contribuyentes.Any(x => x.CodContribuyente == value)) return;
        contribuyenteId = value;
        var seleccionado = contribuyentes.First(x => x.CodContribuyente == value);
        perfilNombre = NombreContribuyente(seleccionado);
        perfilIdentificacion = seleccionado.Numeroidentificacion?.Trim() ?? string.Empty;
        pasoActual = 1;
        clasificacionAutomaticaIntentada = false;
        await CargarAnalisisGuardadoOActualizarAsync();
    }

    private async Task CambiarAnioAsync(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var value)) anio = value; pasoActual = 1; clasificacionAutomaticaIntentada = false; await CargarAnalisisGuardadoOActualizarAsync(); }
    private async Task CambiarPeriodoAsync(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var value)) periodo = value; pasoActual = 1; clasificacionAutomaticaIntentada = false; await CargarAnalisisGuardadoOActualizarAsync(); }

    private async Task CargarAnalisisGuardadoOActualizarAsync()
    {
        var borrador = await DeclaracionesService.ObtenerBorradorAsync(userId, contribuyenteId, anio, periodo);
        if (borrador.DeclaracionId > 0)
        {
            analisis = borrador;
            return;
        }

        await AnalizarAsync();
        await ClasificarPendientesAutomaticamenteAsync();
    }

    private async Task IrAValidacionAsync() { pasoActual = 2; await AnalizarAsync(); }
    private void IrPaso(int paso) { if (paso == 3 && !analisis.PuedeGuardarBorrador) { pasoActual = 2; return; } pasoActual = paso; }
    private void AbrirValidacion(EDeclaraDeclaracionValidacion item) => validacionSeleccionada = item;
    private void CerrarModal() => validacionSeleccionada = null;
    private void SolicitarGuardado() => mostrarConfirmacionGuardado = analisis.PuedeGuardarBorrador;
    private void CancelarGuardado() => mostrarConfirmacionGuardado = false;
    private void IrACompras()
    {
        CerrarModal();
        var ruta = EContaxRoutes.IsEContaxPath(Navigation, Navigation.Uri)
            ? EContaxRoutes.Compras
            : EDeclaraRoutes.Compras;
        Navigation.NavigateTo($"{ruta}?contribuyenteId={contribuyenteId}");
    }
    private async Task ConfirmarGuardadoAsync() { mostrarConfirmacionGuardado = false; await GuardarAsync(); }

    private string TituloValidacion(EDeclaraDeclaracionValidacion item) => item.Codigo switch
    {
        "CUENTA" => $"Cuenta {NombreAplicacion}",
        "DOCUMENTOS" => "Documentos del período",
        "PERIODO" => "Fechas del período",
        "IDENTIFICACION" => "Identificación del contribuyente",
        "IMPORTES" => "Importes tributarios",
        "DUPLICADOS" => "Documentos duplicados",
        "NOTAS" => "Relación de notas de crédito",
        "CLASIFICACION" => "Clasificación de documentos",
        _ => "Validación"
    };

    private string AyudaValidacion(EDeclaraDeclaracionValidacion item) => item.Codigo switch
    {
        "CUENTA" => $"La declaración solo puede trabajar con la identificación configurada en la cuenta {NombreAplicacion} activa.",
        "DOCUMENTOS" => "Descarga o importa las facturas, notas de crédito y retenciones desde el módulo Compras.",
        "PERIODO" => "Cada documento debe tener una fecha de emisión dentro del mes o semestre seleccionado.",
        "IDENTIFICACION" => "La identificación del comprador o sujeto retenido debe coincidir con la cuenta activa.",
        "IMPORTES" => "Revisa que la base imponible y el IVA de los documentos sean valores no negativos.",
        "DUPLICADOS" => "Elimina el registro repetido o conserva solo el comprobante válido antes de analizar nuevamente.",
        "NOTAS" => "Cada nota de crédito debe estar relacionada con una factura del mismo proveedor y período.",
         "CLASIFICACION" => $"Ejecuta la clasificación automática con IA. Solo se guardarán actividades y casillas existentes en el catálogo {NombreAplicacion}.",
        _ => "Revisa el detalle en el módulo Compras."
    };

    private async Task AnalizarAsync()
    {
        if (userId <= 0) return;
        ocupado = true;
        error = string.Empty;
        mensaje = string.Empty;
        mensajeError = false;
        try { analisis = await DeclaracionesService.AnalizarAsync(userId, contribuyenteId, anio, periodo); }
        catch (Exception ex) { error = ex.Message; }
        finally { ocupado = false; }
    }

    private async Task GuardarAsync()
    {
        ocupado = true;
        error = string.Empty;
        mensaje = string.Empty;
        mensajeError = false;
        try { analisis = await DeclaracionesService.GuardarAsync(userId, contribuyenteId, analisis); mensaje = $"Borrador guardado correctamente. Versión {analisis.VersionCalculo}."; }
        catch (Exception ex) { error = ex.Message; }
        finally { ocupado = false; }
    }

    private async Task ValidarDeclaracionAsync()
    {
        ocupado = true;
        error = string.Empty;
        mensaje = string.Empty;
        mensajeError = false;
        try
        {
            analisis = await DeclaracionesService.ValidarAsync(userId, contribuyenteId, analisis);
            mensaje = $"Declaración validada correctamente. Versión {analisis.VersionCalculo}.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { ocupado = false; }
    }

    private async Task ClasificarConIaAsync()
    {
        ocupado = clasificandoIa = true;
        error = string.Empty;
        mensaje = string.Empty;
        mensajeError = false;
        try
        {
            var resultado = await ClasificacionIaService.ClasificarAsync(userId, contribuyenteId, anio, periodo);
            var detalle = resultado.Errores.Count > 0 ? $" {string.Join(" | ", resultado.Errores.Take(3))}" : string.Empty;
            await AnalizarAsync();
            mensajeError = resultado.Clasificados == 0 && resultado.TieneErrores;
            mensaje = resultado.Clasificados == 0
                ? $"No se clasificaron documentos automáticamente.{detalle}"
                : $"IA clasificó {resultado.Clasificados} documento(s). Pendientes: {resultado.Pendientes}.{detalle}";
        }
        catch (Exception ex) { mensajeError = true; mensaje = $"No se pudo ejecutar la clasificación automática: {ex.Message}"; }
        finally { ocupado = clasificandoIa = false; }
    }

    private async Task ClasificarPendientesAutomaticamenteAsync()
    {
        if (clasificacionAutomaticaIntentada || analisis.PendientesClasificacion == 0) return;
        clasificacionAutomaticaIntentada = true;
        await ClasificarConIaAsync();
    }

    private static string NombrePeriodo(int value) => System.Globalization.CultureInfo.GetCultureInfo("es-EC").DateTimeFormat.GetMonthName(value);
    private static string NombreContribuyente(ContribuyenteEdeclare contribuyente) =>
        !string.IsNullOrWhiteSpace(contribuyente.Nombrerazonsocial)
            ? contribuyente.Nombrerazonsocial.Trim()
            : $"{contribuyente.Apellidos} {contribuyente.Nombres}".Trim();
    private static string EstadoTexto(EDeclaraEstadoDeclaracion estado) => estado switch
    {
        EDeclaraEstadoDeclaracion.Validada => "Validada",
        EDeclaraEstadoDeclaracion.Presentada => "Presentada",
        EDeclaraEstadoDeclaracion.Rechazada => "Rechazada",
        _ => "Borrador"
    };
    private static string Dinero(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-EC"));
}
