@page "/demo/erubrica"
@layout Simetric.Components.Layout.MainLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Simetric.Models
@using System.Globalization

<PageTitle>eRúbrica demo | Numerica</PageTitle>

<div class="erubrica-demo">
    @if (Vista == "documentos")
    {
        <Simetric.Components.Pages.ESign.Documentos DemoMode="true" />
    }
    else if (Vista == "validar")
    {
        <Simetric.Components.Pages.ESign.ValidarFirmaDocumento DemoMode="true" />
    }
    else if (Vista == "historial")
    {
        <Simetric.Components.Pages.MisPagos DemoMode="true" />
    }
    else if (Vista == "firma")
    {
        <Simetric.Components.Pages.ESign.MisFirmas DemoMode="true" />
    }
    else if (Vista == "soporte")
    {
        <Simetric.Components.Pages.ESign.Soporte DemoMode="true" />
    }
    else if (Vista == "dashboard")
    {
        <Simetric.Components.Pages.ESign.Dashboard DemoMode="true" />
    }
    else if (Vista == "solicitud")
    {
    <Simetric.Components.Pages.NuevaSolicitud DemoMode="true" />
    @* La solicitud demo utiliza exactamente el formulario oficial con datos precargados. *@
    @if (false) {
    <section class="erubrica-hero">
        <div>
            <span class="demo-kicker">Firma electrónica · recorrido completo</span>
            <h1>Solicita, paga y firma con eRúbrica</h1>
            <p>Explora el proceso de una cuenta real con datos simulados. Ninguna acción genera cobros, solicitudes externas ni documentos reales.</p>
        </div>
        <div class="erubrica-total"><span>Total demo</span><strong>@Total.ToString("C", Cultura)</strong><small>IVA incluido</small></div>
    </section>

    <section class="erubrica-steps">
        @foreach (var step in Steps.Select((value, index) => (value, index)))
        {
            <button type="button" class="erubrica-step @(step.index == Paso ? "active" : step.index < Paso ? "done" : string.Empty)" @onclick="() => IrA(step.index)">
                <span>@(step.index < Paso ? "✓" : (step.index + 1).ToString())</span><strong>@step.value</strong>
            </button>
        }
    </section>

    <section class="erubrica-card">
        @if (Paso == 0)
        {
            <span class="demo-kicker">1 · Solicitud</span><h2>Elige la vigencia de tu certificado</h2>
            <p class="muted">En una cuenta real completarías tus datos personales y cargarías los documentos de validación.</p>
            <div class="erubrica-options">
                @foreach (var plan in Planes)
                {
                    <button type="button" class="erubrica-option @(Vigencia == plan.Key ? "selected" : string.Empty)" @onclick="() => Vigencia = plan.Key"><span>@plan.Label</span><strong>@plan.Price.ToString("C", Cultura)</strong><small>Precio sin IVA</small></button>
                }
            </div>
            <button class="demo-primary" @onclick="() => Paso = 1">Continuar solicitud <i class="ri-arrow-right-line"></i></button>
        }
        else if (Paso == 1)
        {
            <span class="demo-kicker">2 · Pago</span><h2>Confirma el pago de tu solicitud</h2>
            <div class="erubrica-summary"><span>Certificado eRúbrica · @SelectedPlan.Label</span><strong>@Total.ToString("C", Cultura)</strong><small>Subtotal @Subtotal.ToString("C", Cultura) + IVA @Iva.ToString("C", Cultura)</small></div>
            <div class="demo-alert"><i class="ri-information-line"></i> En la demo el pago se aprueba automáticamente para mostrarte el siguiente paso.</div>
            <button class="demo-primary" @onclick="() => Paso = 2">Simular pago aprobado <i class="ri-check-line"></i></button>
        }
        else if (Paso == 2)
        {
            <span class="demo-kicker">3 · Aprobación</span><h2>Solicitud aprobada por BackOffice</h2>
            <div class="erubrica-status"><i class="ri-checkbox-circle-fill"></i><div><strong>Pago confirmado</strong><span>Solicitud #ER-2026-0042 · @SelectedPlan.Label · @Total.ToString("C", Cultura)</span></div></div>
            <div class="erubrica-timeline"><span><b>✓</b> Solicitud recibida</span><span><b>✓</b> Pago validado</span><span><b>✓</b> Certificado listo para usar</span></div>
            <button class="demo-primary" @onclick="() => Paso = 3">Ir a mis documentos <i class="ri-arrow-right-line"></i></button>
        }
        else
        {
            <span class="demo-kicker">4 · Firma</span><h2>Firma un documento PDF</h2>
            <p class="muted">Selecciona un documento de ejemplo y observa cómo queda disponible la acción de firma.</p>
            <div class="erubrica-document"><i class="ri-file-pdf-2-line"></i><div><strong>Contrato-servicios-2026.pdf</strong><small>PDF · 3 páginas · Listo para firmar</small></div><button class="demo-secondary" @onclick="() => DocumentoFirmado = !DocumentoFirmado">@(DocumentoFirmado ? "Firmado" : "Firmar documento")</button></div>
            @if (DocumentoFirmado) { <div class="demo-alert success"><i class="ri-checkbox-circle-line"></i> Firma aplicada correctamente en modo demo.</div> }
            <button class="demo-secondary back" @onclick="Reiniciar">Volver a iniciar el recorrido</button>
        }
    </section>
    }
    }
</div>

<style>
    .erubrica-demo{max-width:1120px;margin:0 auto;padding:2rem 1.25rem 4rem;color:#17324a}.erubrica-hero{display:flex;justify-content:space-between;gap:2rem;align-items:center;padding:2rem;border-radius:24px;background:linear-gradient(135deg,#effaf3,#e8f4ee);border:1px solid #cbe5d2}.demo-kicker{color:#147a45;font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.erubrica-hero h1{margin:.55rem 0 .65rem;font-size:clamp(1.7rem,4vw,2.7rem)}.erubrica-hero p{max-width:690px;margin:0;color:#567064}.erubrica-total{min-width:145px;text-align:right}.erubrica-total span,.erubrica-total small{display:block;color:#567064;font-size:.8rem}.erubrica-total strong{display:block;color:#147a45;font-size:1.8rem}.erubrica-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1.4rem 0}.erubrica-step{border:1px solid #d7e3dc;background:#fff;border-radius:14px;padding:.8rem;text-align:left;color:#718078;cursor:pointer}.erubrica-step span{display:inline-grid;place-items:center;width:25px;height:25px;border-radius:50%;margin-right:.45rem;background:#edf2ef;font-weight:800}.erubrica-step.active{border-color:#39a968;color:#147a45;box-shadow:0 4px 14px #147a4518}.erubrica-step.active span,.erubrica-step.done span{background:#d9f4e2;color:#147a45}.erubrica-card{background:#fff;border:1px solid #dce7e0;border-radius:20px;padding:clamp(1.3rem,3vw,2.2rem);box-shadow:0 12px 30px #17324a0d}.erubrica-card h2{margin:.45rem 0 .55rem}.erubrica-demo .muted{color:#667b70}.erubrica-options{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin:1.4rem 0}.erubrica-option{border:1px solid #dce7e0;background:#fff;border-radius:14px;padding:1rem;text-align:left;cursor:pointer}.erubrica-option.selected{border:2px solid #29a45e;background:#f1fbf4}.erubrica-option span,.erubrica-option strong,.erubrica-option small{display:block}.erubrica-option strong{margin:.45rem 0;color:#147a45;font-size:1.25rem}.erubrica-option small,.erubrica-summary small{color:#718078}.demo-primary,.demo-secondary{border:0;border-radius:10px;padding:.75rem 1.15rem;font-weight:800;cursor:pointer}.demo-primary{background:#16834a;color:#fff}.demo-secondary{background:#edf7ef;color:#147a45}.erubrica-summary,.erubrica-status,.erubrica-document{display:flex;align-items:center;gap:1rem;padding:1.1rem;margin:1.3rem 0;background:#f7faf8;border:1px solid #dce7e0;border-radius:14px}.erubrica-summary strong{margin-left:auto;color:#147a45;font-size:1.3rem}.erubrica-summary small{display:block}.demo-alert{padding:1rem;margin:1rem 0;background:#eff8ff;border-radius:12px;color:#315d78}.demo-alert.success{background:#eaf9ef;color:#147a45}.erubrica-status i{font-size:2rem;color:#1b9b56}.erubrica-status span,.erubrica-status strong{display:block}.erubrica-timeline{display:grid;gap:.7rem;margin:1.4rem 0}.erubrica-timeline b{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#d9f4e2;color:#147a45;margin-right:.5rem}.erubrica-document>i{font-size:2rem;color:#d34b4b}.erubrica-document div{flex:1}.erubrica-document strong,.erubrica-document small{display:block}.erubrica-demo .back{margin-top:1rem}@@media(max-width:720px){.erubrica-hero{display:block}.erubrica-total{text-align:left;margin-top:1.2rem}.erubrica-steps{grid-template-columns:repeat(2,1fr)}.erubrica-options{grid-template-columns:1fr}.erubrica-document{align-items:flex-start;flex-wrap:wrap}.erubrica-document button{margin-left:3rem}}
</style>

<style>
    .erubrica-demo {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-x: hidden;
    }

    .erubrica-demo :deep(.esign-page),
    .erubrica-demo :deep(.validation-page),
    .erubrica-demo :deep(.signature-page),
    .erubrica-demo :deep(.support-center-shell),
    .erubrica-demo :deep(.mis-pagos-shell),
    .erubrica-demo :deep(.solicitud-shell) {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-x: hidden;
    }

    @@media (max-width: 760px) {
        .erubrica-demo {
            padding-left: 0.6rem;
            padding-right: 0.6rem;
        }

        .erubrica-demo :deep(.esign-header-section),
        .erubrica-demo :deep(.validation-header),
        .erubrica-demo :deep(.signature-hero),
        .erubrica-demo :deep(.mis-pagos-head),
        .erubrica-demo :deep(.solicitud-page-head) {
            display: block;
        }

        .erubrica-demo :deep(.header-actions),
        .erubrica-demo :deep(.signature-hero-visual),
        .erubrica-demo :deep(.mis-pagos-summary),
        .erubrica-demo :deep(.solicitud-head-actions) {
            margin-top: 1rem;
        }

        .erubrica-demo :deep(.mis-pagos-table-wrap) {
            overflow-x: auto;
        }

        .erubrica-demo :deep(.mis-pagos-table) {
            min-width: 760px;
        }
    }

    /* Estos nombres también existen en las vistas oficiales; la demo no debe cambiar su layout. */
    .erubrica-demo .signature-panel.validation-panel {
        display: block;
        grid-template-columns: none;
        gap: initial;
    }
</style>

