k}.erubrica-profile-grid,.support-grid,.dashboard-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:1rem}.profile-heading{display:flex;align-items:center;gap:.8rem;color:#147a45;font-size:1.15rem}.profile-heading i{font-size:2.3rem}.profile-heading strong,.profile-heading small{display:block}.detail-list{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin:1.5rem 0}.detail-list dt{color:#718078}.detail-list dd{margin:0;font-weight:700}.activity-list{display:grid;gap:1rem;margin-top:1rem}.activity-list span{display:block}.activity-list b{display:inline-grid;place-items:center;width:23px;height:23px;margin-right:.5rem;border-radius:50%;background:#d9f4e2;color:#147a45}.activity-list small{display:block;margin:.25rem 0 0 1.9rem;color:#718078}.support-grid{grid-template-columns:repeat(2,1fr)}.support-icon{font-size:2.3rem;color:#16834a}.support-grid h3{margin:.7rem 0 .4rem}.support-grid p{color:#667b70;min-height:42px}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin:1.2rem 0}.metric-card{padding:1.1rem;border:1px solid #dce7e0;border-radius:15px;background:#fff}.metric-card i{color:#16834a;font-size:1.5rem}.metric-card strong,.metric-card span,.metric-card small{display:block}.metric-card strong{font-size:1.5rem;margin:.3rem 0}.metric-card span{font-weight:700}.metric-card small{color:#718078;margin-top:.25rem}.quick-actions{display:grid;gap:.7rem}.quick-action{display:flex;align-items:center;gap:.8rem;padding:.8rem;border-radius:10px;background:#f5faf6;color:#17324a;text-decoration:none}.quick-action>i{font-size:1.5rem;color:#16834a}.quick-action strong,.quick-action small{display:block}.quick-action small{color:#718078;margin-top:.2rem}@@media(max-width:760px){.metric-grid{grid-template-columns:repeat(2,1fr)}.dashboard-grid,.erubrica-profile-grid,.erubrica-demo .validation-panel{grid-template-columns:1fr}.support-grid{grid-template-columns:1fr}.erubrica-row{align-items:flex-start;flex-wrap:wrap}.erubrica-row button{margin-left:3rem}}
</style>

@code {
    [SupplyParameterFromQuery(Name = "vista")] private string? VistaQuery { get; set; }
    private string Vista => (VistaQuery ?? "dashboard").Trim().ToLowerInvariant();
    private string Busqueda = string.Empty;
    private bool DocumentoValidado;
    private IReadOnlyList<DemoDocument> DocumentosFiltrados => string.IsNullOrWhiteSpace(Busqueda) ? Documentos : Documentos.Where(x => x.Nombre.Contains(Busqueda, StringComparison.OrdinalIgnoreCase)).ToList();
    private IReadOnlyList<DemoDocument> Documentos =
    [
        new("Contrato-servicios-2026.pdf", "28/08/2026", 3, "María Fernanda López"),
        new("Autorizacion-representante.pdf", "21/08/2026", 2, "María Fernanda López"),
        new("Acuerdo-comercial-andina.pdf", "14/08/2026", 5, "María Fernanda López")
    ];
    private IReadOnlyList<DemoRequest> Solicitudes =
    [
        new("ER-2026-0042", "Certificado nuevo", "28/08/2026", "1 año", ESignPricing.ObtenerPrecioBase("1 ANIO"), "approved", "Aprobada"),
        new("ER-2026-0031", "Renovación de firma", "12/07/2026", "1 año", ESignPricing.ObtenerPrecioBase("1 ANIO"), "completed", "Completada"),
        new("ER-2026-0024", "Certificado nuevo", "05/06/2026", "30 días", ESignPricing.ObtenerPrecioBase("30 DIAS"), "pending", "En revisión")
    ];
    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-EC");
    private static readonly string[] Steps = ["Solicitud", "Pago", "Aprobación", "Firma"];
    private static readonly IReadOnlyList<(string Key, string Label, decimal Price)> Planes =
    [
        ("7 DIAS", "7 días", ESignPricing.ObtenerPrecioBase("7 DIAS")),
        ("30 DIAS", "30 días", ESignPricing.ObtenerPrecioBase("30 DIAS")),
        ("1 ANIO", "1 año", ESignPricing.ObtenerPrecioBase("1 ANIO")),
        ("2 ANIOS", "2 años", ESignPricing.ObtenerPrecioBase("2 ANIOS")),
        ("3 ANIOS", "3 años", ESignPricing.ObtenerPrecioBase("3 ANIOS")),
        ("4 ANIOS", "4 años", ESignPricing.ObtenerPrecioBase("4 ANIOS"))
    ];
    private int Paso;
    private string Vigencia = "1 ANIO";
    private bool DocumentoFirmado;
    private void ValidarDocumento() => DocumentoValidado = true;
    private (string Key, string Label, decimal Price) SelectedPlan => Planes.First(x => x.Key == Vigencia);
    private decimal Precio => SelectedPlan.Price;
    private decimal Subtotal => ESignPricing.ObtenerSubtotal(Vigencia);
    private decimal Iva => decimal.Round(Subtotal * ESignPricing.IvaRate, 2, MidpointRounding.AwayFromZero);
    private decimal Total => Subtotal + Iva;
    private void IrA(int paso) { if (paso <= Paso) Paso = paso; }
    private void Reiniciar() { Paso = 0; DocumentoFirmado = false; }
}

@code {
    private sealed record DemoDocument(string Nombre, string Fecha, int Paginas, string Titular);
    private sealed record DemoRequest(string Id, string Tipo, string Fecha, string Vigencia, decimal Total, string Clase, string Estado);
}
