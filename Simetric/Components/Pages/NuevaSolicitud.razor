    {
        var total = ObtenerDocumentosVisibles().Count();
        return $"{archivosTemporales.Count}/{total} cargados";
    }

    private string GetDocumentosAyudaResumen()
    {
        if (archivosTemporales.Count == 0)
        {
            return "Se adjuntan al finalizar.";
        }

        return "Puedes reemplazarlos antes de enviar.";
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(solicitud);
        catalogoNacionalidades = NacionalidadesCatalogo.ToList();
        provinciasEcuador = CatalogoUbicacionEcuador.Provincias;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst("IdUsuario")?.Value;
        usuarioActualId = int.TryParse(idClaim, out var parsedId) ? parsedId : 0;
        solicitud.SolFormatoFirma = "ARCHIVO_P12";
        solicitud.SolVigencia = "7 DIAS";
        solicitud.SolMontoPago = 10.00m;
        solicitud.SolTipoPersona = TipoPersonaNatural;
        if (SolicitudEditarId is > 0)
        {
            var rechazada = await SolicitudService.ObtenerSolicitudRechazadaClienteAsync(SolicitudEditarId.Value, usuarioActualId);
            if (rechazada is not null)
            {
                modoEdicionRechazada = true;
                CopiarSolicitudEditable(rechazada);
                foreach (var documento in rechazada.Documentos.Where(d => d.DocVigente))
                    documentosExistentes[documento.DocTipo] = documento.DocNombreArchivo;
                mensajeGeneralFormulario = "Solicitud rechazada cargada. Corrige únicamente los datos o archivos necesarios.";
            }
            else
            {
                edicionNoDisponible = true;
                mensajeGeneralFormulario = "Esta solicitud ya no está disponible para edición o no pertenece a tu cuenta.";
            }
        }
        else if (SolicitudRenovarId is > 0)
        {
            esRenovacion = true;
            var anterior = await SolicitudService.ObtenerSolicitudRenovacionClienteAsync(SolicitudRenovarId.Value, usuarioActualId);
            if (anterior is null)
            {
                edicionNoDisponible = true;
                mensajeGeneralFormulario = "La solicitud no está disponible para renovación.";
            }
            else if (UsarDatosRenovacion)
            {
                CopiarSolicitudEditable(anterior);
                solicitudOrigenId = anterior.SolId;
                solicitud.SolId = 0;
                solicitud.SolIdUsuarioCliente = usuarioActualId;
                solicitud.SolIdTransaccionPago = null;
                solicitud.SolPagoExitoso = false;
                solicitud.SolFechaSolicitud = DateTime.Now;
                foreach (var documento in anterior.Documentos.Where(d => d.DocVigente))
                    documentosExistentes[documento.DocTipo] = documento.DocNombreArchivo;
                mensajeGeneralFormulario = "Datos y documentos de la solicitud anterior cargados. Revisa y modifica lo necesario antes de pagar.";
            }
            else
            {
                mensajeGeneralFormulario = "Solicitud de renovación iniciada. Completa los datos y adjunta los documentos requeridos.";
            }
        }
        SincronizarTipoPersonaConRuc();
        ActualizarCantonesDisponibles();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SelectedAppServiceState.SetCurrentServiceKeyAsync("e-sign");
            borradoresGuardados = await ObtenerBorradoresGuardadosAsync();
            tieneBorrador = borradoresGuardados.Any();
            StateHasChanged();
        }
    }

    private async Task GuardarBorradorAsync()
    {
        mensajeBorrador = null;
        borradorExitoso = false;
        NormalizarSolicitud();
        VerificarEdad();

        var borradores = await ObtenerBorradoresGuardadosAsync();
        borradores.Insert(0, new SolicitudFirmaDraftItem
        {
            Id = Guid.NewGuid().ToString("N"),
            FechaGuardado = DateTime.Now,
            Titulo = CrearTituloBorrador(),
            Datos = SolicitudFirmaDraft.FromSolicitud(solicitud)
        });

        borradoresGuardados = borradores
            .OrderByDescending(b => b.FechaGuardado)
            .Take(20)
            .ToList();

        await GuardarBorradoresGuardadosAsync(borradoresGuardados);
        tieneBorrador = true;
        borradorExitoso = true;
        mensajeBorrador = "Solicitud de cliente conservada. Podrás retomarla desde Solicitudes de clientes; los documentos deberán confirmarse o adjuntarse al usarla.";
    }

    private async Task AbrirHistorialBorradoresAsync()
    {
        mensajeBorrador = null;
        borradorExitoso = false;
        borradoresGuardados = await ObtenerBorradoresGuardadosAsync();
        tieneBorrador = borradoresGuardados.Any();

        if (!tieneBorrador)
        {
            mensajeBorrador = "No encontramos solicitudes de clientes conservadas para esta cuenta.";
            return;
        }

        mostrarModalBorradores = true;
    }

    private async Task SeleccionarBorradorAsync(SolicitudFirmaDraftItem borrador)
    {
        var volverADocumentos = false;

        if (archivosTemporales.Count > 0)
        {
            var mantener = await JS.InvokeAsync<bool>(
                "confirm",
                "Ya tienes documentos cargados en esta solicitud. Acepta para seguir con esos documentos o cancela para adjuntarlos nuevamente.");
            if (!mantener)
            {
                LimpiarDocumentosTemporales();
                volverADocumentos = true;
                mensajeArchivos = "Adjunta nuevamente los documentos para esta solicitud.";
            }
        }

        AplicarBorrador(borrador.Datos);
        if (volverADocumentos)
        {
            paso = 2;
        }

        mostrarModalBorradores = false;
        borradorExitoso = true;
        mensajeBorrador = archivosTemporales.Count > 0
            ? "Solicitud aplicada. Se mantuvieron los documentos que ya estaban cargados."
            : "Solicitud aplicada. Revisa la información y adjunta los documentos requeridos.";
    }

    private async Task EliminarBorradorAsync(SolicitudFirmaDraftItem borrador)
    {
        borradoresGuardados = borradoresGuardados
            .Where(item => !string.Equals(item.Id, borrador.Id, StringComparison.Ordinal))
            .ToList();

        await GuardarBorradoresGuardadosAsync(borradoresGuardados);
        tieneBorrador = borradoresGuardados.Any();
        if (!tieneBorrador)
        {
            mostrarModalBorradores = false;
        }
    }

    private void CerrarHistorialBorradores()
    {
        mostrarModalBorradores = false;
    }

    private async Task<List<SolicitudFirmaDraftItem>> ObtenerBorradoresGuardadosAsync()
    {
        var raw = await JS.InvokeAsync<string?>("localStorage.getItem", DraftStorageKey);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new List<SolicitudFirmaDraftItem>();
        }

        try
        {
            var items = JsonSerializer.Deserialize<List<SolicitudFirmaDraftItem>>(raw);
            if (items is { Count: > 0 })
            {
                return items
                    .Where(item => item.Datos is not null)
                    .OrderByDescending(item => item.FechaGuardado)
                    .ToList();
            }
        }
        catch
        {
        }

        try
        {
            var draft = JsonSerializer.Deserialize<SolicitudFirmaDraft>(raw);
            if (draft is not null)
            {
                return
                [
                    new SolicitudFirmaDraftItem
                    {
                        Id = Guid.NewGuid().ToString("N"),
                        FechaGuardado = DateTime.Now,
                        Titulo = "Solicitud anterior",
                        Datos = draft
                    }
                ];
            }
        }
        catch
        {
        }

        return new List<SolicitudFirmaDraftItem>();
    }

    private async Task GuardarBorradoresGuardadosAsync(List<SolicitudFirmaDraftItem> borradores)
    {
        var json = JsonSerializer.Serialize(borradores);
        await JS.InvokeVoidAsync("localStorage.setItem", DraftStorageKey, json);
    }

