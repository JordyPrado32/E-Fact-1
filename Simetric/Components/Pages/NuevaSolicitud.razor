                                <i class="bi bi-signpost solicitud-input-icon"></i>
                                <InputText @bind-Value="solicitud.SolDireccion"
                                           class="solicitud-field-input"
                                           maxlength="300"
                                           placeholder="Calle principal y secundaria"
                                           autocomplete="street-address" />
                            </div>
                            <ValidationMessage For="@(() => solicitud.SolDireccion)" class="solicitud-field-error" />
                        </div>

                        @if (solicitud.SolEsMayor65)
                        {
                            <div class="solicitud-alert solicitud-alert-warning">
                                <i class="bi bi-camera-video-fill"></i>
                                <span>Al ser mayor de 65 años, en el siguiente paso se solicitará también un video corto de aceptación.</span>
                            </div>
                        }

                        <div class="solicitud-actions solicitud-bottom-actions">
                            <button type="button" class="secondary-btn" @onclick="LimpiarFormulario">
                                <i class="bi bi-eraser"></i> Limpiar formulario
                            </button>
                            <button type="button" class="secondary-btn solicitud-save-draft-btn @(borradorExitoso ? "is-saved" : string.Empty)" @onclick="GuardarBorradorAsync">
                                <i class="bi bi-person-check"></i> Conservar solicitud del cliente
                            </button>
                            <button type="button" class="primary-btn solicitud-action-main" @onclick="IrAPasoDocumentos">
                                Siguiente <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="solicitud-card" data-tour="solicitud.step2">
                <div class="solicitud-card-header">
                    <div class="solicitud-step-pill">Paso 2</div>
                    <div>
                        <h3>Adjunta la documentación requerida</h3>
                        <p>Los archivos se validan por formato y tamaño antes de enviar la solicitud.</p>
                    </div>
                </div>

                <div class="solicitud-config-banner">
                    <span class="solicitud-config-chip">@GetFormatoFirmaLabel()</span>
                    <span class="solicitud-config-chip">@GetVigenciaLabel(solicitud.SolVigencia)</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeArchivos))
                {
                    <div class="solicitud-alert solicitud-alert-danger">
                        <i class="bi bi-paperclip"></i>
                        <span>@mensajeArchivos</span>
                    </div>
                }

                <div class="solicitud-grid solicitud-upload-grid" data-tour="solicitud.uploads">
                    @foreach (var documento in ObtenerDocumentosVisibles())
                    {
                        <div class="solicitud-upload-card @(TieneArchivo(documento.Tipo) ? "solicitud-upload-card-loaded" : string.Empty) @(documento.Tipo == "VIDEO_ACEPTACION" ? "solicitud-upload-card-warning" : string.Empty)">
                            <div class="solicitud-field-top">
                                <label class="solicitud-field-label">@documento.Titulo</label>
                                <span class="solicitud-field-tag">@(documento.EsObligatorio ? "Obligatorio" : "Opcional")</span>
                            </div>

                            <p class="solicitud-upload-help">@documento.Ayuda</p>

                            <InputFile OnChange="@(e => OnFile(e, documento.Tipo))"
                                       class="solicitud-upload-input"
                                       accept="@documento.Accept" />

                            @if (TieneArchivo(documento.Tipo))
                            {
                                <div class="solicitud-upload-ok">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>@ObtenerNombreArchivo(documento.Tipo)</span>
                                </div>
                            }

                            @if (erroresDocumentos.TryGetValue(documento.Tipo, out var errorDocumento))
                            {
                                <div class="solicitud-field-error">@errorDocumento</div>
                            }

                            <small class="solicitud-upload-meta">
                                Formatos: @documento.FormatosTexto | Máximo: @FormatearTamano(documento.TamanoMaximoBytes)
                            </small>
                        </div>
                    }
                </div>

                <div class="solicitud-actions solicitud-actions-between solicitud-bottom-actions" data-tour="solicitud.submit">
                    <button type="button" class="secondary-btn" @onclick="RegresarAPasoUno">
                        <i class="bi bi-arrow-left"></i> Regresar
                    </button>

                    <div class="solicitud-bottom-actions-right">
                        <button type="button" class="secondary-btn solicitud-save-draft-btn @(borradorExitoso ? "is-saved" : string.Empty)" @onclick="GuardarBorradorAsync">
                            <i class="bi bi-person-check"></i> Conservar solicitud del cliente
                        </button>

                        <button type="submit" class="primary-btn solicitud-action-main" disabled="@(enviando || edicionNoDisponible)">
                            @if (enviando)
                            {
                                <span>Enviando solicitud...</span>
                            }
                            else
                            {
                                <span>@(modoEdicionRechazada ? "Corregir y reenviar" : solicitud.SolId > 0 ? "Continuar con el pago" : "Finalizar y enviar")</span>
                            }
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </section>
        }
    </EditForm>
        </main>
    </div>
</div>

@if (mostrarModalBorradores)
{
    <div class="solicitud-drafts-overlay" role="dialog" aria-modal="true" aria-labelledby="draftHistoryTitle" @onclick="CerrarHistorialBorradores">
        <section class="solicitud-drafts-modal" @onclick:stopPropagation>
            <header class="solicitud-drafts-header">
                <div>
                    <span class="solicitud-section-kicker">Solicitudes conservadas</span>
                    <h3 id="draftHistoryTitle">Selecciona una solicitud de cliente</h3>
                </div>
                <button type="button" class="solicitud-drafts-close" @onclick="CerrarHistorialBorradores" aria-label="Cerrar solicitudes conservadas">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="solicitud-drafts-body">
                @if (!borradoresGuardados.Any())
                {
                    <div class="solicitud-empty-state">
                        <i class="bi bi-info-circle"></i>
                        <div>
                            <strong>No hay solicitudes conservadas.</strong>
                            <span>Conserva una solicitud de cliente para retomarla aquí.</span>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var borrador in borradoresGuardados)
                    {
                        <article class="solicitud-draft-item">
                            <button type="button" class="solicitud-draft-select" @onclick="() => SeleccionarBorradorAsync(borrador)">
                                <span class="solicitud-draft-icon"><i class="bi bi-person-lines-fill"></i></span>
                                <span>
                                    <strong>@borrador.Titulo</strong>
                                    <small>@borrador.FechaGuardado.ToString("dd/MM/yyyy HH:mm")</small>
                                </span>
                            </button>
                            <button type="button" class="solicitud-draft-delete" @onclick="() => EliminarBorradorAsync(borrador)" aria-label="Quitar solicitud conservada">
                                <i class="bi bi-trash"></i>
                            </button>
                        </article>
                    }
                }
            </div>
        </section>
    </div>
}

@if (mostrarModalPagoFirma)
{
    <div class="firma-payment-overlay" role="dialog" aria-modal="true" aria-labelledby="firmaPaymentTitle" @onclick="CerrarModalPagoFirma">
        <section class="firma-payment-modal" @onclick:stopPropagation>
            <header class="firma-payment-header">
                <div>
                    <span class="solicitud-section-kicker">Resumen de pago</span>
                    <h3 id="firmaPaymentTitle">Firma electrónica @GetVigenciaLabel(solicitud.SolVigencia)</h3>
                    <p>Elige pagar en línea o registrar una transferencia para aprobación.</p>
                </div>
                <button type="button" class="firma-payment-close" @onclick="CerrarModalPagoFirma" disabled="@procesandoPagoFirma" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="firma-payment-body">
                <div class="firma-payment-summary">
                    <div class="firma-summary-card">
                        <span>Servicio</span>
                        <strong>e-Rúbrica</strong>
                    </div>
                    <div class="firma-summary-card">
                        <span>Subtotal</span>
                        <strong>$@SubtotalFirma.ToString("F2")</strong>
                    </div>
                    <div class="firma-summary-card">
                        <span>IVA 15%</span>
                        <strong>$@IvaFirma.ToString("F2")</strong>
                    </div>
                    <div class="firma-summary-card is-total">
                        <span>Total</span>
                        <strong>USD $@TotalFirma.ToString("F2")</strong>
                    </div>
                </div>

                <div class="firma-payment-methods">
                    <button type="button" class="firma-method-card @(metodoPagoFirma == "online" ? "is-active" : string.Empty)" @onclick='() => SeleccionarMetodoPagoFirma("online")' disabled="@procesandoPagoFirma">
                        <i class="bi bi-phone"></i>
                        <span><strong>DeUna / Pago en línea</strong><small>Abre el checkout seguro y se acredita al aprobarse.</small></span>
                    </button>
                    <button type="button" class="firma-method-card @(metodoPagoFirma == "transferencia" ? "is-active" : string.Empty)" @onclick='() => SeleccionarMetodoPagoFirma("transferencia")' disabled="@procesandoPagoFirma">
                        <i class="bi bi-bank"></i>
                        <span><strong>Transferencia bancaria</strong><small>Se valida manualmente en un plazo máximo de 24 horas.</small></span>
                    </button>
                </div>

                @if (metodoPagoFirma == "transferencia")
                {
                    <div class="firma-transfer-layout">
                        <div class="firma-transfer-form">
                            <h4>Información de pago</h4>
                            <div class="firma-transfer-fields">
                                <label><span>Banco *</span><select @bind="transferBancoFirma" disabled="@procesandoPagoFirma"><option value="">Seleccione...</option>@foreach (var banco in BancosTransferenciaFirma) { <option value="@banco">@banco</option> }</select></label>
                                <label><span>Titular de la cuenta *</span><input type="text" placeholder="Nombre del titular" @bind="transferTitularFirma" disabled="@procesandoPagoFirma" /></label>
                                <label><span>N. cuenta de origen *</span><input type="text" inputmode="numeric" placeholder="Cuenta desde donde pagaste" @bind:get="transferCuentaFirma" @bind:set="OnTransferCuentaFirmaChanged" @bind:event="oninput" disabled="@procesandoPagoFirma" /></label>
                                <label><span>N. comprobante *</span><input type="text" maxlength="50" placeholder="Letras o números del comprobante" @bind:get="transferComprobanteFirma" @bind:set="OnTransferComprobanteFirmaChanged" @bind:event="oninput" disabled="@procesandoPagoFirma" /></label>
                            </div>
                            <label class="firma-transfer-upload @(TieneComprobanteFirma ? "has-file" : string.Empty)" for="firma-transfer-file">
                                <i class="bi bi-image"></i>
                                <span><strong>@(TieneComprobanteFirma ? "Comprobante cargado" : "Arrastra o selecciona el comprobante")</strong><small>@(transferArchivoFirmaNombre ?? "JPG o PNG. Máximo 5MB. Haz clic en cualquier parte del cuadro.")</small></span>
                                @if (!string.IsNullOrWhiteSpace(transferPreviewFirmaUrl)) { <img src="@transferPreviewFirmaUrl" alt="Comprobante de transferencia" /> }
                                <InputFile id="firma-transfer-file" OnChange="OnTransferFirmaFileSelected" accept=".jpg,.jpeg,.png,image/png,image/jpeg" disabled="@procesandoPagoFirma" />
                            </label>
                            @if (!string.IsNullOrWhiteSpace(transferMensajeFirma)) { <small class="firma-transfer-message">@transferMensajeFirma</small> }
                        </div>
                        <aside class="firma-bank-card">
                            <strong>Pagar a</strong>
                            <dl>
                                <div><dt>Banco:</dt><dd>Banco Pichincha</dd></div>
                                <div><dt>Tipo de cuenta:</dt><dd>Cuenta corriente</dd></div>
                                <div><dt>Número de cuenta:</dt><dd>2100346647</dd></div>
                                <div><dt>RUC:</dt><dd>1793233799001</dd></div>
                                <div><dt>Nombre:</dt><dd>NUMERICASOFTWARE S.A.S.</dd></div>
                                <div><dt>e-mail:</dt><dd>contabilidad@numericasoftware.com</dd></div>
                            </dl>
                            <p>Realiza la transferencia y adjunta la imagen del comprobante para validar la recarga.</p>
                        </aside>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(mensajePagoFirma))
                {
                    <div class="firma-payment-result @(pagoFirmaExitoso ? "is-success" : "is-error")">@mensajePagoFirma</div>
                }
            </div>

            <footer class="firma-payment-footer">
                <button type="button" class="secondary-btn" @onclick="CerrarModalPagoFirma" disabled="@procesandoPagoFirma">Cancelar</button>
                <button type="button" class="primary-btn" @onclick="ConfirmarPagoFirmaAsync" disabled="@procesandoPagoFirma">
                    @(procesandoPagoFirma ? "Procesando..." : metodoPagoFirma == "transferencia" ? "Enviar transferencia" : "Pagar con DeUna")
                </button>
            </footer>
        </section>
    </div>
}

