    private string GetPasoVisualClass(int step)
    {
        var actual = paso == 1
            ? 1
            : solicitud.SolId > 0 ? 5 : 4;

        if (step < actual)
        {
            return "is-complete";
        }

        return step == actual ? "is-active" : string.Empty;
    }

    private string GetTipoPersonaResumen() =>
        string.Equals(solicitud.SolTipoPersona, TipoPersonaJuridica, StringComparison.OrdinalIgnoreCase)
            ? "Representante legal"
            : solicitud.SolTieneRuc ? "Persona natural con RUC" : "Persona natural con cédula";

    private string NombreTitularResumen
    {
        get
        {
            var nombre = $"{solicitud.SolNombres} {solicitud.SolPrimerApellido}".Trim();
            if (!string.IsNullOrWhiteSpace(nombre))
            {
                return nombre;
            }

            return string.IsNullOrWhiteSpace(solicitud.SolNroRuc)
                ? "Pendiente"
                : $"RUC: {solicitud.SolNroRuc}";
        }
    }

