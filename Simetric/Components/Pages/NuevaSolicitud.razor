    {
        if (procesandoPagoFirma)
            return;

        mostrarModalPagoFirma = false;
    }

    private async Task ConfirmarPagoFirmaAsync()
    {
        if (metodoPagoFirma == "transferencia")
        {
            await RegistrarTransferenciaFirmaAsync();
            return;
        }

        procesandoPagoFirma = true;
        mensajePagoFirma = null;
        try
        {
            var notifyUrl = Navigation.ToAbsoluteUri("/api/pagomedios/notificacion").ToString();
            var urlPago = await PagoService.GenerarSolicitudPago(solicitud, notifyUrl);
            if (string.IsNullOrWhiteSpace(urlPago))
            {
                mensajePagoFirma = "No se pudo conectar con la pasarela de pagos. Puedes reintentar o pagar por transferencia.";
                pagoFirmaExitoso = false;
                return;
            }

            Navigation.NavigateTo(urlPago);
        }
        finally
        {
            procesandoPagoFirma = false;
        }
    }

    private async Task OnTransferFirmaFileSelected(InputFileChangeEventArgs e)
    {
        transferComprobanteFirmaBytes = null;
        transferArchivoFirmaNombre = null;
        transferPreviewFirmaUrl = null;
        transferMensajeFirma = null;

        var archivo = e.File;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size > MaxTransferFirmaBytes)
        {
            transferMensajeFirma = "El comprobante no debe superar 5 MB.";
            return;
        }

        if (!(archivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || extension is ".jpg" or ".jpeg" or ".png"))
        {
            transferMensajeFirma = "El comprobante debe ser una imagen JPG o PNG.";
            return;
        }

        await using var stream = archivo.OpenReadStream(MaxTransferFirmaBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        transferComprobanteFirmaBytes = memory.ToArray();
        transferArchivoFirmaNombre = archivo.Name;
        var mime = extension == ".png" ? "image/png" : "image/jpeg";
        transferPreviewFirmaUrl = $"data:{mime};base64,{Convert.ToBase64String(transferComprobanteFirmaBytes)}";
        transferMensajeFirma = "Comprobante cargado correctamente.";
    }

    private void OnTransferCuentaFirmaChanged(string? value) =>
        transferCuentaFirma = new string((value ?? string.Empty).Where(char.IsDigit).ToArray());

    private void OnTransferComprobanteFirmaChanged(string? value) =>
        transferComprobanteFirma = new string((value ?? string.Empty).Where(char.IsLetterOrDigit).Take(50).ToArray()).ToUpperInvariant();

    private async Task RegistrarTransferenciaFirmaAsync()
    {
        mensajePagoFirma = null;
        pagoFirmaExitoso = false;

        if (!ValidarTransferenciaFirma(out var error))
        {
            mensajePagoFirma = error;
            return;
        }

        procesandoPagoFirma = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var solicitudDb = await context.UsuSolicitudFirma
                .FirstOrDefaultAsync(item => item.SolId == solicitud.SolId && item.SolIdUsuarioCliente == usuarioActualId);
            if (solicitudDb is null)
                throw new InvalidOperationException("No se encontró la solicitud de firma registrada.");

            if (solicitudDb.SolPagoExitoso == true)
                throw new InvalidOperationException("La solicitud ya tiene un pago aprobado.");

            var marcador = $"[SolicitudFirma:{solicitudDb.SolId}]";
            var pendienteExistente = await context.ReporteVentasBackOffice
                .AnyAsync(v => v.Estado == "pendiente" && v.Observacion != null && v.Observacion.Contains(marcador));
            if (pendienteExistente)
                throw new InvalidOperationException("Ya existe una transferencia pendiente para esta solicitud.");

            var venta = new ReporteVentaBackOffice
            {
                Cliente = TruncarFirma($"{solicitudDb.SolNombres} {solicitudDb.SolPrimerApellido} | {solicitudDb.SolCorreo1}", 150),
                Producto = "e-sign",
                PlanPaquete = TruncarFirma($"Firma electrónica {solicitudDb.SolVigencia}", 100),
                Valor = decimal.Round(solicitudDb.SolMontoPago ?? 0m, 2, MidpointRounding.AwayFromZero),
                Fecha = DateTime.Now,
                Canal = "Transferencia Web",
                Vendedor = "Solicitud en línea",
                Estado = "pendiente",
                FormaPago = "Transferencia Bancaria",
                Observacion = TruncarFirma(
                    $"{marcador} Banco: {transferBancoFirma.Trim()}. Cuenta origen: {transferCuentaFirma.Trim()}. N. comprobante: {transferComprobanteFirma.Trim()}. Titular: {transferTitularFirma.Trim()}. Solicitud pendiente de aprobación por compra de firma electrónica.",
                    500),
                ComprobanteArchivo = transferComprobanteFirmaBytes
            };

            context.ReporteVentasBackOffice.Add(venta);
            await context.SaveChangesAsync();
            solicitudDb.SolIdTransaccionPago = TruncarFirma($"TRANSFERENCIA-PENDIENTE-BO-{venta.IdReporte}", 100);
            await context.SaveChangesAsync();

            try
            {
                await EmailService.EnviarAvisoCobroPendienteAsync(
                    solicitudDb.SolCorreo1,
                    $"{solicitudDb.SolNombres} {solicitudDb.SolPrimerApellido}".Trim(),
                    venta.Producto,
                    venta.PlanPaquete,
                    venta.Valor,
                    venta.FormaPago,
                    transferComprobanteFirma);
            }
            catch
            {
                // La solicitud queda registrada aunque el aviso por correo falle.
            }

            pagoFirmaExitoso = true;
            mensajePagoFirma = "Tu transferencia fue registrada. El equipo de Cobros la revisará y, al aprobarla, generará la factura automáticamente.";
        }
        catch (Exception ex)
        {
            mensajePagoFirma = $"No se pudo registrar la transferencia: {ex.Message}";
        }
        finally
        {
            procesandoPagoFirma = false;
        }
    }

    private bool ValidarTransferenciaFirma(out string error)
    {
        if (string.IsNullOrWhiteSpace(transferBancoFirma))
            error = "Selecciona el banco desde donde realizaste la transferencia.";
        else if (string.IsNullOrWhiteSpace(transferCuentaFirma))
            error = "Ingresa el número de cuenta de origen.";
        else if (string.IsNullOrWhiteSpace(transferComprobanteFirma))
            error = "Ingresa el número de comprobante.";
        else if ((transferTitularFirma ?? string.Empty).Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length < 2)
            error = "Ingresa el nombre y apellido del titular de la cuenta.";
        else if (!TieneComprobanteFirma)
            error = "Adjunta el comprobante de la transferencia.";
        else
        {
            error = string.Empty;
            return true;
        }

        return false;
    }

    private static string TruncarFirma(string? value, int maxLength)
    {
        var text = (value ?? string.Empty).Trim();
        return text.Length <= maxLength ? text : text[..maxLength];
    }

    private IEnumerable<DocumentoConfig> ObtenerDocumentosVisibles()
    {
        yield return documentos["CEDULA_FRONTAL"];
        yield return documentos["CEDULA_POSTERIOR"];
        yield return documentos["SELFIE_CEDULA"];

        if (solicitud.SolEsMayor65)
        {
            yield return documentos["VIDEO_ACEPTACION"];
        }

        if (solicitud.SolTieneRuc)
        {
            yield return documentos["RUC_FILE"];
        }

        if (string.Equals(solicitud.SolTipoPersona, "JURIDICA", StringComparison.OrdinalIgnoreCase))
        {
            yield return documentos["NOMBRAMIENTO"];
            yield return documentos["CONSTITUCION"];
            yield return documentos["CEDULA_REPRESENTANTE"];
            yield return documentos["AUTORIZACION"];
            yield return documentos["ACEPTACION_NOMBRAMIENTO"];
        }

        yield return documentos["ARCHIVO_ADICIONAL"];
    }

    private bool TieneArchivo(string tipo) => archivosTemporales.ContainsKey(tipo) || documentosExistentes.ContainsKey(tipo);

    private string ObtenerNombreArchivo(string tipo)
        => archivosTemporales.TryGetValue(tipo, out var archivo)
            ? archivo.NombreOriginal
            : documentosExistentes.TryGetValue(tipo, out var nombre) ? nombre : string.Empty;

    private void CopiarSolicitudEditable(UsuSolicitudFirma origen)
    {
        foreach (var propiedad in typeof(UsuSolicitudFirma).GetProperties()
                     .Where(p => p.CanWrite && (p.PropertyType.IsValueType || p.PropertyType == typeof(string))))
        {
            if (propiedad.Name is nameof(UsuSolicitudFirma.SolIdEstadoNumerica)
                or nameof(UsuSolicitudFirma.SolIdEstadoUanataca)
                or nameof(UsuSolicitudFirma.SolActivo))
                continue;
            propiedad.SetValue(solicitud, propiedad.GetValue(origen));
        }
    }

