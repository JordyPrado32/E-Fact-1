    private static decimal ObtenerMontoVigencia(string vigencia) => vigencia switch
    {
        "7 DIAS" => 10.00m,
        "30 DIAS" => 11.00m,
        "1 ANIO" => 20.00m,
        "2 ANIOS" => 30.00m,
        "3 ANIOS" => 39.00m,
        "4 ANIOS" => 48.00m,
        "5 ANIOS" => 56.00m,
        _ => 0m
    };

    private void AplicarBorrador(SolicitudFirmaDraft draft)
    {
        solicitud.SolFormatoFirma = string.IsNullOrWhiteSpace(draft.SolFormatoFirma) ? "ARCHIVO_P12" : draft.SolFormatoFirma;
        solicitud.SolVigencia = string.IsNullOrWhiteSpace(draft.SolVigencia) ? "7 DIAS" : draft.SolVigencia;
        solicitud.SolMontoPago = VigenciasDisponibles.Contains(solicitud.SolVigencia) ? ObtenerMontoVigencia(solicitud.SolVigencia) : 0m;
        solicitud.SolTipoPersona = string.IsNullOrWhiteSpace(draft.SolTipoPersona) ? TipoPersonaNatural : draft.SolTipoPersona;
        solicitud.SolTipoIdentificacion = draft.SolTipoIdentificacion ?? string.Empty;
        solicitud.SolIdentificacion = draft.SolIdentificacion ?? string.Empty;
        solicitud.SolCodigoDactilar = draft.SolCodigoDactilar;
        solicitud.SolNombres = draft.SolNombres ?? string.Empty;
        solicitud.SolPrimerApellido = draft.SolPrimerApellido ?? string.Empty;
        solicitud.SolSegundoApellido = draft.SolSegundoApellido;
        solicitud.SolFechaNacimiento = draft.SolFechaNacimiento == default ? DateTime.Today : draft.SolFechaNacimiento;
        solicitud.SolNacionalidad = string.IsNullOrWhiteSpace(draft.SolNacionalidad) ? "ECUATORIANA" : draft.SolNacionalidad;
        solicitud.SolSexo = draft.SolSexo ?? string.Empty;
        solicitud.SolTelefono1 = draft.SolTelefono1 ?? string.Empty;
        solicitud.SolTelefono2 = draft.SolTelefono2;
        solicitud.SolCorreo1 = draft.SolCorreo1 ?? string.Empty;
        solicitud.SolCorreo2 = draft.SolCorreo2;
        solicitud.SolTieneRuc = draft.SolTieneRuc;
        solicitud.SolNroRuc = draft.SolNroRuc;
        solicitud.SolProvincia = draft.SolProvincia ?? string.Empty;
        solicitud.SolCanton = draft.SolCanton ?? string.Empty;
        solicitud.SolDireccion = draft.SolDireccion ?? string.Empty;
        solicitud.SolCompanyName = draft.SolCompanyName;
        solicitud.SolDepartment = draft.SolDepartment;
        solicitud.SolPosition = draft.SolPosition;
        solicitud.SolReason = draft.SolReason;
        solicitud.SolIdentificationTypeManager = draft.SolIdentificationTypeManager;
        solicitud.SolIdentificationManager = draft.SolIdentificationManager;
        solicitud.SolNamesManager = draft.SolNamesManager;
        solicitud.SolLastNameManager = draft.SolLastNameManager;
        solicitud.SolId = 0;
        solicitud.SolIdTransaccionPago = null;
        solicitud.SolPagoExitoso = false;

        VerificarEdad();
        SincronizarTipoPersonaConRuc();
        ActualizarCantonesDisponibles();
        editContext = new EditContext(solicitud);
        paso = 1;
    }

    private void LimpiarDocumentosTemporales()
    {
        foreach (var archivo in archivosTemporales.Values)
        {
            SolicitudService.EliminarArchivoTemporal(archivo.TempFileName);
        }

        archivosTemporales.Clear();
        erroresDocumentos.Clear();
    }

