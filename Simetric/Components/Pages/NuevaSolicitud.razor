        string.Equals(solicitud.SolTipoPersona, tipoPersona.Valor, StringComparison.OrdinalIgnoreCase) &&
        solicitud.SolTieneRuc == tipoPersona.TieneRuc;

    private void SeleccionarTipoPersona(TipoPersonaConfig tipoPersona)
    {
        solicitud.SolTipoPersona = tipoPersona.Valor;
        solicitud.SolTieneRuc = tipoPersona.TieneRuc;

        if (tipoPersona.Valor == TipoPersonaJuridica && (solicitud.SolVigencia is "7 DIAS" or "30 DIAS"))
        {
            solicitud.SolVigencia = "1 ANIO";
            solicitud.SolMontoPago = ObtenerMontoVigencia(solicitud.SolVigencia);
            editContext.NotifyFieldChanged(FieldIdentifier.Create(() => solicitud.SolVigencia));
        }

        if (tipoPersona.Valor == TipoPersonaJuridica)
        {
            solicitud.SolTieneRuc = true;
        }
        else
        {
            if (!tipoPersona.TieneRuc)
            {
                solicitud.SolNroRuc = null;
            }
        }

        editContext.NotifyFieldChanged(FieldIdentifier.Create(() => solicitud.SolTipoPersona));
        editContext.NotifyFieldChanged(FieldIdentifier.Create(() => solicitud.SolNroRuc));
    }

