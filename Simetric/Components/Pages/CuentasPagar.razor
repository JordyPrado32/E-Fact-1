@page "/cuentas-por-pagar"
@page "/e-contax/cuentas-por-pagar"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@using Simetric.Services.EContax
@using Simetric.ViewModels
@attribute [AllowAnonymous]
@inject CuentasPagarService CuentasPagarService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject SweetAlertService AlertService

<link rel="stylesheet" href="/css/cuentas-por-pagar.css?v=20261023-cxp-flow" />
<PageTitle>Cuentas por pagar | Numerica e-fact</PageTitle>

<div class="payable-shell">
    <section class="payable-hero">
        <div class="payable-hero-copy">
            <span class="payable-kicker">Cuentas por pagar</span>
            <h1>Cartera de proveedores</h1>
            <p>Consulta facturas de compra, vencimientos y saldos pendientes desde una vista clara y ordenada.</p>
            <div class="payable-hero-actions">
                <a class="payable-primary-btn" href="@RutaCuentasPorPagar("/cuentas-por-pagar/registrar", EContaxRoutes.CuentasPorPagarRegistrar)"><i class="ri-hand-coin-line"></i>Registrar pago</a>
                <a class="payable-secondary-btn" href="@RutaCuentasPorPagar("/mis-compras", EContaxRoutes.CuentasPorPagarMisCompras)"><i class="ri-shopping-bag-3-line"></i>Mis compras</a>
                <a class="payable-secondary-btn" href="@RutaCuentasPorPagar("/cuentas-por-pagar/estado-cuenta", EContaxRoutes.CuentasPorPagarEstadoCuenta)"><i class="ri-file-list-3-line"></i>Estado de cuenta</a>
            </div>
        </div>
        <div class="payable-hero-mark" aria-hidden="true"><i class="ri-bank-card-2-line"></i></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger border-0 rounded-3">@error</div>
    }

    @if (cargando)
    {
        <section class="payable-state">Cargando cuentas por pagar...</section>
    }
    else
    {
        <section class="payable-metrics" aria-label="Resumen de cuentas por pagar">
            <article class="payable-metric is-primary"><span>Saldo pendiente</span><strong>$@CuentasFiltradas.Sum(x => x.SaldoPendiente).ToString("N2")</strong><small>Cartera visible</small><i class="ri-wallet-3-line"></i></article>
            <article class="payable-metric is-info"><span>Documentos pendientes</span><strong>@CuentasFiltradas.Count(x => x.SaldoPendiente > 0)</strong><small>Con saldo por pagar</small><i class="ri-file-list-3-line"></i></article>
            <article class="payable-metric is-danger"><span>Facturas vencidas</span><strong>@CuentasFiltradas.Count(x => x.EstaVencida)</strong><small>Requieren atención</small><i class="ri-alarm-warning-line"></i></article>
            <article class="payable-metric is-success"><span>Documentos pagados</span><strong>@CuentasFiltradas.Count(x => x.Estado == "PAGADO")</strong><small>Historial visible</small><i class="ri-checkbox-circle-line"></i></article>
        </section>

        <section class="payable-flow" aria-label="Flujo de cuentas por pagar">
            <div class="payable-flow-step is-active"><span>1</span><div><strong>Revisar cartera</strong><small>Consulta saldos y vencimientos</small></div></div><i class="ri-arrow-right-line"></i>
            <div class="payable-flow-step"><span>2</span><div><strong>Filtrar proveedor</strong><small>Busca el documento requerido</small></div></div><i class="ri-arrow-right-line"></i>
            <div class="payable-flow-step"><span>3</span><div><strong>Ver estado</strong><small>Revisa el detalle de la cuenta</small></div></div><i class="ri-arrow-right-line"></i>
            <div class="payable-flow-step"><span>4</span><div><strong>Registrar abono</strong><small>Aplica el pago pendiente</small></div></div>
        </section>

        <section class="payable-board">
            <div class="payable-board-head">
                <div><span class="payable-section-kicker">Cartera de proveedores</span><h2>Facturas y liquidaciones</h2></div>
                <button type="button" class="payable-refresh-btn" @onclick="CargarAsync" disabled="@cargando"><i class="ri-refresh-line"></i>Actualizar</button>
            </div>
            <div class="payable-filters">
                <label class="payable-search"><i class="ri-search-line"></i><input @bind="busqueda" @bind:event="oninput" placeholder="Buscar por proveedor, RUC o documento..." /></label>
                <label class="payable-select"><span>Estado</span><select @bind="filtroEstado"><option value="TODOS">Todos</option><option value="PENDIENTE">Pendientes</option><option value="VENCIDO">Vencidas</option><option value="PAGADO">Pagadas</option></select></label>
            </div>
            @if (!CuentasFiltradas.Any())
            {
                <div class="payable-empty"><i class="ri-inbox-line"></i><strong>No hay cuentas por pagar</strong><span>No existen documentos con los filtros seleccionados.</span></div>
            }
            else
            {
                <div class="payable-table-wrap">
                    <table class="payable-table">
                        <thead><tr><th>Documento</th><th>Proveedor</th><th>Emisión</th><th>Vencimiento</th><th class="text-end">Total</th><th class="text-end">Saldo</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var cuenta in CuentasFiltradas)
                            {
                                <tr @key="cuenta.IdFactura" class="@(cuentaSeleccionada?.IdFactura == cuenta.IdFactura ? "is-selected" : "")" @onclick="() => SeleccionarCuenta(cuenta)">
                                    <td><strong>@cuenta.NumeroDocumento</strong><small>#@cuenta.IdFactura</small></td>
                                    <td><strong>@cuenta.Proveedor</strong><small>@cuenta.IdentificacionProveedor</small></td>
                                    <td>@cuenta.FechaEmision?.ToString("dd/MM/yyyy")</td>
                                    <td>@cuenta.FechaVencimiento?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">$@cuenta.Total.ToString("N2")</td>
                                    <td class="text-end payable-balance">$@cuenta.SaldoPendiente.ToString("N2")</td>
                                    <td><span class="payable-status @(cuenta.Estado == "VENCIDO" ? "is-danger" : cuenta.Estado == "PAGADO" ? "is-success" : "is-warning")">@cuenta.Estado</span></td>
                                    <td class="text-end"><button type="button" class="payable-row-btn" title="Ver detalle" @onclick:stopPropagation="true" @onclick="() => SeleccionarCuenta(cuenta)"><i class="ri-eye-line"></i></button>@if (cuenta.SaldoPendiente > 0) { <button type="button" class="payable-row-btn is-primary" title="Marcar pagada" @onclick:stopPropagation="true" @onclick="() => MarcarPagadaAsync(cuenta)"><i class="ri-check-line"></i></button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (cuentaSeleccionada is not null)
        {
            <section class="payable-detail-card">
                <div class="payable-detail-head"><div><span class="payable-section-kicker">Documento seleccionado</span><h2>@cuentaSeleccionada.Proveedor</h2><small>@cuentaSeleccionada.IdentificacionProveedor · @cuentaSeleccionada.NumeroDocumento</small></div><button type="button" class="payable-close-btn" @onclick="() => cuentaSeleccionada = null"><i class="ri-close-line"></i></button></div>
                <div class="payable-detail-metrics"><div><span>Total</span><strong>$@cuentaSeleccionada.Total.ToString("N2")</strong></div><div><span>Pagado</span><strong>$@cuentaSeleccionada.TotalPagado.ToString("N2")</strong></div><div><span>Saldo pendiente</span><strong class="@(cuentaSeleccionada.SaldoPendiente > 0 ? "is-danger" : "is-success")">$@cuentaSeleccionada.SaldoPendiente.ToString("N2")</strong></div><div><span>Vencimiento</span><strong>@cuentaSeleccionada.FechaVencimiento?.ToString("dd/MM/yyyy")</strong></div></div>
                @if (cuentaSeleccionada.SaldoPendiente > 0)
                {
                    <div class="payable-detail-actions"><a class="payable-primary-btn" href="@RutaCuentasPorPagar("/cuentas-por-pagar/registrar", EContaxRoutes.CuentasPorPagarRegistrar)"><i class="ri-hand-coin-line"></i>Registrar abono</a><button type="button" class="payable-secondary-btn" @onclick="() => MarcarPagadaAsync(cuentaSeleccionada)"><i class="ri-check-double-line"></i>Pagar total</button></div>
                }
            </section>
        }
    }
</div>

@code {
    private List<CuentaPorPagarVM> cuentas = new();
    private CuentaPorPagarVM? cuentaSeleccionada;
    private int currentUserId;
    private bool cargando = true;
    private string busqueda = "";
    private string filtroEstado = "TODOS";
    private string error = "";

    private bool EsEContaxContext => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("e-contax/", StringComparison.OrdinalIgnoreCase);

    private string RutaCuentasPorPagar(string efact, string econtax) => EsEContaxContext ? econtax : efact;
    private void SeleccionarCuenta(CuentaPorPagarVM cuenta) => cuentaSeleccionada = cuenta;

    private IEnumerable<CuentaPorPagarVM> CuentasFiltradas => cuentas.Where(x =>
        (string.IsNullOrWhiteSpace(busqueda) || x.Proveedor.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || x.IdentificacionProveedor.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || x.NumeroDocumento.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) &&
        (filtroEstado == "TODOS" || x.Estado == filtroEstado));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id) ? id : 0;
        if (currentUserId <= 0)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (currentUserId <= 0) return;
        cargando = true;
        error = "";
        try
        {
            cuentas = await CuentasPagarService.ListarAsync(currentUserId, incluirPagadas: true);
            cuentaSeleccionada = null;
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar las cuentas por pagar: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task MarcarPagadaAsync(CuentaPorPagarVM cuenta)
    {
        if (!await AlertService.ConfirmAsync($"¿Marcar como pagado el documento {cuenta.NumeroDocumento}?", "Confirmar pago", "Sí, marcar pagada")) return;
        try
        {
            if (await CuentasPagarService.MarcarPagadaAsync(currentUserId, cuenta.IdFactura))
            {
                await AlertService.ShowSuccessAsync("Cuenta por pagar actualizada.");
                await CargarAsync();
            }
        }
        catch (InvalidOperationException ex) { await AlertService.ShowErrorAsync(ex.Message); }
        catch (Exception ex) { error = $"No se pudo actualizar la cuenta: {ex.Message}"; }
    }
}
