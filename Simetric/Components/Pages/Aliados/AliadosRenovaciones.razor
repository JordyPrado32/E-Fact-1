@page "/aliados/renovaciones"

<PageTitle>Renovaciones | Portal de Aliados</PageTitle>

<div class="ally-page">
    <div class="ally-page-intro"><div><span class="ally-eyebrow">VENTANA DE GESTIÓN</span><h2>Renovaciones</h2><p>Servicios próximos a vencer, ordenados por urgencia. Puedes registrar el resultado de cada contacto.</p></div><select class="ally-select" @bind="filtro" @bind:after="CargarAsync"><option value="">Todos los estados</option><option>Pendiente</option><option>Contactado</option><option>No responde</option><option>Interesado</option><option>Pendiente de pago</option><option>No renueva</option><option>Renovado</option></select></div>
    <section class="ally-panel">
        @if (cargando) { <div class="ally-empty">Cargando renovaciones...</div> }
        else if (renovaciones.Count == 0) { <div class="ally-empty">No existen renovaciones para los filtros seleccionados.</div> }
        else { <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Cliente / producto</th><th>Vencimiento</th><th>Valor oficial</th><th>Comisión potencial</th><th>Gestión</th><th></th></tr></thead><tbody>@foreach (var item in renovaciones) { <tr @key="item.IdFactura"><td><strong>@item.Cliente</strong><br /><small>@item.Producto</small></td><td><span class="ally-badge @(item.DiasRestantes <= 15 ? "danger" : "warning")">@item.FechaVencimiento.ToString("dd/MM/yyyy") · @item.DiasRestantes días</span></td><td>$ @item.Valor.ToString("N2")</td><td>$ @item.ComisionPotencial.ToString("N2")</td><td>@item.EstadoGestion<br /><small>@(item.UltimaGestion?.ToString("dd/MM/yyyy") ?? "Sin gestión")</small></td><td><button type="button" class="ally-table-action" @onclick="() => AbrirGestion(item)">Registrar gestión</button></td></tr>}</tbody></table></div> }
    </section>
</div>

@if (gestion is not null)
{
        <div class="ally-modal-backdrop"><div class="ally-modal" role="dialog" aria-modal="true" aria-labelledby="ally-gestion-title"><div class="ally-modal-heading"><h3 id="ally-gestion-title">Registrar gestión</h3><button type="button" aria-label="Cerrar ventana" @onclick="CerrarGestion">×</button></div><p><strong>@gestion.Cliente</strong><br />@gestion.Producto · vence @gestion.FechaVencimiento.ToString("dd/MM/yyyy")</p><label>Resultado<select class="ally-select" @bind="resultado"><option>Pendiente</option><option>Contactado</option><option>No responde</option><option>Interesado</option><option>Pendiente de pago</option><option>No renueva</option><option>Renovado</option></select></label><label>Observación<textarea @bind="observacion"></textarea></label><label>Próximo seguimiento<input type="date" @bind="proximoSeguimiento" /></label>@if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="ally-feedback">@mensaje</div> }<div class="ally-modal-actions"><button type="button" class="ally-button muted" @onclick="CerrarGestion">Cancelar</button><button type="button" class="ally-button" @onclick="GuardarGestion" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar gestión")</button></div></div></div>
}

@code {
    private List<AliadoRenovacionDto> renovaciones = new();
    private AliadoRenovacionDto? gestion;
    private string filtro = string.Empty;
    private string resultado = "Pendiente";
    private string observacion = string.Empty;
    private DateTime? proximoSeguimiento;
    private string? mensaje;
    private bool cargando = true;
    private bool guardando;
    private int userId;

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out userId);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        renovaciones = (await AliadoService.ObtenerRenovacionesAsync(userId, filtro)).ToList();
        cargando = false;
    }

    private void AbrirGestion(AliadoRenovacionDto item) { gestion = item; resultado = item.EstadoGestion; observacion = item.Observacion ?? string.Empty; mensaje = null; proximoSeguimiento = null; }
    private void CerrarGestion() => gestion = null;

    private async Task GuardarGestion()
    {
        if (gestion is null || guardando) return;
        guardando = true;
        try
        {
            var response = await AliadoService.RegistrarGestionAsync(userId, gestion.IdFactura, resultado, observacion, proximoSeguimiento);
            if (response.Success)
            {
                await AlertService.ShowSuccessAsync("La gestión quedó registrada correctamente.", "Gestión guardada");
                gestion = null;
                await CargarAsync();
            }
            else
            {
                mensaje = response.Message;
                await AlertService.ShowErrorAsync(response.Message, "No se pudo guardar");
            }
        }
        catch
        {
            mensaje = "No fue posible guardar la gestión. Inténtalo nuevamente.";
            await AlertService.ShowErrorAsync(mensaje, "No se pudo guardar");
        }
        finally
        {
            guardando = false;
        }
    }
}
