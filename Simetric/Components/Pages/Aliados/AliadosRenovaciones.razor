@page "/aliados/renovaciones"
@using MiniExcelLibs

<PageTitle>Renovaciones | Portal de Aliados</PageTitle>

<div class="ally-page">
    <section class="renewals-hero">
        <div><span class="ally-eyebrow">RENOVACIONES</span><h2>Mantén a tus clientes <strong>siempre activos</strong></h2><p>Gestiona a tiempo el saldo de documentos y la vigencia de E-RÚBRICA.</p></div>
        <span class="renewals-hero-icon"><i class="ri-calendar-check-fill"></i></span>
        <div class="renewals-hero-message"><i class="ri-lightbulb-flash-line"></i><span>Una gestión oportuna mantiene a tus clientes creciendo contigo.</span></div>
    </section>

    <section class="renewals-kpis" aria-label="Resumen de renovaciones">
        <article class="renewals-kpi total"><span><i class="ri-team-fill"></i></span><div><small>Total de clientes</small><strong>@TotalClientes</strong><em>Clientes para gestionar</em></div></article>
        <article class="renewals-kpi urgent"><span><i class="ri-alarm-warning-fill"></i></span><div><small>Atención urgente</small><strong>@AtencionUrgente</strong><em>Requiere acción inmediata</em></div></article>
        <article class="renewals-kpi warning"><span><i class="ri-time-fill"></i></span><div><small>Seguimiento preventivo</small><strong>@SeguimientoPreventivo</strong><em>Conviene contactar pronto</em></div></article>
        <article class="renewals-kpi current"><span><i class="ri-checkbox-circle-fill"></i></span><div><small>Sin alertas críticas</small><strong>@SinAlertasCriticas</strong><em>Clientes estables</em></div></article>
    </section>

    <section class="ally-panel renewals-list-card">
        <div class="renewals-list-heading">
            <div><span class="ally-eyebrow">CARTERA DE RENOVACIONES</span><h3>Clientes que requieren seguimiento</h3><p>Consulta cada dato en su columna y registra las acciones realizadas.</p></div>
            <div class="renewals-heading-actions"><button type="button" class="ally-export-card" @onclick="ExportarReporteAsync" disabled="@(!RenovacionesVisibles.Any())"><span class="ally-export-card-icon"><i class="ri-download-2-line"></i></span><span><strong>Exportar renovaciones</strong><small>Archivo Excel</small></span></button><button type="button" class="ally-button renewals-refresh" @onclick="CargarAsync" disabled="@cargando"><i class="ri-refresh-line"></i> Actualizar</button></div>
        </div>
        <div class="renewals-filters">
            <label class="ally-search" style="min-width:240px;"><i class="ri-search-line"></i><input @bind="busqueda" @bind:event="oninput" placeholder="Buscar cliente, identificación o correo" /></label>
            <select class="ally-select" @bind="filtroServicio">
                <option value="">Todos los servicios</option>
                <option value="E-FACT">E-FACT</option>
                <option value="E-RÚBRICA">E-RÚBRICA</option>
            </select>
            <select class="ally-select" @bind="filtroAlerta">
                <option value="">Todas las alertas</option>
                <option value="danger">Rojas</option>
                <option value="warning">Amarillas</option>
            </select>
            <select class="ally-select" @bind="filtro">
                <option value="">Todos los estados</option>
                <option>Pendiente</option>
                <option>Contactado</option>
                <option>No responde</option>
                <option>Interesado</option>
                <option>Pendiente de pago</option>
                <option>No renueva</option>
                <option>Renovado</option>
            </select>
            <button type="button" class="ally-table-action" @onclick="LimpiarFiltros"><i class="ri-eraser-line"></i> Limpiar</button>
        </div>

        @if (cargando)
        {
            <AllyLoadingState Title="Cargando alertas" Description="Preparando la información de tus clientes." />
        }
        else if (!RenovacionesVisibles.Any())
        {
            <div class="ally-empty">No existen clientes con alertas para los filtros seleccionados.</div>
        }
        else
        {
            <div class="ally-table-wrap">
                <table class="ally-table">
                    <thead>
                        <tr>
                            @if (esAdministrador) { <th>Aliado</th> }
                            <th>Cliente</th>
                            <th>Identificación</th>
                            <th>Contacto</th>
                            <th>Servicio</th>
                            <th>Disponibilidad / vigencia</th>
                            <th>Alerta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in RenovacionesVisibles)
                        {
                            <tr @key="(item.IdCliente, item.Servicio, item.IdFactura)">
                                @if (esAdministrador) { <td>@(string.IsNullOrWhiteSpace(item.Aliado) ? "-" : item.Aliado)</td> }
                                <td><div class="renewals-client"><span>@Iniciales(item.Cliente)</span><strong>@item.Cliente</strong></div></td>
                                <td><span class="renewals-identification">@(item.Identificacion ?? "Sin identificación")</span></td>
                                <td><div class="renewals-contact"><span><i class="ri-phone-line"></i>@(item.Telefono ?? "Sin teléfono")</span><small><i class="ri-mail-line"></i>@(CorreoVisible(item.Email))</small></div></td>
                                <td><span class="ally-badge @ServicioCss(item.Servicio)">@item.Servicio</span></td>
                                <td>
                                    @if (item.Servicio == "E-FACT")
                                    {
                                        <div class="renewals-availability"><strong class="@(item.SaldoDocumentos < 5 ? "renewal-danger-text" : item.SaldoDocumentos == 5 ? "renewal-warning-text" : "renewal-success-text")">@item.SaldoDocumentos documentos</strong><small>Saldo disponible</small></div>
                                    }
                                    else if (item.DiasFirmaElectronica.HasValue)
                                    {
                                        <div class="renewals-availability"><strong class="@(item.DiasFirmaElectronica <= 7 ? "renewal-danger-text" : "renewal-warning-text")">@DiasTexto(item.DiasFirmaElectronica.Value)</strong><small>Vence: @item.FechaVencimientoFirmaElectronica?.ToString("dd/MM/yyyy")</small></div>
                                    }
                                    else { <span>-</span> }
                                </td>
                                <td><span class="ally-badge renewals-alert @NivelAlertaVisible(item)">@AlertaTexto(item)</span></td>
                                <td>
                                    <div class="ally-contact-actions renewal-actions">
                                        @if (!string.IsNullOrWhiteSpace(item.Telefono))
                                        {
                                            <a class="renewals-action call" href="tel:@TelefonoLink(item.Telefono)" title="Llamar cliente" aria-label="Llamar cliente"><i class="ri-phone-line"></i></a>
                                            <a class="renewals-action whatsapp" href="@WhatsAppUrl(item)" title="Abrir WhatsApp" aria-label="Abrir WhatsApp"><i class="ri-whatsapp-line"></i></a>
                                        }
                                        @if (EsCorreoDisponible(item.Email))
                                        {
                                            <button type="button" class="renewals-action email" title="Enviar correo" aria-label="Enviar correo" @onclick="() => EnviarCorreoAsync(item)" disabled="@correoEnviandoIds.Contains(item.IdCliente)"><i class="@(correoEnviandoIds.Contains(item.IdCliente) ? "ri-loader-4-line" : "ri-mail-send-line")"></i></button>
                                        }
                                        @if (item.IdFactura > 0 && !esAdministrador)
                                        {
                                            <button type="button" class="renewals-action manage" title="Registrar gestión" aria-label="Registrar gestión" @onclick="() => AbrirGestion(item)"><i class="ri-edit-line"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (gestion is not null)
{
    <div class="ally-modal-backdrop">
        <div class="ally-modal" role="dialog" aria-modal="true" aria-labelledby="ally-gestion-title">
            <div class="ally-modal-heading"><h3 id="ally-gestion-title">Registrar gestión</h3><button type="button" aria-label="Cerrar ventana" @onclick="CerrarGestion">×</button></div>
            <p><strong>@gestion.Cliente</strong><br />@gestion.Producto · @gestion.Alerta</p>
            <label>Resultado<select class="ally-select" @bind="resultado"><option>Pendiente</option><option>Contactado</option><option>No responde</option><option>Interesado</option><option>Pendiente de pago</option><option>No renueva</option><option>Renovado</option></select></label>
            <label>Observación<textarea @bind="observacion"></textarea></label>
            <label>Próximo seguimiento<input type="date" @bind="proximoSeguimiento" /></label>
            @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="ally-feedback">@mensaje</div> }
            <div class="ally-modal-actions"><button type="button" class="ally-button muted" @onclick="CerrarGestion">Cancelar</button><button type="button" class="ally-button" @onclick="GuardarGestion" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar gestión")</button></div>
        </div>
    </div>
}

<style>
    .renewal-actions { margin:0; gap:.35rem; flex-wrap:wrap; }
    .renewal-actions .ally-button, .renewal-actions .ally-table-action { padding:.45rem .6rem; font-size:.78rem; }
    .renewal-danger-text { color:#b91c1c; }
    .renewal-warning-text { color:#a16207; }
    .renewal-success-text { color:#087a45; }
    .whatsapp-action { color:#087a51 !important; background:#e9f9f2 !important; }
    .ally-badge.service-efact { background:#e6f0ff; color:#1d4ed8; }
    .ally-badge.service-erubrica { background:#e3f7eb; color:#087a45; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "factura")]
    private int? FacturaId { get; set; }

    private List<AliadoRenovacionDto> renovaciones = new();
    private AliadoRenovacionDto? gestion;
    private readonly HashSet<int> correoEnviandoIds = new();
    private string filtro = string.Empty;
    private string filtroServicio = string.Empty;
    private string filtroAlerta = string.Empty;
    private string busqueda = string.Empty;
    private string resultado = "Pendiente";
    private string observacion = string.Empty;
    private DateTime? proximoSeguimiento;
    private string? mensaje;
    private bool cargando = true;
    private bool guardando;
    private bool esAdministrador;
    private int userId;

    private int TotalClientes => RenovacionesVisibles.Select(x => x.IdCliente).Distinct().Count();
    private int AtencionUrgente => RenovacionesVisibles.Count(x => x.NivelAlerta == "danger");
    private int SeguimientoPreventivo => RenovacionesVisibles.Count(x => x.NivelAlerta == "warning");
    private int SinAlertasCriticas => Math.Max(0, TotalClientes - AtencionUrgente - SeguimientoPreventivo);

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private IEmailService EmailService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;

    private IEnumerable<AliadoRenovacionDto> RenovacionesVisibles => renovaciones.Where(x =>
        (string.IsNullOrWhiteSpace(busqueda) || $"{x.Cliente} {x.Identificacion} {x.Email} {x.Telefono}".Contains(busqueda, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroServicio) || string.Equals(x.Servicio, filtroServicio, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroAlerta) || x.NivelAlerta == filtroAlerta) &&
        (string.IsNullOrWhiteSpace(filtro) || string.Equals(x.EstadoGestion, filtro, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out userId);
        esAdministrador = (await AliadoService.ObtenerContextoAsync(userId))?.EsAdministrador == true;
        await CargarAsync();
        if (FacturaId.HasValue && !esAdministrador)
        {
            var item = renovaciones.FirstOrDefault(x => x.IdFactura == FacturaId.Value);
            if (item is not null)
                AbrirGestion(item);
        }
    }

    private async Task CargarAsync()
    {
        cargando = true;
        renovaciones = (await AliadoService.ObtenerRenovacionesAsync(userId, filtro)).ToList();
        cargando = false;
    }

    private void LimpiarFiltros()
    {
        busqueda = string.Empty;
        filtroServicio = string.Empty;
        filtroAlerta = string.Empty;
        filtro = string.Empty;
    }

    private async Task ExportarReporteAsync()
    {
        var data = RenovacionesVisibles.Select(x => new
        {
            Aliado = x.Aliado ?? string.Empty,
            Cliente = x.Cliente,
            Identificacion = x.Identificacion ?? string.Empty,
            Correo = x.Email ?? string.Empty,
            Telefono = x.Telefono ?? string.Empty,
            Servicio = x.Servicio,
            DocumentosDisponibles = x.Servicio == "E-FACT" ? (int?)x.SaldoDocumentos : null,
            DiasERubrica = x.DiasFirmaElectronica,
            VencimientoERubrica = x.FechaVencimientoFirmaElectronica,
            Alerta = x.Alerta,
            Gestion = x.EstadoGestion
        }).ToList();

        using var stream = new MemoryStream();
        stream.SaveAs(data);
        stream.Position = 0;
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", $"Reporte_Renovaciones_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", reference, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        await AlertService.ShowSuccessAsync("El reporte se descargó correctamente.", "Reporte listo");
    }

    private async Task EnviarCorreoAsync(AliadoRenovacionDto item)
    {
        if (string.IsNullOrWhiteSpace(item.Email) || !correoEnviandoIds.Add(item.IdCliente))
            return;
        try
        {
            await EmailService.EnviarAvisoRenovacionClienteAsync(item.Email, item.Cliente, item.Servicio, item.Servicio == "E-FACT" ? item.SaldoDocumentos : null, item.FechaVencimientoFirmaElectronica, item.DiasFirmaElectronica);
            await AlertService.ShowSuccessAsync($"Aviso enviado a {item.Email}.", "Correo enviado");
        }
        catch
        {
            await AlertService.ShowErrorAsync("No fue posible enviar el correo al cliente.", "Error de envío");
        }
        finally
        {
            correoEnviandoIds.Remove(item.IdCliente);
        }
    }

    private void AbrirGestion(AliadoRenovacionDto item) { gestion = item; resultado = item.EstadoGestion; observacion = item.Observacion ?? string.Empty; mensaje = null; proximoSeguimiento = item.ProximoSeguimiento?.Date; }
    private void CerrarGestion() => gestion = null;

    private async Task GuardarGestion()
    {
        if (gestion is null || guardando) return;
        guardando = true;
        try
        {
            var response = await AliadoService.RegistrarGestionAsync(userId, gestion.IdFactura, resultado, observacion, proximoSeguimiento);
            if (response.Success)
            {
                await AlertService.ShowSuccessAsync("La gestión quedó registrada correctamente.", "Gestión guardada");
                gestion = null;
                await CargarAsync();
            }
            else
            {
                mensaje = response.Message;
                await AlertService.ShowErrorAsync(response.Message, "No se pudo guardar");
            }
        }
        catch
        {
            mensaje = "No fue posible guardar la gestión. Inténtalo nuevamente.";
            await AlertService.ShowErrorAsync(mensaje, "No se pudo guardar");
        }
        finally
        {
            guardando = false;
        }
    }

    private static string DiasTexto(int dias) => dias switch
    {
        < 0 => $"Venció hace {Math.Abs(dias)} días",
        0 => "Vence hoy",
        1 => "1 día restante",
        _ => $"{dias} días restantes"
    };

    private static string ServicioCss(string servicio) => servicio == "E-RÚBRICA" ? "service-erubrica" : "service-efact";

    private static string Iniciales(string nombre) => string.Concat(nombre
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => char.ToUpperInvariant(x[0])));

    private static bool EsCorreoDisponible(string? correo) => !string.IsNullOrWhiteSpace(correo) &&
        !correo.EndsWith("@deleted.local", StringComparison.OrdinalIgnoreCase);

    private static string CorreoVisible(string? correo) => EsCorreoDisponible(correo) ? correo! : "Sin correo";

    private static string NivelAlertaVisible(AliadoRenovacionDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Alerta))
            return item.NivelAlerta;
        if (item.Servicio == "E-FACT")
            return item.SaldoDocumentos < 5 ? "danger" : item.SaldoDocumentos == 5 ? "warning" : "success";
        return item.DiasFirmaElectronica switch { <= 7 => "danger", <= 30 => "warning", _ => "success" };
    }

    private static string AlertaTexto(AliadoRenovacionDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Alerta))
            return item.Alerta;
        if (item.Servicio == "E-FACT")
            return item.SaldoDocumentos < 5 ? "Atención urgente" : item.SaldoDocumentos == 5 ? "5 documentos" : "Disponible";
        return item.DiasFirmaElectronica switch { <= 7 => "Próxima a vencer", <= 30 => "Seguimiento", _ => "Vigente" };
    }

    private static string TelefonoLink(string? telefono) => new string((telefono ?? string.Empty).Where(char.IsDigit).ToArray());

    private static string WhatsAppUrl(AliadoRenovacionDto item)
    {
        var telefono = TelefonoLink(item.Telefono);
        if (telefono.StartsWith('0'))
            telefono = $"593{telefono[1..]}";
        else if (telefono.Length == 9 && telefono.StartsWith('9'))
            telefono = $"593{telefono}";
        var texto = Uri.EscapeDataString(MensajeWhatsApp(item));
        return $"whatsapp://send?phone={telefono}&text={texto}";
    }

    private static string MensajeWhatsApp(AliadoRenovacionDto item)
    {
        if (item.Servicio == "E-FACT")
        {
            var documentos = Math.Max(item.SaldoDocumentos, 0);
            var detalle = documentos switch
            {
                0 => "ya no tienes documentos disponibles y, si se acaban, no podrás facturar",
                1 => "te queda 1 documento disponible y, cuando se acabe, no podrás facturar",
                _ => $"te quedan {documentos} documentos disponibles y, cuando se acaben, no podrás facturar"
            };
            return $"Hola {item.Cliente}, te escribo para avisarte que {detalle}. ¿Quieres que te ayudemos a recargar tus documentos? Respóndeme este mensaje y te ayudamos.";
        }

        var firma = item.DiasFirmaElectronica switch
        {
            null => "tu firma electrónica va a caducar pronto",
            <= 0 => "tu firma electrónica ya caducó",
            1 => "tu firma electrónica caducará mañana",
            _ => $"tu firma electrónica caducará en {item.DiasFirmaElectronica} días"
        };
        return $"Hola {item.Cliente}, te escribo para avisarte que {firma}. ¿Quieres que te ayudemos a renovarla en E-RÚBRICA? Respóndeme este mensaje y te ayudamos.";
    }
}
