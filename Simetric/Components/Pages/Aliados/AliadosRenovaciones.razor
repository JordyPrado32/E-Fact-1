@page "/aliados/renovaciones"

<PageTitle>Renovaciones | Portal de Aliados</PageTitle>

<div class="ally-page">
    <div class="ally-page-intro"><div><span class="ally-eyebrow">VENTANA DE GESTIÓN</span><h2>Renovaciones</h2><p>Servicios próximos a vencer, ordenados por urgencia. Puedes registrar el resultado de cada contacto.</p></div><div class="ally-page-tools"><select class="ally-select" @bind="filtro" @bind:after="CargarAsync"><option value="">Todos los estados</option><option>Pendiente</option><option>Contactado</option><option>No responde</option><option>Interesado</option><option>Pendiente de pago</option><option>No renueva</option><option>Renovado</option></select><select class="ally-select" @bind="prioridad"><option value="">Todas las prioridades</option><option value="vencida">Seguimiento vencido</option><option value="hoy">Seguimiento de hoy</option><option value="proxima">Seguimiento próximo</option><option value="sin-seguimiento">Sin seguimiento</option></select></div></div>
    <div class="ally-filter-summary"><span><strong>@RenovacionesVisibles.Count()</strong> renovaciones visibles</span><span class="ally-badge danger">@renovaciones.Count(EsUrgente) urgentes</span><span class="ally-badge warning">@renovaciones.Count(x => x.ProximoSeguimiento?.Date == DateTime.Today) seguimientos hoy</span></div>
    <section class="ally-panel">
        @if (cargando) { <AllyLoadingState Title="Cargando renovaciones" Description="Preparando los vencimientos de tus clientes." /> }
        else if (!RenovacionesVisibles.Any()) { <div class="ally-empty">No existen renovaciones para los filtros seleccionados.</div> }
        else { <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Cliente / producto</th><th>Vencimiento / saldo</th><th>Valor oficial</th><th>Comisión potencial</th><th>Seguimiento</th><th>Gestión</th></tr></thead><tbody>@foreach (var item in RenovacionesVisibles) { <tr @key="item.IdFactura"><td><strong>@item.Cliente</strong><br /><small>@item.Producto</small></td><td>@if (item.EsPorSaldo) { <span class="ally-badge @SaldoCss(item.SaldoDocumentos)">@item.SaldoDocumentos documentos disponibles</span> } else { <span class="ally-badge @(item.DiasRestantes <= 15 ? "danger" : "warning")">@item.FechaVencimiento.ToString("dd/MM/yyyy") · @item.DiasRestantes días</span> }</td><td>$ @item.Valor.ToString("N2")</td><td>$ @item.ComisionPotencial.ToString("N2")</td><td><span class="ally-badge @SeguimientoCss(item)">@SeguimientoTexto(item)</span><br /><small>@item.EstadoGestion · @(item.UltimaGestion?.ToString("dd/MM/yyyy") ?? "Sin gestión")</small></td><td><button type="button" class="ally-table-action" @onclick="() => AbrirGestion(item)">Registrar gestión</button></td></tr>}</tbody></table></div> }
    </section>
</div>

@if (gestion is not null)
{
        <div class="ally-modal-backdrop"><div class="ally-modal" role="dialog" aria-modal="true" aria-labelledby="ally-gestion-title"><div class="ally-modal-heading"><h3 id="ally-gestion-title">Registrar gestión</h3><button type="button" aria-label="Cerrar ventana" @onclick="CerrarGestion">×</button></div><p><strong>@gestion.Cliente</strong><br />@gestion.Producto · @(gestion.EsPorSaldo ? $"{gestion.SaldoDocumentos} documentos disponibles" : $"vence {gestion.FechaVencimiento:dd/MM/yyyy}")</p><label>Resultado<select class="ally-select" @bind="resultado"><option>Pendiente</option><option>Contactado</option><option>No responde</option><option>Interesado</option><option>Pendiente de pago</option><option>No renueva</option><option>Renovado</option></select></label><label>Observación<textarea @bind="observacion"></textarea></label><label>Próximo seguimiento<input type="date" @bind="proximoSeguimiento" /></label>@if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="ally-feedback">@mensaje</div> }<div class="ally-modal-actions"><button type="button" class="ally-button muted" @onclick="CerrarGestion">Cancelar</button><button type="button" class="ally-button" @onclick="GuardarGestion" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar gestión")</button></div></div></div>
}

@code {
    [SupplyParameterFromQuery(Name = "factura")]
    private int? FacturaId { get; set; }

    private List<AliadoRenovacionDto> renovaciones = new();
    private AliadoRenovacionDto? gestion;
    private string filtro = string.Empty;
    private string prioridad = string.Empty;
    private string resultado = "Pendiente";
    private string observacion = string.Empty;
    private DateTime? proximoSeguimiento;
    private string? mensaje;
    private bool cargando = true;
    private bool guardando;
    private int userId;

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;

    private IEnumerable<AliadoRenovacionDto> RenovacionesVisibles => renovaciones.Where(x => prioridad switch
    {
        "vencida" => x.ProximoSeguimiento.HasValue && x.ProximoSeguimiento.Value.Date < DateTime.Today,
        "hoy" => x.ProximoSeguimiento?.Date == DateTime.Today,
        "proxima" => x.ProximoSeguimiento.HasValue && x.ProximoSeguimiento.Value.Date > DateTime.Today,
        "sin-seguimiento" => !x.ProximoSeguimiento.HasValue,
        _ => true
    });

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out userId);
        await CargarAsync();
        if (FacturaId.HasValue)
        {
            var item = renovaciones.FirstOrDefault(x => x.IdFactura == FacturaId.Value);
            if (item is not null)
                AbrirGestion(item);
        }
    }

    private async Task CargarAsync()
    {
        cargando = true;
        renovaciones = (await AliadoService.ObtenerRenovacionesAsync(userId, filtro)).ToList();
        cargando = false;
    }

    private void AbrirGestion(AliadoRenovacionDto item) { gestion = item; resultado = item.EstadoGestion; observacion = item.Observacion ?? string.Empty; mensaje = null; proximoSeguimiento = item.ProximoSeguimiento?.Date; }
    private void CerrarGestion() => gestion = null;

    private static string SeguimientoTexto(AliadoRenovacionDto item) => item.ProximoSeguimiento is null
        ? "Sin fecha"
        : item.ProximoSeguimiento.Value.Date < DateTime.Today
            ? $"Vencido · {item.ProximoSeguimiento:dd/MM}"
            : item.ProximoSeguimiento.Value.Date == DateTime.Today
                ? "Hoy"
                : $"{item.ProximoSeguimiento:dd/MM}";

    private static string SeguimientoCss(AliadoRenovacionDto item) => item.ProximoSeguimiento?.Date switch
    {
        DateTime date when date < DateTime.Today => "danger",
        DateTime date when date == DateTime.Today => "warning",
        null => "",
        _ => "success"
    };

    private static string SaldoCss(int saldo) => saldo > 5 ? "success" : saldo == 5 ? "warning" : "danger";
    private static bool EsUrgente(AliadoRenovacionDto item) => item.EsPorSaldo ? item.SaldoDocumentos < 5 : item.DiasRestantes <= 7;

    private async Task GuardarGestion()
    {
        if (gestion is null || guardando) return;
        guardando = true;
        try
        {
            var response = await AliadoService.RegistrarGestionAsync(userId, gestion.IdFactura, resultado, observacion, proximoSeguimiento);
            if (response.Success)
            {
                await AlertService.ShowSuccessAsync("La gestión quedó registrada correctamente.", "Gestión guardada");
                gestion = null;
                await CargarAsync();
            }
            else
            {
                mensaje = response.Message;
                await AlertService.ShowErrorAsync(response.Message, "No se pudo guardar");
            }
        }
        catch
        {
            mensaje = "No fue posible guardar la gestión. Inténtalo nuevamente.";
            await AlertService.ShowErrorAsync(mensaje, "No se pudo guardar");
        }
        finally
        {
            guardando = false;
        }
    }
}
