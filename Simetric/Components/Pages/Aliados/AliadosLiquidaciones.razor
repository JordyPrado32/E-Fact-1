@page "/aliados/liquidaciones"

<PageTitle>Liquidaciones | Portal de Aliados</PageTitle>

<div class="ally-page">
    <div class="ally-page-intro"><div><span class="ally-eyebrow">PAGOS DE COMISIONES</span><h2>Liquidaciones</h2><p>Consulta las liquidaciones emitidas por Numérica y sus referencias de pago.</p></div></div>
    <section class="ally-panel">
        @if (cargando) { <div class="ally-empty">Cargando liquidaciones...</div> }
        else if (liquidaciones.Count == 0) { <div class="ally-empty">Aún no tienes liquidaciones registradas.</div> }
        else { <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Período</th><th>Fecha</th><th>Total</th><th>Referencia</th><th>Estado</th></tr></thead><tbody>@foreach (var item in liquidaciones) { <tr @key="item.IdLiquidacion"><td>@item.Periodo</td><td>@item.Fecha.ToString("dd/MM/yyyy")</td><td>$ @item.Total.ToString("N2")</td><td>@(item.ReferenciaPago ?? "-")</td><td><span class="ally-badge @(item.Estado == "Pagada" ? "success" : "warning")">@item.Estado</span></td></tr>}</tbody></table></div> }
    </section>
</div>

@code {
    private List<AliadoLiquidacionDto> liquidaciones = new();
    private bool cargando = true;
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
            liquidaciones = (await AliadoService.ObtenerLiquidacionesAsync(id)).ToList();
        cargando = false;
    }
}
