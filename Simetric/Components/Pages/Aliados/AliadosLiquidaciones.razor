@page "/aliados/liquidaciones"
@using MiniExcelLibs
@implements IAsyncDisposable

<PageTitle>Liquidaciones | Portal de Aliados</PageTitle>

<div class="ally-page">
    <section class="liquidations-hero">
        <div><span class="ally-eyebrow">LIQUIDACIONES</span><h2>Liquidaciones</h2><p>Consulta, revisa y descarga las liquidaciones de comisiones de tus clientes.</p></div>
        <div class="liquidations-hero-message"><i class="ri-coins-line"></i><div><strong>Todas tus liquidaciones en un solo lugar</strong><span>Mantén el control de tus comisiones y revisa el detalle de cada período.</span></div></div>
    </section>
    <section class="liquidations-summary">
        <article><span class="liquidations-summary-icon"><i class="ri-file-list-3-line"></i></span><div><small>Total de liquidaciones</small><strong>@LiquidacionesFiltradas.Count</strong><p>@LiquidacionesFiltradas.Sum(x => x.CantidadComisiones) comisiones</p></div><span class="kpi-bars"><i></i><i></i><i></i><i></i></span></article>
        <article class="paid"><span class="liquidations-summary-icon"><i class="ri-checkbox-circle-line"></i></span><div><small>Pagadas</small><strong>$ @TotalPagado.ToString("N2")</strong><p>@LiquidacionesPagadas.Count liquidación(es)</p></div><span class="kpi-bars"><i></i><i></i><i></i><i></i></span></article>
        <article class="pending"><span class="liquidations-summary-icon"><i class="ri-time-line"></i></span><div><small>Pendientes de pago</small><strong>$ @TotalPendiente.ToString("N2")</strong><p>@LiquidacionesPendientes.Count liquidación(es)</p></div><span class="kpi-bars"><i></i><i></i><i></i><i></i></span></article>
        <article class="canceled"><span class="liquidations-summary-icon"><i class="ri-close-circle-line"></i></span><div><small>Anuladas</small><strong>$ @TotalAnulado.ToString("N2")</strong><p>@LiquidacionesAnuladas.Count liquidación(es)</p></div><span class="kpi-bars"><i></i><i></i><i></i><i></i></span></article>
    </section>
    <div class="liquidations-overview">
    <section class="liquidations-filter-panel">
        <header><div><span class="ally-eyebrow">FILTROS DE CONSULTA</span><h3>Encuentra una liquidación</h3><p>Combina fechas, estado, aliado y referencia para consultar el detalle que necesitas.</p></div><button class="ally-button muted filter-reset" type="button" @onclick="RestablecerFiltros"><i class="ri-refresh-line"></i> Limpiar filtros</button></header>
        <div class="liquidations-filter-grid">
            <div class="liquidations-filter-block date"><div class="liquidations-filter-heading"><i class="ri-calendar-check-line"></i><div><strong>Rango de fechas</strong><small>Fecha de emisión de la liquidación</small></div></div><div class="liquidations-date-fields"><label><span>Desde</span><input type="date" @bind="fechaDesde" @bind:format="yyyy-MM-dd" @bind:after="ReiniciarPagina" /></label><span class="date-separator">hasta</span><label><span>Hasta</span><input type="date" @bind="fechaHasta" @bind:format="yyyy-MM-dd" @bind:after="ReiniciarPagina" /></label></div><div class="liquidations-date-presets"><button type="button" class="@(RangoActivo == "mes" ? "active" : "")" @onclick="SeleccionarEsteMes">Este mes</button><button type="button" class="@(RangoActivo == "anterior" ? "active" : "")" @onclick="SeleccionarMesAnterior">Mes anterior</button><button type="button" class="@(RangoActivo == "seis" ? "active" : "")" @onclick="SeleccionarUltimosSeisMeses">Últimos 6 meses</button><button type="button" class="@(RangoActivo == "todo" ? "active" : "")" @onclick="SeleccionarTodo">Todo</button></div></div>
            <div class="liquidations-filter-block"><div class="liquidations-filter-heading"><i class="ri-equalizer-2-line"></i><div><strong>Filtros de liquidación</strong><small>Refina por pago, período o aliado</small></div></div><div class="liquidations-filter-controls"><label class="liquidations-search"><i class="ri-search-line"></i><input @bind="busqueda" @bind:event="oninput" @bind:after="ReiniciarPagina" placeholder="Período, aliado o referencia" /></label><select class="ally-select" @bind="filtroEstado" @bind:after="ReiniciarPagina"><option value="">Todos los estados</option><option>Pendiente</option><option>Pagada</option><option>Anulada</option></select><select class="ally-select" @bind="filtroAliado" @bind:after="ReiniciarPagina"><option value="">Todos los aliados</option>@foreach (var aliado in AliadosDisponibles) { <option value="@aliado">@aliado</option> }</select><select class="ally-select" @bind="filtroPeriodo" @bind:after="ReiniciarPagina"><option value="">Todos los períodos</option>@foreach (var periodo in PeriodosDisponibles) { <option value="@periodo">@periodo</option> }</select></div></div>
        </div>
        <div class="liquidations-filter-footer"><span><i class="ri-filter-3-line"></i> @LiquidacionesFiltradas.Count resultado(s)</span></div>
    </section>
    <aside class="liquidations-visual-panel"><header><span class="liquidations-visual-icon"><i class="ri-bar-chart-box-line"></i></span><div><strong>Resumen visual</strong><small>Información general de tus liquidaciones</small></div></header><div class="liquidations-visual-content"><div class="liquidations-chart-block"><strong>Liquidaciones por mes</strong><div class="liquidations-chart-canvas"><canvas id="ally-liquidations-monthly"></canvas></div></div><div class="liquidations-chart-block state"><strong>Estado de pago</strong><div class="liquidations-chart-canvas"><canvas id="ally-liquidations-status"></canvas></div></div></div></aside>
    </div>
    <section class="ally-panel liquidations-list-card">
        <div class="liquidations-list-heading"><div><span class="ally-eyebrow">HISTORIAL</span><h3>Listado de liquidaciones</h3><p>Revisa el detalle, descarga documentos y consulta el estado de cada liquidación.</p></div><button class="ally-export-card" type="button" @onclick="ExportarExcelAsync" disabled="@(!LiquidacionesFiltradas.Any())"><span class="ally-export-card-icon"><i class="ri-download-2-line"></i></span><span><strong>Exportar liquidaciones</strong><small>Archivo Excel</small></span></button></div>
        @if (cargando)
        {
            <AllyLoadingState Title="Cargando liquidaciones" Description="Preparando tu historial de pagos." />
        }
        else if (!LiquidacionesFiltradas.Any())
        {
            <div class="ally-empty">@(liquidaciones.Count == 0 ? "Aún no tienes liquidaciones registradas." : "No hay liquidaciones para este estado.")</div>
        }
        else
        {
            <div class="ally-table-wrap"><table class="ally-table liquidations-table"><thead><tr><th>Fecha / período</th><th>Aliado</th><th>Movimientos</th><th>Total</th><th>Referencia</th><th>Estado de pago</th><th>Documentos</th><th>Acciones</th></tr></thead><tbody>
            @foreach (var item in LiquidacionesPaginadas)
            {
                <tr @key="item.IdLiquidacion"><td>@(string.IsNullOrWhiteSpace(item.Aliado) ? "-" : item.Aliado)</td><td><strong>@item.Periodo</strong></td><td>@item.Fecha.ToString("dd/MM/yyyy")</td><td>@item.CantidadComisiones comisión(es)</td><td>$ @item.Total.ToString("N2")</td><td>@(item.ReferenciaPago ?? "-")</td><td><span class="ally-badge @EstadoLiquidacionCss(item.Estado)">@EstadoLiquidacionTexto(item.Estado)</span></td><td><div class="liquidation-document-actions">@if (item.CodLiquidacionCompra is > 0) { <button type="button" class="ally-document-link xml" @onclick="() => AbrirXmlAsync(item)" title="Descargar XML autorizado por el SRI">XML</button><button type="button" class="ally-document-link pdf" @onclick="() => AbrirPdfAsync(item)" title="Descargar PDF autorizado por el SRI">PDF</button> }@if (!string.IsNullOrWhiteSpace(item.ComprobantePagoUrl)) { <button type="button" class="ally-table-action" @onclick="() => AbrirComprobante(item)" title="Ver comprobante de pago"><i class="ri-attachment-2"></i></button> }</div></td><td><button type="button" class="ally-table-action" @onclick="() => VerDetalleAsync(item)">Ver detalle</button></td></tr>
            }
            </tbody></table></div>
            <div class="ally-pagination"><button class="ally-table-action" type="button" @onclick="() => CambiarPagina(-1)" disabled="@(pagina <= 1)">Anterior</button><span>Página @pagina de @TotalPaginas</span><button class="ally-table-action" type="button" @onclick="() => CambiarPagina(1)" disabled="@(pagina >= TotalPaginas)">Siguiente</button></div>
        }
    </section>
</div>

@if (liquidacionSeleccionada is not null)
{
    <div class="ally-modal-backdrop" @onclick="CerrarDetalle">
        <div class="ally-modal ally-modal-wide" role="dialog" aria-modal="true" aria-labelledby="detalle-liquidacion-title" @onclick:stopPropagation="true">
            <div class="ally-modal-heading"><h3 id="detalle-liquidacion-title">Liquidación @liquidacionSeleccionada.Periodo</h3><button type="button" aria-label="Cerrar detalle" @onclick="CerrarDetalle">×</button></div>
            <div class="ally-detail-grid"><div><span>Fecha</span><strong>@liquidacionSeleccionada.Fecha.ToString("dd/MM/yyyy")</strong></div><div><span>Movimientos</span><strong>@movimientosDetalle.Count</strong></div><div><span>Total</span><strong>$ @liquidacionSeleccionada.Total.ToString("N2")</strong></div><div><span>Referencia</span><strong>@(liquidacionSeleccionada.ReferenciaPago ?? "Sin referencia")</strong></div></div>
            @if (cargandoDetalle)
            {
                <div class="ally-empty">Cargando movimientos...</div>
            }
            else if (movimientosDetalle.Count == 0)
            {
                <div class="ally-empty">No hay movimientos asociados a esta liquidación.</div>
            }
            else
            {
                <div class="liquidation-detail-breakdown"><span><b class="paid-dot"></b>Pagadas: <strong>@movimientosDetalle.Count(EstaPagado)</strong> · $ @movimientosDetalle.Where(EstaPagado).Sum(x => x.ValorComision).ToString("N2")</span><span><b class="pending-dot"></b>Pendientes: <strong>@movimientosDetalle.Count(x => !EstaPagado(x))</strong> · $ @movimientosDetalle.Where(x => !EstaPagado(x)).Sum(x => x.ValorComision).ToString("N2")</span></div>
                <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Cliente / producto</th><th>Tipo</th><th>Base</th><th>Comisión</th><th>Estado de pago</th></tr></thead><tbody>@foreach (var movimiento in movimientosDetalle) { <tr @key="movimiento.IdComision"><td><strong>@movimiento.Cliente</strong><br /><small>@movimiento.Producto</small></td><td>@movimiento.Tipo</td><td>$ @movimiento.BaseComisionable.ToString("N2")</td><td>$ @movimiento.ValorComision.ToString("N2")<br /><small>@movimiento.Porcentaje.ToString("0.##")%</small></td><td><span class="ally-badge @EstadoPagoCss(movimiento)">@EstadoPagoTexto(movimiento)</span></td></tr>}</tbody></table></div>
            }
            <div class="ally-modal-actions"><button type="button" class="ally-button muted" @onclick="CerrarDetalle">Cerrar</button></div>
        </div>
    </div>
}

@if (comprobanteSeleccionado is not null && !string.IsNullOrWhiteSpace(comprobanteSeleccionado.ComprobantePagoUrl))
{
    <div class="liquidation-preview-backdrop" @onclick="CerrarComprobante">
        <div class="liquidation-preview-modal" role="dialog" aria-modal="true" aria-label="Vista previa del comprobante" @onclick:stopPropagation="true">
            <div class="liquidation-preview-header"><strong>Comprobante de pago</strong><button type="button" @onclick="CerrarComprobante" aria-label="Cerrar vista previa"><i class="ri-close-line"></i></button></div>
            <div class="liquidation-preview-body">@if (EsPdf(comprobanteSeleccionado.ComprobantePagoUrl)) { <iframe src="@comprobanteSeleccionado.ComprobantePagoUrl" title="Comprobante de pago"></iframe> } else { <img src="@comprobanteSeleccionado.ComprobantePagoUrl" alt="Comprobante de pago" /> }</div>
        </div>
    </div>
}

@code {
    private List<AliadoLiquidacionDto> liquidaciones = new();
    private AliadoLiquidacionDto? liquidacionSeleccionada;
    private AliadoLiquidacionDto? comprobanteSeleccionado;
    private List<AliadoComisionMovimientoDto> movimientosDetalle = new();
    private string filtroEstado = string.Empty;
    private string filtroAliado = string.Empty;
    private string filtroPeriodo = string.Empty;
    private string busqueda = string.Empty;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private int pagina = 1;
    private const int TamanoPagina = 20;
    private IReadOnlyList<AliadoLiquidacionDto> LiquidacionesFiltradas => liquidaciones.Where(x =>
        (!fechaDesde.HasValue || x.Fecha.Date >= fechaDesde.Value.Date) &&
        (!fechaHasta.HasValue || x.Fecha.Date <= fechaHasta.Value.Date) &&
        (string.IsNullOrWhiteSpace(filtroEstado) || x.Estado == filtroEstado) &&
        (string.IsNullOrWhiteSpace(filtroAliado) || x.Aliado == filtroAliado) &&
        (string.IsNullOrWhiteSpace(filtroPeriodo) || x.Periodo == filtroPeriodo) &&
        (string.IsNullOrWhiteSpace(busqueda) || $"{x.Periodo} {x.ReferenciaPago} {x.Estado}".Contains(busqueda, StringComparison.OrdinalIgnoreCase))).ToList();
    private IEnumerable<AliadoLiquidacionDto> LiquidacionesPaginadas => LiquidacionesFiltradas.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina);
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(LiquidacionesFiltradas.Count / (double)TamanoPagina));
    private IReadOnlyList<AliadoLiquidacionDto> LiquidacionesPagadas => LiquidacionesFiltradas.Where(x => x.Estado == "Pagada").ToList();
    private IReadOnlyList<AliadoLiquidacionDto> LiquidacionesPendientes => LiquidacionesFiltradas.Where(x => x.Estado == "Pendiente").ToList();
    private IReadOnlyList<AliadoLiquidacionDto> LiquidacionesAnuladas => LiquidacionesFiltradas.Where(x => x.Estado == "Anulada").ToList();
    private decimal TotalPagado => LiquidacionesPagadas.Sum(x => x.Total);
    private decimal TotalPendiente => LiquidacionesPendientes.Sum(x => x.Total);
    private decimal TotalAnulado => LiquidacionesAnuladas.Sum(x => x.Total);
    private IReadOnlyList<ResumenPeriodo> ResumenPeriodos => LiquidacionesFiltradas
        .GroupBy(x => x.Periodo)
        .OrderByDescending(x => x.Key)
        .Take(6)
        .OrderBy(x => x.Key)
        .Select(x => new ResumenPeriodo(x.Key, x.Count()))
        .ToList();
    private bool cargando = true;
    private bool cargandoDetalle;
    private bool graficosPendientes;
    private string RangoActivo { get; set; } = "todo";

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;

    private void ReiniciarPagina() { pagina = 1; RangoActivo = string.Empty; graficosPendientes = true; }
    private void SeleccionarEsteMes() => AplicarRango(DateTime.Today.AddDays(1 - DateTime.Today.Day), DateTime.Today, "mes");
    private void SeleccionarMesAnterior() { var inicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1); AplicarRango(inicio, inicio.AddMonths(1).AddDays(-1), "anterior"); }
    private void SeleccionarUltimosSeisMeses() => AplicarRango(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-5), DateTime.Today, "seis");
    private void SeleccionarTodo() { fechaDesde = null; fechaHasta = null; RangoActivo = "todo"; pagina = 1; graficosPendientes = true; }
    private void AplicarRango(DateTime desde, DateTime hasta, string rango) { fechaDesde = desde; fechaHasta = hasta; RangoActivo = rango; pagina = 1; graficosPendientes = true; }
    private void RestablecerFiltros() { filtroEstado = string.Empty; filtroAliado = string.Empty; filtroPeriodo = string.Empty; busqueda = string.Empty; SeleccionarTodo(); }
    private void CambiarPagina(int delta) => pagina = Math.Clamp(pagina + delta, 1, TotalPaginas);
    private void CerrarDetalle() => liquidacionSeleccionada = null;
    private void AbrirComprobante(AliadoLiquidacionDto item) => comprobanteSeleccionado = item;
    private void CerrarComprobante() => comprobanteSeleccionado = null;
    private static bool EsPdf(string? url) => url?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;
    private IEnumerable<string> PeriodosDisponibles => liquidaciones.Select(x => x.Periodo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderByDescending(x => x);
    private IEnumerable<string> AliadosDisponibles => liquidaciones.Select(x => x.Aliado).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private static bool EstaPagado(AliadoComisionMovimientoDto item) => item.EstadoPago == "Pagada";
    private static string EstadoPagoTexto(AliadoComisionMovimientoDto item) => item.EstadoPago == "Pagada" ? "Pagada" : item.EstadoPago == "Anulada" ? "Anulada" : "Pendiente de pago";
    private static string EstadoPagoCss(AliadoComisionMovimientoDto item) => item.EstadoPago == "Pagada" ? "success" : item.EstadoPago == "Anulada" ? "danger" : "warning";
    private static string EstadoLiquidacionTexto(string estado) => estado == "Pagada" ? "Pagada" : estado == "Anulada" ? "Anulada" : "Pendiente de pago";
    private static string EstadoLiquidacionCss(string estado) => estado == "Pagada" ? "success" : estado == "Anulada" ? "danger" : "warning";
    private static string EtiquetaPeriodo(string periodo) => DateTime.TryParseExact($"{periodo}-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var fecha) ? fecha.ToString("MMM", new System.Globalization.CultureInfo("es-EC")) : periodo;
    private sealed record ResumenPeriodo(string Periodo, int Cantidad);

    private int currentUserId;

    private async Task AbrirXmlAsync(AliadoLiquidacionDto item)
    {
        try
        {
            var url = await AliadoService.AsegurarXmlLiquidacionAsync(currentUserId, item.IdLiquidacion);
            if (string.IsNullOrWhiteSpace(url))
            {
                await AlertService.ShowWarningAsync("No se pudo generar o ubicar el XML de la liquidación.");
                return;
            }

            await JS.InvokeVoidAsync("open", $"{url}?v={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}", "_blank");
        }
        catch (Exception ex)
        {
            await AlertService.ShowWarningAsync($"No se pudo preparar el XML: {ex.Message}");
        }
    }

    private async Task AbrirPdfAsync(AliadoLiquidacionDto item)
    {
        try
        {
            var url = await AliadoService.AsegurarPdfLiquidacionAsync(currentUserId, item.IdLiquidacion);
            if (string.IsNullOrWhiteSpace(url))
            {
                await AlertService.ShowWarningAsync("No se pudo generar o ubicar el PDF de la liquidación.");
                return;
            }

            await JS.InvokeVoidAsync("open", $"{url}?v={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}", "_blank");
        }
        catch (Exception ex)
        {
            await AlertService.ShowWarningAsync($"No se pudo preparar el PDF: {ex.Message}");
        }
    }

    private async Task VerDetalleAsync(AliadoLiquidacionDto liquidacion)
    {
        liquidacionSeleccionada = liquidacion;
        movimientosDetalle = new();
        cargandoDetalle = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
                movimientosDetalle = (await AliadoService.ObtenerDetalleLiquidacionAsync(id, liquidacion.IdLiquidacion)).ToList();
        }
        finally
        {
            cargandoDetalle = false;
        }
    }
    private async Task ExportarExcelAsync()
    {
        var data = LiquidacionesFiltradas.Select(x => new { x.Aliado, x.Periodo, x.Fecha, x.CantidadComisiones, x.Total, Referencia = x.ReferenciaPago ?? string.Empty, x.Estado }).ToList();
        using var stream = new MemoryStream();
        stream.SaveAs(data);
        stream.Position = 0;
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", $"Liquidaciones_Aliados_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", reference, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        await AlertService.ShowSuccessAsync("El archivo Excel se descargó correctamente.", "Exportación lista");
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
        {
            currentUserId = id;
            liquidaciones = (await AliadoService.ObtenerLiquidacionesAsync(id)).ToList();
        }
        cargando = false;
        graficosPendientes = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!graficosPendientes || cargando)
            return;

        graficosPendientes = false;
        await JS.InvokeVoidAsync("aliadosLiquidacionesCharts.render", new
        {
            monthly = new { labels = ResumenPeriodos.Select(x => EtiquetaPeriodo(x.Periodo)), values = ResumenPeriodos.Select(x => x.Cantidad) },
            status = new { labels = new[] { "Pagadas", "Pendientes", "Anuladas" }, values = new[] { LiquidacionesPagadas.Count, LiquidacionesPendientes.Count, LiquidacionesAnuladas.Count } }
        });
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("aliadosLiquidacionesCharts.destroy"); } catch (JSDisconnectedException) { }
    }
}
