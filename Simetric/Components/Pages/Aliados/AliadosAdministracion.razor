@page "/aliados/admin"

<PageTitle>Administración | Portal de Aliados</PageTitle>

<div class="ally-page">
    <section class="ally-hero">
        <div><span class="ally-eyebrow">ADMINISTRACIÓN INTERNA</span><h2>Portal de Aliados</h2><p>Administra cuentas, canales y porcentajes de comisión.</p></div>
        <NavLink class="ally-button light" href="/aliados/admin/permisos"><i class="ri-shield-user-line"></i> Roles y permisos</NavLink>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="ally-feedback">@mensaje</div>
    }

    <div class="ally-admin-grid">
        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">NUEVA CUENTA</span><h3>Crear acceso</h3></div></div>
            <label class="ally-admin-label">Tipo de cuenta</label>
            <select class="ally-select" @bind="tipoCuenta">
                <option value="aliado">Usuario Aliado Comercial</option>
                @if (puedeCrearAdministrador)
                {
                    <option value="administrador">Administrador Portal de Aliados</option>
                }
            </select>
            <label class="ally-admin-label">Nombre</label>
            <input class="ally-admin-input" @bind="nombre" placeholder="Nombre de la cuenta o aliado" />
            <label class="ally-admin-label">Correo</label>
            <input class="ally-admin-input" type="email" @bind="email" />
            <label class="ally-admin-label">Clave inicial</label>
            <input class="ally-admin-input" type="password" @bind="password" />
            @if (tipoCuenta == "aliado")
            {
                <label class="ally-admin-label">Porcentaje base</label>
                <input class="ally-admin-input" type="number" min="0" max="100" step=".01" @bind="porcentaje" />
            }
            <button class="ally-button" type="button" @onclick="CrearAsync" disabled="@guardando">@(guardando ? "Creando..." : "Crear cuenta")</button>
        </section>

        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">CANALES</span><h3>Aliados registrados</h3></div><span class="ally-readonly">Solo lectura</span></div>
            <div class="ally-table-wrap">
                <table class="ally-table">
                    <thead><tr><th>Aliado</th><th>Cuenta</th><th>Canal</th><th>Comisión</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var aliado in aliados)
                        {
                            <tr @key="aliado.IdVendedor"><td><strong>@aliado.Nombre</strong></td><td>@(aliado.Usuario ?? "Sin cuenta")</td><td>@aliado.CodigoReferencia</td><td><input class="ally-admin-input" style="max-width:90px" type="number" min="0" max="100" step=".01" value="@aliado.PorcentajeBase" @onchange="e => ActualizarPorcentajeAsync(aliado, e)" />%</td><td><span class="ally-badge @(aliado.Activo ? "success" : "danger")">@(aliado.Activo ? "Activo" : "Inactivo")</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    @if (configuracion is not null)
    {
        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">REGLAS FINANCIERAS</span><h3>Intervención de Numérica</h3></div><span class="ally-readonly">Solo personal interno</span></div>
            <div class="ally-admin-grid">
                <div><label class="ally-admin-label">Comisión de renovación por Numérica</label><input class="ally-admin-input" type="number" min="0" max="100" step=".01" @bind="porcentajeRenovacionNumerica" /></div>
                <div><label class="ally-admin-label">Días antes del vencimiento</label><input class="ally-admin-input" type="number" min="0" max="365" @bind="diasIntervencionNumerica" /></div>
            </div>
            <button class="ally-button" type="button" @onclick="GuardarConfiguracionAsync" disabled="@guardandoConfiguracion">@(guardandoConfiguracion ? "Guardando..." : "Guardar regla")</button>
        </section>
    }

    <section class="ally-panel">
        <div class="ally-panel-heading"><div><span class="ally-label">LIBRO MAYOR</span><h3>Comisiones</h3></div><input class="ally-admin-input" style="max-width:240px" @bind="referenciaPago" placeholder="Referencia del pago" /></div>
        @if (comisiones.Count == 0)
        {
            <div class="ally-empty">No hay comisiones generadas con los pagos actuales.</div>
        }
        else
        {
            <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Aliado</th><th>Factura / cliente</th><th>Tipo</th><th>Base</th><th>Valor</th><th>Estado</th><th></th></tr></thead><tbody>
                @foreach (var comision in comisiones)
                {
                    <tr @key="comision.IdComision"><td>@comision.Aliado</td><td>#@comision.IdFactura<br /><small>@comision.Cliente</small></td><td>@comision.TipoComision</td><td>$ @comision.BaseComisionable.ToString("N2")<br /><small>@comision.Porcentaje.ToString("0.##")%</small></td><td>$ @comision.Valor.ToString("N2")</td><td><span class="ally-badge @(comision.Estado == "Pagada" ? "success" : comision.Estado == "Aprobada" ? "" : "warning")">@comision.Estado</span><br /><small>@(comision.Periodo ?? "-")</small></td><td>@if (comision.Estado == "Generada") { <button type="button" class="ally-table-action" @onclick="() => AprobarAsync(comision)">Aprobar</button> } else if (comision.Estado == "Aprobada") { <button type="button" class="ally-table-action" @onclick="() => PagarAsync(comision)">Registrar pago</button> } else { <span class="ally-readonly">@(comision.ReferenciaPago ?? "Pagada")</span> }</td></tr>
                }
            </tbody></table></div>
        }
    </section>
</div>

@code {
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    private List<AliadoAdminRow> aliados = new();
    private string tipoCuenta = "aliado";
    private string nombre = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private decimal porcentaje = 30m;
    private string? mensaje;
    private bool guardando;
    private bool puedeCrearAdministrador;
    private List<AliadoAdminComisionRow> comisiones = new();
    private AliadoPortalConfiguracion? configuracion;
    private decimal porcentajeRenovacionNumerica = 15m;
    private int diasIntervencionNumerica = 15;
    private string referenciaPago = string.Empty;
    private bool guardandoConfiguracion;
    private int actorId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out actorId);
        puedeCrearAdministrador = auth.User.IsInRole(BackOfficePermissionHelper.SuperAdministradorRoleId.ToString());
        await CargarAsync();
        await CargarComisionesAsync();
        await CargarConfiguracionAsync();
    }

    private async Task CargarAsync() => aliados = (await AliadoService.ListarAliadosAsync()).ToList();
    private async Task CargarComisionesAsync() => comisiones = (await AliadoService.ObtenerComisionesAdministracionAsync(actorId)).ToList();

    private async Task CargarConfiguracionAsync()
    {
        configuracion = await AliadoService.ObtenerConfiguracionPortalAsync(actorId);
        if (configuracion is not null)
        {
            porcentajeRenovacionNumerica = configuracion.PorcentajeRenovacionNumerica;
            diasIntervencionNumerica = configuracion.DiasIntervencionNumerica;
        }
    }

    private async Task CrearAsync()
    {
        if (guardando) return;
        guardando = true;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId);
        var resultado = await AliadoService.CrearCuentaAliadoAsync(actorId, nombre, email, password, porcentaje, tipoCuenta == "administrador");
        mensaje = resultado.Message;
        if (resultado.Success)
        {
            nombre = email = password = string.Empty;
            porcentaje = 30m;
            await CargarAsync();
        }
        guardando = false;
    }

    private async Task GuardarConfiguracionAsync()
    {
        if (guardandoConfiguracion) return;
        guardandoConfiguracion = true;
        var resultado = await AliadoService.ActualizarConfiguracionPortalAsync(actorId, porcentajeRenovacionNumerica, diasIntervencionNumerica);
        mensaje = resultado.Message;
        if (resultado.Success) await CargarConfiguracionAsync();
        guardandoConfiguracion = false;
    }

    private async Task AprobarAsync(AliadoAdminComisionRow comision)
    {
        var resultado = await AliadoService.AprobarComisionAsync(actorId, comision.IdComision);
        mensaje = resultado.Message;
        if (resultado.Success) await CargarComisionesAsync();
    }

    private async Task PagarAsync(AliadoAdminComisionRow comision)
    {
        var resultado = await AliadoService.PagarComisionAsync(actorId, comision.IdComision, referenciaPago);
        mensaje = resultado.Message;
        if (resultado.Success)
        {
            referenciaPago = string.Empty;
            await CargarComisionesAsync();
        }
    }

    private async Task ActualizarPorcentajeAsync(AliadoAdminRow aliado, object? valor)
    {
        if (valor is not ChangeEventArgs change || !decimal.TryParse(change.Value?.ToString(), out var porcentaje))
            return;
        var resultado = await AliadoService.ActualizarPorcentajeAliadoAsync(actorId, aliado.IdVendedor, porcentaje);
        mensaje = resultado.Message;
        if (resultado.Success) await CargarAsync();
    }
}
