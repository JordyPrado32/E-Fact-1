@page "/aliados/admin/gestion"
@using System.Globalization

<PageTitle>Administración | Portal de Aliados</PageTitle>

<div class="ally-page">
    <section class="ally-hero">
        <div><span class="ally-eyebrow">ADMINISTRACIÓN INTERNA</span><h2>Portal de Aliados</h2><p>Administra cuentas, canales y porcentajes de comisión.</p></div>
        <div class="ally-page-tools"><button class="ally-button light" type="button" @onclick="AbrirModalAsignarClientesAsync"><i class="ri-user-shared-line"></i> Asignar clientes</button><NavLink class="ally-button light" href="/aliados/admin/usuarios"><i class="ri-group-line"></i> Usuarios</NavLink><NavLink class="ally-button light" href="/backoffice/comisiones"><i class="ri-money-dollar-circle-line"></i> Todas las comisiones</NavLink><button class="ally-button light" type="button" @onclick="AbrirModalCrear"><i class="ri-user-add-line"></i> Crear cuenta</button><NavLink class="ally-button light" href="/aliados/admin/permisos"><i class="ri-shield-user-line"></i> Roles y permisos</NavLink></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="ally-feedback">@mensaje</div>
    }

    <div class="ally-admin-grid">
        <section class="ally-panel ally-creation-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">CUENTAS</span><h3>Accesos del portal</h3></div><span class="ally-readonly">@(aliados.Count) aliados</span></div>
            <p class="ally-panel-copy">Crea cuentas de aliados comerciales y administra sus canales de venta desde un formulario seguro.</p>
            <button class="ally-button" type="button" @onclick="AbrirModalCrear"><i class="ri-user-add-line"></i> Crear cuenta</button>
        </section>

        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">CANALES</span><h3>Aliados registrados</h3></div><div class="ally-page-tools ally-admin-filters"><div class="ally-search"><i class="ri-search-line"></i><input @bind="filtroAliados" @bind:event="oninput" placeholder="Buscar aliado, correo o canal" /></div><select class="ally-select" @bind="filtroEstadoAliados"><option value="">Todos los estados</option><option value="activo">Activos</option><option value="inactivo">Inactivos</option></select></div></div>
            <div class="ally-table-wrap">
                <table class="ally-table">
                    <thead><tr><th>Aliado</th><th>Cuenta</th><th>Canal</th><th>Comisión</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @if (!AliadosFiltrados.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No hay aliados para los filtros seleccionados.</td></tr>
                        }
                        @foreach (var aliado in AliadosFiltrados)
                        {
                            <tr @key="aliado.IdVendedor"><td><strong>@aliado.Nombre</strong></td><td>@(aliado.Usuario ?? "Sin cuenta")</td><td>@aliado.CodigoReferencia</td><td><input class="ally-admin-input ally-percent-input" type="number" min="0" max="100" step="0.01" value="@aliado.PorcentajeBase.ToString("0.##", CultureInfo.InvariantCulture)" @onchange="e => ActualizarPorcentajeAsync(aliado, e)" />%</td><td><span class="ally-badge @(aliado.Activo && aliado.UsuarioActivo ? "success" : "danger")">@(aliado.Activo && aliado.UsuarioActivo ? "Activo" : "Inactivo")</span></td><td><button type="button" class="ally-table-action" @onclick="() => CambiarEstadoAsync(aliado)" disabled="@guardandoEstado">@(aliado.Activo && aliado.UsuarioActivo ? "Desactivar" : "Activar")</button></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    @if (configuracion is not null)
    {
        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">REGLAS FINANCIERAS</span><h3>Intervención de Numérica</h3></div><span class="ally-readonly">Solo personal interno</span></div>
            <div class="ally-admin-grid">
                <div><label class="ally-admin-label">Comisión de venta nueva por defecto</label><input class="ally-admin-input" type="number" min="0" max="100" step="0.01" @bind="porcentajeVentaNueva" /></div>
                <div><label class="ally-admin-label">Comisión de renovación del aliado por defecto</label><input class="ally-admin-input" type="number" min="0" max="100" step="0.01" @bind="porcentajeRenovacionAliado" /></div>
                <div><label class="ally-admin-label">Comisión de renovación por Numérica</label><input class="ally-admin-input" type="number" min="0" max="100" step="0.01" @bind="porcentajeRenovacionNumerica" /></div>
                <div><label class="ally-admin-label">Días antes del vencimiento</label><input class="ally-admin-input" type="number" min="0" max="365" @bind="diasIntervencionNumerica" /></div>
            </div>
            <button class="ally-button" type="button" @onclick="GuardarConfiguracionAsync" disabled="@guardandoConfiguracion">@(guardandoConfiguracion ? "Guardando..." : "Guardar regla")</button>
        </section>
    }

    <section class="ally-panel">
        <div class="ally-panel-heading"><div><span class="ally-label">COMISIONES</span><h3>Detalle separado</h3></div></div>
        <p class="ally-panel-copy">La configuración del porcentaje está en cada aliado. El detalle, ajuste y liquidación de comisiones se administran en una vista independiente.</p>
        <NavLink class="ally-button" href="/backoffice/comisiones"><i class="ri-external-link-line"></i> Abrir todas las comisiones</NavLink>
    </section>
</div>

@if (mostrarModalCrear)
{
    <div class="ally-modal-backdrop" @onclick="CerrarModalCrear">
        <div class="ally-modal" role="dialog" aria-modal="true" aria-labelledby="crear-cuenta-title" @onclick:stopPropagation="true">
            <div class="ally-modal-heading"><h3 id="crear-cuenta-title">Crear cuenta</h3><button type="button" aria-label="Cerrar ventana" @onclick="CerrarModalCrear">×</button></div>
            <p class="ally-panel-copy">Completa los datos de acceso y asigna el porcentaje base del aliado.</p>
            <label>Tipo de cuenta<select class="ally-select" @bind="tipoCuenta"><option value="aliado">Usuario Aliado Comercial</option>@if (puedeCrearAdministrador) { <option value="administrador">Administrador Portal de Aliados</option> }</select></label>
            <label>Nombre<input class="ally-admin-input" @bind="nombre" placeholder="Nombre de la cuenta o aliado" /></label>
            <label>Correo<input class="ally-admin-input" type="email" @bind="email" /></label>
            <label>Clave inicial<input class="ally-admin-input" type="password" @bind="password" /></label>
            @if (tipoCuenta == "aliado")
            {
                <label>Porcentaje base (0 a 100)<input class="ally-admin-input" type="number" min="0" max="100" step="0.01" @bind="porcentaje" /></label>
            }
            @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="ally-feedback">@mensaje</div> }
            <div class="ally-modal-actions"><button class="ally-button muted" type="button" @onclick="CerrarModalCrear">Cancelar</button><button class="ally-button" type="button" @onclick="CrearAsync" disabled="@guardando">@(guardando ? "Creando..." : "Crear cuenta")</button></div>
        </div>
    </div>
}

@if (mostrarModalAsignarClientes)
{
    <div class="ally-modal-backdrop" @onclick="CerrarModalAsignarClientes">
        <div class="ally-modal ally-modal-wide" role="dialog" aria-modal="true" aria-labelledby="asignar-clientes-title" @onclick:stopPropagation="true">
            <div class="ally-modal-heading"><h3 id="asignar-clientes-title">Asignar clientes</h3><button type="button" aria-label="Cerrar ventana" @onclick="CerrarModalAsignarClientes">×</button></div>
            <p class="ally-panel-copy">Selecciona el aliado que recibirá las comisiones de las nuevas facturas. Las comisiones históricas no se transfieren.</p>
            <div class="ally-assignment-toolbar">
                <select class="ally-select" @bind="idVendedorDestino">
                    <option value="0">Selecciona un aliado</option>
                    @foreach (var aliado in aliados.Where(x => x.Activo && x.UsuarioActivo))
                    {
                        <option value="@aliado.IdVendedor">@aliado.Nombre</option>
                    }
                </select>
                <div class="ally-search"><i class="ri-search-line"></i><input @bind="filtroClientesAsignacion" @bind:event="oninput" placeholder="Buscar cliente, identificación o correo" /></div>
            </div>
            @if (cargandoClientesAsignacion)
            {
                <div class="ally-empty">Cargando clientes...</div>
            }
            else if (!ClientesAsignacionFiltrados.Any())
            {
                <div class="ally-empty">No hay clientes que coincidan con el filtro.</div>
            }
            else
            {
                <div class="ally-table-wrap">
                    <table class="ally-table ally-assignment-table">
                        <thead><tr><th>Cliente</th><th>Contacto</th><th>Aliado actual</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var cliente in ClientesAsignacionFiltrados)
                            {
                                <tr @key="cliente.IdCliente">
                                    <td><strong>@cliente.Nombre</strong><small>@(cliente.Identificacion ?? "Sin identificación")</small></td>
                                    <td>@(cliente.Correo ?? "Sin correo")</td>
                                    <td>
                                        <span class="ally-badge @(cliente.IdVendedorActual.HasValue ? "warning" : "success")">@(cliente.AliadoActual ?? "Sin aliado")</span>
                                        @if (cliente.IdVendedorActual.HasValue)
                                        {
                                            <small>Se retirará; las comisiones no se transfieren.</small>
                                        }
                                    </td>
                                    <td><button type="button" class="ally-table-action" @onclick="() => AsignarClienteAsync(cliente)" disabled="@(guardandoAsignacion || idVendedorDestino <= 0)">Asignar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;

    private List<AliadoAdminRow> aliados = new();
    private string tipoCuenta = "aliado";
    private string nombre = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private decimal porcentaje;
    private string? mensaje;
    private bool guardando;
    private bool mostrarModalCrear;
    private bool puedeCrearAdministrador;
    private AliadoPortalConfiguracion? configuracion;
    private decimal porcentajeVentaNueva = 30m;
    private decimal porcentajeRenovacionAliado = 30m;
    private decimal porcentajeRenovacionNumerica = 15m;
    private int diasIntervencionNumerica = 15;
    private bool guardandoConfiguracion;
    private bool guardandoEstado;
    private bool mostrarModalAsignarClientes;
    private bool cargandoClientesAsignacion;
    private bool guardandoAsignacion;
    private int idVendedorDestino;
    private string filtroClientesAsignacion = string.Empty;
    private List<AliadoClienteAsignacionRow> clientesAsignacion = new();
    private int actorId;
    private string filtroAliados = string.Empty;
    private string filtroEstadoAliados = string.Empty;

    private IEnumerable<AliadoClienteAsignacionRow> ClientesAsignacionFiltrados => clientesAsignacion.Where(x =>
        string.IsNullOrWhiteSpace(filtroClientesAsignacion) ||
        x.Nombre.Contains(filtroClientesAsignacion, StringComparison.OrdinalIgnoreCase) ||
        (x.Identificacion?.Contains(filtroClientesAsignacion, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (x.Correo?.Contains(filtroClientesAsignacion, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (x.AliadoActual?.Contains(filtroClientesAsignacion, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<AliadoAdminRow> AliadosFiltrados => aliados.Where(x =>
        (string.IsNullOrWhiteSpace(filtroAliados) ||
         x.Nombre.Contains(filtroAliados, StringComparison.OrdinalIgnoreCase) ||
         (x.Usuario?.Contains(filtroAliados, StringComparison.OrdinalIgnoreCase) ?? false) ||
         x.CodigoReferencia.Contains(filtroAliados, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroEstadoAliados) ||
         (filtroEstadoAliados == "activo" && x.Activo && x.UsuarioActivo) ||
         (filtroEstadoAliados == "inactivo" && !(x.Activo && x.UsuarioActivo))));
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out actorId);
        puedeCrearAdministrador = auth.User.IsInRole(BackOfficePermissionHelper.SuperAdministradorRoleId.ToString());
        await CargarAsync();
        await CargarConfiguracionAsync();
    }

    private void AbrirModalCrear()
    {
        mensaje = null;
        mostrarModalCrear = true;
    }

    private void CerrarModalCrear()
    {
        if (!guardando)
            mostrarModalCrear = false;
    }

    private async Task AbrirModalAsignarClientesAsync()
    {
        mensaje = null;
        idVendedorDestino = 0;
        filtroClientesAsignacion = string.Empty;
        mostrarModalAsignarClientes = true;
        cargandoClientesAsignacion = true;
        clientesAsignacion = (await AliadoService.ListarClientesParaAsignacionAsync(actorId)).ToList();
        cargandoClientesAsignacion = false;
    }

    private void CerrarModalAsignarClientes()
    {
        if (!guardandoAsignacion)
            mostrarModalAsignarClientes = false;
    }

    private async Task AsignarClienteAsync(AliadoClienteAsignacionRow cliente)
    {
        if (guardandoAsignacion || idVendedorDestino <= 0)
            return;

        var aliadoDestino = aliados.FirstOrDefault(x => x.IdVendedor == idVendedorDestino)?.Nombre ?? "el aliado seleccionado";
        if (cliente.IdVendedorActual.HasValue && !await AlertService.ConfirmAsync(
                $"Este cliente se retirará de {cliente.AliadoActual ?? "su aliado actual"} y se asignará a {aliadoDestino}. Las comisiones existentes no se transferirán.",
                "Confirmar reasignación",
                "Sí, asignar"))
            return;

        guardandoAsignacion = true;
        try
        {
            var resultado = await AliadoService.AsignarClienteAliadoAsync(actorId, cliente.IdCliente, idVendedorDestino);
            await MostrarResultadoAsync(resultado, "Cliente asignado");
            if (resultado.Success)
                clientesAsignacion = (await AliadoService.ListarClientesParaAsignacionAsync(actorId)).ToList();
        }
        finally
        {
            guardandoAsignacion = false;
        }
    }

    private async Task CargarAsync() => aliados = (await AliadoService.ListarAliadosAsync()).ToList();

    private async Task CargarConfiguracionAsync()
    {
        configuracion = await AliadoService.ObtenerConfiguracionPortalAsync(actorId);
        if (configuracion is not null)
        {
            porcentajeVentaNueva = configuracion.PorcentajeVentaNueva;
            porcentajeRenovacionAliado = configuracion.PorcentajeRenovacionAliado;
            porcentajeRenovacionNumerica = configuracion.PorcentajeRenovacionNumerica;
            diasIntervencionNumerica = configuracion.DiasIntervencionNumerica;
        }
    }

    private async Task CrearAsync()
    {
        if (guardando) return;
        if (tipoCuenta == "aliado" && !PorcentajeValido(porcentaje))
        {
            await AlertService.ShowWarningAsync("El porcentaje debe estar entre 0 y 100.", "Porcentaje inválido");
            return;
        }
        porcentaje = RedondearPorcentaje(porcentaje);
        guardando = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId);
            var resultado = await AliadoService.CrearCuentaAliadoAsync(actorId, nombre, email, password, porcentaje, tipoCuenta == "administrador");
            await MostrarResultadoAsync(resultado, "Cuenta creada");
            if (resultado.Success)
            {
                nombre = email = password = string.Empty;
                porcentaje = 0m;
                mostrarModalCrear = false;
                await CargarAsync();
            }
        }
        catch
        {
            await AlertService.ShowErrorAsync("No fue posible crear la cuenta. Inténtalo nuevamente.", "No se pudo crear");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarConfiguracionAsync()
    {
        if (guardandoConfiguracion) return;
        porcentajeVentaNueva = RedondearPorcentaje(porcentajeVentaNueva);
        porcentajeRenovacionAliado = RedondearPorcentaje(porcentajeRenovacionAliado);
        porcentajeRenovacionNumerica = RedondearPorcentaje(porcentajeRenovacionNumerica);
        if (!PorcentajeValido(porcentajeVentaNueva) || !PorcentajeValido(porcentajeRenovacionAliado) || !PorcentajeValido(porcentajeRenovacionNumerica))
        {
            await AlertService.ShowWarningAsync("Los porcentajes deben estar entre 0 y 100.", "Porcentaje inválido");
            return;
        }
        guardandoConfiguracion = true;
        try
        {
            var resultado = await AliadoService.ActualizarConfiguracionPortalAsync(actorId, porcentajeVentaNueva, porcentajeRenovacionAliado, porcentajeRenovacionNumerica, diasIntervencionNumerica);
            await MostrarResultadoAsync(resultado, "Regla guardada");
            if (resultado.Success) await CargarConfiguracionAsync();
        }
        catch
        {
            await AlertService.ShowErrorAsync("No fue posible guardar la regla. Inténtalo nuevamente.", "No se pudo guardar");
        }
        finally
        {
            guardandoConfiguracion = false;
        }
    }

    private async Task ActualizarPorcentajeAsync(AliadoAdminRow aliado, ChangeEventArgs valor)
    {
        if (!TryParsePorcentaje(valor.Value?.ToString(), out var porcentaje))
        {
            await AlertService.ShowWarningAsync("El porcentaje debe ser un número entre 0 y 100.", "Porcentaje inválido");
            return;
        }
        porcentaje = RedondearPorcentaje(porcentaje);
        var resultado = await AliadoService.ActualizarPorcentajeAliadoAsync(actorId, aliado.IdVendedor, porcentaje);
        await MostrarResultadoAsync(resultado, "Porcentaje actualizado");
        if (resultado.Success) await CargarAsync();
    }

    private async Task CambiarEstadoAsync(AliadoAdminRow aliado)
    {
        if (guardandoEstado)
            return;

        var activo = !(aliado.Activo && aliado.UsuarioActivo);
        var accion = activo ? "activar" : "desactivar";
        if (!await AlertService.ConfirmAsync($"¿Deseas {accion} el canal de {aliado.Nombre}?", $"Confirmar {accion}", $"Sí, {accion}")) return;

        guardandoEstado = true;
        try
        {
            var resultado = await AliadoService.ActualizarEstadoAliadoAsync(actorId, aliado.IdVendedor, activo);
            await MostrarResultadoAsync(resultado, activo ? "Canal activado" : "Canal desactivado");
            if (resultado.Success) await CargarAsync();
        }
        catch
        {
            await AlertService.ShowErrorAsync("No fue posible cambiar el estado del canal. Inténtalo nuevamente.", "No se pudo actualizar");
        }
        finally
        {
            guardandoEstado = false;
        }
    }

    private async Task MostrarResultadoAsync((bool Success, string Message) resultado, string tituloExito)
    {
        mensaje = resultado.Message;
        if (resultado.Success)
            await AlertService.ShowSuccessAsync(resultado.Message, tituloExito);
        else
            await AlertService.ShowErrorAsync(resultado.Message, "No se pudo completar");
    }

    private static bool PorcentajeValido(decimal valor) => valor is >= 0 and <= 100;

    private static decimal RedondearPorcentaje(decimal valor) => decimal.Round(valor, 2, MidpointRounding.AwayFromZero);

    private static bool TryParsePorcentaje(string? valor, out decimal porcentaje)
    {
        return decimal.TryParse(valor, NumberStyles.Number, CultureInfo.InvariantCulture, out porcentaje) ||
               decimal.TryParse(valor, NumberStyles.Number, CultureInfo.CurrentCulture, out porcentaje);
    }
}
