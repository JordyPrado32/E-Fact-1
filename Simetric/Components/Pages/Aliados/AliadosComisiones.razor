@page "/aliados/comisiones"

<PageTitle>Comisiones | Portal de Aliados</PageTitle>

<div class="ally-page">
    <div class="ally-page-intro"><div><span class="ally-eyebrow">TRANSPARENCIA DE MOVIMIENTOS</span><h2>Comisiones</h2><p>Historial de comisiones calculadas sobre valores netos efectivamente cobrados.</p></div><select class="ally-select" @bind="filtroEstado"><option value="">Todos los estados</option><option>Generada</option><option>Aprobada</option><option>Pagada</option></select></div>
    @if (modelo is null) { <div class="ally-empty">No se pudo cargar el historial de comisiones.</div> }
    else
    {
        <div class="ally-kpis"><div class="ally-kpi"><span>Generadas</span><strong>$ @modelo.Generadas.ToString("N2")</strong><small>Incluye aprobadas y pagadas</small></div><div class="ally-kpi warning"><span>Pendientes de aprobación</span><strong>$ @modelo.PendientesAprobacion.ToString("N2")</strong><small>Revisión interna</small></div><div class="ally-kpi"><span>Aprobadas</span><strong>$ @modelo.Aprobadas.ToString("N2")</strong><small>Listas para pago</small></div><div class="ally-kpi"><span>Pagadas</span><strong>$ @modelo.Pagadas.ToString("N2")</strong><small>Confirmadas por Numérica</small></div></div>
        <section class="ally-panel"><div class="ally-panel-heading"><h3>Movimientos <small class="ally-muted-count">@MovimientosFiltrados.Count()</small></h3><span class="ally-readonly">Solo consulta</span></div>@if (!MovimientosFiltrados.Any()) { <div class="ally-empty">No hay comisiones para este estado.</div> } else { <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Fecha</th><th>Cliente / producto</th><th>Tipo</th><th>Base sin IVA</th><th>Comisión</th><th>Estado</th><th>Liquidación</th></tr></thead><tbody>@foreach (var item in MovimientosFiltrados) { <tr @key="item.IdComision"><td>@item.FechaGeneracion.ToString("dd/MM/yyyy")</td><td><strong>@item.Cliente</strong><br /><small>@item.Producto</small></td><td>@item.Tipo</td><td>$ @item.BaseComisionable.ToString("N2")</td><td>$ @item.ValorComision.ToString("N2")<br /><small>@item.Porcentaje.ToString("0.##")%</small></td><td><span class="ally-badge @(item.Estado == "Pagada" ? "success" : item.Estado == "Aprobada" ? "approved" : "warning")">@item.Estado</span></td><td>@(item.PeriodoLiquidacion ?? "-")<br /><small>@(item.ReferenciaPago ?? "Sin pago")</small></td></tr>}</tbody></table></div>}</section>
    }
</div>

@code {
    private AliadoComisionesDto? modelo;
    private string filtroEstado = string.Empty;
    private IEnumerable<AliadoComisionMovimientoDto> MovimientosFiltrados =>
        modelo?.Movimientos.Where(x => string.IsNullOrWhiteSpace(filtroEstado) || x.Estado == filtroEstado)
        ?? Enumerable.Empty<AliadoComisionMovimientoDto>();
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
            modelo = await AliadoService.ObtenerComisionesAsync(id);
    }
}
