@page "/aliados/clientes"
@page "/aliados/clientes/{Id:int}"

<PageTitle>Mis clientes | Portal de Aliados</PageTitle>

@if (cargando)
{
    <div class="ally-empty">Cargando clientes...</div>
}
else if (Id.HasValue && detalle is null)
{
    <div class="ally-page">
        <NavLink class="ally-back-link" href="/aliados/clientes"><i class="ri-arrow-left-line"></i> Volver a mis clientes</NavLink>
        <div class="ally-empty">No se encontró el cliente solicitado.</div>
    </div>
}
else if (detalle is not null)
{
    <div class="ally-page">
        <NavLink class="ally-back-link" href="/aliados/clientes"><i class="ri-arrow-left-line"></i> Volver a mis clientes</NavLink>
        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">DETALLE DE CLIENTE</span><h2>@detalle.Nombre</h2></div><span class="ally-badge">@detalle.Identificacion</span></div>
            <div class="ally-detail-grid"><div><span>Correo</span><strong>@(detalle.Email ?? "No registrado")</strong></div><div><span>Teléfono</span><strong>@(detalle.Telefono ?? "No registrado")</strong></div><div><span>Dirección</span><strong>@(detalle.Direccion ?? "No registrada")</strong></div></div>
            <h3 class="ally-section-title">Productos contratados</h3>
            <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Producto / plan</th><th>Compra</th><th>Vencimiento</th><th>Estado</th><th>Valor</th></tr></thead><tbody>@foreach (var p in detalle.Productos) { <tr @key="p"><td>@p.Producto<br /><small>@p.Plan</small></td><td>@p.FechaCompra.ToString("dd/MM/yyyy")</td><td>@(p.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</td><td><span class="ally-badge success">@(p.Estado ?? "Activo")</span></td><td>$ @p.Valor.ToString("N2")</td></tr>}</tbody></table></div>
        </section>
    </div>
}
else
{
    <div class="ally-page">
        <div class="ally-page-intro"><div><span class="ally-eyebrow">CLIENTES ATRIBUIDOS A TU CANAL</span><h2>Mis clientes</h2><p>Consulta la información básica y los productos vigentes. La atribución solo puede modificarla Numérica.</p></div><div style="display:flex;gap:8px"><div class="ally-search"><i class="ri-search-line"></i><input @bind="busqueda" @bind:event="oninput" @bind:after="ReiniciarPagina" placeholder="Buscar por nombre, RUC o correo" /></div><button class="ally-button muted" type="button" @onclick="ExportarAsync" disabled="@(!clientesFiltrados.Any())">Exportar CSV</button></div></div>
        <section class="ally-panel"><div class="ally-panel-heading"><h3>@clientesFiltrados.Count cliente(s)</h3><span class="ally-readonly">Solo lectura</span></div>
            @if (clientesFiltrados.Count == 0) { <div class="ally-empty">No hay clientes atribuidos a tu canal.</div> }
            else { <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Cliente / identificación</th><th>Producto</th><th>Compra</th><th>Vencimiento</th><th></th></tr></thead><tbody>@foreach (var cliente in ClientesPaginados) { <tr @key="cliente.IdCliente"><td><strong>@cliente.Nombre</strong><br /><small>@(cliente.Identificacion ?? "Sin identificación") · @(cliente.Email ?? "Sin correo")</small></td><td>@(cliente.Producto ?? "Sin compras")</td><td>@(cliente.FechaCompra?.ToString("dd/MM/yyyy") ?? "-")</td><td>@(cliente.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</td><td><NavLink class="ally-table-action" href="@($"/aliados/clientes/{cliente.IdCliente}")">Ver detalle</NavLink></td></tr>}</tbody></table></div><div style="display:flex;align-items:center;gap:10px;margin-top:12px"><button class="ally-table-action" type="button" @onclick="() => CambiarPagina(-1)" disabled="@(pagina <= 1)">Anterior</button><span>Página @pagina de @TotalPaginas</span><button class="ally-table-action" type="button" @onclick="() => CambiarPagina(1)" disabled="@(pagina >= TotalPaginas)">Siguiente</button></div> }
        </section>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    private string busqueda = string.Empty;
    private List<AliadoClienteDto> clientes = new();
    private AliadoClienteDetalleDto? detalle;
    private bool cargando = true;
    private List<AliadoClienteDto> clientesFiltrados => clientes.Where(x => string.IsNullOrWhiteSpace(busqueda) || $"{x.Nombre} {x.Identificacion} {x.Email}".Contains(busqueda, StringComparison.OrdinalIgnoreCase)).ToList();
    private IEnumerable<AliadoClienteDto> ClientesPaginados => clientesFiltrados.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina);
    private int pagina = 1;
    private const int TamanoPagina = 20;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(clientesFiltrados.Count / (double)TamanoPagina));

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private void ReiniciarPagina() => pagina = 1;
    private void CambiarPagina(int delta) => pagina = Math.Clamp(pagina + delta, 1, TotalPaginas);

    private async Task ExportarAsync()
    {
        var csv = "Nombre,Identificacion,Email,Telefono,Producto,FechaCompra,FechaVencimiento,Estado\n" + string.Join("\n", clientesFiltrados.Select(x => string.Join(",", Csv(x.Nombre), Csv(x.Identificacion), Csv(x.Email), Csv(x.Telefono), Csv(x.Producto), Csv(x.FechaCompra?.ToString("yyyy-MM-dd")), Csv(x.FechaVencimiento?.ToString("yyyy-MM-dd")), Csv(x.Estado))));
        await using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv)).ToArray());
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", "clientes-aliado.csv", reference, "text/csv;charset=utf-8");
    }
    private static string Csv(string? value) => "\"" + (value ?? string.Empty).Replace("\"", "\"\"") + "\"";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        detalle = null;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
        {
            cargando = false;
            return;
        }
        if (Id.HasValue)
            detalle = await AliadoService.ObtenerClienteAsync(id, Id.Value);
        else
            clientes = (await AliadoService.ObtenerClientesAsync(id)).ToList();
        pagina = 1;
        cargando = false;
    }
}
