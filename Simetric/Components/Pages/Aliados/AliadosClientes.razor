@page "/aliados/clientes"
@page "/aliados/clientes/{Id:int}"
@using MiniExcelLibs
@using System.ComponentModel.DataAnnotations
@implements IAsyncDisposable
@inject IWebHostEnvironment Env

<PageTitle>Mis clientes | Portal de Aliados</PageTitle>

@if (cargando)
{
    <AllyLoadingState Title="Cargando tus clientes" Description="Preparando la información de tus clientes." />
}
else if (Id.HasValue && detalle is null)
{
    <div class="ally-page">
        <NavLink class="ally-back-link" href="/aliados/clientes"><i class="ri-arrow-left-line"></i> Volver a mis clientes</NavLink>
        <div class="ally-empty">No se encontró el cliente solicitado.</div>
    </div>
}
else if (detalle is not null)
{
    <div class="ally-page">
        <NavLink class="ally-back-link" href="/aliados/clientes"><i class="ri-arrow-left-line"></i> Volver a mis clientes</NavLink>
        <section class="ally-panel">
            <div class="ally-panel-heading"><div><span class="ally-label">DETALLE DE CLIENTE</span><h2>@detalle.Nombre</h2></div><span class="ally-badge">@detalle.Identificacion</span></div>
            <div class="ally-detail-grid"><div><span>Correo</span><strong>@(detalle.Email ?? "No registrado")</strong></div><div><span>Teléfono</span><strong>@(detalle.Telefono ?? "No registrado")</strong></div><div><span>Dirección</span><strong>@(detalle.Direccion ?? "No registrada")</strong></div></div>
            @if (!string.IsNullOrWhiteSpace(detalle.Email) || !string.IsNullOrWhiteSpace(detalle.Telefono))
            {
                <div class="ally-contact-actions">
                    @if (!string.IsNullOrWhiteSpace(detalle.Email)) { <a class="ally-button muted" href="mailto:@detalle.Email"><i class="ri-mail-line"></i> Enviar correo</a> }
                    @if (!string.IsNullOrWhiteSpace(detalle.Telefono)) { <a class="ally-button light" href="tel:@detalle.Telefono"><i class="ri-phone-line"></i> Llamar cliente</a> }
                </div>
            }
            <h3 class="ally-section-title">Productos adquiridos</h3>
            @if (detalle.Productos.Count == 0)
            {
                <div class="ally-empty">Este cliente todavía no registra productos adquiridos.</div>
            }
            else
            {
                <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Producto / plan</th><th>Servicio</th><th>Compra</th><th>Vencimiento</th><th>Estado</th><th>Valor</th></tr></thead><tbody>@foreach (var p in detalle.Productos) { <tr @key="p"><td>@p.Producto<br /><small>@p.Plan</small></td><td><span class="ally-badge @ServicioCss(p.Servicio)">@p.Servicio</span></td><td>@p.FechaCompra.ToString("dd/MM/yyyy")</td><td>@(p.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</td><td><span class="ally-badge @EstadoCss(p.Estado)">@(p.Estado ?? "Activo")</span></td><td>$ @p.Valor.ToString("N2")</td></tr>}</tbody></table></div>
            }
        </section>
    </div>
}
else
{
    <div class="ally-page ally-clients-page">
        <section class="clients-kpis" aria-label="Resumen de clientes">
            <article class="clients-kpi rose"><span><i class="ri-user-heart-line"></i></span><div><small>Clientes activos</small><strong>@ClientesActivos</strong><em>Clientes únicos</em></div></article>
            <article class="clients-kpi purple"><span><i class="ri-shopping-cart-2-line"></i></span><div><small>Compras realizadas</small><strong>@ComprasRealizadas</strong><em>Adquisiciones registradas</em></div></article>
            <article class="clients-kpi blue"><span><i class="ri-file-list-3-line"></i></span><div><small>Compras E-FACT</small><strong>@ComprasEFact</strong><em>Facturación electrónica</em></div></article>
            <article class="clients-kpi green"><span><i class="ri-quill-pen-line"></i></span><div><small>Compras E-RÚBRICA</small><strong>@ComprasERubrica</strong><em>Firma electrónica</em></div></article>
            <article class="clients-kpi amber"><span><i class="ri-calendar-event-line"></i></span><div><small>Próximos a vencer</small><strong>@ClientesProximosVencer</strong><em>En los siguientes 30 días</em></div></article>
        </section>

        <section class="clients-insights">
            <article class="ally-panel clients-chart-card" aria-labelledby="clients-chart-title">
                <div class="clients-chart-heading"><div><span class="ally-eyebrow">COMPORTAMIENTO DE COMPRA</span><h3 id="clients-chart-title">Clientes con más compras</h3><p>Compara la cantidad de adquisiciones registradas por cliente.</p></div></div>
                <div class="clients-chart-container"><canvas id="ally-clients-purchases-chart"></canvas></div>
            </article>
            <aside class="ally-panel clients-ranking" aria-label="Distribución de compras por servicio">
                <div class="clients-ranking-heading"><i class="ri-pie-chart-2-line"></i><div><span class="ally-eyebrow">SERVICIOS</span><h3>Distribución de compras</h3></div></div>
                <div class="clients-service-summary efact"><span><img src="/images/LogoNumerica.svg" alt="E-FACT" /></span><div><strong>E-FACT</strong><small>Facturación electrónica</small><span class="clients-ranking-bar"><i style="width:@PorcentajeServicio(ComprasEFact)%"></i></span></div><b>@ComprasEFact</b></div>
                <div class="clients-service-summary erubrica"><span><img src="/images/services/n-erubrica.png" alt="E-RÚBRICA" /></span><div><strong>E-RÚBRICA</strong><small>Firma electrónica</small><span class="clients-ranking-bar"><i style="width:@PorcentajeServicio(ComprasERubrica)%"></i></span></div><b>@ComprasERubrica</b></div>
                <div class="clients-service-total"><span>Total registrado</span><strong>@ComprasRealizadas compras</strong></div>
            </aside>
        </section>

        <section class="ally-panel clients-list-card">
                <div class="clients-list-heading">
                <div class="clients-list-title"><span class="clients-list-icon"><i class="ri-user-line"></i></span><div><span class="ally-eyebrow">LISTADO DE CLIENTES</span><h3>@(esAdministrador ? "Todos los clientes asociados" : "Clientes atribuidos a tu canal")</h3></div></div>
                    <div class="clients-toolbar" aria-label="Herramientas de clientes"><label class="clients-search"><i class="ri-search-line"></i><input @bind="busqueda" @bind:event="oninput" @bind:after="ActualizarBusqueda" list="clientes-sugerencias" placeholder="Buscar por nombre, RUC o contacto..." /></label><datalist id="clientes-sugerencias">@foreach (var sugerencia in clientes.Take(8)) { <option value="@sugerencia.Nombre">@sugerencia.Identificacion</option> }</datalist><button class="clients-action-card clients-create-account" type="button" @onclick="AbrirCrearCuentaModal"><span class="clients-action-icon"><i class="ri-user-add-line"></i></span><span><strong>Crear cliente</strong><small>Nuevo cliente</small></span></button><button class="clients-action-card ally-excel-button" type="button" @onclick="ExportarExcelAsync" disabled="@(!clientesFiltrados.Any())"><span class="clients-action-icon"><i class="ri-download-2-line"></i></span><span><strong>Exportar clientes</strong><small>Archivo Excel</small></span></button></div>
            </div>
            @if (ClientesAgrupados.Count == 0) { <div class="ally-empty">No hay clientes atribuidos a tu canal.</div> }
            else
            {
                <div class="ally-table-wrap">
                    <table class="ally-table clients-table">
                        <thead><tr><th>Cliente</th>@if (esAdministrador) { <th>Aliado asociado</th> }<th>Contacto</th><th>Identificación</th><th>Última compra</th><th>Total compras</th><th>Vencimiento</th><th>Acción</th></tr></thead>
                        <tbody>
                            @foreach (var cliente in ClientesPaginados)
                            {
                                <tr @key="cliente.IdCliente">
                                    <td><div class="clients-name-cell"><span class="clients-avatar">@Iniciales(cliente.Nombre)</span><div><strong>@cliente.Nombre</strong></div></div></td>
                                    @if (esAdministrador) { <td><span class="clients-ally-name">@(cliente.Aliado ?? "Sin aliado")</span></td> }
                                    <td><span class="clients-contact"><i class="ri-phone-line"></i> @(cliente.Telefono ?? "Sin teléfono")</span><small class="clients-email"><i class="ri-mail-line"></i> @(cliente.Email ?? "Sin correo")</small></td>
                                    <td><span class="clients-id">@(cliente.Identificacion ?? "Sin identificación")</span></td>
                                    <td><span class="clients-date"><i class="ri-calendar-line"></i>@(cliente.UltimaCompra?.ToString("dd/MM/yyyy") ?? "-")</span></td>
                                    <td><span class="clients-purchases-count">@cliente.TotalCompras</span></td>
                                    <td>@(cliente.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td><button class="clients-view-action" type="button" @onclick="() => AbrirDetalleModalAsync(cliente.IdCliente)" disabled="@(clienteDetalleCargando == cliente.IdCliente)" title="Ver detalle" aria-label="@($"Ver detalle de {cliente.Nombre}")"><i class="@(clienteDetalleCargando == cliente.IdCliente ? "ri-loader-4-line clients-spin" : "ri-eye-line")"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="clients-table-footer"><span>Mostrando @((pagina - 1) * tamanoPagina + 1) a @Math.Min(pagina * tamanoPagina, ClientesAgrupados.Count) de @ClientesAgrupados.Count clientes</span><div class="ally-pagination"><button class="ally-table-action" type="button" @onclick="() => CambiarPagina(-1)" disabled="@(pagina <= 1)">Anterior</button><strong>@pagina</strong><button class="ally-table-action" type="button" @onclick="() => CambiarPagina(1)" disabled="@(pagina >= TotalPaginas)">Siguiente</button></div></div>
            }
        </section>

        @if (detalleModal is not null)
        {
            <div class="ally-modal-backdrop clients-detail-backdrop" role="presentation" @onclick="CerrarDetalleModal">
                <section class="ally-modal clients-detail-modal" role="dialog" aria-modal="true" aria-labelledby="clienteDetalleModalTitulo" @onclick:stopPropagation="true">
                    <header class="clients-detail-header">
                        <div>
                            <span class="ally-label">DETALLE DE CLIENTE</span>
                            <h2 id="clienteDetalleModalTitulo">@detalleModal.Nombre</h2>
                            <span class="clients-detail-id">@(detalleModal.Identificacion ?? "Sin identificación")</span>
                        </div>
                        <button class="clients-modal-close" type="button" @onclick="CerrarDetalleModal" aria-label="Cerrar detalle"><i class="ri-close-line"></i></button>
                    </header>

                    <div class="clients-detail-grid">
                        <article class="clients-detail-email"><span><i class="ri-mail-line"></i> Correo</span><strong title="@(detalleModal.Email ?? "No registrado")">@(detalleModal.Email ?? "No registrado")</strong></article>
                        <article><span><i class="ri-phone-line"></i> Teléfono</span><strong>@(detalleModal.Telefono ?? "No registrado")</strong></article>
                        <article class="clients-detail-address"><span><i class="ri-map-pin-line"></i> Dirección</span><strong>@(detalleModal.Direccion ?? "No registrada")</strong></article>
                    </div>

                    <div class="clients-detail-section-title"><div><span class="ally-label">SERVICIOS</span><h3>Productos adquiridos</h3></div><span class="clients-count">@detalleModal.Productos.Count registros</span></div>
                    @if (detalleModal.Productos.Count == 0)
                    {
                        <div class="ally-empty">Este cliente todavía no registra productos adquiridos.</div>
                    }
                    else
                    {
                        <div class="ally-table-wrap clients-detail-table-wrap">
                            <table class="ally-table clients-detail-table">
                                <thead><tr><th>Producto / plan</th><th>Servicio</th><th>Compra</th><th>Vencimiento</th><th>Estado</th><th>Valor</th></tr></thead>
                                <tbody>
                                    @foreach (var producto in detalleModal.Productos)
                                    {
                                        <tr @key="producto"><td><strong>@producto.Producto</strong><small>@producto.Plan</small></td><td><span class="ally-badge @ServicioCss(producto.Servicio)">@producto.Servicio</span></td><td>@producto.FechaCompra.ToString("dd/MM/yyyy")</td><td>@(producto.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</td><td><span class="ally-badge @EstadoCss(producto.Estado)">@(producto.Estado ?? "Activo")</span></td><td><strong>$ @producto.Valor.ToString("N2")</strong></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <footer class="clients-detail-footer">
                        @if (!string.IsNullOrWhiteSpace(detalleModal.Email)) { <a class="clients-contact-button secondary" href="mailto:@detalleModal.Email"><i class="ri-mail-line"></i> Enviar correo</a> }
                        @if (!string.IsNullOrWhiteSpace(detalleModal.Telefono)) { <a class="clients-contact-button secondary" href="tel:@detalleModal.Telefono"><i class="ri-phone-line"></i> Llamar cliente</a> }
                        <button class="clients-contact-button primary" type="button" @onclick="CerrarDetalleModal">Cerrar</button>
                    </footer>
                </section>
            </div>
        }
    </div>
}

@if (mostrarCrearCuentaModal)
{
    <div class="ally-modal-backdrop clients-create-backdrop" @onclick="CerrarCrearCuentaModal">
        <section class="ally-modal clients-create-modal" role="dialog" aria-modal="true" aria-labelledby="crear-cliente-title" @onclick:stopPropagation="true">
            <header class="clients-detail-header clients-create-header">
                <div><span class="ally-label">NUEVA CUENTA</span><h2 id="crear-cliente-title">Crear cuenta de cliente</h2><span class="clients-detail-id">@(esAdministrador ? "Selecciona el aliado que recibirá las comisiones." : "El cliente quedará asociado a tu canal.")</span></div>
                <button class="clients-modal-close" type="button" @onclick="CerrarCrearCuentaModal" aria-label="Cerrar formulario"><i class="ri-close-line"></i></button>
            </header>
            <EditForm Model="cuentaCliente" OnValidSubmit="CrearCuentaClienteAsync" FormName="crear-cuenta-cliente-form">
                <DataAnnotationsValidator />
                <div class="clients-create-body">
                    <ValidationSummary class="clients-validation-summary" />
                    <div class="clients-create-grid">
                        @if (esAdministrador)
                        {
                            <label class="clients-create-wide">Aliado asociado
                                <input class="clients-ally-search" @bind="busquedaAliado" @bind:event="oninput" list="aliados-sugerencias" placeholder="Escribe para buscar un aliado..." />
                                <datalist id="aliados-sugerencias">@foreach (var aliado in AliadosFiltrados.Take(8)) { <option value="@aliado.Nombre">@aliado.CodigoReferencia</option> }</datalist>
                                <select @bind="aliadoSeleccionadoId">
                                    <option value="">Selecciona el aliado asociado</option>
                                    @foreach (var aliado in AliadosFiltrados)
                                    {
                                        <option value="@aliado.IdVendedor">@aliado.Nombre</option>
                                    }
                                </select>
                            </label>
                        }
                        <div class="clients-profile-picker clients-create-wide"><div class="clients-profile-preview">@if (!string.IsNullOrWhiteSpace(cuentaCliente.AvatarUrl)) { <img src="@ResolverAvatar(cuentaCliente.AvatarUrl)" alt="Foto de perfil seleccionada" /> } else { <i class="ri-user-3-line"></i> }</div><div><strong>Foto de perfil</strong><small>Selecciona un avatar para la cuenta del cliente.</small><button type="button" class="clients-avatar-toggle" @onclick="() => mostrarSelectorAvatar = !mostrarSelectorAvatar"><i class="ri-image-add-line"></i> @(mostrarSelectorAvatar ? "Ocultar avatares" : "Seleccionar foto")</button></div></div>
                        @if (mostrarSelectorAvatar)
                        {
                            <div class="clients-avatar-options clients-create-wide">@foreach (var avatar in avatarFiles) { var url = $"images/Avatars/{avatar}"; <button type="button" class="clients-avatar-option @(string.Equals(ResolverAvatar(cuentaCliente.AvatarUrl), ResolverAvatar(url), StringComparison.OrdinalIgnoreCase) ? "selected" : string.Empty)" @onclick="() => SeleccionarAvatar(url)" title="Seleccionar avatar"><img src="@ResolverAvatar(url)" alt="Avatar disponible" /></button> }</div>
                        }
                        <label>Tipo de cliente<InputSelect @bind-Value="cuentaCliente.TipoCliente" @bind-Value:after="CambiarTipoCliente"><option value="1">Persona natural</option><option value="2">Empresa</option></InputSelect></label>
                        <label>Tipo de documento<InputSelect @bind-Value="cuentaCliente.TipoDocumento" @bind-Value:after="NormalizarIdentificacionCuenta"><option value="CEDULA" disabled="@(cuentaCliente.TipoCliente == 2)">Cédula</option><option value="RUC">RUC</option><option value="EXTERIOR">Identificación del exterior</option><option value="PASAPORTE">Pasaporte</option></InputSelect></label>
                        <label>Identificación<input @bind="IdentificacionCuentaInput" @bind:event="oninput" maxlength="20" inputmode="numeric" placeholder="Ingresa el número de identificación" /><ValidationMessage For="@(() => cuentaCliente.Identificacion)" /></label>
                        @if (cuentaCliente.TipoCliente == 2)
                        {
                            <label class="clients-create-wide">Nombre comercial<InputText @bind-Value="cuentaCliente.NombreComercial" maxlength="150" placeholder="Ej. Comercial La Esperanza" /><ValidationMessage For="@(() => cuentaCliente.NombreComercial)" /></label>
                        }
                        else
                        {
                            <label>Nombres<InputText @bind-Value="cuentaCliente.Nombres" autocomplete="given-name" placeholder="Ingresa los nombres" /><ValidationMessage For="@(() => cuentaCliente.Nombres)" /></label>
                            <label>Apellidos<InputText @bind-Value="cuentaCliente.Apellidos" autocomplete="family-name" placeholder="Ingresa los apellidos" /><ValidationMessage For="@(() => cuentaCliente.Apellidos)" /></label>
                        }
                        <label>Celular<input @bind="CelularCuentaInput" @bind:event="oninput" inputmode="tel" autocomplete="tel" placeholder="Ej. 0991234567" /><ValidationMessage For="@(() => cuentaCliente.Celular)" /></label>
                        <label class="clients-create-wide">Correo electrónico<InputText @bind-Value="cuentaCliente.Email" type="email" autocomplete="email" placeholder="cliente@correo.com" /><ValidationMessage For="@(() => cuentaCliente.Email)" /></label>
                        <label class="clients-create-wide">Dirección<InputText @bind-Value="cuentaCliente.Direccion" maxlength="100" placeholder="Calle, número y referencia" /><ValidationMessage For="@(() => cuentaCliente.Direccion)" /></label>
                        <label>Clave inicial<InputText @bind-Value="cuentaCliente.Password" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" /><ValidationMessage For="@(() => cuentaCliente.Password)" /></label>
                        <label>Confirmar clave<InputText @bind-Value="cuentaCliente.ConfirmarPassword" type="password" autocomplete="new-password" placeholder="Repite la clave" /><ValidationMessage For="@(() => cuentaCliente.ConfirmarPassword)" /></label>
                    </div>
                    <div class="clients-create-note"><i class="ri-information-line"></i><span>La clave inicial será temporal. El cliente deberá cambiarla obligatoriamente en su primer ingreso.</span></div>
                    @if (!string.IsNullOrWhiteSpace(errorCrearCuenta))
                    {
                        <div class="clients-create-error">@errorCrearCuenta</div>
                    }
                </div>
                <footer class="clients-detail-footer"><button class="clients-contact-button secondary" type="button" @onclick="CerrarCrearCuentaModal">Cancelar</button><button class="clients-contact-button primary" type="submit" disabled="@creandoCuenta">@(creandoCuenta ? "Creando..." : "Crear cliente")</button></footer>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    private string busqueda = string.Empty;
    private List<AliadoClienteDto> clientes = new();
    private AliadoClienteDetalleDto? detalle;
    private AliadoClienteDetalleDto? detalleModal;
    private int? clienteDetalleCargando;
    private int usuarioAliadoId;
    private bool cargando = true;
    private bool graficoPendiente;
    private bool mostrarCrearCuentaModal;
    private bool creandoCuenta;
    private bool esAdministrador;
    private string? errorCrearCuenta;
    private ClienteCuentaForm cuentaCliente = new();
    private List<AliadoAdminRow> aliadosDisponibles = new();
    private string busquedaAliado = string.Empty;
    private int? aliadoSeleccionadoId;
    private List<string> avatarFiles = new();
    private bool mostrarSelectorAvatar;
    private IEnumerable<AliadoAdminRow> AliadosFiltrados => aliadosDisponibles.Where(x => x.Activo && x.UsuarioActivo &&
        (string.IsNullOrWhiteSpace(busquedaAliado) || x.Nombre.Contains(busquedaAliado, StringComparison.OrdinalIgnoreCase)));
    private List<AliadoClienteDto> clientesFiltrados => clientes.Where(x =>
        string.IsNullOrWhiteSpace(busqueda) || $"{x.Nombre} {x.Identificacion} {x.Email}".Contains(busqueda, StringComparison.OrdinalIgnoreCase)).ToList();
    private List<ClienteListadoResumen> ClientesAgrupados => clientesFiltrados
        .GroupBy(ClienteClave)
        .Select(g =>
        {
            var ultima = g.OrderByDescending(x => x.FechaCompra).First();
            var contacto = g.FirstOrDefault(x => EsCorreoDisponible(x.Email)) ?? ultima;
            var telefono = g.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.Telefono))?.Telefono;
            var aliado = g.Select(x => x.Aliado).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
            return new ClienteListadoResumen(ultima.IdCliente, ultima.Nombre, aliado, ultima.Identificacion, EsCorreoDisponible(contacto.Email) ? contacto.Email : null, telefono, ultima.FechaCompra, g.Max(x => x.TotalCompras), ultima.FechaVencimiento);
        })
        .OrderBy(x => x.Nombre)
        .ToList();
    private IEnumerable<ClienteListadoResumen> ClientesPaginados => ClientesAgrupados.Skip((pagina - 1) * tamanoPagina).Take(tamanoPagina);
    private int pagina = 1;
    private int tamanoPagina = 10;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(ClientesAgrupados.Count / (double)tamanoPagina));
    private IEnumerable<IGrouping<string, AliadoClienteDto>> ClientesUnicos => clientesFiltrados.GroupBy(ClienteClave);
    private int ClientesActivos => clientes.Where(x => !string.Equals(x.Estado, "Vencido", StringComparison.OrdinalIgnoreCase)).GroupBy(ClienteClave).Count();
    private int ComprasRealizadas => ClientesUnicos.Sum(g => g.Max(x => x.TotalCompras));
    private int ComprasEFact => ClientesUnicos.Sum(g => g.Max(x => x.ComprasEFact));
    private int ComprasERubrica => ClientesUnicos.Sum(g => g.Max(x => x.ComprasERubrica));
    private int ClientesProximosVencer => clientes.Where(x => x.FechaVencimiento?.Date >= DateTime.Today && x.FechaVencimiento?.Date <= DateTime.Today.AddDays(30)).GroupBy(ClienteClave).Count();
    private List<ClienteComprasResumen> ComprasPorCliente => clientesFiltrados
        .GroupBy(ClienteClave)
        .Select(g => new ClienteComprasResumen(g.First().Nombre, g.Max(x => x.TotalCompras)))
        .OrderByDescending(x => x.Compras)
        .ThenBy(x => x.Nombre)
        .Take(8)
        .ToList();
    private static string ClienteClave(AliadoClienteDto cliente) => !string.IsNullOrWhiteSpace(cliente.Identificacion)
        ? $"identificacion:{cliente.Identificacion.Trim()}"
        : $"cliente:{cliente.IdCliente}";
    private static bool EsCorreoDisponible(string? correo) => !string.IsNullOrWhiteSpace(correo) &&
        !correo.EndsWith("@deleted.local", StringComparison.OrdinalIgnoreCase);
    private int PorcentajeServicio(int cantidad) => ComprasRealizadas == 0 ? 0 : (int)Math.Round(cantidad * 100d / ComprasRealizadas);

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;

    private string IdentificacionCuentaInput
    {
        get => cuentaCliente.Identificacion;
        set => cuentaCliente.Identificacion = SanitizarIdentificacion(value, cuentaCliente.TipoDocumento);
    }

    private string CelularCuentaInput
    {
        get => cuentaCliente.Celular;
        set => cuentaCliente.Celular = (value ?? string.Empty).Trim();
    }

    private void ActualizarBusqueda() { pagina = 1; graficoPendiente = true; }
    private void CambiarPagina(int delta) => pagina = Math.Clamp(pagina + delta, 1, TotalPaginas);
    private async Task AbrirDetalleModalAsync(int idCliente)
    {
        clienteDetalleCargando = idCliente;
        try
        {
            detalleModal = await AliadoService.ObtenerClienteAsync(usuarioAliadoId, idCliente);
            if (detalleModal is null)
                await AlertService.ShowWarningAsync("No se encontró la información del cliente.", "Detalle no disponible");
        }
        finally
        {
            clienteDetalleCargando = null;
        }
    }
    private void CerrarDetalleModal() => detalleModal = null;

    private async Task AbrirCrearCuentaModal()
    {
        cuentaCliente = new ClienteCuentaForm();
        errorCrearCuenta = null;
        busquedaAliado = string.Empty;
        aliadoSeleccionadoId = null;
        CargarAvatares();
        mostrarSelectorAvatar = false;
        if (esAdministrador && aliadosDisponibles.Count == 0)
            aliadosDisponibles = (await AliadoService.ListarAliadosAsync()).ToList();
        mostrarCrearCuentaModal = true;
    }

    private void CerrarCrearCuentaModal()
    {
        if (!creandoCuenta)
            mostrarCrearCuentaModal = false;
    }

    private void CambiarTipoCliente()
    {
        if (cuentaCliente.TipoCliente == 2)
        {
            cuentaCliente.Nombres = string.Empty;
            cuentaCliente.Apellidos = string.Empty;
            cuentaCliente.TipoDocumento = "RUC";
        }
        else
        {
            cuentaCliente.RazonSocial = string.Empty;
            cuentaCliente.TipoDocumento = "CEDULA";
        }
        NormalizarIdentificacionCuenta();
    }

    private void NormalizarIdentificacionCuenta()
    {
        cuentaCliente.Identificacion = SanitizarIdentificacion(cuentaCliente.Identificacion, cuentaCliente.TipoDocumento);
    }

    private async Task CrearCuentaClienteAsync()
    {
        if (creandoCuenta)
            return;

        creandoCuenta = true;
        errorCrearCuenta = null;
        try
        {
            if (esAdministrador && aliadoSeleccionadoId is not > 0)
            {
                errorCrearCuenta = "Selecciona el aliado al que se asociará el cliente.";
                return;
            }

            var registro = new AliadoClienteRegistroDto
            {
                Nombres = cuentaCliente.Nombres,
                Apellidos = cuentaCliente.Apellidos,
                RazonSocial = cuentaCliente.TipoCliente == 2 ? cuentaCliente.NombreComercial : cuentaCliente.RazonSocial,
                Email = cuentaCliente.Email,
                Direccion = cuentaCliente.Direccion,
                Celular = cuentaCliente.Celular,
                TipoDocumento = cuentaCliente.TipoDocumento,
                Identificacion = cuentaCliente.Identificacion,
                Password = cuentaCliente.Password,
                ConfirmarPassword = cuentaCliente.ConfirmarPassword,
                TipoCliente = cuentaCliente.TipoCliente,
                AvatarUrl = cuentaCliente.AvatarUrl,
                IdVendedorDestino = esAdministrador ? aliadoSeleccionadoId : null
            };
            var resultado = await AliadoService.CrearCuentaClienteAliadoAsync(usuarioAliadoId, registro);
            if (!resultado.Success)
            {
                errorCrearCuenta = resultado.Message;
                return;
            }

            mostrarCrearCuentaModal = false;
            await OnParametersSetAsync();
            await AlertService.ShowSuccessAsync(resultado.Message, "Cuenta creada");
        }
        finally
        {
            creandoCuenta = false;
        }
    }

    private static string SanitizarIdentificacion(string? valor, string tipoDocumento)
    {
        var raw = valor ?? string.Empty;
        var limpio = tipoDocumento is "PASAPORTE" or "EXTERIOR"
            ? new string(raw.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant()
            : new string(raw.Where(char.IsDigit).ToArray());
        return limpio.Length > 20 ? limpio[..20] : limpio;
    }

    private void CargarAvatares()
    {
        var ruta = Path.Combine(Env.WebRootPath, "images", "Avatars");
        avatarFiles = Directory.Exists(ruta)
            ? Directory.GetFiles(ruta).Select(Path.GetFileName).Where(x => x is not null && (x.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || x.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || x.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase))).OrderBy(x => x).ToList()!
            : new List<string>();
    }

    private void SeleccionarAvatar(string nombre) { cuentaCliente.AvatarUrl = $"images/Avatars/{nombre}"; mostrarSelectorAvatar = false; }
    private static string ResolverAvatar(string? ruta) => string.IsNullOrWhiteSpace(ruta) ? string.Empty : "/" + ruta.Trim().Replace('\\', '/').TrimStart('/');
    private async Task ExportarExcelAsync()
    {
        var data = clientesFiltrados.Select(x => new
        {
            Cliente = x.Nombre,
            Identificacion = x.Identificacion ?? string.Empty,
            Correo = EsCorreoDisponible(x.Email) ? x.Email : string.Empty,
            Telefono = x.Telefono ?? string.Empty,
            Producto = x.Producto ?? string.Empty,
            x.Servicio,
            FechaCompra = x.FechaCompra,
            FechaVencimiento = x.FechaVencimiento,
            Estado = x.Estado ?? "Activo"
        }).ToList();

        using var stream = new MemoryStream();
        stream.SaveAs(data);
        stream.Position = 0;
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            $"Clientes_Aliados_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
            reference,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        await AlertService.ShowSuccessAsync("El archivo Excel se descargó correctamente.", "Exportación lista");
    }

    private static string EstadoCss(string? estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "vencido" or "vencida" or "cancelado" or "cancelada" => "danger",
        "pendiente" or "por vencer" => "warning",
        _ => "success"
    };

    private static string ServicioCss(string servicio) => servicio == "E-RÚBRICA" ? "service-erubrica" : "service-efact";
    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        detalle = null;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
        {
            cargando = false;
            return;
        }
        usuarioAliadoId = id;
        var contexto = await AliadoService.ObtenerContextoAsync(id);
        esAdministrador = contexto?.EsAdministrador == true;
        if (Id.HasValue)
            detalle = await AliadoService.ObtenerClienteAsync(id, Id.Value);
        else
            clientes = (await AliadoService.ObtenerClientesAsync(id)).ToList();
        pagina = 1;
        graficoPendiente = !Id.HasValue;
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!graficoPendiente || cargando || Id.HasValue) return;
        graficoPendiente = false;
        var datos = ComprasPorCliente;
        await JS.InvokeVoidAsync("aliadosClientesChart.render", new { labels = datos.Select(x => x.Nombre), values = datos.Select(x => x.Compras) });
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("aliadosClientesChart.destroy"); } catch { }
    }

    private sealed record ClienteComprasResumen(string Nombre, int Compras);
    private sealed record ClienteListadoResumen(int IdCliente, string Nombre, string? Aliado, string? Identificacion, string? Email, string? Telefono, DateTime? UltimaCompra, int TotalCompras, DateTime? FechaVencimiento);

    private sealed class ClienteCuentaForm : IValidatableObject
    {
        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress(ErrorMessage = "Ingresa un correo válido")]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "La dirección es obligatoria")]
        [StringLength(100, MinimumLength = 5, ErrorMessage = "La dirección debe tener entre 5 y 100 caracteres")]
        public string Direccion { get; set; } = string.Empty;
        [Required(ErrorMessage = "El tipo de documento es obligatorio")]
        public string TipoDocumento { get; set; } = "CEDULA";
        [Required(ErrorMessage = "La identificación es obligatoria")]
        public string Identificacion { get; set; } = string.Empty;
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$", ErrorMessage = "La clave requiere 8 caracteres, mayúscula, minúscula, número y carácter especial")]
        public string Password { get; set; } = string.Empty;
        public string ConfirmarPassword { get; set; } = string.Empty;
        [Range(1, 2, ErrorMessage = "Selecciona un tipo de cliente")]
        public int TipoCliente { get; set; } = 1;
        public string Nombres { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public string RazonSocial { get; set; } = string.Empty;
        public string NombreComercial { get; set; } = string.Empty;
        public string? AvatarUrl { get; set; }
        public string Celular { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var registro = new AliadoClienteRegistroDto
            {
                Nombres = Nombres,
                Apellidos = Apellidos,
                RazonSocial = TipoCliente == 2 ? NombreComercial : RazonSocial,
                Email = Email,
                Direccion = Direccion,
                Celular = Celular,
                TipoDocumento = TipoDocumento,
                Identificacion = Identificacion,
                Password = Password,
                ConfirmarPassword = ConfirmarPassword,
                TipoCliente = TipoCliente
            };
            registro.Normalizar();
            var error = registro.Validar();
            if (error is not null)
                yield return new ValidationResult(error);
        }
    }
}
