@page "/aliados/facturas-liquidaciones"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Models
@using Simetric.Services
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Env
@inject SweetAlertService AlertService

<PageTitle>Facturas para pago | Portal de Aliados</PageTitle>

<div class="ally-page ally-invoice-page">
    <section class="ally-invoice-hero">
        <div class="ally-invoice-hero-copy"><span class="ally-eyebrow">PAGO DE LIQUIDACIONES</span><h2>Facturas para recibir tu pago</h2><p>Carga una factura por cada período disponible y mantén al día tus liquidaciones.</p><div class="ally-invoice-benefits"><span><i class="ri-flashlight-line"></i>Carga rápida<br />y segura</span><span><i class="ri-shield-check-line"></i>Control de<br />períodos</span><span><i class="ri-bar-chart-box-line"></i>Historial siempre<br />disponible</span></div></div>
        <div class="ally-invoice-hero-art" aria-hidden="true"><span class="hero-file"><i class="ri-file-text-line"></i></span><span class="hero-coin">$</span><span class="hero-check"><i class="ri-check-line"></i></span></div>
    </section>

    @if (cargando)
    {
        <AllyLoadingState Title="Cargando períodos" Description="Consultando tus liquidaciones pendientes." />
    }
    else
    {
        @if (pendientes.Count == 0)
        {
            <div class="ally-invoice-empty"><i class="ri-checkbox-circle-line"></i><h3>No tienes facturas pendientes</h3><p>Cuando cierre un nuevo período aparecerá aquí el valor exacto que debes facturar.</p></div>
        }
        else
        {
            <div class="ally-invoice-summary">
                <div class="is-pending"><span><i class="ri-file-list-3-line"></i></span><small>Períodos pendientes</small><strong>@pendientes.Count</strong></div>
                <div class="is-money"><span><i class="ri-money-dollar-circle-line"></i></span><small>Total pendiente</small><strong>$ @pendientes.Sum(x => x.Total).ToString("N2")</strong></div>
                <div class="is-loaded"><span><i class="ri-checkbox-circle-line"></i></span><small>Períodos cargados</small><strong>@pendientes.Count(x => !string.IsNullOrWhiteSpace(x.FacturaUrl))</strong></div>
                <div class="is-paid"><span><i class="ri-bar-chart-fill"></i></span><small>Total pagado</small><strong>$ @liquidaciones.Sum(x => x.Estado == "Pagada" ? x.Total : 0).ToString("N2")</strong></div>
            </div>

            var actual = PeriodoActual;
            <div class="ally-invoice-payment-grid @(actual is null ? "without-uploader" : null)">
                @if (actual is not null)
                {
                    <aside class="ally-invoice-uploader">
                        <header><i class="ri-file-upload-line"></i><div><strong>Cargar factura del período</strong><small>@EtiquetaPeriodo(actual.Periodo) · Selecciona el archivo PDF o XML.</small></div></header>
                        <label class="ally-invoice-upload"><i class="ri-upload-cloud-2-line"></i><strong>Arrastra tu factura aquí</strong><small>o haz clic para seleccionar<br />PDF · XML · Máx. 10 MB</small><InputFile aria-label="@($"Subir factura de {EtiquetaPeriodo(actual.Periodo)}")" accept=".pdf,.xml,application/pdf,text/xml,application/xml" OnChange="e => CargarFacturaAsync(actual, e)" /></label>
                        @if (!string.IsNullOrWhiteSpace(actual.FacturaObservacion)) { <div class="ally-invoice-note"><i class="ri-error-warning-line"></i>@actual.FacturaObservacion</div> }
                        @if (!string.IsNullOrWhiteSpace(actual.FacturaUrl)) { <a class="ally-invoice-current" href="@actual.FacturaUrl" target="_blank" rel="noopener"><i class="ri-file-text-line"></i> Ver factura cargada</a> }
                        <label class="ally-invoice-select-button"><i class="ri-upload-2-line"></i> Seleccionar factura<InputFile aria-label="@($"Seleccionar factura de {EtiquetaPeriodo(actual.Periodo)}")" accept=".pdf,.xml,application/pdf,text/xml,application/xml" OnChange="e => CargarFacturaAsync(actual, e)" /></label>
                        <button class="ally-invoice-history" type="button" @onclick="() => VerHistorialAsync(actual)"><i class="ri-history-line"></i> Ver historial de cargas <i class="ri-arrow-right-s-line"></i></button>
                    </aside>
                }
                <section class="ally-invoice-recipient" aria-label="Datos para emitir tu factura">
                    <div class="ally-invoice-recipient-heading"><span><i class="ri-file-copy-2-line"></i></span><div><small>DATOS PARA TU FACTURA</small><strong>Utiliza estos datos en la emisión de tu factura.</strong></div></div>
                    <dl>
                        <div><dt>Razón social</dt><dd>@(pendientes.First().EmisorRazonSocial ?? "Numerica Software S.A.S.")</dd></div>
                        <div><dt>Dirección</dt><dd>@(pendientes.First().EmisorDireccion ?? "Dirección no configurada")</dd></div>
                        <div><dt>RUC</dt><dd>@(pendientes.First().EmisorRuc ?? "No configurado")</dd></div>
                        <div><dt>Teléfono</dt><dd>@(pendientes.First().EmisorTelefono ?? "No configurado")</dd></div>
                        <div><dt>Correo</dt><dd>@(pendientes.First().EmisorEmail ?? "No configurado")</dd></div>
                    </dl>
                </section>
            </div>

            <section class="ally-invoice-periods">
                <div class="ally-invoice-toolbar"><div><span><i class="ri-file-list-3-line"></i></span><div><h3>Períodos disponibles</h3><small>Aquí puedes ver tus períodos pendientes y cargar su factura.</small></div></div><label>Período<select @bind="periodoSeleccionado"><option value="">Todos los períodos</option>@foreach (var periodo in pendientes.Select(x => x.Periodo).Distinct()) { <option value="@periodo">@EtiquetaPeriodo(periodo)</option> }</select></label></div>
                <div class="ally-invoice-table-wrap"><table><thead><tr><th>Período</th><th>Monto</th><th>Estado</th><th>Fecha carga</th><th>Factura</th><th>Acciones</th></tr></thead><tbody>
                    @foreach (var item in PeriodosFiltrados)
                    {
                        <tr class="@(actual?.IdLiquidacion == item.IdLiquidacion ? "selected" : null)" @key="item.IdLiquidacion"><td><strong>@EtiquetaPeriodo(item.Periodo)</strong><small>@item.CantidadComisiones @(item.CantidadComisiones == 1 ? "comisión" : "comisiones")</small></td><td><strong>$ @item.Total.ToString("N2")</strong></td><td><span class="ally-invoice-status @(item.FacturaEstado == "RequiereCorreccion" ? "correction" : "pending")">@EstadoFactura(item)</span></td><td>—</td><td>@if (!string.IsNullOrWhiteSpace(item.FacturaUrl)) { <a href="@item.FacturaUrl" target="_blank" rel="noopener">Ver archivo</a> } else { <span>—</span> }</td><td><button type="button" @onclick="() => SeleccionarPeriodo(item)"><i class="ri-upload-2-line"></i> Cargar factura</button></td></tr>
                    }
                </tbody></table></div>
            </section>
        }
    }

    @if (historial.Count > 0)
    {
        <div class="ally-invoice-history-panel"><div class="ally-invoice-history-heading"><div><span class="ally-eyebrow">TRAZABILIDAD</span><h3>Historial de facturas</h3></div><button type="button" class="ally-button muted" @onclick="CerrarHistorial">Cerrar</button></div><div class="ally-invoice-history-list">@foreach (var factura in historial) { <div><a href="@factura.ArchivoUrl" target="_blank" rel="noopener">@factura.NombreArchivo</a><span>@factura.Estado</span><small>@factura.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</small>@if (!string.IsNullOrWhiteSpace(factura.Observacion)) { <em>@factura.Observacion</em> }</div> }</div></div>
    }
</div>

@code {
    private int currentUserId;
    private bool cargando = true;
    private string periodoSeleccionado = string.Empty;
    private List<AliadoLiquidacionDto> pendientes = new();
    private List<AliadoLiquidacionDto> liquidaciones = new();
    private List<AliadoLiquidacionFactura> historial = new();
    private int? idLiquidacionSeleccionada;

    private IEnumerable<AliadoLiquidacionDto> PeriodosFiltrados => pendientes.Where(x => string.IsNullOrEmpty(periodoSeleccionado) || x.Periodo == periodoSeleccionado);
    private AliadoLiquidacionDto? PeriodoActual => pendientes.FirstOrDefault(x => x.IdLiquidacion == idLiquidacionSeleccionada);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out currentUserId))
            await CargarAsync();
        cargando = false;
    }

    private async Task CargarAsync()
    {
        liquidaciones = (await AliadoService.ObtenerLiquidacionesAsync(currentUserId)).ToList();
        pendientes = liquidaciones.Where(x => x.Estado == "Pendiente" && x.FacturaEstado != "Aprobada").OrderBy(x => x.Periodo).ToList();
        if (!pendientes.Any(x => x.Periodo == periodoSeleccionado)) periodoSeleccionado = string.Empty;
        if (!pendientes.Any(x => x.IdLiquidacion == idLiquidacionSeleccionada)) idLiquidacionSeleccionada = null;
    }

    private async Task CargarFacturaAsync(AliadoLiquidacionDto liquidacion, InputFileChangeEventArgs args)
    {
        var archivo = args.File;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size <= 0 || archivo.Size > 10 * 1024 * 1024 || extension is not ".pdf" and not ".xml")
        {
            await AlertService.ShowWarningAsync("La factura debe ser PDF o XML y no superar 10 MB.");
            return;
        }
        var carpeta = Path.Combine(Env.WebRootPath, "comprobantes", "aliados", "facturas");
        Directory.CreateDirectory(carpeta);
        var nombre = $"LIQ_{liquidacion.IdLiquidacion}_{Guid.NewGuid():N}{extension}";
        var ruta = Path.Combine(carpeta, nombre);
        await using (var origen = archivo.OpenReadStream(10 * 1024 * 1024))
        await using (var destino = File.Create(ruta))
            await origen.CopyToAsync(destino);
        var resultado = await AliadoService.RegistrarFacturaLiquidacionAsync(currentUserId, liquidacion.IdLiquidacion, $"/comprobantes/aliados/facturas/{nombre}", archivo.Name, archivo.ContentType);
        if (!resultado.Success)
        {
            File.Delete(ruta);
            await AlertService.ShowWarningAsync(resultado.Message);
            return;
        }
        await CargarAsync();
        await AlertService.ShowSuccessAsync(resultado.Message, "Factura enviada");
    }

    private async Task VerHistorialAsync(AliadoLiquidacionDto item) => historial = (await AliadoService.ObtenerHistorialFacturaLiquidacionAsync(currentUserId, item.IdLiquidacion)).ToList();
    private void SeleccionarPeriodo(AliadoLiquidacionDto item) => idLiquidacionSeleccionada = item.IdLiquidacion;
    private void CerrarHistorial() => historial.Clear();
    private static string EstadoFactura(AliadoLiquidacionDto item) => item.FacturaEstado == "RequiereCorreccion" ? "Por corregir" : item.FacturaEstado == "Pendiente" ? "En revisión" : string.IsNullOrWhiteSpace(item.FacturaUrl) ? "Por facturar" : "Cargada";
    private static string EtiquetaPeriodo(string periodo) => DateTime.TryParseExact($"{periodo}-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var fecha) ? fecha.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-EC")) : periodo;
}
