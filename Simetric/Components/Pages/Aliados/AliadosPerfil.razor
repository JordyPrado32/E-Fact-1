@page "/aliados/perfil"

<PageTitle>Mi perfil | Portal de Aliados</PageTitle>

<div class="ally-page">
    <div class="ally-page-intro"><div><span class="ally-eyebrow">DATOS DE ACCESO</span><h2>Mi perfil</h2><p>Información básica de tu cuenta y tu enlace personal.</p></div></div>
    @if (perfil is null) { <div class="ally-empty">No se pudo cargar el perfil.</div> }
    else
    {
        <section class="ally-panel"><div class="ally-panel-heading"><h3>@perfil.NombreAliado</h3><span class="ally-badge success">Cuenta activa</span></div><div class="ally-detail-grid"><div><span>Nombre</span><strong>@perfil.Nombre</strong></div><div><span>Correo</span><strong>@perfil.Email</strong></div><div><span>Teléfono</span><strong>@(perfil.Celular ?? "No registrado")</strong></div><div><span>Porcentaje base</span><strong>@perfil.PorcentajeBase.ToString("0.##")%</strong></div></div><div class="ally-link-card"><div><span class="ally-label">CÓDIGO DE CANAL</span><strong>@perfil.CodigoReferencia</strong></div><a class="ally-button" href="/cambiar-clave/@perfil.IdUsuario">Cambiar contraseña</a></div></section>
    }
</div>

@code {
    private AliadoPortalContext? perfil;
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
            perfil = await AliadoService.ObtenerContextoAsync(id);
    }
}
