@page "/aliados/perfil"
@using QRCoder
@using Simetric.Auth
@using Simetric.Data
@using Simetric.ViewModels

<PageTitle>Mi perfil | Portal de Aliados</PageTitle>

<div class="ally-profile-shell">
    @if (cargandoPerfil)
    {
        <section class="ally-profile-state is-loading" aria-busy="true">
            <span class="ally-profile-state-icon"><span class="spinner-border" role="status"></span></span>
            <h3>Cargando tu perfil</h3>
            <p>Preparando tu información.</p>
        </section>
    }
    else if (perfil is null || cuenta is null)
    {
        <section class="ally-profile-state">
            <span class="ally-profile-state-icon"><i class="ri-user-unfollow-line"></i></span>
            <h3>No se pudo cargar el perfil</h3>
            <p>Actualiza la página o vuelve a intentarlo en unos minutos.</p>
        </section>
    }
    else
    {
        <EditForm Model="@cuenta" OnValidSubmit="GuardarPerfilAsync">
        <DataAnnotationsValidator />
        <div class="ally-profile-grid">
            <aside class="ally-profile-aside">
                <div class="ally-profile-panel-head">
                    <div>
                        <span class="ally-profile-kicker">Avatar</span>
                        <h3>Imagen</h3>
                    </div>
                    <span class="ally-profile-pill">@GetAvatarCountLabel()</span>
                </div>

                <div class="ally-profile-avatar-stage">
                    <span class="ally-profile-avatar-frame">
                        <img src="@AvatarSrc" alt="Foto de perfil de @NombreCompleto" />
                    </span>
                    <span class="ally-profile-avatar-copy">
                        <strong>@NombreCompleto</strong>
                        <small>@(perfil.EsAdministrador ? "Administrador interno" : perfil.NombreAliado)</small>
                        <InputFile OnChange="SubirFotoPropiaAsync" accept="image/png, image/jpeg, image/jpg" class="d-none" id="allyOwnAvatar" />
                        <label for="allyOwnAvatar" class="ally-profile-upload">
                            <i class="ri-upload-cloud-2-line"></i><span>@(subiendoArchivo ? "Subiendo..." : "Subir foto propia")</span>
                        </label>
                    </span>
                </div>

                <section class="ally-profile-avatar-library" aria-labelledby="ally-avatar-library-title">
                    <div class="ally-profile-section-head">
                        <h4 id="ally-avatar-library-title">Selección</h4>
                        <span>Biblioteca</span>
                    </div>
                    <div class="ally-profile-avatar-grid">
                        @foreach (var imgNombre in listaAvatares)
                        {
                            var rutaRelativa = $"images/Avatars/{imgNombre}";
                            var activo = string.Equals(cuenta.AvatarUrl?.TrimStart('/'), rutaRelativa, StringComparison.OrdinalIgnoreCase);
                            <button type="button" title="@imgNombre" class="ally-avatar-picker @(activo ? "is-active" : string.Empty)" @onclick="() => SeleccionarAvatarAsync(imgNombre)">
                                <img src="/@rutaRelativa" alt="Avatar disponible @imgNombre" />
                            </button>
                        }
                    </div>
                </section>

                @if (!perfil.EsAdministrador)
                {
                    <section class="ally-profile-channel" aria-labelledby="ally-channel-title">
                        <div class="ally-profile-section-head">
                            <h4 id="ally-channel-title">Mi canal</h4>
                            <span>Enlace y QR</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(QrDataUri))
                        {
                            <img class="ally-profile-qr" src="@QrDataUri" alt="Código QR del enlace de registro de @perfil.NombreAliado" />
                        }

                        <strong class="ally-profile-channel-code">@perfil.CodigoReferencia</strong>
                        <small>Comparte tu código para registrar clientes en tu canal.</small>

                        <div class="ally-profile-channel-actions">
                            <button class="ally-profile-secondary" type="button" @onclick="CopiarEnlace">
                                <i class="ri-file-copy-line"></i><span>Copiar enlace</span>
                            </button>
                            <a class="ally-profile-icon-button" href="@QrDataUri" download="qr-aliado.png" aria-label="Descargar código QR" title="Descargar QR">
                                <i class="ri-download-2-line"></i>
                            </a>
                        </div>
                    </section>
                }

                <section class="ally-profile-legal" aria-labelledby="ally-legal-title">
                    <div class="ally-profile-section-head">
                        <h4 id="ally-legal-title">Legal</h4>
                        <span>Documentos</span>
                    </div>
                    <a href="/politica-privacidad?returnUrl=%2Faliados%2Fperfil" class="ally-profile-legal-link">
                        <span class="ally-profile-legal-icon"><i class="ri-shield-check-line"></i></span>
                        <span class="ally-profile-legal-copy">
                            <strong>Política de Privacidad</strong>
                            <small>Ver acuerdo vigente</small>
                        </span>
                        <i class="ri-external-link-line"></i>
                    </a>
                </section>
            </aside>

            <section class="ally-profile-form">
                <div class="ally-profile-panel-head ally-profile-form-head">
                    <div>
                        <span class="ally-profile-kicker">Cuenta</span>
                        <h3>Información</h3>
                    </div>
                    <span class="ally-profile-pill ally-profile-pill-soft">Portal de aliados</span>
                </div>

                <ValidationSummary class="ally-profile-validation" />

                <section class="ally-profile-banner">
                    <span class="ally-profile-banner-icon"><i class="ri-hand-heart-line"></i></span>
                    <span>
                        <strong>Datos de tu cuenta de aliado</strong>
                        <small>Actualiza tu información personal y los datos asociados a tu cuenta.</small>
                    </span>
                </section>

                <div class="ally-profile-fields">
                    <div class="ally-profile-field ally-profile-field-wide">
                        <span class="ally-profile-field-label">Correo electrónico</span>
                        <div class="ally-profile-value is-readonly"><i class="ri-mail-line"></i><input value="@cuenta.Email" readonly /></div>
                    </div>
                    <div class="ally-profile-field">
                        <span class="ally-profile-field-label">Tipo de cliente</span>
                        <div class="ally-profile-value"><i class="ri-user-settings-line"></i><InputSelect @bind-Value="cuenta.TipoCliente"><option value="">Seleccione</option>@foreach (var tipo in tiposCliente){<option value="@tipo.TclCodigo">@tipo.TclDescripcion</option>}</InputSelect></div>
                        <ValidationMessage For="@(() => cuenta.TipoCliente)" class="ally-profile-field-error" />
                    </div>
                    <div class="ally-profile-field">
                        <span class="ally-profile-field-label">Tipo de identificación</span>
                        <div class="ally-profile-value"><i class="ri-id-card-line"></i><InputSelect @bind-Value="cuenta.IdTipoIdentificacion"><option value="">Seleccione</option>@foreach (var tipo in tiposIdentificacion){<option value="@tipo.IdTipoIdentificacion">@tipo.NombreTipo</option>}</InputSelect></div>
                        <ValidationMessage For="@(() => cuenta.IdTipoIdentificacion)" class="ally-profile-field-error" />
                    </div>
                    <div class="ally-profile-field ally-profile-field-wide">
                        <span class="ally-profile-field-label">Identificación (Cédula o RUC)</span>
                        <div class="ally-profile-value"><i class="ri-bank-card-line"></i><InputText @bind-Value="cuenta.Identificacion" maxlength="13" /></div>
                        <ValidationMessage For="@(() => cuenta.Identificacion)" class="ally-profile-field-error" />
                    </div>
                    @if (cuenta.TipoCliente == 2)
                    {
                        <div class="ally-profile-field ally-profile-field-wide">
                            <span class="ally-profile-field-label">Razón social</span>
                            <div class="ally-profile-value"><i class="ri-building-line"></i><InputText @bind-Value="cuenta.NombreEmpresa" maxlength="150" /></div>
                            <ValidationMessage For="@(() => cuenta.NombreEmpresa)" class="ally-profile-field-error" />
                        </div>
                    }
                    else
                    {
                        <div class="ally-profile-field">
                            <span class="ally-profile-field-label">Nombres</span>
                            <div class="ally-profile-value"><i class="ri-user-3-line"></i><InputText @bind-Value="cuenta.Nombres" maxlength="60" /></div>
                            <ValidationMessage For="@(() => cuenta.Nombres)" class="ally-profile-field-error" />
                        </div>
                        <div class="ally-profile-field">
                            <span class="ally-profile-field-label">Apellidos</span>
                            <div class="ally-profile-value"><i class="ri-contacts-line"></i><InputText @bind-Value="cuenta.Apellidos" maxlength="60" /></div>
                            <ValidationMessage For="@(() => cuenta.Apellidos)" class="ally-profile-field-error" />
                        </div>
                    }
                    <div class="ally-profile-field ally-profile-field-wide">
                        <span class="ally-profile-field-label">Celular</span>
                        <div class="ally-profile-value"><i class="ri-smartphone-line"></i><InputText @bind-Value="cuenta.Celular" autocomplete="tel" /></div>
                        <ValidationMessage For="@(() => cuenta.Celular)" class="ally-profile-field-error" />
                    </div>
                    <div class="ally-profile-field ally-profile-field-wide">
                        <span class="ally-profile-field-label">Dirección</span>
                        <div class="ally-profile-value"><i class="ri-map-pin-line"></i><InputText @bind-Value="cuenta.DireccionEmpresa" maxlength="200" /></div>
                        <ValidationMessage For="@(() => cuenta.DireccionEmpresa)" class="ally-profile-field-error" />
                    </div>
                </div>

                <section class="ally-profile-security">
                    <div class="ally-profile-security-head">
                        <div>
                            <span class="ally-profile-kicker">Seguridad</span>
                            <h4>Clave de acceso</h4>
                        </div>
                        <div class="ally-profile-security-controls">
                            <span class="ally-profile-status @(cambiarClave ? "is-active" : string.Empty)">@(cambiarClave ? "En edición" : "Estable")</span>
                            <label class="ally-profile-toggle">
                                <input type="checkbox" @bind="cambiarClave" @bind:after="AlCambiarEstadoClave" />
                                <span class="ally-profile-toggle-track"></span>
                                <span>Cambiar</span>
                            </label>
                        </div>
                    </div>

                    @if (cambiarClave)
                    {
                        <div class="ally-profile-password-grid">
                            <label class="ally-profile-password-field">
                                <span>Contraseña actual</span>
                                <span class="ally-profile-password-input"><i class="ri-lock-line"></i><input type="password" @bind="claveActual" autocomplete="current-password" /></span>
                            </label>
                            <label class="ally-profile-password-field">
                                <span>Nueva contraseña</span>
                                <span class="ally-profile-password-input"><i class="ri-shield-keyhole-line"></i><input type="password" @bind="claveNueva" autocomplete="new-password" /></span>
                            </label>
                            <label class="ally-profile-password-field">
                                <span>Confirmar contraseña</span>
                                <span class="ally-profile-password-input"><i class="ri-checkbox-circle-line"></i><input type="password" @bind="claveConfirmar" autocomplete="new-password" /></span>
                            </label>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(mensajeClave))
                        {
                            <div class="ally-profile-feedback"><i class="ri-error-warning-line"></i><span>@mensajeClave</span></div>
                        }
                        <div class="ally-profile-password-actions">
                            <button type="button" class="ally-profile-secondary" @onclick="CancelarCambiarClave">Cancelar</button>
                            <button type="button" class="ally-profile-primary" @onclick="GuardarClaveAsync" disabled="@guardandoClave">
                                <i class="ri-save-3-line"></i><span>@(guardandoClave ? "Guardando..." : "Guardar contraseña")</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="ally-profile-security-placeholder">
                            <span><i class="ri-shield-check-line"></i></span>
                            <strong>Sin cambios en contraseña</strong>
                        </div>
                    }
                </section>

                <div class="ally-profile-form-footer">
                    <button type="submit" class="ally-profile-primary" disabled="@guardandoPerfil">
                        <i class="ri-save-3-line"></i><span>@(guardandoPerfil ? "Guardando..." : "Guardar cambios")</span>
                    </button>
                </div>
            </section>
        </div>
        </EditForm>
    }
</div>

@code {
    private AliadoPortalContext? perfil;
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;
    [Inject] private IUsuarioService UsuarioService { get; set; } = null!;
    [Inject] private IDbContextFactory<AppDbContext> DbFactory { get; set; } = null!;
    [Inject] private IWebHostEnvironment Env { get; set; } = null!;

    private string EnlaceAbsoluto => perfil is null ? string.Empty : $"{NavManager.BaseUri.TrimEnd('/')}{perfil.EnlaceRegistro}";
    private string AvatarSrc => !string.IsNullOrWhiteSpace(cuenta?.AvatarUrl)
        ? ResolverAvatar(cuenta.AvatarUrl)
        : cuenta?.FotoByte is { Length: > 0 }
            ? $"data:image/png;base64,{Convert.ToBase64String(cuenta.FotoByte)}"
            : "/images/Avatars/Avatar-Boy.jpg";
    private string NombreCompleto => cuenta is null
        ? "Tu cuenta"
        : string.Join(" ", new[] { cuenta.Nombres, cuenta.Apellidos }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();
    private PerfilViewModel? cuenta;
    private readonly List<string> listaAvatares = new();
    private List<TipoIdentificacion> tiposIdentificacion = new();
    private List<Tipocliente> tiposCliente = new();
    private int? usuarioIdActual;
    private string? QrDataUri { get; set; }
    private bool cambiarClave;
    private bool guardandoClave;
    private bool guardandoPerfil;
    private bool subiendoArchivo;
    private bool cargandoPerfil = true;
    private string? mensajeClave;
    private string? claveActual;
    private string? claveNueva;
    private string? claveConfirmar;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
            {
                usuarioIdActual = id;
                perfil = await AliadoService.ObtenerContextoAsync(id);
                var usuario = await UsuarioService.ObtenerUsuarioPorId(id);
                if (usuario is not null)
                {
                    cuenta = new PerfilViewModel
                    {
                        Nombres = usuario.Nombres,
                        Apellidos = usuario.Apellidos,
                        Email = usuario.Email,
                        AvatarUrl = usuario.AvatarUrl,
                        FotoByte = usuario.FirmaElectronica,
                        Identificacion = usuario.Identificacion,
                        TipoCliente = usuario.TipoCliente,
                        IdTipoIdentificacion = usuario.IdTipoIdentificacion,
                        NombreEmpresa = usuario.NombreEmpresa,
                        DireccionEmpresa = usuario.DireccionEmpresa,
                        Celular = usuario.Celular
                    };
                }

                await using var db = await DbFactory.CreateDbContextAsync();
                tiposIdentificacion = await db.TipoIdentificacion.AsNoTracking().OrderBy(x => x.IdTipoIdentificacion).ToListAsync();
                tiposCliente = await db.Tipoclientes.AsNoTracking().OrderBy(x => x.TclCodigo).ToListAsync();
                CargarListaAvatares();

                if (perfil is not null && !string.IsNullOrWhiteSpace(EnlaceAbsoluto))
                    QrDataUri = GenerarQr(EnlaceAbsoluto);
            }
        }
        finally
        {
            cargandoPerfil = false;
        }
    }

    private void CargarListaAvatares()
    {
        var folderPath = Path.Combine(Env.WebRootPath, "images", "Avatars");
        if (!Directory.Exists(folderPath))
            return;

        const string avatarRestringido = "avatar_18e35752-9dbd-40a4-8c62-970a2dfc1dfb.png";
        var archivos = Directory.GetFiles(folderPath)
            .Select(Path.GetFileName)
            .Where(x => !string.IsNullOrWhiteSpace(x) &&
                        !x.Equals("Avatar-Boy.jpg", StringComparison.OrdinalIgnoreCase) &&
                        (x.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                         x.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                         x.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)));

        if (perfil?.EsAdministrador != true)
            archivos = archivos.Where(x => !x!.Equals(avatarRestringido, StringComparison.OrdinalIgnoreCase));

        listaAvatares.AddRange(archivos.Select(x => x!).OrderByDescending(x => x.StartsWith("Bandera-", StringComparison.OrdinalIgnoreCase)).ThenBy(x => x));
    }

    private async Task SeleccionarAvatarAsync(string nombreArchivo)
    {
        if (cuenta is null || usuarioIdActual is null)
            return;

        cuenta.AvatarUrl = $"images/Avatars/{nombreArchivo}";
        cuenta.FotoByte = null;
        if (!await UsuarioService.ActualizarAvatar(usuarioIdActual.Value, cuenta.AvatarUrl))
        {
            await AlertService.ShowErrorAsync("No se pudo actualizar el avatar.", "Error");
            return;
        }

        await RefrescarSesionAsync();
    }

    private async Task SubirFotoPropiaAsync(InputFileChangeEventArgs e)
    {
        if (cuenta is null || usuarioIdActual is null)
            return;

        subiendoArchivo = true;
        try
        {
            var file = e.File;
            if (file.Size > 1024 * 1024)
            {
                await AlertService.ShowErrorAsync("La imagen no debe superar 1 MB.", "Archivo demasiado grande");
                return;
            }

            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".png" or ".jpg" or ".jpeg"))
            {
                await AlertService.ShowErrorAsync("Utiliza una imagen PNG, JPG o JPEG.", "Formato no permitido");
                return;
            }

            var uploadsFolder = Path.Combine(Env.WebRootPath, "images", "Avatars", "uploads");
            Directory.CreateDirectory(uploadsFolder);
            var uniqueName = $"avatar_user_{usuarioIdActual}_{Guid.NewGuid()}{extension}";
            var filePath = Path.Combine(uploadsFolder, uniqueName);
            await using (var fileStream = new FileStream(filePath, FileMode.CreateNew))
                await file.OpenReadStream(1024 * 1024).CopyToAsync(fileStream);

            cuenta.AvatarUrl = $"images/Avatars/uploads/{uniqueName}";
            cuenta.FotoByte = null;
            if (!await UsuarioService.ActualizarAvatar(usuarioIdActual.Value, cuenta.AvatarUrl))
            {
                File.Delete(filePath);
                await AlertService.ShowErrorAsync("No se pudo guardar la foto en tu perfil.", "Error");
                return;
            }

            await RefrescarSesionAsync();
            await AlertService.ShowSuccessAsync("Tu foto de perfil fue actualizada.", "Avatar actualizado");
        }
        catch
        {
            await AlertService.ShowErrorAsync("No se pudo procesar la imagen seleccionada.", "Error");
        }
        finally
        {
            subiendoArchivo = false;
        }
    }

    private async Task GuardarPerfilAsync()
    {
        if (guardandoPerfil || cuenta is null || usuarioIdActual is null)
            return;

        guardandoPerfil = true;
        try
        {
            cuenta.Nombres = NormalizarTexto(cuenta.Nombres);
            cuenta.Apellidos = NormalizarTexto(cuenta.Apellidos);
            cuenta.NombreEmpresa = cuenta.NombreEmpresa?.Trim();
            cuenta.DireccionEmpresa = cuenta.DireccionEmpresa?.Trim();
            cuenta.Celular = cuenta.Celular?.Trim();
            cuenta.Identificacion = cuenta.Identificacion?.Trim();
            cuenta.NuevaPassword = null;
            cuenta.ConfirmarPassword = null;

            if (!await UsuarioService.ActualizarPerfil(usuarioIdActual.Value, cuenta))
            {
                await AlertService.ShowErrorAsync("Revisa los datos ingresados e inténtalo nuevamente.", "No se pudo actualizar");
                return;
            }

            await RefrescarSesionAsync();
            perfil = await AliadoService.ObtenerContextoAsync(usuarioIdActual.Value);
            await AlertService.ShowSuccessAsync("Tu información fue actualizada correctamente.", "Perfil actualizado");
        }
        finally
        {
            guardandoPerfil = false;
        }
    }

    private async Task RefrescarSesionAsync()
    {
        if (usuarioIdActual is null)
            return;

        var usuario = await UsuarioService.ObtenerUsuarioPorId(usuarioIdActual.Value);
        if (usuario is not null && AuthStateProvider is CustomAuthStateProvider authProvider)
            await authProvider.UpdateAuthenticationState(usuario);
    }

    private string GetAvatarCountLabel() => listaAvatares.Count == 1 ? "1 opción" : $"{listaAvatares.Count} opciones";

    private static string NormalizarTexto(string? texto) =>
        string.Join(" ", (texto ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private async Task CopiarEnlace()
    {
        if (!string.IsNullOrWhiteSpace(EnlaceAbsoluto))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", EnlaceAbsoluto);
            await AlertService.ShowSuccessAsync("El enlace quedó copiado en el portapapeles.", "Enlace copiado");
        }
    }

    private void AlCambiarEstadoClave()
    {
        if (!cambiarClave)
            LimpiarCamposClave();
    }

    private void CancelarCambiarClave()
    {
        cambiarClave = false;
        LimpiarCamposClave();
    }

    private async Task GuardarClaveAsync()
    {
        if (guardandoClave || perfil is null)
            return;

        guardandoClave = true;
        mensajeClave = null;
        try
        {
            var resultado = await AliadoService.ActualizarClaveAsync(perfil.IdUsuario, claveActual, claveNueva, claveConfirmar);
            if (resultado.Success)
            {
                await AlertService.ShowSuccessAsync("Tu contraseña fue actualizada correctamente.", "Contraseña actualizada");
                cambiarClave = false;
                LimpiarCamposClave();
            }
            else
            {
                mensajeClave = resultado.Message;
                await AlertService.ShowErrorAsync(resultado.Message, "No se pudo actualizar");
            }
        }
        catch
        {
            mensajeClave = "No fue posible actualizar la contraseña. Inténtalo nuevamente.";
            await AlertService.ShowErrorAsync(mensajeClave, "No se pudo actualizar");
        }
        finally
        {
            guardandoClave = false;
        }
    }

    private void LimpiarCamposClave()
    {
        claveActual = null;
        claveNueva = null;
        claveConfirmar = null;
        mensajeClave = null;
    }

    private static string GenerarQr(string enlace)
    {
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(enlace, QRCodeGenerator.ECCLevel.Q);
        var bytes = new PngByteQRCode(data).GetGraphic(8);
        return $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
    }

    private static string ResolverAvatar(string? avatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
            return "/images/Avatars/Avatar-Boy.jpg";

        var value = avatarUrl.Trim().Replace('\\', '/');
        if (value.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return value;

        var relativeUrl = value.TrimStart('/');
        return relativeUrl.StartsWith("images/", StringComparison.OrdinalIgnoreCase)
            ? $"/{relativeUrl}"
            : value;
    }
}
