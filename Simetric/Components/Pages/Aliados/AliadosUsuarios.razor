@page "/aliados/admin/usuarios"
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider
@inject SweetAlertService AlertService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{ var usuariosVisibles = UsuariosFiltrados.ToList(); }
<PageTitle>Usuarios | Portal de Aliados</PageTitle>

<div class="users-shell" data-tour="usuarios.page">
 <section class="users-hero" data-tour="usuarios.hero">
  <div class="hero-copy"><span class="hero-eyebrow">Administracion de accesos</span><h2>Usuarios de aliados</h2><p>Gestione perfiles, roles y seguridad del Portal de Aliados desde una vista unificada.</p></div>
  <div class="hero-actions"><button type="button" class="secondary-btn" @onclick="AbrirGestorAvatares"><i class="bi bi-images"></i><span>Galeria de avatares</span></button><button type="button" class="primary-btn" @onclick="AbrirCrear"><i class="bi bi-person-plus-fill"></i><span>Nuevo usuario</span></button></div>
  <div class="hero-summary"><article class="summary-card summary-card-primary"><span class="summary-label">Usuarios registrados</span><strong>@usuarios.Count</strong><small>Cuentas exclusivas del Portal de Aliados.</small></article><article class="summary-card"><span class="summary-label">Usuarios activos</span><strong>@usuarios.Count(x => x.Activo)</strong><small>Perfiles con acceso habilitado actualmente.</small></article><article class="summary-card"><span class="summary-label">Cuentas bloqueadas</span><strong>@usuarios.Count(x => x.Bloqueado)</strong><small>Usuarios que requieren intervencion administrativa.</small></article></div>
 </section>
 <section class="table-card">
  <div class="table-card-head"><div><span class="table-kicker">Directorio administrativo</span><h3>Control de usuarios</h3></div><div class="d-flex align-items-center gap-2"><input class="form-control" style="max-width:260px" @bind="filtro" @bind:event="oninput" placeholder="Buscar usuario"/><span class="table-badge">@usuariosVisibles.Count registrados</span></div></div>
  @if(isLoading){<div class="state-card"><div class="state-icon"><i class="bi bi-arrow-repeat"></i></div><h3>Cargando usuarios</h3><p>Preparando la informacion de acceso, roles y seguridad.</p></div>}
  else if(!usuariosVisibles.Any()){<div class="state-card state-card-empty"><div class="state-icon"><i class="bi bi-people"></i></div><h3>No hay usuarios</h3><p>Cree un nuevo usuario para comenzar.</p></div>}
  else {<div class="table-wrap"><table class="table users-table mb-0"><thead><tr><th>Usuario</th><th>Aliado / canal</th><th>Rol</th><th>Seguridad</th><th class="text-end">Acciones</th></tr></thead><tbody>
   @foreach(var u in usuariosVisibles){<tr @key="u.IdUsuario"><td><div class="user-cell">@if(TieneAvatar(u.AvatarUrl)){<img src="@ResolveAvatarUrl(u.AvatarUrl)" alt="Avatar de @u.Nombre" class="user-avatar"/>}else{<span class="user-avatar avatar-default"><i class="bi bi-person-fill"></i></span>}<div class="cell-main"><strong>@u.Nombre</strong><span>@u.Email</span></div></div></td><td><div class="cell-main"><strong>@(u.Aliado??"Administracion del portal")</strong><span>@(u.CodigoReferencia??"Sin canal comercial")</span></div></td><td><span class="role-pill">@u.Rol</span></td><td><div class="security-stack"><span class="security-pill @(u.Bloqueado?"security-pill-danger":"security-pill-neutral")"><i class="bi @(u.Bloqueado?"bi-lock-fill":"bi-unlock-fill")"></i>@(u.Bloqueado?"Bloqueado":u.Activo?"Sin bloqueo":"Inactivo")</span></div></td><td class="text-end"><div class="action-group"><button type="button" class="action-btn action-view" title="Ver detalles" @onclick="()=>VerDetalle(u)"><i class="bi bi-eye"></i></button><button type="button" class="action-btn action-edit" title="Editar usuario" @onclick="()=>AbrirEditar(u)"><i class="bi bi-pencil-square"></i></button><button type="button" class="action-btn action-reset" title="Resetear clave" @onclick="()=>ResetearPasswordAsync(u)"><i class="bi bi-shield-lock"></i></button>@if(u.Bloqueado){<button type="button" class="action-btn action-unlock" title="Desbloquear usuario" @onclick="()=>DesbloquearAsync(u)"><i class="bi bi-unlock"></i></button>}<button type="button" class="action-btn action-delete" title="Dar de baja" disabled="@(!u.Activo)" @onclick="()=>ConfirmarBajaAsync(u)"><i class="bi bi-person-x"></i></button></div></td></tr>}
  </tbody></table></div>}
 </section>
</div>

@if(showModal){<div class="users-modal-backdrop"></div><div class="users-modal users-modal-lg" role="dialog" aria-modal="true"><div class="users-modal-content">
 <div class="users-modal-header users-modal-header-primary"><div><span class="modal-kicker">Perfil de usuario</span><h3>@(tempUser.IdUsuario==0?"Nuevo registro de usuario":"Modificar usuario")</h3></div><button type="button" class="modal-close" @onclick="CerrarModal"><i class="bi bi-x-lg"></i></button></div>
 <div class="users-modal-body">@if(errorFormulario is not null){<div class="alert alert-danger rounded-3 border-0 shadow-sm mb-3">@errorFormulario</div>}<div class="form-layout">
  <aside class="avatar-panel"><div class="avatar-preview-wrap">@if(TieneAvatar(tempUser.AvatarUrl)){<img src="@ResolveAvatarUrl(tempUser.AvatarUrl)" alt="Avatar" class="avatar-preview"/>}else{<span class="avatar-preview avatar-default avatar-default-large"><i class="bi bi-person-fill"></i></span>}<button type="button" class="avatar-trigger" @onclick="()=>showAvatarSelector=!showAvatarSelector"><i class="bi bi-camera"></i></button></div><div class="avatar-copy"><strong>Imagen de perfil</strong><span>Seleccione un avatar del catalogo compartido.</span></div>@if(showAvatarSelector){<div class="avatar-selector">@foreach(var avatar in avatarFiles){var url=$"/images/Avatars/{avatar}";<button type="button" class="avatar-selector-item @(EsMismoAvatar(tempUser.AvatarUrl,url)?"avatar-selector-item-selected":"")" @onclick="()=>SeleccionarAvatar(url)"><img src="@url" alt="Avatar disponible"/></button>}</div>}</aside>
  <div class="form-grid"><div class="form-field"><label class="field-label">Nombres</label><input @bind="tempUser.Nombres" class="form-control field-input"/></div><div class="form-field"><label class="field-label">Apellidos</label><input @bind="tempUser.Apellidos" class="form-control field-input"/></div><div class="form-field"><label class="field-label">Email corporativo</label><input @bind="tempUser.Email" type="email" class="form-control field-input"/></div><div class="form-field"><label class="field-label">Fecha de nacimiento</label><input type="date" class="form-control field-input" value="@FormatFecha(tempUser.FechaNacimiento)" @onchange="OnFechaChanged"/></div><div class="form-field form-field-wide"><label class="field-label">Identificacion</label><input @bind="tempUser.Identificacion" class="form-control field-input"/></div><div class="form-field form-field-wide"><label class="field-label">Rol asignado</label><select @bind="tempUser.EsAdministrador" class="form-select field-input" disabled="@(tempUser.IdUsuario>0)"><option value="false">Aliado Comercial</option>@if(puedeCrearAdministrador){<option value="true">Administrador Portal de Aliados</option>}</select></div>@if(tempUser.IdUsuario==0){<div class="form-field"><label class="field-label">Comision base (%)</label><input type="number" min="0" max="100" step="0.01" @bind="tempUser.Porcentaje" class="form-control field-input"/></div><div class="form-field"><label class="field-label">Contrasena inicial</label><input @bind="tempUser.Password" type="password" class="form-control field-input field-input-accent" placeholder="Minimo 8 caracteres"/></div><div class="form-note form-field-wide"><i class="bi bi-info-circle"></i><span>La cuenta se registrara exclusivamente en el Portal de Aliados.</span></div>}</div>
 </div></div><div class="users-modal-footer"><button type="button" class="secondary-btn secondary-btn-quiet" @onclick="CerrarModal">Cancelar</button><button type="button" class="primary-btn" @onclick="GuardarAsync" disabled="@guardando"><i class="bi bi-save"></i><span>@(guardando?"Guardando...":"Guardar cambios")</span></button></div>
</div></div>}

@if(showDetailModal && usuarioSeleccionado is not null){<div class="users-modal-backdrop"></div><div class="users-modal users-modal-lg" role="dialog" aria-modal="true"><div class="users-modal-content"><div class="users-modal-header users-modal-header-secondary"><div><span class="modal-kicker">Detalle de usuario</span><h3>@usuarioSeleccionado.Nombre</h3></div><button type="button" class="modal-close" @onclick="CerrarDetalle"><i class="bi bi-x-lg"></i></button></div><div class="users-modal-body"><div class="detail-layout"><aside class="detail-profile">@if(TieneAvatar(usuarioSeleccionado.AvatarUrl)){<img src="@ResolveAvatarUrl(usuarioSeleccionado.AvatarUrl)" alt="Avatar" class="detail-avatar"/>}else{<span class="detail-avatar avatar-default avatar-default-large"><i class="bi bi-person-fill"></i></span>}<h4>@usuarioSeleccionado.Nombre</h4><span class="role-pill">@usuarioSeleccionado.Rol</span><span class="status-pill @(usuarioSeleccionado.Activo?"status-pill-active":"status-pill-inactive")">@(usuarioSeleccionado.Activo?"Usuario activo":"Usuario inactivo")</span></aside><div class="detail-sections"><section class="detail-section"><span class="detail-kicker">Contacto e identificacion</span><div class="detail-grid"><article class="detail-item"><span>Email</span><strong>@usuarioSeleccionado.Email</strong></article><article class="detail-item"><span>Fecha de nacimiento</span><strong>@FormatFechaDetalle(usuarioSeleccionado.FechaNacimiento)</strong></article><article class="detail-item"><span>Identificacion</span><strong>@(usuarioSeleccionado.Identificacion??"No registrada")</strong></article><article class="detail-item"><span>Canal comercial</span><strong>@(usuarioSeleccionado.CodigoReferencia??"No aplica")</strong></article></div></section><section class="detail-section"><span class="detail-kicker">Seguridad de la cuenta</span><div class="detail-grid"><article class="detail-item"><span>Bloqueo</span><strong>@(usuarioSeleccionado.Bloqueado?"Cuenta bloqueada":"Sin bloqueo")</strong></article><article class="detail-item"><span>Estado de clave</span><strong>@(usuarioSeleccionado.ClaveTemporal?"Temporal":"Permanente")</strong></article></div></section></div></div></div><div class="users-modal-footer"><button type="button" class="secondary-btn secondary-btn-quiet" @onclick="CerrarDetalle">Cerrar</button></div></div></div>}

@if(showAvatarManager){<div class="users-modal-backdrop"></div><div class="users-modal users-modal-xl" role="dialog" aria-modal="true"><div class="users-modal-content"><div class="users-modal-header users-modal-header-dark"><div><span class="modal-kicker">Biblioteca visual compartida</span><h3>Galeria de avatares</h3></div><button type="button" class="modal-close" @onclick="()=>showAvatarManager=false"><i class="bi bi-x-lg"></i></button></div><div class="users-modal-body"><label class="upload-dropzone"><span class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></span><strong>Subir nuevo avatar</strong><small>JPG, JPEG y PNG. Maximo 2 MB.</small><InputFile OnChange="SubirAvatarAsync" accept=".jpg,.jpeg,.png" class="d-none"/></label><div class="avatar-gallery-grid">@foreach(var avatar in avatarFiles){var url=$"/images/Avatars/{avatar}";<article class="avatar-gallery-card">@if(!string.Equals(avatar,"default.png",StringComparison.OrdinalIgnoreCase)){<button type="button" class="avatar-gallery-remove" @onclick="()=>EliminarAvatarAsync(avatar)"><i class="bi bi-x-lg"></i></button>}<img src="@url" alt="Avatar almacenado" class="avatar-gallery-image"/></article>}</div></div></div></div>}

@code{
 private List<AliadoUsuarioAdminRow> usuarios=new(); private List<string> avatarFiles=new(); private UsuarioForm tempUser=new(); private AliadoUsuarioAdminRow? usuarioSeleccionado; private int actorId; private string filtro=string.Empty; private string? errorFormulario; private bool isLoading=true,showModal,showDetailModal,showAvatarManager,showAvatarSelector,guardando,puedeCrearAdministrador;
 private IEnumerable<AliadoUsuarioAdminRow> UsuariosFiltrados=>usuarios.Where(x=>string.IsNullOrWhiteSpace(filtro)||x.Nombre.Contains(filtro,StringComparison.OrdinalIgnoreCase)||x.Email.Contains(filtro,StringComparison.OrdinalIgnoreCase)||(x.Aliado?.Contains(filtro,StringComparison.OrdinalIgnoreCase)??false));
 protected override async Task OnInitializedAsync(){var auth=await AuthStateProvider.GetAuthenticationStateAsync();int.TryParse(auth.User.FindFirst("IdUsuario")?.Value,out actorId);puedeCrearAdministrador=auth.User.IsInRole(BackOfficePermissionHelper.SuperAdministradorRoleId.ToString());CargarAvatares();await CargarAsync();}
 private async Task CargarAsync(){isLoading=true;try{usuarios=(await AliadoService.ListarUsuariosAliadosAsync(actorId)).ToList();}finally{isLoading=false;}}
 private void AbrirCrear(){tempUser=new();errorFormulario=null;showAvatarSelector=false;showModal=true;} private void AbrirEditar(AliadoUsuarioAdminRow u){tempUser=new(){IdUsuario=u.IdUsuario,Nombres=u.Nombres,Apellidos=u.Apellidos,Email=u.Email,Identificacion=u.Identificacion,FechaNacimiento=u.FechaNacimiento,AvatarUrl=u.AvatarUrl,EsAdministrador=u.Rol==AliadoPortalService.AdminRoleName};errorFormulario=null;showModal=true;} private void CerrarModal(){if(!guardando)showModal=false;} private void VerDetalle(AliadoUsuarioAdminRow u){usuarioSeleccionado=u;showDetailModal=true;} private void CerrarDetalle(){showDetailModal=false;usuarioSeleccionado=null;} private void AbrirGestorAvatares(){CargarAvatares();showAvatarManager=true;} private void SeleccionarAvatar(string url){tempUser.AvatarUrl=url;showAvatarSelector=false;} private void OnFechaChanged(ChangeEventArgs e)=>tempUser.FechaNacimiento=DateTime.TryParse(e.Value?.ToString(),out var f)?f:null;
 private async Task GuardarAsync(){errorFormulario=Validar();if(errorFormulario is not null)return;guardando=true;try{var r=tempUser.IdUsuario==0?await AliadoService.CrearCuentaAliadoAsync(actorId,tempUser.Nombres,tempUser.Email,tempUser.Password,tempUser.Porcentaje,tempUser.EsAdministrador,tempUser.Apellidos,tempUser.Identificacion,tempUser.FechaNacimiento,tempUser.AvatarUrl):await AliadoService.ActualizarPerfilUsuarioAliadoAsync(actorId,tempUser.IdUsuario,tempUser.Nombres,tempUser.Apellidos,tempUser.Email,tempUser.Identificacion,tempUser.FechaNacimiento,tempUser.AvatarUrl);if(!r.Success){errorFormulario=r.Message;return;}showModal=false;await CargarAsync();await AlertService.ShowSuccessAsync(r.Message,"Usuario guardado");}finally{guardando=false;}}
 private async Task ResetearPasswordAsync(AliadoUsuarioAdminRow u){if(!await AlertService.ConfirmAsync($"Se restablecera la contraseña de {u.Nombre} a '00000000'.","Resetear contraseña","Si, resetear"))return;var r=await AliadoService.ResetearClaveUsuarioAliadoAsync(actorId,u.IdUsuario);await MostrarAsync(r);await CargarAsync();} private async Task DesbloquearAsync(AliadoUsuarioAdminRow u){var r=await AliadoService.DesbloquearUsuarioAliadoAsync(actorId,u.IdUsuario);await MostrarAsync(r);if(r.Success)await CargarAsync();} private async Task ConfirmarBajaAsync(AliadoUsuarioAdminRow u){if(!await AlertService.ConfirmAsync("Se dara de baja al usuario seleccionado.","Dar de baja usuario","Si, dar de baja"))return;var r=await AliadoService.ActualizarEstadoUsuarioAliadoAsync(actorId,u.IdUsuario,false);await MostrarAsync(r);if(r.Success)await CargarAsync();} private async Task MostrarAsync((bool Success,string Message) r){if(r.Success)await AlertService.ShowSuccessAsync(r.Message);else await AlertService.ShowWarningAsync(r.Message);}
 private void CargarAvatares(){var p=Path.Combine(Env.WebRootPath,"images","Avatars");Directory.CreateDirectory(p);avatarFiles=Directory.GetFiles(p).Select(Path.GetFileName).Where(x=>x is not null&&(x.EndsWith(".png",StringComparison.OrdinalIgnoreCase)||x.EndsWith(".jpg",StringComparison.OrdinalIgnoreCase)||x.EndsWith(".jpeg",StringComparison.OrdinalIgnoreCase))).OrderBy(x=>string.Equals(x,"default.png",StringComparison.OrdinalIgnoreCase)?0:1).ThenBy(x=>x).ToList()!;}
 private async Task SubirAvatarAsync(InputFileChangeEventArgs e){var f=e.File;if(f.Size>2*1024*1024){await AlertService.ShowWarningAsync("El tamaño máximo es 2 MB.");return;}var ext=Path.GetExtension(f.Name).ToLowerInvariant();if(ext is not ".png" and not ".jpg" and not ".jpeg"){await AlertService.ShowWarningAsync("Formato no permitido.");return;}var p=Path.Combine(Env.WebRootPath,"images","Avatars",$"avatar_{Guid.NewGuid():N}{ext}");await using var input=f.OpenReadStream(2*1024*1024);await using var output=File.Create(p);await input.CopyToAsync(output);CargarAvatares();}
 private async Task EliminarAvatarAsync(string n){if(!await AlertService.ConfirmAsync("Se eliminara el avatar seleccionado.","Eliminar avatar","Si, eliminar"))return;var url=$"/images/Avatars/{n}";var r=await AliadoService.LimpiarAvatarUsuariosAliadosAsync(actorId,url);if(!r.Success){await MostrarAsync(r);return;}var root=Path.GetFullPath(Path.Combine(Env.WebRootPath,"images","Avatars"));var p=Path.GetFullPath(Path.Combine(root,n));if(p.StartsWith(root,StringComparison.OrdinalIgnoreCase)&&File.Exists(p))File.Delete(p);CargarAvatares();await CargarAsync();}
 private string? Validar(){tempUser.Nombres=tempUser.Nombres.Trim();tempUser.Apellidos=tempUser.Apellidos.Trim();tempUser.Email=tempUser.Email.Trim();if(tempUser.Nombres.Length<2||tempUser.Apellidos.Length<2)return "Nombres y apellidos son obligatorios.";if(!System.Net.Mail.MailAddress.TryCreate(tempUser.Email,out _))return "El correo corporativo no es válido.";if(!string.IsNullOrWhiteSpace(tempUser.Identificacion)&&(!tempUser.Identificacion.All(char.IsDigit)||tempUser.Identificacion.Length is not(10 or 13)))return "La identificación debe tener 10 o 13 dígitos.";if(tempUser.IdUsuario==0&&tempUser.Password.Trim().Length<8)return "La contraseña inicial debe tener al menos 8 caracteres.";if(tempUser.Porcentaje<0||tempUser.Porcentaje>100)return "La comisión debe estar entre 0 y 100.";return null;}
 private static bool TieneAvatar(string? u)=>!string.IsNullOrWhiteSpace(u); private static bool EsMismoAvatar(string? a,string? b)=>string.Equals(ResolveAvatarUrl(a),ResolveAvatarUrl(b),StringComparison.OrdinalIgnoreCase); private static string ResolveAvatarUrl(string? u){if(string.IsNullOrWhiteSpace(u))return string.Empty;var v=u.Trim().Replace('\\','/');return v.StartsWith("http",StringComparison.OrdinalIgnoreCase)||v.StartsWith("data:",StringComparison.OrdinalIgnoreCase)?v:"/"+v.TrimStart('/');} private static string FormatFecha(DateTime? f)=>f?.ToString("yyyy-MM-dd")??string.Empty; private static string FormatFechaDetalle(DateTime? f)=>f?.ToString("dd/MM/yyyy")??"No registrada";
 private sealed class UsuarioForm{public int IdUsuario{get;set;}public string Nombres{get;set;}=string.Empty;public string Apellidos{get;set;}=string.Empty;public string Email{get;set;}=string.Empty;public string Password{get;set;}=string.Empty;public string? Identificacion{get;set;}public DateTime? FechaNacimiento{get;set;}public string? AvatarUrl{get;set;}public decimal Porcentaje{get;set;}=30m;public bool EsAdministrador{get;set;}}
}
