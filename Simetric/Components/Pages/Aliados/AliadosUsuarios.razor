@page "/aliados/admin/usuarios"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Usuarios | Portal de Aliados</PageTitle>

<style>
    .ally-users-hero{background:linear-gradient(135deg,#fff4f7,#fff 60%,#f8f2f5)!important;border-color:#ead2db!important}.ally-users-hero>div:first-child>span{color:#7b1e3a!important}.ally-users-primary{background:linear-gradient(135deg,#7b1e3a,#a33a5c)!important}.ally-users-secondary{border-color:#dfbdca!important;color:#7b1e3a!important}.ally-users-kpis article:first-child{background:linear-gradient(135deg,#f5e4ea,#fff)!important;border-color:#ead2db!important}.ally-users-role{background:#f3e2e8!important;color:#7b1e3a!important}.ally-users-person img,.ally-users-person>i{background:#f3e2e8!important;color:#7b1e3a!important}.ally-users-row-actions{display:flex;gap:.35rem}.ally-users-row-actions button{width:34px;height:34px;border:0;border-radius:9px;background:#f3e8ec;color:#7b1e3a;cursor:pointer}.ally-users-row-actions button:hover{background:#7b1e3a;color:#fff}.ally-users-row-actions button.danger{background:#fff0f2;color:#bd3150}.ally-users-modal header{background:linear-gradient(135deg,#7b1e3a,#a33a5c)!important}
</style>

<div class="ally-users-page">
    <section class="ally-users-hero" style="position:relative">
        <div><span>ADMINISTRACIÓN DE ACCESOS</span><h2>Usuarios de aliados</h2><p>Consulta las cuentas que tienen acceso al Portal de Aliados y crea nuevos accesos comerciales.</p></div>
        <div class="ally-users-actions"><NavLink href="/aliados/admin" class="ally-users-secondary"><i class="ri-arrow-left-line"></i> Administración</NavLink><button type="button" class="ally-users-primary" @onclick="AbrirCrear"><i class="ri-user-add-line"></i> Nuevo usuario</button></div>
        <div class="ally-users-kpis"><article><small>USUARIOS REGISTRADOS</small><strong>@usuarios.Count</strong><span>Cuentas propias del portal.</span></article><article><small>USUARIOS ACTIVOS</small><strong>@usuarios.Count(x => x.Activo && !x.Bloqueado)</strong><span>Acceso habilitado actualmente.</span></article><article><small>CUENTAS BLOQUEADAS</small><strong>@usuarios.Count(x => x.Bloqueado)</strong><span>Requieren intervención administrativa.</span></article></div>
    </section>

    <section class="ally-users-panel">
        <div class="ally-users-panel-head"><div><span>DIRECTORIO ADMINISTRATIVO</span><h3>Control de usuarios</h3></div><div class="ally-users-search"><i class="ri-search-line"></i><input @bind="filtro" @bind:event="oninput" placeholder="Buscar por nombre, correo o aliado" /></div></div>
        <div class="ally-users-table-wrap"><table class="ally-users-table"><thead><tr><th>USUARIO</th><th>ALIADO / CANAL</th><th>ROL</th><th>SEGURIDAD</th><th>ACCIONES</th></tr></thead><tbody>
            @if (!UsuariosFiltrados.Any()) { <tr><td colspan="5" class="ally-users-empty">No hay usuarios de aliados para mostrar.</td></tr> }
            @foreach (var usuario in UsuariosFiltrados)
            {
                <tr @key="usuario.IdUsuario"><td><div class="ally-users-person">@if (!string.IsNullOrWhiteSpace(usuario.AvatarUrl)) { <img src="@usuario.AvatarUrl" alt="" /> } else { <i class="ri-user-3-line"></i> }<span><strong>@usuario.Nombre</strong><small>@usuario.Email</small></span></div></td><td><strong>@(usuario.Aliado ?? "Administración del portal")</strong><small>@(usuario.CodigoReferencia ?? "Sin canal comercial")</small></td><td><b class="ally-users-role">@usuario.Rol</b></td><td><span class="ally-users-status @(usuario.Activo && !usuario.Bloqueado ? "ok" : "off")"><i class="@(usuario.Bloqueado ? "ri-lock-line" : "ri-lock-unlock-line")"></i> @(usuario.Bloqueado ? "Bloqueada" : usuario.Activo ? "Sin bloqueo" : "Inactiva")</span></td><td><div class="ally-users-row-actions"><button title="Ver usuario" type="button" @onclick="() => VerAsync(usuario)"><i class="ri-eye-line"></i></button><button title="Editar usuario" type="button" @onclick="() => AbrirEditar(usuario)"><i class="ri-pencil-line"></i></button><button title="@(usuario.Activo ? "Eliminar acceso" : "Activar acceso")" type="button" class="danger" @onclick="() => CambiarEstadoAsync(usuario)" disabled="@guardandoEstado"><i class="@(usuario.Activo ? "ri-user-forbid-line" : "ri-user-follow-line")"></i></button></div></td></tr>
            }
        </tbody></table></div>
    </section>
</div>

@if (mostrarCrear)
{
    <div class="ally-users-modal-backdrop" @onclick="CerrarCrear"><section class="ally-users-modal" role="dialog" aria-modal="true" aria-labelledby="nuevo-usuario-title" @onclick:stopPropagation="true"><header><div><span>PERFIL DE USUARIO</span><h3 id="nuevo-usuario-title">@(usuarioEditando is null ? "Nuevo registro de usuario" : "Editar usuario")</h3></div><button type="button" aria-label="Cerrar" @onclick="CerrarCrear">×</button></header><div class="ally-users-modal-body"><aside><i class="ri-user-add-line"></i><strong>Cuenta de aliado</strong><small>Se creará un canal comercial y se enviará una clave temporal al usuario.</small></aside><div class="ally-users-form"><label>Nombre completo<input @bind="nombre" placeholder="Nombres y apellidos" /></label><label>Correo corporativo<input type="email" @bind="email" placeholder="correo@empresa.com" /></label>@if (usuarioEditando is null) { <label>Clave inicial<input type="password" @bind="password" placeholder="Mínimo 8 caracteres" /></label><label>Comisión base (%)<input type="number" min="0" max="100" step="0.01" @bind="porcentaje" /></label> }<p><i class="ri-information-line"></i> La cuenta tendrá el rol Aliado Comercial.</p></div></div><footer><button type="button" class="ally-users-secondary" @onclick="CerrarCrear">Cancelar</button><button type="button" class="ally-users-primary" @onclick="GuardarUsuarioAsync" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar usuario")</button></footer></section></div>
}

@code {
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;
    private List<AliadoUsuarioAdminRow> usuarios = new();
    private int actorId;
    private string filtro = string.Empty;
    private string nombre = string.Empty, email = string.Empty, password = string.Empty;
    private decimal porcentaje = 30m;
    private bool mostrarCrear, guardando, guardandoEstado;
    private AliadoUsuarioAdminRow? usuarioEditando;
    private IEnumerable<AliadoUsuarioAdminRow> UsuariosFiltrados => usuarios.Where(x => string.IsNullOrWhiteSpace(filtro) || x.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase) || x.Email.Contains(filtro, StringComparison.OrdinalIgnoreCase) || (x.Aliado?.Contains(filtro, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out actorId);
        await CargarAsync();
    }

    private async Task CargarAsync() => usuarios = (await AliadoService.ListarUsuariosAliadosAsync(actorId)).ToList();
    private void AbrirCrear() { usuarioEditando = null; nombre = email = password = string.Empty; porcentaje = 30m; mostrarCrear = true; }
    private void AbrirEditar(AliadoUsuarioAdminRow usuario) { usuarioEditando = usuario; nombre = usuario.Nombre; email = usuario.Email; mostrarCrear = true; }
    private void CerrarCrear() { if (!guardando) mostrarCrear = false; }
    private async Task CrearAsync()
    {
        if (guardando) return;
        guardando = true;
        try
        {
            var resultado = await AliadoService.CrearCuentaAliadoAsync(actorId, nombre, email, password, porcentaje);
            if (resultado.Success) { mostrarCrear = false; await CargarAsync(); await AlertService.ShowSuccessAsync(resultado.Message, "Usuario creado"); }
            else await AlertService.ShowWarningAsync(resultado.Message, "No se pudo crear");
        }
        finally { guardando = false; }
    }
    private async Task GuardarUsuarioAsync()
    {
        if (usuarioEditando is null) { await CrearAsync(); return; }
        guardando = true;
        try { var resultado = await AliadoService.ActualizarUsuarioAliadoAsync(actorId, usuarioEditando.IdUsuario, nombre, email); if (resultado.Success) { mostrarCrear = false; await CargarAsync(); await AlertService.ShowSuccessAsync(resultado.Message, "Usuario actualizado"); } else await AlertService.ShowWarningAsync(resultado.Message, "No se pudo actualizar"); }
        finally { guardando = false; }
    }
    private Task VerAsync(AliadoUsuarioAdminRow usuario) => AlertService.ShowInfoAsync($"{usuario.Nombre}\n{usuario.Email}\nRol: {usuario.Rol}\nCanal: {usuario.Aliado ?? "Administración del portal"}", "Datos del usuario").AsTask();
    private async Task CambiarEstadoAsync(AliadoUsuarioAdminRow usuario)
    {
        if (guardandoEstado) return;
        guardandoEstado = true;
        try
        {
            var resultado = await AliadoService.ActualizarEstadoUsuarioAliadoAsync(actorId, usuario.IdUsuario, !usuario.Activo);
            if (resultado.Success) { await CargarAsync(); await AlertService.ShowSuccessAsync(resultado.Message, "Estado actualizado"); }
            else await AlertService.ShowWarningAsync(resultado.Message, "No se pudo actualizar");
        }
        finally { guardandoEstado = false; }
    }
}
