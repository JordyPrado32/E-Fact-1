@page "/aliados/admin/usuarios"
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider
@inject SweetAlertService AlertService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{ var usuariosVisibles = UsuariosFiltrados.ToList(); }
<PageTitle>Usuarios | Portal de Aliados</PageTitle>

<div class="users-shell" data-tour="usuarios.page">
 <section class="users-hero" data-tour="usuarios.hero">
  <div class="hero-copy"><span class="hero-eyebrow">Administracion de accesos</span><h2>Usuarios de aliados</h2><p>Gestione perfiles, roles y seguridad del Portal de Aliados desde una vista unificada.</p></div>
  <div class="hero-actions"><button type="button" class="secondary-btn" @onclick="AbrirGestorAvatares"><i class="bi bi-images"></i><span>Galeria de avatares</span></button><button type="button" class="secondary-btn" @onclick="AbrirAsignacion"><i class="bi bi-person-plus"></i><span>Asignar clientes</span></button><button type="button" class="primary-btn" @onclick="AbrirCrear"><i class="bi bi-person-plus-fill"></i><span>Nuevo usuario</span></button></div>
  <div class="hero-summary"><article class="summary-card summary-card-primary"><span class="summary-label">Usuarios registrados</span><strong>@usuarios.Count</strong><small>Cuentas exclusivas del Portal de Aliados.</small></article><article class="summary-card"><span class="summary-label">Usuarios activos</span><strong>@usuarios.Count(x => x.Activo)</strong><small>Perfiles con acceso habilitado actualmente.</small></article><article class="summary-card"><span class="summary-label">Cuentas bloqueadas</span><strong>@usuarios.Count(x => x.Bloqueado)</strong><small>Usuarios que requieren intervencion administrativa.</small></article></div>
 </section>
 <section class="table-card">
  <div class="table-card-head"><div><span class="table-kicker">Directorio administrativo</span><h3>Control de usuarios</h3></div><div class="d-flex align-items-center gap-2"><input class="form-control" style="max-width:260px" @bind="filtro" @bind:event="oninput" placeholder="Buscar usuario"/><span class="table-badge">@usuariosVisibles.Count registrados</span></div></div>
  @if(isLoading){<AllyLoadingState Title="Cargando usuarios" Description="Preparando la información de acceso, roles y seguridad." />}
  else if(!usuariosVisibles.Any()){<div class="state-card state-card-empty"><div class="state-icon"><i class="bi bi-people"></i></div><h3>No hay usuarios</h3><p>Cree un nuevo usuario para comenzar.</p></div>}
  else {<div class="table-wrap"><table class="table users-table mb-0"><thead><tr><th>Usuario</th><th>Aliado / canal</th><th>Rol</th><th class="text-end">Acciones</th></tr></thead><tbody>
   @foreach(var u in usuariosVisibles){<tr @key="u.IdUsuario"><td><div class="user-cell">@if(TieneAvatar(u.AvatarUrl)){<img src="@ResolveAvatarUrl(u.AvatarUrl)" alt="Avatar de @u.Nombre" class="user-avatar"/>}else{<span class="user-avatar avatar-default"><i class="bi bi-person-fill"></i></span>}<div class="cell-main"><strong>@u.Nombre</strong><span>@u.Email</span></div></div></td><td><div class="cell-main"><strong>@(u.Aliado??"Administracion del portal")</strong></div></td><td><span class="role-pill">@RolVisible(u.Rol)</span></td><td class="text-end"><div class="action-group"><button type="button" class="action-btn action-view" title="Ver detalles" @onclick="()=>VerDetalle(u)"><i class="bi bi-eye"></i></button><button type="button" class="action-btn action-edit" title="Editar usuario" @onclick="()=>AbrirEditar(u)"><i class="bi bi-pencil-square"></i></button><button type="button" class="action-btn action-reset" title="Resetear clave" @onclick="()=>ResetearPasswordAsync(u)"><i class="bi bi-shield-lock"></i></button>@if(u.Bloqueado){<button type="button" class="action-btn action-unlock" title="Desbloquear usuario" @onclick="()=>DesbloquearAsync(u)"><i class="bi bi-unlock"></i></button>}<button type="button" class="action-btn action-delete" title="Dar de baja" disabled="@(!u.Activo)" @onclick="()=>ConfirmarBajaAsync(u)"><i class="bi bi-person-x"></i></button></div></td></tr>}
  </tbody></table></div>}
 </section>
</div>

@if(showModal){<div class="users-modal-backdrop"></div><div class="users-modal users-modal-lg" role="dialog" aria-modal="true"><div class="users-modal-content">
 <div class="users-modal-header users-modal-header-primary"><div><span class="modal-kicker">Perfil de usuario</span><h3>@(tempUser.IdUsuario==0?"Nuevo registro de usuario":"Modificar usuario")</h3></div><button type="button" class="modal-close" @onclick="CerrarModal"><i class="bi bi-x-lg"></i></button></div>
 <form class="users-modal-body" autocomplete="off">@if(tempUser.IdUsuario == 0 && !tempUser.EsAdministrador){<Simetric.Components.AliadoCuentaBancariaFields Cuenta="tempUser.CuentaBancaria" />}@if(errorFormulario is not null){<div class="alert alert-danger rounded-3 border-0 shadow-sm mb-3">@errorFormulario</div>}<div class="form-layout">
  <aside class="avatar-panel"><div class="avatar-preview-wrap">@if(TieneAvatar(tempUser.AvatarUrl)){<img src="@ResolveAvatarUrl(tempUser.AvatarUrl)" alt="Avatar" class="avatar-preview"/>}else{<span class="avatar-preview avatar-default avatar-default-large"><i class="bi bi-person-fill"></i></span>}<button type="button" class="avatar-trigger" @onclick="()=>showAvatarSelector=!showAvatarSelector"><i class="bi bi-camera"></i></button></div><div class="avatar-copy"><strong>Imagen de perfil</strong><span>Seleccione un avatar<br />del catálogo compartido.</span></div>@if(showAvatarSelector){<div class="avatar-selector">@foreach(var avatar in avatarFiles){var url=$"/images/Avatars/{avatar}";<button type="button" class="avatar-selector-item @(EsMismoAvatar(tempUser.AvatarUrl,url)?"avatar-selector-item-selected":"")" @onclick="()=>SeleccionarAvatar(url)"><img src="@url" alt="Avatar disponible"/></button>}</div>}</aside>
  <div class="form-grid"><div class="form-field"><label class="field-label required">Tipo de cliente</label><select @bind="tempUser.TipoCliente" @bind:after="NormalizarTipoCliente" class="form-select field-input" name="new-user-client-type" autocomplete="off" required><option value="1">Persona natural</option><option value="2">Empresa</option></select></div><div class="form-field"><label class="field-label required">Tipo de documento</label><select @bind="tempUser.TipoDocumento" class="form-select field-input" name="new-user-document-type" autocomplete="off" required><option value="CEDULA">Cédula</option><option value="RUC">RUC</option><option value="PASAPORTE">Pasaporte</option><option value="EXTERIOR">Identificación del exterior</option></select></div>@if(tempUser.TipoCliente==2){<div class="form-field"><label class="field-label required">Razón social</label><input @bind="tempUser.RazonSocial" class="form-control field-input" name="new-user-business-name" required minlength="3" maxlength="150" autocomplete="off" placeholder="Ej. Empresa Ejemplo S.A."/></div><div class="form-field"><label class="field-label required">Nombre comercial</label><input @bind="tempUser.NombreComercial" class="form-control field-input" name="new-user-trade-name" required minlength="2" maxlength="150" autocomplete="off" placeholder="Ej. Empresa Ejemplo"/></div>}else{<div class="form-field"><label class="field-label required">Nombres</label><input @bind="tempUser.Nombres" class="form-control field-input" name="new-user-first-name" required minlength="2" maxlength="80" autocomplete="off" placeholder="Ej. María Fernanda"/></div><div class="form-field"><label class="field-label required">Apellidos</label><input @bind="tempUser.Apellidos" class="form-control field-input" name="new-user-last-name" required minlength="2" maxlength="80" autocomplete="off" placeholder="Ej. González Pérez"/></div>}<div class="form-field"><label class="field-label required">Identificación</label><input @bind="tempUser.Identificacion" class="form-control field-input" name="new-user-identification" required maxlength="20" autocomplete="off" placeholder="Ingresa cédula, RUC o pasaporte"/></div><div class="form-field"><label class="field-label required">Email corporativo</label><input @bind="tempUser.Email" type="email" class="form-control field-input" name="new-user-email" required maxlength="254" autocomplete="new-password" placeholder="usuario@empresa.com"/></div><div class="form-field"><label class="field-label required">Teléfono</label><input @bind="tempUser.Celular" class="form-control field-input" name="new-user-phone" inputmode="tel" required maxlength="15" autocomplete="off" placeholder="Ej. 0991234567"/></div><div class="form-field"><label class="field-label @(tempUser.TipoCliente != 2 ? "required" : "")">Fecha de nacimiento</label><input type="date" class="form-control field-input" name="new-user-birthdate" value="@FormatFecha(tempUser.FechaNacimiento)" @onchange="OnFechaChanged" required="@(tempUser.TipoCliente != 2)" disabled="@(tempUser.TipoCliente==2)" autocomplete="off" max="@DateTime.Today.ToString("yyyy-MM-dd")"/></div><div class="form-field form-field-wide"><label class="field-label required">Dirección fiscal</label><input @bind="tempUser.Direccion" class="form-control field-input" name="new-user-address" required minlength="5" maxlength="100" autocomplete="off" placeholder="Ej. Av. Principal 123 y calle Secundaria"/></div><div class="form-field"><label class="field-label required">Rol asignado</label><select @bind="tempUser.EsAdministrador" class="form-select field-input" name="new-user-role" autocomplete="off" required disabled="@(!puedeCrearAdministrador || tempUser.IdUsuario==actorId)"><option value="false">Aliado Comercial</option>@if(puedeCrearAdministrador){<option value="true">Administrador Portal de Aliados</option>}</select></div>@if(tempUser.IdUsuario==0){<div class="form-field"><label class="field-label required">Contraseña inicial</label><input @bind="tempUser.Password" type="password" class="form-control field-input field-input-accent" name="new-user-password" required minlength="8" autocomplete="new-password" placeholder="Mínimo 8: Mayúscula, minúscula, número y símbolo"/></div><div class="form-note form-field-wide"><i class="bi bi-info-circle"></i><span>La cuenta se registrará exclusivamente en el Portal de Aliados y deberá cambiar su clave al ingresar.</span></div>}</div>
  </div></form><div class="users-modal-footer"><button type="button" class="secondary-btn secondary-btn-quiet" @onclick="CerrarModal">Cancelar</button><button type="button" class="primary-btn" @onclick="GuardarAsync" disabled="@guardando"><i class="bi bi-save"></i><span>@(guardando?"Guardando...":"Guardar cambios")</span></button></div>
</div></div>}

@if(showAssignmentModal)
{
 <div class="users-modal-backdrop"></div>
 <div class="users-modal users-modal-xl" role="dialog" aria-modal="true">
  <div class="users-modal-content">
   <div class="users-modal-header users-modal-header-secondary"><div><span class="modal-kicker">Comisiones futuras</span><h3>Asignar clientes a un aliado</h3></div><button type="button" class="modal-close" @onclick="CerrarAsignacion"><i class="bi bi-x-lg"></i></button></div>
   <div class="users-modal-body">
    <p class="assignment-help">Se muestran únicamente cuentas activas con clientes activos. Las comisiones históricas no se transfieren.</p>
    <div class="assignment-toolbar">
     <div class="assignment-ally-picker">
      <label for="assignment-ally-search"><span class="assignment-step">1</span> Primero busca el aliado destino</label>
      <input id="assignment-ally-search" class="form-control field-input" @bind="busquedaAliadoAsignacion" @bind:event="oninput" @bind:after="LimpiarAliadoDestino" placeholder="Escribe y selecciona un aliado..." autocomplete="off" />
      @if (AliadosPredictivos.Any())
      {
       <div class="assignment-suggestions">@foreach (var aliado in AliadosPredictivos) { <button type="button" class="assignment-suggestion" @onclick="() => SeleccionarAliadoAsignacion(aliado)"><strong>@aliado.Nombre</strong></button> }</div>
      }
      @if (idVendedorDestino > 0) { <span class="assignment-selected-ally"><i class="bi bi-check-circle-fill"></i> Aliado seleccionado: @AliadoDestinoNombre</span> } else { <span class="assignment-ally-hint">Selecciona una sugerencia para continuar.</span> }
     </div>
      <input class="form-control field-input assignment-search" @bind="filtroAsignacion" @bind:event="oninput" @bind:after="ReiniciarPaginaAsignacion" placeholder="2. Buscar cliente, identificación o correo..." disabled="@(idVendedorDestino <= 0)" />
      <select class="form-select field-input assignment-status-filter" @bind="filtroAliadoAsignacion" @bind:after="ReiniciarPaginaAsignacion" disabled="@(idVendedorDestino <= 0)"><option value="todos">Todos los clientes</option><option value="sin">Sin aliado</option><option value="con">Con aliado</option></select>
     <button type="button" class="primary-btn assignment-bulk-button" @onclick="AsignarSeleccionadosAsync" disabled="@(guardandoAsignacion || idVendedorDestino <= 0 || !usuariosSeleccionados.Any())"><i class="bi bi-people-fill"></i> Asignar seleccionados (@usuariosSeleccionados.Count)</button>
    </div>
    @if(cargandoAsignacion)
    {
     <AllyLoadingState Title="Cargando usuarios" Description="Consultando las cuentas activas de E-Fact." />
    }
    else if(!UsuariosAsignacionFiltrados.Any())
    {
     <div class="state-card state-card-empty"><div class="state-icon"><i class="bi bi-person-x"></i></div><h3>No hay clientes para asignar</h3><p>Prueba con otro filtro.</p></div>
    }
    else
    {
     <div class="table-wrap assignment-table-wrap"><table class="table users-table assignment-table mb-0"><colgroup><col class="assignment-check-column" /><col class="assignment-client-column" /><col /><col class="assignment-ally-column" /><col class="assignment-action-column" /></colgroup><thead><tr><th class="assignment-check-cell"><input type="checkbox" checked="@TodosSeleccionados" @onchange="AlternarSeleccionTodos" aria-label="Seleccionar todos los clientes visibles" /></th><th>Cliente</th><th>Contacto</th><th>Aliado actual</th><th class="text-end">Acción</th></tr></thead><tbody>@foreach(var usuario in UsuariosAsignacionPagina){<tr @key="usuario.IdUsuario"><td class="assignment-check-cell"><input type="checkbox" checked="@usuariosSeleccionados.Contains(usuario.IdUsuario)" @onchange="e => AlternarSeleccionUsuario(usuario.IdUsuario, e)" aria-label="Seleccionar @usuario.Nombre" /></td><td><strong>@usuario.Nombre</strong><small class="assignment-client-id">@(usuario.Identificacion??"Sin identificación")</small></td><td>@(usuario.Correo??"Sin correo")</td><td><span class="status-pill @(usuario.IdVendedorActual.HasValue?"status-pill-inactive":"status-pill-active")">@(usuario.AliadoActual??"Sin aliado")</span>@if(usuario.IdVendedorActual.HasValue){<small class="d-block">Solo cambia la asignación futura</small>}</td><td class="text-end"><button type="button" class="assignment-row-button" title="Asignar cliente" aria-label="Asignar @usuario.Nombre" @onclick="()=>AsignarUsuarioAsync(usuario)" disabled="@(guardandoAsignacion||idVendedorDestino<=0)"><i class="bi bi-person-check-fill"></i></button></td></tr>}</tbody></table></div>
     @if(TotalPaginasAsignacion>1){<nav class="assignment-pagination" aria-label="Paginación de clientes"><button type="button" class="pagination-btn" @onclick="PaginaAnteriorAsignacion" disabled="@(paginaAsignacion<=1)" aria-label="Página anterior"><i class="bi bi-chevron-left"></i></button><span>Página @paginaAsignacion de @TotalPaginasAsignacion</span><button type="button" class="pagination-btn" @onclick="PaginaSiguienteAsignacion" disabled="@(paginaAsignacion>=TotalPaginasAsignacion)" aria-label="Página siguiente"><i class="bi bi-chevron-right"></i></button></nav>}
    }
   </div>
   <div class="users-modal-footer"><button type="button" class="secondary-btn secondary-btn-quiet" @onclick="CerrarAsignacion">Cerrar</button></div>
  </div>
 </div>
}

 @if(showDetailModal && usuarioSeleccionado is not null){<div class="users-modal-backdrop"></div><div class="users-modal users-modal-lg" role="dialog" aria-modal="true"><div class="users-modal-content"><div class="users-modal-header users-modal-header-secondary"><div><span class="modal-kicker">Detalle de usuario</span><h3>@usuarioSeleccionado.Nombre</h3></div><button type="button" class="modal-close" @onclick="CerrarDetalle"><i class="bi bi-x-lg"></i></button></div><div class="users-modal-body"><div class="detail-layout"><aside class="detail-profile">@if(TieneAvatar(usuarioSeleccionado.AvatarUrl)){<img src="@ResolveAvatarUrl(usuarioSeleccionado.AvatarUrl)" alt="Avatar" class="detail-avatar"/>}else{<span class="detail-avatar avatar-default avatar-default-large"><i class="bi bi-person-fill"></i></span>}<h4>@usuarioSeleccionado.Nombre</h4><span class="role-pill">@usuarioSeleccionado.Rol</span><span class="status-pill @(usuarioSeleccionado.Activo?"status-pill-active":"status-pill-inactive")">@(usuarioSeleccionado.Activo?"Usuario activo":"Usuario inactivo")</span></aside><div class="detail-sections"><section class="detail-section"><span class="detail-kicker">Contacto e identificacion</span><div class="detail-grid"><article class="detail-item"><span>Email</span><strong>@usuarioSeleccionado.Email</strong></article><article class="detail-item"><span>Fecha de nacimiento</span><strong>@FormatFechaDetalle(usuarioSeleccionado.FechaNacimiento)</strong></article><article class="detail-item"><span>Identificacion</span><strong>@(usuarioSeleccionado.Identificacion??"No registrada")</strong></article><article class="detail-item"><span>Canal comercial</span><strong>@(usuarioSeleccionado.CodigoReferencia??"No aplica")</strong></article><article class="detail-item"><span>Rol</span><strong>@usuarioSeleccionado.Rol</strong></article></div></section><section class="detail-section"><span class="detail-kicker">Seguridad de la cuenta</span><div class="detail-grid"><article class="detail-item"><span>Bloqueo</span><strong>@(usuarioSeleccionado.Bloqueado?"Cuenta bloqueada":"Sin bloqueo")</strong></article><article class="detail-item"><span>Estado de clave</span><strong>@(usuarioSeleccionado.ClaveTemporal?"Temporal":"Permanente")</strong></article></div></section></div></div></div><div class="users-modal-footer"><button type="button" class="secondary-btn secondary-btn-quiet" @onclick="CerrarDetalle">Cerrar</button></div></div></div>}

@if(showAvatarManager){<div class="users-modal-backdrop"></div><div class="users-modal users-modal-xl" role="dialog" aria-modal="true"><div class="users-modal-content"><div class="users-modal-header users-modal-header-dark"><div><span class="modal-kicker">Biblioteca visual compartida</span><h3>Galeria de avatares</h3></div><button type="button" class="modal-close" @onclick="()=>showAvatarManager=false"><i class="bi bi-x-lg"></i></button></div><div class="users-modal-body"><label class="upload-dropzone"><span class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></span><strong>Subir nuevo avatar</strong><small>JPG, JPEG y PNG. Maximo 2 MB.</small><InputFile OnChange="SubirAvatarAsync" accept=".jpg,.jpeg,.png" class="d-none"/></label><div class="avatar-gallery-grid">@foreach(var avatar in avatarFiles){var url=$"/images/Avatars/{avatar}";<article class="avatar-gallery-card">@if(!string.Equals(avatar,"default.png",StringComparison.OrdinalIgnoreCase)){<button type="button" class="avatar-gallery-remove" @onclick="()=>EliminarAvatarAsync(avatar)"><i class="bi bi-x-lg"></i></button>}<img src="@url" alt="Avatar almacenado" class="avatar-gallery-image"/></article>}</div></div></div></div>}

@code{
 private List<AliadoUsuarioAdminRow> usuarios=new(); private List<AliadoAdminRow> aliadosDisponibles=new(); private List<AliadoUsuarioAsignacionRow> usuariosAsignacion=new(); private List<string> avatarFiles=new(); private readonly HashSet<int> usuariosSeleccionados=new(); private UsuarioForm tempUser=new(); private AliadoUsuarioAdminRow? usuarioSeleccionado; private int actorId,idVendedorDestino; private string filtro=string.Empty,filtroAsignacion=string.Empty,busquedaAliadoAsignacion=string.Empty,filtroAliadoAsignacion="todos"; private string? errorFormulario; private bool isLoading=true,showModal,showDetailModal,showAvatarManager,showAvatarSelector,showAssignmentModal,cargandoAsignacion,guardandoAsignacion,guardando,puedeCrearAdministrador;
 private IEnumerable<AliadoUsuarioAdminRow> UsuariosFiltrados=>usuarios.Where(x=>string.IsNullOrWhiteSpace(filtro)||x.Nombre.Contains(filtro,StringComparison.OrdinalIgnoreCase)||x.Email.Contains(filtro,StringComparison.OrdinalIgnoreCase)||(x.Aliado?.Contains(filtro,StringComparison.OrdinalIgnoreCase)??false));
  private IEnumerable<AliadoAdminRow> AliadosPredictivos=>idVendedorDestino==0?aliadosDisponibles.Where(x=>x.Activo&&x.UsuarioActivo&&!string.IsNullOrWhiteSpace(busquedaAliadoAsignacion)&&x.Nombre.Contains(busquedaAliadoAsignacion,StringComparison.OrdinalIgnoreCase)).Take(3):Enumerable.Empty<AliadoAdminRow>();
 private string AliadoDestinoNombre=>aliadosDisponibles.FirstOrDefault(x=>x.IdVendedor==idVendedorDestino)?.Nombre??"Aliado seleccionado";
  private IEnumerable<AliadoUsuarioAsignacionRow> UsuariosAsignacionFiltrados=>usuariosAsignacion.Where(x=>(string.IsNullOrWhiteSpace(filtroAsignacion)||x.Nombre.Contains(filtroAsignacion,StringComparison.OrdinalIgnoreCase)||(x.Identificacion?.Contains(filtroAsignacion,StringComparison.OrdinalIgnoreCase)??false)||(x.Correo?.Contains(filtroAsignacion,StringComparison.OrdinalIgnoreCase)??false)||(x.AliadoActual?.Contains(filtroAsignacion,StringComparison.OrdinalIgnoreCase)??false))&&(filtroAliadoAsignacion=="todos"||(filtroAliadoAsignacion=="sin"&&!x.IdVendedorActual.HasValue)||(filtroAliadoAsignacion=="con"&&x.IdVendedorActual.HasValue)));
  private static string RolVisible(string rol)=>rol.Contains("Administrador",StringComparison.OrdinalIgnoreCase)?"Administrador":rol;
  private bool TodosSeleccionados=>UsuariosAsignacionFiltrados.Any()&&UsuariosAsignacionFiltrados.All(x=>usuariosSeleccionados.Contains(x.IdUsuario));
  private const int TamanoPaginaAsignacion=10;
  private int paginaAsignacion=1;
  private int TotalPaginasAsignacion=>Math.Max(1,(int)Math.Ceiling(UsuariosAsignacionFiltrados.Count()/(double)TamanoPaginaAsignacion));
  private IEnumerable<AliadoUsuarioAsignacionRow> UsuariosAsignacionPagina=>UsuariosAsignacionFiltrados.Skip((paginaAsignacion-1)*TamanoPaginaAsignacion).Take(TamanoPaginaAsignacion);
 protected override async Task OnInitializedAsync(){var auth=await AuthStateProvider.GetAuthenticationStateAsync();int.TryParse(auth.User.FindFirst("IdUsuario")?.Value,out actorId);puedeCrearAdministrador=auth.User.IsInRole(BackOfficePermissionHelper.SuperAdministradorRoleId.ToString());CargarAvatares();await CargarAsync();}
 private async Task CargarAsync(){isLoading=true;try{usuarios=(await AliadoService.ListarUsuariosAliadosAsync(actorId)).ToList();aliadosDisponibles=(await AliadoService.ListarAliadosAsync()).ToList();}finally{isLoading=false;}}
 private void AbrirCrear(){tempUser=new();errorFormulario=null;showAvatarSelector=false;showModal=true;} private void AbrirEditar(AliadoUsuarioAdminRow u){tempUser=new(){IdUsuario=u.IdUsuario,TipoCliente=u.TipoCliente,TipoDocumento=u.TipoDocumento,Nombres=u.Nombres,Apellidos=u.Apellidos,RazonSocial=u.RazonSocial??string.Empty,NombreComercial=u.NombreComercial??string.Empty,Email=u.Email,Identificacion=u.Identificacion,Celular=u.Celular??string.Empty,Direccion=u.Direccion??string.Empty,FechaNacimiento=u.FechaNacimiento,AvatarUrl=u.AvatarUrl,Porcentaje=u.PorcentajeComision??0m,EsAdministrador=u.Rol==AliadoPortalService.AdminRoleName};errorFormulario=null;showAvatarSelector=false;showModal=true;} private void CerrarModal(){if(!guardando)showModal=false;} private void VerDetalle(AliadoUsuarioAdminRow u){usuarioSeleccionado=u;showDetailModal=true;} private void CerrarDetalle(){showDetailModal=false;usuarioSeleccionado=null;} private void AbrirGestorAvatares(){CargarAvatares();showAvatarManager=true;} private void SeleccionarAvatar(string url){tempUser.AvatarUrl=url;showAvatarSelector=false;} private void OnFechaChanged(ChangeEventArgs e)=>tempUser.FechaNacimiento=DateTime.TryParse(e.Value?.ToString(),out var f)?f:null; private void NormalizarTipoCliente(){if(tempUser.TipoCliente==2)tempUser.TipoDocumento="RUC";else if(tempUser.TipoDocumento=="RUC")tempUser.TipoDocumento="CEDULA";}
