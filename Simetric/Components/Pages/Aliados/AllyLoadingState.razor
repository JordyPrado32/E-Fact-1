<section class="ally-loading-state" aria-busy="true" aria-live="polite">
    <span class="ally-loading-state-icon">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </span>
    <h3>@Title</h3>
    <p>@Description</p>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = "Preparando tu información.";
}
