@page "/aliados"
@page "/aliados/inicio"

<PageTitle>Inicio | Portal de Aliados</PageTitle>

@if (modelo is null)
{
    <div class="ally-empty">No se pudo cargar la información del aliado.</div>
}
else
{
    <div class="ally-dashboard">
        <section class="ally-dashboard-hero">
            <div class="ally-dashboard-hero-copy">
                <span>CICLO COMERCIAL</span>
                <h1>¡Bienvenida, @PrimerNombre!</h1>
                <p>Aquí puedes consultar tus clientes, renovaciones y comisiones.</p>
            </div>
            <NavLink class="ally-dashboard-button is-light" href="/aliados/clientes">Ver mis clientes <i class="ri-arrow-right-line"></i></NavLink>
        </section>

        <section class="ally-sales-link">
            <div class="ally-sales-link-title">
                <span class="ally-dashboard-icon"><i class="ri-links-line"></i></span>
                <div><strong>Mi enlace de ventas</strong><small>Comparte este enlace con tus clientes para que puedan adquirir nuestros productos.</small></div>
            </div>
            <div class="ally-sales-link-actions">
                <div class="ally-sales-link-value"><span>@EnlaceAbsoluto</span><button type="button" title="Copiar enlace" aria-label="Copiar enlace" @onclick="CopiarEnlace"><i class="ri-file-copy-line"></i></button></div>
                <button type="button" class="ally-dashboard-button" @onclick="CopiarEnlace"><i class="ri-file-copy-line"></i> Copiar enlace</button>
            </div>
        </section>

        <section class="ally-dashboard-kpis">
            <article class="ally-dashboard-kpi"><span class="ally-dashboard-icon"><i class="ri-bar-chart-fill"></i></span><div><small>Ventas generadas</small><strong>@Dinero(modelo.VentasPeriodo)</strong><p>@modelo.VentasCantidad venta(s) en el período actual</p></div></article>
            <article class="ally-dashboard-kpi"><span class="ally-dashboard-icon"><i class="ri-coins-line"></i></span><div><small>Comisiones generadas</small><strong>@Dinero(modelo.ComisionesGeneradas)</strong><p>Sobre valores cobrados sin IVA</p></div></article>
            <article class="ally-dashboard-kpi"><span class="ally-dashboard-icon"><i class="ri-time-line"></i></span><div><small>Pendientes de aprobación</small><strong>@Dinero(modelo.ComisionesPendientesAprobacion)</strong><p>En proceso de revisión interna</p></div></article>
            <article class="ally-dashboard-kpi"><span class="ally-dashboard-icon"><i class="ri-calendar-event-line"></i></span><div><small>Próximas renovaciones</small><strong>@modelo.RenovacionesProximas</strong><p>Dentro de los próximos 30 días</p></div></article>
        </section>

        @if (modelo.RenovacionesUrgentes > 0)
        {
            <section class="ally-dashboard-alert">
                <span class="ally-alert-icon"><i class="ri-alert-fill"></i></span>
                <div><strong>Tienes @modelo.RenovacionesUrgentes renovación(es) que requieren gestión esta semana</strong><small>Contacta a tus clientes para asegurar la continuidad de sus productos.</small></div>
                <NavLink class="ally-dashboard-button" href="/aliados/renovaciones">Ver renovaciones <i class="ri-arrow-right-line"></i></NavLink>
            </section>
        }

        <div class="ally-dashboard-content">
            <div class="ally-dashboard-main-column">
                <section class="ally-dashboard-panel">
                    <header><h2><i class="ri-file-list-3-line"></i> Renovaciones urgentes</h2><NavLink href="/aliados/renovaciones">Ver todas <i class="ri-arrow-right-line"></i></NavLink></header>
                    @if (modelo.Renovaciones.Count == 0)
                    {
                        <div class="ally-dashboard-empty">No tienes renovaciones próximas.</div>
                    }
                    else
                    {
                        <div class="ally-dashboard-table-wrap">
                            <table class="ally-dashboard-table">
                                <thead><tr><th>Cliente</th><th>Producto</th><th>Vence</th><th>Días restantes</th><th>Estado</th><th>Acción</th></tr></thead>
                                <tbody>
                                    @foreach (var item in modelo.Renovaciones)
                                    {
                                        <tr @key="item.IdFactura">
                                            <td>@item.Cliente</td><td>@item.Producto</td><td>@item.FechaVencimiento.ToString("dd MMM. yyyy")</td>
                                            <td><span class="ally-days @(item.DiasRestantes <= 7 ? "is-urgent" : null)">@item.DiasRestantes días</span></td>
                                            <td><span class="ally-status @EstadoCss(item.EstadoGestion)"><i></i>@item.EstadoGestion</span></td>
                                            <td><NavLink class="ally-manage-button" href="/aliados/renovaciones">Gestionar</NavLink></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="ally-dashboard-panel ally-commission-summary">
                    <header><h2><i class="ri-coins-line"></i> Resumen de comisiones</h2><NavLink href="/aliados/comisiones">Ver todas <i class="ri-arrow-right-line"></i></NavLink></header>
                    <div class="ally-commission-rows">
                        <div><span>Comisiones generadas</span><strong>@Dinero(modelo.ComisionesGeneradas)</strong><em class="is-generated"><i></i> Generadas</em></div>
                        <div><span>Pendientes de aprobación</span><strong>@Dinero(modelo.ComisionesPendientesAprobacion)</strong><em class="is-pending"><i></i> Pendientes</em></div>
                        <div><span>Comisiones pagadas</span><strong>@Dinero(modelo.ComisionesPagadas)</strong><em class="is-paid"><i></i> Pagadas</em></div>
                    </div>
                </section>
            </div>

            <aside class="ally-dashboard-panel ally-quick-access">
                <header><h2><i class="ri-flashlight-fill"></i> Accesos rápidos</h2></header>
                <NavLink href="/aliados/clientes"><span class="ally-dashboard-icon"><i class="ri-team-fill"></i></span><div><strong>Ver clientes</strong><small>Consulta y gestiona tu cartera de clientes.</small></div><i class="ri-arrow-right-s-line"></i></NavLink>
                <NavLink href="/aliados/renovaciones"><span class="ally-dashboard-icon"><i class="ri-file-edit-line"></i></span><div><strong>Registrar gestión</strong><small>Registra tus comunicaciones y seguimientos.</small></div><i class="ri-arrow-right-s-line"></i></NavLink>
                <NavLink href="/aliados/comisiones"><span class="ally-dashboard-icon"><i class="ri-coins-line"></i></span><div><strong>Consultar comisiones</strong><small>Revisa el detalle de tus comisiones y liquidaciones.</small></div><i class="ri-arrow-right-s-line"></i></NavLink>
            </aside>
        </div>
    </div>
}

@code {
    private AliadoDashboardDto? modelo;
    private string EnlaceAbsoluto => modelo is null ? string.Empty : $"{NavManager.BaseUri.TrimEnd('/')}{modelo.LinkPersonalizado}";
    private string PrimerNombre => modelo?.Contexto.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Aliado";

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
            modelo = await AliadoService.ObtenerDashboardAsync(id);
    }

    private async Task CopiarEnlace()
    {
        if (!string.IsNullOrWhiteSpace(EnlaceAbsoluto))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", EnlaceAbsoluto);
    }

    private static string Dinero(decimal valor) => $"$ {valor:N2}";

    private static string EstadoCss(string estado) => estado.ToLowerInvariant() switch
    {
        var x when x.Contains("contact") => "is-contacted",
        var x when x.Contains("interes") => "is-interested",
        var x when x.Contains("respond") => "is-unanswered",
        _ => "is-pending"
    };
}
