@page "/aliados"
@page "/aliados/inicio"
@implements IAsyncDisposable

<PageTitle>Inicio | Portal de Aliados</PageTitle>

@if (cargando)
{
    <AllyLoadingState Title="Cargando tu inicio" Description="Preparando el resumen de tu canal." />
}
else if (modelo is null)
{
    <div class="ally-empty">No se pudo cargar la información del aliado.<br /><button type="button" class="ally-button" @onclick="CargarAsync">Reintentar</button></div>
}
else
{
    <div class="ally-dashboard ally-dashboard-redesign">
        <section class="ally-dashboard-hero">
            <div class="ally-dashboard-hero-copy"><span>CICLO COMERCIAL</span><h1>¡Hola, @PrimerNombre!</h1><p>Gestiona tus clientes, renovaciones y comisiones de forma simple.</p><small class="ally-dashboard-period"><i class="ri-calendar-line"></i> @PeriodoLabel</small></div>
            <img class="ally-dashboard-hero-numi" src="/images/aliados-dashboard-numi.png" alt="Numi mostrando el crecimiento de ventas" />
        </section>

        <article class="ally-sales-link ally-sales-link-bottom ally-sales-link-top">
            <div class="ally-sales-link-title"><span class="ally-dashboard-icon"><i class="ri-links-line"></i></span><div><strong>Mi enlace de ventas</strong><small>Compártelo con tus clientes para registrar tus ventas.</small></div></div>
            <div class="ally-sales-link-actions"><div class="ally-sales-link-value"><span>@EnlaceAbsoluto</span><button type="button" aria-label="Copiar enlace" @onclick="CopiarEnlace"><i class="ri-file-copy-line"></i></button></div><button type="button" class="ally-dashboard-button" @onclick="CopiarEnlace"><i class="ri-file-copy-line"></i> Copiar enlace</button></div>
        </article>

        <section class="ally-dashboard-kpis">
            <article class="ally-dashboard-kpi sales"><span class="ally-dashboard-icon"><i class="ri-shopping-cart-line"></i></span><div><small>Ventas generadas</small><strong>@Dinero(modelo.VentasPeriodo)</strong><p>@modelo.VentasCantidad venta(s) en el período</p></div></article>
            <article class="ally-dashboard-kpi commissions"><span class="ally-dashboard-icon"><i class="ri-percent-line"></i></span><div><small>Comisiones generadas</small><strong>@Dinero(modelo.ComisionesGeneradas)</strong><p>Sobre valores cobrados sin IVA</p></div></article>
            <article class="ally-dashboard-kpi pending"><span class="ally-dashboard-icon"><i class="ri-time-line"></i></span><div><small>Pendientes de aprobación</small><strong>@Dinero(modelo.ComisionesPendientesAprobacion)</strong><p>En proceso de revisión interna</p></div></article>
            <article class="ally-dashboard-kpi renewals"><span class="ally-dashboard-icon"><i class="ri-calendar-event-line"></i></span><div><small>Próximas renovaciones</small><strong>@modelo.RenovacionesProximas</strong><p>Dentro de los próximos 30 días</p></div></article>
        </section>

        @if (modelo.RenovacionesUrgentes > 0)
        {
            <section class="ally-dashboard-alert"><span class="ally-alert-icon"><i class="ri-alert-fill"></i></span><div><strong>Tienes @modelo.RenovacionesUrgentes renovación(es) que requieren gestión esta semana</strong><small>Contacta a tus clientes para asegurar la continuidad de sus productos.</small></div><NavLink class="ally-dashboard-button" href="/aliados/renovaciones">Ver renovaciones <i class="ri-arrow-right-line"></i></NavLink></section>
        }

        <section class="ally-dashboard-analytics">
            <article class="ally-dashboard-panel ally-dashboard-chart-card chart-main"><header><div><h2><i class="ri-bar-chart-grouped-line"></i> Ventas y comisiones</h2><p>Evolución de tus resultados en el período seleccionado.</p></div></header><div class="ally-dashboard-chart"><canvas id="ally-dashboard-evolution"></canvas></div></article>
            <article class="ally-dashboard-panel ally-dashboard-chart-card chart-donut"><header><div><h2><i class="ri-pie-chart-2-line"></i> Distribución de comisiones</h2><p>Estado del total generado.</p></div></header><div class="ally-dashboard-chart"><canvas id="ally-dashboard-distribution"></canvas></div></article>
            <aside class="ally-dashboard-panel ally-quick-access"><header><h2><i class="ri-flashlight-fill"></i> Accesos rápidos</h2></header><NavLink href="/aliados/clientes"><span class="ally-dashboard-icon"><i class="ri-team-fill"></i></span><div><strong>Ver clientes</strong><small>Consulta y gestiona tu cartera.</small></div><i class="ri-arrow-right-s-line"></i></NavLink><NavLink href="/aliados/renovaciones"><span class="ally-dashboard-icon"><i class="ri-file-edit-line"></i></span><div><strong>Registrar gestión</strong><small>Registra comunicaciones y seguimientos.</small></div><i class="ri-arrow-right-s-line"></i></NavLink><NavLink href="/aliados/comisiones"><span class="ally-dashboard-icon"><i class="ri-coins-line"></i></span><div><strong>Consultar comisiones</strong><small>Revisa comisiones y liquidaciones.</small></div><i class="ri-arrow-right-s-line"></i></NavLink><NavLink href="/aliados/renovaciones"><span class="ally-dashboard-icon"><i class="ri-calendar-line"></i></span><div><strong>Calendario de renovaciones</strong><small>Visualiza próximas fechas.</small></div><i class="ri-arrow-right-s-line"></i></NavLink></aside>
        </section>

        <section class="ally-dashboard-bottom">
            <article class="ally-dashboard-panel ally-renewals-panel">
                <header><div><h2><i class="ri-notification-3-line"></i> Renovaciones urgentes</h2><p>Clientes con renovaciones próximas.</p></div><NavLink href="/aliados/renovaciones">Ver todas <i class="ri-arrow-right-line"></i></NavLink></header>
                @if (modelo.Renovaciones.Count == 0)
                {
                    <div class="ally-dashboard-empty"><span><i class="ri-calendar-line"></i></span><strong>No tienes renovaciones próximas</strong><small>Cuando tengas clientes próximos a renovar se mostrarán aquí.</small></div>
                }
                else
                {
                    <div class="ally-dashboard-table-wrap"><table class="ally-dashboard-table"><thead><tr><th>Cliente</th><th>Producto</th><th>Vence</th><th>Días</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach (var item in modelo.Renovaciones) { <tr @key="item.IdFactura"><td>@item.Cliente</td><td>@item.Producto</td><td>@item.FechaVencimiento.ToString("dd MMM. yyyy")</td><td><span class="ally-days @(item.DiasRestantes <= 7 ? "is-urgent" : null)">@item.DiasRestantes días</span></td><td><span class="ally-status @EstadoCss(item.EstadoGestion)"><i></i>@item.EstadoGestion</span></td><td><NavLink class="ally-manage-button" href="@($"/aliados/renovaciones?factura={item.IdFactura}")">Gestionar</NavLink></td></tr>}</tbody></table></div>
                }
            </article>

        </section>
    </div>
}

@code {
    private AliadoDashboardDto? modelo;
    private AliadoComisionesDto? comisiones;
    private bool cargando = true;
    private bool graficosPendientes;
    private string periodo = "mes";
    private string PrimerNombre => modelo?.Contexto.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Aliado";
    private string EnlaceAbsoluto { get { if (modelo is null) return string.Empty; var ruta = modelo.LinkPersonalizado; if (string.IsNullOrWhiteSpace(ruta) && !string.IsNullOrWhiteSpace(modelo.Contexto.CodigoReferencia)) ruta = $"/register?vendedor={Uri.EscapeDataString(modelo.Contexto.CodigoReferencia)}"; return string.IsNullOrWhiteSpace(ruta) ? string.Empty : $"{NavManager.BaseUri.TrimEnd('/')}{ruta}"; } }
    private string PeriodoLabel => modelo is null ? "Período actual" : $"{modelo.PeriodoDesde:dd 'de' MMMM 'de' yyyy} – {modelo.PeriodoHasta:dd 'de' MMMM 'de' yyyy}";
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private SweetAlertService AlertService { get; set; } = null!;
    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id)) { modelo = null; return; }
            var hoy = DateTime.Today;
            var inicio = periodo switch { "trimestre" => new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-2), "ano" => new DateTime(hoy.Year, 1, 1), _ => new DateTime(hoy.Year, hoy.Month, 1) };
            modelo = await AliadoService.ObtenerDashboardAsync(id, inicio, hoy);
            comisiones = await AliadoService.ObtenerComisionesAsync(id);
            graficosPendientes = modelo is not null;
        }
        catch { modelo = null; comisiones = null; }
        finally { cargando = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!graficosPendientes || modelo is null) return;
        graficosPendientes = false;
        var movimientos = (comisiones?.Movimientos ?? Array.Empty<AliadoComisionMovimientoDto>()).Where(x => x.FechaGeneracion.Date >= modelo.PeriodoDesde.Date && x.FechaGeneracion.Date <= modelo.PeriodoHasta.Date && x.Estado is not "Revertida" and not "Anulada").ToList();
        var meses = Enumerable.Range(0, 6).Select(offset => new DateTime(modelo.PeriodoHasta.Year, modelo.PeriodoHasta.Month, 1).AddMonths(offset - 5)).ToList();
        await JS.InvokeVoidAsync("aliadosDashboardCharts.render", new { evolution = new { labels = meses.Select(x => x.ToString("MMM", new System.Globalization.CultureInfo("es-EC"))), sales = meses.Select(m => movimientos.Where(x => x.FechaGeneracion.Year == m.Year && x.FechaGeneracion.Month == m.Month).Sum(x => x.BaseComisionable)), commissions = meses.Select(m => movimientos.Where(x => x.FechaGeneracion.Year == m.Year && x.FechaGeneracion.Month == m.Month).Sum(x => x.ValorComision)) }, distribution = new { labels = new[] { "Generadas", "Pendientes", "Pagadas" }, values = new[] { modelo.ComisionesGeneradas, modelo.ComisionesPendientesAprobacion, modelo.ComisionesPagadas } } });
    }

    private Task CopiarEnlace() => CopiarEnlace(EnlaceAbsoluto);
    private async Task CopiarEnlace(string enlace) { if (string.IsNullOrWhiteSpace(enlace)) return; var copiado = await JS.InvokeAsync<bool>("numericaClipboard.copy", enlace); if (copiado) await AlertService.ShowSuccessAsync("El enlace quedó copiado en el portapapeles.", "Enlace copiado"); else await AlertService.ShowErrorAsync("No fue posible copiar el enlace.", "No se pudo copiar"); }
    private static string Dinero(decimal valor) => $"$ {valor:N2}";
    private static string EstadoCss(string estado) => estado.ToLowerInvariant() switch { var x when x.Contains("contact") => "is-contacted", var x when x.Contains("interes") => "is-interested", var x when x.Contains("respond") => "is-unanswered", _ => "is-pending" };
    public async ValueTask DisposeAsync() { try { await JS.InvokeVoidAsync("aliadosDashboardCharts.destroy"); } catch { } }
}
