@page "/aliados"
@page "/aliados/inicio"

<PageTitle>Inicio | Portal de Aliados</PageTitle>

@if (modelo is null)
{
    <div class="ally-empty">No se pudo cargar la información del aliado.</div>
}
else
{
    <div class="ally-page">
        <div class="ally-hero">
            <div><span class="ally-eyebrow">CICLO COMERCIAL</span><h2>Hola, @modelo.Contexto.Nombre</h2><p>Comparte tu enlace, consulta tus clientes y gestiona tus renovaciones.</p></div>
            <a class="ally-button light" href="/aliados/clientes">Ver mis clientes <i class="ri-arrow-right-line"></i></a>
        </div>
        <div class="ally-link-card"><div><span class="ally-label">MI ENLACE DE VENTAS</span><strong>@EnlaceAbsoluto</strong></div><button class="ally-button" @onclick="CopiarEnlace"><i class="ri-file-copy-line"></i> Copiar enlace</button></div>
        <div class="ally-kpis">
            <div class="ally-kpi"><span>Ventas del período</span><strong>$ @modelo.VentasPeriodo.ToString("N2")</strong><small>@modelo.VentasCantidad venta(s)</small></div>
            <div class="ally-kpi"><span>Comisiones generadas</span><strong>$ @modelo.ComisionesGeneradas.ToString("N2")</strong><small>Sobre valores cobrados sin IVA</small></div>
            <div class="ally-kpi"><span>Comisiones pagadas</span><strong>$ @modelo.ComisionesPagadas.ToString("N2")</strong><small>Historial confirmado</small></div>
            <div class="ally-kpi warning"><span>Próximas renovaciones</span><strong>@modelo.RenovacionesProximas</strong><small>Dentro de 30 días</small></div>
        </div>
        @if (modelo.RenovacionesUrgentes > 0)
        {
            <div class="ally-alert"><i class="ri-alarm-warning-line"></i><span>Tienes @modelo.RenovacionesUrgentes renovación(es) que requieren gestión esta semana.</span><a href="/aliados/renovaciones">Ver renovaciones</a></div>
        }
        <section class="ally-panel"><div class="ally-panel-heading"><div><span class="ally-label">ACCIÓN RECOMENDADA</span><h3>Renovaciones próximas</h3></div><a href="/aliados/renovaciones">Ver todas</a></div>
            @if (modelo.Renovaciones.Count == 0) { <div class="ally-empty">No tienes renovaciones próximas.</div> }
            else { <div class="ally-table-wrap"><table class="ally-table"><thead><tr><th>Cliente</th><th>Producto</th><th>Vencimiento</th><th>Días</th></tr></thead><tbody>@foreach (var item in modelo.Renovaciones) { <tr @key="item.IdFactura"><td>@item.Cliente</td><td>@item.Producto</td><td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td><td><span class="ally-badge warning">@item.DiasRestantes días</span></td></tr>}</tbody></table></div> }
        </section>
    </div>
}

@code {
    private AliadoDashboardDto? modelo;
    private string EnlaceAbsoluto => modelo is null ? string.Empty : $"{NavManager.BaseUri.TrimEnd('/')}{modelo.LinkPersonalizado}";

    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id))
            modelo = await AliadoService.ObtenerDashboardAsync(id);
    }

    private async Task CopiarEnlace()
    {
        if (!string.IsNullOrWhiteSpace(EnlaceAbsoluto))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", EnlaceAbsoluto);
    }
}
