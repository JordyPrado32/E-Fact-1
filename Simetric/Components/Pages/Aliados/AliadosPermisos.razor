@page "/aliados/admin/permisos"

<PageTitle>Roles y permisos | Portal de Aliados</PageTitle>

<div class="ally-page">
    <div class="ally-page-intro"><div><span class="ally-eyebrow">SEGURIDAD DEL PORTAL</span><h2>Roles y permisos</h2><p>Configura qué opciones puede consultar cada rol del Portal de Aliados.</p></div><a class="ally-back-link" href="/aliados/admin"><i class="ri-arrow-left-line"></i> Administración</a></div>
    @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="ally-feedback">@mensaje</div> }
    <section class="ally-panel">
        <div class="ally-panel-heading"><div><span class="ally-label">ROL</span><h3>Accesos de navegación</h3></div><select class="ally-select" @bind="rolId" @bind:after="CargarPermisosAsync">@foreach (var rol in roles) { <option value="@rol.IdRol">@rol.Nombre</option> }</select></div>
        @if (cargando) { <div class="ally-empty">Cargando permisos...</div> }
        else { <div class="ally-permissions">@foreach (var menu in menus) { <label class="ally-permission" @key="menu.IdMenu"><input type="checkbox" checked="@seleccionados.Contains(menu.IdMenu)" @onchange="e => Alternar(menu.IdMenu, e.Value)" /><span><strong>@menu.Nombre</strong><small>@menu.Ruta</small></span></label> }</div><div class="ally-modal-actions"><button class="ally-button" @onclick="GuardarAsync" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar permisos")</button></div> }
    </section>
</div>

@code {
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    private List<AliadoPortalRol> roles = new();
    private List<AliadoPortalMenu> menus = new();
    private HashSet<int> seleccionados = new();
    private int rolId;
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        roles = (await AliadoService.ObtenerRolesAsync()).ToList();
        menus = (await AliadoService.ObtenerCatalogoMenusAsync()).ToList();
        rolId = roles.FirstOrDefault()?.IdRol ?? 0;
        await CargarPermisosAsync();
    }

    private async Task CargarPermisosAsync()
    {
        cargando = true;
        seleccionados = rolId > 0 ? (await AliadoService.ObtenerMenusAsync(rolId)).Select(x => x.IdMenu).ToHashSet() : new();
        cargando = false;
    }

    private void Alternar(int idMenu, object? valor)
    {
        if (valor is bool activo && activo) seleccionados.Add(idMenu); else seleccionados.Remove(idMenu);
    }

    private async Task GuardarAsync()
    {
        if (rolId <= 0 || guardando) return;
        guardando = true;
        await AliadoService.ActualizarPermisosAsync(rolId, seleccionados.ToList());
        mensaje = "Permisos actualizados correctamente.";
        guardando = false;
    }
}
