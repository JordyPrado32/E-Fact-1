@page "/aliados/admin/permisos"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Roles y permisos | Portal de Aliados</PageTitle>

<div class="ally-security-shell">
    <section class="ally-security-hero">
        <div><span class="ally-security-kicker">CONTROL DE ACCESOS</span><h2>Panel de seguridad</h2><p>Gestiona los perfiles y los accesos exclusivos del Portal de Aliados.</p></div>
        <div class="ally-security-actions"><NavLink class="ally-security-secondary" href="/aliados/admin"><i class="ri-arrow-left-line"></i> Administración</NavLink><button type="button" class="ally-security-primary" @onclick="GuardarAsync" disabled="@guardando">@if (guardando) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="ri-save-3-line"></i> } Guardar cambios</button></div>
        <div class="ally-security-summary"><article class="primary"><span>PERFILES REGISTRADOS</span><strong>@roles.Count</strong><small>Roles propios del portal.</small></article><article><span>MENÚS DISPONIBLES</span><strong>@menus.Count</strong><small>Accesos configurables.</small></article><article><span>PERMISOS SELECCIONADOS</span><strong>@seleccionados.Count</strong><small>@(rolSeleccionado?.Nombre ?? "Seleccione un perfil")</small></article></div>
    </section>
    @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="ally-security-feedback"><i class="ri-checkbox-circle-line"></i>@mensaje</div> }
    <section class="ally-security-grid">
        <aside class="ally-security-panel ally-roles-panel"><div class="ally-security-head"><div><span>PERFILES DISPONIBLES</span><h3>Roles de acceso</h3></div><b>@roles.Count</b></div>
            @if (cargando) { <div class="ally-empty">Cargando perfiles...</div> }
            else { <div class="ally-role-list">@foreach (var rol in roles) { <button type="button" class="ally-role-card @(rol.IdRol == rolId ? "selected" : "")" @onclick="() => SeleccionarRolAsync(rol.IdRol)"><span><strong>@rol.Nombre</strong><small>@(rol.Descripcion ?? "Perfil activo")</small></span><em>Activo</em><i class="ri-check-line"></i></button> }</div> }
        </aside>
        <section class="ally-security-panel"><div class="ally-security-head"><div><span>MATRIZ DE PERMISOS</span><h3>@(rolSeleccionado?.Nombre ?? "Selecciona un rol")</h3><p>Activa cada opción que podrá ver este perfil en el menú lateral.</p></div></div>
            @if (!cargando) { <div class="ally-module-list">@foreach (var menu in menus) { <label class="ally-module-card" @key="menu.IdMenu"><input type="checkbox" checked="@seleccionados.Contains(menu.IdMenu)" @onchange="e => Alternar(menu.IdMenu, e.Value)" /><i class="@menu.Icono"></i><span><small>MÓDULO DEL PORTAL</small><strong>@menu.Nombre</strong><em>@menu.Ruta</em></span><b>@(seleccionados.Contains(menu.IdMenu) ? "Permitido" : "Sin acceso")</b></label> }</div> }
        </section>
    </section>
</div>

@code {
    [Inject] private AliadoPortalService AliadoService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    private List<AliadoPortalRol> roles = new();
    private List<AliadoPortalMenu> menus = new();
    private HashSet<int> seleccionados = new();
    private int rolId;
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;
    private AliadoPortalRol? rolSeleccionado => roles.FirstOrDefault(x => x.IdRol == rolId);

    protected override async Task OnInitializedAsync()
    {
        roles = (await AliadoService.ObtenerRolesAsync()).ToList();
        menus = (await AliadoService.ObtenerCatalogoMenusAsync()).ToList();
        rolId = roles.FirstOrDefault()?.IdRol ?? 0;
        await CargarPermisosAsync();
    }

    private async Task CargarPermisosAsync()
    {
        cargando = true;
        seleccionados = rolId > 0 ? (await AliadoService.ObtenerMenusAsync(rolId)).Select(x => x.IdMenu).ToHashSet() : new();
        cargando = false;
    }

    private async Task SeleccionarRolAsync(int idRol)
    {
        rolId = idRol;
        await CargarPermisosAsync();
    }

    private void Alternar(int idMenu, object? valor)
    {
        if (valor is bool activo && activo) seleccionados.Add(idMenu); else seleccionados.Remove(idMenu);
    }

    private async Task GuardarAsync()
    {
        if (rolId <= 0 || guardando) return;
        guardando = true;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId))
        {
            mensaje = "No se pudo validar la sesión actual.";
        }
        else
        {
            var actualizado = await AliadoService.ActualizarPermisosAsync(actorId, rolId, seleccionados.ToList());
            mensaje = actualizado ? "Permisos actualizados correctamente." : "No tienes autorización para modificar permisos.";
        }
        guardando = false;
    }
}
