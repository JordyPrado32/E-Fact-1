@page "/e-contax/inventarios"
@page "/e-contax/inventarios/kardex"
@using System.Net.Http.Json
@using System.Security.Claims
@using System.Text
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Simetric.DTOs.EContax
@using Simetric.Services
@using Simetric.Services.EContax
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ISimpleExcelExportService ExcelExportService
@inject IEContaxInventarioReportePdfService InventarioPdfService
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Inventarios | E-Contax</PageTitle>

<div class="inventory-shell @(EsKardexRuta ? "is-kardex" : "is-dashboard")">
    <section class="inventory-hero">
        <div>
            <span class="inventory-eyebrow">E-Contax · Control de existencias</span>
            <h2>@(EsKardexRuta ? "Kardex de inventario" : "Inventarios")</h2>
            <p>Consulta movimientos, costos y existencias de cada producto por sucursal.</p>
            <nav class="inventory-view-switcher" aria-label="Sección de inventario">
                <button type="button" class="@(EsKardexRuta ? "" : "is-active")" @onclick="VolverInventarios"><i class="ri-stack-line"></i> Existencias</button>
                @if (EsKardexRuta)
                {
                    <span class="inventory-current-view"><i class="ri-file-list-3-line"></i> Kardex</span>
                }
                else
                {
                    <span class="inventory-view-hint">Seleccione “Ver Kardex” en un producto</span>
                }
            </nav>
        </div>
        <div class="inventory-hero-summary">
            <span>Método de valoración</span>
            <strong>@MetodoVisible</strong>
            <small>@(EsKardexRuta ? kardex?.NombreSucursal : SucursalResumen)</small>
            @if (!EsKardexRuta && dashboard.PuedeConsultarTodasSucursales)
            {
                <label class="inventory-hero-selector">
                    <span>Sucursal de consulta</span>
                    <select value="@SucursalSeleccionadaTexto" @onchange="CambiarSucursalAsync">
                        <option value="0">Todas las sucursales</option>
                        @foreach (var sucursal in dashboard.Sucursales)
                        {
                            <option value="@sucursal.IdSucursal">@sucursal.Nombre</option>
                        }
                    </select>
                </label>
            }
            @if (!EsKardexRuta && dashboard.PuedeEditar)
            {
                <button type="button" class="inventory-primary-btn inventory-method-button" @onclick="AbrirConfiguracion"><i class="ri-settings-3-line"></i> Cambiar método</button>
            }
        </div>
    </section>

    <div class="inventory-alert" role="alert">
        <i class="ri-alert-line"></i>
        <div><strong>Configuración con impacto contable</strong><span>El método <b>@MetodoVisible</b> se aplicará a los movimientos futuros y puede afectar los libros de inventario.</span></div>
    </div>

    @if (EsKardexRuta)
    {
        @if (cargando && kardex is null)
        {
            <section class="inventory-state-card"><span class="spinner-border text-primary" role="status"></span><strong>Cargando Kardex</strong><span>Consultando movimientos y costos del producto.</span></section>
        }
        else if (kardex is not null)
        {
            <section class="inventory-kardex-head">
                <div class="inventory-product-heading"><span class="inventory-code">@(kardex.CodigoPrincipal ?? $"#{kardex.CodigoProducto}")</span><h3>@kardex.NombreProducto</h3><span><i class="ri-store-2-line"></i> @kardex.NombreSucursal</span></div>
                <div class="inventory-kardex-actions">
                    @if (kardex.Sucursales.Count > 1)
                    {
                        <label class="inventory-inline-filter"><span>Sucursal</span><select value="@SucursalSeleccionadaTexto" @onchange="CambiarSucursalAsync">
                            @foreach (var sucursal in kardex.Sucursales)
                            {
                                <option value="@sucursal.IdSucursal">@sucursal.Nombre</option>
                            }
                        </select></label>
                    }
                    <div class="inventory-stock-total"><span>Stock actual</span><strong>@kardex.StockActual.ToString("N2")</strong><small>Costo promedio @kardex.CostoPromedio.ToString("C2")</small></div>
                    @if (kardex.PuedeEditar)
                    {
                        <button type="button" class="inventory-icon-button" title="Configurar método" @onclick="AbrirConfiguracion"><i class="ri-settings-3-line"></i></button>
                    }
                </div>
            </section>

            <section class="inventory-kardex-insights" aria-label="Resumen del inventario">
                <article class="inventory-kardex-insight"><span><i class="ri-checkbox-circle-line"></i> Disponible</span><strong>@kardex.StockDisponible.ToString("N2")</strong><small>Unidades libres para salida</small></article>
                <article class="inventory-kardex-insight"><span><i class="ri-lock-line"></i> Reservado</span><strong>@kardex.StockReservado.ToString("N2")</strong><small>Unidades comprometidas</small></article>
                <article class="inventory-kardex-insight"><span><i class="ri-money-dollar-circle-line"></i> Valor estimado</span><strong>@ValorInventarioKardex.ToString("C2")</strong><small>Stock actual a costo promedio</small></article>
                <article class="inventory-kardex-insight"><span><i class="ri-history-line"></i> Último movimiento</span><strong>@UltimoMovimientoTexto</strong><small>@kardex.Movimientos.Count movimientos registrados</small></article>
            </section>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="inventory-status is-error"><i class="ri-error-warning-line"></i><span>@error</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="inventory-status is-success"><i class="ri-checkbox-circle-line"></i><span>@mensaje</span></div>
            }

            <section class="inventory-table-card">
                <div class="inventory-kardex-filterbar" aria-label="Filtros del kardex">
                    <label class="inventory-filter"><span>Tipo de movimiento</span><select @bind="kardexTipoFiltro"><option value="">Todos los movimientos</option><option value="ENTRADAS">Solo entradas</option><option value="SALIDAS">Solo salidas</option></select></label>
                    <label class="inventory-filter"><span>Desde</span><input type="date" @bind="kardexDesde" /></label>
                    <label class="inventory-filter"><span>Hasta</span><input type="date" @bind="kardexHasta" /></label>
                    <button type="button" class="inventory-secondary-btn inventory-filter-clear" @onclick="LimpiarFiltrosKardex" disabled="@(!KardexTieneFiltros)"><i class="ri-filter-off-line"></i> Limpiar</button>
                </div>
                <div class="inventory-table-head"><div><span class="inventory-section-kicker">Historial de movimientos</span><h3>Kardex valorizado</h3></div><div class="inventory-table-head-actions"><span class="inventory-table-badge" aria-live="polite">@MovimientosKardexFiltrados.Count de @kardex.Movimientos.Count movimientos</span><button type="button" class="inventory-secondary-btn inventory-print-button" title="Imprimir kardex" onclick="window.print()"><i class="ri-printer-line"></i><span>Imprimir</span></button><button type="button" class="inventory-secondary-btn inventory-print-button" title="Exportar kardex a CSV" @onclick="ExportarKardexCsvAsync" disabled="@(!MovimientosKardexFiltrados.Any())"><i class="ri-download-2-line"></i><span>CSV</span></button><button type="button" class="inventory-secondary-btn inventory-print-button" title="Exportar kardex a PDF" @onclick="ExportarKardexPdfAsync" disabled="@(!MovimientosKardexFiltrados.Any())"><i class="ri-file-pdf-2-line"></i><span>PDF</span></button><button type="button" class="inventory-primary-btn inventory-print-button" title="Exportar kardex a Excel" @onclick="ExportarKardexExcelAsync" disabled="@(!MovimientosKardexFiltrados.Any())"><i class="ri-file-excel-2-line"></i><span>Excel</span></button></div></div>
                @if (cargando)
                {
                    <div class="inventory-state-card compact"><span class="spinner-border spinner-border-sm text-primary" role="status"></span><span>Actualizando movimientos...</span></div>
                }
                else if (!kardex.Movimientos.Any())
                {
                    <div class="inventory-state-card compact"><i class="ri-inbox-2-line"></i><strong>Sin movimientos registrados</strong><span>El producto todavía no tiene entradas o salidas en esta sucursal.</span></div>
                }
                else if (!MovimientosKardexFiltrados.Any())
                {
                    <div class="inventory-state-card compact"><i class="ri-filter-off-line"></i><strong>No hay movimientos con estos filtros</strong><span>Pruebe con otro rango de fechas o tipo de movimiento.</span><button type="button" class="inventory-secondary-btn" @onclick="LimpiarFiltrosKardex">Limpiar filtros</button></div>
                }
                else
                {
                    <div class="inventory-table-wrap inventory-kardex-wrap"><table class="table inventory-table inventory-kardex-table mb-0" aria-label="Kardex valorizado"><thead><tr><th rowspan="2">Fecha</th><th rowspan="2">Detalle</th><th colspan="3" class="inventory-kardex-group is-entry">Entradas</th><th colspan="3" class="inventory-kardex-group is-exit">Salidas</th><th colspan="3" class="inventory-kardex-group is-balance">Existencias</th></tr><tr><th class="text-end">Cantidad</th><th class="text-end">C. unitario</th><th class="text-end">C. total</th><th class="text-end">Cantidad</th><th class="text-end">C. unitario</th><th class="text-end">C. total</th><th class="text-end">Cantidad</th><th class="text-end">C. unitario</th><th class="text-end">C. total</th></tr></thead><tbody>
                        @foreach (var movimiento in MovimientosKardexFiltrados)
                        {
                            var esSalida = EsSalida(movimiento.TipoMovimiento);
                            <tr @key="movimiento.IdMovimiento"><td>@movimiento.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="inventory-movement-pill @(esSalida ? "is-out" : "is-in")"><i class="@(esSalida ? "ri-arrow-down-line" : "ri-arrow-up-line")"></i>@movimiento.TipoMovimiento</span><button type="button" class="inventory-detail-trigger" title="Ver detalle del movimiento" @onclick="() => SeleccionarMovimiento(movimiento)"><i class="ri-eye-line"></i></button><small class="d-block">@(movimiento.NombreUsuario ?? $"Usuario #{movimiento.IdUsuario}")</small><span>@(movimiento.Referencia ?? movimiento.Observacion ?? "-")</span>@if (movimiento.NumeroLote is not null || movimiento.FechaVencimiento.HasValue) { <small class="d-block">Lote: @(movimiento.NumeroLote ?? "-")@(movimiento.FechaVencimiento.HasValue ? $" · vence {movimiento.FechaVencimiento:dd/MM/yyyy}" : "")</small> }</td><td class="text-end">@(esSalida ? "-" : movimiento.Cantidad.ToString("N2"))</td><td class="text-end">@(esSalida ? "-" : movimiento.CostoUnitario.ToString("C2"))</td><td class="text-end">@(esSalida ? "-" : movimiento.CostoTotal.ToString("C2"))</td><td class="text-end">@(esSalida ? movimiento.Cantidad.ToString("N2") : "-")</td><td class="text-end">@(esSalida ? movimiento.CostoUnitario.ToString("C2") : "-")</td><td class="text-end">@(esSalida ? movimiento.CostoTotal.ToString("C2") : "-")</td><td class="text-end fw-semibold">@movimiento.SaldoCantidad.ToString("N2")</td><td class="text-end">@CostoSaldoUnitario(movimiento).ToString("C2")</td><td class="text-end fw-semibold">@movimiento.SaldoCosto.ToString("C2")</td></tr>
                        }
                    </tbody></table></div>
                }
            </section>
        }
        else
        {
            <section class="inventory-state-card"><i class="ri-error-warning-line"></i><strong>No se pudo cargar el Kardex</strong><span>@(error ?? "Seleccione un producto desde el catálogo.")</span><button type="button" class="inventory-secondary-btn" @onclick="VolverInventarios">Volver a existencias</button></section>
        }
    }
    else
    {
        <section class="inventory-kpi-grid">
            <article class="inventory-kpi"><span class="inventory-kpi-icon is-blue"><i class="ri-box-3-line"></i></span><div><span>Productos inventariables</span><strong>@dashboard.TotalProductos</strong><small>Productos activos en la consulta</small></div></article>
            <article class="inventory-kpi"><span class="inventory-kpi-icon is-green"><i class="ri-stack-line"></i></span><div><span>Stock disponible</span><strong>@dashboard.StockTotal.ToString("N2")</strong><small>Unidades disponibles</small></div></article>
            <button class="inventory-kpi inventory-kpi-action" type="button" @onclick='() => SeleccionarAlerta("MINIMO")'><span class="inventory-kpi-icon is-red"><i class="ri-arrow-down-circle-line"></i></span><div><span>Bajo mínimo</span><strong>@dashboard.ProductosBajoMinimo</strong><small>Requieren reposición</small></div></button>
            <button class="inventory-kpi inventory-kpi-action" type="button" @onclick='() => SeleccionarAlerta("MAXIMO")'><span class="inventory-kpi-icon is-orange"><i class="ri-alert-line"></i></span><div><span>Sobre máximo</span><strong>@dashboard.ProductosSobreMaximo</strong><small>Revisar niveles de compra</small></div></button>
            <button class="inventory-kpi inventory-kpi-action" type="button" @onclick='() => SeleccionarAlerta("VENCIDO")'><span class="inventory-kpi-icon is-red"><i class="ri-close-circle-line"></i></span><div><span>Lotes vencidos</span><strong>@dashboard.LotesVencidos</strong><small>No disponibles para salida</small></div></button>
            <button class="inventory-kpi inventory-kpi-action" type="button" @onclick='() => SeleccionarAlerta("VENCE_7")'><span class="inventory-kpi-icon is-orange"><i class="ri-alarm-warning-line"></i></span><div><span>Vencen en 7 días</span><strong>@dashboard.LotesPorVencer7Dias</strong><small>Atención prioritaria</small></div></button>
            <button class="inventory-kpi inventory-kpi-action" type="button" @onclick='() => SeleccionarAlerta("VENCE_30")'><span class="inventory-kpi-icon is-purple"><i class="ri-calendar-close-line"></i></span><div><span>Vencen en 30 días</span><strong>@dashboard.LotesPorVencer</strong><small>Planificar salida</small></div></button>
            <article class="inventory-kpi"><span class="inventory-kpi-icon is-teal"><i class="ri-money-dollar-circle-line"></i></span><div><span>Valor inventario</span><strong>@dashboard.ValorInventario.ToString("C2")</strong><small>Costo sin impuestos</small></div></article>
        </section>

        <section class="inventory-toolbar">
            <div class="inventory-toolbar-heading"><span class="inventory-section-kicker">Consulta</span><h3>Filtrar existencias</h3><p>Use la búsqueda y los filtros para encontrar rápidamente un producto.</p></div>
            <div class="inventory-filter-grid">
                <label class="inventory-filter search-filter"><span>Buscar producto</span><div class="inventory-search-box"><i class="ri-search-line"></i><input @bind="filtro" @bind:event="oninput" placeholder="Nombre, código o código principal" @onkeydown="OnSearchKeyDown" /><button type="button" title="Buscar" @onclick="CargarDashboardAsync"><i class="ri-arrow-right-line"></i></button></div></label>
                <label class="inventory-filter"><span>Alertas</span><select value="@filtroAlerta" @onchange="CambiarFiltroAlerta"><option value="">Todas</option><option value="MINIMO">Bajo mínimo</option><option value="MAXIMO">Sobre máximo</option><option value="VENCIDO">Lote vencido</option><option value="VENCE_7">Vence en 7 días</option><option value="VENCE_30">Vence en 30 días</option><option value="VENCIMIENTO">Cualquier vencimiento</option><option value="SIN_ALERTA">Sin alerta</option></select></label>
                <label class="inventory-filter"><span>Ordenar por</span><select value="@ordenInventario" @onchange="CambiarOrdenInventario"><option value="producto">Producto</option><option value="stock">Stock actual</option><option value="costo">Costo promedio</option><option value="alerta">Nivel de alerta</option></select></label>
                <label class="inventory-filter"><span>Registros</span><select value="@registrosInventarioPagina" @onchange="CambiarRegistrosInventario"><option value="10">10 por página</option><option value="20">20 por página</option><option value="50">50 por página</option></select></label>
            </div>
            <div class="inventory-toolbar-actions inventory-hero-action"><button type="button" class="inventory-secondary-btn" @onclick="AbrirReportes"><i class="ri-file-chart-line"></i> Reportes</button><button type="button" class="inventory-primary-btn" @onclick="AbrirOperaciones"><i class="ri-exchange-box-line"></i> Operaciones</button></div>
            <div class="inventory-toolbar-actions"><button type="button" class="inventory-secondary-btn" @onclick="LimpiarFiltros"><i class="ri-filter-off-line"></i> Limpiar</button><button type="button" class="inventory-secondary-btn" @onclick="CargarDashboardAsync" disabled="@cargando"><i class="ri-refresh-line"></i> Actualizar</button><button type="button" class="inventory-secondary-btn" @onclick="ExportarInventarioCsvAsync" disabled="@(!ItemsFiltrados.Any())"><i class="ri-download-2-line"></i> Exportar CSV</button>@if (dashboard.PuedeEditar){<button type="button" class="inventory-primary-btn" @onclick="AbrirConfiguracion"><i class="ri-settings-3-line"></i> Configurar valoración</button>}</div>
        </section>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="inventory-status is-error"><i class="ri-error-warning-line"></i><span>@error</span></div>
        }
        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="inventory-status is-success"><i class="ri-checkbox-circle-line"></i><span>@mensaje</span></div>
        }

        <section class="inventory-table-card">
            <div class="inventory-table-head"><div><span class="inventory-section-kicker">Existencias por sucursal</span><h3>Productos inventariables</h3></div><span class="inventory-table-badge">@TotalItemsInventario registros</span></div>
            @if (cargando)
            {
                <div class="inventory-state-card"><span class="spinner-border text-primary" role="status"></span><strong>Cargando inventario</strong><span>Consultando existencias, límites y alertas.</span></div>
            }
            else if (!ItemsFiltrados.Any())
            {
                <div class="inventory-state-card"><i class="ri-inbox-2-line"></i><strong>No hay existencias para mostrar</strong><span>Pruebe con otro criterio de búsqueda o ajuste los filtros.</span></div>
            }
            else
            {
                    <div class="inventory-table-wrap"><table class="table inventory-table mb-0"><thead><tr><th>Producto</th><th>Sucursal</th><th class="text-end">Stock actual</th><th class="text-end">Disponible vigente</th><th class="text-end">Mínimo</th><th class="text-end">Máximo</th><th class="text-end">Costo promedio</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
                    @foreach (var item in ItemsInventarioPagina)
                    {
                        <tr @key="@($"{item.CodigoProducto}-{item.IdSucursal}")"><td><div class="inventory-product-cell"><strong>@item.NombreProducto</strong><span>@(item.CodigoPrincipal ?? $"#{item.CodigoProducto}")</span></div></td><td><span class="inventory-branch"><i class="ri-store-2-line"></i>@item.NombreSucursal</span></td><td class="text-end fw-bold">@item.StockActual.ToString("N2")</td><td class="text-end">@item.StockDisponibleVigente.ToString("N2")</td><td class="text-end">@item.StockMinimo.ToString("N2")</td><td class="text-end">@(item.StockMaximo > 0 ? item.StockMaximo.ToString("N2") : "-")</td><td class="text-end">@item.CostoPromedio.ToString("C2")</td><td><span class="inventory-alert-pill @ClaseAlerta(item)">@TextoAlerta(item)</span></td><td class="text-end"><div class="inventory-action-group"><button type="button" class="inventory-icon-button" title="Ver Kardex" @onclick="() => AbrirKardex(item.CodigoProducto, item.IdSucursal)"><i class="ri-file-list-3-line"></i></button>@if (dashboard.PuedeEditar){<button type="button" class="inventory-icon-button is-edit" title="Ajustar existencias" @onclick="() => AbrirAjuste(item)"><i class="ri-edit-line"></i></button>}</div></td></tr>
                    }
                </tbody></table></div>
                <div class="inventory-table-pagination"><span>Mostrando @PrimerItemInventario-@UltimoItemInventario de @TotalItemsInventario registros</span><div class="inventory-pagination-actions"><button type="button" class="inventory-icon-button" title="Página anterior" @onclick="() => CambiarPaginaInventario(PaginaInventarioSegura - 1)" disabled="@(PaginaInventarioSegura <= 1)"><i class="ri-arrow-left-s-line"></i></button><strong>Página @PaginaInventarioSegura de @TotalPaginasInventario</strong><button type="button" class="inventory-icon-button" title="Página siguiente" @onclick="() => CambiarPaginaInventario(PaginaInventarioSegura + 1)" disabled="@(PaginaInventarioSegura >= TotalPaginasInventario)"><i class="ri-arrow-right-s-line"></i></button></div></div>
            }
        </section>
    }
</div>

@if (mostrarConfiguracion)
{
    <div class="inventory-modal-backdrop"></div>
    <section class="inventory-modal inventory-modal-small" role="dialog" aria-modal="true" aria-labelledby="inventarioConfigTitulo"><header class="inventory-modal-header"><div><span class="inventory-section-kicker">Configuración administrativa</span><h3 id="inventarioConfigTitulo">Método de valoración</h3><p>Este cambio aplicará a los movimientos futuros de la empresa.</p></div><button type="button" class="inventory-modal-close" @onclick="CerrarConfiguracion" disabled="@guardando"><i class="ri-close-line"></i></button></header><div class="inventory-modal-body"><div class="inventory-modal-warning"><i class="ri-alert-line"></i><span>FIFO, LIFO y promedio ponderado pueden producir costos y saldos contables diferentes. Confirme el cambio con autorización del administrador.</span></div><label class="inventory-modal-field"><span>Método de valoración</span><select @bind="metodoBorrador" disabled="@guardando">@foreach (var metodo in Metodos){<option value="@metodo">@metodo</option>}</select></label>@if (!string.IsNullOrWhiteSpace(error)){<div class="inventory-modal-error">@error</div>}</div><footer class="inventory-modal-footer"><button type="button" class="inventory-secondary-btn" @onclick="CerrarConfiguracion" disabled="@guardando">Cancelar</button><button type="button" class="inventory-primary-btn" @onclick="GuardarMetodoAsync" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar configuración")</button></footer></section>
}

@if (mostrarAjuste && ajuste is not null)
{
    <div class="inventory-modal-backdrop"></div>
    <section class="inventory-modal" role="dialog" aria-modal="true" aria-labelledby="inventarioAjusteTitulo"><header class="inventory-modal-header"><div><span class="inventory-section-kicker">Administrar existencias</span><h3 id="inventarioAjusteTitulo">Ajustar inventario</h3><p>@itemAjuste?.NombreProducto · @itemAjuste?.NombreSucursal</p></div><button type="button" class="inventory-modal-close" @onclick="CerrarAjuste" disabled="@guardando"><i class="ri-close-line"></i></button></header><div class="inventory-modal-body"><div class="inventory-current-stock"><span>Stock actual</span><strong>@itemAjuste?.StockActual.ToString("N2")</strong><small>Los límites generan alertas automáticas.</small></div><div class="inventory-form-grid"><label class="inventory-modal-field"><span>Movimiento</span><select @bind="ajuste.TipoMovimiento" disabled="@guardando"><option value="ENTRADA">Entrada</option><option value="SALIDA">Salida</option><option value="AJUSTE">Fijar stock</option><option value="BAJA_VENCIDO">Dar de baja vencido</option></select></label><label class="inventory-modal-field"><span>@(ajuste.TipoMovimiento == "AJUSTE" ? "Stock objetivo" : "Cantidad")</span><input type="number" min="0" step="0.01" @bind="ajuste.Cantidad" disabled="@guardando" /></label><label class="inventory-modal-field"><span>Costo unitario</span><input type="number" min="0" step="0.01" @bind="ajuste.CostoUnitario" disabled="@guardando" /></label><label class="inventory-modal-field"><span>Stock mínimo</span><input type="number" min="0" step="0.01" @bind="ajuste.StockMinimo" disabled="@guardando" /></label><label class="inventory-modal-field"><span>Stock máximo</span><input type="number" min="0" step="0.01" @bind="ajuste.StockMaximo" disabled="@guardando" /></label>@if (ajuste.TipoMovimiento is "ENTRADA" or "AJUSTE") { <label class="inventory-modal-field"><span>Número de lote</span><input @bind="ajuste.NumeroLote" maxlength="80" disabled="@guardando" /></label><label class="inventory-modal-field"><span>Fecha de vencimiento</span><input type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @bind="ajuste.FechaVencimiento" disabled="@guardando" /></label> }<label class="inventory-modal-field is-wide"><span>Observación</span><textarea rows="3" @bind="ajuste.Observacion" disabled="@guardando"></textarea></label></div>@if (!string.IsNullOrWhiteSpace(error)){<div class="inventory-modal-error">@error</div>}</div><footer class="inventory-modal-footer"><button type="button" class="inventory-secondary-btn" @onclick="CerrarAjuste" disabled="@guardando">Cancelar</button><button type="button" class="inventory-primary-btn" @onclick="GuardarAjusteAsync" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar ajuste")</button></footer></section>
}

@if (movimientoSeleccionado is not null)
{
    <div class="inventory-modal-backdrop"></div>
    <section class="inventory-modal inventory-modal-small" role="dialog" aria-modal="true" aria-labelledby="inventarioMovimientoTitulo"><header class="inventory-modal-header"><div><span class="inventory-section-kicker">Trazabilidad del inventario</span><h3 id="inventarioMovimientoTitulo">Detalle del movimiento</h3><p>@movimientoSeleccionado.TipoMovimiento · @movimientoSeleccionado.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><button type="button" class="inventory-modal-close" @onclick="CerrarDetalleMovimiento"><i class="ri-close-line"></i></button></header><div class="inventory-modal-body"><div class="inventory-detail-grid"><div><span>Usuario</span><strong>@(movimientoSeleccionado.NombreUsuario ?? $"Usuario #{movimientoSeleccionado.IdUsuario}")</strong></div><div><span>Referencia</span><strong>@(movimientoSeleccionado.Referencia ?? "-")</strong></div><div><span>Cantidad</span><strong>@movimientoSeleccionado.Cantidad.ToString("N2")</strong></div><div><span>Costo unitario</span><strong>@movimientoSeleccionado.CostoUnitario.ToString("C2")</strong></div><div><span>Costo total</span><strong>@movimientoSeleccionado.CostoTotal.ToString("C2")</strong></div><div><span>Saldo posterior</span><strong>@movimientoSeleccionado.SaldoCantidad.ToString("N2") · @movimientoSeleccionado.SaldoCosto.ToString("C2")</strong></div><div><span>Lote</span><strong>@(movimientoSeleccionado.NumeroLote ?? "-")</strong></div><div><span>Vencimiento</span><strong>@(movimientoSeleccionado.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</strong></div><div class="is-wide"><span>Observación</span><strong>@(movimientoSeleccionado.Observacion ?? "-")</strong></div></div></div><footer class="inventory-modal-footer"><button type="button" class="inventory-secondary-btn" @onclick="CerrarDetalleMovimiento">Cerrar</button></footer></section>
}

@code {
    [SupplyParameterFromQuery(Name = "productoId")]
    public int? ProductoId { get; set; }

    [SupplyParameterFromQuery(Name = "sucursalId")]
    public int? SucursalIdQuery { get; set; }

    private readonly string[] Metodos = ["FIFO", "LIFO", "PROMEDIO"];
    private EContaxInventarioDashboardDto dashboard = new();
    private EContaxInventarioKardexDto? kardex;
    private EContaxInventarioMovimientoDto? movimientoSeleccionado;
    private EContaxInventarioItemDto? itemAjuste;
    private EContaxInventarioAjusteDto? ajuste;
    private string filtro = string.Empty;
    private string filtroAlerta = string.Empty;
    private string ordenInventario = "producto";
    private string kardexTipoFiltro = string.Empty;
    private string metodoSeleccionado = "PROMEDIO";
    private string metodoBorrador = "PROMEDIO";
    private DateTime? kardexDesde;
    private DateTime? kardexHasta;
    private int paginaInventario = 1;
    private int registrosInventarioPagina = 10;
    private int? SucursalSeleccionada { get; set; }
    private int usuarioId;
    private bool cargando = true;
    private bool guardando;
    private bool mostrarAjuste;
    private bool mostrarConfiguracion;
    private bool ultimaCargaExitosa;
    private string? error;
    private string? mensaje;
    private string? rutaCargada;
    private bool EsKardexRuta => NavManager.Uri.Split('?', '#')[0].TrimEnd('/').EndsWith("/kardex", StringComparison.OrdinalIgnoreCase);
    private string MetodoVisible => EsKardexRuta ? kardex?.MetodoValoracion ?? metodoSeleccionado : string.IsNullOrWhiteSpace(dashboard.MetodoValoracion) ? metodoSeleccionado : dashboard.MetodoValoracion;
    private string SucursalSeleccionadaTexto => (SucursalSeleccionada ?? (dashboard.PuedeConsultarTodasSucursales ? 0 : dashboard.Sucursales.FirstOrDefault()?.IdSucursal ?? kardex?.IdSucursal ?? 0)).ToString();
    private string? SucursalResumen => dashboard.PuedeConsultarTodasSucursales && (SucursalSeleccionada is null or 0) ? "Todas las sucursales" : dashboard.Sucursales.FirstOrDefault(x => x.IdSucursal == SucursalSeleccionada)?.Nombre ?? "Sucursal actual";
    private List<EContaxInventarioItemDto> ItemsFiltrados => dashboard.Items.Where(CoincideAlerta).ToList();
    private List<EContaxInventarioItemDto> ItemsInventarioOrdenados => ordenInventario switch
    {
        "stock" => ItemsFiltrados.OrderByDescending(x => x.StockActual).ToList(),
        "costo" => ItemsFiltrados.OrderByDescending(x => x.CostoPromedio).ToList(),
        "alerta" => ItemsFiltrados.OrderByDescending(x => !string.IsNullOrWhiteSpace(x.Alerta) || !string.IsNullOrWhiteSpace(x.AlertaVencimiento)).ThenBy(x => x.NombreProducto).ToList(),
        _ => ItemsFiltrados.OrderBy(x => x.NombreProducto).ToList()
    };
    private List<EContaxInventarioItemDto> ItemsInventarioPagina => ItemsInventarioOrdenados.Skip((PaginaInventarioSegura - 1) * registrosInventarioPagina).Take(registrosInventarioPagina).ToList();
    private int TotalItemsInventario => ItemsFiltrados.Count;
    private int TotalPaginasInventario => Math.Max(1, (int)Math.Ceiling(TotalItemsInventario / (double)registrosInventarioPagina));
    private int PaginaInventarioSegura => Math.Min(Math.Max(paginaInventario, 1), TotalPaginasInventario);
    private int PrimerItemInventario => TotalItemsInventario == 0 ? 0 : ((PaginaInventarioSegura - 1) * registrosInventarioPagina) + 1;
    private int UltimoItemInventario => Math.Min(PaginaInventarioSegura * registrosInventarioPagina, TotalItemsInventario);
    private List<EContaxInventarioMovimientoDto> MovimientosKardexFiltrados => kardex?.Movimientos.Where(CoincideFiltroKardex).ToList() ?? [];
    private bool KardexTieneFiltros => !string.IsNullOrWhiteSpace(kardexTipoFiltro) || kardexDesde.HasValue || kardexHasta.HasValue;
    private decimal ValorInventarioKardex => kardex is null ? 0 : kardex.StockActual * kardex.CostoPromedio;
    private string UltimoMovimientoTexto => kardex?.Movimientos.FirstOrDefault()?.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin movimientos";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        usuarioId = int.TryParse(user.FindFirst("IdUsuario")?.Value ?? user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 0;
        if (usuarioId <= 0) { error = "Sesión no válida."; cargando = false; return; }
        SucursalSeleccionada = SucursalIdQuery > 0 ? SucursalIdQuery : null;
        rutaCargada = ObtenerClaveRuta();
        if (EsKardexRuta && ProductoId is > 0) await CargarKardexAsync(ProductoId.Value);
        else if (EsKardexRuta) { error = "Seleccione un producto desde el catálogo para consultar su Kardex."; cargando = false; }
        else await CargarDashboardAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (usuarioId <= 0)
            return;

        var nuevaRuta = ObtenerClaveRuta();
        if (nuevaRuta == rutaCargada)
            return;

        rutaCargada = nuevaRuta;
        SucursalSeleccionada = SucursalIdQuery > 0 ? SucursalIdQuery : null;
        if (EsKardexRuta && ProductoId is > 0)
            await CargarKardexAsync(ProductoId.Value);
        else if (!EsKardexRuta)
            await CargarDashboardAsync();
    }

    private string ObtenerClaveRuta() => $"{EsKardexRuta}:{ProductoId}:{SucursalIdQuery}";

    private async Task CargarDashboardAsync()
    {
        if (usuarioId <= 0) return;
        paginaInventario = 1;
        ultimaCargaExitosa = false;
        cargando = true; error = null; mensaje = null;
        try
        {
            var url = $"api/e-contax/inventarios?userId={usuarioId}";
            if (SucursalSeleccionada.HasValue) url += $"&sucursalId={SucursalSeleccionada.Value}";
            if (!string.IsNullOrWhiteSpace(filtro)) url += $"&filtro={Uri.EscapeDataString(filtro.Trim())}";
            dashboard = await Http.GetFromJsonAsync<EContaxInventarioDashboardDto>(url) ?? new();
            metodoSeleccionado = dashboard.MetodoValoracion;
            ultimaCargaExitosa = true;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    private async Task CargarKardexAsync(int codigo)
    {
        cargando = true; error = null; mensaje = null;
        try
        {
            var url = $"api/e-contax/inventarios/{codigo}/kardex?userId={usuarioId}";
            if (SucursalSeleccionada is > 0) url += $"&sucursalId={SucursalSeleccionada.Value}";
            kardex = await Http.GetFromJsonAsync<EContaxInventarioKardexDto>(url);
            if (kardex is not null) { SucursalSeleccionada = kardex.IdSucursal; metodoSeleccionado = kardex.MetodoValoracion; }
        }
        catch (Exception ex) { error = ex.Message; kardex = null; }
        finally { cargando = false; }
    }

    private async Task CambiarSucursalAsync(ChangeEventArgs args)
    {
        var sucursalAnterior = SucursalSeleccionada;
        SucursalSeleccionada = int.TryParse(args.Value?.ToString(), out var id) && id > 0 ? id : 0;
        if (EsKardexRuta && ProductoId is > 0) await CargarKardexAsync(ProductoId.Value); else await CargarDashboardAsync();
        if (!EsKardexRuta && !ultimaCargaExitosa)
            SucursalSeleccionada = sucursalAnterior;
    }

    private async Task OnSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await CargarDashboardAsync();
    }

    private bool CoincideAlerta(EContaxInventarioItemDto item)
    {
        if (string.IsNullOrWhiteSpace(filtroAlerta)) return true;
        if (filtroAlerta == "SIN_ALERTA") return string.IsNullOrWhiteSpace(item.Alerta) && string.IsNullOrWhiteSpace(item.AlertaVencimiento);
        if (filtroAlerta == "VENCIMIENTO") return !string.IsNullOrWhiteSpace(item.AlertaVencimiento);
        if (filtroAlerta is "VENCIDO" or "VENCE_7" or "VENCE_30")
            return string.Equals(item.AlertaVencimiento, filtroAlerta, StringComparison.OrdinalIgnoreCase);
        return string.Equals(item.Alerta, filtroAlerta, StringComparison.OrdinalIgnoreCase);
    }
    private bool CoincideFiltroKardex(EContaxInventarioMovimientoDto movimiento)
    {
        if (kardexTipoFiltro == "ENTRADAS" && EsSalida(movimiento.TipoMovimiento)) return false;
        if (kardexTipoFiltro == "SALIDAS" && !EsSalida(movimiento.TipoMovimiento)) return false;
        var fecha = movimiento.FechaMovimiento.ToLocalTime().Date;
        return (!kardexDesde.HasValue || fecha >= kardexDesde.Value.Date) && (!kardexHasta.HasValue || fecha <= kardexHasta.Value.Date);
    }
    private void LimpiarFiltrosKardex()
    {
        kardexTipoFiltro = string.Empty;
        kardexDesde = null;
        kardexHasta = null;
    }
    private void SeleccionarMovimiento(EContaxInventarioMovimientoDto movimiento) => movimientoSeleccionado = movimiento;
    private void CerrarDetalleMovimiento() => movimientoSeleccionado = null;
    private async Task ExportarKardexCsvAsync()
    {
        if (kardex is null || !MovimientosKardexFiltrados.Any()) return;
        var csv = new StringBuilder("Fecha;Movimiento;Usuario;Referencia;Lote;Vencimiento;Cantidad;Costo unitario;Costo total;Saldo cantidad;Saldo costo");
        foreach (var movimiento in MovimientosKardexFiltrados)
        {
            csv.AppendLine().Append(string.Join(';',
                Csv(movimiento.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")),
                Csv(movimiento.TipoMovimiento),
                Csv(movimiento.NombreUsuario ?? $"Usuario #{movimiento.IdUsuario}"),
                Csv(movimiento.Referencia ?? movimiento.Observacion),
                Csv(movimiento.NumeroLote),
                Csv(movimiento.FechaVencimiento?.ToString("dd/MM/yyyy")),
                movimiento.Cantidad.ToString("0.00", CultureInfo.InvariantCulture),
                movimiento.CostoUnitario.ToString("0.00", CultureInfo.InvariantCulture),
                movimiento.CostoTotal.ToString("0.00", CultureInfo.InvariantCulture),
                movimiento.SaldoCantidad.ToString("0.00", CultureInfo.InvariantCulture),
                movimiento.SaldoCosto.ToString("0.00", CultureInfo.InvariantCulture)));
        }

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", $"kardex-{kardex.CodigoProducto}-{DateTime.Now:yyyyMMddHHmm}.csv", streamRef, "text/csv;charset=utf-8");
    }
    private async Task ExportarInventarioCsvAsync()
    {
        var items = ItemsInventarioOrdenados;
        if (items.Count == 0) return;
        var csv = new StringBuilder("Producto;Código;Sucursal;Stock actual;Disponible;Mínimo;Máximo;Costo promedio;Alerta");
        foreach (var item in items)
        {
            csv.AppendLine().Append(string.Join(';',
                Csv(item.NombreProducto), Csv(item.CodigoPrincipal ?? $"#{item.CodigoProducto}"), Csv(item.NombreSucursal),
                item.StockActual.ToString("0.00", CultureInfo.InvariantCulture), item.StockDisponibleVigente.ToString("0.00", CultureInfo.InvariantCulture),
                item.StockMinimo.ToString("0.00", CultureInfo.InvariantCulture), item.StockMaximo.ToString("0.00", CultureInfo.InvariantCulture),
                item.CostoPromedio.ToString("0.00", CultureInfo.InvariantCulture), Csv(TextoAlerta(item))));
        }

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", $"inventario-{DateTime.Now:yyyyMMddHHmm}.csv", streamRef, "text/csv;charset=utf-8");
    }
    private EContaxInventarioReporteDto CrearReporteKardexExportable()
    {
        var movimientos = MovimientosKardexFiltrados.Select(x => new EContaxInventarioReporteMovimientoDto
        {
            FechaMovimiento = x.FechaMovimiento,
            IdUsuario = x.IdUsuario,
            NombreUsuario = x.NombreUsuario,
            CodigoProducto = kardex!.CodigoProducto,
            CodigoPrincipal = kardex.CodigoPrincipal,
            NombreProducto = kardex.NombreProducto,
            IdSucursal = kardex.IdSucursal,
            NombreSucursal = kardex.NombreSucursal,
            TipoMovimiento = x.TipoMovimiento,
            Cantidad = x.Cantidad,
            CostoUnitario = x.CostoUnitario,
            CostoTotal = x.CostoTotal,
            SaldoCantidad = x.SaldoCantidad,
            SaldoCosto = x.SaldoCosto,
            NumeroLote = x.NumeroLote,
            FechaVencimiento = x.FechaVencimiento,
            Referencia = x.Referencia,
            Observacion = x.Observacion
        }).ToList();
        return new EContaxInventarioReporteDto
        {
            Movimientos = movimientos,
            TotalEntradas = movimientos.Where(x => !EsSalida(x.TipoMovimiento)).Sum(x => x.Cantidad),
            TotalSalidas = movimientos.Where(x => EsSalida(x.TipoMovimiento)).Sum(x => x.Cantidad),
            ValorEntradas = movimientos.Where(x => !EsSalida(x.TipoMovimiento)).Sum(x => x.CostoTotal),
            ValorSalidas = movimientos.Where(x => EsSalida(x.TipoMovimiento)).Sum(x => x.CostoTotal)
        };
    }
    private async Task ExportarKardexExcelAsync()
    {
        if (kardex is null || !MovimientosKardexFiltrados.Any()) return;
        var reporte = CrearReporteKardexExportable();
        var rows = reporte.Movimientos.Select(x => (IReadOnlyList<string>)[
            x.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), x.TipoMovimiento,
            x.NombreUsuario ?? $"Usuario #{x.IdUsuario}", x.Referencia ?? x.Observacion ?? string.Empty,
            x.NumeroLote ?? string.Empty, x.FechaVencimiento?.ToString("dd/MM/yyyy") ?? string.Empty,
            x.Cantidad.ToString("N4"), x.CostoUnitario.ToString("N4"), x.CostoTotal.ToString("N4"),
            x.SaldoCantidad.ToString("N4"), x.SaldoCosto.ToString("N4")]).ToList();
        var archivo = ExcelExportService.Create($"kardex_{kardex.CodigoProducto}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", new ExcelSheetData("Kardex", ["Fecha", "Movimiento", "Usuario", "Referencia", "Lote", "Vencimiento", "Cantidad", "Costo unitario", "Costo total", "Saldo cantidad", "Saldo costo"], rows));
        await DescargarBytesAsync(archivo.FileName, archivo.Content);
    }
    private async Task ExportarKardexPdfAsync()
    {
        if (kardex is null || !MovimientosKardexFiltrados.Any()) return;
        await DescargarBytesAsync($"kardex_{kardex.CodigoProducto}_{DateTime.Now:yyyyMMdd_HHmm}.pdf", InventarioPdfService.Generar(CrearReporteKardexExportable()));
    }
    private async Task DescargarBytesAsync(string fileName, byte[] content)
    {
        await using var stream = new MemoryStream(content);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
    private static string Csv(string? value)
    {
        var texto = value ?? string.Empty;
        return "\"" + texto.Replace("\"", "\"\"") + "\"";
    }
    private void SeleccionarAlerta(string alerta) { filtroAlerta = filtroAlerta == alerta ? string.Empty : alerta; paginaInventario = 1; }
    private void CambiarFiltroAlerta(ChangeEventArgs args) { filtroAlerta = args.Value?.ToString() ?? string.Empty; paginaInventario = 1; }
    private void CambiarOrdenInventario(ChangeEventArgs args) { ordenInventario = args.Value?.ToString() ?? "producto"; paginaInventario = 1; }
    private void CambiarRegistrosInventario(ChangeEventArgs args)
    {
        registrosInventarioPagina = int.TryParse(args.Value?.ToString(), out var valor) && valor is 10 or 20 or 50 ? valor : 10;
        paginaInventario = 1;
    }
    private void CambiarPaginaInventario(int pagina) => paginaInventario = Math.Clamp(pagina, 1, TotalPaginasInventario);
    private static string TextoAlerta(EContaxInventarioItemDto item)
    {
        var stock = item.Alerta switch
        {
            "MINIMO" => "Bajo mínimo",
            "MAXIMO" => "Sobre máximo",
            _ => string.Empty
        };
        var vencimiento = item.AlertaVencimiento switch
        {
            "VENCIDO" => "Vencido",
            "VENCE_7" => $"Vence {item.ProximoVencimiento:dd/MM}",
            "VENCE_30" => $"Vence {item.ProximoVencimiento:dd/MM}",
            _ => string.Empty
        };
        return string.IsNullOrWhiteSpace(stock) ? (string.IsNullOrWhiteSpace(vencimiento) ? "Normal" : vencimiento) :
            string.IsNullOrWhiteSpace(vencimiento) ? stock : $"{stock} · {vencimiento}";
    }
    private static string ClaseAlerta(EContaxInventarioItemDto item) =>
        item.AlertaVencimiento == "VENCIDO" || item.Alerta == "MINIMO" ? "is-min" :
        item.Alerta == "MAXIMO" || item.AlertaVencimiento == "VENCE_7" ? "is-max" : "is-ok";
    private static bool EsSalida(string tipo) => tipo.Contains("SALIDA", StringComparison.OrdinalIgnoreCase) || tipo.Contains("BAJA", StringComparison.OrdinalIgnoreCase) || tipo.Equals("DEVOLUCION_COMPRA", StringComparison.OrdinalIgnoreCase) || tipo.Equals("ANULACION_RECEPCION", StringComparison.OrdinalIgnoreCase) || tipo.Equals("DEVOLUCION_VENTA_REVERSA", StringComparison.OrdinalIgnoreCase);
    private static decimal CostoSaldoUnitario(EContaxInventarioMovimientoDto movimiento) => movimiento.SaldoCantidad == 0 ? 0 : movimiento.SaldoCosto / movimiento.SaldoCantidad;
    private void AbrirKardex(int codigo, int sucursal) => NavManager.NavigateTo($"{EContaxRoutes.InventariosKardex}?productoId={codigo}&sucursalId={sucursal}");
    private void VolverInventarios() => NavManager.NavigateTo(EContaxRoutes.Inventarios);
    private void AbrirOperaciones() => NavManager.NavigateTo(EContaxRoutes.InventariosOperaciones);
    private void AbrirReportes() => NavManager.NavigateTo(EContaxRoutes.InventariosReportes);
    private void AbrirConfiguracion() { metodoBorrador = MetodoVisible; error = null; mostrarConfiguracion = true; }
    private void CerrarConfiguracion() { if (!guardando) mostrarConfiguracion = false; }

    private void AbrirAjuste(EContaxInventarioItemDto item)
    {
        itemAjuste = item;
        ajuste = new EContaxInventarioAjusteDto { CodigoProducto = item.CodigoProducto, IdSucursal = item.IdSucursal, Cantidad = item.StockActual, StockMinimo = item.StockMinimo, StockMaximo = item.StockMaximo, CostoUnitario = item.CostoPromedio };
        error = null; mostrarAjuste = true;
    }

    private void CerrarAjuste() { mostrarAjuste = false; ajuste = null; itemAjuste = null; }

    private async Task GuardarAjusteAsync()
    {
        if (ajuste is null || guardando) return;
        guardando = true; error = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/e-contax/inventarios/ajuste?userId={usuarioId}", ajuste);
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
            CerrarAjuste(); mensaje = "El inventario se actualizó correctamente."; await CargarDashboardAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { guardando = false; }
    }

    private async Task GuardarMetodoAsync()
    {
        if (guardando) return;
        guardando = true; error = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/e-contax/inventarios/configuracion?userId={usuarioId}", new EContaxInventarioConfiguracionDto { MetodoValoracion = metodoBorrador });
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
            dashboard.MetodoValoracion = metodoBorrador;
            if (kardex is not null) kardex.MetodoValoracion = metodoBorrador;
            metodoSeleccionado = metodoBorrador; mensaje = "Método de valoración actualizado."; mostrarConfiguracion = false;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { guardando = false; }
    }

    private async Task LimpiarFiltros()
    {
        filtro = string.Empty; filtroAlerta = string.Empty; ordenInventario = "producto"; paginaInventario = 1; registrosInventarioPagina = 10; SucursalSeleccionada = dashboard.PuedeConsultarTodasSucursales ? 0 : null;
        await CargarDashboardAsync();
    }
}
