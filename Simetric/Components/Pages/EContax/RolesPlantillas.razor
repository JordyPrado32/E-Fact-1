@page "/e-contax/administracion/roles"
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Models.EContax
@using Simetric.Services
@using Simetric.Services.EContax
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthenticationStateProvider AuthStateProvider
@inject EContaxAdministracionService AdministracionService
@inject NavigationManager NavManager

<PageTitle>Roles y permisos | E-Contax</PageTitle>

<div class="econtax-role-templates">
    <section class="security-hero">
        <div class="hero-copy">
            <span class="hero-eyebrow">Control de accesos</span>
            <h2>Roles y permisos</h2>
            <p>Administra las plantillas de acceso y los menús disponibles para cada rol de E-Contax.</p>
        </div>
        <div class="hero-actions">
            <button type="button" class="secondary-btn accent-btn" @onclick="NuevoMenu">
                <i class="bi bi-list-stars"></i>
                <span>Nuevo menú</span>
            </button>
            <button type="button" class="secondary-btn accent-btn" @onclick="AbrirOrdenMenus">
                <i class="bi bi-menu-button-wide"></i>
                <span>Ordenar menús</span>
            </button>
            <button type="button" class="primary-btn" @onclick="AbrirModalRol" disabled="@(!esSuperAdmin)">
                <i class="bi bi-plus-circle"></i>
                <span>Nuevo perfil</span>
            </button>
        </div>

        <div class="hero-summary">
            <article class="summary-card summary-card-primary">
                <span class="summary-label">Roles registrados</span>
                <strong>@roles.Count</strong>
                <small>Plantillas disponibles para asignar accesos.</small>
            </article>
            <article class="summary-card">
                <span class="summary-label">Módulos principales</span>
                <strong>@MenusPadre.Count()</strong>
                <small>Estructura principal de navegación.</small>
            </article>
            <article class="summary-card">
                <span class="summary-label">Ítems de menú</span>
                <strong>@menus.Count</strong>
                <small>Opciones configuradas dentro del sistema.</small>
            </article>
            <article class="summary-card">
                <span class="summary-label">Permisos seleccionados</span>
                <strong>@menusSeleccionados.Count</strong>
                <small>@(rolSeleccionado is null ? "Selecciona un rol para comenzar." : $"Asignación actual de {rolSeleccionado.NombreRol}.")</small>
            </article>
        </div>
    </section>

    @if (cargando)
    {
        <section class="roles-panel state-panel">
            <i class="bi bi-arrow-repeat state-spinner"></i>
            <strong>Cargando roles y menús</strong>
            <span>Preparando la configuración de accesos.</span>
        </section>
    }
    else if (!esSuperAdmin)
    {
        <section class="roles-panel p-4">
            <h3>Administración interna de la empresa</h3>
            <p>Las plantillas globales son del superadmin. Como jefe de empresa puedes configurar sucursales y roles internos.</p>
            <a class="primary-btn d-inline-flex mt-2" href="@EContaxRoutes.Organizacion">Gestionar empresa, sucursales y roles</a>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger mt-3">@error</div>
        }
        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert alert-success mt-3">@mensaje</div>
        }

        <section class="role-template-layout">
            <aside class="roles-panel role-template-list">
                <div class="panel-head">
                    <div>
                        <span class="panel-kicker">Plantillas disponibles</span>
                        <h3>Roles E-Contax</h3>
                    </div>
                    <span class="panel-badge">@roles.Count</span>
                </div>

                @if (!roles.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-shield-plus"></i>
                        <strong>No hay roles disponibles</strong>
                        <span>Crea la primera plantilla para asignar accesos.</span>
                    </div>
                }
                else
                {
                    <div class="role-template-items">
                        @foreach (var rol in roles)
                        {
                            <article
                                    @key="rol.IdRol"
                                    class="role-template-item @(rolSeleccionado?.IdRol == rol.IdRol ? "is-selected" : string.Empty)"
                                    @onclick="() => SeleccionarRolAsync(rol)">
                                <div class="role-copy">
                                    <strong>@rol.NombreRol</strong>
                                    <small>Perfil @(rol.EstadoRol == 1 ? "activo" : "inactivo")</small>
                                </div>
                                <div class="role-actions">
                                    <span class="role-status @(rol.EstadoRol == 1 ? "is-active" : "is-inactive")">
                                        @(rol.EstadoRol == 1 ? "Activo" : "Inactivo")
                                    </span>
                                    <button type="button" class="select-role-btn" @onclick:stopPropagation="true" @onclick="() => SeleccionarRolAsync(rol)">
                                        <i class="bi bi-check-lg"></i>
                                        <span>Seleccionar</span>
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </aside>

            <section class="roles-panel role-template-editor">
                <div class="panel-head editor-head">
                    <div>
                        <span class="panel-kicker">Matriz de permisos</span>
                        <h3>@(rolSeleccionado?.IdRol > 0 ? rolSeleccionado.NombreRol : "Nuevo rol")</h3>
                        <p>Selecciona los módulos e ítems disponibles para este perfil.</p>
                    </div>
                    <div class="editor-actions">
                        @if (rolSeleccionado?.IdRol > 0)
                        {
                            <button type="button" class="secondary-btn state-btn" @onclick="CambiarEstadoRolAsync">
                                <i class="bi @(rolSeleccionado.EstadoRol == 1 ? "bi-pause-circle" : "bi-play-circle")"></i>
                                <span>@(rolSeleccionado.EstadoRol == 1 ? "Desactivar" : "Reactivar")</span>
                            </button>
                        }
                        @if (rolSeleccionado is not null)
                        {
                            <button type="button" class="primary-btn" @onclick="GuardarAsync" disabled="@guardando">
                                <i class="bi bi-floppy"></i>
                                <span>@(guardando ? "Guardando..." : "Guardar cambios")</span>
                            </button>
                        }
                    </div>
                </div>

                @if (rolSeleccionado is null)
                {
                    <div class="empty-state editor-empty">
                        <i class="bi bi-person-lock"></i>
                        <strong>Selecciona un rol</strong>
                        <span>Elige una plantilla o crea una nueva para configurar sus permisos.</span>
                    </div>
                }
                else
                {
                    <div class="role-name-field">
                        <label for="role-name">Nombre del rol</label>
                        <input id="role-name" class="form-control" @bind="rolSeleccionado.NombreRol" maxlength="200" />
                    </div>

                    <div class="permissions-intro">
                        <div>
                            <span class="panel-kicker">Menús de navegación</span>
                            <p>@(RolJefeEmpresaSeleccionado ? "JEFE_EMPRESA tiene acceso total para los superadmins." : "Selecciona todos los accesos que tendrá esta plantilla.")</p>
                        </div>
                        <span class="selection-badge">@menusSeleccionados.Count seleccionados</span>
                    </div>

                    <div class="role-menu-template-list">
                        @foreach (var menu in MenusPadre)
                        {
                            var hijos = GetMenusHijos(menu.IdMenu).ToList();
                            <div class="role-menu-template-group">
                                <header class="module-head">
                                    <label class="role-menu-template-parent">
                                        <input type="checkbox"
                                               class="permission-check"
                                               checked="@menusSeleccionados.Contains(menu.IdMenu)"
                                               disabled="@RolJefeEmpresaSeleccionado"
                                               @onchange="e => CambiarMenu(menu.IdMenu, e.Value is true)" />
                                        <span class="module-copy">
                                            <span class="module-kicker">Módulo principal</span>
                                            <strong class="module-title">
                                                <i class="@ResolveIcono(menu.IconoMenu)"></i>
                                                @menu.NombreMenu
                                            </strong>
                                            <span class="module-badge">@hijos.Count @(hijos.Count == 1 ? "ítem" : "ítems")</span>
                                        </span>
                                    </label>
                                    <div class="action-group">
                                        <button type="button" class="action-btn action-view" title="Ver detalle" @onclick="() => VerMenu(menu)"><i class="bi bi-eye"></i></button>
                                        <button type="button" class="action-btn action-edit" title="Editar módulo" @onclick="() => EditarMenu(menu)"><i class="bi bi-pencil-square"></i></button>
                                        <button type="button" class="action-btn action-delete" title="Eliminar módulo" @onclick="() => ConfirmarEliminarMenu(menu)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </header>
                                @if (hijos.Any())
                                {
                                    <div class="module-children">
                                        @foreach (var hijo in hijos)
                                        {
                                            <div class="child-row">
                                                <label class="role-menu-template-child">
                                                    <input type="checkbox" class="permission-check"
                                                           checked="@menusSeleccionados.Contains(hijo.IdMenu)"
                                                           disabled="@RolJefeEmpresaSeleccionado"
                                                           @onchange="e => CambiarMenu(hijo.IdMenu, e.Value is true)" />
                                                    <span>@hijo.NombreMenu</span>
                                                </label>
                                                <div class="action-group">
                                                    <button type="button" class="action-btn action-view" title="Ver detalle" @onclick="() => VerMenu(hijo)"><i class="bi bi-eye"></i></button>
                                                    <button type="button" class="action-btn action-edit" title="Editar ítem" @onclick="() => EditarMenu(hijo)"><i class="bi bi-pencil-square"></i></button>
                                                    <button type="button" class="action-btn action-delete" title="Eliminar ítem" @onclick="() => ConfirmarEliminarMenu(hijo)"><i class="bi bi-trash"></i></button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="module-empty"><i class="bi bi-info-circle"></i> Este módulo aún no tiene ítems hijos.</div>
                                }
                            </div>
                        }
                    </div>

                    @if (MenusHuerfanos.Any())
                    {
                        <div class="role-menu-template-group orphan-group">
                            <header class="module-head"><span class="panel-kicker">Otros menús</span></header>
                            <div class="module-children">
                                @foreach (var menu in MenusHuerfanos)
                                {
                                    <label class="role-menu-template-child">
                                        <input type="checkbox" class="permission-check"
                                               checked="@menusSeleccionados.Contains(menu.IdMenu)"
                                               disabled="@RolJefeEmpresaSeleccionado"
                                               @onchange="e => CambiarMenu(menu.IdMenu, e.Value is true)" />
                                        <span>@menu.NombreMenu</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        </section>
    }
</div>

@if (mostrarModalMenu && menuEdicion is not null)
{
    <div class="modal-backdrop"></div>
    <div class="role-modal" role="dialog" aria-modal="true">
        <div class="role-modal-card">
            <header class="role-modal-head">
                <div><span class="modal-kicker">@(menuSoloLectura ? "Vista de detalle" : "Configuración de menú")</span><h3>@(menuSoloLectura ? "Detalle del ítem" : menuEdicion.IdMenu == 0 ? "Crear nuevo ítem" : "Editar ítem maestro")</h3></div>
                <button type="button" class="modal-close" @onclick="CerrarModalMenu" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </header>
            <div class="role-modal-body">
                @if (menuSoloLectura)
                {
                    <div class="detail-grid">
                        <div class="detail-field wide"><label>Tipo de ítem</label><div>@(menuEdicion.IdPadre is null or 0 ? "Módulo principal" : "Submenú")</div></div>
                        <div class="detail-field wide"><label>Nombre visible</label><div>@menuEdicion.NombreMenu</div></div>
                        <div class="detail-field"><label>Icono</label><div><i class="@ResolveIcono(menuEdicion.IconoMenu)"></i> @(menuEdicion.IconoMenu ?? "Sin icono")</div></div>
                        <div class="detail-field"><label>Estado</label><div>@(menuEdicion.EstadoMenu == 1 ? "Activo" : "Inactivo")</div></div>
                        <div class="detail-field wide"><label>Padre</label><div>@NombrePadre(menuEdicion)</div></div>
                        <div class="detail-field wide"><label>Ruta</label><div>@(string.IsNullOrWhiteSpace(menuEdicion.UrlMenu) ? "Ruta pendiente" : menuEdicion.UrlMenu)</div></div>
                    </div>
                }
                else
                {
                    <div class="form-grid">
                        <div class="form-field wide"><label>Tipo de ítem o ubicación</label><select class="form-select" @bind="menuEdicion.IdPadre"><option value="">Es un módulo principal</option>@foreach (var padre in MenusPadre.Where(item => item.IdMenu != menuEdicion.IdMenu)){<option value="@padre.IdMenu">Hijo de: @padre.NombreMenu</option>}</select></div>
                        <div class="form-field"><label>Nombre visible</label><input class="form-control" @bind="menuEdicion.NombreMenu" maxlength="200" placeholder="Ej: Facturación" /></div>
                        <div class="form-field"><label>Icono</label><div class="icon-field"><span><i class="@ResolveIcono(menuEdicion.IconoMenu)"></i></span><input class="form-control" @bind="menuEdicion.IconoMenu" maxlength="50" placeholder="ri-checkbox-blank-circle-line" /></div></div>
                        @if (menuEdicion.IdPadre is null or 0)
                        {
                            <div class="menu-note wide"><i class="bi bi-info-circle"></i><span>Los módulos principales solo agrupan ítems y no necesitan ruta de navegación.</span></div>
                        }
                        else
                        {
                            <div class="form-field wide"><label>Ruta de navegación</label><input class="form-control" @bind="menuEdicion.UrlMenu" maxlength="200" placeholder="/e-contax/ruta" /></div>
                        }
                        <a class="icon-catalog wide" href="https://remixicon.com" target="_blank" rel="noopener noreferrer">Ver catálogo de iconos RemixIcon</a>
                    </div>
                }
            </div>
            <footer class="role-modal-footer">
                <button type="button" class="secondary-btn" @onclick="CerrarModalMenu">Cerrar</button>
                @if (!menuSoloLectura) { <button type="button" class="primary-btn" @onclick="GuardarMenuAsync" disabled="@guardandoMenu"><i class="bi @(menuEdicion.IdMenu == 0 ? "bi-plus-lg" : "bi-floppy")"></i> @(guardandoMenu ? "Guardando..." : menuEdicion.IdMenu == 0 ? "Crear ítem" : "Actualizar")</button> }
            </footer>
        </div>
    </div>
}

@if (mostrarOrdenMenus)
{
    <div class="modal-backdrop"></div>
    <div class="role-modal" role="dialog" aria-modal="true">
        <div class="role-modal-card order-modal-card">
            <header class="role-modal-head"><div><span class="modal-kicker">Navegación del portal</span><h3>Ordenar menú de servicios</h3></div><button type="button" class="modal-close" @onclick="CerrarOrdenMenus"><i class="bi bi-x-lg"></i></button></header>
            <div class="role-modal-body">
                <p class="order-help">Utiliza las flechas para ordenar los menús tal como quieres que aparezcan en el panel lateral.</p>
                <div class="order-columns">
                    <section class="order-panel"><header><strong>Módulos principales</strong><span>@MenusOrdenablesPadre.Count()</span></header><div class="order-list">@foreach (var item in MenusOrdenablesPadre){<div class="order-row @(menuPadreOrdenId == item.IdMenu ? "selected" : string.Empty)" @onclick="() => SeleccionarPadreOrden(item.IdMenu)"><i class="bi bi-arrows-move drag-icon"></i><span class="order-icon"><i class="@ResolveIcono(item.IconoMenu)"></i></span><strong>@item.NombreMenu</strong><div class="order-actions"><button type="button" @onclick:stopPropagation="true" @onclick="() => MoverMenu(item.IdMenu, -1)"><i class="bi bi-arrow-up"></i></button><button type="button" @onclick:stopPropagation="true" @onclick="() => MoverMenu(item.IdMenu, 1)"><i class="bi bi-arrow-down"></i></button></div></div>}</div></section>
                    <section class="order-panel"><header><strong>Submenús de:</strong><span class="selected-parent">@NombrePadreOrden</span></header><div class="order-list">@if (!SubmenusOrdenables.Any()){<div class="order-empty"><i class="bi bi-info-circle"></i><span>Este módulo no tiene submenús.</span></div>}else{@foreach (var item in SubmenusOrdenables){<div class="order-row"><i class="bi bi-arrows-move drag-icon"></i><span class="order-icon"><i class="@ResolveIcono(item.IconoMenu)"></i></span><strong>@item.NombreMenu</strong><div class="order-actions"><button type="button" @onclick="() => MoverMenu(item.IdMenu, -1)"><i class="bi bi-arrow-up"></i></button><button type="button" @onclick="() => MoverMenu(item.IdMenu, 1)"><i class="bi bi-arrow-down"></i></button></div></div>}}</div></section>
                </div>
            </div>
            <footer class="role-modal-footer"><button type="button" class="secondary-btn" @onclick="CerrarOrdenMenus">Cancelar</button><button type="button" class="primary-btn" @onclick="GuardarOrdenMenusAsync" disabled="@guardandoMenu"><i class="bi bi-floppy"></i> Guardar orden</button></footer>
        </div>
    </div>
}

@if (mostrarModalRol)
{
    <div class="modal-backdrop"></div>
    <div class="role-modal" role="dialog" aria-modal="true">
        <div class="role-modal-card profile-modal-card">
            <header class="role-modal-head"><div><span class="modal-kicker">Nuevo perfil</span><h3>Crear rol de usuario</h3></div><button type="button" class="modal-close" @onclick="CerrarModalRol"><i class="bi bi-x-lg"></i></button></header>
            <div class="role-modal-body"><div class="form-field"><label>Nombre del perfil</label><input class="form-control profile-input" @bind="nuevoNombreRol" @bind:event="oninput" maxlength="200" placeholder="Ej: Administrador, Auditor, Supervisor..." /></div></div>
            <footer class="role-modal-footer"><button type="button" class="secondary-btn" @onclick="CerrarModalRol">Cancelar</button><button type="button" class="primary-btn" @onclick="CrearRolAsync" disabled="@(guardando || string.IsNullOrWhiteSpace(nuevoNombreRol))"><i class="bi bi-plus-circle"></i> Crear perfil</button></footer>
        </div>
    </div>
}

@if (menuAEliminar is not null)
{
    <div class="modal-backdrop"></div>
    <div class="role-modal" role="dialog" aria-modal="true">
        <div class="role-modal-card confirm-card"><div class="role-modal-body confirm-body"><i class="bi bi-trash"></i><h3>Eliminar menú</h3><p>Se desactivará <strong>@menuAEliminar.NombreMenu</strong>@(menuAEliminar.IdPadre is null or 0 ? " y sus ítems hijos" : string.Empty).</p></div><footer class="role-modal-footer"><button type="button" class="secondary-btn" @onclick="CancelarEliminarMenu">Cancelar</button><button type="button" class="danger-btn" @onclick="EliminarMenuAsync">Eliminar</button></footer></div>
    </div>
}

@code {
    private readonly List<EContaxRol> roles = new();
    private readonly List<EContaxMenu> menus = new();
    private EContaxRol? rolSeleccionado;
    private HashSet<int> menusSeleccionados = new();
    private bool cargando = true;
    private bool guardando;
    private bool esSuperAdmin;
    private string? error;
    private string? mensaje;
    private EContaxMenu? menuEdicion;
    private EContaxMenu? menuAEliminar;
    private readonly List<EContaxMenu> menusOrdenables = new();
    private bool mostrarModalMenu;
    private bool menuSoloLectura;
    private bool mostrarOrdenMenus;
    private bool guardandoMenu;
    private bool mostrarModalRol;
    private string nuevoNombreRol = string.Empty;
    private int? menuPadreOrdenId;

    private IEnumerable<EContaxMenu> MenusOrdenablesPadre => menusOrdenables.Where(item => item.IdPadre is null or 0).OrderBy(item => item.OrdenMenu ?? int.MaxValue);
    private IEnumerable<EContaxMenu> SubmenusOrdenables => menusOrdenables.Where(item => item.IdPadre == menuPadreOrdenId).OrderBy(item => item.OrdenMenu ?? int.MaxValue);
    private string NombrePadreOrden => menusOrdenables.FirstOrDefault(item => item.IdMenu == menuPadreOrdenId)?.NombreMenu ?? "Selecciona un módulo";

    private IEnumerable<EContaxMenu> MenusPadre => menus
        .Where(item => item.IdPadre is null or 0)
        .OrderBy(item => item.OrdenMenu ?? int.MaxValue)
        .ThenBy(item => item.NombreMenu);

    private IEnumerable<EContaxMenu> MenusHuerfanos => menus
        .Where(item => item.IdPadre is > 0 && !menus.Any(parent => parent.IdMenu == item.IdPadre))
        .OrderBy(item => item.OrdenMenu ?? int.MaxValue)
        .ThenBy(item => item.NombreMenu);

    private bool RolJefeEmpresaSeleccionado =>
        rolSeleccionado is not null && EsRolJefeEmpresa(rolSeleccionado.NombreRol);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        esSuperAdmin = user.Identity?.IsAuthenticated == true &&
            string.Equals(user.FindFirst("IdTipoUsuario")?.Value, AppAccessService.AdminRoleId, StringComparison.OrdinalIgnoreCase);

        if (esSuperAdmin)
        {
            await CargarAsync();
        }
        else
        {
            cargando = false;
        }
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            roles.Clear();
            roles.AddRange((await AdministracionService.GetEContaxRolesAsync(includeInactivos: true))
                .OrderBy(item => item.NombreRol));
            menus.Clear();
            menus.AddRange(await AdministracionService.GetEContaxMenusAsync());

            if (rolSeleccionado is null)
            {
                var primerRol = roles.FirstOrDefault(item => item.EstadoRol == 1) ?? roles.FirstOrDefault();
                if (primerRol is not null)
                {
                    await SeleccionarRolAsync(primerRol);
                }
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar las plantillas. {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SeleccionarRolAsync(EContaxRol rol)
    {
        rolSeleccionado = new EContaxRol
        {
            IdRol = rol.IdRol,
            NombreRol = rol.NombreRol,
            PermisoRol = rol.PermisoRol,
            EstadoRol = rol.EstadoRol
        };
        menusSeleccionados = EsRolJefeEmpresa(rol.NombreRol)
            ? menus.Where(item => item.EstadoMenu == 1).Select(item => item.IdMenu).ToHashSet()
            : (await AdministracionService.GetEContaxMenusByRolIdAsync(rol.IdRol))
                .Select(item => item.IdMenu)
                .ToHashSet();
        mensaje = null;
        error = null;
    }

    private void AbrirModalRol() { nuevoNombreRol = string.Empty; mostrarModalRol = true; }
    private void CerrarModalRol() { mostrarModalRol = false; nuevoNombreRol = string.Empty; }

    private async Task CrearRolAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevoNombreRol)) return;
        guardando = true;
        var nuevo = new EContaxRol { NombreRol = nuevoNombreRol.Trim(), EstadoRol = 1 };
        var correcto = await AdministracionService.GuardarEContaxRolAsync(nuevo);
        guardando = false;
        if (!correcto) { error = "No se pudo crear el perfil. Verifica que el nombre no esté registrado."; return; }
        CerrarModalRol();
        await CargarRolesAsync();
        var creado = roles.FirstOrDefault(item => string.Equals(item.NombreRol, nuevo.NombreRol, StringComparison.OrdinalIgnoreCase));
        if (creado is not null) await SeleccionarRolAsync(creado);
        mensaje = "Perfil creado correctamente.";
    }

    private void NuevoMenu()
    {
        menuEdicion = new EContaxMenu { EstadoMenu = 1 };
        menuSoloLectura = false;
        mostrarModalMenu = true;
    }

    private void VerMenu(EContaxMenu menu) => AbrirMenu(menu, true);
    private void EditarMenu(EContaxMenu menu) => AbrirMenu(menu, false);

    private void AbrirMenu(EContaxMenu menu, bool soloLectura)
    {
        menuEdicion = CopiarMenu(menu);
        menuSoloLectura = soloLectura;
        mostrarModalMenu = true;
    }

    private void CerrarModalMenu() { mostrarModalMenu = false; menuEdicion = null; }
    private void ConfirmarEliminarMenu(EContaxMenu menu) => menuAEliminar = menu;
    private void CancelarEliminarMenu() => menuAEliminar = null;

    private void AbrirOrdenMenus()
    {
        menusOrdenables.Clear();
        menusOrdenables.AddRange(menus.OrderBy(item => item.OrdenMenu ?? int.MaxValue).ThenBy(item => item.NombreMenu).Select(CopiarMenu));
        NormalizarOrden(menusOrdenables.Where(item => item.IdPadre is null or 0));
        foreach (var grupo in menusOrdenables.Where(item => item.IdPadre is > 0).GroupBy(item => item.IdPadre)) NormalizarOrden(grupo);
        menuPadreOrdenId = MenusOrdenablesPadre.FirstOrDefault()?.IdMenu;
        mostrarOrdenMenus = true;
    }

    private void CerrarOrdenMenus() { mostrarOrdenMenus = false; menusOrdenables.Clear(); }
    private void SeleccionarPadreOrden(int idMenu) => menuPadreOrdenId = idMenu;

    private void MoverMenu(int idMenu, int desplazamiento)
    {
        var actual = menusOrdenables.First(item => item.IdMenu == idMenu);
        var grupo = menusOrdenables.Where(item => item.IdPadre == actual.IdPadre).OrderBy(item => item.OrdenMenu).ToList();
        var indice = grupo.FindIndex(item => item.IdMenu == idMenu);
        var destino = indice + desplazamiento;
        if (destino < 0 || destino >= grupo.Count) return;
        (grupo[indice].OrdenMenu, grupo[destino].OrdenMenu) = (grupo[destino].OrdenMenu, grupo[indice].OrdenMenu);
    }

    private static void NormalizarOrden(IEnumerable<EContaxMenu> items)
    {
        var orden = 1;
        foreach (var item in items.OrderBy(value => value.OrdenMenu ?? int.MaxValue).ThenBy(value => value.NombreMenu)) item.OrdenMenu = orden++;
    }

    private string NombrePadre(EContaxMenu menu) => menu.IdPadre is null or 0 ? "Sin padre" : menus.FirstOrDefault(item => item.IdMenu == menu.IdPadre)?.NombreMenu ?? "Sin padre";

    private async Task GuardarMenuAsync()
    {
        if (menuEdicion is null || string.IsNullOrWhiteSpace(menuEdicion.NombreMenu)) { error = "El nombre del menú es obligatorio."; return; }
        guardandoMenu = true;
        var correcto = await AdministracionService.GuardarEContaxMenuAsync(menuEdicion);
        guardandoMenu = false;
        if (!correcto) { error = "No se pudo guardar el menú. Verifica el nombre, la ruta y el módulo padre."; return; }
        CerrarModalMenu();
        await RecargarMenusAsync();
        mensaje = "Menú guardado correctamente.";
    }

    private async Task GuardarOrdenMenusAsync()
    {
        guardandoMenu = true;
        var correcto = await AdministracionService.ActualizarOrdenMenusAsync(menusOrdenables);
        guardandoMenu = false;
        if (!correcto) { error = "No se pudo actualizar el orden de los menús."; return; }
        CerrarOrdenMenus();
        await RecargarMenusAsync();
        mensaje = "Orden de menús actualizado.";
    }

    private async Task EliminarMenuAsync()
    {
        if (menuAEliminar is null) return;
        guardandoMenu = true;
        var correcto = await AdministracionService.EliminarLogicoEContaxMenuAsync(menuAEliminar.IdMenu);
        guardandoMenu = false;
        menuAEliminar = null;
        if (!correcto) { error = "No se pudo eliminar el menú."; return; }
        await RecargarMenusAsync();
        mensaje = "Menú eliminado correctamente.";
    }

    private async Task RecargarMenusAsync()
    {
        menus.Clear();
        menus.AddRange(await AdministracionService.GetEContaxMenusAsync());
        menusSeleccionados.IntersectWith(menus.Select(item => item.IdMenu));
    }

    private static EContaxMenu CopiarMenu(EContaxMenu menu) => new()
    {
        IdMenu = menu.IdMenu, NombreMenu = menu.NombreMenu, PerteneceMenu = menu.PerteneceMenu,
        UrlMenu = menu.UrlMenu, DescripcionMenu = menu.DescripcionMenu, IconoMenu = menu.IconoMenu,
        EstadoMenu = menu.EstadoMenu, IdPadre = menu.IdPadre, OrdenMenu = menu.OrdenMenu
    };

    private void CambiarMenu(int idMenu, bool seleccionado)
    {
        if (seleccionado)
        {
            menusSeleccionados.Add(idMenu);
        }
        else
        {
            menusSeleccionados.Remove(idMenu);
        }
    }

    private async Task GuardarAsync()
    {
        if (rolSeleccionado is null || string.IsNullOrWhiteSpace(rolSeleccionado.NombreRol))
        {
            error = "El nombre del rol es obligatorio.";
            return;
        }

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            var nombre = rolSeleccionado.NombreRol.Trim();
            if (!await AdministracionService.GuardarEContaxRolAsync(rolSeleccionado))
            {
                error = "No se pudo guardar el rol. Verifica que no exista otro con el mismo nombre.";
                return;
            }

            await CargarRolesAsync();
            var guardado = roles.FirstOrDefault(item =>
                item.IdRol == rolSeleccionado.IdRol ||
                string.Equals(item.NombreRol?.Trim(), nombre, StringComparison.OrdinalIgnoreCase));

            var menusDelRol = RolJefeEmpresaSeleccionado
                ? menus.Where(item => item.EstadoMenu == 1).Select(item => item.IdMenu).ToList()
                : menusSeleccionados.ToList();

            if (guardado is null || !await AdministracionService.AsignarEContaxMenusARolAsync(guardado.IdRol, menusDelRol))
            {
                error = "El rol se guardó, pero no se pudieron guardar sus menús.";
                return;
            }

            await SeleccionarRolAsync(guardado);
            mensaje = "Plantilla de rol guardada correctamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarEstadoRolAsync()
    {
        if (rolSeleccionado is null || rolSeleccionado.IdRol <= 0)
        {
            return;
        }

        var correcto = rolSeleccionado.EstadoRol == 1
            ? await AdministracionService.DesactivarEContaxRolAsync(rolSeleccionado.IdRol)
            : await AdministracionService.ReactivarEContaxRolAsync(rolSeleccionado.IdRol);

        if (correcto)
        {
            await CargarRolesAsync();
            var actualizado = roles.FirstOrDefault(item => item.IdRol == rolSeleccionado.IdRol);
            if (actualizado is not null)
            {
                await SeleccionarRolAsync(actualizado);
            }
            mensaje = "Estado del rol actualizado.";
        }
    }

    private async Task CargarRolesAsync()
    {
        roles.Clear();
        roles.AddRange((await AdministracionService.GetEContaxRolesAsync(includeInactivos: true))
            .OrderBy(item => item.NombreRol));
    }

    private IEnumerable<EContaxMenu> GetMenusHijos(int idPadre) => menus
        .Where(item => item.IdPadre == idPadre)
        .OrderBy(item => item.OrdenMenu ?? int.MaxValue)
        .ThenBy(item => item.NombreMenu);

    private static string ResolveIcono(string? icono) =>
        string.IsNullOrWhiteSpace(icono) ? "bi bi-folder" : icono;

    private static bool EsRolJefeEmpresa(string? nombre) =>
        string.Equals(nombre?.Trim(), "JEFE_EMPRESA", StringComparison.OrdinalIgnoreCase);
}
