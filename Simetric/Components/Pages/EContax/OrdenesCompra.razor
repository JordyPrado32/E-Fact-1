@page "/e-contax/compras/ordenes"
@page "/e-contax/compras/ordenes/nueva"
@using System.Net.Http.Json
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Simetric.DTOs
@using Simetric.DTOs.EContax
@using Simetric.Services
@using Simetric.Services.EContax
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ISimpleExcelExportService ExcelExportService
@rendermode InteractiveServer

<PageTitle>Órdenes de compra | E-Contax</PageTitle>
<link rel="stylesheet" href="/css/econtax-compras.css?v=20261023-compras-buttons" />

<div class="container-fluid purchase-orders-page purchase-flow-shell">
    <header class="purchase-hero">
        <div class="purchase-hero-copy">
            <div>
                <h1>Órdenes de compra</h1>
                <p>Gestiona tus órdenes de compra, consulta su estado y da seguimiento hasta la recepción.</p>
            </div>
        </div>
        <div class="purchase-hero-art" aria-hidden="true"><i class="ri-robot-2-line"></i><span><i class="ri-box-3-line"></i><i class="ri-checkbox-multiple-line"></i></span></div>
        <div class="purchase-hero-actions">
            <button class="purchase-secondary-btn" type="button" @onclick='() => NavManager.NavigateTo("/e-contax/proveedores")'>
                <i class="ri-truck-line"></i><span>Proveedores</span>
            </button>
            <button class="purchase-primary-btn" type="button" @onclick="AbrirNuevaAsync" disabled="@cargando">
                <i class="ri-add-line"></i><span>Nueva orden</span>
            </button>
        </div>
    </header>

    <section class="purchase-kpis" aria-label="Resumen de órdenes">
        <article class="purchase-kpi"><i class="ri-file-list-3-line"></i><div><span>Borradores</span><strong>@TotalBorradores</strong><small>Órdenes por completar</small></div><b style="--progress:@Porcentaje(TotalBorradores)%"></b></article>
        <article class="purchase-kpi purchase-kpi-warning"><i class="ri-time-line"></i><div><span>Por aprobar</span><strong>@TotalAprobadas</strong><small>Pendientes de revisión</small></div><b style="--progress:@Porcentaje(TotalAprobadas)%"></b></article>
        <article class="purchase-kpi purchase-kpi-info"><i class="ri-send-plane-line"></i><div><span>Enviadas</span><strong>@TotalEnviadas</strong><small>Esperando recepción</small></div><b style="--progress:@Porcentaje(TotalEnviadas)%"></b></article>
        <article class="purchase-kpi purchase-kpi-success"><i class="ri-box-3-line"></i><div><span>Recepcionadas</span><strong>@TotalRecepcionadas</strong><small>Completadas</small></div><b style="--progress:@Porcentaje(TotalRecepcionadas)%"></b></article>
        <article class="purchase-kpi purchase-kpi-total"><i class="ri-coins-line"></i><div><span>Valor total (filtrado)</span><strong>@TotalOrdenes.ToString("C2")</strong><small>@OrdenesVisibles.Count() orden(es)</small></div></article>
    </section>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="card shadow-sm mb-3 purchase-filter-card">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="filtro" @bind:event="oninput" placeholder="Número, proveedor o identificación" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="estadoFiltro">
                        <option value="">Todos</option>
                        <option value="BORRADOR">Borrador</option>
                        <option value="APROBADA">Aprobada</option>
                        <option value="ENVIADA">Enviada</option>
                        <option value="CERRADA">Cerrada</option>
                        <option value="CANCELADA">Cancelada</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Desde</label>
                    <input class="form-control" type="date" @bind="fechaDesde" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Hasta</label>
                    <input class="form-control" type="date" @bind="fechaHasta" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Ordenar por</label>
                    <select class="form-select" @bind="ordenListado" @bind:after="ReiniciarPaginacion">
                        <option value="fecha-desc">Más recientes</option>
                        <option value="fecha-asc">Más antiguas</option>
                        <option value="total-desc">Mayor total</option>
                        <option value="total-asc">Menor total</option>
                        <option value="estado">Estado</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-2">
                    <button class="purchase-secondary-btn purchase-filter-btn" type="button" @onclick="CargarAsync" disabled="@cargando">
                        <i class="ri-search-line"></i><span>Consultar</span>
                    </button>
                </div>
                <div class="col-md-3 col-lg-2">
                    <button class="purchase-primary-btn purchase-filter-btn" type="button" @onclick="ExportarExcelAsync" disabled="@(cargando || ordenes.Count == 0)"><i class="ri-file-excel-2-line"></i><span>Excel</span></button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm purchase-table-card">
        <div class="purchase-table-heading"><div><span>LISTADO ACTIVO</span><h2>Órdenes registradas</h2></div><span class="purchase-count">@ordenes.Count registro@(ordenes.Count == 1 ? string.Empty : "s")</span></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 purchase-data-table">
                <thead>
                    <tr>
                        <th>Orden</th>
                        <th>Proveedor</th>
                        <th>Emisión</th>
                        <th>Entrega estimada</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr><td colspan="7"><div class="purchase-table-state" aria-live="polite"><i class="ri-loader-4-line"></i><span>Cargando órdenes...</span></div></td></tr>
                    }
                    else if (!OrdenesVisibles.Any())
                    {
                        <tr><td colspan="7"><div class="purchase-table-state is-empty" aria-live="polite"><i class="ri-file-list-3-line"></i><span>No hay órdenes de compra para los filtros seleccionados.</span></div></td></tr>
                    }
                    else
                    {
                        @foreach (var orden in OrdenesPagina)
                        {
                            <tr @key="orden.IdOrdenCompra">
                                <td><strong>@orden.NumeroOrden</strong><small class="d-block text-muted">@orden.Lineas línea(s)</small></td>
                                <td>@orden.NombreProveedor<small class="d-block text-muted">@orden.RucProveedor</small></td>
                                <td>@orden.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td>@(orden.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td><span class="badge @ClaseEstado(orden.Estado)">@TextoEstado(orden.Estado)</span></td>
                                <td class="text-end">@orden.Total.ToString("C2")</td>
                                <td class="text-end text-nowrap"><div class="purchase-table-actions">
                                    <button class="purchase-table-btn is-primary" type="button" @onclick="() => EditarAsync(orden.IdOrdenCompra)"><i class="ri-eye-line"></i><span>Ver / editar</span></button>
                                    @if (orden.Estado == "BORRADOR")
                                    {
                                        <button class="purchase-table-btn is-success" type="button" @onclick='() => CambiarEstadoAsync(orden, "APROBADA")'><i class="ri-checkbox-circle-line"></i><span>Aprobar</span></button>
                                    }
                                    else if (orden.Estado == "APROBADA")
                                    {
                                        <button class="purchase-table-btn is-success" type="button" @onclick='() => CambiarEstadoAsync(orden, "ENVIADA")'><i class="ri-send-plane-line"></i><span>Enviar</span></button>
                                    }
                                    @if (orden.Estado is "APROBADA" or "ENVIADA")
                                    {
                                        <button class="purchase-table-btn is-neutral" type="button" @onclick='() => CambiarEstadoAsync(orden, "CERRADA")'><i class="ri-lock-line"></i><span>Cerrar</span></button>
                                    }
                                    @if (orden.Estado is "BORRADOR" or "APROBADA" or "ENVIADA")
                                    {
                                        <button class="purchase-table-btn is-danger" type="button" @onclick='() => CambiarEstadoAsync(orden, "CANCELADA")'><i class="ri-close-circle-line"></i><span>Cancelar</span></button>
                                    }
                                </div></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (!cargando && ordenes.Count > 0)
        {
            <div class="purchase-pagination" aria-label="Paginación de órdenes">
                <span>Mostrando @PrimerRegistroPagina–@UltimoRegistroPagina de @ordenes.Count</span>
                <div class="purchase-pagination-actions">
                    <button type="button" class="purchase-table-btn is-neutral" @onclick="() => CambiarPagina(-1)" disabled="@(PaginaActualSegura == 1)"><i class="ri-arrow-left-s-line"></i><span>Anterior</span></button>
                    <strong>Página @PaginaActualSegura de @TotalPaginas</strong>
                    <button type="button" class="purchase-table-btn is-neutral" @onclick="() => CambiarPagina(1)" disabled="@(PaginaActualSegura == TotalPaginas)"><span>Siguiente</span><i class="ri-arrow-right-s-line"></i></button>
                </div>
            </div>
        }
    </div>
</div>

@if (mostrarEditor)
{
    <div class="purchase-modal-backdrop" @onclick="CerrarEditorAsync">
        <section class="purchase-modal" role="dialog" aria-modal="true" aria-labelledby="orden-compra-modal-title" @onclick:stopPropagation="true">
            <header class="purchase-modal-header">
                <div class="purchase-modal-brand">
                    <div class="purchase-document-icon"><i class="ri-file-list-3-line"></i></div>
                    <div>
                        <span class="purchase-eyebrow">DOCUMENTO DE ABASTECIMIENTO</span>
                        <h2 id="orden-compra-modal-title">@(editor.Id == 0 ? "Nueva orden de compra" : editor.NumeroOrden)</h2>
                        <p>Define el proveedor, las condiciones y el detalle de la compra.</p>
                        <div class="purchase-document-meta">
                            <span><i class="ri-calendar-2-line"></i>Emisión: @editor.FechaEmision.ToString("dd/MM/yyyy")</span>
                            <span><i class="ri-file-edit-line"></i>@(editor.Id == 0 ? "Documento nuevo" : "Documento existente")</span>
                        </div>
                    </div>
                    @if (TieneCambiosSinGuardar)
                    {
                        <span class="purchase-dirty-indicator"><i class="ri-save-3-line"></i>Cambios sin guardar</span>
                    }
                </div>
                <div class="purchase-modal-header-actions">
                    <span class="purchase-document-status"><i class="ri-draft-line"></i>BORRADOR</span>
                    <button type="button" class="purchase-modal-close" aria-label="Cerrar" @onclick="CerrarEditorAsync"><i class="ri-close-line"></i></button>
                </div>
            </header>

            <div class="purchase-modal-body p-4 overflow-auto">
                <div class="purchase-editor-card mb-3">
                    <div class="purchase-section-heading"><div><span>DATOS DEL DOCUMENTO</span><h3>Información de la orden</h3></div><i class="ri-file-list-3-line"></i></div>
                    <div class="row g-3 p-3">
                    <div class="col-md-6">
                        <label class="form-label">Proveedor <span class="text-danger">*</span></label>
                        <select class="form-select @(MostrarErrorProveedor ? "is-invalid" : string.Empty)" @bind="editor.IdProveedor" @bind:after="ProveedorSeleccionadoAsync" required disabled="@guardando">
                            <option value="0">Seleccione un proveedor</option>
                            @foreach (var proveedor in proveedores)
                            {
                                <option value="@proveedor.IdProveedor">@proveedor.Nombre · @proveedor.Identificacion</option>
                            }
                        </select>
                        @if (MostrarErrorProveedor)
                        {
                            <small class="purchase-field-error">Selecciona un proveedor.</small>
                        }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Entrega estimada</label>
                        <input class="form-control" type="date" @bind="editor.FechaEntregaEstimada" disabled="@guardando" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Forma de pago</label>
                        <input class="form-control" @bind="editor.FormaPago" maxlength="100" disabled="@guardando" placeholder="Transferencia" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Plazo (días)</label>
                        <input class="form-control" type="number" min="0" @bind="editor.PlazoPago" disabled="@guardando" />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">Observación</label>
                        <input class="form-control" @bind="editor.Observacion" maxlength="1000" disabled="@guardando" />
                    </div>
                </div>
                </div>

                <div class="purchase-editor-card mb-3">
                    <div class="purchase-section-heading"><div><span>DETALLE DE LA COMPRA</span><h3>Productos y servicios</h3></div><span class="purchase-count">@editor.Detalles.Count línea(s)</span></div>
                    <div class="p-3">
                            <p class="purchase-helper-text">Selecciona primero el proveedor para consultar sus productos y precios de compra.</p>
                    </div>
                    <div class="input-group mb-3">
                        <input class="form-control" @bind="filtroProducto" placeholder="Código o descripción" @onkeydown="BuscarProductoAlPresionarEnter" disabled="@guardando" />
                        <button class="purchase-secondary-btn purchase-search-btn" type="button" @onclick="BuscarProductosAsync" disabled="@guardando">Buscar</button>
                    </div>
                    @if (productosBusqueda.Count > 0)
                    {
                        <div class="list-group mb-3">
                            @foreach (var producto in productosBusqueda)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between" @onclick="() => AgregarProducto(producto)">
                                    <span><strong>@producto.Codproducto</strong> · @(producto.Descripcion ?? "Sin descripción")</span>
                                    <span>@PrecioProducto(producto).ToString("C2")</span>
                                </button>
                            }
                        </div>
                    }

                    @if (editor.Detalles.Count == 0)
                    {
                        <p class="text-muted mb-0">Agrega al menos un producto.</p>
                        @if (MostrarErrorDetalle)
                        {
                            <small class="purchase-field-error">Agrega al menos un producto para guardar la orden.</small>
                        }
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 purchase-lines-table">
                                <thead><tr><th>Producto <span class="text-danger">*</span></th><th style="width: 110px">Cantidad <span class="text-danger">*</span></th><th style="width: 140px">Precio <span class="text-danger">*</span></th><th style="width: 130px">Descuento</th><th class="text-end">Total</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var linea in editor.Detalles)
                                    {
                                        <tr @key="linea">
                                            <td>@linea.Descripcion<small class="d-block text-muted">@linea.CodigoPrincipal</small></td>
                                            <td><input class="form-control form-control-sm @(MostrarErrorCantidad(linea) ? "is-invalid" : string.Empty)" type="number" min="0.0001" step="0.0001" @bind="linea.Cantidad" @bind:event="oninput" @onchange="RecalcularEditor" />@if (MostrarErrorCantidad(linea)) { <small class="purchase-field-error">Debe ser mayor que cero.</small> }</td>
                                            <td><input class="form-control form-control-sm @(MostrarErrorPrecio(linea) ? "is-invalid" : string.Empty)" type="number" min="0" step="0.0001" @bind="linea.PrecioUnitario" @bind:event="oninput" @onchange="RecalcularEditor" />@if (MostrarErrorPrecio(linea)) { <small class="purchase-field-error">No puede ser negativo.</small> }</td>
                                            <td><input class="form-control form-control-sm @(MostrarErrorDescuento(linea) ? "is-invalid" : string.Empty)" type="number" min="0" step="0.01" @bind="linea.Descuento" @bind:event="oninput" @onchange="RecalcularEditor" />@if (MostrarErrorDescuento(linea)) { <small class="purchase-field-error">Supera el subtotal.</small> }</td>
                                            <td class="text-end">@linea.Total.ToString("C2")</td>
                                            <td><button type="button" class="purchase-table-btn is-danger" @onclick="() => QuitarDetalle(linea)">Quitar</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    </div>

                <div class="purchase-total-summary">
                    <div class="purchase-total-copy">
                        <span>RESUMEN DE LA ORDEN</span>
                        <strong>Total de compra</strong>
                        <small>Valores calculados a partir del detalle ingresado.</small>
                    </div>
                    <div class="purchase-total-values">
                        <div><span>Subtotal</span><strong>@SubtotalEditor.ToString("C2")</strong></div>
                        <div><span>IVA</span><strong>@IvaEditor.ToString("C2")</strong></div>
                        <div class="is-total"><span>Total</span><strong>@TotalEditor.ToString("C2")</strong></div>
                    </div>
                </div>
            </div>

            <footer class="purchase-modal-footer">
                <span><i class="ri-information-line"></i>Documento interno; se guardará inicialmente como borrador.</span>
                <div>
                    @if (editor.Id > 0)
                    {
                        <button type="button" class="purchase-secondary-btn" @onclick="ImprimirAsync" disabled="@guardando"><i class="ri-printer-line"></i> Imprimir / PDF</button>
                    }
                    <button type="button" class="purchase-secondary-btn" @onclick="CerrarEditorAsync" disabled="@guardando">Cerrar</button><button type="button" class="purchase-primary-btn" @onclick="GuardarAsync" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar borrador")</button>
                </div>
            </footer>
        </section>
    </div>
}

@code {
    private const string ApiUrl = "api/e-contax/compras/ordenes";
    private readonly List<EContaxOrdenCompraListaDto> ordenes = new();
    private readonly List<EContaxProveedorLookupDto> proveedores = new();
    private readonly List<ProductoLookupDetalleDto> productosBusqueda = new();
    private string filtro = string.Empty;
    private string estadoFiltro = string.Empty;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string filtroProducto = string.Empty;
    private string? error;
    private bool cargando;
    private bool guardando;
    private bool mostrarEditor;
    private bool mostrarErrores;
    private int usuarioId;
    private EditorModel editor = new();
    private string? editorSnapshot;
    private string ordenListado = "fecha-desc";
    private int paginaActual = 1;
    private const int RegistrosPorPagina = 10;

    private int TotalBorradores => ordenes.Count(x => x.Estado == "BORRADOR");
    private int TotalAprobadas => ordenes.Count(x => x.Estado == "APROBADA");
    private int TotalEnviadas => ordenes.Count(x => x.Estado == "ENVIADA");
    private int TotalRecepcionadas => ordenes.Count(x => x.Estado is "RECEPCIONADA" or "RECIBIDA");
    private int TotalCanceladas => ordenes.Count(x => x.Estado == "CANCELADA");
    private decimal TotalOrdenes => OrdenesVisibles.Sum(x => x.Total);
    private IEnumerable<EContaxOrdenCompraListaDto> OrdenesVisibles => ordenes.Where(x =>
        (string.IsNullOrWhiteSpace(estadoFiltro) ||
         x.Estado == estadoFiltro ||
         (estadoFiltro == "RECEPCIONADA" && x.Estado == "RECIBIDA")) &&
        (!fechaDesde.HasValue || x.FechaEmision.Date >= fechaDesde.Value.Date) &&
        (!fechaHasta.HasValue || x.FechaEmision.Date <= fechaHasta.Value.Date));
    private IEnumerable<EstadoResumen> EstadosResumen =>
    [
        new("BORRADOR", "Borradores", TotalBorradores, "is-draft"),
        new("APROBADA", "Por aprobar", TotalAprobadas, "is-warning"),
        new("ENVIADA", "Enviadas", TotalEnviadas, "is-sent"),
        new("RECEPCIONADA", "Recepcionadas", TotalRecepcionadas, "is-received")
    ];
    private decimal SubtotalEditor => editor.Detalles.Sum(x => x.Subtotal);
    private decimal IvaEditor => editor.Detalles.Sum(x => x.Iva);
    private decimal TotalEditor => SubtotalEditor + IvaEditor;
    private IEnumerable<EContaxOrdenCompraListaDto> OrdenesOrdenadas => ordenListado switch
    {
        "fecha-asc" => ordenes.OrderBy(x => x.FechaEmision).ThenBy(x => x.NumeroOrden),
        "total-desc" => ordenes.OrderByDescending(x => x.Total).ThenByDescending(x => x.FechaEmision),
        "total-asc" => ordenes.OrderBy(x => x.Total).ThenByDescending(x => x.FechaEmision),
        "estado" => ordenes.OrderBy(x => x.Estado).ThenByDescending(x => x.FechaEmision),
        _ => ordenes.OrderByDescending(x => x.FechaEmision).ThenByDescending(x => x.IdOrdenCompra)
    };
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(ordenes.Count / (double)RegistrosPorPagina));
    private int PaginaActualSegura => Math.Min(paginaActual, TotalPaginas);
    private IEnumerable<EContaxOrdenCompraListaDto> OrdenesPagina => OrdenesOrdenadas.Skip((PaginaActualSegura - 1) * RegistrosPorPagina).Take(RegistrosPorPagina);
    private int PrimerRegistroPagina => ordenes.Count == 0 ? 0 : ((PaginaActualSegura - 1) * RegistrosPorPagina) + 1;
    private int UltimoRegistroPagina => Math.Min(PaginaActualSegura * RegistrosPorPagina, ordenes.Count);
    private bool TieneCambiosSinGuardar => mostrarEditor && editorSnapshot is not null && editorSnapshot != JsonSerializer.Serialize(editor);
    private bool MostrarErrorProveedor => mostrarErrores && editor.IdProveedor <= 0;
    private bool MostrarErrorDetalle => mostrarErrores && editor.Detalles.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst("IdUsuario")?.Value ?? state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(claim, out usuarioId);
        await CargarAsync();

        if (NavManager.Uri.TrimEnd('/').EndsWith("/nueva", StringComparison.OrdinalIgnoreCase))
            await AbrirNuevaAsync();
    }

    private async Task CargarAsync()
    {
        if (usuarioId <= 0)
        {
            error = "No se pudo identificar la sesión actual.";
            return;
        }

        cargando = true;
        error = null;
        paginaActual = 1;
        ordenes.Clear();
        try
        {
            var url = $"{ApiUrl}?userId={usuarioId}&search={Uri.EscapeDataString(filtro)}&estado={Uri.EscapeDataString(estadoFiltro)}" +
                $"&fechaDesde={Uri.EscapeDataString(fechaDesde?.ToString("yyyy-MM-dd") ?? string.Empty)}&fechaHasta={Uri.EscapeDataString(fechaHasta?.ToString("yyyy-MM-dd") ?? string.Empty)}";
            var resultado = await Http.GetFromJsonAsync<List<EContaxOrdenCompraListaDto>>(url) ?? new();
            ordenes.Clear();
            ordenes.AddRange(resultado);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ExportarExcelAsync()
    {
        await CargarAsync();
        if (ordenes.Count == 0)
            return;

        var resumen = (IReadOnlyList<IReadOnlyList<string>>)[
            ["Filtro de texto", string.IsNullOrWhiteSpace(filtro) ? "Todos" : filtro],
            ["Estado", string.IsNullOrWhiteSpace(estadoFiltro) ? "Todos" : TextoEstado(estadoFiltro)],
            ["Fecha desde", fechaDesde?.ToString("dd/MM/yyyy") ?? "Todas"],
            ["Fecha hasta", fechaHasta?.ToString("dd/MM/yyyy") ?? "Todas"],
            ["Registros", ordenes.Count.ToString("N0")],
            ["Borradores", TotalBorradores.ToString("N0")],
            ["Aprobadas", TotalAprobadas.ToString("N0")],
            ["Enviadas", TotalEnviadas.ToString("N0")],
            ["Total filtrado", TotalOrdenes.ToString("N2")]
        ];
        var rows = ordenes.Select(x => (IReadOnlyList<string>)[
            x.NumeroOrden,
            x.NombreProveedor,
            x.RucProveedor,
            x.FechaEmision.ToString("dd/MM/yyyy"),
            x.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? string.Empty,
            TextoEstado(x.Estado),
            x.Total.ToString("N2"),
            x.Lineas.ToString()
        ]).ToList();
        var archivo = ExcelExportService.Create(
            $"ordenes_compra_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
            new ExcelSheetData("Resumen", ["Indicador", "Valor"], resumen),
            new ExcelSheetData("Órdenes", ["Orden", "Proveedor", "Identificación", "Emisión", "Entrega estimada", "Estado", "Total", "Líneas"], rows));
        await using var stream = new MemoryStream(archivo.Content);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", archivo.FileName, streamRef);
    }

    private async Task AbrirNuevaAsync()
    {
        error = null;
        editor = new EditorModel { FechaEmision = DateTime.Today, FechaEntregaEstimada = DateTime.Today.AddDays(7) };
        mostrarErrores = false;
        try
        {
            await CargarProveedoresAsync();
            editorSnapshot = JsonSerializer.Serialize(editor);
            mostrarEditor = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task EditarAsync(int id)
    {
        error = null;
        try
        {
            await CargarProveedoresAsync();
            var detalle = await Http.GetFromJsonAsync<EContaxOrdenCompraDto>($"{ApiUrl}/{id}?userId={usuarioId}");
            if (detalle is null)
                return;

            editor = EditorModel.From(detalle);
            mostrarErrores = false;
            editorSnapshot = JsonSerializer.Serialize(editor);
            mostrarEditor = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task CargarProveedoresAsync()
    {
        try
        {
            var resultado = await Http.GetFromJsonAsync<List<EContaxProveedorLookupDto>>($"{ApiUrl}/proveedores?userId={usuarioId}") ?? new();
            proveedores.Clear();
            proveedores.AddRange(resultado);
            if (proveedores.Count == 0)
                throw new InvalidOperationException("No hay proveedores activos disponibles para la empresa.");
        }
        catch (Exception ex)
        {
            error = ex.Message;
            throw;
        }
    }

    private async Task BuscarProductosAsync()
    {
        try
        {
            var proveedorQuery = editor.IdProveedor > 0 ? $"&idProveedor={editor.IdProveedor}" : string.Empty;
            var resultado = await Http.GetFromJsonAsync<List<ProductoLookupDetalleDto>>($"{ApiUrl}/productos?userId={usuarioId}&search={Uri.EscapeDataString(filtroProducto)}{proveedorQuery}") ?? new();
            productosBusqueda.Clear();
            productosBusqueda.AddRange(resultado);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private Task BuscarProductoAlPresionarEnter(KeyboardEventArgs args) =>
        args.Key == "Enter" ? BuscarProductosAsync() : Task.CompletedTask;

    private async Task ProveedorSeleccionadoAsync()
    {
        productosBusqueda.Clear();
        filtroProducto = string.Empty;
        if (editor.IdProveedor > 0)
            await BuscarProductosAsync();
    }

    private void AgregarProducto(ProductoLookupDetalleDto producto)
    {
        if (editor.Detalles.Any(x => x.CodigoProducto == producto.Codproducto))
            return;

        editor.Detalles.Add(new EditorDetail
        {
            CodigoProducto = producto.Codproducto,
            CodigoPrincipal = producto.Codprincipal,
            Descripcion = producto.Descripcion ?? string.Empty,
            Cantidad = 1,
            PrecioUnitario = PrecioProducto(producto),
            TarifaIva = producto.TarifaIva
        });
        RecalcularEditor();
        productosBusqueda.Clear();
        filtroProducto = string.Empty;
    }

    private void QuitarDetalle(EditorDetail detalle)
    {
        editor.Detalles.Remove(detalle);
        RecalcularEditor();
    }

    private void RecalcularEditor()
    {
        foreach (var detalle in editor.Detalles)
        {
            var bruto = Math.Round(detalle.Cantidad * detalle.PrecioUnitario, 2, MidpointRounding.AwayFromZero);
            detalle.Subtotal = Math.Round(Math.Max(0, bruto - detalle.Descuento), 2, MidpointRounding.AwayFromZero);
            detalle.Iva = Math.Round(detalle.Subtotal * detalle.TarifaIva / 100m, 2, MidpointRounding.AwayFromZero);
            detalle.Total = detalle.Subtotal + detalle.Iva;
        }
    }

    private async Task GuardarAsync()
    {
        mostrarErrores = true;
        if (editor.IdProveedor <= 0 || editor.Detalles.Count == 0)
        {
            error = "Selecciona un proveedor y agrega al menos un producto.";
            return;
        }
        if (editor.Detalles.Any(x => x.Cantidad <= 0 || x.PrecioUnitario < 0 || x.Descuento < 0 || x.Descuento > x.Cantidad * x.PrecioUnitario))
        {
            error = "Revisa las cantidades, precios y descuentos de las líneas antes de guardar.";
            return;
        }

        guardando = true;
        error = null;
        try
        {
            var dto = new EContaxOrdenCompraUpsertDto
            {
                IdProveedor = editor.IdProveedor,
                FechaEntregaEstimada = editor.FechaEntregaEstimada,
                FormaPago = editor.FormaPago,
                PlazoPago = editor.PlazoPago,
                Observacion = editor.Observacion,
                Detalles = editor.Detalles.Select(x => new EContaxOrdenCompraDetalleUpsertDto
                {
                    CodigoProducto = x.CodigoProducto,
                    Cantidad = x.Cantidad,
                    PrecioUnitario = x.PrecioUnitario,
                    Descuento = x.Descuento
                }).ToList()
            };
            var response = editor.Id == 0
                ? await Http.PostAsJsonAsync($"{ApiUrl}?userId={usuarioId}", dto)
                : await Http.PutAsJsonAsync($"{ApiUrl}/{editor.Id}?userId={usuarioId}", dto);
            response.EnsureSuccessStatusCode();
            mostrarEditor = false;
            editorSnapshot = null;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarEstadoAsync(EContaxOrdenCompraListaDto orden, string estado)
    {
        var accion = estado switch
        {
            "APROBADA" => "aprobar",
            "ENVIADA" => "marcar como enviada",
            "CERRADA" => "cerrar",
            "CANCELADA" => "cancelar",
            _ => "cambiar el estado de"
        };
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Deseas {accion} la orden {orden.NumeroOrden}?"))
            return;

        try
        {
            var response = await Http.PutAsJsonAsync($"{ApiUrl}/{orden.IdOrdenCompra}/estado?userId={usuarioId}", new EContaxOrdenCompraEstadoDto { Estado = estado });
            response.EnsureSuccessStatusCode();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void ReiniciarPaginacion() => paginaActual = 1;
    private void CambiarPagina(int delta) => paginaActual = Math.Clamp(PaginaActualSegura + delta, 1, TotalPaginas);

    private async Task CerrarEditorAsync()
    {
        if (guardando)
            return;
        if (TieneCambiosSinGuardar && !await JS.InvokeAsync<bool>("confirm", "Hay cambios sin guardar. ¿Deseas cerrar y descartarlos?"))
            return;
        mostrarEditor = false;
        editorSnapshot = null;
        mostrarErrores = false;
    }

    private bool MostrarErrorCantidad(EditorDetail linea) => mostrarErrores && linea.Cantidad <= 0;
    private bool MostrarErrorPrecio(EditorDetail linea) => mostrarErrores && linea.PrecioUnitario < 0;
    private bool MostrarErrorDescuento(EditorDetail linea) => mostrarErrores && (linea.Descuento < 0 || linea.Descuento > linea.Cantidad * linea.PrecioUnitario);
    private Task ImprimirAsync() => JS.InvokeVoidAsync("print").AsTask();

    private static decimal PrecioProducto(ProductoLookupDetalleDto producto) => producto.Costo > 0 ? producto.Costo : producto.PrecioUnitario;

    private static string TextoEstado(string estado) => estado switch
    {
        "BORRADOR" => "Borrador",
        "APROBADA" => "Aprobada",
        "ENVIADA" => "Enviada",
        "CERRADA" => "Cerrada",
        "CANCELADA" => "Cancelada",
        _ => estado
    };

    private static string ClaseEstado(string estado) => estado switch
    {
        "APROBADA" => "text-bg-success",
        "ENVIADA" => "text-bg-primary",
        "CERRADA" => "text-bg-dark",
        "CANCELADA" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private sealed record EstadoResumen(string Valor, string Texto, int Total, string Clase);

    private sealed class EditorModel
    {
        public int Id { get; set; }
        public string NumeroOrden { get; set; } = string.Empty;
        public int IdProveedor { get; set; }
        public DateTime FechaEmision { get; set; }
        public DateTime? FechaEntregaEstimada { get; set; }
        public string? FormaPago { get; set; }
        public int? PlazoPago { get; set; }
        public string? Observacion { get; set; }
        public List<EditorDetail> Detalles { get; set; } = new();

        public static EditorModel From(EContaxOrdenCompraDto dto) => new()
        {
            Id = dto.IdOrdenCompra,
            NumeroOrden = dto.NumeroOrden,
            IdProveedor = dto.IdProveedor,
            FechaEmision = dto.FechaEmision,
            FechaEntregaEstimada = dto.FechaEntregaEstimada,
            FormaPago = dto.FormaPago,
            PlazoPago = dto.PlazoPago,
            Observacion = dto.Observacion,
            Detalles = dto.Detalles.Select(x => new EditorDetail
            {
                CodigoProducto = x.CodigoProducto,
                CodigoPrincipal = x.CodigoPrincipal,
                Descripcion = x.Descripcion,
                Cantidad = x.Cantidad,
                PrecioUnitario = x.PrecioUnitario,
                Descuento = x.Descuento,
                TarifaIva = x.TarifaIva,
                Subtotal = x.Subtotal,
                Iva = x.Iva,
                Total = x.Total
            }).ToList()
        };
    }

    private sealed class EditorDetail
    {
        public int CodigoProducto { get; set; }
        public string? CodigoPrincipal { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public decimal Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Descuento { get; set; }
        public int TarifaIva { get; set; }
        public decimal Subtotal { get; set; }
        public decimal Iva { get; set; }
        public decimal Total { get; set; }
    }
}

