@page "/e-contax"
@page "/e-contax/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@using Simetric.Services.EContax
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState

<PageTitle>Inicio | E-Contax</PageTitle>

@if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="econtax-page">
        <section class="econtax-state econtax-state-error">
            <i class="bi bi-exclamation-octagon"></i>
            <h3>No pudimos abrir E-Contax</h3>
            <p>@errorCarga</p>
            <button type="button" class="primary-btn" @onclick="VolverServicios">
                <i class="bi bi-grid"></i>
                <span>Volver a servicios</span>
            </button>
        </section>
    </div>
}
else
{
    <div class="econtax-page" data-tour="econtax.dashboard">
        <section class="econtax-spotlight">
            <div class="section-head">
                <div>
                    <span class="section-kicker">Centro de operaciones</span>
                    <h3>Gestiona tu empresa desde E-Contax</h3>
                </div>
                <span class="section-chip">E-CONTAX</span>
            </div>
            <p class="summary-spotlight-copy">Accede a facturacion, catalogos y configuracion manteniendo la informacion separada por empresa y sucursal.</p>
            <div class="spotlight-grid">
                <button class="spotlight-card spotlight-action" @onclick="() => Ir(EContaxRoutes.FacturacionNueva)">
                    <span class="spotlight-label">Facturacion</span><strong><i class="ri-file-add-line"></i></strong><small>Genera una nueva factura electronica.</small>
                </button>
                <button class="spotlight-card spotlight-action" @onclick="() => Ir(EContaxRoutes.FacturacionDocumentos)">
                    <span class="spotlight-label">Documentos</span><strong><i class="ri-file-list-3-line"></i></strong><small>Consulta las facturas emitidas y su estado.</small>
                </button>
                <button class="spotlight-card spotlight-action" @onclick="() => Ir(EContaxRoutes.Clientes)">
                    <span class="spotlight-label">Catalogo</span><strong><i class="ri-group-line"></i></strong><small>Administra clientes y proveedores.</small>
                </button>
            </div>
        </section>

        <section class="econtax-grid">
            <article class="econtax-panel">
                <div class="panel-head"><div><span class="panel-kicker">Catalogos</span><h3>Datos comerciales</h3></div></div>
                <div class="compact-list">
                    <button class="compact-row compact-row-action" @onclick="() => Ir(EContaxRoutes.Productos)"><span><strong>Productos y servicios</strong><span>Precios, impuestos y existencias.</span></span><i class="ri-arrow-right-s-line"></i></button>
                    <button class="compact-row compact-row-action" @onclick="() => Ir(EContaxRoutes.ConfiguracionCategorias)"><span><strong>Categorias</strong><span>Clasificacion del catalogo.</span></span><i class="ri-arrow-right-s-line"></i></button>
                </div>
            </article>
            <article class="econtax-panel">
                <div class="panel-head"><div><span class="panel-kicker">Empresa</span><h3>Configuracion</h3></div></div>
                <div class="compact-list">
                    <button class="compact-row compact-row-action" @onclick="() => Ir(EContaxRoutes.Emisor)"><span><strong>Emisor</strong><span>Datos fiscales y certificado.</span></span><i class="ri-arrow-right-s-line"></i></button>
                    <button class="compact-row compact-row-action" @onclick="() => Ir(EContaxRoutes.Organizacion)"><span><strong>Organizacion</strong><span>Empresa, sucursales y asignaciones.</span></span><i class="ri-arrow-right-s-line"></i></button>
                </div>
            </article>
            <article class="econtax-panel">
                <div class="panel-head"><div><span class="panel-kicker">Control</span><h3>Administracion</h3></div></div>
                <div class="compact-list">
                    <button class="compact-row compact-row-action" @onclick="() => Ir(EContaxRoutes.AdministracionRoles)"><span><strong>Roles y permisos</strong><span>Control de acceso por perfil.</span></span><i class="ri-arrow-right-s-line"></i></button>
                    <button class="compact-row compact-row-action" @onclick="() => Ir(EContaxRoutes.Profile)"><span><strong>Mi perfil</strong><span>Datos personales y seguridad.</span></span><i class="ri-arrow-right-s-line"></i></button>
                </div>
            </article>
        </section>
    </div>
}

@code {
    private string? errorCarga;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                NavManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out var userId) || userId <= 0)
            {
                NavManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            var isSuperAdmin = string.Equals(
                user.FindFirst("IdTipoUsuario")?.Value,
                AppAccessService.AdminRoleId,
                StringComparison.OrdinalIgnoreCase);

            var access = await AppAccessService.CanAccessAsync(userId, EContaxRoutes.ServiceKey, isSuperAdmin);
            if (!access.HasAccess)
            {
                NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(EContaxRoutes.ServiceKey)}", forceLoad: true);
                return;
            }

            await SelectedAppServiceState.SetCurrentServiceKeyAsync(EContaxRoutes.ServiceKey);
        }
        catch (Exception ex)
        {
            errorCarga = $"No fue posible cargar los datos de E-Contax: {ex.Message}";
        }
    }

    private void VolverServicios() => NavManager.NavigateTo("/portal-servicios", forceLoad: true);
    private void Ir(string ruta) => NavManager.NavigateTo(ruta);
}
