@page "/e-contax/afiliacion"
@using Simetric.Services.EContax
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Afiliación | E-Contax</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <span class="text-uppercase small text-primary fw-bold">Cuenta y empresa</span>
        <h2>Afiliación</h2>
        <p class="text-muted mb-0">Consulta tu vínculo actual con la empresa de E-Contax.</p>
    </div>

    @if (cargando)
    {
        <section class="card shadow-sm p-4"><p class="mb-0">Cargando afiliación…</p></section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="card shadow-sm p-4"><div class="alert alert-danger mb-0">@error</div></section>
    }
    else if (resumen is not null)
    {
        <section class="card shadow-sm p-4">
            <span class="text-uppercase small text-primary fw-bold">Vínculo activo</span>
            <h3>@resumen.Empresa.Nombre</h3>
            <div class="row g-3 mb-4">
                <div class="col-md-4"><span class="d-block text-muted small">Empresa</span><strong>@resumen.Empresa.Nombre</strong></div>
                <div class="col-md-4"><span class="d-block text-muted small">Sucursal</span><strong>@SucursalActual</strong></div>
                <div class="col-md-4"><span class="d-block text-muted small">Rol</span><strong>@resumen.Contexto.Rol</strong></div>
            </div>

            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle"></i>
                <span>
                    Tus datos personales, contraseña y servicios de tu cuenta principal permanecen en E-Fact.
                    Al dejar la empresa solo se elimina esta afiliación a E-Contax.
                </span>
            </div>

            @if (resumen.Contexto.EsJefeEmpresa)
            {
                <div class="alert alert-warning">
                    Debes transferir primero la titularidad desde <a href="@EContaxRoutes.Usuarios">Usuarios</a> antes de dejar la empresa.
                </div>
            }
            else
            {
                <label class="d-block mb-3">
                    <input type="checkbox" @bind="confirmarAbandono" />
                    Confirmo que deseo dejar esta empresa.
                </label>
                <button type="button" class="btn btn-danger" disabled="@(ocupado || !confirmarAbandono)" @onclick="AbandonarAsync">
                    @(ocupado ? "Procesando…" : "Dejar empresa")
                </button>
            }

            @if (resumen.EsAdmin)
            {
                <hr class="my-4" />
                <h4>Usuarios afiliados</h4>
                <p class="text-muted">Puedes retirar el acceso a la empresa sin borrar la cuenta de E-Fact del usuario.</p>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr><th>Usuario</th><th>Correo</th><th>Rol</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in resumen.Usuarios.OrderBy(x => x.Usuario?.NombreCompleto))
                            {
                                var puedeDesvincular = PuedeDesvincular(usuario);
                                <tr @key="usuario.IdUsuario">
                                    <td>@(usuario.Usuario?.NombreCompleto ?? "Usuario")</td>
                                    <td>@usuario.Usuario?.Email</td>
                                    <td>@RolUsuario(usuario)</td>
                                    <td class="text-end">
                                        @if (puedeDesvincular)
                                        {
                                            @if (usuarioConfirmarDesvinculacion == usuario.IdUsuario)
                                            {
                                                <button type="button" class="btn btn-danger btn-sm me-2" disabled="@ocupado" @onclick="() => DesvincularUsuarioAsync(usuario.IdUsuario)">Confirmar</button>
                                                <button type="button" class="btn btn-light btn-sm" disabled="@ocupado" @onclick="CancelarDesvinculacion">Cancelar</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@ocupado" @onclick="() => SolicitarDesvinculacion(usuario.IdUsuario)">Desafiliar</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>
