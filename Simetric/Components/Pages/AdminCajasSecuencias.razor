@page "/administracion/cajas-secuencias"
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject AdminCajaSecuenciaService AdminService
@inject IJSRuntime JS

<PageTitle>Cajas y secuencias | Numerica e-fact</PageTitle>

<div class="sequence-shell">
    <section class="sequence-hero">
        <div>
            <span class="section-kicker">Administración</span>
            <h2>Cajas y secuencias</h2>
            <p>Consulta puntos de emisión y últimos secuenciales de todos los clientes.</p>
        </div>
        <div class="hero-summary">
            <span>Cajas visibles</span>
            <strong>@CajasFiltradas.Count</strong>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="status-banner @(mensajeEsError ? "is-error" : "is-success")">@mensaje</div>
    }

    @if (cargando)
    {
        <section class="table-card state-card">
            <span class="spinner-border text-primary" role="status"></span>
            <strong>Cargando cajas y secuencias</strong>
        </section>
    }
    else if (!tienePermiso)
    {
        <section class="table-card state-card">
            <i class="ri-lock-2-line"></i>
            <strong>Acceso restringido</strong>
            <span>Su rol no tiene permiso para administrar cajas y secuencias.</span>
        </section>
    }
    else
    {
        <section class="toolbar-card">
            <div>
                <span class="section-kicker">Filtros</span>
                <h3>Localizar una caja</h3>
            </div>
            <div class="toolbar-actions">
                <label class="search-field">
                    <i class="ri-search-line"></i>
                    <input @bind="Filtro"
                           @bind:event="oninput"
                           placeholder="Cliente, correo, RUC, empresa, serie o SEC" />
                </label>
                <button type="button" class="secondary-btn" @onclick="Cargar" disabled="@guardando">
                    <i class="ri-refresh-line"></i>
                    Refrescar
                </button>
            </div>
        </section>

        <section class="table-card">
            <div class="table-card-head">
                <div>
                    <span class="section-kicker">Listado general</span>
                    <h3>Cajas y puntos de emisión registrados</h3>
                </div>
                <span class="table-badge">@CajasFiltradas.Count registros</span>
            </div>

            @if (CajasFiltradas.Count == 0)
            {
                <div class="state-card">
                    <i class="ri-inbox-2-line"></i>
                    <strong>No se encontraron cajas</strong>
                    <span>Pruebe con otro criterio de búsqueda.</span>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table entity-table mb-0">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Caja</th>
                                <th>Serie</th>
                                <th>Últimos secuenciales</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var caja in CajasPaginadas)
                            {
                                <tr>
                                    <td>
                                        <div class="cell-main">
                                            <strong>@NombreCliente(caja)</strong>
                                            <span><i class="ri-mail-line"></i> @(string.IsNullOrWhiteSpace(caja.Email) ? "Sin correo" : caja.Email)</span>
                                            <span><i class="ri-fingerprint-line"></i> RUC @(string.IsNullOrWhiteSpace(caja.Ruc) ? "no registrado" : caja.Ruc)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cell-main compact">
                                            <strong>Caja @caja.NumeroCaja</strong>
                                            <span>SEC @caja.CajaSec</span>
                                            <span>Usuario @caja.IdUsuario</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="series-pill">@caja.Serie</span>
                                    </td>
                                    <td>
                                        <div class="sequence-grid">
                                            @foreach (var item in caja.Secuencias)
                                            {
                                                <span title="@item.DocumentLabel">
                                                    <small>@AbreviarDocumento(item.DocumentKey)</small>
                                                    <strong>@item.LastSequence.ToString("D9")</strong>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="status-stack">
                                            <span class="status-pill @(caja.Activa ? "is-active" : "is-inactive")">
                                                @(caja.Activa ? "Activa" : "Inactiva")
                                            </span>
                                            @if (caja.EsCajaSistema)
                                            {
                                                <small class="system-label">Caja del sistema</small>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="action-btn"
                                                title="Editar caja y secuencias"
                                                @onclick="() => AbrirEditar(caja)">
                                            <i class="ri-pencil-line"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-pagination">
                    <span>Mostrando @PrimerRegistro-@UltimoRegistro de @CajasFiltradas.Count registros</span>
                    <div class="pagination-actions">
                        <button type="button"
                                class="pagination-btn"
                                disabled="@(paginaActual <= 1)"
                                @onclick="() => CambiarPagina(paginaActual - 1)">
                            <i class="ri-arrow-left-s-line"></i>
                        </button>
                        <strong>@paginaActual / @TotalPaginas</strong>
                        <button type="button"
                                class="pagination-btn"
                                disabled="@(paginaActual >= TotalPaginas)"
                                @onclick="() => CambiarPagina(paginaActual + 1)">
                            <i class="ri-arrow-right-s-line"></i>
                        </button>
                    </div>
                </div>
            }
        </section>
    }
</div>

@if (cajaEdicion is not null)
{
    <div class="modal-backdrop" @onclick="CerrarEditar">
        <section class="edit-modal" @onclick:stopPropagation="true">
            <header class="modal-head">
                <div>
                    <span class="section-kicker">Edición administrativa</span>
                    <h3>@NombreCliente(cajaEdicion)</h3>
                    <p>Caja @cajaEdicion.NumeroCaja · SEC @cajaEdicion.CajaSec</p>
                </div>
                <button type="button" class="close-btn" @onclick="CerrarEditar" disabled="@guardando">
                    <i class="ri-close-line"></i>
                </button>
            </header>

            <div class="modal-body">
                <label class="series-field">
                    <span>Establecimiento - punto de emisión</span>
                    <input value="@cajaEdicion.Serie"
                           maxlength="7"
                           inputmode="numeric"
                           @oninput="e => cajaEdicion.Serie = e.Value?.ToString() ?? string.Empty"
                           disabled="@guardando" />
                    <small>Formato SRI: 001-001. El establecimiento y punto no pueden ser 000.</small>
                </label>

                <div class="modal-table-wrap">
                    <table class="table modal-table mb-0">
                        <thead>
                            <tr>
                                <th>Documento</th>
                                <th>Último secuencial</th>
                                <th>Inicializado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cajaEdicion.Secuencias)
                            {
                                <tr>
                                    <td><strong>@item.DocumentLabel</strong></td>
                                    <td>
                                        <input type="number"
                                               min="0"
                                               max="999999999"
                                               value="@item.LastSequence"
                                               @oninput="e => item.LastSequence = ParseSequence(e.Value)"
                                               disabled="@guardando" />
                                    </td>
                                    <td>
                                        <label class="initialized-check">
                                            <input type="checkbox" @bind="item.Initialized" disabled="@guardando" />
                                            <span>@(item.Initialized ? "Sí" : "No")</span>
                                        </label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <footer class="modal-actions">
                <button type="button" class="secondary-btn" @onclick="CerrarEditar" disabled="@guardando">
                    Cancelar
                </button>
                <button type="button" class="primary-btn" @onclick="GuardarEdicion" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="ri-save-line"></i>
                        <span>Guardar cambios</span>
                    }
                </button>
            </footer>
        </section>
    </div>
}

