@code {
    private const int PageSize = 10;
    private readonly List<AdminCajaSecuenciaDto> cajas = new();
    private int actorUserId;
    private int paginaActual = 1;
    private bool cargando = true;
    private bool guardando;
    private bool tienePermiso = true;
    private bool mensajeEsError;
    private string filtro = string.Empty;
    private string? mensaje;
    private AdminCajaSecuenciaDto? cajaEdicion;

    private string Filtro
    {
        get => filtro;
        set
        {
            filtro = value;
            paginaActual = 1;
        }
    }

    private List<AdminCajaSecuenciaDto> CajasFiltradas =>
        cajas.Where(CoincideFiltro).ToList();

    private IEnumerable<AdminCajaSecuenciaDto> CajasPaginadas =>
        CajasFiltradas
            .Skip((paginaActual - 1) * PageSize)
            .Take(PageSize);

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(CajasFiltradas.Count / (double)PageSize));
    private int PrimerRegistro => CajasFiltradas.Count == 0 ? 0 : ((paginaActual - 1) * PageSize) + 1;
    private int UltimoRegistro => Math.Min(paginaActual * PageSize, CajasFiltradas.Count);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        actorUserId = int.TryParse(authState.User.FindFirst("IdUsuario")?.Value, out var id)
            ? id
            : 0;

        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        mensaje = null;

        try
        {
            cajas.Clear();
            cajas.AddRange(await AdminService.GetAllAsync(actorUserId));
            tienePermiso = true;
            paginaActual = Math.Min(paginaActual, TotalPaginas);
        }
        catch (UnauthorizedAccessException ex)
        {
            tienePermiso = false;
            mensajeEsError = true;
            mensaje = ex.Message;
        }
        catch (Exception ex)
        {
            mensajeEsError = true;
            mensaje = $"No se pudieron cargar las cajas. {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirEditar(AdminCajaSecuenciaDto caja)
    {
        cajaEdicion = Clonar(caja);
        mensaje = null;
    }

    private void CerrarEditar()
    {
        if (!guardando)
        {
            cajaEdicion = null;
        }
    }

    private async Task GuardarEdicion()
    {
        if (cajaEdicion is null)
        {
            return;
        }

        guardando = true;
        mensaje = null;

        try
        {
            var nombre = NombreCliente(cajaEdicion);
            var numeroCaja = cajaEdicion.NumeroCaja;
            await AdminService.SaveAsync(actorUserId, cajaEdicion);
            cajaEdicion = null;
            await Cargar();
            mensajeEsError = false;
            mensaje = $"Caja {numeroCaja} de {nombre} actualizada correctamente.";
            await JS.ShowToastAsync("Caja y secuencias actualizadas");
        }
        catch (Exception ex)
        {
            mensajeEsError = true;
            mensaje = ex.Message;
            await JS.ShowAlertAsync("No se pudo guardar", ex.Message, "error");
        }
        finally
        {
            guardando = false;
        }
    }

    private void CambiarPagina(int pagina)
    {
        paginaActual = Math.Clamp(pagina, 1, TotalPaginas);
    }

    private bool CoincideFiltro(AdminCajaSecuenciaDto caja)
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            return true;
        }

        var term = filtro.Trim();
        return Contiene(caja.Cliente, term) ||
               Contiene(caja.Email, term) ||
               Contiene(caja.Ruc, term) ||
               Contiene(caja.RazonSocial, term) ||
               Contiene(caja.Serie, term) ||
               caja.CajaSec.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
               caja.IdUsuario.ToString().Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private static AdminCajaSecuenciaDto Clonar(AdminCajaSecuenciaDto caja) =>
        new()
        {
            CajaSec = caja.CajaSec,
            NumeroCaja = caja.NumeroCaja,
            IdUsuario = caja.IdUsuario,
            Cliente = caja.Cliente,
            Email = caja.Email,
            Ruc = caja.Ruc,
            RazonSocial = caja.RazonSocial,
            Activa = caja.Activa,
            EsCajaSistema = caja.EsCajaSistema,
            Serie = caja.Serie,
            Secuencias = caja.Secuencias.Select(item => new AdminDocumentoSecuenciaDto
            {
                DocumentKey = item.DocumentKey,
                DocumentLabel = item.DocumentLabel,
                Initialized = item.Initialized,
                LastSequence = item.LastSequence
            }).ToList()
        };

    private static string AbreviarDocumento(string documentKey) =>
        documentKey switch
        {
            "factura" => "FAC",
            "guia-remision" => "GUI",
            "nota-credito" => "NC",
            "nota-debito" => "ND",
            "liquidacion-compra" => "LIQ",
            "compra-manual" => "COM",
            "retencion" => "RET",
            _ => documentKey
        };

    private static bool Contiene(string? value, string term) =>
        (value ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string NombreCliente(AdminCajaSecuenciaDto caja) =>
        !string.IsNullOrWhiteSpace(caja.RazonSocial)
            ? caja.RazonSocial
            : !string.IsNullOrWhiteSpace(caja.Cliente)
                ? caja.Cliente
                : $"Usuario {caja.IdUsuario}";

    private static long ParseSequence(object? value) =>
        long.TryParse(value?.ToString(), out var parsed)
            ? Math.Clamp(parsed, 0, 999_999_999)
            : 0;
}
