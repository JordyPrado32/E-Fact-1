@page "/backoffice/aliados"
@attribute [Authorize(Roles = "7,2")]
@layout Simetric.Components.Layout.BackOfficeLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Aliados | BackOffice</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div><span class="text-primary fw-bold small">PORTAL DE ALIADOS</span><h2 class="mb-1">Cuentas de aliados</h2><p class="text-muted mb-0">Crea el acceso externo con su rol y canal de ventas asignado.</p></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div> }
    <div class="row g-4">
        <div class="col-lg-4"><section class="card border-0 shadow-sm"><div class="card-body"><h5>Nuevo aliado</h5><p class="text-muted small">La cuenta iniciará con cambio de contraseña obligatorio.</p><label class="form-label">Nombre comercial</label><input class="form-control mb-3" @bind="nombre" placeholder="Ej. Distribuidor Costa" /><label class="form-label">Correo de acceso</label><input type="email" class="form-control mb-3" @bind="email" /><label class="form-label">Clave inicial</label><input type="password" class="form-control mb-3" @bind="password" /><label class="form-label">Porcentaje base</label><div class="input-group mb-3"><input type="number" class="form-control" min="0" max="100" step=".01" @bind="porcentaje" /><span class="input-group-text">%</span></div><button class="btn btn-primary w-100" @onclick="Crear" disabled="@guardando">@(guardando ? "Creando..." : "Crear cuenta de aliado")</button></div></section></div>
        <div class="col-lg-8"><section class="card border-0 shadow-sm"><div class="card-body"><h5 class="mb-3">Aliados registrados</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Aliado</th><th>Correo</th><th>Canal</th><th>Comisión</th><th>Estado</th></tr></thead><tbody>@if (aliados.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No hay aliados registrados.</td></tr> } else { @foreach (var aliado in aliados) { <tr @key="aliado.IdVendedor"><td><strong>@aliado.Nombre</strong></td><td>@(aliado.Usuario ?? "Sin cuenta")</td><td><code>@aliado.CodigoReferencia</code></td><td>@aliado.PorcentajeBase.ToString("0.##")%</td><td><span class="badge @(aliado.Activo ? "text-bg-success" : "text-bg-secondary")">@(aliado.Activo ? "Activo" : "Inactivo")</span></td></tr> } }</tbody></table></div></div></section></div>
    </div>
</div>

@code {
    private List<AliadoAdminRow> aliados = new();
    private string nombre = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private decimal porcentaje = 30m;
    private string? mensaje;
    private bool exito;
    private bool guardando;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync() => aliados = (await AliadoService.ListarAliadosAsync()).ToList();

    private async Task Crear()
    {
        if (guardando) return;
        guardando = true;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId);
        var resultado = await AliadoService.CrearCuentaAliadoAsync(actorId, nombre, email, password, porcentaje);
        exito = resultado.Success;
        mensaje = resultado.Message;
        if (resultado.Success) { nombre = email = password = string.Empty; porcentaje = 30m; await CargarAsync(); }
        guardando = false;
    }
}
