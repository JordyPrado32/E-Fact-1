@page "/backoffice/aliados"
@attribute [Authorize(Roles = "7,2")]
@layout Simetric.Components.Layout.BackOfficeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Aliados | BackOffice</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div><span class="text-primary fw-bold small">PORTAL DE ALIADOS</span><h2 class="mb-1">Cuentas de aliados</h2><p class="text-muted mb-0">Crea el acceso externo con su rol y canal de ventas asignado.</p></div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="button" @onclick="AbrirModalCrear">Crear cuenta</button><button class="btn btn-outline-primary" type="button" @onclick="AbrirModalAsociar">Añadir vendedor existente</button></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div> }
    <section class="card border-0 shadow-sm"><div class="card-body">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3"><h5 class="mb-0">Aliados registrados</h5><div class="d-flex gap-2 flex-wrap"><input class="form-control" style="min-width:260px" @bind="filtroAliados" @bind:event="oninput" placeholder="Buscar aliado, correo o canal" /><select class="form-select" @bind="filtroEstado"><option value="">Todos los estados</option><option value="activo">Activos</option><option value="inactivo">Inactivos</option></select></div></div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Aliado</th><th>Correo</th><th>Canal</th><th>Comisión</th><th>Estado</th></tr></thead><tbody>@if (!AliadosFiltrados.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No hay aliados para los filtros seleccionados.</td></tr> } else { @foreach (var aliado in AliadosFiltrados) { <tr @key="aliado.IdVendedor"><td><strong>@aliado.Nombre</strong></td><td>@(aliado.Usuario ?? "Sin cuenta")</td><td><code>@aliado.CodigoReferencia</code></td><td>@aliado.PorcentajeBase.ToString("0.##", CultureInfo.InvariantCulture)%</td><td><span class="badge @(aliado.Activo ? "text-bg-success" : "text-bg-secondary")">@(aliado.Activo ? "Activo" : "Inactivo")</span></td></tr> } }</tbody></table></div>
    </div></section>
</div>

@if (mostrarModalCrear)
{
    <div class="modal d-block" tabindex="-1" role="dialog" @onclick="CerrarModalCrear">
        <div class="modal-dialog" role="document" @onclick:stopPropagation="true"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Crear cuenta de aliado</h5><button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModalCrear"></button></div>
            <div class="modal-body"><p class="text-muted small">La cuenta iniciará con cambio de contraseña obligatorio.</p><label class="form-label">Nombre comercial</label><input class="form-control mb-3" @bind="nombre" placeholder="Ej. Distribuidor Costa" /><label class="form-label">Correo de acceso</label><input type="email" class="form-control mb-3" @bind="email" /><label class="form-label">Clave inicial</label><input type="password" class="form-control mb-3" @bind="password" /><label class="form-label">Porcentaje base (0 a 100)</label><input type="number" class="form-control" min="0" max="100" step="0.01" @bind="porcentaje" /></div>
            <div class="modal-footer"><button class="btn btn-secondary" type="button" @onclick="CerrarModalCrear">Cancelar</button><button class="btn btn-primary" type="button" @onclick="Crear" disabled="@guardando">@(guardando ? "Creando..." : "Crear cuenta")</button></div>
        </div></div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (mostrarModalAsociar)
{
    <div class="modal d-block" tabindex="-1" role="dialog" @onclick="CerrarModalAsociar">
        <div class="modal-dialog" role="document" @onclick:stopPropagation="true"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Añadir vendedor como aliado</h5><button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModalAsociar"></button></div>
            <div class="modal-body"><p class="text-muted small">Conserva su tipo de vendedor y habilita su acceso al Portal de Aliados.</p><label class="form-label">Vendedor</label><select class="form-select" @bind="idVendedorSeleccionado"><option value="0">Selecciona un vendedor</option>@foreach (var vendedor in vendedoresDisponibles) { <option value="@vendedor.IdVendedor">@vendedor.Nombre (@vendedor.Email)</option> }</select></div>
            <div class="modal-footer"><button class="btn btn-secondary" type="button" @onclick="CerrarModalAsociar">Cancelar</button><button class="btn btn-primary" type="button" @onclick="AgregarVendedorComoAliado" disabled="@(guardando || idVendedorSeleccionado <= 0)">Añadir como aliado</button></div>
        </div></div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<AliadoAdminRow> aliados = new();
    private string nombre = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private decimal porcentaje = 30m;
    private int idVendedorSeleccionado;
    private List<AliadoVendedorDisponible> vendedoresDisponibles = new();
    private string? mensaje;
    private bool exito;
    private bool guardando;
    private bool mostrarModalCrear;
    private bool mostrarModalAsociar;
    private string filtroAliados = string.Empty;
    private string filtroEstado = string.Empty;

    private IEnumerable<AliadoAdminRow> AliadosFiltrados => aliados.Where(x =>
        (string.IsNullOrWhiteSpace(filtroAliados) || x.Nombre.Contains(filtroAliados, StringComparison.OrdinalIgnoreCase) || (x.Usuario?.Contains(filtroAliados, StringComparison.OrdinalIgnoreCase) ?? false) || x.CodigoReferencia.Contains(filtroAliados, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroEstado) || (filtroEstado == "activo" && x.Activo) || (filtroEstado == "inactivo" && !x.Activo)));

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        aliados = (await AliadoService.ListarAliadosAsync()).ToList();
        vendedoresDisponibles = (await AliadoService.ListarVendedoresDisponiblesComoAliadosAsync()).ToList();
    }

    private void AbrirModalCrear() => mostrarModalCrear = true;
    private void CerrarModalCrear() { if (!guardando) mostrarModalCrear = false; }
    private void AbrirModalAsociar() => mostrarModalAsociar = true;
    private void CerrarModalAsociar() { if (!guardando) mostrarModalAsociar = false; }

    private async Task AgregarVendedorComoAliado()
    {
        if (guardando || idVendedorSeleccionado <= 0)
            return;

        guardando = true;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId);
        var resultado = await AliadoService.AsociarVendedorComoAliadoAsync(actorId, idVendedorSeleccionado);
        exito = resultado.Success;
        mensaje = resultado.Message;
        if (resultado.Success)
        {
            idVendedorSeleccionado = 0;
            mostrarModalAsociar = false;
            await CargarAsync();
        }
        guardando = false;
    }

    private async Task Crear()
    {
        if (guardando) return;
        if (porcentaje is < 0 or > 100)
        {
            exito = false;
            mensaje = "El porcentaje debe estar entre 0 y 100.";
            return;
        }
        porcentaje = decimal.Round(porcentaje, 2, MidpointRounding.AwayFromZero);
        guardando = true;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId);
        var resultado = await AliadoService.CrearCuentaAliadoAsync(actorId, nombre, email, password, porcentaje);
        exito = resultado.Success;
        mensaje = resultado.Message;
        if (resultado.Success) { nombre = email = password = string.Empty; porcentaje = 30m; mostrarModalCrear = false; await CargarAsync(); }
        guardando = false;
    }
}
