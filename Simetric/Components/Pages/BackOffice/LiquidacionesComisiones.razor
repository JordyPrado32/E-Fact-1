@page "/backoffice/liquidaciones-comisiones"
@attribute [Authorize(Roles = "7,2")]
@layout Simetric.Components.Layout.BackOfficeLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Liquidaciones de comisiones | BackOffice</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><span class="text-primary fw-bold small">ALIADOS</span><h2 class="mb-1">Liquidaciones de comisiones</h2><p class="text-muted mb-0">Pagos registrados para todos los aliados.</p></div><a class="btn btn-outline-primary" href="/backoffice/comisiones">Comisiones por pagar</a></div>
    @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div> }
    <section class="card border-0 shadow-sm"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Aliado</th><th>Período</th><th>Comisiones</th><th>Total</th><th>Pago</th><th>SRI</th><th>Observación</th><th>Comprobante</th><th></th></tr></thead><tbody>
    @foreach (var item in liquidaciones)
    {
        <tr @key="item.IdLiquidacion"><td>@item.Aliado</td><td>@item.Periodo</td><td>@item.CantidadComisiones</td><td>$ @item.Total.ToString("N2")</td><td>@item.Estado<br /><small>@((item.FechaPago ?? item.Fecha).ToString("dd/MM/yyyy"))</small></td><td>@item.EstadoSri@if (!string.IsNullOrWhiteSpace(item.ErrorSri)) { <br /><small>@item.ErrorSri</small> }</td><td>@(item.ObservacionPago ?? "-")</td><td>@if (!string.IsNullOrWhiteSpace(item.ComprobantePagoUrl)) { <a href="@item.ComprobantePagoUrl" target="_blank">Ver comprobante</a> } else { <span>-</span> }</td><td>@if (item.EstadoSri == "Error") { <button class="btn btn-outline-primary btn-sm" @onclick="() => ReintentarAsync(item.IdLiquidacion)">Reintentar SRI</button> }</td></tr>
    }
    </tbody></table></div></div></section>
</div>

@code {
    private List<AliadoAdminLiquidacionRow> liquidaciones = new();
    private int actorId;
    private string? mensaje;
    private bool exito;
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out actorId))
            liquidaciones = (await AliadoService.ObtenerLiquidacionesAdministracionAsync(actorId)).ToList();
    }
    private async Task ReintentarAsync(int idLiquidacion)
    {
        var resultado = await AliadoService.ReintentarLiquidacionSriAsync(actorId, idLiquidacion);
        exito = resultado.Success; mensaje = resultado.Message;
        if (resultado.Success) liquidaciones = (await AliadoService.ObtenerLiquidacionesAdministracionAsync(actorId)).ToList();
    }
}
