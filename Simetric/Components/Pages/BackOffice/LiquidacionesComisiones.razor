@page "/backoffice/liquidaciones-comisiones"
@attribute [Authorize(Roles = "7,2")]
@layout Simetric.Components.Layout.BackOfficeLayout
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.DTOs
@using Simetric.Services
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ISimpleExcelExportService ExcelExportService
@inject SweetAlertService AlertService

<PageTitle>Reportes de liquidaciones pagadas | BackOffice</PageTitle>
<link href="/css/reportes-compartido.css" rel="stylesheet" />

<div class="reports-container commission-tools-page">
    <div class="report-header-card no-print animate__animated animate__fadeIn">
        <div class="report-header-top">
            <div>
                <span class="filter-label">PORTAL DE ALIADOS</span>
                <h2 class="report-page-title"><i class="bi bi-bar-chart-line-fill"></i> Reporte de liquidaciones pagadas</h2>
                <p class="text-muted mb-0">Analiza pagos, estados SRI y comportamiento por aliado desde un solo reporte.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" href="/backoffice/comisiones"><i class="bi bi-arrow-left"></i> Comisiones</a>
                <button type="button" class="btn-export" @onclick="ExportarExcelAsync" disabled="@(!LiquidacionesVisibles.Any())"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Exportar Excel avanzado</button>
            </div>
        </div>
        <div class="report-header-filters">
            <div class="filter-group"><span class="filter-label">Desde</span><input type="date" class="filter-input" @bind="fechaDesde" @bind:after="AplicarFiltrosAsync" /></div>
            <div class="filter-group"><span class="filter-label">Hasta</span><input type="date" class="filter-input" @bind="fechaHasta" @bind:after="AplicarFiltrosAsync" /></div>
            <div class="filter-group"><span class="filter-label">Aliado</span><select class="filter-input" @bind="filtroAliado" @bind:after="AplicarFiltrosAsync"><option value="">Todos los aliados</option>@foreach (var aliado in AliadosDisponibles) { <option value="@aliado">@aliado</option> }</select></div>
            <div class="filter-group"><span class="filter-label">Estado de pago</span><select class="filter-input" @bind="filtroPago" @bind:after="AplicarFiltrosAsync"><option value="">Todos</option><option value="Pagada">Pagadas</option><option value="Pendiente">Pendientes</option></select></div>
            <div class="filter-group"><span class="filter-label">Estado SRI</span><select class="filter-input" @bind="filtroSri" @bind:after="AplicarFiltrosAsync"><option value="">Todos</option><option value="Enviada">Enviadas</option><option value="Pendiente">Pendientes</option><option value="Error">Con error</option></select></div>
            <div class="filter-group"><span class="filter-label">Período</span><select class="filter-input" @bind="filtroPeriodo" @bind:after="AplicarFiltrosAsync"><option value="">Todos los períodos</option>@foreach (var periodo in PeriodosDisponibles) { <option value="@periodo">@periodo</option> }</select></div>
            <div class="filter-group filter-group-search"><span class="filter-label">Buscar</span><input class="filter-input" placeholder="Aliado, período, referencia o código" @bind="busqueda" @bind:event="oninput" @bind:after="AplicarFiltrosAsync" /></div>
            <div class="filter-presets"><button type="button" class="btn-preset @(presetActivo == "mes" ? "active" : "")" @onclick='() => AplicarPreset("mes")'>Este mes</button><button type="button" class="btn-preset @(presetActivo == "trimestre" ? "active" : "")" @onclick='() => AplicarPreset("trimestre")'>90 días</button><button type="button" class="btn-preset @(presetActivo == "anio" ? "active" : "")" @onclick='() => AplicarPreset("anio")'>Este año</button><button type="button" class="btn-preset @(presetActivo == "todo" ? "active" : "")" @onclick='() => AplicarPreset("todo")'>Todo</button><button type="button" class="btn-preset" @onclick="LimpiarFiltros">Limpiar</button></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") no-print" role="alert">@mensaje</div>
    }

    <div class="reports-viewport printable-report">
        <div class="report-slide report-slide-active">
            <div class="visual-header"><h3 class="visual-title">Panel ejecutivo de pagos</h3><p class="visual-subtitle">Los indicadores y gráficos se recalculan con los filtros seleccionados. @LiquidacionesVisibles.Count() registro(s) visibles.</p></div>
            <div class="kpis-grid">
                <div class="bo-kpi-card"><div class="kpi-icon-container kpi-icon-purple"><i class="bi bi-receipt-cutoff"></i></div><div class="kpi-details"><span class="kpi-card-title">Liquidaciones</span><strong class="kpi-card-value">@LiquidacionesVisibles.Count()</strong><span class="kpi-card-trend trend-neutral">Resultado filtrado</span></div></div>
                <div class="bo-kpi-card"><div class="kpi-icon-container kpi-icon-blue"><i class="bi bi-cash-stack"></i></div><div class="kpi-details"><span class="kpi-card-title">Total pagado</span><strong class="kpi-card-value">$ @TotalPagado.ToString("N2")</strong><span class="kpi-card-trend trend-up">Acumulado del período</span></div></div>
                <div class="bo-kpi-card"><div class="kpi-icon-container kpi-icon-teal"><i class="bi bi-people-fill"></i></div><div class="kpi-details"><span class="kpi-card-title">Aliados con pagos</span><strong class="kpi-card-value">@AliadosConPagos</strong><span class="kpi-card-trend trend-neutral">Canales incluidos</span></div></div>
                <div class="bo-kpi-card"><div class="kpi-icon-container kpi-icon-green"><i class="bi bi-check-circle-fill"></i></div><div class="kpi-details"><span class="kpi-card-title">Enviadas al SRI</span><strong class="kpi-card-value">@CantidadSri("Enviada")</strong><span class="kpi-card-trend trend-up">Documentos procesados</span></div></div>
                <div class="bo-kpi-card"><div class="kpi-icon-container kpi-icon-orange"><i class="bi bi-exclamation-triangle-fill"></i></div><div class="kpi-details"><span class="kpi-card-title">Con error SRI</span><strong class="kpi-card-value">@CantidadSri("Error")</strong><span class="kpi-card-trend trend-neutral">Requieren seguimiento</span></div></div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-xl-7"><div class="report-visual-card h-100"><div class="visual-header"><h4 class="visual-title">Evolución mensual de pagos</h4><p class="visual-subtitle">Total pagado y cantidad de liquidaciones por mes.</p></div><div class="chart-container" style="height:320px"><canvas id="liquidaciones-comisiones-evolution" aria-label="Evolución mensual de liquidaciones" role="img"></canvas></div></div></div>
                <div class="col-xl-5"><div class="report-visual-card h-100"><div class="visual-header"><h4 class="visual-title">Distribución por estado SRI</h4><p class="visual-subtitle">Identifica pendientes y errores de emisión.</p></div><div class="chart-container" style="height:320px"><canvas id="liquidaciones-comisiones-sri" aria-label="Distribución por estado SRI" role="img"></canvas></div></div></div>
                <div class="col-12"><div class="report-visual-card"><div class="visual-header"><h4 class="visual-title">Total pagado por aliado</h4><p class="visual-subtitle">Comparativo de aportación al total del período seleccionado.</p></div><div class="chart-container" style="height:340px"><canvas id="liquidaciones-comisiones-aliados" aria-label="Total pagado por aliado" role="img"></canvas></div></div></div>
            </div>

            <div class="report-table-card mt-4">
                <div class="table-header-row"><div><h4 class="table-title">Detalle de liquidaciones</h4><p class="visual-subtitle mb-0">Consulta cada pago, referencia, código de liquidación y estado de envío.</p></div><span class="report-tab-badge">Página @pagina de @TotalPaginas</span></div>
                <div class="table-responsive"><table class="bo-table"><thead><tr><th>Fecha</th><th>Aliado</th><th>Período</th><th>Movimientos</th><th>Total</th><th>Pago</th><th>Estado SRI</th><th>Comprobante</th><th></th></tr></thead><tbody>
                    @if (!LiquidacionesVisibles.Any()) { <tr><td colspan="9" class="text-center text-muted py-5">No hay liquidaciones para los filtros seleccionados.</td></tr> }
                    @foreach (var item in LiquidacionesPaginadas)
                    {
                        <tr @key="item.IdLiquidacion"><td><strong>@FechaPago(item).ToString("dd/MM/yyyy")</strong></td><td><strong>@item.Aliado</strong><small>@(item.ObservacionPago ?? "Sin observación")</small></td><td>@item.Periodo</td><td>@item.CantidadComisiones</td><td><strong class="text-blue">$ @item.Total.ToString("N2")</strong></td><td>@(item.ReferenciaPago ?? "Sin referencia")<small>LC: @(item.CodLiquidacionCompra?.ToString() ?? "Pendiente")</small></td><td><span class="report-tab-badge @(EstadoSri(item) == "Enviada" ? "text-bg-success" : EstadoSri(item) == "Error" ? "text-bg-danger" : "text-bg-warning")">@EstadoSri(item)</span>@if (!string.IsNullOrWhiteSpace(ErrorSri(item))) { <small class="text-danger">@ErrorSri(item)</small> }</td><td>@if (!string.IsNullOrWhiteSpace(item.ComprobantePagoUrl)) { <a href="@item.ComprobantePagoUrl" target="_blank" rel="noopener">Ver comprobante</a> } else { <span class="text-muted">No adjunto</span> }</td><td>@if (EstadoSri(item) == "Error") { <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ReintentarAsync(item.IdLiquidacion)" disabled="@reintentando.Contains(item.IdLiquidacion)">@(reintentando.Contains(item.IdLiquidacion) ? "Enviando..." : "Reintentar")</button> }</td></tr>
                    }
                </tbody></table></div>
                <div class="pagination-controls"><span class="page-indicator">Página @pagina de @TotalPaginas</span><div class="pagination-btn-group"><button type="button" class="btn-pagination" disabled="@(pagina <= 1)" @onclick="() => CambiarPagina(-1)"><i class="bi bi-chevron-left"></i> Anterior</button><button type="button" class="btn-pagination" disabled="@(pagina >= TotalPaginas)" @onclick="() => CambiarPagina(1)">Siguiente <i class="bi bi-chevron-right"></i></button></div></div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AliadoAdminLiquidacionRow> liquidaciones = new();
    private readonly HashSet<int> reintentando = new();
    private readonly Dictionary<int, string> estadosSri = new();
    private readonly Dictionary<int, string?> erroresSri = new();
    private int actorId;
    private string? mensaje;
    private bool exito;
    private bool graficosPendientes;
    private string busqueda = string.Empty;
    private string filtroAliado = string.Empty;
    private string filtroPago = "Pagada";
    private string filtroSri = string.Empty;
    private string filtroPeriodo = string.Empty;
    private DateTime? fechaDesde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? fechaHasta = DateTime.Today;
    private string presetActivo = "mes";
    private int pagina = 1;
    private const int TamanoPagina = 20;

    private IEnumerable<AliadoAdminLiquidacionRow> LiquidacionesVisibles => liquidaciones.Where(x =>
        (string.IsNullOrWhiteSpace(filtroAliado) || x.Aliado.Equals(filtroAliado, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroPago) || x.Estado.Equals(filtroPago, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroSri) || EstadoSri(x).Equals(filtroSri, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroPeriodo) || x.Periodo.Equals(filtroPeriodo, StringComparison.OrdinalIgnoreCase)) &&
        (!fechaDesde.HasValue || FechaPago(x).Date >= fechaDesde.Value.Date) &&
        (!fechaHasta.HasValue || FechaPago(x).Date <= fechaHasta.Value.Date) &&
        (string.IsNullOrWhiteSpace(busqueda) || $"{x.Aliado} {x.Periodo} {x.ReferenciaPago} {x.CodLiquidacionCompra}".Contains(busqueda, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<AliadoAdminLiquidacionRow> LiquidacionesPaginadas => LiquidacionesVisibles.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina);
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(LiquidacionesVisibles.Count() / (double)TamanoPagina));
    private IEnumerable<string> AliadosDisponibles => liquidaciones.Select(x => x.Aliado).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private IEnumerable<string> PeriodosDisponibles => liquidaciones.Select(x => x.Periodo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderByDescending(x => x);
    private decimal TotalPagado => LiquidacionesVisibles.Sum(x => x.Total);
    private int AliadosConPagos => LiquidacionesVisibles.Select(x => x.Aliado).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private string EstadoSri(AliadoAdminLiquidacionRow item) => estadosSri.TryGetValue(item.IdLiquidacion, out var estado) ? estado : item.EstadoSri;
    private string? ErrorSri(AliadoAdminLiquidacionRow item) => erroresSri.TryGetValue(item.IdLiquidacion, out var error) ? error : item.ErrorSri;
    private int CantidadSri(string estado) => LiquidacionesVisibles.Count(x => EstadoSri(x).Equals(estado, StringComparison.OrdinalIgnoreCase));
    private static DateTime FechaPago(AliadoAdminLiquidacionRow item) => item.FechaPago ?? item.Fecha;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out actorId))
            liquidaciones = (await AliadoService.ObtenerLiquidacionesAdministracionAsync(actorId)).ToList();
        foreach (var item in liquidaciones)
        {
            estadosSri[item.IdLiquidacion] = item.EstadoSri;
            erroresSri[item.IdLiquidacion] = item.ErrorSri;
        }
        graficosPendientes = true;
    }

    private Task AplicarFiltrosAsync()
    {
        pagina = 1;
        graficosPendientes = true;
        return Task.CompletedTask;
    }

    private void AplicarPreset(string preset)
    {
        presetActivo = preset;
        var hoy = DateTime.Today;
        if (preset == "mes") fechaDesde = new DateTime(hoy.Year, hoy.Month, 1);
        else if (preset == "trimestre") fechaDesde = hoy.AddDays(-89);
        else if (preset == "anio") fechaDesde = new DateTime(hoy.Year, 1, 1);
        else fechaDesde = null;
        fechaHasta = hoy;
        pagina = 1;
        graficosPendientes = true;
    }

    private void LimpiarFiltros()
    {
        busqueda = filtroAliado = filtroSri = filtroPeriodo = string.Empty;
        filtroPago = "Pagada";
        presetActivo = string.Empty;
        fechaDesde = null;
        fechaHasta = null;
        pagina = 1;
        graficosPendientes = true;
    }

    private void CambiarPagina(int delta) => pagina = Math.Clamp(pagina + delta, 1, TotalPaginas);

    private async Task ReintentarAsync(int idLiquidacion)
    {
        if (!reintentando.Add(idLiquidacion)) return;
        try
        {
            var resultado = await AliadoService.ReintentarLiquidacionSriAsync(actorId, idLiquidacion);
            exito = resultado.Success; mensaje = resultado.Message;
            estadosSri[idLiquidacion] = resultado.Success ? "Enviada" : "Error";
            erroresSri[idLiquidacion] = resultado.Success ? null : resultado.Message;
            graficosPendientes = true;
        }
        finally { reintentando.Remove(idLiquidacion); }
    }

    private async Task ExportarExcelAsync()
    {
        var datos = LiquidacionesVisibles.ToList();
        if (datos.Count == 0)
        {
            await AlertService.ShowInfoAsync("No hay datos para exportar con los filtros actuales.");
            return;
        }

        var detalle = datos.Select(item => (IReadOnlyList<string>)new[] { FechaPago(item).ToString("yyyy-MM-dd"), item.Aliado, item.Periodo, item.CantidadComisiones.ToString(), item.Total.ToString("0.00"), item.Estado, item.ReferenciaPago ?? string.Empty, EstadoSri(item), ErrorSri(item) ?? string.Empty, item.ObservacionPago ?? string.Empty, item.CodLiquidacionCompra?.ToString() ?? string.Empty, item.ComprobantePagoUrl ?? string.Empty }).ToList();
        var porAliado = datos.GroupBy(x => x.Aliado).OrderByDescending(x => x.Sum(y => y.Total)).Select(x => (IReadOnlyList<string>)new[] { x.Key, x.Count().ToString(), x.Sum(y => y.CantidadComisiones).ToString(), x.Sum(y => y.Total).ToString("0.00") }).ToList();
        var resumen = new List<IReadOnlyList<string>>
        {
            new[] { "Liquidaciones", datos.Count.ToString() },
            new[] { "Total pagado", datos.Sum(x => x.Total).ToString("0.00") },
            new[] { "Aliados", datos.Select(x => x.Aliado).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString() },
            new[] { "Enviadas al SRI", datos.Count(x => EstadoSri(x) == "Enviada").ToString() },
            new[] { "Pendientes SRI", datos.Count(x => EstadoSri(x) == "Pendiente").ToString() },
            new[] { "Errores SRI", datos.Count(x => EstadoSri(x) == "Error").ToString() }
        };
        var archivo = ExcelExportService.Create($"reporte_liquidaciones_aliados_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
            new ExcelSheetData("Resumen", new[] { "Indicador", "Valor" }, resumen),
            new ExcelSheetData("Liquidaciones", new[] { "Fecha pago", "Aliado", "Período", "Comisiones", "Total", "Estado pago", "Referencia", "Estado SRI", "Error SRI", "Observación", "Código LC", "Comprobante" }, detalle),
            new ExcelSheetData("Por aliado", new[] { "Aliado", "Liquidaciones", "Comisiones", "Total pagado" }, porAliado));
        await using var stream = new MemoryStream(archivo.Content);
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", archivo.FileName, reference, archivo.ContentType);
        await AlertService.ShowSuccessAsync("El reporte avanzado fue generado correctamente.", "Exportación lista");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!graficosPendientes) return;
        graficosPendientes = false;
        var datos = LiquidacionesVisibles.ToList();
        var referenciaFecha = fechaHasta ?? DateTime.Today;
        var meses = Enumerable.Range(0, 6).Select(offset => new DateTime(referenciaFecha.Year, referenciaFecha.Month, 1).AddMonths(offset - 5)).ToList();
        var aliados = datos.GroupBy(x => x.Aliado).OrderByDescending(x => x.Sum(y => y.Total)).Take(10).ToList();
        await JS.InvokeVoidAsync("liquidacionesComisionesCharts.render", new
        {
            evolution = new { labels = meses.Select(x => x.ToString("MMM yy", new System.Globalization.CultureInfo("es-EC"))), totals = meses.Select(m => datos.Where(x => FechaPago(x).Year == m.Year && FechaPago(x).Month == m.Month).Sum(x => x.Total)), counts = meses.Select(m => datos.Count(x => FechaPago(x).Year == m.Year && FechaPago(x).Month == m.Month)) },
            allies = new { labels = aliados.Select(x => x.Key), values = aliados.Select(x => x.Sum(y => y.Total)) },
            sri = new { labels = new[] { "Enviada", "Pendiente", "Error" }, values = new[] { datos.Count(x => EstadoSri(x) == "Enviada"), datos.Count(x => EstadoSri(x) == "Pendiente"), datos.Count(x => EstadoSri(x) == "Error") } }
        });
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("liquidacionesComisionesCharts.destroy"); } catch { }
    }
}
