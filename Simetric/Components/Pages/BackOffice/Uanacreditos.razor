@page "/backoffice/uanacreditos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Models
@using Simetric.DTOs.ESign
@using Simetric.Services
@using Simetric.Services.ESign
@attribute [Authorize]
@inject UanatacaApiService UanatacaApiService
@inject SolicitudService SolicitudService
@inject EmisorSistemaService EmisorSistemaService
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Uanacréditos | BackOffice</PageTitle>

<div class="uanacredits-page animate__animated animate__fadeIn">
    <header class="uanacredits-header">
        <div class="uanacredits-title-block">
            @if (puedeVerHerramientas)
            {
                <span class="uanacredits-eyebrow">Uanataca · BackOffice</span>
                <h2>Saldo de <em>Uanacréditos</em></h2>
                <p>Controla el crédito disponible para procesar firmas electrónicas.</p>
            }
            else
            {
                <span class="uanacredits-eyebrow">Uanataca</span>
                <h2>Uanacréditos</h2>
                <p>Saldo disponible para procesar solicitudes de firma electrónica.</p>
            }
        </div>
        @if (puedeVerHerramientas)
        {
            <div class="uanacredits-actions">
                <button type="button" @onclick="ConsultarSaldoAsync" disabled="@consultando">
                    <i class="ri-refresh-line @(consultando ? "is-spinning" : string.Empty)"></i>
                    @(consultando ? "Consultando..." : "Actualizar saldo")
                </button>
                <button type="button" class="uanacredits-header-button is-secondary" @onclick="ActualizarPendientesAsync" disabled="@(sincronizandoPendientes || !UanatacaApiService.IsConfigured)">
                    <i class="ri-refresh-line @(sincronizandoPendientes ? "is-spinning" : string.Empty)"></i>
                    @(sincronizandoPendientes ? "Actualizando..." : "Actualizar estados")
                </button>
            </div>
        }
    </header>

    @if (puedeVerHerramientas)
    {
    <section class="uanacredits-context-grid">
        <article class="uanacredits-context-card">
            <i class="ri-building-4-line"></i>
            <div>
                <span>Emisor maestro</span>
                <strong>@NombreEmisorMaestro</strong>
                <small>RUC: @RucEmisorMaestro</small>
            </div>
        </article>
    </section>
    }

    @if (!UanatacaApiService.IsConfigured)
    {
        <section class="uanacredits-alert">
            <i class="ri-settings-3-line"></i>
            <div>
                <strong>Integración pendiente de configuración</strong>
                <p>Configura la URL y las credenciales de Uanataca para consultar el saldo.</p>
            </div>
        </section>
    }
    else if (consultando && saldo is null)
    {
        <section class="uanacredits-state">
            <span class="spinner-border text-primary" role="status"></span>
            <p>Consultando el saldo disponible...</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="uanacredits-alert is-error">
            <i class="ri-error-warning-line"></i>
            <div>
                <strong>No fue posible consultar Uanacréditos</strong>
                <p>@error</p>
            </div>
        </section>
    }
    else if (saldo is decimal saldoDisponible)
    {
        <section class="uanacredits-balance-grid @(puedeVerHerramientas ? string.Empty : "is-reader")">
            <article class="uanacredits-card @(puedeVerHerramientas ? "is-admin" : "is-reader")">
                <div class="uanacredits-icon"><i class="ri-coins-line"></i></div>
                <div class="uanacredits-balance-main">
                    <span>Saldo disponible</span>
                    <strong>@saldoDisponible.ToString("N2")</strong>
                    <small>Uanacréditos</small>
                </div>
                @if (puedeVerHerramientas)
                {
                    <div class="uanacredits-balance-metrics">
                        <div><i class="ri-user-follow-line"></i><strong>@saldoDisponible.ToString("N2")</strong><span>Disponibles</span></div>
                    </div>
                }
                @if (ultimaConsulta is DateTime fecha)
                {
                    @if (puedeVerHerramientas)
                    {
                        <time>Actualizado: @fecha.ToString("dd/MM/yyyy HH:mm")</time>
                    }
                    else
                    {
                        <time class="uanacredits-reader-updated">
                            <i class="ri-time-line"></i>
                            <span><small>Última actualización</small><strong>@fecha.ToString("dd/MM/yyyy HH:mm")</strong></span>
                        </time>
                    }
                }
            </article>

        </section>
    }

    @if (puedeVerHerramientas && UanatacaApiService.IsConfigured)
    {
        @if (!string.IsNullOrWhiteSpace(mensajePendientes))
        {
            <section class="uanacredits-endpoints"><strong>@mensajePendientes</strong></section>
        }
        <section class="uanacredits-lower-grid">
            <div class="uanacredits-requests-column">
                <section class="uanacredits-endpoints uanacredits-request-panel">
                    <div class="uanacredits-request-info">
                        <span>Solicitudes enviadas a Uanataca</span>
                        <strong>GET @CertificateRequestsEndpoint</strong>
                    </div>
                    <div class="uanacredits-direct-query">
                        <div>
                            <span>Consulta directa por UUID</span>
                            <small>Autentica contra Uanataca y consulta únicamente la solicitud indicada.</small>
                        </div>
                        <div class="uanacredits-query-row">
                            <input class="form-control"
                                   placeholder="Pega aquí el UUID de la solicitud"
                                   @bind="uuidConsultaDirecta"
                                   @bind:event="oninput" />
                            <button type="button"
                                    class="btn btn-primary"
                                    @onclick="ConsultarSolicitudPorUuidAsync"
                                    disabled="@(consultandoUuid || !UanatacaApiService.IsConfigured)">
                                <i class="ri-search-line @(consultandoUuid ? "is-spinning" : string.Empty)"></i>
                                @(consultandoUuid ? "Consultando..." : "Probar endpoint")
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(uuidConsultaDirecta))
                        {
                            <small class="d-block text-muted mt-2 text-break">GET @GetUuidEndpoint()</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(errorUuid))
                        {
                            <p class="text-danger mt-2 mb-0">@errorUuid</p>
                        }
                        @if (solicitudUuid is not null)
                        {
                            <div class="table-responsive mt-3">
                                <table class="table table-sm align-middle mb-0">
                                    <tbody>
                                        <tr><th>UUID</th><td class="text-break">@solicitudUuid.Uuid</td></tr>
                                        <tr><th>Estado interno</th><td>@GetEstadoUanatacaLabel(solicitudUuid.Status)</td></tr>
                                        <tr><th>Estado Uanataca</th><td><span class="uanacredits-status-badge @GetEstadoUanatacaClase(solicitudUuid.UanatacaStatus)">@GetEstadoUanatacaLabel(solicitudUuid.UanatacaStatus)</span></td></tr>
                                        <tr><th>Fecha de solicitud</th><td>@(solicitudUuid.RequestDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td></tr>
                                        <tr><th>Comentarios</th><td>@(solicitudUuid.Comments ?? "-")</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="uanacredits-filters">
                        <input class="form-control" placeholder="UUID, identificación o correo" @bind="filtroTexto" />
                        <select class="form-select" @bind="filtroEstado">
                            <option value="">Todos los estados</option>
                            <option value="NEW">Nuevas</option>
                            <option value="IN_VALIDATION">En validación</option>
                            <option value="APPROVED">Aprobadas</option>
                            <option value="REJECTED">Rechazadas</option>
                            <option value="CANCELED">Canceladas</option>
                        </select>
                        <button type="button" class="btn btn-primary" @onclick="ConsultarSolicitudesAsync" disabled="@consultandoSolicitudes">
                            <i class="ri-list-check"></i>
                            @(consultandoSolicitudes ? "Consultando..." : "Consultar solicitudes")
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorSolicitudes))
                    {
                        <p class="text-danger mt-2">@errorSolicitudes</p>
                    }
                </section>
                @if (solicitudesRemotas is not null)
                {
                    <div class="table-responsive uanacredits-requests-table">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>UUID</th><th>Identificación</th><th>Estado interno</th><th>Estado Uanataca</th><th>Fecha</th></tr></thead>
                            <tbody>
                                @foreach (var solicitud in solicitudesRemotas)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(solicitud.Uuid))
                                            {
                                                <div class="input-group input-group-sm">
                                                    <input class="form-control" value="@solicitud.Uuid" readonly aria-label="UUID de la solicitud" />
                                                    <button type="button" class="btn btn-outline-secondary" title="Copiar UUID" @onclick="() => CopiarUuidAsync(solicitud.Uuid)"><i class="ri-file-copy-line"></i></button>
                                                    <button type="button" class="btn btn-outline-primary" @onclick="() => PrepararYConsultarSolicitudAsync(solicitud.Uuid)">Probar</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>Sin UUID</span>
                                            }
                                        </td>
                                        <td>@(solicitud.Identification ?? "-")</td>
                                        <td>@(solicitud.Status ?? "-")</td>
                                        <td><span class="uanacredits-status-badge @GetEstadoUanatacaClase(solicitud.UanatacaStatus)">@GetEstadoUanatacaLabel(solicitud.UanatacaStatus)</span></td>
                                        <td>@(solicitud.RequestDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <section class="uanacredits-activity">
                <header><div><span>Actividad reciente</span><strong>Últimas consultas</strong></div><i class="ri-time-line"></i></header>
                <div class="uanacredits-activity-head"><span>FECHA</span><span>ACCIÓN</span><span>DETALLE</span><span>RESULTADO</span></div>
                <div class="uanacredits-activity-row"><time>@(ultimaConsulta?.ToString("dd/MM/yyyy HH:mm") ?? "--/--/---- --:--")</time><span><i class="ri-refresh-line"></i> Consulta de saldo</span><span>@saldo?.ToString("N2") U.C.</span><b><i class="ri-check-line"></i></b></div>
                <div class="uanacredits-activity-row"><time>@(ultimaConsulta?.ToString("dd/MM/yyyy HH:mm") ?? "--/--/---- --:--")</time><span><i class="ri-list-check"></i> Consultar solicitudes</span><span>@(solicitudesRemotas?.Count ?? 0) solicitudes</span><b><i class="ri-check-line"></i></b></div>
                <div class="uanacredits-activity-row"><time>--/--/---- --:--</time><span><i class="ri-search-line"></i> Consulta por UUID</span><span>@(solicitudUuid?.Uuid is { Length: > 8 } uuid ? $"{uuid[..4]}...{uuid[^4..]}" : "Sin consulta")</span><b><i class="ri-check-line"></i></b></div>
            </section>
        </section>
    }
</div>

@code {
    private decimal? saldo;
    private DateTime? ultimaConsulta;
    private bool consultando;
    private bool consultandoSolicitudes;
    private bool sincronizandoPendientes;
    private bool consultandoUuid;
    private bool puedeVerHerramientas;
    private string? error;
    private string? errorSolicitudes;
    private string? errorUuid;
    private string? mensajePendientes;
    private string filtroTexto = string.Empty;
    private string filtroEstado = string.Empty;
    private string uuidConsultaDirecta = string.Empty;
    private IReadOnlyList<BesCertificateRequestDto>? solicitudesRemotas;
    private BesCertificateRequestDto? solicitudUuid;
    private Emisor? emisorMaestro;

    private string NombreEmisorMaestro => emisorMaestro is null
        ? "No configurado"
        : !string.IsNullOrWhiteSpace(emisorMaestro.RazonSocial)
            ? emisorMaestro.RazonSocial
            : emisorMaestro.NomComercial ?? "Emisor maestro";

    private string RucEmisorMaestro => string.IsNullOrWhiteSpace(emisorMaestro?.Ruc)
        ? "No configurado"
        : emisorMaestro.Ruc;

    private string BaseUrlPruebas => Configuration["UanatacaApi:BaseUrl"] ?? "No configurada";
    private string CertificateRequestsEndpoint => $"{BaseUrlPruebas.TrimEnd('/')}{Configuration["UanatacaApi:CertificateRequestsPath"]}";
    private string GetUuidEndpoint() => $"{CertificateRequestsEndpoint}?uuid={Uri.EscapeDataString(uuidConsultaDirecta.Trim())}";

    private static string GetEstadoUanatacaLabel(string? estado)
    {
        return (estado ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            "ENROLLREADY" => "Por configurar",
            "ENROLLED" or "CONFIGURED" or "ACTIVE" => "Configurada",
            "ISSUED" or "CERTIFICATE_ISSUED" => "Emitida",
            "READY" => "Lista",
            "" => "Sin estado",
            _ => estado!.Trim()
        };
    }

    private static string GetEstadoUanatacaClase(string? estado) =>
        GetEstadoUanatacaLabel(estado) switch
        {
            "Por configurar" => "is-pending",
            "Configurada" or "Emitida" or "Lista" => "is-ready",
            "Sin estado" => "is-empty",
            _ => "is-progress"
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idUsuarioClaim = user.FindFirst("IdUsuario")?.Value;
        puedeVerHerramientas = user.Identity?.IsAuthenticated == true
            && int.TryParse(idUsuarioClaim, out var idUsuario)
            && idUsuario == 1;
        emisorMaestro = await EmisorSistemaService.GetEmisorSistemaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && UanatacaApiService.IsConfigured)
        {
            await ConsultarSaldoAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConsultarSaldoAsync()
    {
        if (consultando || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        consultando = true;
        error = null;

        try
        {
            saldo = await UanatacaApiService.ObtenerSaldoAsync();
            ultimaConsulta = DateTime.Now;

            if (saldo is null)
            {
                error = "Uanataca no devolvió un saldo válido.";
            }
        }
        catch (Exception ex)
        {
            error = ex is OperationCanceledException
                ? "La consulta a Uanataca excedió el tiempo de espera de 20 segundos. Verifica la conectividad del servidor publicado."
                : ex.Message;
        }
        finally
        {
            consultando = false;
        }
    }

    private async Task ConsultarSolicitudesAsync()
    {
        if (!puedeVerHerramientas || consultandoSolicitudes || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        consultandoSolicitudes = true;
        errorSolicitudes = null;

        try
        {
            solicitudesRemotas = await UanatacaApiService.BuscarSolicitudesAsync(
                string.IsNullOrWhiteSpace(filtroTexto) ? null : filtroTexto.Trim(),
                string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado);
        }
        catch (Exception ex)
        {
            solicitudesRemotas = null;
            errorSolicitudes = ex.Message;
        }
        finally
        {
            consultandoSolicitudes = false;
        }
    }

    private async Task ConsultarSolicitudPorUuidAsync()
    {
        if (!puedeVerHerramientas || consultandoUuid || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        var uuid = uuidConsultaDirecta.Trim();
        if (!Guid.TryParse(uuid, out _))
        {
            solicitudUuid = null;
            errorUuid = "Ingresa un UUID válido de Uanataca.";
            return;
        }

        consultandoUuid = true;
        errorUuid = null;
        solicitudUuid = null;

        try
        {
            solicitudUuid = (await UanatacaApiService.BuscarSolicitudesAsync(uuid: uuid)).FirstOrDefault();
            if (solicitudUuid is null)
            {
                errorUuid = "Uanataca no devolvió una solicitud para ese UUID.";
            }
        }
        catch (Exception ex)
        {
            errorUuid = ex.Message;
        }
        finally
        {
            consultandoUuid = false;
        }
    }

    private void PrepararConsultaDirecta(string? uuid)
    {
        uuidConsultaDirecta = uuid?.Trim() ?? string.Empty;
        solicitudUuid = null;
        errorUuid = null;
    }

    private async Task PrepararYConsultarSolicitudAsync(string? uuid)
    {
        PrepararConsultaDirecta(uuid);
        await ConsultarSolicitudPorUuidAsync();
    }

    private async Task CopiarUuidAsync(string? uuid)
    {
        if (string.IsNullOrWhiteSpace(uuid))
        {
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", uuid.Trim());
    }

    private async Task ActualizarPendientesAsync()
    {
        if (!puedeVerHerramientas || sincronizandoPendientes || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        sincronizandoPendientes = true;
        mensajePendientes = null;
        try
        {
            var lote = await SolicitudService.SincronizarSolicitudesUanatacaPendientesAsync();
            mensajePendientes = $"Consultadas: {lote.Consulted}. Aprobadas: {lote.Approved}. Pendientes: {lote.NotApproved}. Omitidas por estar aprobadas: {lote.SkippedApproved}. Errores: {lote.UanatacaErrors}.";
        }
        catch (Exception ex)
        {
            mensajePendientes = $"No fue posible actualizar los estados: {ex.Message}";
        }
        finally
        {
            sincronizandoPendientes = false;
        }
    }
}
