@page "/backoffice/uanacreditos"
@using Microsoft.AspNetCore.Authorization
@using Simetric.Models
@using Simetric.DTOs.ESign
@using Simetric.Services
@using Simetric.Services.ESign
@attribute [Authorize]
@inject UanatacaApiService UanatacaApiService
@inject SolicitudService SolicitudService
@inject EmisorSistemaService EmisorSistemaService
@inject IConfiguration Configuration

<PageTitle>Uanacréditos | BackOffice</PageTitle>

<div class="uanacredits-page animate__animated animate__fadeIn">
    <header class="uanacredits-header">
        <div>
            <span>Uanataca</span>
            <h2>Saldo de Uanacréditos</h2>
            <p>Consulta el saldo disponible para procesar solicitudes de firma electrónica.</p>
        </div>
        <button type="button" @onclick="ConsultarSaldoAsync" disabled="@consultando">
            <i class="ri-refresh-line @(consultando ? "is-spinning" : string.Empty)"></i>
            @(consultando ? "Consultando..." : "Actualizar saldo")
        </button>
        <button type="button" @onclick="ActualizarPendientesAsync" disabled="@(sincronizandoPendientes || !UanatacaApiService.IsConfigured)">
            <i class="ri-refresh-line @(sincronizandoPendientes ? "is-spinning" : string.Empty)"></i>
            @(sincronizandoPendientes ? "Actualizando solicitudes..." : "Actualizar estados pendientes")
        </button>
        <button type="button" class="uanacredits-header-button is-secondary" @onclick="ConsultarProductosAsync" disabled="@(consultandoProductos || !UanatacaApiService.IsConfigured)">
            <i class="ri-search-line @(consultandoProductos ? "is-spinning" : string.Empty)"></i>
            @(consultandoProductos ? "Consultando productos..." : "Probar productos")
        </button>
        <button type="button" class="uanacredits-header-button is-secondary" @onclick="ConsultarProductosStakeholderAsync" disabled="@(consultandoProductosStakeholder || !UanatacaApiService.IsConfigured)">
            <i class="ri-user-search-line @(consultandoProductosStakeholder ? "is-spinning" : string.Empty)"></i>
            @(consultandoProductosStakeholder ? "Consultando asignados..." : "Probar productos asignados")
        </button>
    </header>

    <section class="uanacredits-context-grid">
        <article class="uanacredits-context-card">
            <i class="ri-building-4-line"></i>
            <div>
                <span>Emisor maestro</span>
                <strong>@NombreEmisorMaestro</strong>
                <small>RUC: @RucEmisorMaestro</small>
            </div>
        </article>
        <article class="uanacredits-context-card is-test">
            <i class="ri-flask-line"></i>
            <div>
                <span>Entorno activo</span>
                <strong>Pruebas Uanataca</strong>
                <small>@BaseUrlPruebas</small>
            </div>
        </article>
        <article class="uanacredits-context-card">
            <i class="ri-shield-user-line"></i>
            <div>
                <span>Identidad de consulta</span>
                <strong>Stakeholder del JWT</strong>
                <small>El endpoint de saldo no solicita RUC.</small>
            </div>
        </article>
    </section>

    @if (!UanatacaApiService.IsConfigured)
    {
        <section class="uanacredits-alert">
            <i class="ri-settings-3-line"></i>
            <div>
                <strong>Integración pendiente de configuración</strong>
                <p>Configura la URL y las credenciales de Uanataca para consultar el saldo.</p>
            </div>
        </section>
    }
    else if (consultando && saldo is null)
    {
        <section class="uanacredits-state">
            <span class="spinner-border text-primary" role="status"></span>
            <p>Consultando el saldo disponible...</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="uanacredits-alert is-error">
            <i class="ri-error-warning-line"></i>
            <div>
                <strong>No fue posible consultar Uanacréditos</strong>
                <p>@error</p>
            </div>
        </section>
    }
    else if (saldo is decimal saldoDisponible)
    {
        <section class="uanacredits-balance-grid">
            <article class="uanacredits-card">
                <div class="uanacredits-icon"><i class="ri-coins-line"></i></div>
                <div>
                    <span>Saldo disponible</span>
                    <strong>@saldoDisponible.ToString("N2")</strong>
                    <small>Uanacréditos</small>
                </div>
                @if (ultimaConsulta is DateTime fecha)
                {
                    <time>Actualizado: @fecha.ToString("dd/MM/yyyy HH:mm")</time>
                }
            </article>

            <article class="uanacredits-chart" style="@GraficoStyle">
                <div class="uanacredits-chart-head">
                    <div>
                        <span>Lectura visual</span>
                        <strong>Saldo actual</strong>
                    </div>
                    <i class="ri-bar-chart-box-line"></i>
                </div>
                <div class="uanacredits-chart-track" role="img" aria-label="@GraficoAriaLabel">
                    <span></span>
                </div>
                <div class="uanacredits-chart-scale">
                    <small>0</small>
                    <b>@saldoDisponible.ToString("N2")</b>
                    <small>@EscalaGrafico.ToString("N0")</small>
                </div>
                <p>Escala dinámica de referencia; no representa un cupo máximo asignado.</p>
            </article>
        </section>

        <section class="uanacredits-endpoints">
            <div>
                <span>Endpoint de pruebas</span>
                <strong>@BalanceEndpoint</strong>
            </div>
            <small>Autenticación Bearer JWT · sin parámetros adicionales</small>
        </section>
    }

    @if (UanatacaApiService.IsConfigured && (productosDisponibles is not null || productosStakeholder is not null || !string.IsNullOrWhiteSpace(errorProductos) || !string.IsNullOrWhiteSpace(errorProductosStakeholder)))
    {
        <section class="uanacredits-endpoints uanacredits-products-panel">
            <div>
                <span>Prueba de catálogos Uanataca</span>
                <strong>Productos y productos asignados al stakeholder</strong>
                <small>Estas consultas usan el mismo JWT y las URLs de prueba configuradas.</small>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorProductos))
            {
                <p class="text-danger mb-2">Productos: @errorProductos</p>
            }
            @if (!string.IsNullOrWhiteSpace(errorProductosStakeholder))
            {
                <p class="text-danger mb-2">Productos asignados: @errorProductosStakeholder</p>
            }

            @if (productosDisponibles is not null)
            {
                <h6 class="mt-3">Catálogo general (@productosDisponibles.Count)</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Producto UUID</th><th>Código</th><th>Nombre</th><th>Precio</th><th>Activo</th></tr></thead>
                        <tbody>
                            @foreach (var producto in productosDisponibles)
                            {
                                <tr>
                                    <td class="text-break">@producto.Uuid</td>
                                    <td>@producto.Code</td>
                                    <td>@producto.Name</td>
                                    <td>@producto.Price.ToString("N2")</td>
                                    <td>@(producto.Active ? "Sí" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (productosStakeholder is not null)
            {
                <h6 class="mt-3">Productos asignados al stakeholder (@productosStakeholder.Count)</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Relación UUID</th><th>Product UUID</th><th>Stakeholder UUID</th><th>Precio</th><th>Activo</th></tr></thead>
                        <tbody>
                            @foreach (var producto in productosStakeholder)
                            {
                                <tr>
                                    <td class="text-break">@producto.Uuid</td>
                                    <td class="text-break">@producto.ProductUuid</td>
                                    <td class="text-break">@producto.StakeholderUuid</td>
                                    <td>@producto.Price.ToString("N2")</td>
                                    <td>@(producto.Active ? "Sí" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (UanatacaApiService.IsConfigured)
    {
        @if (!string.IsNullOrWhiteSpace(mensajePendientes))
        {
            <section class="uanacredits-endpoints"><strong>@mensajePendientes</strong></section>
        }
        <section class="uanacredits-endpoints">
            <div>
                <span>Solicitudes enviadas a Uanataca</span>
                <strong>GET @CertificateRequestsEndpoint</strong>
            </div>
            <div class="d-flex gap-2 flex-wrap mt-3">
                <input class="form-control" style="max-width:280px" placeholder="UUID, identificación o correo" @bind="filtroTexto" />
                <select class="form-select" style="max-width:220px" @bind="filtroEstado">
                    <option value="">Todos los estados</option>
                    <option value="NEW">Nuevas</option>
                    <option value="IN_VALIDATION">En validación</option>
                    <option value="APPROVED">Aprobadas</option>
                    <option value="REJECTED">Rechazadas</option>
                    <option value="CANCELED">Canceladas</option>
                </select>
                <button type="button" class="btn btn-primary" @onclick="ConsultarSolicitudesAsync" disabled="@consultandoSolicitudes">
                    @(consultandoSolicitudes ? "Consultando..." : "Consultar solicitudes")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(errorSolicitudes))
            {
                <p class="text-danger mt-2">@errorSolicitudes</p>
            }
            @if (solicitudesRemotas is not null)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>UUID</th><th>Identificación</th><th>Estado</th><th>Fecha</th></tr></thead>
                        <tbody>
                            @foreach (var solicitud in solicitudesRemotas)
                            {
                                <tr>
                                    <td>@(solicitud.Uuid ?? "Sin UUID")</td>
                                    <td>@(solicitud.Identification ?? "-")</td>
                                    <td>@(solicitud.UanatacaStatus ?? solicitud.Status ?? "-")</td>
                                    <td>@(solicitud.RequestDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private decimal? saldo;
    private DateTime? ultimaConsulta;
    private bool consultando;
    private bool consultandoSolicitudes;
    private bool sincronizandoPendientes;
    private bool consultandoProductos;
    private bool consultandoProductosStakeholder;
    private string? error;
    private string? errorSolicitudes;
    private string? errorProductos;
    private string? errorProductosStakeholder;
    private string? mensajePendientes;
    private string filtroTexto = string.Empty;
    private string filtroEstado = string.Empty;
    private IReadOnlyList<BesCertificateRequestDto>? solicitudesRemotas;
    private IReadOnlyList<BesProductoDto>? productosDisponibles;
    private IReadOnlyList<BesStakeholderProductDto>? productosStakeholder;
    private Emisor? emisorMaestro;

    private string NombreEmisorMaestro => emisorMaestro is null
        ? "No configurado"
        : !string.IsNullOrWhiteSpace(emisorMaestro.RazonSocial)
            ? emisorMaestro.RazonSocial
            : emisorMaestro.NomComercial ?? "Emisor maestro";

    private string RucEmisorMaestro => string.IsNullOrWhiteSpace(emisorMaestro?.Ruc)
        ? "No configurado"
        : emisorMaestro.Ruc;

    private string BaseUrlPruebas => Configuration["UanatacaApi:BaseUrl"] ?? "No configurada";
    private string BalanceEndpoint => $"{BaseUrlPruebas.TrimEnd('/')}{Configuration["UanatacaApi:BalancePath"]}";
    private string CertificateRequestsEndpoint => $"{BaseUrlPruebas.TrimEnd('/')}{Configuration["UanatacaApi:CertificateRequestsPath"]}";
    private decimal EscalaGrafico => saldo is > 0m
        ? Math.Max(1000m, Math.Ceiling(saldo.Value / 1000m) * 1000m)
        : 1000m;
    private decimal PorcentajeGrafico => saldo is > 0m
        ? Math.Min(100m, saldo.Value / EscalaGrafico * 100m)
        : 0m;
    private string GraficoStyle => $"--uanacredits-progress:{PorcentajeGrafico.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
    private string GraficoAriaLabel => $"Saldo actual de {saldo.GetValueOrDefault():N2} Uanacréditos sobre una escala visual de {EscalaGrafico:N0}.";

    protected override async Task OnInitializedAsync()
    {
        emisorMaestro = await EmisorSistemaService.GetEmisorSistemaAsync();

        if (UanatacaApiService.IsConfigured)
        {
            await ConsultarSaldoAsync();
        }
    }

    private async Task ConsultarSaldoAsync()
    {
        if (consultando || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        consultando = true;
        error = null;

        try
        {
            saldo = await UanatacaApiService.ObtenerSaldoAsync();
            ultimaConsulta = DateTime.Now;

            if (saldo is null)
            {
                error = "Uanataca no devolvió un saldo válido.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            consultando = false;
        }
    }

    private async Task ConsultarSolicitudesAsync()
    {
        if (consultandoSolicitudes || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        consultandoSolicitudes = true;
        errorSolicitudes = null;

        try
        {
            solicitudesRemotas = await UanatacaApiService.BuscarSolicitudesAsync(
                string.IsNullOrWhiteSpace(filtroTexto) ? null : filtroTexto.Trim(),
                string.IsNullOrWhiteSpace(filtroEstado) ? null : filtroEstado);
        }
        catch (Exception ex)
        {
            solicitudesRemotas = null;
            errorSolicitudes = ex.Message;
        }
        finally
        {
            consultandoSolicitudes = false;
        }
    }

    private async Task ConsultarProductosAsync()
    {
        if (consultandoProductos || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        consultandoProductos = true;
        errorProductos = null;
        try
        {
            productosDisponibles = await UanatacaApiService.ObtenerProductosAsync();
        }
        catch (Exception ex)
        {
            productosDisponibles = null;
            errorProductos = ex.Message;
        }
        finally
        {
            consultandoProductos = false;
        }
    }

    private async Task ConsultarProductosStakeholderAsync()
    {
        if (consultandoProductosStakeholder || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        consultandoProductosStakeholder = true;
        errorProductosStakeholder = null;
        try
        {
            productosStakeholder = await UanatacaApiService.ObtenerProductosStakeholderAsync();
        }
        catch (Exception ex)
        {
            productosStakeholder = null;
            errorProductosStakeholder = ex.Message;
        }
        finally
        {
            consultandoProductosStakeholder = false;
        }
    }

    private async Task ActualizarPendientesAsync()
    {
        if (sincronizandoPendientes || !UanatacaApiService.IsConfigured)
        {
            return;
        }

        sincronizandoPendientes = true;
        mensajePendientes = null;
        try
        {
            var lote = await SolicitudService.SincronizarSolicitudesUanatacaPendientesAsync();
            mensajePendientes = $"Consultadas: {lote.Consulted}. Aprobadas: {lote.Approved}. Pendientes: {lote.NotApproved}. Omitidas por estar aprobadas: {lote.SkippedApproved}. Errores: {lote.UanatacaErrors}.";
        }
        catch (Exception ex)
        {
            mensajePendientes = $"No fue posible actualizar los estados: {ex.Message}";
        }
        finally
        {
            sincronizandoPendientes = false;
        }
    }
}
