@page "/backoffice/mis-liquidaciones-compra"
@attribute [Authorize(Roles = "7,2")]
@layout Simetric.Components.Layout.BackOfficeLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.DTOs
@using Simetric.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject EmisorSistemaService EmisorSistemaService
@inject LiquidacionCompraService LiquidacionCompraService

<PageTitle>Liquidaciones de compra | BackOffice</PageTitle>

<div class="container-fluid py-3">
    <div class="mb-4"><span class="text-primary fw-bold small">EMISOR MAESTRO</span><h2 class="mb-1">Mis liquidaciones de compra</h2><p class="text-muted mb-0">Liquidaciones emitidas desde Backoffice.</p></div>
    <div class="card border-0 shadow-sm"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Fecha</th><th>Número</th><th>Proveedor</th><th>Total</th><th>Estado</th></tr></thead><tbody>
    @if (liquidaciones.Count == 0) { <tr><td colspan="5" class="text-center text-muted">No hay liquidaciones emitidas.</td></tr> }
    @foreach (var item in liquidaciones) { <tr @key="item.CodFactura"><td>@(item.FechaEmision?.ToString("dd/MM/yyyy") ?? "-")</td><td>@item.NumeroDocumento</td><td>@item.Proveedor</td><td>$ @item.ImporteTotal.ToString("N2")</td><td>@item.EstadoSri</td></tr> }
    </tbody></table></div></div></div>
</div>

@code {
    private List<LiquidacionCompraListDto> liquidaciones = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var actorId) || !await EmisorSistemaService.TieneAccesoBackOfficeAsync(actorId)) return;
        var emisor = await EmisorSistemaService.GetEmisorSistemaAsync();
        if (emisor?.IdUsuario is > 0)
            liquidaciones = await LiquidacionCompraService.ListarLiquidacionesUsuarioAsync(emisor.IdUsuario.Value, EmisorSistemaService.CodigoEmisorBackOffice);
    }
}
