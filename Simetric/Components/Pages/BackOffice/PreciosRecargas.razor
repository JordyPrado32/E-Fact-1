@page "/backoffice/precios-recargas"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Simetric.Data
@using Simetric.Models
@using Simetric.Services
@using System.Globalization
@using System.Security.Claims
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject SweetAlertService AlertService
@inject VendedorBackOfficeService VendedorBackOfficeService

<PageTitle>Precios y planes | BackOffice</PageTitle>

<div class="seller-pricing-page animate__animated animate__fadeIn">
    @if (cargando)
    {
        <section class="pricing-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Cargando precios vigentes...</p>
        </section>
    }
    else if (!tieneAcceso)
    {
        <section class="pricing-state">
            <i class="ri-lock-2-line"></i>
            <h2>Acceso exclusivo para vendedores</h2>
            <p>Esta página está disponible para los perfiles comerciales de BackOffice.</p>
        </section>
    }
    else
    {
        <header class="pricing-hero">
            <div class="pricing-hero-copy">
                <span class="pricing-kicker">Guía comercial e-fact</span>
                <h1>Precios y planes de recarga</h1>
                <p>Consulta los valores vigentes y prepara una cotización rápida para cada comprador.</p>
                <div class="hero-benefits">
                    <span><i class="ri-shield-check-line"></i><span><strong>Precios actualizados</strong><small>y vigentes</small></span></span>
                    <span><i class="ri-flashlight-line"></i><span><strong>Planes flexibles</strong><small>para cada negocio</small></span></span>
                    <span><i class="ri-customer-service-2-line"></i><span><strong>Soporte incluido</strong><small>en todos los planes</small></span></span>
                </div>
            </div>
            <div class="hero-illustration" aria-hidden="true">
                <span class="hero-document"><i class="ri-file-list-3-line"></i><b>$</b></span>
                <span class="hero-spark"><i class="ri-arrow-up-line"></i></span>
            </div>
            <div class="pricing-minimum">
                <div class="minimum-icon"><i class="ri-coins-line"></i></div>
                <div>
                    <span>Recarga mínima sugerida</span>
                    <strong>$@EFactDocumentPricing.MontoMinimoPersonalizado.ToString("N2", Cultura)</strong>
                    <small>Total con IVA · @EFactDocumentPricing.DocumentosMinimosPersonalizados documentos</small>
                </div>
            </div>
        </header>

        <div class="plans-catalog">
        <section class="pricing-section efact-section">
            <div class="section-heading">
                <div>
                    <span class="pricing-kicker">Planes disponibles</span>
                    <h2>Opciones para ofrecer</h2>
                </div>
                <span class="current-chip">Precios vigentes</span>
            </div>

            <div class="plans-grid">
                @foreach (var plan in PlanesVisibles)
                {
                    <article class="plan-card theme-@plan.ColorClase @(plan.EsRecomendado ? "is-featured" : string.Empty)">
                        @if (plan.EsRecomendado)
                        {
                            <span class="recommended-badge"><i class="ri-star-fill"></i> Más elegido</span>
                        }
                        <div class="plan-icon"><i class="bi @plan.Icono"></i></div>
                        <span class="plan-eyebrow">@(plan.CantidadDocs < 0 ? "Cobertura anual" : "Paquete de documentos")</span>
                        <h3>@plan.Nombre</h3>
                        <div class="plan-price">
                            <sup>$</sup><strong>@plan.Precio.ToString("N2", Cultura)</strong>
                            <small>IVA incluido</small>
                        </div>
                        <p>@plan.Descripcion</p>
                        <div class="plan-detail"><i class="ri-check-line"></i><span>@ObtenerDetallePlan(plan)</span></div>
                    </article>
                }
            </div>
        </section>

        <section class="pricing-section esign-section">
            <div class="section-heading">
                <div>
                    <span class="pricing-kicker">Firma electrónica</span>
                    <h2>Planes E-RÚBRICA</h2>
                    <p class="section-description">Certificados digitales para cada etapa de tu negocio.</p>
                </div>
                <span class="current-chip esign-chip"><i class="ri-quill-pen-line"></i> Precios con IVA</span>
            </div>

            <div class="esign-plans-grid">
                @foreach (var plan in PlanesERubrica)
                {
                    <article class="esign-plan-card @(plan.EsRecomendado ? "is-featured" : string.Empty)">
                        @if (plan.EsRecomendado)
                        {
                            <span class="recommended-badge"><i class="ri-star-fill"></i> Recomendado</span>
                        }
                        <div class="esign-plan-icon"><i class="ri-quill-pen-line"></i></div>
                        <span class="plan-eyebrow">Certificado digital</span>
                        <h3>@plan.Nombre</h3>
                        <div class="plan-price esign-price-final">
                            <sup>$</sup><strong>@ESignPricing.ObtenerPrecioFinal(plan.Vigencia).ToString("N2", Cultura)</strong>
                            <small>con IVA</small>
                        </div>
                        <div class="esign-price-base">$@ESignPricing.ObtenerPrecioBase(plan.Vigencia).ToString("N2", Cultura) sin IVA</div>
                        <div class="plan-detail"><i class="ri-check-line"></i><span>Emisión y soporte incluidos</span></div>
                    </article>
                }
            </div>
        </section>
        </div>

        <div class="pricing-workspace">
            <section class="pricing-section calculator-card">
                <div class="section-heading compact">
                    <div>
                        <span class="pricing-kicker">Cotizador</span>
                        <h2>Calcula una recarga</h2>
                    </div>
                </div>

                <div class="quote-mode-switch" aria-label="Modo de cotización">
                    <button type="button" class="@(!cotizarPorMonto ? "is-active" : string.Empty)" @onclick="() => cotizarPorMonto = false">
                        <i class="ri-file-list-3-line"></i> Por documentos
                    </button>
                    <button type="button" class="@(cotizarPorMonto ? "is-active" : string.Empty)" @onclick="() => cotizarPorMonto = true">
                        <i class="ri-money-dollar-circle-line"></i> Por monto
                    </button>
                </div>

                @if (cotizarPorMonto)
                {
                    <label class="quantity-field">
                        <span>Monto de la recarga</span>
                        <div class="quantity-input-wrap money-input">
                            <span>$</span>
                            <input type="number"
                                   min="@MontoMinimoCotizador"
                                   max="@EFactDocumentPricing.MontoMaximoPersonalizado"
                                   step="0.01"
                                   @bind="montoRecarga"
                                   @bind:event="oninput" />
                            <span>USD</span>
                        </div>
                        <small>Mayor a $@EFactDocumentPricing.MontoMinimoPersonalizado.ToString("N2", Cultura) y hasta $@EFactDocumentPricing.MontoMaximoPersonalizado.ToString("N2", Cultura).</small>
                    </label>
                }
                else
                {
                    <label class="quantity-field">
                        <span>Cantidad de documentos</span>
                        <div class="quantity-input-wrap">
                            <input type="number"
                                   min="@EFactDocumentPricing.DocumentosMinimosPersonalizados"
                                   max="@MaxDocumentosRecarga"
                                   @bind="cantidadDocumentos"
                                   @bind:event="oninput" />
                            <span>docs.</span>
                        </div>
                        <small>Entre @EFactDocumentPricing.DocumentosMinimosPersonalizados y @MaxDocumentosRecarga documentos.</small>
                    </label>
                }

                @if (CantidadValida)
                {
                    <div class="quote-result">
                        <div>
                            <span>Documentos</span>
                            <strong>@DocumentosCotizados.ToString("N0", Cultura)</strong>
                        </div>
                        <div>
                            <span>Pagas por cada documento</span>
                            <strong>@FormatearPrecioEnCentavos(PrecioUnitario)</strong>
                            <small>Equivale a $@PrecioUnitario.ToString("N4", Cultura) c/u · IVA incluido</small>
                        </div>
                        <div>
                            <span>Subtotal</span>
                            <strong>$@Subtotal.ToString("N2", Cultura)</strong>
                        </div>
                        <div>
                            <span>IVA</span>
                            <strong>$@Iva.ToString("N2", Cultura)</strong>
                        </div>
                        <div class="quote-total">
                            <span>Total a pagar</span>
                            <strong>$@TotalCotizacion.ToString("N2", Cultura)</strong>
                        </div>
                    </div>

                    <button type="button" class="copy-quote-btn" @onclick="CopiarCotizacionAsync">
                        <i class="ri-file-copy-line"></i>
                        Copiar cotización
                    </button>
                }
                else
                {
                    <div class="quote-warning">
                        Ingresa una cantidad válida dentro del rango permitido.
                    </div>
                }
            </section>

            <section class="pricing-section tiers-card">
                <div class="section-heading compact">
                    <div>
                        <span class="pricing-kicker">Recarga personalizada</span>
                        <h2>Tarifa según cantidad</h2>
                    </div>
                </div>

                <div class="tiers-table-wrap">
                    <table class="tiers-table">
                        <thead>
                            <tr>
                                <th>Rango de documentos</th>
                                <th>Pagas por cada documento</th>
                                <th>Total de ejemplo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tier in Tarifas)
                            {
                                <tr>
                                    <td><strong>@tier.Rango</strong><small>@tier.Detalle</small></td>
                                    <td>
                                        <strong>@((tier.Precio * 100m).ToString("0.##", Cultura)) centavos</strong>
                                        <small>Equivale a $@tier.Precio.ToString("N4", Cultura) c/u · IVA incluido</small>
                                    </td>
                                    <td>@tier.Ejemplo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pricing-note">
                    <i class="ri-information-line"></i>
                    <span>Los totales cercanos hasta 10 centavos a un dólar entero se muestran redondeados, sin cambiar la tarifa base.</span>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-EC");
    private static readonly IReadOnlyList<EFactPlanDto> PlanesVisibles = EFactBillingConfig.EFactPlans
        .Where(plan => plan.CantidadDocs != 0)
        .ToList();
    private static readonly IReadOnlyList<TarifaComercial> Tarifas =
    [
        new("De 1 a 25 documentos", "Tarifa inicial", EFactDocumentPricing.PrecioTierHasta25, "$0,46 – $11,50"),
        new("De 26 a 48 documentos", "Segundo tramo", EFactDocumentPricing.PrecioTierHasta48, "$9,57 – $17,66"),
        new("De 49 a 120 documentos", "Tercer tramo", EFactDocumentPricing.PrecioTierHasta120, "$12,96 – $31,74"),
        new("De 121 a 240 documentos", "Cuarto tramo", EFactDocumentPricing.PrecioTierHasta240, "$22,26 – $44,16"),
        new("De 241 a 600 documentos", "Quinto tramo", EFactDocumentPricing.PrecioTierHasta600, "$27,72 – $69,00"),
        new("Más de 600 documentos", "Recarga de alto volumen", EFactDocumentPricing.PrecioRecargaAlta, "Ej.: 1.000 docs = $60,00")
    ];
    private static readonly IReadOnlyList<PlanERubrica> PlanesERubrica =
    [
        new("7 días", "7 DIAS", false),
        new("30 días", "30 DIAS", false),
        new("1 año", "1 ANIO", true),
        new("2 años", "2 ANIOS", false),
        new("3 años", "3 ANIOS", false),
        new("4 años", "4 ANIOS", false),
        new("5 años", "5 ANIOS", false)
    ];

    private bool cargando = true;
    private bool tieneAcceso;
    private bool cotizarPorMonto;
    private int cantidadDocumentos = EFactDocumentPricing.DocumentosMinimosPersonalizados;
    private decimal montoRecarga = EFactDocumentPricing.MontoMinimoPersonalizado + 0.01m;
    private static decimal MontoMinimoCotizador => EFactDocumentPricing.MontoMinimoPersonalizado + 0.01m;
    private static int MaxDocumentosRecarga => decimal.ToInt32(decimal.Floor(
        EFactDocumentPricing.MontoMaximoPersonalizado / EFactDocumentPricing.PrecioRecargaAlta));
    private bool CantidadValida => cotizarPorMonto
        ? montoRecarga >= MontoMinimoCotizador &&
          montoRecarga <= EFactDocumentPricing.MontoMaximoPersonalizado
        : cantidadDocumentos >= EFactDocumentPricing.DocumentosMinimosPersonalizados &&
          cantidadDocumentos <= MaxDocumentosRecarga;
    private int DocumentosCotizados => cotizarPorMonto && CantidadValida
        ? EFactDocumentPricing.CalcularDocumentosPorMonto(montoRecarga, PrecioUnitario)
        : cantidadDocumentos;
    private decimal TotalCotizacion => CantidadValida
        ? cotizarPorMonto
            ? montoRecarga
            : EFactDocumentPricing.CalcularTotalPorCantidad(cantidadDocumentos)
        : 0m;
    private decimal PrecioUnitario => CantidadValida
        ? cotizarPorMonto
            ? EFactDocumentPricing.ObtenerPrecioPorDocumentoSegunMonto(montoRecarga)
            : EFactDocumentPricing.ObtenerPrecioPorDocumentoSegunCantidad(cantidadDocumentos)
        : 0m;
    private decimal Subtotal => EFactDocumentPricing.CalcularSubtotalDesdeTotal(TotalCotizacion);
    private decimal Iva => EFactDocumentPricing.CalcularIvaDesdeTotal(TotalCotizacion);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                return;

            var idUsuario = int.TryParse(
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("IdUsuario")?.Value,
                out var parsedId)
                ? parsedId
                : 0;

            var role = user.FindFirst("IdTipoUsuario")?.Value ?? user.FindFirst(ClaimTypes.Role)?.Value;
            var tipoCliente = user.FindFirst("TipoCliente")?.Value;

            if (idUsuario > 0)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var usuario = await db.Usuarios
                    .AsNoTracking()
                    .Where(item => item.IdUsuario == idUsuario)
                    .Select(item => new { item.IdTipoUsuario, item.TipoCliente })
                    .FirstOrDefaultAsync();
                role = usuario?.IdTipoUsuario?.ToString() ?? role;
                tipoCliente = usuario?.TipoCliente?.ToString() ?? tipoCliente;
            }

            var esVendedor = string.Equals(role, "7", StringComparison.OrdinalIgnoreCase) &&
                              string.Equals(tipoCliente, "2", StringComparison.OrdinalIgnoreCase);
            var tienePerfilVendedor = idUsuario > 0 && await VendedorBackOfficeService.TienePerfilUsuarioAsync(idUsuario);
            tieneAcceso = esVendedor || tienePerfilVendedor;
        }
        finally
        {
            cargando = false;
        }
    }

    private static string ObtenerDetallePlan(EFactPlanDto plan)
    {
        if (plan.CantidadDocs < 0)
            return "Vigencia de 12 meses";

        var precioUnitario = plan.CantidadDocs > 0 ? plan.Precio / plan.CantidadDocs : 0m;
        return $"{FormatearPrecioEnCentavos(precioUnitario)} por documento · IVA incluido";
    }

    private static string FormatearPrecioEnCentavos(decimal precio) =>
        $"{(precio * 100m).ToString("0.##", Cultura)} centavos";

    private async Task CopiarCotizacionAsync()
    {
        if (!CantidadValida)
            return;

        var texto = $"Cotización Numerica e-fact: {DocumentosCotizados:N0} documentos por ${TotalCotizacion:N2} (IVA incluido).";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto);
        await AlertService.ShowSuccessAsync("La cotización quedó lista para compartir.", "Cotización copiada");
    }

    private sealed record TarifaComercial(string Rango, string Detalle, decimal Precio, string Ejemplo);
    private sealed record PlanERubrica(string Nombre, string Vigencia, bool EsRecomendado);
}
