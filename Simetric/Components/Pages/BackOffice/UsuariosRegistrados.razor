@page "/backoffice/usuarios-registrados"
@namespace Simetric.Components.Pages.BackOffice
@using Microsoft.EntityFrameworkCore
@using Simetric.Data
@using Simetric.Models
@using Simetric.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavManager

<PageTitle>Usuarios registrados - BackOffice | Numerica</PageTitle>

<style>
    .registered-users-shell {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        color: #0f172a;
    }

    .registered-users-hero,
    .registered-users-toolbar,
    .registered-users-table-card {
        border: 1px solid #cbd5e1;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.05);
    }

    .registered-users-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1rem;
        padding: 1.25rem;
        background:
            radial-gradient(circle at top left, rgba(15, 28, 63, 0.12), transparent 32%),
            linear-gradient(145deg, #ffffff, #f6fafe);
    }

    .registered-users-kicker {
        display: inline-flex;
        color: #0f1c3f;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .registered-users-hero h2,
    .registered-users-table-card h3 {
        margin: 0.45rem 0 0;
        color: #0f172a;
        font-weight: 800;
        letter-spacing: 0;
    }

    .registered-users-hero p {
        margin: 0.55rem 0 0;
        max-width: 70ch;
        color: #64748b;
        line-height: 1.6;
    }

    .registered-users-kpis {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .registered-users-kpi {
        padding: 0.85rem 1rem;
        border: 1px solid #e4edf5;
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff, #f8fbff);
    }

    .registered-users-kpi span {
        display: block;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .registered-users-kpi strong {
        display: block;
        margin-top: 0.3rem;
        font-size: 1.55rem;
        line-height: 1;
    }

    .registered-users-toolbar {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: center;
        padding: 1rem 1.25rem;
    }

    .registered-users-search {
        min-height: 44px;
        border: 1px solid #d4e3ef;
        border-radius: 14px;
        padding: 0 1rem;
        width: min(100%, 520px);
    }

    .registered-users-toolbar-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.7rem;
        flex-wrap: wrap;
    }

    .registered-users-filters {
        display: inline-flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .registered-users-filter {
        min-height: 40px;
        padding: 0 0.95rem;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: #64748b;
        font-weight: 700;
    }

    .registered-users-filter.is-active {
        background: #0f1c3f;
        border-color: #0f1c3f;
        color: #ffffff;
    }

    .registered-users-export {
        min-height: 40px;
        padding: 0 1rem;
        border: 1px solid #15803d;
        border-radius: 12px;
        background: #15803d;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 800;
    }

    .registered-users-export:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .registered-users-table-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
    }

    .registered-users-count {
        min-height: 34px;
        padding: 0 0.85rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        background: rgba(15, 28, 63, 0.08);
        color: #0f1c3f;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .registered-users-table-wrap {
        overflow-x: auto;
        border-top: 1px solid #edf3f8;
    }

    .registered-users-table {
        min-width: 920px;
        margin: 0;
    }

    .registered-users-table th {
        background: linear-gradient(180deg, #f7fbff, #eef5fb);
        color: #31526d;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.95rem 1rem;
        white-space: nowrap;
    }

    .registered-users-table td {
        padding: 0.95rem 1rem;
        border-bottom: 1px solid #eef3f7;
        vertical-align: middle;
    }

    .registered-user-main {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .registered-user-main strong {
        color: #0f172a;
    }

    .registered-user-main span,
    .registered-users-muted {
        color: #64748b;
        font-size: 0.84rem;
    }

    .registered-users-pill {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 0 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .registered-users-pill-success {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .registered-users-pill-neutral {
        background: #eef3f7;
        color: #475569;
    }

    .registered-users-pill-danger {
        background: rgba(220, 53, 69, 0.12);
        color: #dc3545;
    }

    .registered-users-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
        background: #ffffff;
    }

    .registered-users-pagination button {
        min-height: 38px;
        padding: 0 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        background: #ffffff;
        color: #475569;
        font-weight: 700;
    }

    .registered-users-pagination button:disabled {
        opacity: 0.5;
    }

    .registered-users-state {
        padding: 3rem 1rem;
        text-align: center;
        color: #64748b;
    }

    @@media (max-width: 820px) {
        .registered-users-hero,
        .registered-users-toolbar,
        .registered-users-table-head,
        .registered-users-pagination {
            grid-template-columns: 1fr;
            flex-direction: column;
            align-items: stretch;
        }

        .registered-users-kpis {
            grid-template-columns: 1fr;
        }

        .registered-users-filters {
            justify-content: flex-start;
        }
    }
</style>

@{
    var usuariosFiltrados = UsuariosFiltrados.ToList();
    var totalPages = Math.Max(1, (int)Math.Ceiling(usuariosFiltrados.Count / (double)PageSize));
    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }
    var usuariosPagina = usuariosFiltrados.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
}

<div class="registered-users-shell animate__animated animate__fadeIn">
    <section class="registered-users-hero">
        <div>
            <span class="registered-users-kicker">BackOffice</span>
            <h2>Usuarios registrados</h2>
            <p>Lista de personas que crearon cuenta en el sistema, incluyendo usuarios que aun no registran compras.</p>
        </div>
        <div class="registered-users-kpis">
            <article class="registered-users-kpi">
                <span>Total registrados</span>
                <strong>@usuarios.Count</strong>
            </article>
            <article class="registered-users-kpi">
                <span>Con compras</span>
                <strong>@usuarios.Count(u => u.Compras > 0)</strong>
            </article>
            <article class="registered-users-kpi">
                <span>Sin compras</span>
                <strong>@usuarios.Count(u => u.Compras == 0)</strong>
            </article>
        </div>
    </section>

    <section class="registered-users-toolbar">
        <input class="registered-users-search"
               placeholder="Buscar por nombre, correo o identificación..."
               @bind="searchText"
               @bind:event="oninput" />
        <div class="registered-users-toolbar-actions">
            <div class="registered-users-filters">
                <button type="button" class="registered-users-filter @(purchaseFilter == PurchaseFilter.All ? "is-active" : "")" @onclick="() => SetFilter(PurchaseFilter.All)">Todos</button>
                <button type="button" class="registered-users-filter @(purchaseFilter == PurchaseFilter.WithPurchases ? "is-active" : "")" @onclick="() => SetFilter(PurchaseFilter.WithPurchases)">Con compras</button>
                <button type="button" class="registered-users-filter @(purchaseFilter == PurchaseFilter.WithoutPurchases ? "is-active" : "")" @onclick="() => SetFilter(PurchaseFilter.WithoutPurchases)">Sin compras</button>
            </div>
            <button type="button"
                    class="registered-users-export"
                    @onclick="IrAReporteUsuariosRegistrados"
                    disabled="@loading">
                <i class="bi bi-bar-chart-line"></i>
                <span>Ver reporte</span>
            </button>
        </div>
    </section>

    <section class="registered-users-table-card">
        <div class="registered-users-table-head">
            <div>
                <span class="registered-users-kicker">Directorio</span>
                <h3>Personas registradas</h3>
            </div>
            <span class="registered-users-count">@usuariosFiltrados.Count encontrados</span>
        </div>

        @if (loading)
        {
            <div class="registered-users-state">Cargando usuarios registrados...</div>
        }
        else if (!usuariosFiltrados.Any())
        {
            <div class="registered-users-state">No hay usuarios con los filtros actuales.</div>
        }
        else
        {
            <div class="registered-users-table-wrap">
                <table class="table registered-users-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Identificación</th>
                            <th>Celular</th>
                            <th>Fecha registro</th>
                            <th>Vendedor</th>
                            <th>Compras</th>
                            <th>Total comprado</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in usuariosPagina)
                        {
                            <tr>
                                <td>
                                    <div class="registered-user-main">
                                        <strong>@usuario.Nombre</strong>
                                        <span>@usuario.Email</span>
                                    </div>
                                </td>
                                <td>@DisplayOrDash(usuario.Identificacion)</td>
                                <td>@DisplayOrDash(usuario.Celular)</td>
                                <td>@(usuario.FechaRegistro?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@DisplayOrDash(usuario.Vendedor)</td>
                                <td>
                                    <span class="registered-users-pill @(usuario.Compras > 0 ? "registered-users-pill-success" : "registered-users-pill-neutral")">
                                        @(usuario.Compras > 0 ? usuario.Compras.ToString() : "Sin compras")
                                    </span>
                                </td>
                                <td>$ @usuario.TotalComprado.ToString("N2")</td>
                                <td>
                                    <span class="registered-users-pill @(usuario.Activo ? "registered-users-pill-success" : "registered-users-pill-danger")">
                                        @(usuario.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="registered-users-pagination">
                <button type="button" disabled="@(currentPage == 1)" @onclick="() => SetPage(currentPage - 1)">Anterior</button>
                <span class="registered-users-muted">Página @currentPage de @totalPages</span>
                <button type="button" disabled="@(currentPage == totalPages)" @onclick="() => SetPage(currentPage + 1)">Siguiente</button>
            </div>
        }
    </section>
</div>

@code {
    private const int PageSize = 20;
    private readonly List<UsuarioRegistradoRow> usuarios = new();
    private string searchText = string.Empty;
    private PurchaseFilter purchaseFilter = PurchaseFilter.All;
    private bool loading = true;
    private int currentPage = 1;

    private IEnumerable<UsuarioRegistradoRow> UsuariosFiltrados
    {
        get
        {
            var query = usuarios.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                query = query.Where(u =>
                    u.Nombre.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (u.Identificacion ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            query = purchaseFilter switch
            {
                PurchaseFilter.WithPurchases => query.Where(u => u.Compras > 0),
                PurchaseFilter.WithoutPurchases => query.Where(u => u.Compras == 0),
                _ => query
            };

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        loading = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var usuariosDb = await context.Usuarios
                .AsNoTracking()
                .Where(u => u.IdTipoUsuario == 1)
                .OrderByDescending(u => u.FechaCreacion)
                .ToListAsync();

            usuariosDb = usuariosDb
                .Where(u => !BackOfficeReportDataFilter.IsTestData(u))
                .ToList();

            var ventas = await context.ReporteVentasBackOffice
                .AsNoTracking()
                .Where(v => v.Estado != "anulada")
                .ToListAsync();

            ventas = ventas
                .Where(v => !BackOfficeReportDataFilter.IsTestData(v))
                .ToList();

            var vendedores = await context.VendedoresBackOffice
                .AsNoTracking()
                .ToDictionaryAsync(v => v.IdVendedor, v => v.Nombre);

            usuarios.Clear();
            usuarios.AddRange(usuariosDb.Select(usuario =>
            {
                var ventasUsuario = ventas.Where(venta => CoincideVenta(usuario, venta.Cliente)).ToList();
                return new UsuarioRegistradoRow
                {
                    IdUsuario = usuario.IdUsuario,
                    Nombre = ObtenerNombreUsuario(usuario),
                    Email = usuario.Email ?? string.Empty,
                    Identificacion = usuario.Identificacion,
                    Celular = usuario.Celular,
                    FechaRegistro = usuario.FechaCreacion,
                    Vendedor = usuario.IdVendedor.HasValue && vendedores.TryGetValue(usuario.IdVendedor.Value, out var vendedor)
                        ? vendedor
                        : null,
                    Compras = ventasUsuario.Count,
                    TotalComprado = ventasUsuario.Sum(v => v.Valor),
                    Activo = usuario.Estado == true && usuario.CuentaBloqueada != true
                };
            }));
        }
        finally
        {
            loading = false;
        }
    }

    private void SetFilter(PurchaseFilter filter)
    {
        purchaseFilter = filter;
        currentPage = 1;
    }

    private void SetPage(int page)
    {
        currentPage = Math.Max(1, page);
    }

    private void IrAReporteUsuariosRegistrados()
    {
        NavManager.NavigateTo("/backoffice/reportes/usuarios-registrados");
    }

    private static string ObtenerNombreUsuario(Usuario usuario)
    {
        var nombre = $"{usuario.Nombres} {usuario.Apellidos}".Trim();
        if (!string.IsNullOrWhiteSpace(nombre))
            return nombre;

        return !string.IsNullOrWhiteSpace(usuario.NombreEmpresa)
            ? usuario.NombreEmpresa
            : $"Usuario #{usuario.IdUsuario}";
    }

    private static bool CoincideVenta(Usuario usuario, string? cliente)
    {
        if (string.IsNullOrWhiteSpace(cliente))
            return false;

        var parts = cliente.Split('|');
        var emailPart = parts.Length > 1 ? parts[1].Trim() : string.Empty;
        var nombrePart = parts[0].Trim();

        return (!string.IsNullOrWhiteSpace(usuario.Email) &&
                (string.Equals(usuario.Email.Trim(), emailPart, StringComparison.OrdinalIgnoreCase) ||
                 cliente.Contains(usuario.Email.Trim(), StringComparison.OrdinalIgnoreCase))) ||
               (!string.IsNullOrWhiteSpace(usuario.Identificacion) &&
                cliente.Contains(usuario.Identificacion.Trim(), StringComparison.OrdinalIgnoreCase)) ||
               (!string.IsNullOrWhiteSpace(nombrePart) &&
                string.Equals(nombrePart, ObtenerNombreUsuario(usuario), StringComparison.OrdinalIgnoreCase));
    }

    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private enum PurchaseFilter
    {
        All,
        WithPurchases,
        WithoutPurchases
    }

    private sealed class UsuarioRegistradoRow
    {
        public int IdUsuario { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Identificacion { get; set; }
        public string? Celular { get; set; }
        public DateTime? FechaRegistro { get; set; }
        public string? Vendedor { get; set; }
        public int Compras { get; set; }
        public decimal TotalComprado { get; set; }
        public bool Activo { get; set; }
    }
}
