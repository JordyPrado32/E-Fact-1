@page "/backoffice/solicitudes-firmas"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Simetric.Services
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Solicitudes de firmas | BackOffice</PageTitle>

@if (puedeVerERubrica)
{
    <AdminSolicitudes RutaDetalleBase="/backoffice/solicitudes-firmas" />
}

@code {
    private bool puedeVerERubrica;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        puedeVerERubrica = BackOfficePermissionHelper.PuedeVerERubrica(
            authState.User.FindFirst(ClaimTypes.Email)?.Value);

        if (!puedeVerERubrica)
        {
            NavManager.NavigateTo(BackOfficeRoutes.Perfil);
        }
    }
}
