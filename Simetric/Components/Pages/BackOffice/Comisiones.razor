@page "/backoffice/comisiones"
@attribute [Authorize(Roles = "7,2")]
@layout Simetric.Components.Layout.BackOfficeLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Simetric.Services
@inject AliadoPortalService AliadoService
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Env

<PageTitle>Comisiones | BackOffice</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div><span class="text-primary fw-bold small">ALIADOS</span><h2 class="mb-1">Todas las comisiones</h2><p class="text-muted mb-0">Consulta el estado y paga las comisiones aprobadas.</p></div>
        <a class="btn btn-outline-primary" href="/backoffice/liquidaciones-comisiones">Liquidaciones pagadas</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="alert @(exito ? "alert-success" : "alert-danger")">@mensaje</div> }

    <section class="card border-0 shadow-sm mb-3"><div class="card-body row g-3 align-items-end">
        <div class="col-md-3"><label class="form-label">Buscar aliado</label><input class="form-control" @bind="busquedaAliado" @bind:event="oninput" /></div>
        <div class="col-md-3"><label class="form-label">Aliado</label><select class="form-select" @bind="filtroAliado"><option value="">Todos los aliados</option>@foreach (var aliado in AliadosVisibles) { <option value="@aliado.IdVendedor">@aliado.Nombre</option> }</select></div>
        <div class="col-md-3"><label class="form-label">Buscar comisión</label><input class="form-control" @bind="busquedaComision" @bind:event="oninput" placeholder="Cliente o factura" /></div>
        <div class="col-md-2"><label class="form-label">Estado</label><select class="form-select" @bind="filtroEstado"><option value="">Todos</option><option>Pendiente</option><option>Generada</option><option>Aprobada</option><option>Pagada</option><option>Anulada</option><option>Revertida</option></select></div>
    </div></section>

    <section class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Pendientes de revisión</small><h3 class="mb-0">@ComisionesVisibles.Count(x => x.Estado is "Generada" or "Pendiente")</h3></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Listas para pago</small><h3 class="mb-0">$ @ComisionesVisibles.Where(x => x.Estado == "Aprobada").Sum(x => x.Valor).ToString("N2")</h3></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Pagadas</small><h3 class="mb-0">$ @ComisionesVisibles.Where(x => x.Estado == "Pagada").Sum(x => x.Valor).ToString("N2")</h3></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Registros visibles</small><h3 class="mb-0">@ComisionesVisibles.Count()</h3></div></div></div>
    </section>

    <section class="card border-0 shadow-sm"><div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
            <div><label class="form-label">Referencia de pago</label><input class="form-control" @bind="referenciaPago" /></div>
            <div><label class="form-label">Observación del pago</label><input class="form-control" @bind="observacionPago" /></div>
            <div><label class="form-label">Comprobante</label><InputFile class="form-control" accept=".pdf,.png,.jpg,.jpeg" OnChange="SeleccionarComprobante" /></div>
            <button class="btn btn-primary" @onclick="PagarSeleccionadasAsync" disabled="@(procesando || !Seleccionadas.Any())">@(procesando ? "Procesando..." : $"Pagar seleccionadas ({Seleccionadas.Count})")</button>
        </div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th></th><th>Cliente</th><th>Aliado</th><th>Factura / período</th><th>Base</th><th>Comisión</th><th>Estado</th><th>Ajuste</th><th></th></tr></thead><tbody>
        @if (!ComisionesVisibles.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-5">No hay comisiones para los filtros seleccionados.</td></tr>
        }
        @foreach (var item in ComisionesVisibles)
        {
            <tr @key="item.IdComision"><td><input type="checkbox" checked="@Seleccionadas.Contains(item.IdComision)" disabled="@(item.Estado != "Aprobada")" @onchange="e => Seleccionar(item.IdComision, e)" /></td><td>@item.Cliente</td><td>@item.Aliado</td><td>#@item.IdFactura<br /><small>@(item.Periodo ?? item.FechaGeneracion.ToString("yyyy-MM"))</small></td><td>$ @item.BaseComisionable.ToString("N2")</td><td>$ @item.Valor.ToString("N2")<br /><small>@item.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%</small></td><td><span class="badge @EstadoCss(item.Estado)">@EstadoTexto(item.Estado)</span></td><td><div class="input-group input-group-sm mb-1"><button class="btn btn-outline-secondary" @onclick="() => AjustarPorcentajeAsync(item, -1m)" disabled="@(procesando || item.Estado == "Pagada")">−</button><input class="form-control" type="number" min="0" max="100" step=".01" value="@(PorcentajeAjuste(item).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" @onchange="e => CambiarPorcentaje(item, e)" /><button class="btn btn-outline-secondary" @onclick="() => AjustarPorcentajeAsync(item, 1m)" disabled="@(procesando || item.Estado == "Pagada")">+</button><button class="btn btn-outline-primary" @onclick="() => AjustarAsync(item)" disabled="@(procesando || item.Estado == "Pagada")">%</button></div><div class="input-group input-group-sm"><span class="input-group-text">$</span><input class="form-control" type="number" min="0" step=".01" value="@(ValorAjuste(item).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" @onchange="e => CambiarValor(item, e)" /><button class="btn btn-outline-primary" @onclick="() => AjustarValorAsync(item)" disabled="@(procesando || item.Estado == "Pagada")">$</button></div></td><td>@if (item.Estado == "Generada") { <button class="btn btn-link btn-sm px-0" @onclick="() => AprobarAsync(item)" disabled="@(procesando)">Aprobar</button> }</td></tr>
        }
        </tbody></table></div>
    </div></section>
</div>

@code {
    private List<AliadoAdminRow> aliados = new();
    private List<AliadoAdminComisionRow> comisiones = new();
    private readonly HashSet<int> Seleccionadas = new();
    private readonly Dictionary<int, decimal> porcentajesAjuste = new();
    private readonly Dictionary<int, decimal> valoresAjuste = new();
    private int filtroAliado;
    private string busquedaAliado = string.Empty;
    private string busquedaComision = string.Empty;
    private string filtroEstado = string.Empty;
    private string? observacionPago;
    private string? referenciaPago;
    private IBrowserFile? comprobante;
    private string? mensaje;
    private bool exito;
    private int actorId;

    private bool procesando;
    private IEnumerable<AliadoAdminComisionRow> ComisionesVisibles => comisiones.Where(x =>
        (filtroAliado == 0 || x.IdVendedor == filtroAliado) &&
        (string.IsNullOrWhiteSpace(busquedaAliado) || x.Aliado.Contains(busquedaAliado, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(filtroEstado) || x.Estado == filtroEstado) &&
        (string.IsNullOrWhiteSpace(busquedaComision) || $"{x.Cliente} {x.IdFactura}".Contains(busquedaComision, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<AliadoAdminRow> AliadosVisibles => string.IsNullOrWhiteSpace(busquedaAliado) ? aliados : aliados.Where(x => x.Nombre.Contains(busquedaAliado, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out actorId);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        aliados = (await AliadoService.ListarAliadosAsync()).ToList();
        comisiones = (await AliadoService.ObtenerComisionesAdministracionAsync(actorId)).ToList();
        foreach (var item in comisiones)
        {
            porcentajesAjuste[item.IdComision] = item.Porcentaje;
            valoresAjuste[item.IdComision] = item.Valor;
        }
    }

    private async Task AjustarAsync(AliadoAdminComisionRow item)
    {
        if (procesando) return;
        procesando = true;
        var resultado = await AliadoService.AjustarComisionAsync(actorId, item.IdComision, PorcentajeAjuste(item), null);
        exito = resultado.Success; mensaje = resultado.Message;
        if (resultado.Success) await CargarAsync();
        procesando = false;
    }

    private async Task AjustarPorcentajeAsync(AliadoAdminComisionRow item, decimal delta)
    {
        if (procesando) return;
        porcentajesAjuste[item.IdComision] = Math.Clamp(PorcentajeAjuste(item) + delta, 0m, 100m);
        await AjustarAsync(item);
    }

    private async Task AjustarValorAsync(AliadoAdminComisionRow item)
    {
        if (procesando) return;
        procesando = true;
        var resultado = await AliadoService.AjustarValorComisionAsync(actorId, item.IdComision, ValorAjuste(item));
        exito = resultado.Success; mensaje = resultado.Message;
        if (resultado.Success) await CargarAsync();
        procesando = false;
    }

    private async Task AprobarAsync(AliadoAdminComisionRow item)
    {
        if (procesando) return;
        procesando = true;
        var resultado = await AliadoService.AprobarComisionAsync(actorId, item.IdComision);
        exito = resultado.Success; mensaje = resultado.Message;
        if (resultado.Success) await CargarAsync();
        procesando = false;
    }

    private void Seleccionar(int id, ChangeEventArgs e) { if (e.Value is true or "true" or "on") Seleccionadas.Add(id); else Seleccionadas.Remove(id); }
    private decimal PorcentajeAjuste(AliadoAdminComisionRow item) => porcentajesAjuste.TryGetValue(item.IdComision, out var valor) ? valor : item.Porcentaje;
    private decimal ValorAjuste(AliadoAdminComisionRow item) => valoresAjuste.TryGetValue(item.IdComision, out var valor) ? valor : item.Valor;
    private void CambiarPorcentaje(AliadoAdminComisionRow item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var valor) && valor is >= 0 and <= 100)
            porcentajesAjuste[item.IdComision] = valor;
    }
    private void CambiarValor(AliadoAdminComisionRow item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var valor) && valor >= 0)
            valoresAjuste[item.IdComision] = valor;
    }
    private void SeleccionarComprobante(InputFileChangeEventArgs e) => comprobante = e.File;

    private static string EstadoTexto(string estado) => estado switch
    {
        "Generada" => "Pendiente de revisión",
        "Aprobada" => "Lista para pago",
        "Pagada" => "Pagada",
        "Anulada" => "Anulada",
        "Revertida" => "Revertida",
        _ => estado
    };

    private static string EstadoCss(string estado) => estado switch
    {
        "Pagada" => "text-bg-success",
        "Aprobada" => "text-bg-primary",
        "Anulada" or "Revertida" => "text-bg-danger",
        _ => "text-bg-warning"
    };

    private async Task PagarSeleccionadasAsync()
    {
        if (procesando || !Seleccionadas.Any()) return;
        procesando = true;
        string? ruta = null;
        try
        {
            if (comprobante is not null)
            {
                if (comprobante.Size > 5 * 1024 * 1024) { exito = false; mensaje = "El comprobante no puede superar 5 MB."; return; }
                var extension = Path.GetExtension(comprobante.Name).ToLowerInvariant();
                if (extension is not ".pdf" and not ".png" and not ".jpg" and not ".jpeg") { exito = false; mensaje = "Formato de comprobante no permitido."; return; }
                var carpeta = Path.Combine(Env.WebRootPath, "uploads", "comisiones");
                Directory.CreateDirectory(carpeta);
                var nombre = $"{Guid.NewGuid():N}{extension}";
                await using var destino = File.Create(Path.Combine(carpeta, nombre));
                await comprobante.OpenReadStream(5 * 1024 * 1024).CopyToAsync(destino);
                ruta = $"/uploads/comisiones/{nombre}";
            }
            var resultado = await AliadoService.LiquidarComisionesAsync(actorId, Seleccionadas.ToArray(), referenciaPago, observacionPago, ruta);
            exito = resultado.Success; mensaje = resultado.Message;
            if (resultado.Success) { Seleccionadas.Clear(); referenciaPago = observacionPago = null; comprobante = null; await CargarAsync(); }
        }
        finally
        {
            procesando = false;
        }
    }
}
