@page "/e-sign/documentos/validar-firma"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using Microsoft.JSInterop
@using Simetric.Services
@using Simetric.Services.ESign
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject FirmaStampApiService FirmaStampApiService
@inject IWebHostEnvironment HostEnvironment
@inject IJSRuntime JS

<PageTitle>Validar firma digital | E-Rubrica</PageTitle>

<div class="validation-page">
    @if (cargando)
    {
        <ESignLoadingState
            Title="Cargando validacion"
            Description="Inicializando la consulta para revisar firmas digitales en documentos PDF." />
    }
    else
    {
        <header class="validation-header esign-document-hero">
            <div class="header-content">
                <span class="header-kicker">Documentos Electrónicos</span>
                <h1>Validar Firma</h1>
                <p>Comprueba integridad, certificado, revocación OCSP/CRL y sello de tiempo RFC 3161.</p>
            </div>
            <div class="header-actions">
                <span class="esign-hero-chip"><i class="bi bi-shield-check"></i> Validación completa</span>
            </div>
        </header>

        <section class="validation-workspace">
            <div class="validation-main">
                <article class="validation-card validation-upload-card">
                    <div class="panel-heading">
                        <h2><i class="bi bi-file-earmark-lock"></i> Documento firmado en PDF</h2>
                        <button type="button" class="history-documents-btn" @onclick="AbrirModalDocumentos">
                            <i class="bi bi-folder2-open"></i>
                            <span>Documentos Firmados</span>
                        </button>
                    </div>

                    <div class="file-grid">
                        <label class="signature-file-card @(pdfValidacionFirmaFile is null && documentoHistorialSeleccionado is null ? null : "is-ready")">
                            <InputFile id="validationPdfInput" class="file-input" accept="application/pdf,.pdf" OnChange="SeleccionarPdfValidacionFirma" />
                            <span class="pdf-illustration">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <span class="upload-arrow"><i class="bi bi-arrow-up"></i></span>
                            </span>
                            <strong>Arrastra y suelta tu archivo PDF aquí</strong>
                            <span>@NombreDocumentoActivo</span>
                            <span class="select-file-button">
                                <i class="bi bi-file-earmark-arrow-up"></i>
                                <span>Seleccionar PDF</span>
                            </span>
                            <small>
                                <span><i class="bi bi-filetype-pdf"></i> Formato: PDF</span>
                                <span><i class="bi bi-clock-history"></i> Tamaño máximo: 10 MB</span>
                                <span><i class="bi bi-file-earmark-text"></i> Páginas: ilimitado</span>
                            </small>
                        </label>
                    </div>

                    <div class="validation-pdf-viewer">
                        <div class="validation-pdf-toolbar">
                            <button type="button" id="validationPreviousPage" aria-label="Página anterior">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button type="button" id="validationNextPage" aria-label="Página siguiente">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                            <span>Página <strong id="validationCurrentPage">1</strong> de <strong id="validationPageCount">0</strong></span>
                            <span class="toolbar-spacer"></span>
                            <button type="button" id="validationZoomOut" aria-label="Alejar">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="zoom-label" id="validationZoomLabel">100%</span>
                            <button type="button" id="validationZoomIn" aria-label="Acercar">
                                <i class="bi bi-plus"></i>
                            </button>
                            <span class="validation-pdf-status" id="validationPdfStatus">Carga un PDF para visualizarlo.</span>
                        </div>
                        <div class="validation-pdf-shell">
                            <aside class="validation-pdf-thumbnails" id="validationPdfThumbnails" aria-label="Miniaturas del PDF">
                                <div class="validation-pdf-thumb is-placeholder"><span></span><strong>1</strong></div>
                            </aside>
                            <div class="validation-pdf-stage" id="validationPdfStage">
                                <canvas id="validationPdfCanvas" hidden></canvas>
                                <div class="validation-pdf-placeholder" id="validationPdfPlaceholder">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                    <strong>Previsualización del PDF</strong>
                                    <span>Selecciona un documento firmado para verlo aquí.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                <div class="validation-actions">
                    <button type="button" class="validation-btn" @onclick="ValidarFirmaPdfAsync" disabled="@procesandoValidacionFirmaPdf">
                        <i class="bi @(procesandoValidacionFirmaPdf ? "bi-arrow-repeat" : "bi-shield-check")"></i>
                        <span>@(procesandoValidacionFirmaPdf ? "Analizando..." : "Analizar firma digital")</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>

            <aside class="validation-sidebar">
                <article class="validation-card verification-list-card">
                    <div class="sidebar-title">
                        <i class="bi bi-shield-check"></i>
                        <h2>Qué se verificará</h2>
                    </div>

                    <div class="verification-list">
                        @foreach (var item in CriteriosValidacion)
                        {
                            <div class="verification-item">
                                <span><i class="@item.Icono"></i></span>
                                <div>
                                    <strong>@item.Titulo</strong>
                                    <p>@item.Detalle</p>
                                </div>
                            </div>
                        }
                    </div>
                </article>

                <article class="validation-card support-card">
                    <div>
                        <span class="support-icon"><i class="bi bi-headset"></i></span>
                        <h2>¿Necesitas ayuda?</h2>
                        <p>Nuestro equipo de soporte está listo para asistirte en cualquier momento.</p>
                        <a class="support-link" href="/e-sign/soporte">
                            Contactar soporte <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <img src="/images/support/numerica-support-bot12.png" alt="Numi, asistente de soporte" />
                </article>
            </aside>

            @if (!string.IsNullOrWhiteSpace(pdfFirmaMensaje))
            {
                <div class="validation-result @(pdfFirmaEsError ? "is-error" : "is-valid")" role="status">
                    <i class="bi @(pdfFirmaEsError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>
                    <div>
                        <strong>@(pdfFirmaEsError ? "Firma no valida" : "Firma valida")</strong>
                        <span>@pdfFirmaMensaje</span>
                    </div>
                </div>
            }

            @if (pdfFirmaResultado is not null)
            {
                <dl class="validation-details pdf-signature-summary">
                    <div>
                        <dt>Firmas</dt>
                        <dd>@pdfFirmaResultado.CantidadFirmas</dd>
                    </div>
                    <div>
                        <dt>Documento completo</dt>
                        <dd>@(pdfFirmaResultado.DocumentoCompletoCubierto ? "Si" : "No")</dd>
                    </div>
                </dl>

                <div class="pdf-signature-list">
                    @foreach (var firma in pdfFirmaResultado.Firmas)
                    {
                        <article class="pdf-signature-item @(firma.Valida ? "is-valid" : "is-error")">
                            <div>
                                <strong>@(string.IsNullOrWhiteSpace(firma.Firmante) ? "Firmante no identificado" : firma.Firmante)</strong>
                                <span>@(firma.FechaFirma?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Fecha de firma no disponible")</span>
                            </div>
                            <dl>
                                <div>
                                    <dt>Integridad</dt>
                                    <dd>@(firma.IntegridadValida ? "OK" : "Error")</dd>
                                </div>
                                <div>
                                    <dt>Certificado</dt>
                                    <dd>@TextoVigenciaCertificado(firma)</dd>
                                </div>
                                <div>
                                    <dt>Revocacion</dt>
                                    <dd>@firma.EstadoRevocacion</dd>
                                </div>
                                <div>
                                    <dt>Sello tiempo</dt>
                                    <dd>@TextoSelloTiempo(firma)</dd>
                                </div>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(firma.Error))
                            {
                                <p>@firma.Error</p>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        @if (mostrarModalDocumentos)
        {
            <div class="history-modal-backdrop" @onclick="CerrarModalDocumentos">
                <section class="history-documents-modal" role="dialog" aria-modal="true" aria-labelledby="historyDocumentsTitle" @onclick:stopPropagation>
                    <div class="history-modal-header">
                        <div>
                            <span>Historial de documentos</span>
                            <h2 id="historyDocumentsTitle">Seleccionar documento firmado</h2>
                        </div>
                        <button type="button" @onclick="CerrarModalDocumentos" aria-label="Cerrar modal">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    @if (!documentosFirmados.Any())
                    {
                        <div class="history-empty-state">
                            <i class="bi bi-file-earmark-lock"></i>
                            <strong>No tienes documentos firmados.</strong>
                            <span>Cuando firmes un PDF, aparecerá aquí para validarlo.</span>
                        </div>
                    }
                    else
                    {
                        <div class="history-documents-list">
                            @foreach (var doc in documentosFirmados)
                            {
                                <article class="history-document-item @(documentoHistorialSeleccionado?.Url == doc.Url ? "is-selected" : null)">
                                    <span class="history-document-icon"><i class="bi bi-file-earmark-pdf"></i></span>
                                    <div>
                                        <strong title="@doc.NombreArchivo">@doc.Nombre</strong>
                                        <small>@doc.Fecha.ToString("dd/MM/yyyy HH:mm") · @doc.Tamano</small>
                                    </div>
                                    <button type="button" @onclick="() => SeleccionarDocumentoHistorialAsync(doc)">
                                        Usar
                                    </button>
                                </article>
                            }
                        </div>
                    }
                </section>
            </div>
        }
    }
</div>

@code {
    private const long MaxPdfSize = 10 * 1024 * 1024;

    private bool cargando = true;
    private bool procesandoValidacionFirmaPdf;
    private bool pdfFirmaEsError;
    private string? pdfFirmaMensaje;
    private IBrowserFile? pdfValidacionFirmaFile;
    private PdfSignatureValidationApiResponse? pdfFirmaResultado;
    private IJSObjectReference? pdfPreviewModule;
    private IJSObjectReference? pdfPreviewInstance;
    private bool pdfPreviewInitialized;
    private bool mostrarModalDocumentos;
    private int currentUserId;
    private DocumentoFirmadoItem? documentoHistorialSeleccionado;
    private readonly List<DocumentoFirmadoItem> documentosFirmados = new();
    private string NombreDocumentoActivo =>
        pdfValidacionFirmaFile?.Name
        ?? documentoHistorialSeleccionado?.Nombre
        ?? "o selecciona un archivo desde tu dispositivo";

    private static readonly IReadOnlyList<CriterioValidacion> CriteriosValidacion =
    [
        new("Integridad del documento", "Verifica que el documento no haya sido alterado.", "Confirma que el contenido no ha sido modificado desde su firma.", "bi bi-shield-check"),
        new("Certificado digital", "Valida el certificado del firmante y su cadena.", "Valida la identidad del firmante mediante su certificado digital.", "bi bi-award"),
        new("Revocación OCSP/CRL", "Consulta el estado del certificado en tiempo real.", "Verifica que el certificado no esté revocado (OCSP/CRL).", "bi bi-diagram-3"),
        new("Sello de tiempo RFC 3161", "Verifica la existencia de un sello de tiempo confiable.", "Comprueba la existencia y validez del sello de tiempo.", "bi bi-clock"),
        new("Validez legal", "Determina si la firma cumple los requisitos de validez.", "Determina si la firma cumple con los requisitos para su validez legal.", "bi bi-scales")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) || currentUserId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        CargarDocumentosFirmados();
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cargando || pdfPreviewInitialized)
            return;

        pdfPreviewInitialized = true;
        pdfPreviewModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/esignPdfPreview.js?v=20260820-1");
        pdfPreviewInstance = await pdfPreviewModule.InvokeAsync<IJSObjectReference>(
            "init",
            new
            {
                pdfInputId = "validationPdfInput",
                canvasId = "validationPdfCanvas",
                stageId = "validationPdfStage",
                placeholderId = "validationPdfPlaceholder",
                previousButtonId = "validationPreviousPage",
                nextButtonId = "validationNextPage",
                currentPageLabelId = "validationCurrentPage",
                pageCountLabelId = "validationPageCount",
                statusId = "validationPdfStatus",
                thumbnailsId = "validationPdfThumbnails",
                zoomOutButtonId = "validationZoomOut",
                zoomInButtonId = "validationZoomIn",
                zoomLabelId = "validationZoomLabel"
            });
    }

    private void SeleccionarPdfValidacionFirma(InputFileChangeEventArgs e)
    {
        pdfValidacionFirmaFile = e.File;
        documentoHistorialSeleccionado = null;
        pdfFirmaMensaje = null;
        pdfFirmaResultado = null;
    }

    private async Task ValidarFirmaPdfAsync()
    {
        pdfFirmaMensaje = null;
        pdfFirmaEsError = false;
        pdfFirmaResultado = null;

        if (pdfValidacionFirmaFile is null && documentoHistorialSeleccionado is null)
        {
            pdfFirmaEsError = true;
            pdfFirmaMensaje = "Selecciona el PDF firmado.";
            return;
        }

        if (pdfValidacionFirmaFile is not null && (pdfValidacionFirmaFile.Size <= 0 || pdfValidacionFirmaFile.Size > MaxPdfSize))
        {
            pdfFirmaEsError = true;
            pdfFirmaMensaje = "El PDF debe pesar maximo 10 MB.";
            return;
        }

        if (pdfValidacionFirmaFile is not null && !EsExtension(pdfValidacionFirmaFile.Name, ".pdf"))
        {
            pdfFirmaEsError = true;
            pdfFirmaMensaje = "El documento debe ser PDF.";
            return;
        }

        procesandoValidacionFirmaPdf = true;
        try
        {
            var apiResult = pdfValidacionFirmaFile is not null
                ? await FirmaStampApiService.ValidarFirmaPdfAsync(pdfValidacionFirmaFile)
                : await ValidarDocumentoHistorialAsync(documentoHistorialSeleccionado!);

            if (!apiResult.Success || apiResult.Validation is null)
            {
                pdfFirmaEsError = true;
                pdfFirmaMensaje = apiResult.Message;
                return;
            }

            pdfFirmaResultado = apiResult.Validation;
            pdfFirmaEsError = !pdfFirmaResultado.Valido;
            pdfFirmaMensaje = pdfFirmaResultado.Valido
                ? "El PDF tiene firma digital valida."
                : "El PDF no tiene una firma digital valida.";
        }
        finally
        {
            procesandoValidacionFirmaPdf = false;
        }
    }

    private static string TextoSelloTiempo(PdfSignatureDetailApiResponse firma)
    {
        if (firma.SelloTiempoValido is null)
            return "No aplica";

        return firma.SelloTiempoValido.Value
            ? firma.FechaSelloTiempo?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Valido"
            : "No valido";
    }

    private static string TextoVigenciaCertificado(PdfSignatureDetailApiResponse firma)
    {
        var estado = firma.CertificadoVigente ? "Vigente" : "No vigente";
        var desde = firma.CertificadoDesde?.ToLocalTime().ToString("dd/MM/yyyy");
        var hasta = firma.CertificadoHasta?.ToLocalTime().ToString("dd/MM/yyyy");

        if (!string.IsNullOrWhiteSpace(desde) && !string.IsNullOrWhiteSpace(hasta))
            return $"{estado}: {desde} - {hasta}";

        if (!string.IsNullOrWhiteSpace(hasta))
            return $"{estado}: vence {hasta}";

        return estado;
    }

    private static bool EsExtension(string fileName, string extension) =>
        string.Equals(Path.GetExtension(fileName), extension, StringComparison.OrdinalIgnoreCase);

    private void AbrirModalDocumentos() => mostrarModalDocumentos = true;

    private void CerrarModalDocumentos() => mostrarModalDocumentos = false;

    private async Task SeleccionarDocumentoHistorialAsync(DocumentoFirmadoItem doc)
    {
        documentoHistorialSeleccionado = doc;
        pdfValidacionFirmaFile = null;
        pdfFirmaMensaje = null;
        pdfFirmaResultado = null;
        mostrarModalDocumentos = false;

        if (pdfPreviewInstance is not null)
            await pdfPreviewInstance.InvokeVoidAsync("loadFromUrl", doc.Url);
    }

    private async Task<PdfSignatureValidationApiResult> ValidarDocumentoHistorialAsync(DocumentoFirmadoItem doc)
    {
        var physicalPath = Path.Combine(
            HostEnvironment.WebRootPath,
            doc.RelativePath.Replace('/', Path.DirectorySeparatorChar));

        if (!File.Exists(physicalPath))
            return PdfSignatureValidationApiResult.Error("No se encontró el PDF seleccionado.");

        var fileInfo = new FileInfo(physicalPath);
        if (fileInfo.Length <= 0 || fileInfo.Length > MaxPdfSize)
            return PdfSignatureValidationApiResult.Error("El PDF debe pesar maximo 10 MB.");

        await using var stream = File.OpenRead(physicalPath);
        return await FirmaStampApiService.ValidarFirmaPdfAsync(stream, doc.NombreArchivo, "application/pdf");
    }

    private void CargarDocumentosFirmados()
    {
        documentosFirmados.Clear();
        var relativeDirectory = Path.Combine("uploads", "e-rubrica", "estampados", currentUserId.ToString());
        var physicalDirectory = Path.Combine(HostEnvironment.WebRootPath, relativeDirectory);
        if (!Directory.Exists(physicalDirectory))
            return;

        foreach (var file in Directory.EnumerateFiles(physicalDirectory, "*.pdf")
            .Select(path => new FileInfo(path))
            .OrderByDescending(file => file.CreationTime))
        {
            var relativePath = Path.Combine(relativeDirectory, file.Name).Replace('\\', '/');
            documentosFirmados.Add(new DocumentoFirmadoItem(
                CrearNombreVisible(file),
                file.Name,
                FormatearTamano(file.Length),
                file.CreationTime,
                "/" + relativePath,
                relativePath));
        }
    }

    private static string CrearNombreVisible(FileInfo file)
    {
        if (TryGetNombreDocumentoOriginal(file.Name, out var nombreOriginal))
            return $"{nombreOriginal}_firmado.pdf";

        var nombre = Path.GetFileNameWithoutExtension(file.Name);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 3 &&
            partes[0].Length == 14 &&
            partes[^1].Equals("estampado", StringComparison.OrdinalIgnoreCase) &&
            partes[1].Length >= 16)
        {
            return $"Documento estampado - {file.CreationTime:dd/MM/yyyy HH:mm}";
        }

        var index = nombre.IndexOf("_estampado", StringComparison.OrdinalIgnoreCase);
        if (index > 0)
            nombre = nombre[..index];

        return $"{nombre.Replace('_', ' ').Trim()}.pdf";
    }

    private static bool TryGetNombreDocumentoOriginal(string fileName, out string nombreOriginal)
    {
        nombreOriginal = string.Empty;
        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length < 4 ||
            partes[0].Length != 14 ||
            partes[1].Length != 32 ||
            !partes[^1].Equals("firmado", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        nombreOriginal = string.Join("_", partes.Skip(2).Take(partes.Length - 3))
            .Replace('_', ' ')
            .Trim();

        return !string.IsNullOrWhiteSpace(nombreOriginal);
    }

    private static string FormatearTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{Math.Max(1, bytes / 1024d):0.##} KB";

    public async ValueTask DisposeAsync()
    {
        if (pdfPreviewInstance is not null)
        {
            await pdfPreviewInstance.InvokeVoidAsync("dispose");
            await pdfPreviewInstance.DisposeAsync();
        }

        if (pdfPreviewModule is not null)
            await pdfPreviewModule.DisposeAsync();
    }

    private sealed record CriterioValidacion(string Titulo, string Descripcion, string Detalle, string Icono);
    private sealed record DocumentoFirmadoItem(string Nombre, string NombreArchivo, string Tamano, DateTime Fecha, string Url, string RelativePath);
}
