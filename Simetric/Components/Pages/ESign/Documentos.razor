@page "/e-rubrica/documentos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Simetric.Data
@using Simetric.Services
@using Simetric.Services.ESign
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Documentos firmados | E-Rubrica</PageTitle>

<div class="esign-page">
    @if (cargando)
    {
        <ESignLoadingState
            Title="Cargando documentos"
            Description="Estamos preparando el historial de PDF firmados y sus estados de validacion." />
    }
    else
    {
        <header class="esign-header-section esign-document-hero">
            <div class="header-content">
                <span class="header-kicker">Documentos Electrónicos</span>
                <h1>Historial Documentos Firmados</h1>
                <p>Consulta, descarga o valida los PDF que has firmado electrónicamente.</p>
            </div>
            <div class="header-actions">
                <button class="btn-validate" @onclick="IrAValidarFirma">
                    <i class="bi bi-shield-check"></i>
                    <span>Validar firma</span>
                </button>
            </div>
        </header>

        <section class="stats-grid">
            <article class="stat-card stat-teal">
                <div>
                    <span class="stat-label">Documentos firmados</span>
                    <strong>@documentos.Count</strong>
                    <small>Total en tu cuenta</small>
                </div>
                <span class="stat-progress"></span>
            </article>
            <article class="stat-card stat-blue">
                <div>
                    <span class="stat-label">Firmados este mes</span>
                    <strong>@DocumentosMesActual</strong>
                    <small>@DateTime.Now.ToString("MMMM yyyy")</small>
                </div>
                <span class="stat-progress"></span>
            </article>
            <article class="stat-card stat-gold">
                <div>
                    <span class="stat-label">Documentos validos</span>
                    <strong>@PorcentajeValidos%</strong>
                    <small>Sin incidencias</small>
                </div>
                <span class="stat-progress"></span>
            </article>
        </section>

        <section class="esign-panel">
            <div class="filters-bar">
                <label class="filter-field filter-search">
                    <i class="bi bi-search"></i>
                    <input placeholder="Buscar por nombre de documento..." @bind="busqueda" @bind:event="oninput" />
                </label>
                <label class="filter-field">
                    <input type="date" @bind="fechaFiltro" @bind:format="yyyy-MM-dd" />
                    <i class="bi bi-calendar3"></i>
                </label>
                <label class="filter-field">
                    <select @bind="estadoFiltro">
                        <option value="">Todos los estados</option>
                        <option value="Valido">Valido</option>
                    </select>
                    <i class="bi bi-chevron-down"></i>
                </label>
                <button type="button" class="btn-clear" @onclick="LimpiarFiltros">
                    <i class="bi bi-funnel"></i>
                    <span>Limpiar filtros</span>
                </button>
            </div>

            @if (!DocumentosFiltrados.Any())
            {
                <div class="empty-documents">
                    <i class="bi bi-file-earmark-lock"></i>
                    <strong>No hay documentos para mostrar.</strong>
                    <span>Cuando generes un PDF estampado, aparecera aqui para abrirlo o descargarlo.</span>
                </div>
            }
            else
            {
                <div class="documents-table-wrap">
                    <table class="documents-table">
                        <colgroup>
                            <col class="col-document" />
                            <col class="col-date" />
                            <col class="col-signer" />
                            <col class="col-size" />
                            <col class="col-status" />
                            <col class="col-actions" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Documento</th>
                                <th>Fecha de firma</th>
                                <th>Firmado por</th>
                                <th>Tamaño</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in DocumentosPagina)
                            {
                                <tr>
                                    <td>
                                        <div class="document-cell">
                                            <span class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></span>
                                            <div>
                                                <strong title="@doc.NombreArchivo">@doc.Nombre</strong>
                                                <span>@doc.Descripcion</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="date-cell">
                                            <i class="bi bi-calendar3"></i>
                                            <div>
                                                <strong>@doc.Fecha.ToString("dd/MM/yyyy")</strong>
                                                <span>@doc.Fecha.ToString("HH:mm:ss")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="signer-cell">
                                            <span class="avatar">
                                                @if (!string.IsNullOrWhiteSpace(currentUserAvatarUrl))
                                                {
                                                    <img src="@currentUserAvatarUrl" alt="Foto de perfil de @doc.Firmante" />
                                                }
                                                else
                                                {
                                                    @InicialesUsuario
                                                }
                                            </span>
                                            <div>
                                                <strong>@doc.Firmante</strong>
                                                <span>@currentUserEmail</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@doc.Tamano</td>
                                    <td><span class="status-pill"><i class="bi bi-check"></i> Valido</span></td>
                                    <td>
                                        <div class="row-actions">
                                            <a class="action-btn" href="@doc.Url" target="_blank" title="Ver PDF">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a class="action-btn" href="@doc.Url" download="@doc.Nombre" title="Descargar PDF">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <span>Mostrando @PrimerDocumentoMostrado a @UltimoDocumentoMostrado de @DocumentosFiltrados.Count documentos</span>
                    <div class="pagination">
                        <button type="button" class="page-btn" @onclick="PaginaAnterior" disabled="@(PaginaActualNormalizada <= 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @foreach (var numeroPagina in PaginasVisibles)
                        {
                            <button type="button" class="page-btn @(numeroPagina == PaginaActualNormalizada ? "is-active" : null)" @onclick="() => IrAPagina(numeroPagina)">
                                @numeroPagina
                            </button>
                        }
                        <button type="button" class="page-btn" @onclick="PaginaSiguiente" disabled="@(PaginaActualNormalizada >= TotalPaginas)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public bool DemoMode { get; set; }

    private bool cargando = true;
    private string currentUserName = "Usuario";
    private string currentUserEmail = "correo no disponible";
    private string? currentUserAvatarUrl;
    private string busqueda = string.Empty;
    private DateTime? fechaFiltro;
    private string estadoFiltro = string.Empty;
    private int currentUserId;
    private int paginaActual = 1;
    private const int PageSize = 5;
    private readonly List<DocumentoFirmadoItem> documentos = new();

    private List<DocumentoFirmadoItem> DocumentosFiltrados
    {
        get
        {
            var query = documentos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(busqueda))
                query = query.Where(doc => doc.Nombre.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase));

            if (fechaFiltro.HasValue)
                query = query.Where(doc => doc.Fecha.Date == fechaFiltro.Value.Date);

            if (!string.IsNullOrWhiteSpace(estadoFiltro))
                query = query.Where(doc => string.Equals(doc.Estado, estadoFiltro, StringComparison.OrdinalIgnoreCase));

            return query.ToList();
        }
    }

    private IReadOnlyList<DocumentoFirmadoItem> DocumentosPagina =>
        DocumentosFiltrados
            .Skip((PaginaActualNormalizada - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(DocumentosFiltrados.Count / (double)PageSize));
    private int PaginaActualNormalizada => Math.Clamp(paginaActual, 1, TotalPaginas);
    private int PrimerDocumentoMostrado => DocumentosFiltrados.Count == 0 ? 0 : ((PaginaActualNormalizada - 1) * PageSize) + 1;
    private int UltimoDocumentoMostrado => Math.Min(PaginaActualNormalizada * PageSize, DocumentosFiltrados.Count);
    private int DocumentosMesActual => documentos.Count(doc => doc.Fecha.Month == DateTime.Now.Month && doc.Fecha.Year == DateTime.Now.Year);
    private int PorcentajeValidos => documentos.Count == 0 ? 0 : 100;
    private IEnumerable<int> PaginasVisibles => Enumerable.Range(1, TotalPaginas).Take(7);
    private string InicialesUsuario => string.Join(
        string.Empty,
        currentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(parte => parte[0])).ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (DemoMode)
        {
            currentUserId = 0;
            currentUserName = "María Fernanda López";
            currentUserEmail = "maria.lopez@demo.numerica.ec";
            documentos.AddRange(new[]
            {
                new DocumentoFirmadoItem("Contrato-servicios-2026", "Contrato-servicios-2026.pdf", "Contrato de servicios firmado electrónicamente", "248 KB", new DateTime(2026, 8, 28), currentUserName, "Valido", "#"),
                new DocumentoFirmadoItem("Autorizacion-representante", "Autorizacion-representante.pdf", "Autorización de representante legal", "172 KB", new DateTime(2026, 8, 21), currentUserName, "Valido", "#"),
                new DocumentoFirmadoItem("Acuerdo-comercial-andina", "Acuerdo-comercial-andina.pdf", "Acuerdo comercial con firma digital", "391 KB", new DateTime(2026, 8, 14), currentUserName, "Valido", "#")
            });
            cargando = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) || currentUserId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        currentUserName = user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity?.Name ?? currentUserName;
        currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("Email")?.Value ?? currentUserEmail;
        currentUserAvatarUrl = ResolverAvatarUrl(user.FindFirst("AvatarUrl")?.Value);
        await CargarPerfilUsuarioAsync();
        CargarHistorialDocumentos();
        cargando = false;
    }

    private void IrAValidarFirma() => NavManager.NavigateTo(DemoMode ? "/demo/erubrica?vista=validar" : "/e-rubrica/documentos/validar-firma");

    private void LimpiarFiltros()
    {
        busqueda = string.Empty;
        fechaFiltro = null;
        estadoFiltro = string.Empty;
        paginaActual = 1;
    }

    private void IrAPagina(int pagina) => paginaActual = Math.Clamp(pagina, 1, TotalPaginas);

    private void PaginaAnterior() => IrAPagina(paginaActual - 1);

    private void PaginaSiguiente() => IrAPagina(paginaActual + 1);

    private void CargarHistorialDocumentos()
    {
        documentos.Clear();
        var relativeDirectory = Path.Combine("uploads", "e-rubrica", "estampados", currentUserId.ToString());
        var physicalDirectory = Path.Combine(HostEnvironment.WebRootPath, relativeDirectory);
        if (!Directory.Exists(physicalDirectory))
            return;

        foreach (var file in Directory.EnumerateFiles(physicalDirectory, "*.pdf")
            .Select(path => new FileInfo(path))
            .OrderByDescending(file => file.CreationTime))
        {
            documentos.Add(new DocumentoFirmadoItem(
                CrearNombreVisible(file),
                file.Name,
                CrearDescripcion(file.Name),
                FormatearTamano(file.Length),
                file.CreationTime,
                currentUserName,
                "Valido",
                "/" + Path.Combine(relativeDirectory, file.Name).Replace('\\', '/')));
        }
    }

    private async Task CargarPerfilUsuarioAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var usuario = await context.Usuarios
            .AsNoTracking()
            .Where(u => u.IdUsuario == currentUserId)
            .Select(u => new { u.Nombres, u.Apellidos, u.Email, u.AvatarUrl })
            .FirstOrDefaultAsync();

        if (usuario is null)
            return;

        currentUserName = string.Join(" ", new[] { usuario.Nombres, usuario.Apellidos }
            .Where(valor => !string.IsNullOrWhiteSpace(valor))).Trim();
        if (string.IsNullOrWhiteSpace(currentUserName))
            currentUserName = "Usuario";

        if (!string.IsNullOrWhiteSpace(usuario.Email))
            currentUserEmail = usuario.Email;

        currentUserAvatarUrl = ResolverAvatarUrl(usuario.AvatarUrl) ?? currentUserAvatarUrl;
    }

    private static string CrearDescripcion(string fileName)
    {
        if (TryGetNombreDocumentoOriginal(fileName, out _))
            return "PDF firmado desde e-rubrica";

        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var index = nombre.IndexOf("_estampado", StringComparison.OrdinalIgnoreCase);
        if (index > 0)
            nombre = nombre[..index];

        return nombre.Replace('_', ' ').Trim();
    }

    private static string CrearNombreVisible(FileInfo file)
    {
        if (TryGetNombreDocumentoOriginal(file.Name, out var nombreOriginal))
            return $"{nombreOriginal}_firmado.pdf";

        var nombre = Path.GetFileNameWithoutExtension(file.Name);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 3 &&
            partes[0].Length == 14 &&
            partes[^1].Equals("estampado", StringComparison.OrdinalIgnoreCase) &&
            partes[1].Length >= 16)
        {
            return $"Documento estampado - {file.CreationTime:dd/MM/yyyy HH:mm}";
        }

        var index = nombre.IndexOf("_estampado", StringComparison.OrdinalIgnoreCase);
        if (index > 0)
            nombre = nombre[..index];

        return $"{nombre.Replace('_', ' ').Trim()}.pdf";
    }

    private static bool TryGetNombreDocumentoOriginal(string fileName, out string nombreOriginal)
    {
        nombreOriginal = string.Empty;
        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length < 4 ||
            partes[0].Length != 14 ||
            partes[1].Length != 32 ||
            !partes[^1].Equals("firmado", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        nombreOriginal = string.Join("_", partes.Skip(2).Take(partes.Length - 3))
            .Replace('_', ' ')
            .Trim();

        return !string.IsNullOrWhiteSpace(nombreOriginal);
    }

    private static string FormatearTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{Math.Max(1, bytes / 1024d):0.##} KB";

    private static string? ResolverAvatarUrl(string? avatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
            return null;

        var valor = avatarUrl.Trim().Replace('\\', '/');
        if (valor.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            valor.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            valor.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
            return valor;

        return valor.StartsWith("/", StringComparison.Ordinal)
            ? valor
            : "/" + valor.TrimStart('/');
    }

    private sealed record DocumentoFirmadoItem(string Nombre, string NombreArchivo, string Descripcion, string Tamano, DateTime Fecha, string Firmante, string Estado, string Url);
}
