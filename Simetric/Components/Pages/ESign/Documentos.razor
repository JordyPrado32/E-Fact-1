@page "/e-sign/documentos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using Simetric.Services
@using Simetric.Services.ESign
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState

<PageTitle>Documentos firmados | E-Rúbrica</PageTitle>

<div class="esign-page">
    @if (cargando)
    {
        <div class="esign-state">
            <span class="spinner-border" role="status"></span>
            <h3>Cargando documentos</h3>
        </div>
    }
    else
    {
        <header class="esign-header-section">
            <div class="header-content">
                <span class="header-kicker">E-Rúbrica</span>
                <h1>Documentos firmados</h1>
                <p>Arrastra o selecciona un PDF para prepararlo en tu bandeja de firma.</p>
            </div>
            <button class="btn-back" @onclick="IrAlInicio">
                <i class="bi bi-arrow-left"></i>
                <span>Volver al inicio</span>
            </button>
        </header>

        <section class="esign-upload-container @(archivoArrastrado ? "is-dragging" : null)"
                 @ondragenter="ActivarArrastre"
                 @ondragleave="DesactivarArrastre"
                 @ondrop="DesactivarArrastre">
            <InputFile class="drop-file-input" accept="application/pdf,.pdf" OnChange="ProcesarPdfAsync" />
            <div class="upload-box">
                <div class="upload-icon"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                <div class="upload-copy">
                    <h3>Suelta aqui tu PDF</h3>
                    <p>O haz clic en esta zona para seleccionarlo desde tu computadora.</p>
                </div>
                <div class="upload-meta">
                    <span><i class="bi bi-check2-circle"></i> Solo PDF</span>
                    <span><i class="bi bi-hdd"></i> Maximo 10 MB</span>
                    <span><i class="bi bi-shield-check"></i> Listo para firma</span>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(esMensajeError ? "alert-danger" : "alert-success") animate__animated animate__fadeIn" role="alert">
                <i class="bi @(esMensajeError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                <div>@mensaje</div>
            </div>
        }

        <section class="esign-panel">
            <div class="panel-header">
                <span class="header-kicker">Bandeja</span>
                <h3>PDF cargados</h3>
            </div>

            @if (!documentos.Any())
            {
                <div class="empty-documents">
                    <i class="bi bi-file-earmark-lock"></i>
                    <strong>No hay PDFs cargados en esta sesion.</strong>
                    <span>Cuando selecciones un archivo, aparecera aqui para descargarlo o revisarlo.</span>
                </div>
            }
            else
            {
                <div class="esign-list">
                    @foreach (var doc in documentos)
                    {
                        <div class="esign-list-row">
                            <div class="doc-icon"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                            <div class="row-main">
                                <strong title="@doc.Nombre">@doc.Nombre</strong>
                                <span>@doc.Tamano | @doc.Fecha.ToString("dd/MM/yyyy HH:mm") | @doc.Firmante</span>
                            </div>
                            <div class="row-actions">
                                <a class="action-btn" href="@doc.Url" target="_blank" title="Abrir PDF">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <a class="action-btn" href="@doc.Url" download="@doc.Nombre" title="Descargar PDF">
                                    <i class="bi bi-download"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private const long MaxPdfSize = 10 * 1024 * 1024;
    private bool cargando = true;
    private bool archivoArrastrado;
    private bool esMensajeError;
    private string? mensaje;
    private string currentUserName = "Usuario";
    private int currentUserId;
    private readonly List<DocumentoFirmadoItem> documentos = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) || currentUserId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        currentUserName = user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity?.Name ?? currentUserName;
        cargando = false;
    }

    private void IrAlInicio() => NavManager.NavigateTo("/e-sign");

    private void ActivarArrastre() => archivoArrastrado = true;

    private void DesactivarArrastre() => archivoArrastrado = false;

    private async Task ProcesarPdfAsync(InputFileChangeEventArgs e)
    {
        mensaje = null;
        esMensajeError = false;

        if (e.FileCount != 1)
        {
            SetMensaje("Selecciona un solo archivo PDF.", true);
            return;
        }

        var file = e.File;
        if (file.Size <= 0)
        {
            SetMensaje("El PDF seleccionado esta vacio.", true);
            return;
        }

        if (file.Size > MaxPdfSize)
        {
            SetMensaje("El PDF supera el maximo permitido de 10 MB.", true);
            return;
        }

        if (!string.Equals(Path.GetExtension(file.Name), ".pdf", StringComparison.OrdinalIgnoreCase))
        {
            SetMensaje("Solo se permiten archivos PDF.", true);
            return;
        }

        var storedFileName = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.NewGuid():N}.pdf";
        var relativeDirectory = Path.Combine("uploads", "e-rubrica", "documentos", currentUserId.ToString());
        var physicalDirectory = Path.Combine(HostEnvironment.WebRootPath, relativeDirectory);
        Directory.CreateDirectory(physicalDirectory);

        var physicalPath = Path.Combine(physicalDirectory, storedFileName);
        await using (var source = file.OpenReadStream(MaxPdfSize))
        await using (var target = File.Create(physicalPath))
        {
            await source.CopyToAsync(target);
        }

        documentos.Insert(0, new DocumentoFirmadoItem(
            file.Name,
            FormatearTamano(file.Size),
            DateTime.Now,
            currentUserName,
            "/" + Path.Combine(relativeDirectory, storedFileName).Replace('\\', '/')));

        SetMensaje("PDF cargado correctamente. La firma criptografica queda pendiente de integrar con el motor de firma PDF.", false);
    }

    private void SetMensaje(string texto, bool esError)
    {
        mensaje = texto;
        esMensajeError = esError;
    }

    private static string FormatearTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{Math.Max(1, bytes / 1024d):0.##} KB";

    private sealed record DocumentoFirmadoItem(string Nombre, string Tamano, DateTime Fecha, string Firmante, string Url);
}
