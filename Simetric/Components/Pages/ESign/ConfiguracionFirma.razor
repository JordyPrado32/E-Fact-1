@page "/e-sign/configuracion/firma"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Simetric.Services
@using Simetric.Services.ESign
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState

<PageTitle>Firma, clave y logo | E-Rúbrica</PageTitle>

<div class="esign-config-page">
    @if (cargando)
    {
        <ESignLoadingState Title="Cargando configuracion"
                           Description="Estamos consultando emisores, firma y datos de estampado disponibles." />
    }
    else
    {
        <header class="esign-config-header">
            <div>
                <span class="header-kicker">E-Rúbrica</span>
                <h1>Firma, clave y logo</h1>
                <p>La configuracion existente de E-Fact se carga automaticamente; completa solo los datos pendientes.</p>
            </div>
            <button class="btn-back" @onclick='() => NavManager.NavigateTo("/e-sign")'>
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>
        </header>

        @if (!emisores.Any())
        {
            <section class="config-empty">
                <i class="bi bi-building-x"></i>
                <h3>No hay emisores activos</h3>
                <p>Primero registra un emisor en E-Fact para poder clonar firma, clave y logo.</p>
                <button type="button" class="esign-btn-primary" @onclick='() => NavManager.NavigateTo("/emisor")'>
                    <i class="bi bi-building"></i>
                    <span>Ir a emisor</span>
                </button>
            </section>
        }
        else
        {
            <section class="config-grid">
                <aside class="config-emisores">
                    <span class="header-kicker">Emisor</span>
                    @foreach (var emisor in emisores)
                    {
                        <button type="button"
                                class="emisor-option @(modelo.Codigo == emisor.Codigo ? "is-active" : null)"
                                @onclick="() => SeleccionarEmisorAsync(emisor)">
                            <strong>@GetNombreEmisor(emisor)</strong>
                            <span>@(string.IsNullOrWhiteSpace(emisor.Ruc) ? "Sin RUC" : emisor.Ruc)</span>
                        </button>
                    }
                </aside>

                <EditForm Model="modelo" OnValidSubmit="GuardarAsync" class="config-form">
                    <div class="config-form-head">
                        <div>
                            <span class="header-kicker">Configuracion activa</span>
                            <h3>@GetNombreModelo()</h3>
                        </div>
                        <span class="status-pill @(ConfiguracionCompleta ? "is-ready" : "is-pending")">
                            @(ConfiguracionCompleta ? "Completa" : "Pendiente")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="status-banner @(esError ? "status-error" : "status-ok")">
                            <i class="bi @(esError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>
                            <span>@mensaje</span>
                        </div>
                    }

                    <div class="field-grid">
                        <label class="config-upload-card @(TieneCertificado ? "is-ready" : "is-missing")">
                            <InputFile class="upload-input" accept=".p12" OnChange="SubirP12Async" />
                            <span class="upload-card-icon"><i class="bi bi-file-earmark-lock"></i></span>
                            <span class="upload-card-main">
                                <strong>Firma .p12</strong>
                                <small>@NombreCertificado</small>
                            </span>
                            <span class="upload-card-status">@(TieneCertificado ? "Cargada" : "Pendiente")</span>
                        </label>

                        <div class="config-password-card @(TieneClave ? "is-ready" : "is-missing")">
                            <div class="password-card-head">
                                <span class="upload-card-icon"><i class="bi bi-key"></i></span>
                                <span>
                                    <strong>Clave de firma</strong>
                                    <small>@(TieneClave ? "Clave disponible" : "Pendiente")</small>
                                </span>
                            </div>
                            <input type="password"
                                   @bind="modelo.ClaveCertificado"
                                   placeholder="Escribe una nueva clave solo si quieres actualizarla"
                                   autocomplete="new-password" />
                            <small>@(tieneClaveGuardada && string.IsNullOrWhiteSpace(modelo.ClaveCertificado) ? "Ya existe una clave guardada en E-Fact." : "Esta clave se guardara para este emisor.")</small>
                        </div>

                        <label class="config-upload-card @(TieneLogo ? "is-ready" : "is-missing")">
                            <InputFile class="upload-input" accept="image/jpeg,image/png,.jpg,.jpeg,.png" OnChange="SubirLogoAsync" />
                            <span class="upload-card-icon"><i class="bi bi-image"></i></span>
                            <span class="upload-card-main">
                                <strong>Logo de empresa</strong>
                                <small>@NombreLogo</small>
                            </span>
                            <span class="upload-card-status">@(TieneLogo ? "Cargado" : "Pendiente")</span>
                        </label>
                    </div>

                    <section class="firma-validation-card @(FirmaEstadoClass)">
                        <div class="validation-main">
                            <span class="upload-card-icon"><i class="bi bi-shield-check"></i></span>
                            <div>
                                <span class="header-kicker">Validacion API</span>
                                <h4>@FirmaEstadoTitulo</h4>
                                <p>@FirmaEstadoMensaje</p>
                            </div>
                        </div>

                        @if (firmaEstadoActual is not null)
                        {
                            <div class="validation-details">
                                <span><strong>Titular</strong>@(firmaEstadoActual.NombreTitular ?? "Sin dato")</span>
                                <span><strong>Identificacion</strong>@(firmaEstadoActual.Identificacion ?? "Sin dato")</span>
                                <span><strong>Expira</strong>@FormatearFecha(firmaEstadoActual.FechaExpiracion)</span>
                                <span><strong>Dias restantes</strong>@(firmaEstadoActual.DiasRestantes?.ToString() ?? "Sin dato")</span>
                            </div>
                        }

                        <button type="button"
                                class="esign-btn-secondary"
                                disabled="@(!PuedeValidarFirma || validandoFirma)"
                                @onclick="ValidarFirmaActualAsync">
                            <i class="bi @(validandoFirma ? "bi-arrow-repeat" : "bi-cloud-check")"></i>
                            <span>@(validandoFirma ? "Validando..." : "Validar ahora")</span>
                        </button>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(modelo.LogoImagen))
                    {
                        <div class="logo-preview">
                            <img src="@modelo.LogoImagen" alt="Logo de empresa" />
                        </div>
                    }

                    <div class="form-actions">
                        <button type="submit" class="esign-btn-primary" disabled="@guardando">
                            <i class="bi bi-save"></i>
                            <span>@(guardando ? "Guardando..." : "Guardar configuracion")</span>
                        </button>
                    </div>
                </EditForm>
            </section>
        }
    }
</div>

@code {
    private const long MaxCertificadoSize = 5 * 1024 * 1024;
    private const long MaxLogoSize = 2 * 1024 * 1024;
    private bool cargando = true;
    private bool guardando;
    private bool esError;
    private bool tieneClaveGuardada;
    private bool validandoFirma;
    private string? mensaje;
    private string? mensajeValidacionFirma;
    private string? certificadoSeleccionado;
    private string? logoSeleccionado;
    private FirmaEstadoDto? firmaEstadoActual;
    private int currentUserId;
    private readonly List<EmisorDto> emisores = new();
    private EmisorDto? emisorSeleccionado;
    private EmisorUpsertDto modelo = new();

    private bool ConfiguracionCompleta =>
        TieneCertificado && TieneClave && TieneLogo;

    private bool TieneCertificado => !string.IsNullOrWhiteSpace(modelo.PathCertificado);

    private bool TieneClave => tieneClaveGuardada || !string.IsNullOrWhiteSpace(modelo.ClaveCertificado);

    private bool TieneLogo => !string.IsNullOrWhiteSpace(modelo.LogoImagen);

    private bool PuedeValidarFirma => modelo.Codigo > 0 && TieneCertificado && TieneClave;

    private string FirmaEstadoClass =>
        firmaEstadoActual is null
            ? "is-pending"
            : firmaEstadoActual.EsValida
                ? "is-ready"
                : "is-error";

    private string FirmaEstadoTitulo =>
        validandoFirma
            ? "Validando firma electronica"
            : firmaEstadoActual is null
                ? "Firma pendiente de validar"
                : firmaEstadoActual.EsValida
                    ? "Firma valida y vigente"
                    : "Firma no valida";

    private string FirmaEstadoMensaje =>
        validandoFirma
            ? "Consultando la misma validacion de E-Fact..."
            : !PuedeValidarFirma
                ? "Carga firma .p12 y clave para validar con API."
                : !string.IsNullOrWhiteSpace(mensajeValidacionFirma)
                    ? mensajeValidacionFirma
                    : "La firma se validara con el mismo proceso de E-Fact.";

    private string NombreCertificado =>
        certificadoSeleccionado
        ?? ObtenerNombreArchivo(modelo.PathCertificado)
        ?? "Ningun .p12 seleccionado";

    private string NombreLogo =>
        logoSeleccionado
        ?? (!string.IsNullOrWhiteSpace(modelo.LogoImagen) ? "Logo actual cargado" : "Ningun logo seleccionado");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true ||
            !int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) ||
            currentUserId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        await CargarEmisoresAsync();
        cargando = false;
    }

    private async Task CargarEmisoresAsync()
    {
        emisores.Clear();
        var data = await Http.GetFromJsonAsync<List<EmisorDto>>($"api/emisores?idUsuario={currentUserId}") ?? new();
        emisores.AddRange(data.Where(e => e.Estado != false));
        await SeleccionarEmisorAsync(emisores.FirstOrDefault());
    }

    private async Task SeleccionarEmisorAsync(EmisorDto? emisor)
    {
        emisorSeleccionado = emisor;
        certificadoSeleccionado = null;
        logoSeleccionado = null;
        mensaje = null;
        firmaEstadoActual = null;
        mensajeValidacionFirma = null;

        modelo = emisor is null ? new EmisorUpsertDto() : CrearModeloDesdeEmisor(emisor);
        tieneClaveGuardada = emisor?.TieneClaveCertificadoConfigurada == true;
        if (ConfiguracionCompleta)
        {
            SetMensaje("Configuracion cargada automaticamente desde E-Fact.", false);
        }

        if (PuedeValidarFirma)
        {
            await ValidarFirmaActualAsync();
        }
    }

    private async Task GuardarAsync()
    {
        if (modelo.Codigo <= 0)
            return;

        if (string.IsNullOrWhiteSpace(modelo.PathCertificado))
        {
            SetMensaje("Debes cargar o clonar la firma .p12.", true);
            return;
        }

        if (!tieneClaveGuardada && string.IsNullOrWhiteSpace(modelo.ClaveCertificado))
        {
            SetMensaje("Debes ingresar la clave de la firma.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(modelo.LogoImagen))
        {
            SetMensaje("Debes cargar o clonar el logo de empresa.", true);
            return;
        }

        guardando = true;
        try
        {
            MigrarCertificadoSistemaARutaCompartida();
            modelo.IdUsuario = currentUserId;
            modelo.PathCertificado = modelo.PathCertificado?.Trim();
            modelo.ClaveCertificado = modelo.ClaveCertificado?.Trim();
            var response = await Http.PutAsJsonAsync($"api/emisores/{modelo.Codigo}", modelo);
            if (!response.IsSuccessStatusCode)
            {
                var detalle = await LeerMensajeErrorHttpAsync(
                    response,
                    "No se pudo guardar la configuracion de firma y logo.");
                SetMensaje(detalle, true);
                return;
            }

            await CargarEmisoresAsync();
            SetMensaje("Configuracion de E-Rúbrica guardada correctamente.", false);
        }
        catch (Exception ex)
        {
            SetMensaje(FormatearMensajeError(ex.Message), true);
        }
        finally
        {
            guardando = false;
        }
    }

    private void MigrarCertificadoSistemaARutaCompartida()
    {
        var rutaActual = modelo.PathCertificado?.Trim().Replace('\\', '/');
        if (string.IsNullOrWhiteSpace(rutaActual) ||
            !rutaActual.StartsWith("certs/system/", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var nombreArchivo = Path.GetFileName(rutaActual);
        var origen = Path.Combine(
            HostEnvironment.ContentRootPath,
            "App_Data",
            rutaActual.Replace('/', Path.DirectorySeparatorChar));
        var rutaNueva = $"certs/path/{nombreArchivo}";
        var destino = Path.Combine(
            HostEnvironment.ContentRootPath,
            "App_Data",
            rutaNueva.Replace('/', Path.DirectorySeparatorChar));

        if (!File.Exists(origen))
            return;

        Directory.CreateDirectory(Path.GetDirectoryName(destino)!);
        if (!File.Exists(destino))
            File.Copy(origen, destino);

        modelo.PathCertificado = rutaNueva;
    }

    private async Task SubirP12Async(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.FileCount != 1 || e.File is null)
            {
                SetMensaje("Selecciona un solo archivo .p12.", true);
                return;
            }

            var file = e.File;
            if (!string.Equals(Path.GetExtension(file.Name), ".p12", StringComparison.OrdinalIgnoreCase))
            {
                SetMensaje("Solo se permiten archivos .p12.", true);
                return;
            }

            var contentType = (file.ContentType ?? string.Empty).Trim().ToLowerInvariant();
            var tiposPermitidos = new[]
            {
                string.Empty,
                "application/x-pkcs12",
                "application/pkcs12",
                "application/x-pkcs-12",
                "application/octet-stream"
            };
            if (!tiposPermitidos.Contains(contentType))
            {
                SetMensaje("El archivo seleccionado no es un certificado .p12 valido.", true);
                return;
            }

            if (file.Size <= 0)
            {
                SetMensaje("El archivo .p12 esta vacio.", true);
                return;
            }

            if (file.Size > MaxCertificadoSize)
            {
                SetMensaje("El archivo .p12 excede el tamano maximo de 5 MB.", true);
                return;
            }

            await using var source = file.OpenReadStream(MaxCertificadoSize);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            if (bytes.Length == 0)
            {
                SetMensaje("No se pudo leer el archivo .p12 seleccionado.", true);
                return;
            }

            var relativePath = $"certs/path/{Guid.NewGuid():N}.p12";
            var physicalPath = Path.Combine(
                HostEnvironment.ContentRootPath,
                "App_Data",
                relativePath.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(Path.GetDirectoryName(physicalPath)!);
            await File.WriteAllBytesAsync(physicalPath, bytes);

            modelo.PathCertificado = relativePath;
            certificadoSeleccionado = file.Name;
            firmaEstadoActual = null;
            mensajeValidacionFirma = "Guarda la configuracion para validar la nueva firma.";
            SetMensaje("Firma .p12 cargada. Guarda para confirmar.", false);
        }
        catch (Exception ex)
        {
            SetMensaje(FormatearMensajeError(ex.Message), true);
        }
    }

    private async Task SubirLogoAsync(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.FileCount != 1 || e.File is null)
            {
                SetMensaje("Selecciona un solo logo.", true);
                return;
            }

            var file = e.File;
            var extension = Path.GetExtension(file.Name)?.ToLowerInvariant();
            if (extension is not ".jpg" and not ".jpeg" and not ".png")
            {
                SetMensaje("Solo se permiten logos JPG, JPEG o PNG.", true);
                return;
            }

            var contentType = (file.ContentType ?? string.Empty).Trim().ToLowerInvariant();
            if (contentType is not "image/jpeg" and not "image/png")
            {
                SetMensaje("El logo seleccionado no tiene un formato valido.", true);
                return;
            }

            if (file.Size <= 0)
            {
                SetMensaje("El archivo de logo esta vacio.", true);
                return;
            }

            if (file.Size > MaxLogoSize)
            {
                SetMensaje("El logo excede el tamano maximo de 2 MB.", true);
                return;
            }

            await using var stream = file.OpenReadStream(MaxLogoSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            if (bytes.Length == 0)
            {
                SetMensaje("No se pudo leer el logo seleccionado.", true);
                return;
            }

            var result = LogoImageProcessor.Normalize(bytes, contentType);
            modelo.LogoImagen = $"data:{result.ContentType};base64,{Convert.ToBase64String(result.Bytes)}";
            logoSeleccionado = file.Name;
            SetMensaje("Logo cargado correctamente. Guarda para confirmar.", false);
        }
        catch (Exception ex)
        {
            SetMensaje(FormatearMensajeError(ex.Message), true);
        }
    }

    private void SetMensaje(string texto, bool error)
    {
        mensaje = string.IsNullOrWhiteSpace(texto) ? null : texto.Trim('"', ' ', '\r', '\n');
        esError = error;
    }

    private async Task<string> LeerMensajeErrorHttpAsync(
        HttpResponseMessage response,
        string fallbackMessage)
    {
        var rawBody = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(rawBody))
            return fallbackMessage;

        var normalizedBody = rawBody.Trim();
        var mediaType = response.Content.Headers.ContentType?.MediaType;
        if (string.Equals(mediaType, "text/html", StringComparison.OrdinalIgnoreCase) ||
            PareceHtml(normalizedBody))
        {
            return $"{fallbackMessage} El servidor devolvio un error interno.";
        }

        var mensajeJson = IntentarExtraerMensajeJson(normalizedBody);
        return FormatearMensajeError(
            string.IsNullOrWhiteSpace(mensajeJson) ? normalizedBody : mensajeJson);
    }

    private static string FormatearMensajeError(string? rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
            return "Se produjo un error inesperado.";

        var limpio = rawMessage
            .Replace("\r", " ", StringComparison.Ordinal)
            .Replace("\n", " ", StringComparison.Ordinal)
            .Trim();

        if (PareceHtml(limpio))
            return "El servidor devolvio un error interno no controlado.";

        return limpio.Length > 320
            ? $"{limpio[..317].TrimEnd()}..."
            : limpio;
    }

    private static string? IntentarExtraerMensajeJson(string rawBody)
    {
        try
        {
            using var document = JsonDocument.Parse(rawBody);
            var root = document.RootElement;
            if (root.ValueKind == JsonValueKind.String)
                return root.GetString();

            if (root.ValueKind != JsonValueKind.Object)
                return null;

            foreach (var nombre in new[] { "message", "mensaje", "title" })
            {
                if (root.TryGetProperty(nombre, out var property) &&
                    property.ValueKind == JsonValueKind.String)
                {
                    return property.GetString();
                }
            }
        }
        catch (JsonException)
        {
        }

        return null;
    }

    private static bool PareceHtml(string value)
    {
        var sample = value.TrimStart();
        return sample.StartsWith("<!DOCTYPE", StringComparison.OrdinalIgnoreCase) ||
               sample.StartsWith("<html", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ValidarFirmaActualAsync()
    {
        if (!PuedeValidarFirma)
        {
            firmaEstadoActual = null;
            mensajeValidacionFirma = "Carga firma .p12 y clave para validar con API.";
            return;
        }

        validandoFirma = true;
        mensajeValidacionFirma = null;

        try
        {
            var estado = await Http.GetFromJsonAsync<FirmaEstadoDto>(
                $"api/emisores/{modelo.Codigo}/firma/estado?idUsuario={currentUserId}");

            firmaEstadoActual = estado;
            mensajeValidacionFirma = estado is null
                ? "No se pudo obtener el estado de la firma."
                : estado.EsValida
                    ? estado.LogGuardado
                        ? "Validacion correcta. El JSON de la API fue registrado."
                        : "Validacion correcta. No se pudo registrar el JSON en la tabla."
                    : FirstFilled(estado.Mensaje, "La API no valido la firma.");
        }
        catch (Exception ex)
        {
            firmaEstadoActual = null;
            mensajeValidacionFirma = ex.Message;
        }
        finally
        {
            validandoFirma = false;
        }
    }

    private string GetNombreModelo() =>
        FirstFilled(modelo.NomComercial, modelo.RazonSocial, $"Emisor #{modelo.Codigo}");

    private static string GetNombreEmisor(EmisorDto emisor) =>
        FirstFilled(emisor.NomComercial, emisor.RazonSocial, $"Emisor #{emisor.Codigo}");

    private static string FirstFilled(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private static string? ObtenerNombreArchivo(string? rutaArchivo) =>
        string.IsNullOrWhiteSpace(rutaArchivo)
            ? null
            : Path.GetFileName(rutaArchivo.Replace('\\', '/'));

    private static string FormatearFecha(DateTime? fecha) =>
        fecha?.ToString("dd/MM/yyyy") ?? "Sin dato";

    private static EmisorUpsertDto CrearModeloDesdeEmisor(EmisorDto item) => new()
    {
        Codigo = item.Codigo,
        RazonSocial = item.RazonSocial,
        Ruc = item.Ruc,
        NomComercial = item.NomComercial,
        DirEstablecimiento = item.DirEstablecimiento,
        LlevaContabilidad = item.LlevaContabilidad?.Trim()?.ToUpperInvariant() ?? string.Empty,
        LogoImagen = item.LogoImagen,
        ClaveInterna = item.ClaveInterna,
        DireccionMatriz = item.DireccionMatriz,
        Retenciones = string.IsNullOrWhiteSpace(item.Retenciones) ? "NO" : item.Retenciones,
        PathCertificado = item.PathCertificado,
        ClaveCertificado = null,
        Telefono = item.Telefono,
        Estado = item.Estado ?? true,
        IdUsuario = item.IdUsuario,
        CodEstablecimiento = item.CodEstablecimiento,
        CodPuntoEmision = item.CodPuntoEmision,
        Email = item.Email
    };

    private sealed class EmisorDto
    {
        public int Codigo { get; set; }
        public string? RazonSocial { get; set; }
        public string? Ruc { get; set; }
        public string? NomComercial { get; set; }
        public string? DirEstablecimiento { get; set; }
        public string? Email { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("llevacontabilidad")]
        public string? LlevaContabilidad { get; set; }
        public string? LogoImagen { get; set; }
        public string? DireccionMatriz { get; set; }
        public string? ClaveInterna { get; set; }
        public string? Retenciones { get; set; }
        public string? PathCertificado { get; set; }
        public bool TieneClaveCertificadoConfigurada { get; set; }
        public string? Telefono { get; set; }
        public bool? Estado { get; set; }
        public int? IdUsuario { get; set; }
        public string? CodEstablecimiento { get; set; }
        public string? CodPuntoEmision { get; set; }
    }

    private sealed class FirmaEstadoDto
