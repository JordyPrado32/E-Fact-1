@page "/e-sign/mis-firmas"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using Simetric.Services
@using Simetric.Services.ESign
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject HttpClient Http

<PageTitle>Mi firma activa | E-Rubrica</PageTitle>

<div class="signature-page">
    @if (cargandoPagina)
    {
        <ESignLoadingState Title="Consultando firma activa"
                           Description="Estamos verificando el certificado configurado para tu cuenta." />
    }
    else
    {
        <header class="signature-hero">
            <div class="signature-hero-copy">
                <span class="signature-eyebrow"><i class="bi bi-shield-lock"></i> Seguridad de firma</span>
                <h1>Tu firma electrónica, clara y bajo control</h1>
                <p>Consulta la firma activa de tu cuenta o valida temporalmente otro archivo sin reemplazar tu configuración.</p>
                <div class="signature-hero-actions">
                    <button type="button" class="btn-primary-signature" @onclick="CargarFirmaActivaAsync" disabled="@cargandoFirmaActiva">
                        <i class="bi @(cargandoFirmaActiva ? "bi-arrow-repeat" : "bi-arrow-clockwise")"></i>
                        <span>@(cargandoFirmaActiva ? "Consultando..." : "Actualizar información")</span>
                    </button>
                </div>
            </div>

            <div class="signature-hero-visual @(firmaActiva?.EsValida == true ? "is-valid" : "is-pending")">
                <div class="signature-seal">
                    <i class="bi @(firmaActiva?.EsValida == true ? "bi-patch-check-fill" : "bi-shield-exclamation")"></i>
                </div>
                <span>Estado actual</span>
                <strong>@EstadoFirmaActiva</strong>
                <small>@NombreEmisorActivo</small>
            </div>
        </header>

        <main class="signature-content-grid">
            <section class="signature-panel active-signature-panel">
                <div class="panel-heading">
                    <div class="panel-icon is-blue"><i class="bi bi-person-vcard"></i></div>
                    <div>
                        <span class="panel-kicker">Firma activa de la cuenta</span>
                        <h2>Informacion del certificado</h2>
                        <p>Datos obtenidos directamente desde la API de validación de firma.</p>
                    </div>
                </div>

                @if (cargandoFirmaActiva)
                {
                    <div class="panel-state">
                        <span class="signature-spinner"></span>
                        <div><strong>Consultando certificado</strong><small>Esto puede tardar unos segundos.</small></div>
                    </div>
                }
                else if (emisorActivo is null)
                {
                    <div class="panel-state is-warning">
                        <i class="bi bi-building-exclamation"></i>
                        <div><strong>No hay un emisor activo</strong><small>Registra un emisor para asociar y consultar su firma.</small></div>
                    </div>
                }
                else if (firmaActiva is null)
                {
                    <div class="panel-state is-warning">
                        <i class="bi bi-key"></i>
                        <div><strong>Firma pendiente de configurar</strong><small>@mensajeFirmaActiva</small></div>
                    </div>
                }
                else
                {
                    <div class="certificate-summary @(firmaActiva.EsValida ? "is-valid" : "is-invalid")">
                        <span class="certificate-summary-icon">
                            <i class="bi @(firmaActiva.EsValida ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                        </span>
                        <div>
                            <span>@(firmaActiva.EsValida ? "Certificado verificado" : "Certificado con observaciones")</span>
                            <strong>@(firmaActiva.NombreTitular ?? NombreEmisorActivo)</strong>
                            <small>@mensajeFirmaActiva</small>
                        </div>
                        <span class="certificate-status-pill">@(firmaActiva.EstadoVigencia ?? (firmaActiva.EsValida ? "VIGENTE" : "INVALIDA"))</span>
                    </div>

                    <div class="certificate-details">
                        <article>
                            <span><i class="bi bi-person"></i> Titular</span>
                            <strong>@Valor(firmaActiva.NombreTitular)</strong>
                        </article>
                        <article>
                            <span><i class="bi bi-credit-card-2-front"></i> Identificacion</span>
                            <strong>@Valor(firmaActiva.Identificacion ?? emisorActivo.Ruc)</strong>
                        </article>
                        <article>
                            <span><i class="bi bi-calendar-check"></i> Emitida</span>
                            <strong>@FormatearFecha(firmaActiva.FechaEmision)</strong>
                        </article>
                        <article>
                            <span><i class="bi bi-calendar-x"></i> Expira</span>
                            <strong>@FormatearFecha(firmaActiva.FechaExpiracion)</strong>
                        </article>
                        <article>
                            <span><i class="bi bi-hourglass-split"></i> Vigencia restante</span>
                            <strong>@FormatearDias(firmaActiva.DiasRestantes)</strong>
                        </article>
                        <article>
                            <span><i class="bi bi-bank"></i> Autoridad emisora</span>
                            <strong>@Valor(firmaActiva.Emisor)</strong>
                        </article>
                        <article class="detail-wide">
                            <span><i class="bi bi-upc-scan"></i> Numero de serie</span>
                            <strong>@Valor(firmaActiva.NumeroSerie)</strong>
                        </article>
                        <article class="detail-wide">
                            <span><i class="bi bi-fingerprint"></i> Huella digital</span>
                            <strong>@Valor(firmaActiva.HuellaDigital)</strong>
                        </article>
                    </div>
                }
            </section>

            <section class="signature-panel validation-panel">
                <div class="panel-heading">
                    <div class="panel-icon is-cyan"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <span class="panel-kicker">Validacion temporal</span>
                        <h2>Comprueba un archivo y su clave</h2>
                        <p>El archivo se usa una sola vez y no modifica la firma activa.</p>
                    </div>
                </div>

                <div class="privacy-note">
                    <i class="bi bi-incognito"></i>
                    <span>Ni el archivo ni la clave se guardan después de la validación.</span>
                </div>

                <div class="validation-form">
                    <label class="file-drop-zone @(archivoPrueba is null ? null : "is-ready")">
                        <InputFile class="file-drop-input" accept=".p12,application/x-pkcs12,application/pkcs12" OnChange="SeleccionarArchivoPrueba" />
                        <span class="file-drop-icon"><i class="bi @(archivoPrueba is null ? "bi-cloud-arrow-up" : "bi-file-earmark-check-fill")"></i></span>
                        <span class="file-drop-copy">
                            <strong>@(archivoPrueba?.Name ?? "Selecciona tu archivo .p12")</strong>
                            <small>@(archivoPrueba is null ? "Haz clic para buscar · Máximo 5 MB" : FormatearTamano(archivoPrueba.Size))</small>
                        </span>
                        <span class="file-action">@(archivoPrueba is null ? "Examinar" : "Cambiar")</span>
                    </label>

                    <label class="password-field">
                        <span>Clave del certificado</span>
                        <div>
                            <i class="bi bi-key"></i>
                            <input type="@(mostrarClavePrueba ? "text" : "password")"
                                   @bind="clavePrueba"
                                   autocomplete="new-password"
                                   placeholder="Escribe la clave del archivo" />
                            <button type="button"
                                    class="password-visibility"
                                    @onclick="AlternarVisibilidadClave"
                                    aria-label="@(mostrarClavePrueba ? "Ocultar clave" : "Mostrar clave")"
                                    title="@(mostrarClavePrueba ? "Ocultar clave" : "Mostrar clave")">
                                <i class="bi @(mostrarClavePrueba ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </label>

                    <button type="button" class="validate-button" @onclick="ValidarTemporalAsync" disabled="@(!PuedeValidarTemporalmente)">
                        <i class="bi @(validandoTemporalmente ? "bi-arrow-repeat" : "bi-shield-check")"></i>
                        <span>@(validandoTemporalmente ? "Validando con la API..." : "Validar archivo y clave")</span>
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajePrueba))
                {
                    <div class="validation-result @(resultadoPrueba?.EsValida == true ? "is-valid" : "is-invalid")">
                        <i class="bi @(resultadoPrueba?.EsValida == true ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                        <div>
                            <strong>@(resultadoPrueba?.EsValida == true ? "Firma y clave correctas" : "No se pudo validar")</strong>
                            <span>@mensajePrueba</span>
                        </div>
                    </div>
                }

                @if (resultadoPrueba is not null)
                {
                    <div class="temporary-result-details">
                        <span><small>Titular</small><strong>@Valor(resultadoPrueba.NombreTitular)</strong></span>
                        <span><small>Identificacion</small><strong>@Valor(resultadoPrueba.Identificacion)</strong></span>
                        <span><small>Estado</small><strong>@Valor(resultadoPrueba.EstadoVigencia)</strong></span>
                        <span><small>Expira</small><strong>@FormatearFecha(resultadoPrueba.FechaExpiracion)</strong></span>
                    </div>
                }
            </section>
        </main>
    }
</div>

@code {
    private const long MaxArchivoBytes = 5 * 1024 * 1024;

    private int usuarioId;
    private bool cargandoPagina = true;
    private bool cargandoFirmaActiva;
    private EmisorCuentaDto? emisorActivo;
    private FirmaDetalleDto? firmaActiva;
    private string mensajeFirmaActiva = "La firma activa aun no ha sido consultada.";

    private IBrowserFile? archivoPrueba;
    private string clavePrueba = string.Empty;
    private bool mostrarClavePrueba;
    private bool validandoTemporalmente;
    private FirmaDetalleDto? resultadoPrueba;
    private string? mensajePrueba;

    private bool PuedeValidarTemporalmente =>
        !validandoTemporalmente && archivoPrueba is not null && !string.IsNullOrWhiteSpace(clavePrueba);

    private void AlternarVisibilidadClave() => mostrarClavePrueba = !mostrarClavePrueba;

    private string NombreEmisorActivo => emisorActivo is null
        ? "Cuenta sin emisor"
        : FirstFilled(emisorActivo.NomComercial, emisorActivo.RazonSocial, $"Emisor #{emisorActivo.Codigo}");

    private string EstadoFirmaActiva => firmaActiva?.EsValida == true
        ? "Firma valida y vigente"
        : firmaActiva is null
            ? "Pendiente de validación"
            : "Requiere revision";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true ||
            !int.TryParse(user.FindFirst("IdUsuario")?.Value, out usuarioId) || usuarioId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var esSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);
        var acceso = await AppAccessService.CanAccessAsync(usuarioId, ESignRoutes.ServiceKey, esSuperAdmin);
        if (!acceso.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        await CargarFirmaActivaAsync();
        cargandoPagina = false;
    }

    private async Task CargarFirmaActivaAsync()
    {
        if (usuarioId <= 0 || cargandoFirmaActiva)
            return;

        cargandoFirmaActiva = true;
        firmaActiva = null;
        try
        {
            var emisores = await Http.GetFromJsonAsync<List<EmisorCuentaDto>>($"api/emisores?idUsuario={usuarioId}") ?? [];
            emisorActivo = emisores.FirstOrDefault();
            if (emisorActivo is null)
            {
                mensajeFirmaActiva = "No existe un emisor activo en esta cuenta.";
                return;
            }

            if (string.IsNullOrWhiteSpace(emisorActivo.PathCertificado) || !emisorActivo.TieneClaveCertificadoConfigurada)
            {
                mensajeFirmaActiva = "Carga el archivo .p12 y su clave desde Configurar firma.";
                return;
            }

            firmaActiva = await Http.GetFromJsonAsync<FirmaDetalleDto>(
                $"api/emisores/{emisorActivo.Codigo}/firma/estado?idUsuario={usuarioId}");
            mensajeFirmaActiva = firmaActiva is null
                ? "La API no devolvió información del certificado."
                : FirstFilled(firmaActiva.Mensaje, firmaActiva.EsValida
                    ? "La firma configurada es correcta y se encuentra vigente."
                    : "La firma configurada no pudo validarse.");
        }
        catch (Exception ex)
        {
            mensajeFirmaActiva = $"No fue posible consultar la firma activa: {ex.Message}";
        }
        finally
        {
            cargandoFirmaActiva = false;
        }
    }

    private void SeleccionarArchivoPrueba(InputFileChangeEventArgs e)
    {
        resultadoPrueba = null;
        mensajePrueba = null;
        archivoPrueba = e.FileCount == 1 ? e.File : null;

        if (archivoPrueba is null || !string.Equals(Path.GetExtension(archivoPrueba.Name), ".p12", StringComparison.OrdinalIgnoreCase))
        {
            archivoPrueba = null;
            mensajePrueba = "Selecciona un único archivo con extensión .p12.";
        }
        else if (archivoPrueba.Size <= 0 || archivoPrueba.Size > MaxArchivoBytes)
        {
            archivoPrueba = null;
            mensajePrueba = "El archivo debe tener contenido y no superar 5 MB.";
        }
    }

    private async Task ValidarTemporalAsync()
    {
        if (!PuedeValidarTemporalmente || archivoPrueba is null)
            return;

        validandoTemporalmente = true;
        resultadoPrueba = null;
        mensajePrueba = null;
        try
        {
            await using var stream = archivoPrueba.OpenReadStream(MaxArchivoBytes);
            using var archivoContent = new StreamContent(stream);
            archivoContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(archivoPrueba.ContentType) ? "application/x-pkcs12" : archivoPrueba.ContentType);
            using var form = new MultipartFormDataContent();
            form.Add(archivoContent, "archivo", archivoPrueba.Name);
            form.Add(new StringContent(clavePrueba), "clave");

            using var response = await Http.PostAsync($"api/emisores/firma/validar-temporal?idUsuario={usuarioId}", form);
            if (!response.IsSuccessStatusCode)
            {
                mensajePrueba = LimpiarMensaje(await response.Content.ReadAsStringAsync());
                return;
            }

            resultadoPrueba = await response.Content.ReadFromJsonAsync<FirmaDetalleDto>();
            mensajePrueba = resultadoPrueba?.Mensaje ?? "La API no devolvió el resultado de la validación.";
        }
        catch (Exception ex)
        {
            mensajePrueba = $"No fue posible validar la firma: {ex.Message}";
        }
        finally
        {
            clavePrueba = string.Empty;
            mostrarClavePrueba = false;
            archivoPrueba = null;
            validandoTemporalmente = false;
        }
    }

    private static string FormatearFecha(DateTime? fecha) => fecha?.ToString("dd/MM/yyyy") ?? "Sin dato";
    private static string FormatearDias(int? dias) => dias is null ? "Sin dato" : dias < 0 ? "Vencida" : $"{dias} días";
    private static string FormatearTamano(long bytes) => $"{bytes / 1024d:0.0} KB · Listo para validar";
    private static string Valor(string? valor) => string.IsNullOrWhiteSpace(valor) ? "Sin dato" : valor;
    private static string FirstFilled(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;
    private static string LimpiarMensaje(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "La API no pudo validar la firma." : value.Trim('"', ' ', '\r', '\n');

    private sealed class EmisorCuentaDto
    {
        public int Codigo { get; set; }
        public string? RazonSocial { get; set; }
        public string? NomComercial { get; set; }
        public string? Ruc { get; set; }
        public string? PathCertificado { get; set; }
        public bool TieneClaveCertificadoConfigurada { get; set; }
    }

    private sealed class FirmaDetalleDto
    {
        public bool EsValida { get; set; }
        public string? EstadoVigencia { get; set; }
        public string? Mensaje { get; set; }
        public string? NombreTitular { get; set; }
        public string? Identificacion { get; set; }
        public string? Emisor { get; set; }
        public string? NumeroSerie { get; set; }
        public string? HuellaDigital { get; set; }
        public DateTime? FechaEmision { get; set; }
        public DateTime? FechaExpiracion { get; set; }
        public int? DiasRestantes { get; set; }
    }
}
