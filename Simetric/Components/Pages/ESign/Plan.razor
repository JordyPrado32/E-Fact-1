@page "/e-rubrica/configuracion/plan"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.DTOs
@using Simetric.Services
@using Simetric.Services.ESign
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject SolicitudService SolicitudService

<PageTitle>Mi Plan Disponible | E-Rúbrica</PageTitle>

<div class="esign-page">
    @if (cargando)
    {
        <ESignLoadingState
            Title="Cargando informacion del Plan"
            Description="Revisando tu suscripcion, vigencia y beneficios activos de e-rubrica." />
    }
    else
    {
        <header class="esign-header-section">
            <div class="header-content">
                <span class="header-kicker">Configuración</span>
                <h1>Mi Plan Disponible</h1>
                <p>Consulta los detalles de tu suscripción activa para la firma y validación de documentos electrónicos.</p>
            </div>
            <button class="btn-back" @onclick="IrAlInicio">
                <i class="bi bi-arrow-left"></i>
                <span>Volver al inicio</span>
            </button>
        </header>

        <section class="plan-details-container">
            <div class="plan-main-card">
                <div class="plan-hero">
                    <div class="plan-hero-copy">
                        <div class="plan-badge-row">
                            <span class="plan-status-badge @(diasDisponibles > 0 ? "status-active" : "status-inactive")">
                                <i class="bi @(diasDisponibles > 0 ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                                @(diasDisponibles > 0 ? "Firma vigente" : "Sin firma vigente")
                            </span>
                            <span class="plan-id-badge">Servicio: E-Rúbrica</span>
                        </div>

                        <div class="plan-title-section">
                            <i class="bi bi-key-fill title-icon"></i>
                            <div>
                                <span class="plan-hero-kicker">Tu acceso digital</span>
                                <h2>Plan de E-Rúbrica</h2>
                                <p>Firma, valida y protege tus documentos con respaldo legal.</p>
                            </div>
                        </div>
                    </div>

                    <div class="plan-orbit" aria-label="Días disponibles">
                        <span class="orbit-ring"></span>
                        <i class="bi bi-hourglass-split"></i>
                        <strong>@(tieneFirmaPagada ? diasDisponibles : 0)</strong>
                        <small>DÍAS RESTANTES</small>
                    </div>
                </div>

                <div class="plan-card-body">
                    <div class="plan-meta-grid">
                        <div class="meta-item">
                            <span class="meta-label">Fecha de Vencimiento</span>
                            <strong class="meta-value">
                                @(fechaExpiracion.HasValue ? fechaExpiracion.Value.ToString("dd/MM/yyyy") : "No disponible")
                            </strong>
                        </div>

                        <div class="meta-item">
                            <span class="meta-label">Estado del Acceso</span>
                            <strong class="meta-value text-success">@estadoAcceso</strong>
                        </div>

                    </div>

                    @if (!tieneFirmaPagada)
                    {
                        <div class="plan-empty-message">
                            <i class="bi bi-shield-lock"></i>
                            <span>Para acceder a todas las funciones de e-Rúbrica primero compra una firma.</span>
                        </div>
                    }

                    <div class="plan-actions">
                        <button type="button" class="esign-btn-primary" @onclick="SolicitarNuevaFirma">
                            <i class="bi bi-plus-circle"></i>
                            <span>Solicitar Nueva Firma</span>
                        </button>
                        <a href="/solicitud" class="esign-btn-secondary">
                            <i class="bi bi-folder-check"></i>
                            <span>Ver Mis Trámites</span>
                        </a>
                    </div>
                </div>
            </div>

            <aside class="plan-features-card">
                <h3>Beneficios Incluidos</h3>
                <ul class="features-list">
                    <li>
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>Firmado de PDF Ilimitado</strong>
                            <span>Firma digitalmente todos los contratos y documentos que necesites.</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>Estándar XAdES / PAdES</strong>
                            <span>Garantiza plena validez legal ante el SRI, aduanas y juzgados del Ecuador.</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>Seguridad y Respaldo</strong>
                            <span>Tus firmas y contraseñas no se almacenan, garantizando confidencialidad.</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>Soporte Prioritario</strong>
                            <span>Atención técnica preferencial para resolver bloqueos o dudas del certificado.</span>
                        </div>
                    </li>
                </ul>
            </aside>
        </section>
    }
</div>

@code {
    private bool cargando = true;
    private bool tieneFirmaPagada;
    private int diasDisponibles;
    private DateTime? fechaExpiracion;
    private string estadoAcceso = "Inactivo";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out var userId) || userId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(userId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);

        var solicitudes = await SolicitudService.ObtenerSolicitudesClienteAsync(userId);
        var firmaPagada = solicitudes
            .Where(s => s.SolPagoExitoso)
            .OrderByDescending(s => s.SolFechaPago ?? s.SolFechaSolicitud)
            .FirstOrDefault();

        tieneFirmaPagada = firmaPagada is not null;
        if (firmaPagada is not null)
        {
            var fechaInicio = firmaPagada.SolFechaPago ?? firmaPagada.SolFechaSolicitud;
            fechaExpiracion = fechaInicio.AddYears(ParseVigenciaAnios(firmaPagada.SolVigencia));
            diasDisponibles = Math.Max(0, (fechaExpiracion.Value.Date - DateTime.Today).Days);
            estadoAcceso = diasDisponibles > 0 ? "Activo" : "Vencido";
        }
        else
        {
            estadoAcceso = "Compra una firma";
        }

        cargando = false;
    }

    private void IrAlInicio() => NavManager.NavigateTo("/e-rubrica");
    private void SolicitarNuevaFirma() => NavManager.NavigateTo("/solicitud/nueva");

    private static int ParseVigenciaAnios(string? vigencia)
    {
        if (string.IsNullOrWhiteSpace(vigencia))
            return 1;

        var match = System.Text.RegularExpressions.Regex.Match(vigencia, @"\d+");
        return match.Success && int.TryParse(match.Value, out var anios) ? anios : 1;
    }
}
