@page "/e-sign/documentos/estampar"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Security.Cryptography.X509Certificates
@using System.Security.Claims
@using System.Text.Json
@using Simetric.Data
@using Simetric.Models
@using Simetric.Services
@using Simetric.Services.ESign
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject FirmaStampApiService FirmaStampApiService
@inject FirmaPathResolver FirmaPathResolver
@inject EmisorCertificadoProtector CertificadoProtector
@inject IJSRuntime JS

<PageTitle>Estampar documento | E-RÚBRICA</PageTitle>

<div class="stamp-page">
    @if (cargando)
    {
        <ESignLoadingState
            Title="Cargando estampado"
            Description="Preparando tu certificado, sello visual y herramientas para firmar el PDF." />
    }
    else
    {
        <header class="stamp-header esign-document-hero">
            <div>
                <span class="header-kicker">Documentos Electrónicos</span>
                <h1>Firmar PDF</h1>
                <p>Carga un PDF y elige donde se colocará el sello.</p>
            </div>
            <div class="header-actions">
                <span class="esign-hero-chip"><i class="bi bi-file-earmark-lock"></i> Firma segura</span>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="stamp-alert @(esError ? "is-error" : "is-ok")" role="alert">
                <i class="bi @(esError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>
                <span>@mensaje</span>
            </div>
        }

        <section class="stamp-grid stamp-grid-setup">
            <article class="stamp-panel">
                <div class="panel-heading">
                    <span class="header-kicker">Documento</span>
                    <h2>PDF a estampar</h2>
                    <p>Selecciona el archivo que recibirá el sello visible.</p>
                </div>

                <div class="file-grid">
                    <InputFile id="stampPdfInput" class="file-input" accept=".pdf,application/pdf" OnChange="SeleccionarPdf" />
                    <label for="stampPdfInput" class="stamp-file-card @(pdfFile is null ? null : "is-ready")">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <strong>PDF</strong>
                        <span>@(pdfFile?.Name ?? "Seleccionar o arrastrar PDF")</span>
                    </label>
                </div>
            </article>

            <article class="stamp-panel issuer-panel">
                <div class="panel-heading">
                    <span class="header-kicker">Emisor</span>
                    <h2>Firma y clave</h2>
                    <p>Configura aquí los datos que se usarán para estampar este PDF.</p>
                </div>
                <div class="issuer-summary @(emisorConfigurado ? "is-ready" : "is-missing")">
                    <div class="issuer-icon">
                        <i class="bi bi-file-earmark-lock"></i>
                    </div>
                    <div>
                        <strong>@(emisor?.RazonSocial ?? "Emisor E-Rúbrica")</strong>
                        <span>@estadoEmisorMensaje</span>
                    </div>
                </div>

                @if (emisoresCuenta.Count > 1)
                {
                    <div class="issuer-selector">
                        <label for="stampIssuerSelect">Firma disponible</label>
                        <div class="issuer-select-control">
                            <i class="bi bi-building-check"></i>
                            <select id="stampIssuerSelect" value="@emisor?.Codigo" @onchange="CambiarEmisor">
                                @foreach (var item in emisoresCuenta)
                                {
                                    <option value="@item.Codigo">@ObtenerEtiquetaEmisor(item)</option>
                                }
                            </select>
                            <i class="bi bi-chevron-down"></i>
                        </div>
                        <small>Se muestran únicamente las firmas de los emisores de esta cuenta.</small>
                    </div>
                }

                <div class="stamp-config-grid">
                    <InputFile id="stampP12Input" class="file-input" accept=".p12,application/x-pkcs12,application/pkcs12" OnChange="SubirP12Async" />
                    <label for="stampP12Input" class="stamp-config-card @(TieneCertificadoDisponible ? "is-ready" : "is-missing")">
                        <span class="config-card-icon"><i class="bi bi-file-earmark-lock"></i></span>
                        <span class="config-card-copy">
                            <strong>Firma .p12</strong>
                            <small>@NombreCertificadoConfiguracion</small>
                        </span>
                    </label>

                    <div class="stamp-config-card stamp-config-input @(TieneClaveDisponible ? "is-ready" : "is-missing")">
                        <span class="config-card-icon"><i class="bi bi-key"></i></span>
                        <span class="config-card-copy">
                            <label for="stampCertificatePassword">Clave</label>
                            <input type="password"
                                   id="stampCertificatePassword"
                                   @bind="claveCertificadoInput"
                                   placeholder="Clave de la firma"
                                   autocomplete="new-password" />
                        </span>
                    </div>
                </div>

                <div class="issuer-actions">
                    <button type="button" class="esign-btn-secondary" @onclick="GuardarConfiguracionFirmaAsync" disabled="@guardandoConfiguracion">
                        <i class="bi @(guardandoConfiguracion ? "bi-arrow-repeat" : "bi-save")"></i>
                        <span>@(guardandoConfiguracion ? "Guardando..." : "Guardar y usar para estampar")</span>
                    </button>
                </div>
            </article>
        </section>

        <section class="stamp-panel stamp-preview-panel">
            <div class="panel-heading">
                <span class="header-kicker">Ubicación del sello</span>
                <h2>Selección visual en el PDF</h2>
                <p>Haz clic sobre la página o arrastra el recuadro para mover el sello. El ancho se mantiene fijo en 60 mm.</p>
            </div>

            <div class="pdf-selector">
                <div class="pdf-toolbar">
                    <button type="button" id="stampPreviousPage" aria-label="Página anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span>Página <strong id="stampCurrentPage">1</strong> de <strong id="stampPageCount">0</strong></span>
                    <button type="button" id="stampNextPage" aria-label="Página siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <span class="selection-status" id="stampSelectionStatus">Carga un PDF para seleccionar la posicion.</span>
                </div>
                <div class="pdf-stage" id="stampPdfStage">
                    <canvas id="stampPdfCanvas" hidden></canvas>
                    <div class="stamp-footprint" id="stampFootprint" hidden>
                        <span class="position-dot"></span>
                        <button
                            type="button"
                            class="resize-handle"
                            id="stampResizeHandle"
                            aria-label="Tamano fijo del sello"
                            title="Ancho fijo: 60 mm"></button>
                    </div>
                    <div class="pdf-placeholder" id="stampPdfPlaceholder">
                        <strong>Vista previa del documento</strong>
                        <span>Despues de cargar el PDF, haz clic sobre la pagina.</span>
                    </div>
                </div>
            </div>

            <div class="stamp-preference">
                <label>
                    <input type="checkbox" @bind="usarPreferenciaSiempre" @bind:after="CambiarUsoPreferenciaAsync" />
                    <span>Aplicar mi ubicación guardada automáticamente al cargar un PDF</span>
                </label>
                <p>Guarda una posicion cuando normalmente firmas en el mismo lugar. Si activas esta opcion, se colocara sola en los proximos PDFs.</p>
                <div class="preference-actions">
                    <button type="button" class="action-btn preference-btn" @onclick="GuardarPreferenciaAsync" title="Guardar ubicación preferida">
                        <i class="bi bi-bookmark-check"></i>
                    </button>
                    <button type="button" class="action-btn preference-btn" @onclick="AplicarPreferenciaAsync" disabled="@(!tienePreferenciaGuardada)" title="Usar ubicación guardada">
                        <i class="bi bi-pin-map"></i>
                    </button>
                </div>
            </div>

            <div class="stamp-actions stamp-main-actions">
                <button type="button" class="esign-btn-primary" @onclick="EstamparAsync" disabled="@procesando">
                    <i class="bi @(procesando ? "bi-arrow-repeat" : "bi-pen")"></i>
                    <span>@(procesando ? "Procesando..." : "Estampar PDF")</span>
                </button>
            </div>
        </section>

        @if (resultado is not null)
        {
            <section class="stamp-panel stamp-result">
                <div>
                    <span class="header-kicker">Resultado</span>
                    <h2>Documento estampado</h2>
                    <p>@resultado.Nombre | @resultado.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="result-actions">
                    <a class="action-btn" href="@resultado.Url" target="_blank" title="Abrir PDF">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <a class="action-btn" href="@resultado.Url" download="@resultado.Nombre" title="Descargar PDF">
                        <i class="bi bi-download"></i>
                    </a>
                </div>
            </section>
        }
    }
</div>

@code {
    private const long MaxPdfSize = 10 * 1024 * 1024;
    private const long MaxCertificadoSize = 5 * 1024 * 1024;
    private const double StampWidthMm = 60;

    private bool cargando = true;
    private bool procesando;
    private bool guardandoConfiguracion;
    private bool esError;
    private int currentUserId;
    private string? mensaje;
    private int pagina = 1;
    private double xMm = 10;
    private double yMm = 10;
    private double anchoMm = StampWidthMm;
    private IBrowserFile? pdfFile;
    private Emisor? emisor;
    private List<Emisor> emisoresCuenta = [];
    private bool emisorConfigurado;
    private string estadoEmisorMensaje = "Validando configuración de E-Rúbrica...";
    private string? rutaCertificadoEmisor;
    private string? certificadoSeleccionado;
    private string? claveCertificadoInput;
    private string? pathCertificadoPendiente;
    private bool usarPreferenciaSiempre;
    private bool tienePreferenciaGuardada;
    private StampPreference? preferenciaGuardada;
    private ResultadoEstampado? resultado;
    private DotNetObjectReference<EstamparDocumento>? dotNetRef;
    private IJSObjectReference? stampSelectorModule;
    private IJSObjectReference? stampSelectorInstance;
    private bool stampSelectorInitialized;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) || currentUserId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        await CargarEmisorAsync();
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cargando || stampSelectorInitialized)
            return;

        stampSelectorInitialized = true;
        dotNetRef = DotNetObjectReference.Create(this);
        stampSelectorModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/esignStampSelector.js");
        stampSelectorInstance = await stampSelectorModule.InvokeAsync<IJSObjectReference>(
            "init",
            new
            {
                pdfInputId = "stampPdfInput",
                canvasId = "stampPdfCanvas",
                stageId = "stampPdfStage",
                placeholderId = "stampPdfPlaceholder",
                footprintId = "stampFootprint",
                resizeHandleId = "stampResizeHandle",
                previousButtonId = "stampPreviousPage",
                nextButtonId = "stampNextPage",
                currentPageLabelId = "stampCurrentPage",
                pageCountLabelId = "stampPageCount",
                selectionStatusId = "stampSelectionStatus"
            },
            dotNetRef);

        await CargarPreferenciaAsync();
    }

    private void SeleccionarPdf(InputFileChangeEventArgs e) => pdfFile = e.File;

    private bool TieneCertificadoDisponible =>
        !string.IsNullOrWhiteSpace(pathCertificadoPendiente) ||
        !string.IsNullOrWhiteSpace(rutaCertificadoEmisor) ||
        !string.IsNullOrWhiteSpace(emisor?.PathCertificado);

    private bool TieneClaveDisponible =>
        !string.IsNullOrWhiteSpace(claveCertificadoInput) ||
        !string.IsNullOrWhiteSpace(emisor?.ClaveCertificado);

    private string NombreCertificadoConfiguracion =>
        certificadoSeleccionado
        ?? (TieneCertificadoDisponible ? "Firma disponible" : "Seleccionar .p12");

    [JSInvokable]
    public async Task OnStampSelectionChanged(int selectedPage, double selectedX, double selectedY, double selectedWidth)
    {
        pagina = selectedPage;
        xMm = Math.Round(selectedX, 2);
        yMm = Math.Round(selectedY, 2);
        anchoMm = StampWidthMm;
        if (usarPreferenciaSiempre)
            await GuardarPreferenciaInternaAsync(false, false);

        StateHasChanged();
    }

    [JSInvokable]
    public void OnStampPageChanged(int selectedPage)
    {
        pagina = selectedPage;
        StateHasChanged();
    }

    private async Task EstamparAsync()
    {
        mensaje = null;
        esError = false;
        resultado = null;

        if (!ValidarFormulario())
            return;

        procesando = true;
        try
        {
            var recursosFirma = await ResolverRecursosFirmaAsync();
            if (recursosFirma is null)
                return;

            var apiResult = await FirmaStampApiService.EstamparAsync(
                pdfFile!,
                recursosFirma.Certificado,
                recursosFirma.Clave,
                "Firma digital del documento",
                null,
                pagina,
                xMm,
                yMm,
                anchoMm);

            if (!apiResult.Success || apiResult.Pdf is null)
            {
                SetMensaje(apiResult.Message, true);
                return;
            }

            var downloadFileName = CrearNombrePdfFirmado(pdfFile!.Name);
            var storedFileName = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.NewGuid():N}_{downloadFileName}";
            var relativeDirectory = Path.Combine("uploads", "e-rubrica", "estampados", currentUserId.ToString());
            var physicalDirectory = Path.Combine(HostEnvironment.WebRootPath, relativeDirectory);
            Directory.CreateDirectory(physicalDirectory);

            var physicalPath = Path.Combine(physicalDirectory, storedFileName);
            await File.WriteAllBytesAsync(physicalPath, apiResult.Pdf);

            resultado = new ResultadoEstampado(
                downloadFileName,
                "/" + Path.Combine(relativeDirectory, storedFileName).Replace('\\', '/'),
                DateTime.Now,
                apiResult.OriginalSha256,
                apiResult.OutputSha256);

            SetMensaje("PDF estampado correctamente.", false);
        }
        finally
        {
            procesando = false;
        }
    }

    private bool ValidarFormulario()
    {
        if (pdfFile is null)
            return Error("Selecciona el PDF.");

        if (!emisorConfigurado)
            return Error(estadoEmisorMensaje);

        if (pdfFile.Size <= 0 || pdfFile.Size > MaxPdfSize)
            return Error("El PDF debe pesar maximo 10 MB.");

        if (!EsExtension(pdfFile.Name, ".pdf"))
            return Error("El documento debe ser PDF.");

        if (pagina < 1)
            return Error("La pagina debe ser mayor que cero.");

        if (xMm < 0 || xMm > 2000 || yMm < 0 || yMm > 2000)
            return Error("X e Y deben estar entre 0 y 2000 mm.");

        anchoMm = StampWidthMm;

        return true;
    }

    private async Task CargarEmisorAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var usuario = await context.Usuarios
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.IdUsuario == currentUserId);

        var idUsuarioEmisor = usuario?.estadoAsociado == true && usuario.idJefe is > 0
            ? usuario.idJefe.Value
            : currentUserId;

        emisoresCuenta = await context.Emisores
            .AsNoTracking()
            .Where(item => item.IdUsuario == idUsuarioEmisor && item.Estado && !item.EsEmisorSistema)
            .OrderByDescending(item => item.Codigo)
            .ToListAsync();

        var codigoSeleccionado = emisor?.Codigo;
        emisor = emisoresCuenta.FirstOrDefault(item => item.Codigo == codigoSeleccionado)
            ?? emisoresCuenta.FirstOrDefault(item =>
        {
            var ruta = FirmaPathResolver.ResolverRutaExistente(item.PathCertificado);
            return !string.IsNullOrWhiteSpace(item.ClaveCertificado) &&
                !string.IsNullOrWhiteSpace(ruta);
        }) ?? emisoresCuenta.FirstOrDefault();

        emisorConfigurado = ValidarConfiguracionEmisor(out var estado);
        estadoEmisorMensaje = estado;
        await Task.CompletedTask;
    }

    private void CambiarEmisor(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var codigo))
            return;

        var emisorSeleccionado = emisoresCuenta.FirstOrDefault(item => item.Codigo == codigo);
        if (emisorSeleccionado is null)
            return;

        emisor = emisorSeleccionado;
        certificadoSeleccionado = null;
        claveCertificadoInput = null;
        pathCertificadoPendiente = null;
        emisorConfigurado = ValidarConfiguracionEmisor(out var estado);
        estadoEmisorMensaje = estado;
        mensaje = null;
    }

    private string ObtenerEtiquetaEmisor(Emisor item)
    {
        var nombre = string.IsNullOrWhiteSpace(item.RazonSocial)
            ? item.NomComercial
            : item.RazonSocial;
        var estado = FirmaPathResolver.ResolverRutaExistente(item.PathCertificado) is not null &&
            !string.IsNullOrWhiteSpace(item.ClaveCertificado)
                ? "lista"
                : "incompleta";

        return $"{nombre ?? "Emisor"} · {item.Ruc} · {estado}";
    }

    private async Task SubirP12Async(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.FileCount != 1 || e.File is null)
            {
                SetMensaje("Selecciona una sola firma .p12.", true);
                return;
            }

            var file = e.File;
            if (!EsExtension(file.Name, ".p12"))
            {
                SetMensaje("Solo se permite una firma en formato .p12.", true);
                return;
            }

            var contentType = (file.ContentType ?? string.Empty).Trim().ToLowerInvariant();
            if (contentType is not "" and not "application/x-pkcs12" and not "application/pkcs12" and not "application/x-pkcs-12" and not "application/octet-stream")
            {
                SetMensaje("La firma seleccionada no tiene un formato valido.", true);
                return;
            }

            if (file.Size <= 0)
            {
                SetMensaje("El archivo de firma esta vacio.", true);
                return;
            }

            if (file.Size > MaxCertificadoSize)
            {
                SetMensaje("La firma .p12 excede el tamano maximo de 5 MB.", true);
                return;
            }

            await using var stream = file.OpenReadStream(MaxCertificadoSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            if (bytes.Length == 0)
            {
                SetMensaje("No se pudo leer la firma seleccionada.", true);
                return;
            }

            var relativePath = $"certs/path/{Guid.NewGuid():N}.p12";
            var physicalPath = Path.Combine(
                HostEnvironment.ContentRootPath,
                "App_Data",
                relativePath.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(Path.GetDirectoryName(physicalPath)!);
            await File.WriteAllBytesAsync(physicalPath, bytes);

            pathCertificadoPendiente = relativePath;
            certificadoSeleccionado = file.Name;
            SetMensaje("Firma .p12 cargada. Guarda para usarla al estampar.", false);
        }
        catch (Exception ex)
        {
            SetMensaje(FormatearMensajeError(ex.Message), true);
        }
    }

    private async Task GuardarConfiguracionFirmaAsync()
    {
        if (emisor is null)
        {
            SetMensaje("No se encontró un emisor activo para guardar la firma y clave.", true);
            return;
        }

        var pathCertificado = pathCertificadoPendiente ?? emisor.PathCertificado;
        var claveNueva = claveCertificadoInput?.Trim();

        if (string.IsNullOrWhiteSpace(pathCertificado))
        {
            SetMensaje("Sube la firma .p12 antes de guardar.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(claveNueva) && string.IsNullOrWhiteSpace(emisor.ClaveCertificado))
        {
            SetMensaje("Ingresa la clave de la firma antes de guardar.", true);
            return;
        }

        guardandoConfiguracion = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var emisorDb = await context.Emisores.FirstOrDefaultAsync(item => item.Codigo == emisor.Codigo && item.Estado);
            if (emisorDb is null)
            {
                SetMensaje("No se encontró el emisor activo para actualizar.", true);
                return;
            }

            emisorDb.PathCertificado = pathCertificado.Trim();
            if (!string.IsNullOrWhiteSpace(claveNueva))
                emisorDb.ClaveCertificado = CertificadoProtector.ProtegerClave(claveNueva);

            await context.SaveChangesAsync();

            certificadoSeleccionado = null;
            claveCertificadoInput = null;
            pathCertificadoPendiente = null;

            await CargarEmisorAsync();
            SetMensaje("Firma y clave guardadas. Ya puedes estampar el PDF.", false);
        }
        catch (Exception ex)
        {
            SetMensaje(FormatearMensajeError(ex.Message), true);
        }
        finally
        {
            guardandoConfiguracion = false;
        }
    }

    private bool ValidarConfiguracionEmisor(out string estado)
    {
        rutaCertificadoEmisor = null;

        if (emisor is null)
        {
            estado = "No se encontró un emisor activo para E-Rúbrica. Configura un emisor, firma .p12 y clave.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(emisor.PathCertificado))
        {
            estado = "Falta la firma .p12. Sube o selecciona el certificado para estampar documentos.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(emisor.ClaveCertificado))
        {
            estado = "Falta la clave de la firma. Registra la clave para estampar documentos.";
            return false;
        }

        rutaCertificadoEmisor = FirmaPathResolver.ResolverRutaExistente(emisor.PathCertificado);
        if (string.IsNullOrWhiteSpace(rutaCertificadoEmisor))
        {
            estado = "El certificado configurado no está disponible. Sube o selecciona nuevamente la firma .p12.";
            return false;
        }

        estado = $"RUC {emisor.Ruc} | firma y clave listas para E-Rúbrica.";
        return true;
    }

    private async Task<RecursosFirma?> ResolverRecursosFirmaAsync()
    {
        if (emisor is null)
            return null;

        var certificado = CrearCertificadoDesdeEmisor();
        if (certificado is null)
        {
            Error("No se encontro el certificado configurado en EFact.");
            return null;
        }

        if (certificado.Content.Length <= 0 || certificado.Content.Length > 1024 * 1024)
        {
            Error("El certificado configurado en EFact debe pesar maximo 1 MB.");
            return null;
        }

        var clave = ObtenerClaveCertificado();
        if (string.IsNullOrWhiteSpace(clave))
        {
            Error("El emisor no tiene clave de certificado configurada en EFact.");
            return null;
        }

        await Task.CompletedTask;
        return new RecursosFirma(certificado, clave);
    }

    private FirmaStampApiFile? CrearCertificadoDesdeEmisor()
    {
        if (emisor is null)
            return null;

        var rutaCertificado = rutaCertificadoEmisor ?? FirmaPathResolver.ResolverRutaExistente(emisor.PathCertificado);
        if (string.IsNullOrWhiteSpace(rutaCertificado))
        {
            var clave = ObtenerClaveCertificado();
            if (!string.IsNullOrWhiteSpace(clave))
                rutaCertificado = ResolverCertificadoPorClaveYRuc(clave);
        }

        if (string.IsNullOrWhiteSpace(rutaCertificado) || !File.Exists(rutaCertificado))
            return null;

        var extension = Path.GetExtension(rutaCertificado);
        var contentType = string.Equals(extension, ".pfx", StringComparison.OrdinalIgnoreCase)
            ? "application/x-pkcs12"
            : "application/x-pkcs12";
        return new FirmaStampApiFile(
            File.ReadAllBytes(rutaCertificado),
            $"certificado{extension}",
            contentType);
    }

    private string? ObtenerClaveCertificado()
    {
        if (emisor is null)
            return null;

        var password = CertificadoProtector.DesprotegerClave(emisor.ClaveCertificado);
        return string.IsNullOrWhiteSpace(password)
            ? emisor.ClaveCertificado?.Trim()
            : password;
    }

    private string? ResolverCertificadoPorClaveYRuc(string password)
    {
        var ruc = NormalizarDigitos(emisor?.Ruc);
        var cedulaRuc = ruc?.Length >= 10 ? ruc[..10] : null;
        var rutas = EnumerarCertificadosLocales();

        foreach (var ruta in rutas)
        {
            try
            {
                var bytes = File.ReadAllBytes(ruta);
                using var certificado = new X509Certificate2(
                    bytes,
                    password,
                    X509KeyStorageFlags.EphemeralKeySet | X509KeyStorageFlags.Exportable);
                var textoCertificado = $"{certificado.Subject} {certificado.Issuer}";

                if ((!string.IsNullOrWhiteSpace(ruc) && textoCertificado.Contains(ruc, StringComparison.Ordinal)) ||
                    (!string.IsNullOrWhiteSpace(cedulaRuc) && textoCertificado.Contains(cedulaRuc, StringComparison.Ordinal)))
                {
                    rutaCertificadoEmisor = ruta;
                    return ruta;
                }
            }
            catch
            {
                continue;
            }
        }

        return null;
    }

    private IEnumerable<string> EnumerarCertificadosLocales()
    {
        var baseDirectory = Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "certs");
        foreach (var subDirectory in new[] { "path", "system" })
        {
            var directory = Path.Combine(baseDirectory, subDirectory);
            if (!Directory.Exists(directory))
                continue;

            foreach (var file in Directory.EnumerateFiles(directory, "*.p12"))
                yield return file;
        }
    }

    private static string? NormalizarDigitos(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return null;

        var digitos = new string(valor.Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digitos) ? null : digitos;
    }

    private async Task CargarPreferenciaAsync()
    {
        var raw = await JS.InvokeAsync<string?>("localStorage.getItem", PreferenceKey);
        preferenciaGuardada = string.IsNullOrWhiteSpace(raw)
            ? null
            : JsonSerializer.Deserialize<StampPreference>(raw);
        if (preferenciaGuardada is not null)
            preferenciaGuardada = preferenciaGuardada with { WidthMm = StampWidthMm };

        tienePreferenciaGuardada = preferenciaGuardada is not null;

        var auto = await JS.InvokeAsync<string?>("localStorage.getItem", PreferenceAutoKey);
        usarPreferenciaSiempre = string.Equals(auto, "true", StringComparison.OrdinalIgnoreCase);

        if (stampSelectorInstance is not null)
        {
            await stampSelectorInstance.InvokeVoidAsync(
                "setPreferredSelection",
                preferenciaGuardada,
                usarPreferenciaSiempre);
        }
    }

    private async Task GuardarPreferenciaAsync()
    {
        await GuardarPreferenciaInternaAsync(true, true);
    }

    private async Task GuardarPreferenciaInternaAsync(bool mostrarMensaje, bool sincronizarSelector)
    {
        anchoMm = StampWidthMm;
        preferenciaGuardada = new StampPreference(pagina, xMm, yMm, StampWidthMm);
        tienePreferenciaGuardada = true;
        var raw = JsonSerializer.Serialize(preferenciaGuardada);
        await JS.InvokeVoidAsync("localStorage.setItem", PreferenceKey, raw);
        await JS.InvokeVoidAsync("localStorage.setItem", PreferenceAutoKey, usarPreferenciaSiempre ? "true" : "false");
        if (sincronizarSelector && stampSelectorInstance is not null)
            await stampSelectorInstance.InvokeVoidAsync("setPreferredSelection", preferenciaGuardada, usarPreferenciaSiempre);

        if (mostrarMensaje)
            SetMensaje("Ubicación preferida guardada.", false);
    }

    private async Task AplicarPreferenciaAsync()
    {
        if (preferenciaGuardada is null)
        {
            SetMensaje("No hay una ubicación preferida guardada.", true);
            return;
        }

        pagina = preferenciaGuardada.Page;
        xMm = preferenciaGuardada.XMm;
        yMm = preferenciaGuardada.YMm;
        anchoMm = StampWidthMm;
        if (stampSelectorInstance is not null)
            await stampSelectorInstance.InvokeVoidAsync("applyPreferredSelection", preferenciaGuardada);
    }

    private async Task CambiarUsoPreferenciaAsync()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", PreferenceAutoKey, usarPreferenciaSiempre ? "true" : "false");

        if (usarPreferenciaSiempre && preferenciaGuardada is null)
            await GuardarPreferenciaInternaAsync(false, false);

        if (stampSelectorInstance is not null)
            await stampSelectorInstance.InvokeVoidAsync("setPreferredSelection", preferenciaGuardada, usarPreferenciaSiempre);

        SetMensaje(
            usarPreferenciaSiempre
                ? "Se usará esta ubicación automáticamente al cargar PDF."
                : "Uso automático de ubicación desactivado.",
            false);
    }

    private bool Error(string texto)
    {
        SetMensaje(texto, true);
        return false;
    }

    private void SetMensaje(string texto, bool error)
    {
        mensaje = texto;
        esError = error;
    }

    private static string FormatearMensajeError(string? rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
            return "Se produjo un error inesperado.";

        var limpio = rawMessage
            .Replace("\r", " ", StringComparison.Ordinal)
            .Replace("\n", " ", StringComparison.Ordinal)
            .Trim();

        return limpio.Length > 320
            ? $"{limpio[..320]}..."
            : limpio;
    }

    private static bool EsExtension(string fileName, string extension) =>
        string.Equals(Path.GetExtension(fileName), extension, StringComparison.OrdinalIgnoreCase);

    private static string CrearNombrePdfFirmado(string? fileName)
    {
        var baseName = Path.GetFileNameWithoutExtension(fileName);
        if (string.IsNullOrWhiteSpace(baseName))
            baseName = "documento";

        foreach (var invalidChar in Path.GetInvalidFileNameChars())
            baseName = baseName.Replace(invalidChar, '_');

        baseName = baseName.Trim(' ', '.', '_');
        if (string.IsNullOrWhiteSpace(baseName))
            baseName = "documento";

        return $"{baseName}_firmado.pdf";
    }

    private string PreferenceKey => $"e-rubrica:stamp-preference:{currentUserId}:{emisor?.Codigo ?? 0}";
    private string PreferenceAutoKey => $"{PreferenceKey}:auto";

    private sealed record StampPreference(
        int Page,
        double XMm,
        double YMm,
        double WidthMm);

    private sealed record RecursosFirma(
        FirmaStampApiFile Certificado,
        string Clave);

    private sealed record ResultadoEstampado(
        string Nombre,
        string Url,
        DateTime Fecha,
        string? OriginalSha256,
        string? OutputSha256);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (stampSelectorInstance is not null)
            {
                await stampSelectorInstance.InvokeVoidAsync("dispose");
                await stampSelectorInstance.DisposeAsync();
            }

            if (stampSelectorModule is not null)
                await stampSelectorModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // El circuito ya no permite ejecutar JavaScript durante la desconexión.
        }
        finally
        {
            dotNetRef?.Dispose();
        }
    }
}
