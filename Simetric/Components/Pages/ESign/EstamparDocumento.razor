@page "/e-rubrica/documentos/estampar"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.Text.Json
@using System.Text.RegularExpressions
@using Simetric.Data
@using Simetric.Models
@using Simetric.Services
@using Simetric.Services.ESign
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject FirmaStampApiService FirmaStampApiService
@inject FirmaPathResolver FirmaPathResolver
@inject EmisorCertificadoProtector CertificadoProtector
@inject EmisionControlService EmisionControlService
@inject IJSRuntime JS

<PageTitle>Estampar documento | E-RÚBRICA</PageTitle>

<div class="stamp-page">
    @if (cargando)
    {
        <ESignLoadingState
            Title="Cargando estampado"
            Description="Preparando tu certificado, sello visual y herramientas para firmar el PDF." />
    }
    else
    {
        @if (!puedeFirmarDocumentos)
        {
            <div class="stamp-alert is-error" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                <span>@mensajeAccesoFirma</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="stamp-alert stamp-alert-overlay @(esError ? "is-error" : "is-ok")" role="alert" aria-live="assertive">
                <i class="bi @(esError ? "bi-exclamation-triangle" : "bi-check-circle")"></i>
                <span>@mensaje</span>
                <button type="button" class="stamp-alert-close" @onclick="CerrarMensaje" aria-label="Cerrar alerta">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }

        <section class="stamp-grid stamp-grid-setup">
            <article class="stamp-panel">
                <div class="panel-heading">
                    <div>
                        <h2><span class="step-number">1.</span> PDF a estampar</h2>
                        <p>Selecciona o arrastra el archivo PDF que recibirá el sello.</p>
                    </div>
                    <button type="button" class="stored-documents-btn" @onclick="AbrirModalDocumentos">
                        <i class="bi bi-folder2-open"></i>
                        <span>Documentos Cargados</span>
                    </button>
                </div>

                <div class="file-grid">
                    <InputFile id="stampPdfInput" class="file-input" accept=".pdf,application/pdf" OnChange="SeleccionarPdf" />
                    <label for="stampPdfInput" class="stamp-file-card @(pdfFile is null ? null : "is-ready")">
                        <span class="upload-cloud"><i class="bi bi-cloud-arrow-up"></i></span>
                        <strong>Arrastra tu archivo PDF aquí</strong>
                        <span>o selecciona un archivo</span>
                        <span class="upload-button">
                            <i class="bi bi-file-earmark-arrow-up"></i>
                            <span>Seleccionar PDF</span>
                        </span>
                        <small>@(pdfFile?.Name ?? "Formato PDF - Máx. 10 MB")</small>
                    </label>
                    @if (documentoGuardadoSeleccionado is not null)
                    {
                        <div class="stored-document-selected">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>
                                <strong>@documentoGuardadoSeleccionado.Nombre</strong>
                                <small>@documentoGuardadoSeleccionado.Tamano · @documentoGuardadoSeleccionado.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                            </span>
                            <button type="button" @onclick="LimpiarDocumentoGuardado" aria-label="Quitar documento guardado">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>
            </article>

        </section>

        <section class="stamp-workspace">
            <article class="stamp-panel stamp-preview-panel">
                <div class="panel-heading">
                    <h2><span class="step-number">2.</span> Ubicación de la firma</h2>
                    <p>Haz clic o arrastra para mover la firma. El ancho se mantiene fijo en 60 mm.</p>
                </div>

                <div class="selection-hint">
                    <i class="bi bi-info-circle"></i>
                    <span>Haz clic o arrastra en el documento para seleccionar la posición de la firma.</span>
                </div>

                <div class="pdf-selector">
                    <div class="pdf-toolbar">
                        <button type="button" id="stampPreviousPage" aria-label="Página anterior">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" id="stampNextPage" aria-label="Página siguiente">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <span>Página <strong id="stampCurrentPage">1</strong> de <strong id="stampPageCount">0</strong></span>
                        <span class="toolbar-spacer"></span>
                        <button type="button" class="toolbar-ghost" id="stampZoomOut" aria-label="Alejar">
                            <i class="bi bi-dash"></i>
                        </button>
                        <span class="zoom-label" id="stampZoomLabel">100%</span>
                        <button type="button" class="toolbar-ghost" id="stampZoomIn" aria-label="Acercar">
                            <i class="bi bi-plus"></i>
                        </button>
                        <span class="selection-status" id="stampSelectionStatus">Carga un PDF para seleccionar la posición.</span>
                    </div>
                    <div class="pdf-view-shell">
                        <aside class="pdf-thumbnails" id="stampPdfThumbnails" aria-label="Miniaturas del PDF">
                            <div class="pdf-thumb is-placeholder"><span></span><strong>1</strong></div>
                        </aside>
                        <div class="pdf-stage" id="stampPdfStage">
                            <canvas id="stampPdfCanvas" hidden></canvas>
                            <div class="stamp-footprint" id="stampFootprint" hidden>
                                <span class="position-dot"></span>
                                <span class="footprint-copy">Ubicación de firma</span>
                                <button
                                    type="button"
                                    class="resize-handle"
                                    id="stampResizeHandle"
                                    aria-label="Tamaño fijo del sello"
                                    title="Ancho fijo: 60 mm"></button>
                            </div>
                            <div class="pdf-placeholder" id="stampPdfPlaceholder">
                                <strong>Vista previa del documento</strong>
                                <span>Después de cargar el PDF, haz clic sobre la página.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <aside class="stamp-panel stamp-guidance">
                <div class="guidance-title">
                    <i class="bi bi-lightbulb"></i>
                    <strong>Consejos y validación</strong>
                </div>
                <ul>
                    <li><i class="bi bi-check-circle"></i>Coloca la firma en un área visible del documento.</li>
                    <li><i class="bi bi-check-circle"></i>Evita márgenes y textos importantes.</li>
                    <li><i class="bi bi-check-circle"></i>El ancho de la firma se mantiene fijo en 60 mm.</li>
                    <li><i class="bi bi-check-circle"></i>Asegúrate de que el área seleccionada sea visible al imprimir.</li>
                </ul>
            </aside>
        </section>

        <section class="stamp-panel stamp-footer-actions">
            <div class="stamp-preference">
                <label class="switch-label">
                    <input type="checkbox" @bind="usarPreferenciaSiempre" @bind:after="CambiarUsoPreferenciaAsync" />
                    <span class="switch-control"></span>
                    <span>Guardar ubicación para futuros documentos</span>
                </label>
                <p>Al activar esta opción, el sistema recordará la última posición usada para documentos del mismo tipo.</p>
            </div>
            <div class="stamp-actions stamp-main-actions">
                <button type="button" class="esign-btn-secondary" @onclick="LimpiarFormularioAsync">
                    <i class="bi bi-eraser"></i>
                    <span>Limpiar formulario</span>
                </button>
                <button type="button" class="esign-btn-secondary" @onclick="PrevisualizarDocumentoAsync" disabled="@(procesando || !puedeFirmarDocumentos)">
                    <i class="bi bi-eye"></i>
                    <span>Previsualizar documento</span>
                </button>
                <button type="button" class="esign-btn-primary" @onclick="EstamparAsync" disabled="@(procesando || !puedeFirmarDocumentos)">
                    <i class="bi @(procesando ? "bi-arrow-repeat" : "bi-pen")"></i>
                    <span>@(procesando ? "Procesando..." : "Estampar PDF")</span>
                </button>
            </div>
        </section>

        @if (resultado is not null)
        {
            <section class="stamp-panel stamp-result">
                <div>
                    <span class="header-kicker">Resultado</span>
                    <h2>Documento firmado</h2>
                    <p>@resultado.Nombre | @resultado.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="result-actions">
                    <a class="action-btn" href="@resultado.Url" target="_blank" title="Abrir PDF">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <a class="action-btn" href="@resultado.Url" download="@resultado.Nombre" title="Descargar PDF">
                        <i class="bi bi-download"></i>
                    </a>
                </div>
            </section>
        }

        @if (mostrarPrevisualizacion && !string.IsNullOrWhiteSpace(previsualizacionPdfUrl))
        {
            <div class="stamp-documents-backdrop" @onclick="CerrarPrevisualizacion"></div>
            <section class="stamp-preview-modal" role="dialog" aria-modal="true" aria-labelledby="stampPreviewTitle">
                <header class="stamp-documents-header">
                    <div>
                        <span class="header-kicker">Previsualización</span>
                        <h2 id="stampPreviewTitle">Documento firmado</h2>
                    </div>
                    <button type="button" @onclick="CerrarPrevisualizacion" aria-label="Cerrar previsualización">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>
                <div class="stamp-preview-body">
                    <div class="stamp-preview-pdf-shell">
                        <embed src="@($"{previsualizacionPdfUrl}#toolbar=1&navpanes=0")" type="application/pdf" />
                    </div>
                    <div class="stamp-preview-summary">
                        <strong>@(previsualizacionPdfNombre ?? NombreDocumentoPreview)</strong>
                        <span>Página @pagina · X @xMm.ToString("0.##") mm · Y @yMm.ToString("0.##") mm</span>
                        <a href="@previsualizacionPdfUrl" target="_blank" class="esign-btn-secondary">
                            <i class="bi bi-box-arrow-up-right"></i>
                            <span>Abrir PDF</span>
                        </a>
                    </div>
                </div>
            </section>
        }

        @if (mostrarModalDocumentos)
        {
            <div class="stamp-documents-backdrop" @onclick="CerrarModalDocumentos"></div>
            <section class="stamp-documents-modal" role="dialog" aria-modal="true" aria-labelledby="stampDocumentosTitulo">
                <header class="stamp-documents-header">
                    <div>
                        <span class="header-kicker">Repositorio</span>
                        <h2 id="stampDocumentosTitulo">Documentos cargados</h2>
                    </div>
                    <button type="button" @onclick="CerrarModalDocumentos" aria-label="Cerrar modal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>

                <div class="stamp-documents-upload">
                    <InputFile id="stampDocumentUpload" class="file-input" accept=".pdf,application/pdf" OnChange="SubirDocumentoGuardadoAsync" />
                    <label for="stampDocumentUpload">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <span>
                            <strong>Subir documento para firmar</strong>
                            <small>@(subiendoDocumentoGuardado ? "Guardando documento..." : "PDF máximo 10 MB")</small>
                        </span>
                    </label>
                </div>

                <div class="stamp-documents-list">
                    @if (!documentosGuardados.Any())
                    {
                        <div class="stamp-documents-empty">
                            <i class="bi bi-folder2-open"></i>
                            <strong>No hay documentos guardados.</strong>
                            <span>Sube un PDF para usarlo en esta firma.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var doc in documentosGuardados)
                        {
                            <div class="stamp-document-item @(documentoGuardadoSeleccionado?.NombreArchivo == doc.NombreArchivo ? "is-active" : null)">
                                <button type="button" class="stamp-document-main" @onclick="() => UsarDocumentoGuardadoAsync(doc)">
                                    <span class="stamp-document-preview">
                                        <embed src="@doc.Url#toolbar=0&navpanes=0&scrollbar=0" type="application/pdf" />
                                    </span>
                                    <span class="stamp-document-copy">
                                        <strong title="@doc.Nombre">@doc.Nombre</strong>
                                        <small>@doc.Fecha.ToString("dd/MM/yyyy HH:mm") · @doc.Tamano</small>
                                    </span>
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <button type="button" class="stamp-document-delete" @onclick="() => BorrarDocumentoGuardadoAsync(doc)" title="Borrar" aria-label="Borrar documento">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private const long MaxPdfSize = 10 * 1024 * 1024;
    private const long MaxCertificadoSize = 5 * 1024 * 1024;
    private const double StampWidthMm = 60;

    private bool cargando = true;
    private bool procesando;
    private bool mostrarModalDocumentos;
    private bool subiendoDocumentoGuardado;
    private bool puedeFirmarDocumentos;
    private bool esError;
    private int currentUserId;
    private string? mensaje;
    private string mensajeAccesoFirma = "Para firmar documentos necesitas un plan de documentos activo o una solicitud de firma electrónica pagada y vigente.";
    private int pagina = 1;
    private double xMm = 10;
    private double yMm = 10;
    private double anchoMm = StampWidthMm;
    private IBrowserFile? pdfFile;
    private DocumentoGuardadoItem? documentoGuardadoSeleccionado;
    private readonly List<DocumentoGuardadoItem> documentosGuardados = [];
    private Simetric.Models.Emisor? emisor;
    private List<Simetric.Models.Emisor> emisoresCuenta = [];
    private bool emisorConfigurado;
    private string estadoEmisorMensaje = "Validando configuración de E-Rúbrica...";
    private string? rutaCertificadoEmisor;
    private string? certificadoSeleccionado;
    private string? claveCertificadoInput;
    private string? pathCertificadoPendiente;
    private bool usarPreferenciaSiempre;
    private bool tienePreferenciaGuardada;
    private bool mostrarPrevisualizacion;
    private StampPreference? preferenciaGuardada;
    private string? previsualizacionPdfUrl;
    private string? previsualizacionPdfNombre;
    private ResultadoEstampado? resultado;
    private DotNetObjectReference<EstamparDocumento>? dotNetRef;
    private IJSObjectReference? stampSelectorModule;
    private IJSObjectReference? stampSelectorInstance;
    private bool stampSelectorInitialized;
    private bool documentoQueryCargado;

    [SupplyParameterFromQuery(Name = "documento")]
    public string? DocumentoQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) || currentUserId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var isSuperAdmin = string.Equals(
            user.FindFirst("IdTipoUsuario")?.Value,
            AppAccessService.AdminRoleId,
            StringComparison.OrdinalIgnoreCase);

        var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
        if (!access.HasAccess)
        {
            NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
            return;
        }

        await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);
        CargarDocumentosGuardados();
        SeleccionarDocumentoDesdeQuery();
        await CargarAccesoFirmaAsync();
        await CargarEmisorAsync();
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cargando || stampSelectorInitialized)
            return;

        stampSelectorInitialized = true;
        dotNetRef = DotNetObjectReference.Create(this);
        stampSelectorModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/esignStampSelector.js?v=20260824-1");
        stampSelectorInstance = await stampSelectorModule.InvokeAsync<IJSObjectReference>(
            "init",
            new
            {
                pdfInputId = "stampPdfInput",
                canvasId = "stampPdfCanvas",
                stageId = "stampPdfStage",
                placeholderId = "stampPdfPlaceholder",
                footprintId = "stampFootprint",
                resizeHandleId = "stampResizeHandle",
                previousButtonId = "stampPreviousPage",
                nextButtonId = "stampNextPage",
                currentPageLabelId = "stampCurrentPage",
                pageCountLabelId = "stampPageCount",
                selectionStatusId = "stampSelectionStatus",
                thumbnailsId = "stampPdfThumbnails",
                zoomOutButtonId = "stampZoomOut",
                zoomInButtonId = "stampZoomIn",
                zoomLabelId = "stampZoomLabel"
            },
            dotNetRef);

        await CargarPreferenciaAsync();
        await CargarDocumentoQueryEnVisorAsync();
    }

    private void SeleccionarPdf(InputFileChangeEventArgs e)
    {
        pdfFile = e.File;
        documentoGuardadoSeleccionado = null;
    }

    private bool TieneCertificadoDisponible =>
        !string.IsNullOrWhiteSpace(pathCertificadoPendiente) ||
        !string.IsNullOrWhiteSpace(rutaCertificadoEmisor) ||
        !string.IsNullOrWhiteSpace(emisor?.PathCertificado);

    private bool TieneClaveDisponible =>
        !string.IsNullOrWhiteSpace(claveCertificadoInput) ||
        !string.IsNullOrWhiteSpace(emisor?.ClaveCertificado);

    private string NombreCertificadoConfiguracion =>
        certificadoSeleccionado
        ?? (TieneCertificadoDisponible ? "Firma disponible" : "Seleccionar .p12");

    private string NombreDocumentoPreview =>
        documentoGuardadoSeleccionado?.Nombre
        ?? pdfFile?.Name
        ?? "Documento PDF";

    [JSInvokable]
    public async Task OnStampSelectionChanged(int selectedPage, double selectedX, double selectedY, double selectedWidth)
    {
        pagina = selectedPage;
        xMm = Math.Round(selectedX, 2);
        yMm = Math.Round(selectedY, 2);
        anchoMm = StampWidthMm;
        if (usarPreferenciaSiempre)
            await GuardarPreferenciaInternaAsync(false, false);

        StateHasChanged();
    }

    [JSInvokable]
    public void OnStampPageChanged(int selectedPage)
    {
        pagina = selectedPage;
        StateHasChanged();
    }

    private async Task EstamparAsync()
    {
        mensaje = null;
        esError = false;
        resultado = null;
        previsualizacionPdfUrl = null;
        previsualizacionPdfNombre = null;

        if (!await CargarAccesoFirmaAsync())
        {
            Error(mensajeAccesoFirma);
            return;
        }

        if (!ValidarFormulario())
            return;

        procesando = true;
        try
        {
            var recursosFirma = await ResolverRecursosFirmaAsync();
            if (recursosFirma is null)
                return;

            var apiResult = await GenerarPdfEstampadoAsync(recursosFirma);

            if (!apiResult.Success || apiResult.Pdf is null)
            {
                SetMensaje(apiResult.Message, true);
                return;
            }

            var downloadFileName = CrearNombrePdfFirmado(documentoGuardadoSeleccionado?.Nombre ?? pdfFile!.Name);
            var storedFileName = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.NewGuid():N}_{downloadFileName}";
            var relativeDirectory = Path.Combine("uploads", "e-rubrica", "estampados", currentUserId.ToString());
            var physicalDirectory = Path.Combine(HostEnvironment.WebRootPath, relativeDirectory);
            Directory.CreateDirectory(physicalDirectory);

            var physicalPath = Path.Combine(physicalDirectory, storedFileName);
            await File.WriteAllBytesAsync(physicalPath, apiResult.Pdf);

            resultado = new ResultadoEstampado(
                downloadFileName,
                "/" + Path.Combine(relativeDirectory, storedFileName).Replace('\\', '/'),
                DateTime.Now,
                apiResult.OriginalSha256,
                apiResult.OutputSha256);

            if (documentoGuardadoSeleccionado is not null)
            {
                BorrarDocumentoPendienteFirmado(documentoGuardadoSeleccionado);
                documentoGuardadoSeleccionado = null;
                CargarDocumentosGuardados();
            }

            SetMensaje("PDF estampado correctamente.", false);
        }
        catch (Exception ex)
        {
            SetMensaje($"No se pudo estampar el PDF: {FormatearMensajeError(ex.Message)}", true);
        }

        finally
        {
            procesando = false;
        }
    }

    private async Task<FirmaStampApiResult> GenerarPdfEstampadoAsync(RecursosFirma recursosFirma)
    {
        if (documentoGuardadoSeleccionado is not null)
        {
            await using var pdfStream = File.OpenRead(documentoGuardadoSeleccionado.RutaFisica);
            return await FirmaStampApiService.EstamparAsync(
                pdfStream,
                documentoGuardadoSeleccionado.Nombre,
                documentoGuardadoSeleccionado.Bytes,
                "application/pdf",
                recursosFirma.Certificado,
                recursosFirma.Clave,
                "Firma digital del documento",
                null,
                pagina,
                xMm,
                yMm,
                anchoMm);
        }

        return await FirmaStampApiService.EstamparAsync(
            pdfFile!,
            recursosFirma.Certificado,
            recursosFirma.Clave,
            "Firma digital del documento",
            null,
            pagina,
            xMm,
            yMm,
            anchoMm);
    }

    private bool ValidarFormulario()
    {
        if (pdfFile is null && documentoGuardadoSeleccionado is null)
            return Error("Selecciona el PDF.");

        if (!emisorConfigurado)
            return Error(estadoEmisorMensaje);

        if (pdfFile is not null && (pdfFile.Size <= 0 || pdfFile.Size > MaxPdfSize))
            return Error("El PDF debe pesar máximo 10 MB.");

        if (pdfFile is not null && !EsExtension(pdfFile.Name, ".pdf"))
            return Error("El documento debe ser PDF.");

        if (documentoGuardadoSeleccionado is not null &&
            (!File.Exists(documentoGuardadoSeleccionado.RutaFisica) ||
             documentoGuardadoSeleccionado.Bytes <= 0 ||
             documentoGuardadoSeleccionado.Bytes > MaxPdfSize))
        {
            return Error("El documento guardado no esta disponible o excede 10 MB.");
        }

        if (pagina < 1)
            return Error("La página debe ser mayor que cero.");

        if (xMm < 0 || xMm > 2000 || yMm < 0 || yMm > 2000)
            return Error("X e Y deben estar entre 0 y 2000 mm.");

        anchoMm = StampWidthMm;

        return true;
    }

    private async Task CargarEmisorAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var usuario = await context.Usuarios
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.IdUsuario == currentUserId);

        var idUsuarioEmisor = usuario?.estadoAsociado == true && usuario.idJefe is > 0
            ? usuario.idJefe.Value
            : currentUserId;

        emisoresCuenta = await context.Emisores
            .AsNoTracking()
            .Where(item => item.IdUsuario == idUsuarioEmisor && item.Estado && !item.EsEmisorSistema)
            .OrderByDescending(item => item.Codigo)
            .ToListAsync();

        var codigoSeleccionado = emisor?.Codigo;
        emisor = emisoresCuenta.FirstOrDefault(item => item.Codigo == codigoSeleccionado)
            ?? emisoresCuenta.FirstOrDefault(item =>
        {
            var ruta = FirmaPathResolver.ResolverRutaExistente(item.PathCertificado);
            return !string.IsNullOrWhiteSpace(item.ClaveCertificado) &&
                !string.IsNullOrWhiteSpace(ruta);
        }) ?? emisoresCuenta.FirstOrDefault();

        emisorConfigurado = ValidarConfiguracionEmisor(out var estado);
        estadoEmisorMensaje = estado;
        await Task.CompletedTask;
    }

    private async Task<bool> CargarAccesoFirmaAsync()
    {
        if (await EmisionControlService.TienePlanDocumentosActivoAsync(currentUserId))
        {
            puedeFirmarDocumentos = true;
            return true;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var usuario = await context.Usuarios
            .AsNoTracking()
            .Where(item => item.IdUsuario == currentUserId)
            .Select(item => new { item.estadoAsociado, item.idJefe })
            .FirstOrDefaultAsync();

        var idsCuenta = new[]
        {
            currentUserId,
            usuario?.estadoAsociado == true && usuario.idJefe is > 0
                ? usuario.idJefe.Value
                : currentUserId
        }.Distinct().ToArray();

        var solicitudesPagadas = await context.UsuSolicitudFirma
            .AsNoTracking()
            .Where(item => idsCuenta.Contains(item.SolIdUsuarioCliente) &&
                           item.SolActivo &&
                           item.SolPagoExitoso == true)
            .Select(item => new
            {
                item.SolFechaSolicitud,
                item.SolFechaPago,
                item.SolFechaAprobacion,
                item.SolVigencia
            })
            .ToListAsync();

        puedeFirmarDocumentos = solicitudesPagadas.Any(item =>
            CalcularFechaFinFirma(
                item.SolFechaAprobacion ?? item.SolFechaPago ?? item.SolFechaSolicitud,
                item.SolVigencia) >= DateTime.Today);

        return puedeFirmarDocumentos;
    }

    private static DateTime CalcularFechaFinFirma(DateTime fechaInicio, string? vigencia)
    {
        var match = Regex.Match(vigencia ?? string.Empty, @"\d+");
        if (!match.Success || !int.TryParse(match.Value, out var cantidad))
            return fechaInicio.AddYears(1);

        if (Regex.IsMatch(vigencia ?? string.Empty, @"D[IÍ]AS?", RegexOptions.IgnoreCase))
            return fechaInicio.AddDays(Math.Max(cantidad, 1));

        return fechaInicio.AddYears(Math.Clamp(cantidad, 1, 5));
    }

