    private static string FormatearMensajeError(string? rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
            return "Se produjo un error inesperado.";

        var limpio = rawMessage
            .Replace("\r", " ", StringComparison.Ordinal)
            .Replace("\n", " ", StringComparison.Ordinal)
            .Trim();

        return limpio.Length > 320
            ? $"{limpio[..320]}..."
            : limpio;
    }

    private static bool EsExtension(string fileName, string extension) =>
        string.Equals(Path.GetExtension(fileName), extension, StringComparison.OrdinalIgnoreCase);

    private static string CrearNombreArchivoSeguro(string fileName)
    {
        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var extension = Path.GetExtension(fileName);
        var limpio = new string(nombre.Select(ch => char.IsLetterOrDigit(ch) ? ch : '_').ToArray()).Trim('_');

        if (string.IsNullOrWhiteSpace(limpio))
            limpio = "documento";

        return $"{limpio}{extension.ToLowerInvariant()}";
    }

    private static string CrearNombreDocumentoGuardado(string fileName)
    {
        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length > 3 && partes[0].Length == 14 && Guid.TryParse(partes[1], out _))
            nombre = string.Join("_", partes.Skip(2));

        return $"{nombre.Replace('_', ' ').Trim()}.pdf";
    }

    private static string FormatearTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{Math.Max(1, bytes / 1024d):0.##} KB";

    private static string CrearNombrePdfFirmado(string? fileName)
    {
        var baseName = Path.GetFileNameWithoutExtension(fileName);
        if (string.IsNullOrWhiteSpace(baseName))
            baseName = "documento";

        var partes = baseName.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length > 3 && partes[0].Length == 14 && Guid.TryParse(partes[1], out _))
            baseName = string.Join("_", partes.Skip(2));

        if (baseName.EndsWith("_firmado", StringComparison.OrdinalIgnoreCase))
            baseName = baseName[..^8];

        foreach (var invalidChar in Path.GetInvalidFileNameChars())
            baseName = baseName.Replace(invalidChar, '_');

        baseName = baseName.Trim(' ', '.', '_');
        if (string.IsNullOrWhiteSpace(baseName))
            baseName = "documento";

        return $"{baseName}_firmado.pdf";
    }

