    private async Task SubirDocumentoGuardadoAsync(InputFileChangeEventArgs e)
    {
        if (subiendoDocumentoGuardado)
            return;

        var file = e.File;
        if (file is null)
            return;

        if (!EsExtension(file.Name, ".pdf") || file.Size <= 0 || file.Size > MaxPdfSize)
        {
            SetMensaje("Selecciona un PDF válido de máximo 10 MB.", true);
            return;
        }

        subiendoDocumentoGuardado = true;
        try
        {
            var directory = ObtenerDirectorioDocumentosGuardados();
            Directory.CreateDirectory(directory);

            var storedName = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.NewGuid():N}_{CrearNombreArchivoSeguro(file.Name)}";
            var physicalPath = Path.Combine(directory, storedName);

            await using var stream = file.OpenReadStream(MaxPdfSize);
            await using var target = File.Create(physicalPath);
            await stream.CopyToAsync(target);

            CargarDocumentosGuardados();
            var doc = documentosGuardados.FirstOrDefault(item => item.NombreArchivo == storedName);
            if (doc is not null)
                await UsarDocumentoGuardadoAsync(doc);

            SetMensaje("Documento guardado para firmar.", false);
        }
        catch (Exception ex)
        {
            SetMensaje($"No se pudo guardar el documento: {FormatearMensajeError(ex.Message)}", true);
        }
        finally
        {
            subiendoDocumentoGuardado = false;
        }
    }

    private void CargarDocumentosGuardados()
    {
        documentosGuardados.Clear();
        var directory = ObtenerDirectorioDocumentosGuardados();
        if (!Directory.Exists(directory))
            return;

        foreach (var file in Directory.EnumerateFiles(directory, "*.pdf")
            .Select(path => new FileInfo(path))
            .OrderByDescending(file => file.CreationTime))
        {
            documentosGuardados.Add(new DocumentoGuardadoItem(
                CrearNombreDocumentoGuardado(file.Name),
                file.Name,
                FormatearTamano(file.Length),
                file.Length,
                file.CreationTime,
                file.FullName,
                "/" + Path.Combine(ObtenerDirectorioDocumentosGuardadosRelativo(), file.Name).Replace('\\', '/')));
        }
    }

