    private async Task BorrarDocumentoGuardadoAsync(DocumentoGuardadoItem doc)
    {
        try
        {
            var directory = Path.GetFullPath(ObtenerDirectorioDocumentosGuardados());
            var path = Path.GetFullPath(doc.RutaFisica);
            if (!path.StartsWith(directory, StringComparison.OrdinalIgnoreCase) || !File.Exists(path))
            {
                SetMensaje("No se encontro el documento para borrar.", true);
                return;
            }

            File.Delete(path);
            CargarDocumentosGuardados();
            if (documentoGuardadoSeleccionado?.NombreArchivo == doc.NombreArchivo)
                await LimpiarDocumentoGuardado();

            SetMensaje("Documento eliminado.", false);
        }
        catch (Exception ex)
        {
            SetMensaje($"No se pudo borrar el documento: {FormatearMensajeError(ex.Message)}", true);
        }
    }

