@page "/e-rubrica/firma"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Simetric.Services
@using System.IO
@using System.Security.Claims
@using System.Text.Json

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager NavManager
@inject EmisorOnboardingService EmisorOnboardingService
@inject EmisionControlService EmisionControlService
@inject SweetAlertService AlertService

@rendermode InteractiveServer

<PageTitle>Firma electronica | Numerica e-Rubrica</PageTitle>

<div class="entity-shell" data-tour="firma.page">
    @if (MostrarVolverInicioOnboarding)
    {
        <div class="breadcrumb-container">
            <button type="button" class="breadcrumb-home-btn" @onclick='() => NavManager.NavigateTo("/e-rubrica")'>
                <i class="bi bi-house-door"></i>
                <span>Volver al inicio</span>
            </button>
        </div>
    }

    <section class="entity-grid entity-grid-single">
        <section class="table-card firma-upload-card" data-tour="firma.table">
            <div class="table-card-head">
                <div>
                    <span class="table-kicker">e-Rubrica</span>
                    <h3>Configura tu firma electronica</h3>
                </div>
                <div class="table-head-actions">
                    <span class="table-badge">Archivo .p12</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="status-banner status-banner-info">
                    <i class="bi bi-info-circle"></i>
                    <span>@mensaje</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(debugError))
            {
                <div class="status-banner status-banner-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>@debugError</span>
                </div>
            }

            @if (cargando)
            {
                <div class="state-card">
                    <div class="state-icon">
                        <span class="spinner-border firma-loading-spinner" role="status"></span>
                    </div>
                    <h3>Cargando firmas</h3>
                    <p>Preparando tu archivo de firma y clave.</p>
                </div>
            }
            else if (!FirmaDisponible)
            {
                <div class="state-card state-card-empty">
                    <div class="state-icon">
                        <i class="bi bi-shield-x"></i>
                    </div>
                    <h3>No se puede guardar la firma</h3>
                    <p>No se encontro una cuenta activa disponible para asociar tu archivo .p12.</p>
                </div>
            }
            else
            {
                <div class="firma-reference-layout">
                    <div class="firma-reference-main">
                        <section class="firma-hero-card">
                            <span class="firma-hero-icon">
                                <i class="bi bi-file-earmark-check"></i>
                                <small><i class="bi bi-shield-check"></i></small>
                            </span>
                            <div>
                                <h3>Configura tu firma electronica</h3>
                                <p>Carga tu certificado digital y configura su clave de acceso para firmar documentos de forma segura.</p>
                            </div>
                        </section>

                        @FirmaEstadoVisual

                        @if (esAsociado)
                        {
                            <div class="status-banner status-banner-info status-banner-inline">
                                <i class="bi bi-lock"></i>
                                <span>Los usuarios asociados pueden consultar la firma, pero no modificarla.</span>
                            </div>
                        }

                        <section class="firma-step-card">
                            <div class="firma-step-top">
                                <div class="firma-step-head">
                                    <span>1</span>
                                    <div>
                                        <h4>Certificado digital</h4>
                                        <p>Selecciona tu archivo de certificado digital en formato .p12</p>
                                    </div>
                                </div>

                                <label class="primary-btn firma-select-btn">
                                    <i class="bi bi-file-earmark-lock"></i>
                                    Seleccionar
                                    <InputFile accept=".p12" OnChange="SubirPathCertificado" disabled="@esAsociado" />
                                </label>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(NombrePathCertificadoActual))
                            {
                                <div class="signature-current firma-file-row">
                                    <i class="bi bi-file-earmark-lock"></i>
                                    <span>
                                        <strong>@NombrePathCertificadoActual</strong>
                                        <small>Formato .p12</small>
                                    </span>
                                    <i class="bi bi-check-circle-fill firma-row-check"></i>
                                    @if (!esAsociado)
                                    {
                                        <button type="button" title="Quitar certificado" @onclick="QuitarPathCertificado">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </section>

                        <section class="firma-step-card">
                            <div class="firma-step-head">
                                <span>2</span>
                                <div>
                                    <h4>Clave de acceso</h4>
                                    <p>Ingresa la clave del certificado (.p12) para habilitar la firma electronica.</p>
                                </div>
                            </div>

                            <div class="cert-password-shell">
                                <input type="@tipoPassword"
                                       class="form-control form-control-sm cert-password-input"
                                       placeholder="Ingresa la clave del archivo .p12"
                                       @bind="firmaModel.ClaveCertificado"
                                       @bind:after="InvalidarEstadoFirmaEditor"
                                       autocomplete="off"
                                       disabled="@esAsociado" />
                                <button class="cert-password-eye" type="button" @onclick="TogglePasswordVisibility" title="Mostrar u ocultar clave">
                                    <i class="bi @(mostrarPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>

                            <small class="firma-safe-note">
                                <i class="bi bi-shield-check"></i>
                                @(TieneClaveCertificadoActual ? "Clave configurada correctamente." : "La clave se utiliza unicamente para firmar.")
                            </small>
                        </section>
                    </div>

                    <aside class="firma-reference-side">
                        <section class="firma-side-card">
                            <h4>Resumen de validacion</h4>
                            <div class="firma-validation-list">
                                <div class="firma-validation-item @(string.IsNullOrWhiteSpace(NombrePathCertificadoActual) ? string.Empty : "is-ready")">
                                    <i class="bi bi-file-earmark-check"></i>
                                    <span>
                                        <strong>Archivo detectado</strong>
                                        <small>@(NombrePathCertificadoActual ?? "Pendiente")</small>
                                    </span>
                                </div>
                                <div class="firma-validation-item @(string.IsNullOrWhiteSpace(NombrePathCertificadoActual) ? string.Empty : "is-ready")">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>
                                        <strong>Formato valido</strong>
                                        <small>@(string.IsNullOrWhiteSpace(NombrePathCertificadoActual) ? "Pendiente" : "Certificado .p12 reconocido")</small>
                                    </span>
                                </div>
                                <div class="firma-validation-item @(TieneClaveCertificadoActual ? "is-ready" : string.Empty)">
                                    <i class="bi bi-key"></i>
                                    <span>
                                        <strong>Clave ingresada</strong>
                                        <small>@(TieneClaveCertificadoActual ? "Configurada" : "Pendiente de verificacion")</small>
                                    </span>
                                </div>
                                <div class="firma-validation-item @(FirmaConfiguradaActual ? "is-ready" : string.Empty)">
                                    <i class="bi bi-circle-fill"></i>
                                    <span>
                                        <strong>Lista para usar</strong>
                                        <small>@(FirmaConfiguradaActual ? "Guarda para confirmar" : "Completa los pasos y guarda tu firma")</small>
                                    </span>
                                </div>
                            </div>
                        </section>

                        <section class="firma-side-card firma-protection-card">
                            <div>
                                <h4>Tu informacion esta protegida</h4>
                                <p>Usamos cifrado de nivel empresarial para proteger tu certificado y clave de acceso.</p>
                            </div>
                            <span class="firma-protection-icon"><i class="bi bi-shield-check"></i></span>
                            <ul>
                                <li><i class="bi bi-check-circle"></i> La clave no se almacena en texto plano</li>
                                <li><i class="bi bi-check-circle"></i> Conexiones seguras y cifradas</li>
                                <li><i class="bi bi-check-circle"></i> Cumplimos estandares de seguridad</li>
                            </ul>
                        </section>
                    </aside>
                </div>

                <div class="signature-editor-actions firma-reference-actions">
                    <button type="button" class="secondary-btn" @onclick="CancelarFirmaEdicion" disabled="@guardandoFirma">
                        Cancelar
                    </button>
                    <button type="button" class="secondary-btn firma-clear-btn" @onclick="LimpiarFirmaFormulario" disabled="@(esAsociado || guardandoFirma)">
                        Limpiar
                    </button>
                    <button type="button"
                            class="primary-btn @(guardandoFirma ? "n-auto-loading" : null)"
                            @onclick="GuardarFirma"
                            disabled="@(esAsociado || guardandoFirma)">
                        @if (!guardandoFirma)
                        {
                            <i class="bi bi-lock"></i>
                        }
                        @(guardandoFirma ? "Guardando firma..." : "Guardar firma")
                    </button>
                </div>
            }
        </section>
    </section>
</div>

@code {
    private const long MaxCertificadoSize = 5 * 1024 * 1024;

    private readonly List<EmisorDto> emisores = new();
    private EmisorUpsertDto firmaModel = new();
    private bool cargando = true;
    private bool guardandoFirma;
    private bool esAsociado;
    private bool mostrarPassword;
    private string? mensaje;
    private string? debugError;
    private EmisionEstado? emisionEstado;
    private string? nombrePathCertificadoSeleccionado;
    private bool emisorSeleccionadoTieneClaveCertificado;
    private readonly Dictionary<int, FirmaEstadoDto> estadosFirma = new();
    private FirmaEstadoDto? firmaEstadoEditor;
    private bool cargandoEstadosFirma;
    private bool firmaPendienteValidacion;
    private bool MostrarVolverInicioOnboarding =>
        EmisorOnboardingService.RequiresInitialSetup || emisionEstado?.PuedeEmitir == false;

    private string tipoPassword => mostrarPassword ? "text" : "password";
    private bool FirmaDisponible => firmaModel.Codigo > 0;

    private string? NombrePathCertificadoActual => nombrePathCertificadoSeleccionado ?? ObtenerNombreArchivo(firmaModel.PathCertificado);
    private bool TieneClaveCertificadoActual =>
        !string.IsNullOrWhiteSpace(firmaModel.ClaveCertificado) ||
        emisorSeleccionadoTieneClaveCertificado;
    private bool FirmaConfiguradaActual =>
        !string.IsNullOrWhiteSpace(NombrePathCertificadoActual) &&
        TieneClaveCertificadoActual;
    private RenderFragment FirmaEstadoVisual => @<text>
        @if (firmaEstadoEditor is not null && !EsValidacionFirmaNoConfigurada(firmaEstadoEditor))
        {
            <div class="signature-validation-alert @ObtenerClaseAlertaFirma(firmaEstadoEditor)">
                <i class="bi @ObtenerIconoEstadoFirma(firmaEstadoEditor)"></i>
                <div>
                    <strong>@ObtenerTituloEstadoFirma(firmaEstadoEditor)</strong>
                    <span>@ObtenerDetalleEstadoFirma(firmaEstadoEditor)</span>
                    @if (firmaEstadoEditor.EsValida && !string.IsNullOrWhiteSpace(firmaEstadoEditor.NombreTitular))
                    {
                        <small>Titular: @firmaEstadoEditor.NombreTitular</small>
                    }
                </div>
            </div>
        }
        else if (cargandoEstadosFirma && FirmaConfiguradaActual)
        {
            <div class="signature-validation-alert is-checking">
                <i class="bi bi-arrow-repeat"></i>
                <div>
                    <strong>Validando firma</strong>
                    <span>Consultando titular y vigencia del certificado.</span>
                </div>
            </div>
        }
        else if (firmaPendienteValidacion && FirmaConfiguradaActual)
        {
            <div class="signature-validation-alert is-checking">
                <i class="bi bi-shield-lock"></i>
                <div>
                    <strong>Validación pendiente</strong>
                    <span>Al guardar se comprobaran la clave y vigencia de la firma.</span>
                </div>
            </div>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        esAsociado =
            (bool.TryParse(user.FindFirst("EstadoAsociado")?.Value, out var estadoAsociado) && estadoAsociado) ||
            !string.IsNullOrWhiteSpace(user.FindFirst("IdJefe")?.Value);

        await CargarTodo();
    }

    private async Task CargarTodo()
    {
        cargando = true;
        debugError = null;

        try
        {
            var idUsuario = await ObtenerIdUsuarioLogueado();
            if (idUsuario is not > 0)
            {
                mensaje = "No se pudo obtener la sesion del usuario.";
                return;
            }

            var seleccionadoPrevio = firmaModel.Codigo;
            var data = await Http.GetFromJsonAsync<List<EmisorDto>>($"api/emisores?idUsuario={idUsuario.Value}") ?? new();

            emisores.Clear();
            emisores.AddRange(data);

            var seleccionado = seleccionadoPrevio > 0
                ? emisores.FirstOrDefault(e => e.Codigo == seleccionadoPrevio)
                : null;

            SeleccionarEmisorFirma(seleccionado ?? emisores.FirstOrDefault(e => e.Estado == true) ?? emisores.FirstOrDefault());
            await CargarEstadosFirmaAsync(idUsuario.Value);
            firmaEstadoEditor = ObtenerEstadoFirma(firmaModel.Codigo);
            await EmisorOnboardingService.RefreshRequirementAsync(idUsuario);
            emisionEstado = await EmisionControlService.ObtenerEstadoAsync(idUsuario);
        }
        catch (Exception ex)
        {
            debugError = FormatearMensajeError(ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarEmisorFirma(EmisorDto? emisor)
    {
        if (emisor is null)
        {
            firmaModel = new EmisorUpsertDto();
            nombrePathCertificadoSeleccionado = null;
            emisorSeleccionadoTieneClaveCertificado = false;
            firmaEstadoEditor = null;
            firmaPendienteValidacion = false;
            return;
        }

        firmaModel = CrearModeloDesdeEmisor(emisor);
        nombrePathCertificadoSeleccionado = null;
        emisorSeleccionadoTieneClaveCertificado = emisor.TieneClaveCertificadoConfigurada;
        firmaEstadoEditor = ObtenerEstadoFirma(emisor.Codigo);
        firmaPendienteValidacion = false;
    }

    private async Task GuardarFirma()
    {
        if (!FirmaDisponible || esAsociado || guardandoFirma)
        {
            return;
        }

        var idUsuario = await ObtenerIdUsuarioLogueado();
        if (idUsuario is not > 0)
        {
            mensaje = "No se pudo identificar al usuario para guardar la firma.";
            await AlertService.ShowWarningAsync(mensaje, "Sesion no valida");
            return;
        }

        guardandoFirma = true;
        mensaje = "Guardando configuracion de firma...";
        debugError = null;

        try
        {
            firmaModel.IdUsuario = idUsuario.Value;
            firmaModel.PathCertificado = firmaModel.PathCertificado?.Trim();
            firmaModel.ClaveCertificado = firmaModel.ClaveCertificado?.Trim();

            if (!string.IsNullOrWhiteSpace(firmaModel.ClaveCertificado))
            {
                firmaModel.EliminarClaveCertificado = false;
            }

            var response = await Http.PutAsJsonAsync($"api/emisores/{firmaModel.Codigo}", firmaModel);
            if (!response.IsSuccessStatusCode)
            {
                mensaje = "No se pudo guardar la firma electronica.";
                debugError = await LeerMensajeErrorHttpAsync(response, "No se pudo guardar la firma electronica.");
                firmaEstadoEditor = CrearEstadoFirmaInvalido(debugError);
                firmaPendienteValidacion = false;
                await MostrarAlertaErrorFirmaAsync(debugError);
                return;
            }

            await CargarTodo();
            EmisionControlService.NotifyChanged();
            EmisorOnboardingService.NotifyChanged();
            mensaje = "Firma electronica guardada correctamente.";
            await AlertService.ShowSuccessAsync("La firma electronica se guardo correctamente.", "Firma guardada");
        }
        catch (Exception ex)
        {
            debugError = FormatearMensajeError(ex.Message);
            mensaje = "Error al guardar la firma.";
            await AlertService.ShowErrorAsync(debugError, "Error al guardar la firma");
        }
        finally
        {
            guardandoFirma = false;
        }
    }

    private async Task QuitarPathCertificado()
    {
        firmaModel.PathCertificado = null;
        nombrePathCertificadoSeleccionado = null;
        InvalidarEstadoFirmaEditor();
        mensaje = "Archivo de firma quitado del formulario. Guarda para confirmar el cambio.";
        debugError = null;
        await AlertService.ShowInfoAsync("Archivo de firma quitado del formulario. Guarda para confirmar el cambio.", "Firma quitada");
    }

    private async Task QuitarClaveCertificado()
    {
        firmaModel.ClaveCertificado = null;
        firmaModel.EliminarClaveCertificado = true;
        emisorSeleccionadoTieneClaveCertificado = false;
        InvalidarEstadoFirmaEditor();
        mensaje = "Clave del certificado quitada del formulario. Guarda para confirmar el cambio.";
        debugError = null;
        await AlertService.ShowInfoAsync("Clave del certificado quitada del formulario. Guarda para confirmar el cambio.", "Clave quitada");
    }

    private async Task LimpiarFirmaFormulario()
    {
        if (esAsociado)
        {
            return;
        }

        firmaModel.PathCertificado = null;
        firmaModel.ClaveCertificado = null;
        firmaModel.EliminarClaveCertificado = true;
        nombrePathCertificadoSeleccionado = null;
        emisorSeleccionadoTieneClaveCertificado = false;
        InvalidarEstadoFirmaEditor();
        mensaje = "Firma y clave limpiadas del formulario. Guarda para confirmar el cambio.";
        debugError = null;
        await AlertService.ShowWarningAsync("Firma y clave limpiadas del formulario. Guarda para confirmar el cambio.", "Formulario limpiado");
    }

    private async Task CancelarFirmaEdicion()
    {
        await CargarTodo();
        await AlertService.ShowInfoAsync("Se descartaron los cambios no guardados.", "Cambios descartados");
    }

    private Task SubirPathCertificado(InputFileChangeEventArgs e)
    {
        if (esAsociado)
        {
            mensaje = "Los usuarios asociados no pueden modificar la firma.";
            debugError = null;
            return Task.CompletedTask;
        }

        return SubirArchivoP12(e, "Archivo Firma", "path", relativePath =>
        {
            firmaModel.PathCertificado = relativePath;
            nombrePathCertificadoSeleccionado = e.File?.Name;
            InvalidarEstadoFirmaEditor();
        });
    }

    private async Task SubirArchivoP12(InputFileChangeEventArgs e, string etiqueta, string subcarpeta, Action<string> asignarRuta)
    {
        try
        {
            if (e.FileCount > 1)
            {
                mensaje = $"Solo puedes subir un archivo .p12 para {etiqueta}.";
                debugError = null;
                await AlertService.ShowWarningAsync(mensaje, "Archivo no permitido");
                return;
            }

            var file = e.File;
            if (file is null)
            {
                mensaje = $"No se selecciono ningun archivo para {etiqueta}.";
                await AlertService.ShowWarningAsync(mensaje, "Archivo requerido");
                return;
            }

            var extension = Path.GetExtension(file.Name)?.ToLowerInvariant();
            if (!string.Equals(extension, ".p12", StringComparison.OrdinalIgnoreCase))
            {
                mensaje = $"Solo se permiten archivos .p12 para {etiqueta}.";
                debugError = null;
                await AlertService.ShowWarningAsync(mensaje, "Formato no permitido");
                return;
            }

            var contentType = (file.ContentType ?? string.Empty).Trim().ToLowerInvariant();
            var tiposPermitidos = new[]
            {
                string.Empty,
                "application/x-pkcs12",
                "application/pkcs12",
                "application/x-pkcs-12",
                "application/octet-stream"
            };

            if (!tiposPermitidos.Contains(contentType))
            {
                mensaje = $"El archivo seleccionado para {etiqueta} no es un certificado .p12 valido.";
                debugError = null;
                await AlertService.ShowWarningAsync(mensaje, "Certificado no valido");
                return;
            }

            if (file.Size <= 0)
            {
                mensaje = $"El archivo seleccionado para {etiqueta} esta vacio.";
                debugError = null;
                await AlertService.ShowWarningAsync(mensaje, "Archivo vacio");
                return;
            }

            if (file.Size > MaxCertificadoSize)
            {
                mensaje = $"El archivo de {etiqueta} excede el tamano maximo de 5 MB.";
                debugError = null;
                await AlertService.ShowWarningAsync(mensaje, "Archivo demasiado pesado");
                return;
            }

            using var stream = file.OpenReadStream(MaxCertificadoSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();
            if (bytes.Length == 0)
            {
                mensaje = $"No se pudo leer el archivo seleccionado para {etiqueta}.";
                debugError = null;
                await AlertService.ShowWarningAsync(mensaje, "Archivo no leido");
                return;
            }

            var relativePath = await GuardarArchivoCertificadoAsync(bytes, subcarpeta);
            asignarRuta(relativePath);
            mensaje = $"{etiqueta} cargado correctamente. Guarda para confirmar el cambio.";
            debugError = null;
            await AlertService.ShowSuccessAsync("Certificado cargado correctamente. Guarda para confirmar el cambio.", "Certificado cargado");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            debugError = FormatearMensajeError(ex.Message);
            mensaje = $"Error al procesar el archivo de {etiqueta}.";
            await AlertService.ShowErrorAsync(debugError, "Error al procesar archivo");
        }
    }

    private ValueTask MostrarAlertaErrorFirmaAsync(string detalle) =>
        AlertService.ShowWarningAsync(detalle, "No se pudo guardar la firma");

    private async Task<string> GuardarArchivoCertificadoAsync(byte[] bytes, string subcarpeta)
    {
        var relativePath = $"certs/{subcarpeta}/{Guid.NewGuid():N}.p12";
        var physicalPath = Path.Combine(
            HostEnvironment.ContentRootPath,
            "App_Data",
            relativePath.Replace('/', Path.DirectorySeparatorChar));

        var directory = Path.GetDirectoryName(physicalPath);
        if (!string.IsNullOrWhiteSpace(directory))
        {
            Directory.CreateDirectory(directory);
        }

        await File.WriteAllBytesAsync(physicalPath, bytes);
        return relativePath;
    }

    private async Task<int?> ObtenerIdUsuarioLogueado()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst("IdUsuario")?.Value
            ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        return int.TryParse(idClaim, out var id) ? id : null;
    }

    private void TogglePasswordVisibility()
    {
        mostrarPassword = !mostrarPassword;
    }

    private async Task CargarEstadosFirmaAsync(int idUsuario)
    {
        estadosFirma.Clear();
        cargandoEstadosFirma = true;

        try
        {
            foreach (var emisor in emisores.Where(TieneFirmaConfigurada))
            {
                try
                {
                    var estado = await Http.GetFromJsonAsync<FirmaEstadoDto>(
                        $"api/emisores/{emisor.Codigo}/firma/estado?idUsuario={idUsuario}");

                    if (estado is not null)
                        estadosFirma[emisor.Codigo] = estado;
                }
                catch (Exception ex)
                {
                    estadosFirma[emisor.Codigo] = CrearEstadoFirmaInvalido(
                        FormatearMensajeError(ex.Message));
                }
            }
        }
        finally
        {
            cargandoEstadosFirma = false;
        }
    }

    private FirmaEstadoDto? ObtenerEstadoFirma(int codigoEmisor) =>
        estadosFirma.TryGetValue(codigoEmisor, out var estado) ? estado : null;

    private void InvalidarEstadoFirmaEditor()
    {
        firmaEstadoEditor = null;
        firmaPendienteValidacion = true;
    }

    private static FirmaEstadoDto CrearEstadoFirmaInvalido(string mensaje) => new()
    {
        EsValida = false,
        EstadoVigencia = mensaje.Contains("caducada", StringComparison.OrdinalIgnoreCase)
            ? "CADUCADA"
            : "INVALIDA",
        Mensaje = mensaje
    };

    private static string ObtenerClaseEstadoFirma(bool configurada, FirmaEstadoDto? estado)
    {
        if (!configurada)
            return "is-pending";

        if (estado?.EsValida == true)
            return estado.DiasRestantes is <= 30 ? "is-warning" : "is-ready";

        return string.Equals(estado?.EstadoVigencia, "CADUCADA", StringComparison.OrdinalIgnoreCase)
            ? "is-expired"
            : "is-invalid";
    }

    private static string ObtenerEtiquetaEstadoFirma(bool configurada, FirmaEstadoDto? estado)
    {
        if (!configurada)
            return "Pendiente";

        if (estado is null)
            return "Sin validar";

        if (estado.EsValida)
            return estado.DiasRestantes is <= 30 ? "Por renovar" : "Vigente";

        return string.Equals(estado.EstadoVigencia, "CADUCADA", StringComparison.OrdinalIgnoreCase)
            ? "Caducada"
            : "No valida";
    }

    private static string ObtenerClaseAlertaFirma(FirmaEstadoDto estado) =>
        EsValidacionFirmaNoConfigurada(estado)
            ? "is-checking"
            : estado.EsValida
                ? estado.DiasRestantes is <= 30 ? "is-warning" : "is-valid"
                : string.Equals(estado.EstadoVigencia, "CADUCADA", StringComparison.OrdinalIgnoreCase)
                    ? "is-expired"
                    : "is-invalid";

    private static string ObtenerIconoEstadoFirma(FirmaEstadoDto estado) =>
        EsValidacionFirmaNoConfigurada(estado)
            ? "bi-info-circle"
            : estado.EsValida
                ? estado.DiasRestantes is <= 30 ? "bi-exclamation-triangle-fill" : "bi-shield-check"
                : "bi-shield-x";

    private static string ObtenerTituloEstadoFirma(FirmaEstadoDto estado)
    {
        if (EsValidacionFirmaNoConfigurada(estado))
            return "Validación no configurada";

        if (estado.EsValida)
            return estado.DiasRestantes is <= 30 ? "Firma próxima a vencer" : "Firma vigente";

        return string.Equals(estado.EstadoVigencia, "CADUCADA", StringComparison.OrdinalIgnoreCase)
            ? "Firma caducada"
            : "Firma no válida";
    }

    private static string ObtenerDetalleEstadoFirma(FirmaEstadoDto estado)
    {
        if (EsValidacionFirmaNoConfigurada(estado))
            return "La firma y clave pueden guardarse, pero falta configurar el servicio externo para consultar su validez.";

        if (!estado.EsValida)
            return ObtenerResumenEstadoFirma(estado);

        var fecha = estado.FechaExpiracion?.ToString("dd/MM/yyyy") ?? "sin fecha disponible";
        return $"{FormatearDiasRenovacion(estado.DiasRestantes)}. Expira el {fecha}.";
    }

    private static string ObtenerResumenEstadoFirma(FirmaEstadoDto estado)
    {
        if (!string.IsNullOrWhiteSpace(estado.Mensaje))
            return AcortarMensaje(estado.Mensaje, 220);

        return string.Equals(estado.EstadoVigencia, "CADUCADA", StringComparison.OrdinalIgnoreCase)
            ? "Firma caducada."
            : "No fue posible validar la firma.";
    }

    private static bool EsValidacionFirmaNoConfigurada(FirmaEstadoDto estado) =>
        !estado.EsValida &&
        !string.IsNullOrWhiteSpace(estado.Mensaje) &&
        estado.Mensaje.Contains("servicio de validacion de firma no esta configurada", StringComparison.OrdinalIgnoreCase);

    private static string FormatearDiasRenovacion(int? diasRestantes) =>
        diasRestantes switch
        {
            null => "Días para renovar no disponibles",
            0 => "Renueva hoy",
            1 => "1 día para renovar",
            _ => $"{diasRestantes} días para renovar"
        };

    private static string AcortarMensaje(string? mensaje, int longitudMaxima)
    {
        var texto = string.IsNullOrWhiteSpace(mensaje) ? "No fue posible validar la firma." : mensaje.Trim();
        return texto.Length <= longitudMaxima
            ? texto
            : $"{texto[..(longitudMaxima - 3)].TrimEnd()}...";
    }

    private static bool TieneFirmaConfigurada(EmisorDto emisor) =>
        !string.IsNullOrWhiteSpace(emisor.PathCertificado) &&
        emisor.TieneClaveCertificadoConfigurada;

    private static string FirstFilled(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private static EmisorUpsertDto CrearModeloDesdeEmisor(EmisorDto item) => new()
    {
        Codigo = item.Codigo,
        RazonSocial = item.RazonSocial,
        Ruc = item.Ruc,
