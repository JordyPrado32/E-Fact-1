@page "/e-rubrica"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Hosting
@using System.Globalization
@using System.Security.Claims
@using Simetric.DTOs
@using Simetric.Services
@using Simetric.Services.ESign
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject SolicitudService SolicitudService
@inject IWebHostEnvironment HostEnvironment
@inject IJSRuntime JS

<PageTitle>Inicio | E-Rúbrica</PageTitle>

<div class="esign-page">
    @if (cargando)
    {
        <ESignLoadingState
            Title="Cargando E-Rúbrica"
            Description="Validando tu acceso y preparando tus firmas y solicitudes." />
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <section class="esign-state esign-state-error">
            <i class="bi bi-exclamation-octagon"></i>
            <h3>No pudimos abrir E-Rúbrica</h3>
            <p>@errorCarga</p>
            <button type="button" class="esign-btn-primary" @onclick="VolverServicios">
                <i class="bi bi-grid"></i>
                <span>Volver a servicios</span>
            </button>
        </section>
    }
    else
    {
        <section class="esign-hero-grid">
            <article class="esign-hero-card esign-signature-status-card">
                <div class="signature-status-main">
                    <span class="signature-status-image">
                        <img src="/images/esign/firma-dashboard.png" alt="Firma electronica" />
                    </span>
                    <div class="hero-copy">
                        <span class="signature-status-label">
                            Mi firma electronica
                            <em>@FirmaStatusLabel</em>
                        </span>
                        <p>Gestiona tus firmas electronicas, certificados y documentos de forma segura y eficiente.</p>
                    </div>
                </div>
                <div class="signature-status-meta">
                    <div>
                        <span>Titular</span>
                        <strong>@FirmaTitular</strong>
                    </div>
                    <div>
                        <span>Vigencia</span>
                        <strong>@FirmaVigenciaLabel</strong>
                    </div>
                    <div>
                        <span>Dias restantes</span>
                        <strong>@FirmaDiasRestantesLabel</strong>
                    </div>
                </div>
            </article>
        </section>

        <section class="esign-actions-grid" aria-label="Acciones principales de E-Rúbrica">
            <button type="button" class="esign-main-action is-primary" @onclick="IrAFirmarDocumento">
                <span class="main-action-icon"><i class="bi bi-pencil-square"></i></span>
                <strong>Firmar documento</strong>
                <small>Firma tus documentos en pocos pasos</small>
                <i class="bi bi-chevron-right main-action-arrow"></i>
            </button>

            <button type="button" class="esign-main-action" @onclick="NuevaSolicitud">
                <span class="main-action-icon"><i class="bi bi-cart3"></i></span>
                <strong>Comprar / Renovar firma</strong>
                <small>Adquiere o renueva tu firma electronica</small>
                <i class="bi bi-chevron-right main-action-arrow"></i>
            </button>

            <button type="button" class="esign-main-action" @onclick="IrAMisDocumentos">
                <span class="main-action-icon"><i class="bi bi-folder2-open"></i></span>
                <strong>Mis documentos</strong>
                <small>Accede a tus documentos firmados</small>
                <i class="bi bi-chevron-right main-action-arrow"></i>
            </button>

            <button type="button" class="esign-main-action" @onclick="IrAValidarFirma">
                <span class="main-action-icon"><i class="bi bi-patch-check"></i></span>
                <strong>Validar firma</strong>
                <small>Verifica documentos firmados electronicamente</small>
                <i class="bi bi-chevron-right main-action-arrow"></i>
            </button>
        </section>

        <section class="esign-analytics-grid">
            <article class="esign-panel status-panel">
                <div class="panel-header">
                    <h2>Estados de solicitudes</h2>
                    <button type="button" class="esign-btn-link" @onclick="IrAMisSolicitudes">Ver reporte</button>
                </div>
                <div class="status-chart-row">
                    <div class="status-chart-wrap">
                        <canvas id="esignStatusChart" aria-label="Estados de solicitudes" role="img"></canvas>
                        <div class="chart-center">
                            <strong>@totalSolicitudes</strong>
                            <span>Total</span>
                        </div>
                    </div>
                    <div class="status-legend">
                        <span><i class="legend-dot pending"></i>Pendientes <b>@pendientesPago</b></span>
                        <span><i class="legend-dot success"></i>Aprobadas <b>@certificadosEmitidos</b></span>
                        <span><i class="legend-dot process"></i>Completadas <b>@pagosExitosos</b></span>
                        <span><i class="legend-dot danger"></i>Rechazadas <b>@SolicitudesAnuladas</b></span>
                    </div>
                </div>
            </article>

            <article class="esign-panel summary-panel">
                <div class="panel-header">
                    <h2>Resumen de firmas y documentos <span>(este mes)</span></h2>
                </div>
                <div class="summary-grid">
                    <div class="summary-item">
                        <i class="bi bi-pen"></i>
                        <strong>@certificadosEmitidos</strong>
                        <span>Documentos firmados</span>
                    </div>
                    <div class="summary-item">
                        <i class="bi bi-person-check"></i>
                        <strong>@totalSolicitudes</strong>
                        <span>Solicitudes creadas</span>
                    </div>
                    <div class="summary-item">
                        <i class="bi bi-credit-card"></i>
                        <strong>@pagosExitosos</strong>
                        <span>Pagos exitosos</span>
                    </div>
                    <div class="summary-item">
                        <i class="bi bi-award"></i>
                        <strong>@certificadosEmitidos</strong>
                        <span>Certificados emitidos</span>
                    </div>
                </div>
                <div class="summary-chart-wrap">
                    <canvas id="esignRequestsChart" aria-label="Resumen de solicitudes por mes" role="img"></canvas>
                </div>
            </article>
        </section>

        <section class="esign-stats-grid">
            <article class="esign-stat-card esign-document-stat stat-pending" role="button" tabindex="0" @onclick="IrAFirmarDocumento">
                <span class="stat-icon"><i class="bi bi-file-earmark-text"></i></span>
                <div class="stat-info">
                    <span class="stat-label">Por firmar</span>
                    <strong class="stat-value">@documentosPorFirmar</strong>
                    <small>Documentos pendientes</small>
                    <em class="stat-trend">Ver pendientes <i class="bi bi-arrow-right-short"></i></em>
                </div>
            </article>

            <article class="esign-stat-card esign-document-stat stat-signed" role="button" tabindex="0" @onclick="IrAMisDocumentos">
                <span class="stat-icon icon-success"><i class="bi bi-check-circle"></i></span>
                <div class="stat-info">
                    <span class="stat-label">Firmados</span>
                    <strong class="stat-value">@documentosFirmadosTotal</strong>
                    <small>Documentos completados</small>
                    <em class="stat-trend">Ver documentos <i class="bi bi-arrow-right-short"></i></em>
                </div>
            </article>

            <article class="esign-stat-card esign-document-stat stat-month" role="button" tabindex="0" @onclick="IrAMisDocumentos">
                <span class="stat-icon icon-month"><i class="bi bi-calendar-check"></i></span>
                <div class="stat-info">
                    <span class="stat-label">Firmas del mes</span>
                    <strong class="stat-value">@documentosFirmadosMes</strong>
                    <small>@DateTime.Now.ToString("MMMM yyyy")</small>
                    <em class="stat-trend">Ver documentos <i class="bi bi-arrow-right-short"></i></em>
                </div>
            </article>
        </section>

        <section class="esign-content-grid">
            <article class="esign-panel documents-recent-panel">
                <div class="panel-header">
                    <h2>Documentos recientes</h2>
                    <button type="button" class="esign-btn-link" @onclick="IrAMisDocumentos">Ver todas</button>
                </div>

                @if (documentosRecientes.Count > 0)
                {
                    <div class="esign-table-list">
                        @foreach (var doc in documentosRecientes)
                        {
                            <div class="table-row document-table-row">
                                <span class="document-file-chip"><i class="bi bi-file-earmark-pdf"></i></span>
                                <div class="row-main">
                                    <strong title="@doc.NombreArchivo">@doc.Nombre</strong>
                                    <small>@doc.Descripcion</small>
                                </div>
                                <span class="badge-date">@doc.Fecha.ToString("dd/MM/yyyy")</span>
                                <span class="badge-status badge-success">Valido</span>
                                <div class="document-row-actions">
                                    <a class="row-action-btn" href="@doc.Url" target="_blank" title="Ver PDF">
                                        <i class="bi bi-eye"></i>
                                        <span>Ver</span>
                                    </a>
                                    <a class="row-action-btn" href="@doc.Url" download="@doc.NombreArchivo" title="Descargar PDF">
                                        <i class="bi bi-download"></i>
                                        <span>Descargar</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-compact">Aun no tienes documentos firmados.</div>
                }
            </article>
        </section>
    }
</div>

@code {
    [Parameter] public bool DemoMode { get; set; }

    private bool cargando = true;
    private string? errorCarga;
    private string currentUserName = "Usuario";
    private List<SolicitudPagoClienteDto> solicitudes = new();
    private List<SolicitudPagoClienteDto> solicitudesRecientes = new();
    private List<DocumentoRecienteItem> documentosRecientes = new();
    private int totalSolicitudes;
    private int currentUserId;
    private int pagosExitosos;
    private int pendientesPago;
    private int certificadosEmitidos;
    private int documentosPorFirmar;
    private int documentosFirmadosTotal;
    private int documentosFirmadosMes;
    private bool chartsRenderPending;

    private int SolicitudesAnuladas => solicitudes.Count(s => s.SolIdEstadoNumerica == 4);
    private IEnumerable<SolicitudPagoClienteDto> SolicitudesPagadas => solicitudes.Where(s => s.SolPagoExitoso);
    private string ApprovalRateLabel => FormatPercent(certificadosEmitidos, Math.Max(totalSolicitudes, 1));
    private SolicitudPagoClienteDto? FirmaPrincipal => SolicitudesPagadas.FirstOrDefault();
    private string FirmaTitular => FirmaPrincipal is null ? currentUserName : $"{FirmaPrincipal.SolNombres} {FirmaPrincipal.SolPrimerApellido}".Trim();
    private string FirmaStatusLabel => FirmaPrincipal is null ? "Sin firma activa" : "Activa";
    private string FirmaVigenciaLabel => FirmaPrincipal is null
        ? "Sin vigencia"
        : $"{FirmaPrincipal.SolFechaSolicitud:dd MMM yyyy} - {GetFechaVencimiento(FirmaPrincipal):dd MMM yyyy}";
    private string FirmaDiasRestantesLabel => FirmaPrincipal is null
        ? "0 dias"
        : $"{Math.Max(0, (GetFechaVencimiento(FirmaPrincipal).Date - DateTime.Today).Days)} dias";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (DemoMode)
            {
                currentUserId = 0;
                currentUserName = "María Fernanda López";
                solicitudes = new List<SolicitudPagoClienteDto>
                {
                    new() { SolId = 42, SolNombres = "María Fernanda", SolPrimerApellido = "López", SolCorreo1 = "maria.lopez@demo.numerica.ec", SolFechaSolicitud = new DateTime(2026, 8, 28), SolFormatoFirma = "ARCHIVO_P12", SolVigencia = "1 ANIO", SolMontoPago = 23m, SolPagoExitoso = true, SolIdEstadoNumerica = 3, SolFechaPago = new DateTime(2026, 8, 28) },
                    new() { SolId = 31, SolNombres = "María Fernanda", SolPrimerApellido = "López", SolCorreo1 = "maria.lopez@demo.numerica.ec", SolFechaSolicitud = new DateTime(2026, 8, 21), SolFormatoFirma = "ARCHIVO_P12", SolVigencia = "1 ANIO", SolMontoPago = 23m, SolPagoExitoso = true, SolIdEstadoNumerica = 3, SolFechaPago = new DateTime(2026, 8, 21) },
                    new() { SolId = 24, SolNombres = "María Fernanda", SolPrimerApellido = "López", SolCorreo1 = "maria.lopez@demo.numerica.ec", SolFechaSolicitud = new DateTime(2026, 8, 14), SolFormatoFirma = "ARCHIVO_P12", SolVigencia = "1 ANIO", SolMontoPago = 23m, SolPagoExitoso = false, SolIdEstadoNumerica = 1 }
                };
                totalSolicitudes = solicitudes.Count;
                pagosExitosos = solicitudes.Count(s => s.SolPagoExitoso);
                pendientesPago = solicitudes.Count(s => !s.SolPagoExitoso && s.SolIdEstadoNumerica != 4);
                certificadosEmitidos = solicitudes.Count(s => s.SolPagoExitoso && s.SolIdEstadoNumerica == 3);
                solicitudesRecientes = solicitudes;
                documentosFirmadosTotal = 12;
                documentosFirmadosMes = 3;
                documentosPorFirmar = 2;
                documentosRecientes = new List<DocumentoRecienteItem>
                {
                    new("Contrato-servicios-2026", "Contrato-servicios-2026.pdf", "Firmado por María Fernanda López", new DateTime(2026, 8, 28), "#"),
                    new("Autorizacion-representante", "Autorizacion-representante.pdf", "Firmado por María Fernanda López", new DateTime(2026, 8, 21), "#"),
                    new("Acuerdo-comercial-andina", "Acuerdo-comercial-andina.pdf", "Firmado por María Fernanda López", new DateTime(2026, 8, 14), "#")
                };
                chartsRenderPending = true;
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                NavManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            if (!int.TryParse(user.FindFirst("IdUsuario")?.Value, out currentUserId) || currentUserId <= 0)
            {
                NavManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            var isSuperAdmin = string.Equals(
                user.FindFirst("IdTipoUsuario")?.Value,
                AppAccessService.AdminRoleId,
                StringComparison.OrdinalIgnoreCase);

            var access = await AppAccessService.CanAccessAsync(currentUserId, ESignRoutes.ServiceKey, isSuperAdmin);
            if (!access.HasAccess)
            {
                NavManager.NavigateTo($"/suscripciones?servicio={Uri.EscapeDataString(ESignRoutes.ServiceKey)}", forceLoad: true);
                return;
            }

            await SelectedAppServiceState.SetCurrentServiceKeyAsync(ESignRoutes.ServiceKey);

            var nombres = user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity?.Name ?? string.Empty;
            var apellidos = user.FindFirst(ClaimTypes.Surname)?.Value ?? string.Empty;
            currentUserName = string.Join(" ", new[] { nombres, apellidos }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();
            if (string.IsNullOrWhiteSpace(currentUserName))
                currentUserName = "Usuario";

            solicitudes = await SolicitudService.ObtenerSolicitudesClienteAsync(currentUserId);
            totalSolicitudes = solicitudes.Count;
            pagosExitosos = solicitudes.Count(s => s.SolPagoExitoso);
            pendientesPago = solicitudes.Count(s => !s.SolPagoExitoso && s.SolIdEstadoNumerica != 4);
            certificadosEmitidos = solicitudes.Count(s => s.SolPagoExitoso && s.SolIdEstadoNumerica == 3);

            solicitudesRecientes = solicitudes.OrderByDescending(s => s.SolFechaSolicitud).Take(5).ToList();
            documentosRecientes = CargarDocumentosRecientes();
            documentosPorFirmar = ContarPdfDirectorio("por-firmar");
            chartsRenderPending = true;
        }
        catch (Exception ex)
        {
            errorCarga = $"No fue posible cargar los datos de E-Rúbrica: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverServicios() => NavManager.NavigateTo("/portal-servicios", forceLoad: true);
    private void NuevaSolicitud() => NavManager.NavigateTo(DemoMode ? "/demo/erubrica?vista=solicitud" : "/solicitud/nueva");
    private void IrAMisSolicitudes() => NavManager.NavigateTo(DemoMode ? "/demo/erubrica?vista=historial" : "/solicitud");
    private void IrAFirmas() => NavManager.NavigateTo("/solicitud");
    private void IrAFirmarDocumento() => NavManager.NavigateTo(DemoMode ? "/demo/erubrica?vista=validar" : "/e-rubrica/documentos/firmar");
    private void IrAMisDocumentos() => NavManager.NavigateTo(DemoMode ? "/demo/erubrica?vista=documentos" : "/e-rubrica/documentos");
    private void IrAValidarFirma() => NavManager.NavigateTo(DemoMode ? "/demo/erubrica?vista=validar" : "/e-rubrica/documentos/validar-firma");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!cargando && string.IsNullOrWhiteSpace(errorCarga) && chartsRenderPending)
        {
            chartsRenderPending = false;
            await RenderChartsAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task RenderChartsAsync()
    {
        var culturaMeses = new CultureInfo("es-EC");
        var inicioMesActual = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var ultimosMeses = Enumerable.Range(0, 6)
            .Select(offset => inicioMesActual.AddMonths(-(5 - offset)))
            .ToList();

        var solicitudesPorMes = ultimosMeses
            .Select(mes => solicitudes.Count(s =>
                s.SolFechaSolicitud.Year == mes.Year &&
                s.SolFechaSolicitud.Month == mes.Month))
            .ToArray();

        var emitidas = solicitudes.Count(s => s.SolPagoExitoso && s.SolIdEstadoNumerica == 3);
        var enProceso = solicitudes.Count(s => s.SolPagoExitoso && s.SolIdEstadoNumerica != 3 && s.SolIdEstadoNumerica != 4);

        var payload = new
        {
            requests = new
            {
                labels = ultimosMeses.Select(m => m.ToString("MMM", culturaMeses)).ToArray(),
                values = solicitudesPorMes
            },
            status = new
            {
                labels = new[] { "Emitidos", "En proceso", "Pendientes", "Anuladas" },
                values = new[] { emitidas, enProceso, pendientesPago, SolicitudesAnuladas }
            }
        };

        await JS.InvokeVoidAsync("numericaDashboardCharts.renderESign", payload);
    }

    private string ObtenerEstadoCss(SolicitudPagoClienteDto sol)
    {
        if (sol.SolPagoExitoso && sol.SolIdEstadoNumerica == 3) return "badge-status badge-success";
        if (sol.SolPagoExitoso) return "badge-status badge-info";
        if (sol.SolIdEstadoNumerica == 4) return "badge-status badge-danger";
        return "badge-status badge-warning";
    }

    private static string FormatPercent(int value, int total)
    {
        if (total <= 0) return "0%";
        return $"{(value * 100.0 / total):0}%";
    }

    private static string GetInitials(SolicitudPagoClienteDto sol)
    {
        var first = string.IsNullOrWhiteSpace(sol.SolNombres) ? "U" : sol.SolNombres.Trim()[0].ToString();
        var last = string.IsNullOrWhiteSpace(sol.SolPrimerApellido) ? string.Empty : sol.SolPrimerApellido.Trim()[0].ToString();
        return $"{first}{last}".ToUpperInvariant();
    }

    private DateTime GetFechaVencimiento(SolicitudPagoClienteDto sol) =>
        sol.SolFechaSolicitud.AddYears(ParseVigenciaAnios(sol.SolVigencia));

    private List<DocumentoRecienteItem> CargarDocumentosRecientes()
    {
        var relativeDirectory = Path.Combine("uploads", "e-rubrica", "estampados", currentUserId.ToString());
        var physicalDirectory = Path.Combine(HostEnvironment.WebRootPath, relativeDirectory);
        if (!Directory.Exists(physicalDirectory))
            return new List<DocumentoRecienteItem>();

        var archivos = Directory.EnumerateFiles(physicalDirectory, "*.pdf")
            .Select(path => new FileInfo(path))
            .OrderByDescending(file => file.CreationTime)
            .ToList();

        documentosFirmadosTotal = archivos.Count;
        documentosFirmadosMes = archivos.Count(file =>
            file.CreationTime.Month == DateTime.Now.Month &&
            file.CreationTime.Year == DateTime.Now.Year);

        return archivos
            .Take(5)
            .Select(file => new DocumentoRecienteItem(
                CrearNombreVisible(file),
                file.Name,
                CrearDescripcion(file.Name),
                file.CreationTime,
                "/" + Path.Combine(relativeDirectory, file.Name).Replace('\\', '/')))
            .ToList();
    }

    private int ContarPdfDirectorio(string carpeta)
    {
        var directory = ObtenerDirectorioUsuario(carpeta);
        return Directory.Exists(directory)
            ? Directory.EnumerateFiles(directory, "*.pdf").Count()
            : 0;
    }

    private string ObtenerDirectorioUsuario(string carpeta) =>
        Path.Combine(HostEnvironment.WebRootPath, "uploads", "e-rubrica", carpeta, currentUserId.ToString());

    private static string CrearDescripcion(string fileName)
    {
        if (TryGetNombreDocumentoOriginal(fileName, out _))
            return "PDF firmado desde e-rubrica";

        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var index = nombre.IndexOf("_estampado", StringComparison.OrdinalIgnoreCase);
        if (index > 0)
            nombre = nombre[..index];

        return nombre.Replace('_', ' ').Trim();
    }

    private static string CrearNombreVisible(FileInfo file)
    {
        if (TryGetNombreDocumentoOriginal(file.Name, out var nombreOriginal))
            return $"{nombreOriginal}.pdf";

        var nombre = Path.GetFileNameWithoutExtension(file.Name);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 3 &&
            partes[0].Length == 14 &&
            partes[^1].Equals("estampado", StringComparison.OrdinalIgnoreCase) &&
            partes[1].Length >= 16)
        {
            return $"Documento estampado - {file.CreationTime:dd/MM/yyyy HH:mm}";
        }

        var index = nombre.IndexOf("_estampado", StringComparison.OrdinalIgnoreCase);
        if (index > 0)
            nombre = nombre[..index];

        return $"{nombre.Replace('_', ' ').Trim()}.pdf";
    }

    private static bool TryGetNombreDocumentoOriginal(string fileName, out string nombreOriginal)
    {
        nombreOriginal = string.Empty;
        var nombre = Path.GetFileNameWithoutExtension(fileName);
        var partes = nombre.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length < 4 ||
            partes[0].Length != 14 ||
            partes[1].Length != 32 ||
            !partes[^1].Equals("firmado", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        nombreOriginal = string.Join("_", partes.Skip(2).Take(partes.Length - 3))
            .Replace('_', ' ')
            .Trim();

        return !string.IsNullOrWhiteSpace(nombreOriginal);
    }

    private int ParseVigenciaAnios(string vigencia)
    {
        if (string.IsNullOrWhiteSpace(vigencia)) return 1;
        var match = System.Text.RegularExpressions.Regex.Match(vigencia, @"\d+");
        return match.Success && int.TryParse(match.Value, out var val) ? val : 1;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("numericaDashboardCharts.destroy");
        }
        catch
        {
        }
    }

    private sealed record DocumentoRecienteItem(string Nombre, string NombreArchivo, string Descripcion, DateTime Fecha, string Url);
}
