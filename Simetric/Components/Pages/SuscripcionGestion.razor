@page "/e-declara/configuracion/suscripcion"
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Models
@using Simetric.Services
@using Simetric.Services.EDeclara
@using Microsoft.EntityFrameworkCore
@using Simetric.Data
@using System.Text.Json
@using System.Text.Json.Serialization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AppAccessService AppAccessService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PagoService PagoService

<PageTitle>Mi Suscripción | E-Declara</PageTitle>

<div class="suscripcion-container">
    @if (cargando)
    {
        <section class="loading-state-card">
            <div class="loading-state-icon">
                <span class="spinner-border" role="status" style="color: #6e40c9;"></span>
            </div>
            <h3>Cargando tu suscripción</h3>
            <p>Preparando tu información de facturación de E-Declara.</p>
        </section>
    }
    else
    {
        <section class="subscription-hero">
            <div class="subscription-hero-copy">
                <span class="hero-label">Suscripción</span>
                <h1>Elige tu plan y mantén tus obligaciones al día con <strong>E&#8209;Declara</strong></h1>
                <p>Selecciona el plan que mejor se adapte a tu negocio y gestiona tus declaraciones tributarias de forma simple, rápida y segura.</p>
            </div>
            <div class="hero-benefits">
                <div><i class="ri-bar-chart-grouped-line"></i><span><strong>Más productividad</strong><small>Automatiza y ahorra tiempo</small></span></div>
                <div><i class="ri-shield-check-line"></i><span><strong>Cumplimiento garantizado</strong><small>Siempre al día con la normativa</small></span></div>
                <div><i class="ri-lock-2-line"></i><span><strong>Información segura</strong><small>Tus datos siempre protegidos</small></span></div>
            </div>
        </section>

        <!-- Mensajes de Estado -->
        @if (!string.IsNullOrWhiteSpace(successMensaje))
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 16px; background-color: #f1ecfc; color: #4e2d91; padding: 1rem 1.5rem; margin-bottom: 1.5rem; border-left: 4px solid #6e40c9 !important;">
                <i class="ri-checkbox-circle-line me-2" style="font-size: 1.2rem; vertical-align: middle; color: #6e40c9;"></i> @successMensaje
                <button type="button" class="btn-close" @onclick="() => successMensaje = null" aria-label="Cerrar"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMensaje))
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 16px; background-color: #fdf3f2; color: #b02a37; padding: 1rem 1.5rem; margin-bottom: 1.5rem; border-left: 4px solid #dc3545 !important;">
                <i class="ri-error-warning-line me-2" style="font-size: 1.2rem; vertical-align: middle;"></i> @errorMensaje
                <button type="button" class="btn-close" @onclick="() => errorMensaje = null" aria-label="Cerrar"></button>
            </div>
        }

        <div class="suscripcion-layout-grid">
            
            <!-- PANEL IZQUIERDO: DETALLE DE PLAN & TARJETAS (Aside Glassmorphism) -->
            <aside class="suscripcion-aside-panel">
                
                <!-- PLAN ACTIVO -->
                <div class="aside-block-card">
                    <div class="block-header">
                        <div>
                            <span class="block-kicker-purple">Suscripción</span>
                            <h3>Plan Activo</h3>
                        </div>
                        @if (subActiva is not null && string.Equals(subActiva.Estado, "ACTIVA", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="status-badge-active">Activo</span>
                        }
                        else
                        {
                            <span class="status-badge-inactive">Inactivo</span>
                        }
                    </div>

                    <div style="margin-top: 1rem;">
                        @if (subActiva is not null && string.Equals(subActiva.Estado, "ACTIVA", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="plan-info-detail-box">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <strong style="font-size: 1.1rem; color: #2c3d50; font-weight: 800;">
                                        @GetPlanFriendlyName(subActiva.PlanActual)
                                    </strong>
                                    <span class="cycle-pill">
                                        @GetCicloFriendlyName(subActiva.CicloActual)
                                    </span>
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; color: #6b7d8e;">
                                    <div>Costo: <strong style="color: #6e40c9;">$@GetPlanPrice(subActiva.PlanActual, subActiva.CicloActual).ToString("F2") + IVA</strong></div>
                                    <div>Fecha de Vencimiento: <strong style="color: #2c3d50;">@(subActiva.FechaFin?.ToString("dd/MM/yyyy") ?? "Sin fecha")</strong></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-plan-placeholder">
                                <div class="placeholder-icon-wrap">
                                    <i class="ri-error-warning-line"></i>
                                </div>
                                <div class="placeholder-copy">
                                    <strong>Sin plan activo</strong>
                                    <span>Suscríbete en el panel lateral para empezar.</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- CAMBIO AGENDADO -->
                    @if (subActiva is not null && !string.IsNullOrWhiteSpace(subActiva.PlanAgendado))
                    {
                        <div class="scheduled-banner">
                            <div style="display: flex; gap: 0.6rem; align-items: flex-start;">
                                <i class="ri-time-line" style="color: #b25e00; font-size: 1.15rem; margin-top: 0.1rem;"></i>
                                <div style="font-size: 0.8rem; color: #b25e00; line-height: 1.45; text-align: left;">
                                    <strong style="display: block; font-weight: 800; margin-bottom: 0.15rem;">Cambio de plan agendado</strong>
                                    Tu suscripción cambiará al <strong>@GetPlanFriendlyName(subActiva.PlanAgendado) (@GetCicloFriendlyName(subActiva.CicloAgendado))</strong> automáticamente el día <strong>@(subActiva.FechaFin?.ToString("dd/MM/yyyy") ?? "")</strong> una vez finalice tu ciclo actual.
                                </div>
                            </div>
                            <div style="display: flex; justify-content: flex-end; margin-top: 0.8rem;">
                                <button type="button" class="btn btn-sm btn-outline-danger cancel-agenda-btn" @onclick="CancelarCambioPlanAsync" disabled="@procesandoAccion">
                                    @if (procesandoAccion)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <span>Cancelar Cambio</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- TARJETAS -->
                <div class="aside-block-card" style="border-top: 1px solid rgba(110,64,201,0.12); padding-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <div>
                            <span class="block-kicker-purple">Método de Pago</span>
                            <h3 style="font-size: 1rem; font-weight: 800; color: #2c3d50; margin: 0.1rem 0 0;">Tarjetas Registradas</h3>
                        </div>
                        <button type="button" class="btn btn-sm add-card-purple-btn" @onclick="RegistrarNuevaTarjetaAsync" disabled="@procesandoAccion">
                            <i class="ri-add-line"></i> Agregar
                        </button>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                        @if (tarjetas.Any())
                        {
                            @foreach (var tarjeta in tarjetas)
                            {
                                <div class="card-item-row">
                                    <div style="display: flex; align-items: center; gap: 0.65rem;">
                                        <div class="card-icon-frame">
                                            @if ((tarjeta.MarcaTarjeta ?? "").Contains("visa", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="ri-visa-line visa-brand-icon"></i>
                                            }
                                            else
                                            {
                                                <i class="ri-mastercard-line mastercard-brand-icon"></i>
                                            }
                                        </div>
                                        <div style="display: flex; flex-direction: column; text-align: left;">
                                            <span style="font-size: 0.82rem; font-weight: 800; color: #2d3748;">
                                                •••• @(tarjeta.NumeroMascara?.Length >= 4 ? tarjeta.NumeroMascara.Substring(tarjeta.NumeroMascara.Length - 4) : "****")
                                            </span>
                                            <span style="font-size: 0.68rem; color: #a0aec0;">
                                                Registrada el @tarjeta.FechaRegistro.ToString("dd/MM/yyyy")
                                            </span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm text-danger delete-btn-icon" @onclick="() => EliminarTarjetaAsync(tarjeta)" disabled="@procesandoAccion" title="Eliminar tarjeta">
                                        <i class="ri-delete-bin-line"></i>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-cards-box">
                                <div style="color: #cbd5e0; font-size: 1.6rem; margin-bottom: 0.25rem;">
                                    <i class="ri-bank-card-line"></i>
                                </div>
                                <p style="font-size: 0.76rem; color: #a0aec0; margin: 0; line-height: 1.35; max-width: 25ch; margin: 0 auto;">
                                    No tienes tarjetas de pago registradas. Agrega una tarjeta para cobros automáticos.
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <div class="support-mini-card">
                    <i class="ri-question-line"></i>
                    <div><strong>¿Necesitas ayuda?</strong><span>Nuestro equipo está listo para ayudarte a elegir el plan ideal.</span></div>
                    <a href="/e-declara/soporte"><i class="ri-customer-service-2-line"></i> Contactar soporte</a>
                </div>

            </aside>

            <!-- PANEL DERECHO: SELECTOR DE PLANES (Main Glassmorphism) -->
            <section class="suscripcion-main-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.8rem; border-bottom: 1px solid rgba(110,64,201,0.12); padding-bottom: 1.2rem;">
                    <div style="text-align: left;">
                        <span class="block-kicker-purple">Planes E-Declara</span>
                        <h3 style="font-size: 1.2rem; font-weight: 800; color: #2c3d50; margin: 0.1rem 0 0;">Planes de Suscripción</h3>
                    </div>
                    
                    <!-- Frecuencia Toggle -->
                    <div class="billing-frequency-switcher">
                        <button type="button" class="billing-switch-btn @(cicloSeleccionado == "mensual" ? "active" : "")" @onclick='() => SetCiclo("mensual")'>
                            Mensual
                        </button>
                        <button type="button" class="billing-switch-btn @(cicloSeleccionado == "anual" ? "active" : "")" @onclick='() => SetCiclo("anual")'>
                            Anual <span class="ahorro-badge">Ahorra 20%</span>
                        </button>
                    </div>
                </div>

                <div class="plans-comparison-head" aria-hidden="true">
                    <span>Plan</span><span>Valor / mes</span><span>Valor anual</span><span>Ahorro anual</span><span>Clientes</span><span>Usuarios</span><span></span>
                </div>
                <div class="planes-cards-stack">
                    <!-- PLAN INDIVIDUAL -->
                    <div class="plan-card-box @(IsPlanActual("individual") ? "active-plan" : "") @(IsPlanAgendado("individual") ? "scheduled-plan" : "")">
                        <div class="plan-box-body">
                            <div class="plan-box-info">
                                <span class="plan-icon"><i class="ri-user-line"></i></span>
                                <div class="plan-box-title-row">
                                    <h4>Plan Individual</h4>
                                    @if (IsPlanActual("individual") && string.Equals(cicloSeleccionado, subActiva?.CicloActual, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="plan-status-pill current-pill"><i class="ri-checkbox-circle-fill"></i> Actual</span>
                                    }
                                    else if (IsPlanAgendado("individual") && string.Equals(cicloSeleccionado, subActiva?.CicloAgendado, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="plan-status-pill agenda-pill"><i class="ri-time-fill"></i> Agendado</span>
                                    }
                                </div>
                                <p class="plan-box-desc">Para personas que desean manejar sus impuestos por su cuenta.</p>
                                <ul class="plan-feature-list"><li><i class="ri-checkbox-circle-fill"></i> 1 cliente</li><li><i class="ri-checkbox-circle-fill"></i> 1 usuario</li><li><i class="ri-checkbox-circle-fill"></i> Declaraciones básicas</li><li><i class="ri-checkbox-circle-fill"></i> Soporte por correo</li></ul>
                            </div>

                            <div class="plan-value monthly-value @(cicloSeleccionado == "mensual" ? "selected-value" : "")"><small>por mes</small><strong>$10,00</strong></div>
                            <div class="plan-value annual-value @(cicloSeleccionado == "anual" ? "selected-value" : "")"><small>por año</small><strong>$80,00</strong></div>
                            <div class="plan-value plan-saving"><small>Ahorro anual</small><strong>$40,00</strong></div>
                            <div class="plan-limit"><small>Clientes</small><strong>1</strong></div>
                            <div class="plan-limit"><small>Usuarios</small><strong>1</strong></div>

                            <div class="plan-box-price-action">
                                @if (!(IsPlanActual("individual") && string.Equals(cicloSeleccionado, subActiva?.CicloActual, StringComparison.OrdinalIgnoreCase)) &&
                                     !(IsPlanAgendado("individual") && string.Equals(cicloSeleccionado, subActiva?.CicloAgendado, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <button type="button" class="btn btn-purple-action" @onclick='() => AgendarCambioPlanAsync("individual", cicloSeleccionado)' disabled="@procesandoAccion">
                                        @if (subActiva is null || string.Equals(subActiva.Estado, "PENDIENTE_PAGO", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Suscribirse</span>
                                        }
                                        else
                                        {
                                            <span>Agendar Cambio</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PLAN ASESOR -->
                    <div class="plan-card-box popular-plan @(IsPlanActual("asesor") ? "active-plan" : "") @(IsPlanAgendado("asesor") ? "scheduled-plan" : "")">
                        <div class="popular-ribbon-tag">Más Popular</div>
                        <div class="plan-box-body">
                            <div class="plan-box-info">
                                <span class="plan-icon"><i class="ri-team-line"></i></span>
                                <div class="plan-box-title-row">
                                    <h4>Plan Asesor</h4>
                                    @if (IsPlanActual("asesor") && string.Equals(cicloSeleccionado, subActiva?.CicloActual, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="plan-status-pill current-pill"><i class="ri-checkbox-circle-fill"></i> Actual</span>
                                    }
                                    else if (IsPlanAgendado("asesor") && string.Equals(cicloSeleccionado, subActiva?.CicloAgendado, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="plan-status-pill agenda-pill"><i class="ri-time-fill"></i> Agendado</span>
                                    }
                                </div>
                                <p class="plan-box-desc">Un asesor que realiza las declaraciones para personas naturales.</p>
                                <ul class="plan-feature-list"><li><i class="ri-checkbox-circle-fill"></i> 25 clientes</li><li><i class="ri-checkbox-circle-fill"></i> 1 usuario</li><li><i class="ri-checkbox-circle-fill"></i> Declaraciones completas</li><li><i class="ri-checkbox-circle-fill"></i> Soporte prioritario</li></ul>
                            </div>

                            <div class="plan-value monthly-value @(cicloSeleccionado == "mensual" ? "selected-value" : "")"><small>por mes</small><strong>$25,00</strong></div>
                            <div class="plan-value annual-value @(cicloSeleccionado == "anual" ? "selected-value" : "")"><small>por año</small><strong>$200,00</strong></div>
                            <div class="plan-value plan-saving"><small>Ahorro anual</small><strong>$100,00</strong></div>
                            <div class="plan-limit"><small>Clientes</small><strong>25</strong></div>
                            <div class="plan-limit"><small>Usuarios</small><strong>1</strong></div>

                            <div class="plan-box-price-action">
                                @if (!(IsPlanActual("asesor") && string.Equals(cicloSeleccionado, subActiva?.CicloActual, StringComparison.OrdinalIgnoreCase)) &&
                                     !(IsPlanAgendado("asesor") && string.Equals(cicloSeleccionado, subActiva?.CicloAgendado, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <button type="button" class="btn btn-purple-action" @onclick='() => AgendarCambioPlanAsync("asesor", cicloSeleccionado)' disabled="@procesandoAccion">
                                        @if (subActiva is null || string.Equals(subActiva.Estado, "PENDIENTE_PAGO", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Suscribirse</span>
                                        }
                                        else
                                        {
                                            <span>Agendar Cambio</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PLAN EMPRESARIAL -->
                    <div class="plan-card-box @(IsPlanActual("empresarial") ? "active-plan" : "") @(IsPlanAgendado("empresarial") ? "scheduled-plan" : "")">
                        <div class="plan-box-body">
                            <div class="plan-box-info">
                                <span class="plan-icon"><i class="ri-building-line"></i></span>
                                <div class="plan-box-title-row">
                                    <h4>Plan Empresarial</h4>
                                    @if (IsPlanActual("empresarial") && string.Equals(cicloSeleccionado, subActiva?.CicloActual, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="plan-status-pill current-pill"><i class="ri-checkbox-circle-fill"></i> Actual</span>
                                    }
                                    else if (IsPlanAgendado("empresarial") && string.Equals(cicloSeleccionado, subActiva?.CicloAgendado, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="plan-status-pill agenda-pill"><i class="ri-time-fill"></i> Agendado</span>
                                    }
                                </div>
                                <p class="plan-box-desc">Emprendedor que tiene un equipo de asesores que realizan declaraciones para personas naturales.</p>
                                <ul class="plan-feature-list"><li><i class="ri-checkbox-circle-fill"></i> 75 clientes</li><li><i class="ri-checkbox-circle-fill"></i> 3 usuarios</li><li><i class="ri-checkbox-circle-fill"></i> Declaraciones avanzadas</li><li><i class="ri-checkbox-circle-fill"></i> Soporte especializado</li></ul>
                            </div>

                            <div class="plan-value monthly-value @(cicloSeleccionado == "mensual" ? "selected-value" : "")"><small>por mes</small><strong>$50,00</strong></div>
                            <div class="plan-value annual-value @(cicloSeleccionado == "anual" ? "selected-value" : "")"><small>por año</small><strong>$500,00</strong></div>
                            <div class="plan-value plan-saving"><small>Ahorro anual</small><strong>$100,00</strong></div>
                            <div class="plan-limit"><small>Clientes</small><strong>75</strong></div>
                            <div class="plan-limit"><small>Usuarios</small><strong>3</strong></div>

                            <div class="plan-box-price-action">
                                @if (!(IsPlanActual("empresarial") && string.Equals(cicloSeleccionado, subActiva?.CicloActual, StringComparison.OrdinalIgnoreCase)) &&
                                     !(IsPlanAgendado("empresarial") && string.Equals(cicloSeleccionado, subActiva?.CicloAgendado, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <button type="button" class="btn btn-purple-action" @onclick='() => AgendarCambioPlanAsync("empresarial", cicloSeleccionado)' disabled="@procesandoAccion">
                                        @if (subActiva is null || string.Equals(subActiva.Estado, "PENDIENTE_PAGO", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Suscribirse</span>
                                        }
                                        else
                                        {
                                            <span>Agendar Cambio</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <aside class="numi-panel">
                <div class="numi-heading"><i class="ri-chat-smile-2-line"></i><div><strong>Tu aliado en declaraciones tributarias</strong><span>Numi está aquí para ayudarte a elegir el plan ideal para ti.</span></div></div>
                <img src="/images/edeclara/numi-suscripcion.png" alt="Numi, asistente virtual de E-Declara" />
            </aside>
        </div>

        <section class="subscription-trust-strip">
            <div><i class="ri-bank-card-line"></i><span><strong>Pago 100% seguro</strong><small>Con tarjeta de crédito o débito</small></span></div>
            <div><i class="ri-cloud-line"></i><span><strong>Acceso en la nube</strong><small>Desde cualquier dispositivo</small></span></div>
            <div><i class="ri-refresh-line"></i><span><strong>Siempre actualizado</strong><small>Con la normativa tributaria</small></span></div>
            <div><i class="ri-customer-service-2-line"></i><span><strong>Soporte especializado</strong><small>Cuando lo necesites</small></span></div>
        </section>
    }
</div>


@code {
    private bool cargando = true;
    private bool procesandoAccion = false;
    private int usuarioId;
    private string cicloSeleccionado = "mensual";
    private string? errorMensaje;
    private string? successMensaje;

    private Usuario? usuarioObj;
    private UsuarioServicioSuscripcion? subActiva;
    private List<EdeclareTarjeta> tarjetas = new();
    private int edeclaraServiceId;

    [SupplyParameterFromQuery(Name = "registro")]
    public string? Registro { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true ||
            !int.TryParse(user.FindFirst("IdUsuario")?.Value, out usuarioId) ||
            usuarioId <= 0)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadDataAsync();

        // Procesar retorno de registro de tarjeta
        if (string.Equals(Registro, "exito", StringComparison.OrdinalIgnoreCase))
        {
            successMensaje = "¡Tarjeta registrada exitosamente en Pagomedios!";
        }
        else if (string.Equals(Registro, "error", StringComparison.OrdinalIgnoreCase))
        {
            errorMensaje = "Hubo un problema al registrar la tarjeta. Por favor inténtalo de nuevo.";
        }
    }

    private async Task LoadDataAsync()
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            usuarioObj = await context.Usuarios.FirstOrDefaultAsync(u => u.IdUsuario == usuarioId);
            if (usuarioObj is null)
            {
                errorMensaje = "No se pudo cargar la información del usuario.";
                return;
            }

            // Cargar servicio E-Declara
            var servicio = await context.AppServicios.FirstOrDefaultAsync(x => x.Clave == "e-declara");
            if (servicio is not null)
            {
                edeclaraServiceId = servicio.ServicioId;

                // Cargar suscripción activa o existente
                subActiva = await context.UsuarioServicioSuscripciones
                    .FirstOrDefaultAsync(x => x.IdUsuario == usuarioId && x.ServicioId == edeclaraServiceId);
                
                // Si la suscripción actual tiene un plan específico, pre-seleccionar ciclo
                if (subActiva is not null && !string.IsNullOrWhiteSpace(subActiva.CicloActual))
                {
                    cicloSeleccionado = subActiva.CicloActual;
                }
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }

        // Sincronizar y cargar tarjetas en tiempo real
        await CargarYEstablecerTarjetasAsync();
    }

    private async Task EliminarTarjetaAsync(EdeclareTarjeta tarjeta)
    {
        procesandoAccion = true;
        errorMensaje = null;
        successMensaje = null;

        try
        {
            // 1. Eliminar de Pagomedios
            var result = await PagoService.EliminarTarjetaTokenizada(tarjeta.Token);
            if (result.IsSuccess)
            {
                // 2. Eliminar de base de datos
                await using var context = await DbFactory.CreateDbContextAsync();
                var dbTarjeta = await context.EdeclareTarjetas.FirstOrDefaultAsync(t => t.IdTarjeta == tarjeta.IdTarjeta);
                if (dbTarjeta is not null)
                {
                    context.EdeclareTarjetas.Remove(dbTarjeta);
                    await context.SaveChangesAsync();
                }

                successMensaje = "Tarjeta eliminada con éxito.";
                await LoadDataAsync();
            }
            else
            {
                errorMensaje = $"Error al eliminar la tarjeta en Pagomedios: {result.ErrorMessage ?? "Error desconocido."}";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            procesandoAccion = false;
        }
    }

    private async Task RegistrarNuevaTarjetaAsync()
    {
        if (usuarioObj is null || string.IsNullOrWhiteSpace(usuarioObj.Identificacion))
        {
            errorMensaje = "No se puede iniciar el registro sin la identificación del perfil.";
            return;
        }

        procesandoAccion = true;
        errorMensaje = null;
        successMensaje = null;

        try
        {
            var documentSanitized = new string((usuarioObj.Identificacion ?? "").Where(char.IsLetterOrDigit).ToArray());
            var notifyUrl = NavManager.ToAbsoluteUri("/api/pagomedios/notificacion-registro-tarjeta").ToString();

            var request = new
            {
                integration = true,
                third = new
                {
                    document = documentSanitized,
                    document_type = documentSanitized.Length == 13 ? "04" : "05",
                    name = usuarioObj.NombreCompleto,
                    email = usuarioObj.Email,
                    phones = string.IsNullOrWhiteSpace(usuarioObj.Celular) ? "0999999999" : usuarioObj.Celular,
                    address = string.IsNullOrWhiteSpace(usuarioObj.DireccionEmpresa) ? "Quito" : usuarioObj.DireccionEmpresa,
                    type = "Individual"
                },
                generate_invoice = 0,
                description = "Registro de Tarjeta - Configuración E-DECLARA",
                amount = 1.15m,
                amount_with_tax = 1.00m,
                amount_without_tax = 0.00m,
                tax_value = 0.15m,
                notify_url = notifyUrl,
                custom_value = $"user-{usuarioId}-plan-gestion-ciclo-gestion"
            };

            var result = await PagoService.RegistrarTarjetaSuscripcion(request);
            if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.PaymentUrl))
            {
                NavManager.NavigateTo(result.PaymentUrl, forceLoad: true);
            }
            else
            {
                errorMensaje = $"Error al iniciar el registro de tarjeta: {result.ErrorMessage ?? "Error en el servidor de pagos."}";
                procesandoAccion = false;
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error: {ex.Message}";
            procesandoAccion = false;
        }
    }

    private async Task AgendarCambioPlanAsync(string plan, string ciclo)
    {
        // Si no hay suscripción en absoluto, o si está pendiente de pago, redirigir a checkout
        if (subActiva is null || string.Equals(subActiva.Estado, "PENDIENTE_PAGO", StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo($"/suscripciones?servicio=e-declara&plan={plan}&ciclo={ciclo}");
            return;
        }

        procesandoAccion = true;
        errorMensaje = null;
        successMensaje = null;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var dbSub = await context.UsuarioServicioSuscripciones.FirstOrDefaultAsync(s => s.SuscripcionId == subActiva.SuscripcionId);

            if (dbSub is not null)
            {
                dbSub.PlanAgendado = plan;
                dbSub.CicloAgendado = ciclo;
                dbSub.FechaActualizacion = DateTime.Now;

                await context.SaveChangesAsync();
                successMensaje = $"Tu cambio de plan a {GetPlanFriendlyName(plan)} ({GetCicloFriendlyName(ciclo)}) fue programado con éxito.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al agendar el plan: {ex.Message}";
        }
        finally
        {
            procesandoAccion = false;
        }
    }

    private async Task CancelarCambioPlanAsync()
    {
        if (subActiva is null) return;

        procesandoAccion = true;
        errorMensaje = null;
        successMensaje = null;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var dbSub = await context.UsuarioServicioSuscripciones.FirstOrDefaultAsync(s => s.SuscripcionId == subActiva.SuscripcionId);

            if (dbSub is not null)
            {
                dbSub.PlanAgendado = null;
                dbSub.CicloAgendado = null;
                dbSub.FechaActualizacion = DateTime.Now;

                await context.SaveChangesAsync();
                successMensaje = "El cambio agendado fue cancelado.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cancelar cambio de plan: {ex.Message}";
        }
        finally
        {
            procesandoAccion = false;
        }
    }

    private string GetPlanFriendlyName(string? plan)
    {
        if (string.Equals(plan, "individual", StringComparison.OrdinalIgnoreCase)) return "Plan Individual";
        if (string.Equals(plan, "asesor", StringComparison.OrdinalIgnoreCase)) return "Plan Asesor";
        if (string.Equals(plan, "empresarial", StringComparison.OrdinalIgnoreCase)) return "Plan Empresarial";
        return plan ?? "Ninguno";
    }

    private string GetCicloFriendlyName(string? ciclo)
    {
        if (string.Equals(ciclo, "anual", StringComparison.OrdinalIgnoreCase)) return "Anual";
        if (string.Equals(ciclo, "mensual", StringComparison.OrdinalIgnoreCase)) return "Mensual";
        return ciclo ?? "-";
    }

    private decimal GetPlanPrice(string? plan, string? ciclo)
    {
        if (string.Equals(plan, "individual", StringComparison.OrdinalIgnoreCase))
            return string.Equals(ciclo, "anual", StringComparison.OrdinalIgnoreCase) ? 80.00m : 10.00m;
        if (string.Equals(plan, "asesor", StringComparison.OrdinalIgnoreCase))
            return string.Equals(ciclo, "anual", StringComparison.OrdinalIgnoreCase) ? 200.00m : 25.00m;
        if (string.Equals(plan, "empresarial", StringComparison.OrdinalIgnoreCase))
            return string.Equals(ciclo, "anual", StringComparison.OrdinalIgnoreCase) ? 500.00m : 50.00m;
        return 0m;
    }

    private bool IsPlanActual(string plan) =>
        subActiva is not null && string.Equals(subActiva.PlanActual, plan, StringComparison.OrdinalIgnoreCase);

    private bool IsPlanAgendado(string plan) =>
        subActiva is not null && string.Equals(subActiva.PlanAgendado, plan, StringComparison.OrdinalIgnoreCase);

    private void SetCiclo(string ciclo)
    {
        cicloSeleccionado = ciclo;
    }

    private async Task CargarYEstablecerTarjetasAsync()
    {
        if (usuarioObj is null || string.IsNullOrWhiteSpace(usuarioObj.Identificacion)) return;

        try
        {
            var result = await PagoService.ObtenerTarjetasTokenizadas(usuarioObj.Identificacion);
            if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.ResponseBody))
            {
                var cardsResponse = JsonSerializer.Deserialize<PagomediosCardListResponse>(result.ResponseBody);
                if (cardsResponse?.Success == true && cardsResponse.Data != null)
                {
                    var apiCards = cardsResponse.Data.SelectMany(x => x.Cards ?? new List<PagomediosTokenizedCard>()).ToList();
                    
                    if (apiCards.Any())
                    {
                        await using var context = await DbFactory.CreateDbContextAsync();
                        var existingTokens = await context.EdeclareTarjetas
                            .Where(x => x.IdUsuario == usuarioId)
                            .Select(x => x.Token)
                            .ToListAsync();

                        var newTarjetas = new List<EdeclareTarjeta>();
                        foreach (var card in apiCards)
                        {
                            if (!string.IsNullOrWhiteSpace(card.Token) && !existingTokens.Contains(card.Token))
                            {
                                newTarjetas.Add(new EdeclareTarjeta
                                {
                                    IdUsuario = usuarioId,
                                    Documento = usuarioObj.Identificacion,
                                    Token = card.Token,
                                    MarcaTarjeta = card.CardBrand ?? "Desconocida",
                                    NumeroMascara = card.Number ?? "****",
                                    FechaRegistro = DateTime.Now,
                                    Estado = true
                                });
                            }
                        }

                        if (newTarjetas.Any())
                        {
                            context.EdeclareTarjetas.AddRange(newTarjetas);
                            await context.SaveChangesAsync();
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error al sincronizar tarjetas: {ex.Message}");
        }
        
        // Cargar tarjetas de base de datos actualizadas
        try 
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            tarjetas = await context.EdeclareTarjetas
                .Where(x => x.IdUsuario == usuarioId && x.Estado)
                .OrderByDescending(x => x.FechaRegistro)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error al cargar tarjetas de BD: {ex.Message}");
        }
    }

