@using Microsoft.AspNetCore.Components.Routing

<div class="demo-esign-nav-menu">
    <div class="loading-pill">
        <i class="ri-eye-line"></i>
        <span>Explorando eRúbrica en modo demo.</span>
    </div>

    <div class="nav-item">
        <NavLink class="menu-link" href="/demo/erubrica" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <span class="menu-icon"><i class="ri-home-4-line"></i></span>
            <span class="menu-text">Inicio</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <button type="button" class="menu-button" @onclick="() => Alternar(1)">
            <span class="menu-icon"><i class="ri-file-shield-2-line"></i></span>
            <span class="menu-text">Documentos firmados</span>
            <i class="menu-caret @(abierto == 1 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
        </button>
        @if (abierto == 1)
        {
            <div class="submenu-panel animate__animated animate__fadeIn">
                <NavLink class="menu-link submenu-link" href="/demo/erubrica?vista=documentos" @onclick="OnNavigate">
                    <span class="menu-icon"><i class="ri-file-list-3-line"></i></span>
                    <span class="menu-text">Documentos firmados</span>
                </NavLink>
                <NavLink class="menu-link submenu-link" href="/demo/erubrica?vista=validar" @onclick="OnNavigate">
                    <span class="menu-icon"><i class="ri-checkbox-circle-line"></i></span>
                    <span class="menu-text">Validar firma</span>
                </NavLink>
            </div>
        }
    </div>

    <div class="nav-item">
        <button type="button" class="menu-button" @onclick="() => Alternar(2)">
            <span class="menu-icon"><i class="ri-pen-nib-line"></i></span>
            <span class="menu-text">Firma Electrónica</span>
            <i class="menu-caret @(abierto == 2 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
        </button>
        @if (abierto == 2)
        {
            <div class="submenu-panel animate__animated animate__fadeIn">
                <NavLink class="menu-link submenu-link" href="/demo/erubrica?vista=solicitud" @onclick="OnNavigate">
                    <span class="menu-icon"><i class="ri-file-add-line"></i></span>
                    <span class="menu-text">Nueva Solicitud</span>
                </NavLink>
                <NavLink class="menu-link submenu-link" href="/demo/erubrica?vista=historial" @onclick="OnNavigate">
                    <span class="menu-icon"><i class="ri-history-line"></i></span>
                    <span class="menu-text">Historial Solicitudes</span>
                </NavLink>
            </div>
        }
    </div>

    <div class="nav-item">
        <button type="button" class="menu-button" @onclick="() => Alternar(3)">
            <span class="menu-icon"><i class="ri-key-2-line"></i></span>
            <span class="menu-text">Mis firmas</span>
            <i class="menu-caret @(abierto == 3 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
        </button>
        @if (abierto == 3)
        {
            <div class="submenu-panel animate__animated animate__fadeIn">
                <NavLink class="menu-link submenu-link" href="/demo/erubrica?vista=firma" @onclick="OnNavigate">
                    <span class="menu-icon"><i class="ri-shield-user-line"></i></span>
                    <span class="menu-text">Ver mis firmas</span>
                </NavLink>
            </div>
        }
    </div>

    <div class="nav-item">
        <NavLink class="menu-link" href="/demo/erubrica?vista=soporte" @onclick="OnNavigate">
            <span class="menu-icon"><i class="ri-customer-service-2-line"></i></span>
            <span class="menu-text">Soporte</span>
        </NavLink>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    private int abierto;
    private void Alternar(int id) => abierto = abierto == id ? 0 : id;
}
