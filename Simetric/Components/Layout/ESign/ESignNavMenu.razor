@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Simetric.Data
@using Simetric.Models
@using Simetric.Services
@using Simetric.Services.ESign
@inject AuthenticationStateProvider AuthStateProvider
@inject IESignMenuService ESignMenuService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject MenuStateService MenuStateService
@inject NavigationManager NavigationManager
@implements IDisposable

@if (isLoading)
{
    <div class="loading-pill">
        <span class="spinner-border spinner-border-sm" role="status"></span>
        <span>Cargando menú...</span>
    </div>
}
else if (listadoMenus.Any())
{
    @foreach (var padre in GetMenusPadreOrdenados())
    {
        var hijos = GetMenusHijosOrdenados(padre.IdMenu).ToList();

        if (hijos.Any())
        {
            <div class="nav-item">
                @if (!string.IsNullOrWhiteSpace(padre.RutaMenu))
                {
                    <div class="menu-parent-row">
                        <NavLink class="menu-link menu-parent-link" href="@padre.RutaMenu" Match="NavLinkMatch.Prefix" @onclick="NotifyNavigateAsync">
                            <span class="menu-icon">
                                <i class="@(string.IsNullOrWhiteSpace(padre.IconoMenu) ? "ri-folder-line" : padre.IconoMenu)"></i>
                            </span>
                            <span class="menu-text">@GetMenuDisplayName(padre.NombreMenu)</span>
                        </NavLink>

                        <button type="button" class="menu-caret-button" @onclick="() => ToggleSubmenu(padre.IdMenu)" aria-label="Expandir modulo">
                            <i class="menu-caret @(menuAbiertoId == padre.IdMenu ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
                        </button>
                    </div>
                }
                else
                {
                    <button type="button" class="menu-button" @onclick="() => ToggleSubmenu(padre.IdMenu)">
                        <span class="menu-icon">
                            <i class="@(string.IsNullOrWhiteSpace(padre.IconoMenu) ? "ri-folder-line" : padre.IconoMenu)"></i>
                        </span>
                        <span class="menu-text">@GetMenuDisplayName(padre.NombreMenu)</span>
                        <i class="menu-caret @(menuAbiertoId == padre.IdMenu ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
                    </button>
                }

                @if (menuAbiertoId == padre.IdMenu)
                {
                    <div class="submenu-panel animate__animated animate__fadeIn">
                        @foreach (var hijo in hijos)
                        {
                            <NavLink class="menu-link submenu-link" href="@hijo.RutaMenu" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                                <span class="menu-icon">
                                    <i class="@(string.IsNullOrWhiteSpace(hijo.IconoMenu) ? "ri-subtract-line" : hijo.IconoMenu)"></i>
                                </span>
                                <span class="menu-text">@GetMenuDisplayName(hijo.NombreMenu)</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(padre.RutaMenu))
        {
            <div class="nav-item">
                <NavLink class="menu-link" href="@padre.RutaMenu" @onclick="NotifyNavigateAsync" Match="@(padre.RutaMenu == "/e-sign" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <span class="menu-icon">
                        <i class="@(string.IsNullOrWhiteSpace(padre.IconoMenu) ? "ri-circle-line" : padre.IconoMenu)"></i>
                    </span>
                    <span class="menu-text">@GetMenuDisplayName(padre.NombreMenu)</span>
                </NavLink>
            </div>
        }
    }
}
else
{
    <!-- Fallback Static Menu with E-Rúbrica Parent/Child Structure in ESign Greens -->
    <div class="nav-item">
        <NavLink class="menu-link" href="/e-sign" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
            <span class="menu-icon">
                <i class="ri-home-4-line"></i>
            </span>
            <span class="menu-text">Inicio</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <button type="button" class="menu-button" @onclick="() => ToggleSubmenu(-5)">
            <span class="menu-icon">
                <i class="ri-file-shield-2-line"></i>
            </span>
            <span class="menu-text">Documentos firmados</span>
            <i class="menu-caret @(menuAbiertoId == -5 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
        </button>
        @if (menuAbiertoId == -5)
        {
            <div class="submenu-panel animate__animated animate__fadeIn">
                <NavLink class="menu-link submenu-link" href="/e-sign/documentos" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                    <span class="menu-icon">
                        <i class="ri-file-list-3-line"></i>
                    </span>
                    <span class="menu-text">Documentos firmados</span>
                </NavLink>
            </div>
        }
    </div>

    <div class="nav-item">
        <button type="button" class="menu-button" @onclick="() => ToggleSubmenu(-1)">
            <span class="menu-icon">
                <i class="ri-pen-nib-line"></i>
            </span>
            <span class="menu-text">Firma Electr&oacute;nica</span>
            <i class="menu-caret @(menuAbiertoId == -1 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
        </button>
        @if (menuAbiertoId == -1)
        {
            <div class="submenu-panel animate__animated animate__fadeIn">
                <NavLink class="menu-link submenu-link" href="/solicitud/nueva" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                    <span class="menu-icon">
                        <i class="ri-file-add-line"></i>
                    </span>
                    <span class="menu-text">Nueva Solicitud</span>
                </NavLink>
                <NavLink class="menu-link submenu-link" href="/solicitud/pagos" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                    <span class="menu-icon">
                        <i class="ri-bill-line"></i>
                    </span>
                    <span class="menu-text">Mis Pagos</span>
                </NavLink>
            </div>
        }
    </div>

    <div class="nav-item">
        <button type="button" class="menu-button" @onclick="() => ToggleSubmenu(-3)">
            <span class="menu-icon">
                <i class="ri-key-2-line"></i>
            </span>
            <span class="menu-text">Mis firmas</span>
            <i class="menu-caret @(menuAbiertoId == -3 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
        </button>
        @if (menuAbiertoId == -3)
        {
            <div class="submenu-panel animate__animated animate__fadeIn">
                @if (usuarioTieneFirma)
                {
                    <NavLink class="menu-link submenu-link" href="/e-sign/mis-firmas" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                        <span class="menu-icon">
                            <i class="ri-shield-user-line"></i>
                        </span>
                        <span class="menu-text">Ver mis firmas</span>
                    </NavLink>
                }
                <NavLink class="menu-link submenu-link" href="/e-sign/solicitudes" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                    <span class="menu-icon">
                        <i class="ri-history-line"></i>
                    </span>
                    <span class="menu-text">Historial de solicitudes</span>
                </NavLink>
            </div>
        }
    </div>

    @if (isSuperAdmin)
    {
        <div class="nav-item">
            <button type="button" class="menu-button" @onclick="() => ToggleSubmenu(-4)">
                <span class="menu-icon">
                    <i class="ri-settings-3-line"></i>
                </span>
                <span class="menu-text">Administración</span>
                <i class="menu-caret @(menuAbiertoId == -4 ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
            </button>
            @if (menuAbiertoId == -4)
            {
                <div class="submenu-panel animate__animated animate__fadeIn">
                    <NavLink class="menu-link submenu-link" href="/e-sign/administracion/roles" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                        <span class="menu-icon">
                            <i class="ri-key-line"></i>
                        </span>
                        <span class="menu-text">Roles y permisos</span>
                    </NavLink>
                    <NavLink class="menu-link submenu-link" href="/e-sign/administracion/usuarios" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
                        <span class="menu-icon">
                            <i class="ri-user-shared-line"></i>
                        </span>
                        <span class="menu-text">Usuarios</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    <div class="nav-item">
        <NavLink class="menu-link" href="/e-sign/soporte" @onclick="NotifyNavigateAsync">
            <span class="menu-icon">
                <i class="ri-customer-service-2-line"></i>
            </span>
            <span class="menu-text">Soporte</span>
        </NavLink>
    </div>
}

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    private readonly List<Menu> listadoMenus = new();
    private bool isLoading = true;
    private int menuAbiertoId;
    private bool usuarioTieneFirma = false;
    private bool isSuperAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        MenuStateService.OnMenuChanged += HandleMenuChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
        await CargarMenus();
    }

    private async void HandleMenuChanged()
    {
        await InvokeAsync(async () =>
        {
            await CargarMenus();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        MenuStateService.OnMenuChanged -= HandleMenuChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private async Task CargarMenus()
    {
        try
        {
            isLoading = true;
            listadoMenus.Clear();
            isSuperAdmin = false;
            usuarioTieneFirma = false;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated ?? false)
            {
                var claimValue = user.FindFirst("IdTipoUsuario")?.Value
                    ?? user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                isSuperAdmin = string.Equals(claimValue, "2", StringComparison.OrdinalIgnoreCase);

                if (int.TryParse(user.FindFirst("IdUsuario")?.Value, out int userId))
                {
                    await using var context = await DbFactory.CreateDbContextAsync();
                    usuarioTieneFirma = await context.Set<UsuSolicitudFirma>()
                        .AnyAsync(s => s.SolIdUsuarioCliente == userId &&
                                       s.SolActivo &&
                                       (s.SolIdEstadoNumerica == 3 || s.SolPagoExitoso == true));
                }

                if (int.TryParse(claimValue, out int idTipoUsuario))
                {
                    var dbMenus = await ESignMenuService.GetMenusByRol(idTipoUsuario);
                    if (dbMenus != null)
                    {
                        listadoMenus.AddRange(NormalizarMenusVisibles(dbMenus));

                        // Clear Route for parent menu ID 10 so it behaves as dropdown
                        var parentMisFirmas = listadoMenus.FirstOrDefault(m => m.IdMenu == 10);
                        if (parentMisFirmas != null)
                        {
                            parentMisFirmas.RutaMenu = "";
                        }
                    }
                }

                AbrirSubmenuDeRutaActual();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en ESignNavMenu: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        AbrirSubmenuDeRutaActual();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task NotifyNavigateAsync()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private void ToggleSubmenu(int id)
    {
        menuAbiertoId = menuAbiertoId == id ? 0 : id;
    }

    private void AbrirSubmenuDeRutaActual()
    {
        var rutaActual = NormalizarRuta(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        var hijoActivo = listadoMenus
            .Where(m => m.IdMenuPadre != 0 && !string.IsNullOrWhiteSpace(m.RutaMenu))
            .FirstOrDefault(m => RutasIguales(m.RutaMenu, rutaActual));

        if (hijoActivo is not null)
        {
            menuAbiertoId = hijoActivo.IdMenuPadre;
        }
    }

    private List<Menu> NormalizarMenusVisibles(IEnumerable<Menu> menus)
    {
        var resultado = new List<Menu>();
        var rutasAgregadas = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var llavesAgregadas = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var menu in menus
            .Where(m => m.EstadoMenu != false)
            .OrderBy(m => m.IdMenuPadre)
            .ThenBy(m => m.OrdenMenu ?? 9999)
            .ThenBy(m => m.IdMenu))
        {
            var ruta = NormalizarRuta(menu.RutaMenu);
            var llave = string.IsNullOrWhiteSpace(ruta)
                ? $"parent:{menu.IdMenuPadre}:{GetMenuDisplayName(menu.NombreMenu)}"
                : $"route:{ruta}";

            if (!string.IsNullOrWhiteSpace(ruta) && !rutasAgregadas.Add(ruta))
            {
                continue;
            }

            if (string.IsNullOrWhiteSpace(ruta) && !llavesAgregadas.Add(llave))
            {
                continue;
            }

            resultado.Add(menu);
        }

        return resultado;
    }

    private static bool RutasIguales(string? rutaMenu, string rutaActual) =>
        string.Equals(NormalizarRuta(rutaMenu), rutaActual, StringComparison.OrdinalIgnoreCase);

    private static string NormalizarRuta(string? ruta)
    {
        if (string.IsNullOrWhiteSpace(ruta))
        {
            return string.Empty;
        }

        var valor = ruta.Trim();
        var queryIndex = valor.IndexOfAny(new[] { '?', '#' });
        if (queryIndex >= 0)
        {
            valor = valor[..queryIndex];
        }

        if (!valor.StartsWith('/'))
        {
            valor = "/" + valor;
        }

        return valor.Length > 1 ? valor.TrimEnd('/') : valor;
    }

    private static string GetMenuDisplayName(string? nombreMenu)
    {
        if (string.IsNullOrWhiteSpace(nombreMenu))
        {
            return string.Empty;
        }

        var nombre = nombreMenu.Trim();
        return IsRubricaMenuName(nombre) ? "Firma Electr\u00f3nica" : nombre;
    }

    private static bool IsRubricaMenuName(string nombre) =>
        nombre.Equals("E-Sign", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("e-sign", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("ESign", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("E-Rubrica", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("E-R\u00fabrica", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("eRubrica", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("eR\u00fabrica", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("Firma Electronica", StringComparison.OrdinalIgnoreCase) ||
        nombre.Equals("Firma Electrónica", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<Menu> GetMenusPadreOrdenados() =>
        listadoMenus
            .Where(m => m.IdMenuPadre == 0)
            .OrderBy(m => m.OrdenMenu ?? 9999)
            .ThenBy(m => m.IdMenu);

    private IEnumerable<Menu> GetMenusHijosOrdenados(int idPadre)
    {
        if (idPadre == 10)
        {
            var hijos = new List<Menu>();
            if (usuarioTieneFirma)
            {
                hijos.Add(new Menu
                {
                    IdMenu = 102,
                    IdMenuPadre = 10,
                    NombreMenu = "Ver mis firmas",
                    RutaMenu = "/e-sign/mis-firmas",
                    IconoMenu = "ri-shield-user-line",
                    EstadoMenu = true
                });
            }

            hijos.Add(new Menu
            {
                IdMenu = 103,
                IdMenuPadre = 10,
                NombreMenu = "Historial de solicitudes",
                RutaMenu = "/e-sign/solicitudes",
                IconoMenu = "ri-history-line",
                EstadoMenu = true
            });

            return hijos;
        }

        return listadoMenus
            .Where(m => m.IdMenuPadre == idPadre)
            .OrderBy(m => m.OrdenMenu ?? 9999)
            .ThenBy(m => m.IdMenu);
    }
}
