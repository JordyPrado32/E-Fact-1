@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims
@using Simetric.Models
@using Simetric.Services
@using Simetric.Extensions
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AliadoPortalService AliadoService
@inject IJSRuntime JS
@inject SelectedAppServiceStateService SelectedAppServiceState
@inject AppAccessService AppAccessService
@implements IDisposable

@if (cargando)
{
    <div class="ally-loading"><span class="spinner-border text-primary"></span><span>Validando acceso...</span></div>
}
else if (contexto is not null)
{
    <div class="ally-shell">
        <aside id="ally-navigation" class="ally-sidebar @(menuMovilAbierto ? "is-open" : null)">
            <div class="ally-mobile-nav-header">
                <strong>Menú</strong>
                <button type="button" aria-label="Cerrar menú" @onclick="CerrarMenuMovil">
                    <i class="ri-close-line" aria-hidden="true"></i>
                </button>
            </div>
            <AliadosNavMenu Menus="menus" Contexto="contexto" />
        </aside>
        @if (menuMovilAbierto)
        {
            <button type="button" class="ally-sidebar-backdrop" aria-label="Cerrar menú" @onclick="CerrarMenuMovil"></button>
        }
        <main class="ally-main">
            <header class="ally-topbar">
                <button type="button"
                        class="ally-menu-toggle"
                        aria-label="Abrir menú"
                        aria-controls="ally-navigation"
                        aria-expanded="@menuMovilAbierto"
                        @onclick="ToggleMenuMovil">
                    <i class="ri-menu-line" aria-hidden="true"></i>
                </button>
                <div class="ally-service-card">
                    <span class="ally-service-mark">N</span>
                    @if (puedeCambiarServicio)
                    {
                        <div class="ally-service-switcher">
                            <button type="button" class="ally-service-switcher-trigger" aria-haspopup="menu" aria-expanded="@mostrarMenuServicios" @onclick="ToggleMenuServicios">
                                <span>PORTAL DE ALIADOS</span>
                                <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
                            </button>
                            @if (mostrarMenuServicios)
                            {
                                <div class="ally-service-switcher-dropdown" role="menu">
                                    @foreach (var servicio in serviciosDisponibles)
                                    {
                                        var activo = string.Equals(servicio.Clave, AppAccessService.AllyPortalServiceKey, StringComparison.OrdinalIgnoreCase);
                                        <button type="button" role="menuitem" class="@(activo ? "is-active" : string.Empty)" @onclick="() => CambiarServicioAsync(servicio)">
                                            <img src="@ObtenerIconoServicio(servicio.Clave)" alt="" aria-hidden="true" />
                                            <span>@ObtenerNombreServicio(servicio)</span>
                                            @if (activo) { <i class="ri-check-line"></i> }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ally-service-name">PORTAL DE ALIADOS <i class="ri-arrow-down-s-line" aria-hidden="true"></i></div>
                    }
                </div>
                <div class="ally-session-card">
                    <div class="ally-profile-menu">
                        <div class="ally-user">
                            <span><small>Sesión activa</small><strong>@contexto.Nombre</strong></span>
                            <button type="button" class="ally-avatar-trigger" aria-haspopup="menu" aria-expanded="@mostrarMenuPerfil" aria-label="Abrir opciones de perfil" @onclick="ToggleMenuPerfil">
                                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                {
                                    <img src="@avatarUrl" class="ally-user-avatar" alt="Foto de perfil de @contexto.Nombre" />
                                }
                                else
                                {
                                    <span class="ally-avatar-fallback">@ObtenerIniciales(contexto.Nombre)</span>
                                }
                            </button>
                        </div>
                        @if (mostrarMenuPerfil)
                        {
                            <div class="ally-profile-dropdown" role="menu">
                                <NavLink href="/aliados/perfil" class="ally-profile-action" role="menuitem"><i class="bi bi-person-circle"></i><span>Mi perfil</span></NavLink>
                                <button type="button" class="ally-profile-action is-danger" role="menuitem" @onclick="CerrarSesion"><i class="bi bi-box-arrow-right"></i><span>Salir</span></button>
                            </div>
                        }
                    </div>
                </div>
            </header>
            <section class="ally-content">@Body</section>
        </main>
    </div>
}

@code {
    private AliadoPortalContext? contexto;
    private List<AliadoPortalMenu> menus = new();
    private bool cargando = true;
    private bool mostrarMenuPerfil;
    private bool mostrarMenuServicios;
    private bool menuMovilAbierto;
    private bool puedeCambiarServicio;
    private string? avatarUrl;
    private int userId;
    private readonly List<AppServiceCatalogItem> serviciosDisponibles = new();

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        await ValidarAccesoAsync();
    }

    private async Task ValidarAccesoAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true ||
            !int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out userId))
        {
            NavManager.NavigateTo("/login");
            return;
        }

        contexto = await AliadoService.ObtenerContextoAsync(userId);
        if (contexto is null)
        {
            NavManager.NavigateTo("/dashboard");
            return;
        }

        avatarUrl = NormalizarAvatar(auth.User.FindFirst("AvatarUrl")?.Value);

        menus = (await AliadoService.ObtenerMenusAsync(contexto.IdRolPortal)).ToList();
        await CargarServiciosDisponiblesAsync(auth.User);
        cargando = false;
        await ValidarRutaAsync();
    }

    private async Task ValidarRutaAsync()
    {
        if (contexto is null)
            return;

        var ruta = NavManager.ToBaseRelativePath(NavManager.Uri).Split('?', '#')[0].TrimEnd('/');
        var rutaPerfil = $"{AliadoPortalService.RootRoute.Trim('/')}/perfil";
        var rutaInicio = AliadoPortalService.HomeRoute.Trim('/');
        var rutaRaiz = AliadoPortalService.RootRoute.Trim('/');

        if (contexto.EsAdministrador && ruta.Equals(rutaRaiz, StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo(AliadoPortalService.HomeRoute);
            return;
        }

        if (contexto.EsAdministrador &&
            !ruta.StartsWith(AliadoPortalService.AdminRoute.Trim('/'), StringComparison.OrdinalIgnoreCase) &&
            !ruta.Equals(rutaInicio, StringComparison.OrdinalIgnoreCase) &&
            !ruta.Equals(rutaPerfil, StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo(AliadoPortalService.AdminRoute);
            return;
        }

        var rutaAdmin = AliadoPortalService.AdminRoute.Trim('/');
        if (!contexto.EsAdministrador &&
            (ruta.Equals(rutaAdmin, StringComparison.OrdinalIgnoreCase) ||
             ruta.StartsWith($"{rutaAdmin}/", StringComparison.OrdinalIgnoreCase)))
        {
            NavManager.NavigateTo(AliadoPortalService.RootRoute);
            return;
        }

        if (ruta.Equals(rutaRaiz, StringComparison.OrdinalIgnoreCase) ||
            ruta.Equals(rutaInicio, StringComparison.OrdinalIgnoreCase))
            return;

        var rutaPermitida = menus.Any(x =>
            ruta.Equals(x.Ruta.Trim('/'), StringComparison.OrdinalIgnoreCase) ||
            ruta.StartsWith($"{x.Ruta.Trim('/')}/", StringComparison.OrdinalIgnoreCase));
        if (!rutaPermitida)
        {
            NavManager.NavigateTo(AliadoPortalService.RootRoute, replace: true);
        }

        await Task.CompletedTask;
    }

    private string ObtenerTitulo()
    {
        var ruta = NavManager.ToBaseRelativePath(NavManager.Uri).Split('?', '#')[0].Trim('/');
        return ruta.ToLowerInvariant() switch
        {
            "aliados/clientes" => "Mis clientes",
            "aliados/renovaciones" => "Renovaciones",
            "aliados/comisiones" => "Comisiones",
            "aliados/liquidaciones" => "Liquidaciones",
            "aliados/perfil" => "Mi perfil",
            "aliados/admin" => "Administración de aliados",
            "aliados/admin/permisos" => "Roles y permisos",
            _ => "Inicio"
        };
    }


    private static string ObtenerIniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length > 1
            ? $"{partes[0][0]}{partes[^1][0]}".ToUpperInvariant()
            : (partes.FirstOrDefault()?.FirstOrDefault().ToString() ?? "A").ToUpperInvariant();
    }

    private static string? NormalizarAvatar(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || url.EndsWith("default.png", StringComparison.OrdinalIgnoreCase))
            return null;

        var valor = url.Trim().Replace('\\', '/');
        return valor.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
               valor.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
               valor.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
               valor.StartsWith("/", StringComparison.Ordinal)
            ? valor
            : $"/{valor.TrimStart('/')}";
    }

    private void ToggleMenuPerfil() => mostrarMenuPerfil = !mostrarMenuPerfil;

    private void ToggleMenuMovil()
    {
        menuMovilAbierto = !menuMovilAbierto;
        mostrarMenuPerfil = false;
        mostrarMenuServicios = false;
    }

    private void CerrarMenuMovil() => menuMovilAbierto = false;

    private void ToggleMenuServicios()
    {
        mostrarMenuServicios = !mostrarMenuServicios;
        if (mostrarMenuServicios)
            mostrarMenuPerfil = false;
    }

    private async Task CargarServiciosDisponiblesAsync(ClaimsPrincipal user)
    {
        var esSuperAdmin = string.Equals(user.FindFirst("IdTipoUsuario")?.Value, AppAccessService.AdminRoleId, StringComparison.OrdinalIgnoreCase);
        var esBackOffice = string.Equals(user.FindFirst("IdTipoUsuario")?.Value, BackOfficePermissionHelper.BackOfficeRoleId.ToString(), StringComparison.OrdinalIgnoreCase);
        puedeCambiarServicio = esSuperAdmin || esBackOffice;
        if (!puedeCambiarServicio)
            return;

        var catalogo = await AppAccessService.GetCatalogForUserAsync(userId, esSuperAdmin);
        serviciosDisponibles.Clear();
        serviciosDisponibles.AddRange(catalogo.Where(x =>
            x.TieneAcceso &&
            (esSuperAdmin ||
             string.Equals(x.Clave, BackOfficeRoutes.ServiceKey, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.Clave, AppAccessService.AllyPortalServiceKey, StringComparison.OrdinalIgnoreCase))));
    }

    private async Task CambiarServicioAsync(AppServiceCatalogItem servicio)
    {
        mostrarMenuServicios = false;
        await SelectedAppServiceState.SetCurrentServiceKeyAsync(servicio.Clave, userId);
        var destino = string.Equals(servicio.Clave, AppAccessService.AllyPortalServiceKey, StringComparison.OrdinalIgnoreCase)
            ? AliadoPortalService.HomeRoute
            : servicio.RutaAcceso;
        NavManager.NavigateToIfNeeded(string.IsNullOrWhiteSpace(destino) ? "/portal-servicios" : destino, forceLoad: true);
    }

    private static string ObtenerIconoServicio(string? clave) => clave?.Trim().ToLowerInvariant() switch
    {
        "e-conta" or "e-contax" or "econtax" => "/images/services/n-econtax.png",
        "e-declara" or "edeclara" => "/images/services/n-edeclara.png",
        "e-people" or "epeople" => "/images/services/n-epeople.png",
        "e-sign" or "esign" => "/images/services/n-erubrica.png",
        "backoffice" => "/images/services/n-backoffice.png",
        "portal-aliados" => "/images/LogoNumerica.svg",
        _ => "/images/LogoNumerica.svg"
    };

    private static string ObtenerNombreServicio(AppServiceCatalogItem servicio) => servicio.Clave?.Trim().ToLowerInvariant() switch
    {
        "e-fact" => "E-FACT",
        "e-conta" or "e-contax" or "econtax" => "E-CONTAX",
        "e-declara" or "edeclara" => "E-DECLARA",
        "e-people" or "epeople" => "E-PEOPLE",
        "e-sign" or "esign" => "E-RÚBRICA",
        "backoffice" => "BACKOFFICE",
        "portal-aliados" => "PORTAL DE ALIADOS",
        _ => servicio.Nombre.ToUpperInvariant()
    };

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("numericaLogoutAndRedirect", "/login");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            menuMovilAbierto = false;
            mostrarMenuPerfil = false;
            mostrarMenuServicios = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
