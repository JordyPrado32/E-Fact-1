@using Simetric.Models
@using Simetric.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject NavigationManager NavManager
@inject IJSRuntime JS

<nav class="ally-nav">
    @foreach (var menu in Menus.Where(x => x.IdMenuPadre == 0 || x.RutaMenu == AliadoPortalService.RootRoute).OrderBy(x => x.OrdenMenu ?? x.IdMenu))
    {
        if (menu.RutaMenu == AliadoPortalService.RootRoute)
        {
            <NavLink class="ally-nav-link" href="@menu.RutaMenu" Match="NavLinkMatch.All">
                <i class="@menu.IconoMenu"></i><span>@menu.NombreMenu</span>
            </NavLink>
        }
    }
    @foreach (var menu in Menus.Where(x => x.RutaMenu != AliadoPortalService.RootRoute && x.RutaMenu?.StartsWith(AliadoPortalService.RootRoute + "/", StringComparison.OrdinalIgnoreCase) == true).OrderBy(x => x.OrdenMenu ?? x.IdMenu))
    {
        <NavLink class="ally-nav-link" href="@menu.RutaMenu" Match="NavLinkMatch.Prefix">
            <i class="@menu.IconoMenu"></i><span>@menu.NombreMenu</span>
        </NavLink>
    }
    <div class="ally-nav-spacer"></div>
    <button type="button" class="ally-nav-link ally-logout" @onclick="OnLogout">
        <i class="ri-logout-box-r-line"></i><span>Cerrar sesión</span>
    </button>
</nav>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<Menu> Menus { get; set; }
    [Parameter, EditorRequired] public required AliadoPortalContext Contexto { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }
}
