@using Simetric.Models
@using Simetric.Services
@using Microsoft.AspNetCore.Components

<nav class="ally-nav">
    @foreach (var menu in Menus.Where(x => x.Ruta != AliadoPortalService.AdminRoute && !x.Ruta.StartsWith(AliadoPortalService.AdminRoute + "/", StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Orden))
    {
        if (menu.Ruta == AliadoPortalService.RootRoute)
        {
            <NavLink class="ally-nav-link" href="@AliadoPortalService.HomeRoute" Match="NavLinkMatch.All"><i class="@menu.Icono"></i><span>@menu.Nombre</span>
            </NavLink>
        }
        else { <NavLink class="ally-nav-link" href="@menu.Ruta" Match="NavLinkMatch.Prefix"><i class="@menu.Icono"></i><span>@menu.Nombre</span></NavLink> }
    }
    @if (Menus.Any(x => x.Ruta == AliadoPortalService.AdminRoute))
    {
        <div class="ally-admin-menu">
            <button type="button" class="ally-admin-menu-toggle" @onclick="AlternarAdministracion" aria-expanded="@administracionAbierta">
                <span><i class="ri-admin-line"></i> Administración</span><i class="@(administracionAbierta ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line")"></i>
            </button>
            @if (administracionAbierta)
            {
                <div class="ally-admin-menu-items">
                    <NavLink class="ally-nav-link ally-nav-sub-link" href="/aliados/admin/permisos" Match="NavLinkMatch.Prefix"><i class="ri-key-2-line"></i><span>Roles y permisos</span></NavLink>
                    @if (Menus.Any(x => x.Ruta == AliadoPortalService.AdminRoute + "/usuarios"))
                    {
                        <NavLink class="ally-nav-link ally-nav-sub-link" href="/aliados/admin/usuarios" Match="NavLinkMatch.Prefix"><i class="ri-group-line"></i><span>Usuarios</span></NavLink>
                    }
                </div>
            }
        </div>
    }
    <div class="ally-nav-spacer"></div>
</nav>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<AliadoPortalMenu> Menus { get; set; }
    [Parameter, EditorRequired] public required AliadoPortalContext Contexto { get; set; }

    private bool administracionAbierta = true;

    private void AlternarAdministracion() => administracionAbierta = !administracionAbierta;
}
