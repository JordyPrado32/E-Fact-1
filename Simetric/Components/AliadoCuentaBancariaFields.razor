@using Simetric.Models
<fieldset class="mt-3">
    <legend class="fs-6">Cuenta bancaria para comisiones</legend>
    <label class="form-label">Banco</label>
    <select class="form-select mb-2" @bind="Cuenta.Banco"><option value="">Selecciona un banco</option>@foreach (var banco in AliadoCuentaBancaria.Bancos) { <option @key="banco" value="@banco">@banco</option> }</select>
    @if (Cuenta.Banco == "Otro banco o cooperativa")
    {
        <label class="form-label">Nombre del banco o cooperativa</label><input class="form-control mb-2" @bind="Cuenta.OtroBanco" maxlength="120" />
    }
    <label class="form-label">Tipo de cuenta</label>
    <select class="form-select mb-2" @bind="Cuenta.Tipo"><option value="">Selecciona el tipo</option><option>Ahorros</option><option>Corriente</option></select>
    <label class="form-label">Número de cuenta</label><input class="form-control mb-2" @bind="Cuenta.Numero" inputmode="numeric" maxlength="30" />
    <label class="form-label">Titular</label><input class="form-control mb-2" @bind="Cuenta.Titular" maxlength="120" />
</fieldset>
@code {
    [Parameter, EditorRequired] public required AliadoCuentaBancaria Cuenta { get; set; }
}
