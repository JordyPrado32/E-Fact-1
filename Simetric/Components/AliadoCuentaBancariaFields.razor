@using Simetric.Models

<details class="ally-bank-card" open="@Expanded">
    <summary class="ally-bank-card-head" aria-label="Mostrar u ocultar datos de cuenta bancaria">
        <div class="ally-bank-title-wrap">
            <span class="ally-bank-icon"><i class="ri-bank-card-2-line"></i></span>
            <div>
                <span class="ally-bank-kicker">Pagos de comisiones</span>
                <h3 id="ally-bank-title">Cuenta bancaria</h3>
                <p>Usaremos estos datos para depositar tus liquidaciones aprobadas.</p>
            </div>
        </div>
        <span class="ally-bank-status"><i class="ri-shield-check-line"></i> Datos protegidos</span>
        <span class="ally-bank-toggle"><i class="ri-arrow-down-s-line"></i></span>
    </summary>

    <div class="ally-bank-content">
    <div class="ally-bank-grid">
        <label class="ally-bank-field ally-bank-field-wide">
            <span>Banco</span>
            <div class="ally-bank-control">
                <i class="ri-building-4-line"></i>
                <select @bind="Cuenta.Banco" aria-label="Banco">
                    <option value="">Selecciona un banco</option>
                    @foreach (var banco in AliadoCuentaBancaria.Bancos)
                    {
                        <option @key="banco" value="@banco">@banco</option>
                    }
                </select>
            </div>
        </label>

        @if (Cuenta.Banco == "Otro banco o cooperativa")
        {
            <label class="ally-bank-field ally-bank-field-wide">
                <span>Nombre del banco o cooperativa</span>
                <div class="ally-bank-control">
                    <i class="ri-edit-2-line"></i>
                    <input @bind="Cuenta.OtroBanco" maxlength="120" autocomplete="organization" placeholder="Escribe el nombre" />
                </div>
            </label>
        }

        <label class="ally-bank-field">
            <span>Tipo de cuenta</span>
            <div class="ally-bank-control">
                <i class="ri-wallet-3-line"></i>
                <select @bind="Cuenta.Tipo" aria-label="Tipo de cuenta">
                    <option value="">Selecciona el tipo</option>
                    <option>Ahorros</option>
                    <option>Corriente</option>
                </select>
            </div>
        </label>

        <label class="ally-bank-field">
            <span>Número de cuenta</span>
            <div class="ally-bank-control">
                <i class="ri-hashtag"></i>
                <input @bind="Cuenta.Numero" inputmode="numeric" maxlength="30" autocomplete="off" placeholder="Ingresa el número" />
            </div>
        </label>

        <label class="ally-bank-field ally-bank-field-wide">
            <span>Titular de la cuenta</span>
            <div class="ally-bank-control">
                <i class="ri-user-3-line"></i>
                <input @bind="Cuenta.Titular" maxlength="120" autocomplete="name" placeholder="Nombre completo del titular" />
            </div>
        </label>
    </div>

    <div class="ally-bank-note"><i class="ri-information-line"></i><span>Revisa que el titular y el número coincidan con tu banco para evitar retrasos en el pago.</span></div>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public required AliadoCuentaBancaria Cuenta { get; set; }
    [Parameter] public bool Expanded { get; set; }
}
