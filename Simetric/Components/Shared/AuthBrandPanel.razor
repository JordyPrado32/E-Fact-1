<style>
    .auth-brand-panel {
        flex: 0 0 58%;
        display: none;
        padding: 0;
        background: #061d57;
        color: #fff;
        position: relative;
        overflow: hidden;
        min-width: 0;
        min-height: 0;
    }

    .auth-brand-panel .numeric-digits-layer {
        display: none;
    }

    .auth-brand-cover {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
    }

    @@media (min-width: 993px) {
        html,
        body {
            height: 100%;
            overflow: hidden !important;
        }

        .main-viewport {
            min-height: 0 !important;
            height: 100vh !important;
            height: 100dvh !important;
            overflow: hidden !important;
        }

        .auth-brand-panel,
        .form-side {
            height: 100% !important;
            max-height: 100dvh !important;
            overflow: hidden !important;
        }

        .auth-brand-panel {
            display: block !important;
            flex: 0 0 58% !important;
            width: 58% !important;
        }

        .form-side {
            flex: 0 0 42% !important;
            width: 42% !important;
        }
    }

    @@media (max-width: 992px) {
        html,
        body {
            height: auto;
            overflow-y: auto !important;
        }

        .main-viewport {
            height: auto !important;
            min-height: max(100vh, 100dvh) !important;
            overflow: visible !important;
        }
    }
</style>

<div class="auth-brand-panel">
    <div id="@DigitLayerId" class="numeric-digits-layer" aria-hidden="true"></div>
    <img class="auth-brand-cover" src="/images/login-ecosistema-numerica.png" alt="Numérica software" />
</div>

@code {
    [Parameter]
    public string DigitLayerId { get; set; } = "numericaDigitsLayer";
}
