<section class="esign-loading-state">
    <div class="esign-loading-icon">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
    <h3>@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p>@Description</p>
    }
</section>

@code {
    [Parameter]
    public string Title { get; set; } = "Cargando E-Rubrica";

    [Parameter]
    public string? Description { get; set; }
}
